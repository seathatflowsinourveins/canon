{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.321",
  "model": "fable",
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-2"
  },
  "showThinkingSummaries": true,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4317"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/canon/statusline.sh"
  },
  "hooks": {
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "PostToolUse":        [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "PermissionDenied":   [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "SubagentStart":      [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "SubagentStop":       [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "PreCompact":         [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/canon/ledger.sh", "async": true }] }]
  }
}
