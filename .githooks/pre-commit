#!/bin/bash
# git pre-commit hook. Contract: githooks(5) — a non-zero exit aborts the commit.
# Enabled per clone with `git config core.hooksPath .githooks` (scripts/automation install does this).
#
# Runs scripts/ci --staged, the same script CI runs, in a commit's scope (ADR 0138): the canon lint, the lock
# check, ruff, its format, ty, pytest's collection, the shell checks and a secret scan of what is staged.
# The self-tests, the full pytest and actionlint are left to GitHub's required check, which runs every check
# (ADR 0144). `git commit --no-verify` would skip it here; GitHub runs the same script before anything merges, so a
# skipped commit still cannot land (ADR 0020).
#
# A commit in the primary checkout is refused: the maintenance agent keeps that checkout on main and
# fast-forwards it (ADR 0065), and work belongs in a worktree. The primary checkout is git's own fact: the
# worktree whose git dir is the common dir (git-worktree(1)); a linked worktree's git dir is not. A
# fast-forward is not a commit, so it runs no pre-commit hook.
gitdir=$(git rev-parse --path-format=absolute --git-dir) || exit 1
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1
if [ "$gitdir" = "$common" ]; then
  echo "pre-commit: this is the primary checkout, which stays on main; work in a worktree (git worktree add) and commit there."
  exit 1
fi
root=$(git rev-parse --show-toplevel) || exit 1
if ! "$root/scripts/ci" --staged; then
  echo "pre-commit: commit aborted. Fix what failed above."
  exit 1
fi
