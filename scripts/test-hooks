#!/bin/bash
# test-hooks — check the Claude Code hooks this repo registers in .claude/settings.json.
# Settings shape: https://code.claude.com/docs/en/hooks.md (hooks.<Event>[].hooks[].command, onFailure).
# Exit 0 if every case holds, 1 otherwise. Offline; reads files only.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/.claude/settings.json"
pass=0; fail=0
# check <label> <command...>: passes when the command succeeds
check() { local label="$1"; shift; if "$@"; then pass=$((pass+1)); else fail=$((fail+1)); echo "  FAIL  $label"; fi; }
registered() { grep -qxF "\${CLAUDE_PROJECT_DIR}/.claude/hooks/$1" <<<"$cmds"; }

# --- every registered hook is an executable file here, and every hook file here is registered ---
# Only command hooks name a file; a prompt or http hook has no command and is not checked here.
cmds=$(jq -r '.hooks // {} | .[] | .[]? | .hooks[]? | select(.type == "command") | .command // empty' "$SETTINGS") \
  || { echo "test-hooks: $SETTINGS is not readable as JSON with a hooks object" >&2; exit 1; }
check "settings register at least one hook"  test -n "$cmds"
while IFS= read -r cmd; do
  rel=${cmd#\$\{CLAUDE_PROJECT_DIR\}/}
  check "hook path starts at the project directory: $cmd" test "$rel" != "$cmd"
  check "hook file exists: $rel"               test -f "$ROOT/$rel"
  check "hook file is executable: $rel"        test -x "$ROOT/$rel"
done <<<"$cmds"
for f in "$ROOT"/.claude/hooks/*; do
  [ -e "$f" ] || continue
  check "hook file is registered: ${f##*/}"    registered "${f##*/}"
done

# --- nothing stands in front of a tool call, and no hook stops a session by failing (ADR 0020) ---
check "no PreToolUse hook is registered"     test "$(jq -r '.hooks | has("PreToolUse")' "$SETTINGS")" = "false"
check "no hook blocks when it fails"         test "$(jq -r '[.hooks // {} | .[] | .[]? | .hooks[]? | select(.onFailure == "block")] | length' "$SETTINGS")" = "0"

# --- uv run never rewrites uv.lock ---
# An allow entry that would pre-approve `uv run` without --locked: `uv run ...` itself, or all of uv.
unlocked=$(jq -r '[.permissions.allow[]? | strings
  | select(test("^Bash\\(uv( |:)?\\*\\)$") or (test("^Bash\\(uv run") and (test("^Bash\\(uv run --(locked|frozen) ") | not)))] | length' "$SETTINGS") \
  || unlocked=unreadable
check "settings allow uv run only with --locked" test "$unlocked" = "0"
pyl=$(grep -E 'uv run' "$ROOT/.claude/hooks/py-lint.sh" | grep -cvE 'uv run --locked')
check "py-lint calls uv run --locked"        test "$pyl" = "0"

echo "test-hooks: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
