#!/bin/bash
# test-hooks — check the Claude Code hooks this repo registers in .claude/settings.json.
# Settings shape: https://code.claude.com/docs/en/hooks.md (hooks.<Event>[].hooks[].command, onFailure).
# Exit 0 if every case holds, 1 otherwise. Offline; reads files only.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/.claude/settings.json"
pass=0; fail=0
# check <label> <command...>: passes when the command succeeds
check() { local label="$1"; shift; if "$@"; then pass=$((pass+1)); else fail=$((fail+1)); echo "  FAIL  $label"; fi; }
registered() { grep -qxF "\${CLAUDE_PROJECT_DIR}/.claude/hooks/$1" <<<"$cmds"; }

# --- every registered hook is an executable file here, and every hook file here is registered ---
# Only command hooks name a file; a prompt or http hook has no command and is not checked here.
cmds=$(jq -r '.hooks // {} | .[] | .[]? | .hooks[]? | select(.type == "command") | .command // empty' "$SETTINGS") \
  || { echo "test-hooks: $SETTINGS is not readable as JSON with a hooks object" >&2; exit 1; }
check "settings register at least one hook"  test -n "$cmds"
while IFS= read -r cmd; do
  rel=${cmd#\$\{CLAUDE_PROJECT_DIR\}/}
  check "hook path starts at the project directory: $cmd" test "$rel" != "$cmd"
  check "hook file exists: $rel"               test -f "$ROOT/$rel"
  check "hook file is executable: $rel"        test -x "$ROOT/$rel"
done <<<"$cmds"
for f in "$ROOT"/.claude/hooks/*; do
  [ -e "$f" ] || continue
  check "hook file is registered: ${f##*/}"    registered "${f##*/}"
done

# --- nothing stands in front of a tool call, and no hook stops a session by failing (ADR 0020) ---
check "no PreToolUse hook is registered"     test "$(jq -r '.hooks | has("PreToolUse")' "$SETTINGS")" = "false"
check "no hook blocks when it fails"         test "$(jq -r '[.hooks // {} | .[] | .[]? | .hooks[]? | select(.onFailure == "block")] | length' "$SETTINGS")" = "0"

# --- uv run never rewrites uv.lock ---
# An allow entry that would pre-approve `uv run` without --locked: `uv run ...` itself, or all of uv.
unlocked=$(jq -r '[.permissions.allow[]? | strings
  | select(test("^Bash\\(uv( |:)?\\*\\)$") or (test("^Bash\\(uv run") and (test("^Bash\\(uv run --(locked|frozen) ") | not)))] | length' "$SETTINGS") \
  || unlocked=unreadable
check "settings allow uv run only with --locked" test "$unlocked" = "0"
pyl=$(grep -E 'uv run' "$ROOT/.claude/hooks/py-lint.sh" | grep -cvE 'uv run --locked')
check "py-lint calls uv run --locked"        test "$pyl" = "0"

# --- which command forms prompt (ADR 0028) ---
# The Bash rule matching of https://code.claude.com/docs/en/permissions.md, as far as these rules use it:
# deny, then ask, then allow, the first match deciding; `*` matches any text, spaces included; a rule's
# one trailing ` *` (or `:*`) also matches the bare command; `mise exec` is not a wrapper Claude Code
# strips, so a rule names it. Not emulated: compound commands (an ask rule applies when any subcommand
# matches), stripped wrappers and environment assignments. Redirections and quotes are matched here as
# text, so this matcher matches fewer commands than Claude Code, which still prompted for an exact rule's
# command with `2>&1` or `> file` after it, and for `gh 'pr' merge` and `gh api -X 'POST'` (ADR 0028,
# Confirmation). Ask rules apply in every permission mode; allow rules are what keeps a command from
# prompting outside bypassPermissions.
# shellcheck disable=SC2016  # a jq program; its $names are jq's, not the shell's
MATCH='
  def esc: gsub("(?<c>[.^$|?+()\\[\\]{}\\\\])"; "\\\(.c)");
  def rx: (if endswith(":*") then .[:-2] + " *" else . end) as $p
    | if ($p | endswith(" *")) and ([$p | match("\\*"; "g")] | length) == 1
      then "^" + ($p[:-2] | esc) + "( .*)?$"
      else "^" + ($p | split("*") | map(esc) | join(".*")) + "$" end;
  def bash: [.[]? | strings | select(startswith("Bash(") and endswith(")")) | .[5:-1]];
  def hit($cmd): any(.[]; . as $s | $cmd | test($s | rx));
  def decide($cmd): .permissions as $p
    | if ($p.deny | bash | hit($cmd)) then "deny" elif ($p.ask | bash | hit($cmd)) then "ask"
      elif ($p.allow | bash | hit($cmd)) then "allow" else "none" end;'
decide()    { jq -r --arg c "$1" "$MATCH decide(\$c)" "$SETTINGS"; }
prompts()   { test "$(decide "$1")" = ask; }     # an ask rule: prompts in every mode
runs()      { test "$(decide "$1")" = allow; }   # allowed and no ask rule: prompts in no mode
unlisted()  { test "$(decide "$1")" = none; }    # prompts in Manual mode, runs in bypassPermissions
rule_hits() { test "$(jq -n -r --arg r "$1" --arg c "$2" "$MATCH [\$r] | bash | hit(\$c)")" = "$3"; }

# The matcher reproduces the docs' own table of wildcard patterns.
while IFS='|' read -r rule cmd want; do
  check "matcher: Bash($rule) on '$cmd' is $want"  rule_hits "Bash($rule)" "$cmd" "$want"
done <<'EOF'
npm run build|npm run build|true
npm run build|npm run build --watch|false
npm run *|npm run|true
npm run *|npm install|false
git log * main|git log --oneline main|true
git log * main|git log main|false
ls *|ls|true
ls *|lsof|false
ls*|lsof|true
* --help *|npm --help x|true
* --help *|npm --help|false
ls:*|ls -la|true
EOF

# What a lane runs when it follows adopt-upstream as written, or reads an upstream at the pin (rule 1): no
# prompt in any mode.
while IFS= read -r cmd; do check "runs without a prompt: $cmd" runs "$cmd"; done <<'EOF'
scripts/canon resolve alpaca-py
./scripts/canon resolve alpaca-py
scripts/canon src alpaca-py
./scripts/canon src alpaca-py
scripts/canon src
./scripts/canon src
mise exec -- scripts/canon src alpaca-py
mise exec -- ./scripts/canon src alpaca-py
mise exec -- scripts/canon src
uv add httpx==0.27.2
uv add --package canon-alpaca httpx==0.27.2
uv add httpx==0.27.2 idna==3.10
mise exec -- uv add httpx==0.27.2
mise exec -- uv add --package canon-alpaca httpx==0.27.2
uv add httpx==0.27.2 --no-sync
uv add httpx==0.27.2 2>&1
uv add types-PyYAML==6.0.12
uv add Flask-UUID==0.2
uv add sphinx-index-plugin==1.0
uv add --package canon-alpaca types-PyYAML==6.0.12
mise exec -- uv add types-PyYAML==6.0.12
mise exec -- uv add Flask-UUID==0.2 sphinx-index-plugin==1.0
scripts/land
./scripts/land
scripts/land --reviewed "code-review medium: no findings"
./scripts/land --reviewed "code-review medium: no findings"
scripts/land --pr 5
./scripts/land --pr 5
EOF

# No id (or an empty one) re-resolves every pin. A range, a URL, an upgrade, another index or another
# project is not one exact pin in this checkout. uv lock --upgrade rewrites every pin. uv sync without
# --locked can rewrite uv.lock, and no rule can carve --locked out of it (ask beats allow), so every
# uv sync prompts and a lane syncs with `uv run --locked`. The rest reach outside the checkout.
while IFS= read -r cmd; do check "prompts: $cmd" prompts "$cmd"; done <<'EOF'
scripts/canon resolve
scripts/canon resolve --prune
scripts/canon resolve ''
scripts/canon resolve '' alpaca-py
scripts/canon resolve ""
scripts/canon resolve "$id"
scripts/canon resolve $id
./scripts/canon resolve
./scripts/canon resolve --prune
./scripts/canon resolve ''
./scripts/canon resolve '' alpaca-py
./scripts/canon resolve ""
./scripts/canon resolve "$id"
./scripts/canon resolve $id
mise exec -- scripts/canon resolve
mise exec -- scripts/canon resolve --prune
mise exec -- scripts/canon resolve ''
mise exec -- scripts/canon resolve ""
mise exec -- scripts/canon resolve "$id"
mise exec -- scripts/canon resolve $id
mise exec -- ./scripts/canon resolve
mise exec -- ./scripts/canon resolve --prune
mise exec -- ./scripts/canon resolve ''
mise exec -- ./scripts/canon resolve ""
mise exec -- ./scripts/canon resolve "$id"
mise exec -- ./scripts/canon resolve $id
uv add 'httpx>=0.27'
uv add 'httpx<1'
uv add 'httpx~=0.27'
uv add 'httpx!=0.27.0'
uv add 'pkg @ ../pkg'
uv add httpx==0.27.2 git+https://example.com/pkg
uv add -ihttps://example.com/simple httpx==0.27.2
uv add httpx==0.27.2 --upgrade
uv add -U httpx==0.27.2
uv add -P idna httpx==0.27.2
uv add httpx==0.27.2 -U
uv add types-PyYAML==6.0.12 -U
uv add -Pidna httpx==0.27.2
uv add httpx==0.27.2 -P idna
uv add --extra-index-url ./index httpx==0.27.2
uv add --index-strategy unsafe-best-match httpx==0.27.2
uv add --upgrade-group dev httpx==0.27.2
uv add --index ./index httpx==0.27.2
uv add --default-index ./index httpx==0.27.2
uv add -i ./index httpx==0.27.2
uv add --find-links ./wheels httpx==0.27.2
uv add -f ./wheels httpx==0.27.2
uv add --project ../other httpx==0.27.2
uv add --directory ../other httpx==0.27.2
uv add httpx==0.27.2 -r requirements.txt
uv add httpx==0.27.2 --requirements requirements.txt
uv add httpx==0.27.2 'idna>=3'
mise exec -- uv add 'httpx>=0.27'
mise exec -- uv add 'httpx<1'
mise exec -- uv add 'httpx~=0.27'
mise exec -- uv add 'httpx!=0.27.0'
mise exec -- uv add 'pkg @ ../pkg'
mise exec -- uv add httpx==0.27.2 git+https://example.com/pkg
mise exec -- uv add -ihttps://example.com/simple httpx==0.27.2
mise exec -- uv add httpx==0.27.2 --upgrade
mise exec -- uv add -U httpx==0.27.2
mise exec -- uv add -P idna httpx==0.27.2
mise exec -- uv add httpx==0.27.2 -U
mise exec -- uv add types-PyYAML==6.0.12 -U
mise exec -- uv add -Pidna httpx==0.27.2
mise exec -- uv add httpx==0.27.2 -P idna
mise exec -- uv add --extra-index-url ./index httpx==0.27.2
mise exec -- uv add --index-strategy unsafe-best-match httpx==0.27.2
mise exec -- uv add --upgrade-group dev httpx==0.27.2
mise exec -- uv add --index ./index httpx==0.27.2
mise exec -- uv add --default-index ./index httpx==0.27.2
mise exec -- uv add -i ./index httpx==0.27.2
mise exec -- uv add --find-links ./wheels httpx==0.27.2
mise exec -- uv add -f ./wheels httpx==0.27.2
mise exec -- uv add --project ../other httpx==0.27.2
mise exec -- uv add --directory ../other httpx==0.27.2
mise exec -- uv add httpx==0.27.2 -r requirements.txt
mise exec -- uv add httpx==0.27.2 --requirements requirements.txt
uv lock --upgrade
uv lock -U
uv lock --upgrade-package idna
mise exec -- uv lock --upgrade
mise exec -- uv lock -U
uv lock --offline -U
mise exec -- uv lock --offline -U
uv sync
uv sync --upgrade
uv sync --locked
mise exec -- uv sync
mise exec -- uv sync --locked
scripts/bootstrap --install
scripts/bootstrap --install --with-user-config
./scripts/bootstrap --install
scripts/bootstrap --user-config
./scripts/bootstrap --user-config
mise exec -- scripts/bootstrap --install
mise exec -- scripts/bootstrap --install --with-user-config
mise exec -- ./scripts/bootstrap --install
mise exec -- scripts/bootstrap --user-config
mise exec -- ./scripts/bootstrap --user-config
scripts/automation install
./scripts/automation install
scripts/automation uninstall
./scripts/automation uninstall
scripts/automation install now
scripts/automation install 2>&1
./scripts/automation uninstall 2>&1
mise exec -- scripts/automation install
mise exec -- ./scripts/automation install
mise exec -- scripts/automation uninstall
mise exec -- ./scripts/automation uninstall
git push
git push origin main
mise exec -- git push
mise exec -- git push origin main
EOF

# A direct gh write publishes, as a push does, so it asks; landing goes through scripts/land, which calls
# gh inside, where no rule reaches. So do an alias (a way round every rule), an extension install, the
# auth commands that change credential state, and those that print the token (AGENTS.md, ADR 0018: use
# no credentials). Each form is checked bare and under `mise exec --`. gh upper-cases the method it is
# given (pkg/cmd/api/http.go at v2.103.3), so a rule names its first letter, in either case.
while IFS= read -r cmd; do
  check "prompts: $cmd" prompts "$cmd"
  check "prompts: mise exec -- $cmd" prompts "mise exec -- $cmd"
done <<'EOF'
gh pr merge 1
gh pr create 1
gh pr close 1
gh pr review 1
gh pr comment 1
gh pr edit 1
gh pr ready 1
gh pr reopen 1
gh pr lock 1
gh pr unlock 1
gh pr revert 1
gh pr update-branch 1
gh issue create 1
gh issue close 1
gh issue lock 1
gh issue comment 1
gh issue edit 1
gh issue reopen 1
gh issue delete 1
gh issue transfer 1
gh issue pin 1
gh issue unpin 1
gh issue unlock 1
gh issue develop 1
gh repo edit 1
gh repo create 1
gh repo delete 1
gh repo archive 1
gh repo unarchive 1
gh repo rename 1
gh repo fork 1
gh repo sync 1
gh repo deploy-key add 1
gh repo deploy-key delete 1
gh repo autolink create 1
gh repo autolink delete 1
gh release create 1
gh release edit 1
gh release delete 1
gh release delete-asset 1
gh release upload 1
gh label create 1
gh label edit 1
gh label delete 1
gh label clone 1
gh secret set 1
gh secret delete 1
gh variable set 1
gh variable delete 1
gh workflow run 1
gh workflow enable 1
gh workflow disable 1
gh run rerun 1
gh run cancel 1
gh run delete 1
gh gist create 1
gh gist edit 1
gh gist delete 1
gh gist rename 1
gh cache delete 1
gh pr new 1
gh issue new 1
gh repo new 1
gh repo autolink new 1
gh release new 1
gh gist new 1
gh secret remove 1
gh variable remove 1
gh issue artifact create 1
gh issue artifact edit 1
gh issue artifact delete 1
gh alias set m 'pr merge'
gh alias import aliases.yml
gh extension install o/gh-x
gh extensions install o/gh-x
gh ext install o/gh-x
gh extension upgrade --all
gh extensions upgrade --all
gh ext upgrade --all
gh auth token
gh auth login
gh auth logout
gh auth refresh
gh auth setup-git
gh auth status -t
gh auth status --show-token
gh auth status --json hosts --show-token
gh api -X POST repos/o/r/statuses/abc
gh api -XPUT repos/o/r/statuses/abc
gh api -X=PATCH repos/o/r/statuses/abc
gh api --method POST repos/o/r/statuses/abc
gh api --method=PUT repos/o/r/statuses/abc
gh api -X post repos/o/r/statuses/abc
gh api -Xput repos/o/r/statuses/abc
gh api -X=patch repos/o/r/statuses/abc
gh api --method post repos/o/r/statuses/abc
gh api --method=put repos/o/r/statuses/abc
gh api -X DELETE repos/o/r/statuses/abc
gh api -XDELETE repos/o/r/statuses/abc
gh api -X=DELETE repos/o/r/statuses/abc
gh api --method DELETE repos/o/r/statuses/abc
gh api --method=DELETE repos/o/r/statuses/abc
gh api -X delete repos/o/r/statuses/abc
gh api -Xdelete repos/o/r/statuses/abc
gh api -X=delete repos/o/r/statuses/abc
gh api --method delete repos/o/r/statuses/abc
gh api --method=delete repos/o/r/statuses/abc
gh pr merge 5 --squash --auto
gh pr create
gh api repos/o/r/issues/1 -X PATCH -f state=closed
gh api -X Post repos/o/r/statuses/abc
EOF

# What lanes read through gh: no gh rule catches it (reads of a group whose writes ask included).
while IFS= read -r cmd; do
  check "neither allowed nor asked: $cmd" unlisted "$cmd"
  check "neither allowed nor asked: mise exec -- $cmd" unlisted "mise exec -- $cmd"
done <<'EOF'
gh run view 1
gh run view 1 --log
gh run list
gh pr view 1
gh pr view 1 --json title --jq .title
gh pr list --head main --state open
gh pr checks 1 --required
gh pr diff 1
gh api repos/o/r
gh api -X GET repos/o/r/issues -f state=open
gh api --method GET repos/o/r/issues -f state=open
gh api -X get repos/o/r/pulls --jq .output
gh issue list
gh issue view 1
gh auth status
gh auth status --json hosts
gh auth status -a
gh alias list
gh extension list
gh release list
gh release view v1
gh release download v1
gh label list
gh secret list
gh variable list
gh variable get X
gh workflow list
gh workflow view watch.yml
gh repo view
gh cache list
gh gist list
EOF

# A bare name is neither pinned nor matchable: Manual mode asks, as for any command not allowed.
while IFS= read -r cmd; do check "neither allowed nor asked: $cmd" unlisted "$cmd"; done <<'EOF'
uv add httpx
mise exec -- uv add httpx
uv lock
uv lock -P Flask-UUID
mise exec -- scripts/canon resolve alpaca-py
EOF

# Stated limits (ADR 0028): a rule matches the command as written, so another spelling of the same
# program gets past every rule here, and bypassPermissions runs it unasked. Listed so a change is seen.
while IFS= read -r cmd; do check "a spelling no rule matches: $cmd" unlisted "$cmd"; done <<'EOF'
mise x -- git push origin main
sh -c 'scripts/automation install'
git -C . push origin main
gh api repos/o/r/issues -f title=x
gh api --input body.json repos/o/r/issues
gh api graphql -f query='mutation { x }'
gh api -iX POST repos/o/r/statuses/abc
gh auth status -at
gh m 1
gh -R o/r pr merge 1
gh pr -R o/r merge 1
mise x -- gh pr merge 1
sh -c 'gh pr merge 1'
EOF

# A short flag bundled after another is not its own word, so `uv add -qU` with an exact pin is allowed and
# upgrades unasked (ADR 0028, stated limit), as it did under `*-U*`, which also asked for a name holding
# `-U`.
check "a bundled flag no rule asks for: uv add -qU httpx==0.27.2" runs "uv add -qU httpx==0.27.2"

# --- the two static brief lines name the coordinator's cold-start reads (ADR 0078 items 4 and 5) ---
# Static text: neither hook runs `orca`, so neither waits on the app.
sb=$(printf '{"cwd":"%s"}' "$ROOT" | "$ROOT/.claude/hooks/session-brief.sh" 2>/dev/null)
cb=$("$ROOT/.claude/hooks/compact-brief.sh" 2>/dev/null)
check "session brief printed"        test -n "$sb"
for w in run-list run-use task-list gate-list worker-list "scripts/automation status"; do
  check "session brief names $w"     grep -qF -- "$w" <<<"$sb"
  check "compact brief names $w"     grep -qF -- "$w" <<<"$cb"
done
check "compact brief no longer points at a state file" test "$(grep -ci "state file" <<<"$cb")" = "0"
hooklines=$(cat "$ROOT/.claude/hooks/session-brief.sh" "$ROOT/.claude/hooks/compact-brief.sh" | grep -vE "^[[:space:]]*(#|echo )")
check "brief hooks never run orca"   test "$(grep -cE "(^|[ ;(|&])orca( |$)" <<<"$hooklines")" = "0"
nocomment=$(cat "$ROOT/.claude/hooks/session-brief.sh" "$ROOT/.claude/hooks/compact-brief.sh" | grep -vE "^[[:space:]]*#")
# shellcheck disable=SC2016 # the pattern is a grep regex, not a shell expansion
check "no hook substitutes a command that names orca" test "$(grep -cE '(\$\(|`)[^)`]*orca' <<<"$nocomment")" = "0"

# --- .githooks/pre-commit refuses a commit in the primary checkout, which the maintenance agent keeps on main ---
# The primary worktree is the one whose git dir is the common dir (git-worktree(1)); a linked worktree's is not.
# Scratch repository with a stub scripts/ci, so only the guard is under test. A fast-forward is not a commit, so
# the maintenance agent's `git merge --ff-only` runs no pre-commit hook.
# Hermetic: a hook's environment carries GIT_INDEX_FILE and the like, which would point these commands at the
# real repository, and global config (signing, templates) is none of this test's business.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
G=$(mktemp -d "${TMPDIR:-/tmp}/test-hooks.XXXXXX")
trap 'rm -rf "${G:?}"' EXIT
gq() { git -C "$G/main" -c user.name=t -c user.email=t@example.invalid "$@"; }
git init -q -b main "$G/main"
mkdir -p "$G/main/.githooks" "$G/main/scripts"
cp "$ROOT/.githooks/pre-commit" "$G/main/.githooks/pre-commit"
printf '#!/bin/bash\nexit 0\n' > "$G/main/scripts/ci"
chmod +x "$G/main/.githooks/pre-commit" "$G/main/scripts/ci"
git -C "$G/main" config core.hooksPath .githooks
git -C "$G/main" add -A
gq commit -q --no-verify -m seed
git -C "$G/main" branch work
git -C "$G/main" worktree add -q "$G/linked" work
: > "$G/main/a"; git -C "$G/main" add a
out=$(gq commit -q -m "in primary" 2>&1); rc=$?
check "a commit in the primary checkout is refused"        test "$rc" -ne 0
check "the refusal tells the committer to use a worktree"  grep -qi "work in a worktree" <<<"$out"
check "the refusal is one line of its own"                 test "$(grep -c "^pre-commit:" <<<"$out")" = "1"
git -C "$G/main" reset -q
: > "$G/linked/b"; git -C "$G/linked" add b
out=$(git -C "$G/linked" -c user.name=t -c user.email=t@example.invalid commit -q -m "in linked" 2>&1); rc=$?
check "a commit in a linked worktree passes"               test "$rc" -eq 0
check "a fast-forward in the primary checkout is no commit" git -C "$G/main" merge -q --ff-only work

echo "test-hooks: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
