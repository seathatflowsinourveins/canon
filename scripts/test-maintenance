#!/bin/bash
# test-maintenance — offline checks of the maintenance agent, home/.claude/canon/maintenance.sh, and of what
# scripts/automation does for it and for the OmniRoute gateway agent (ADR 0065, dated addition of 2026-11-11;
# ADR 0056). Everything runs in a temporary folder with HOME and CLAUDE_CONFIG_DIR pointed there:
#   * the agent runs as launchd runs it, with no environment but HOME and CLAUDE_CONFIG_DIR, on a clone of a
#     local bare origin, with stand-ins for both installers (scripts/automation and scripts/bootstrap in the
#     clone), launchctl, mise, `claude` and `agy`, and getconf naming a temporary folder for the paper locks;
#   * a stand-in launchctl that kills the job's process group at its bootout, as launchd kills a job, so the
#     reinstall the agent starts must outlive both its own job's bootout and the end of its round;
#   * the real scripts/automation, rehearsed with AUTOMATION_SKIP_LAUNCHD=1 or the stand-in launchctl, for the
#     plists, `differs` and the status rows.
# Nothing outside the temporary folder is read or changed, and nothing reaches the network. Needs macOS's
# lockf(1), timeout(1) and plutil(1); without them it says so and skips. Exit 0 if every case passes.
# shellcheck disable=SC2016,SC2034  # stub bodies and eval'd checks are single-quoted: they expand, and read the variables set before them, when they run
set -uo pipefail
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-maintenance.XXXXXX") \
  || { echo "test-maintenance: could not create a temp folder under ${TMPDIR:-/tmp}" >&2; exit 1; }
TMP=$(cd "$TMP" && pwd)   # TMPDIR ends in a slash; the scripts name paths as pwd(1) gives them
HOLDERS=""
# the boundary waiters the rounds started are process groups of their own (maintenance.sh, set -m)
# a killed lockf(1) leaves its command running, so each holder's children go first
cleanup() { local p; for p in $HOLDERS $(cat "$STUB/holders" 2>/dev/null); do pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; done
  while read -r p; do kill -- "-$p" 2>/dev/null; done < <(cat "$TMP/waiters" 2>/dev/null); rm -rf "${TMP:?}"; }
trap cleanup EXIT
GIT_CEILING_DIRECTORIES=$(cd "$TMP/.." && pwd -P); export GIT_CEILING_DIRECTORIES
pass=0; fail=0
t_pass() { pass=$((pass+1)); echo "  pass  $1"; }
t_fail() { fail=$((fail+1)); echo "  FAIL  $1"; }
check()  { local label="$1"; shift; if "$@"; then t_pass "$label"; else t_fail "$label"; fi; }
jqt()    { jq -e "$2" "$1" >/dev/null 2>&1; }
rowis()  { grep -Eq "^  $2 +$3( |\$)" "$1"; }
for t in /usr/bin/lockf /usr/bin/timeout /usr/bin/plutil /usr/bin/jq; do
  [ -x "$t" ] || { echo "test-maintenance: skip (no $t here; macOS only)"; echo "test-maintenance: 0 passed, 0 failed, 1 skipped"; exit 0; }
done

H="$TMP/home"; AH="$H/.claude"; W="$AH/canon/watch"; mkdir -p "$H/.local/bin" "$W"
B="$TMP/bin"; STUB="$TMP/stub"; LT="$TMP/user-tmp/"; mkdir -p "$B" "$STUB" "$LT"
export STUB
# ---------- stand-ins ----------
cat > "$B/getconf" <<EOF
#!/bin/bash
echo "$LT"
EOF
# mise: logs; `which agy` names the agy stand-in when there is one; `where npm:omniroute` says installed when
# $STUB/omniroute-installed exists; `which otelcol` names the otelcol stand-in. Its version is
# $STUB/mise-version's, which `self-update <version>` replaces; mise's global config is $STUB/global/<tool>,
# one file a tool holding its version, which `ls --global --json <tool>` reads (the array mise 2026.11.5
# prints, observed) and `use --global --yes <tool>@<version>` writes; $STUB/<command>-rc fails either
cat > "$B/mise" <<'EOF'
#!/bin/bash
echo "mise $* | env=${MISE_ENV:-}" >> "$STUB/mise.log"
gf() { printf '%s/global/%s' "$STUB" "$(printf '%s' "$1" | tr '/:@' '___')"; }
case "$1" in
  --version) cat "$STUB/mise-version" 2>/dev/null || echo "2026.11.5 macos-arm64 (2026-11-09)"; exit 0 ;;
  self-update) [ ! -f "$STUB/self-update-rc" ] || { echo "mise ERROR stand-in self-update failed" >&2; exit "$(cat "$STUB/self-update-rc")"; }
               echo "${!#} macos-arm64 (stand-in)" > "$STUB/mise-version"; exit 0 ;;
  ls) f=$(gf "${!#}"); if [ -f "$f" ]; then v=$(cat "$f"); printf '[{"version":"%s","requested_version":"%s","installed":true,"active":true}]\n' "$v" "$v"
      else echo '[]'; fi; exit 0 ;;
  use) a=${!#}; [ ! -f "$STUB/use-rc" ] || { echo "mise ERROR stand-in could not install $a" >&2; exit "$(cat "$STUB/use-rc")"; }
       mkdir -p "$STUB/global"; echo "${a##*@}" > "$(gf "${a%@*}")"; exit 0 ;;
esac
case "$1 ${2:-}" in
  "which agy") [ -x "$STUB/agy" ] && { echo "$STUB/agy"; exit 0; }; exit 1 ;;
  "which otelcol") echo "$STUB/otelcol"; exit 0 ;;
  "where npm:omniroute") [ -f "$STUB/omniroute-installed" ] && { echo "$STUB/omniroute"; exit 0; }
                         [ -f "$STUB/omniroute-unknown" ] && { echo "mise ERROR could not read the config" >&2; exit 1; }
                         echo "mise ERROR npm:omniroute not installed" >&2; exit 1 ;;
esac
exit 0
EOF
# launchctl: a job is loaded while $STUB/loaded/<label> exists. bootout of a job whose process group is in
# $STUB/pgid-<label> sends that group SIGTERM, as launchd ends a job (launchd.plist(5), AbandonProcessGroup)
cat > "$B/launchctl" <<'EOF'
#!/bin/bash
echo "launchctl $*" >> "$STUB/launchctl.log"
mkdir -p "$STUB/loaded"
case "${1:-}" in
  print) [ -f "$STUB/loaded/${2##*/}" ] || exit 113; printf '\tstate = %s\n\tlast exit code = 0\n' "$(cat "$STUB/loaded/${2##*/}")" ;;
  bootout) l=${2##*/}; [ -f "$STUB/loaded/$l" ] || { echo "Boot-out failed: 3: No such process" >&2; exit 3; }
           if [ -f "$STUB/pgid-$l" ]; then kill -TERM -- "-$(cat "$STUB/pgid-$l")" 2>/dev/null; fi
           rm -f "$STUB/loaded/$l" ;;
  bootstrap) l=$(basename "${3:-}" .plist); [ ! -f "$STUB/loaded/$l" ] || { echo "Bootstrap failed: 5: Input/output error" >&2; exit 5; }
             echo running > "$STUB/loaded/$l" ;;
  list) ;;
esac
exit 0
EOF
printf '#!/bin/bash\necho "otelcol $*" >> "$STUB/otelcol.log"\nexit 0\n' > "$STUB/otelcol"
# takelock <file>: a stand-in window takes the paper lock and holds it until the test releases it
# (release, below; at most 300 s), however slow the round is; returns once it is held (within 30 s)
cat > "$STUB/takelock" <<'EOF'
#!/bin/bash
/usr/bin/lockf -k "$1" /bin/bash -c 'for _ in $(seq 1 3000); do [ ! -f "$0/release" ] || exit 0; sleep 0.1; done' "$(dirname "$0")" >/dev/null 2>&1 &
echo "$!" >> "$(dirname "$0")/holders"
for _ in $(seq 1 600); do /usr/bin/lockf -t 0 "$1" true 2>/dev/null || exit 0; sleep 0.05; done
exit 1
EOF
chmod +x "$STUB/takelock"
# claude and agy: log `update`; $STUB/<name>-rc is the exit code, $STUB/<name>-hangs makes it hang,
# $STUB/<name>-slow takes 5 s (a loaded machine), $STUB/<name>-takes-lock names a lock it has a stand-in take
for n in claude agy; do
  cat > "$STUB/$n" <<EOF
#!/bin/bash
echo "$n \$*" >> "\$STUB/updates.log"
[ ! -f "\$STUB/$n-hangs" ] || sleep 60
[ ! -f "\$STUB/$n-slow" ] || sleep 5
[ ! -f "\$STUB/$n-takes-lock" ] || "\$STUB/takelock" "\$(cat "\$STUB/$n-takes-lock")"
echo "$n: updated (stand-in)"
exit "\$(cat "\$STUB/$n-rc" 2>/dev/null || echo 0)"
EOF
done
chmod +x "$B"/* "$STUB/otelcol" "$STUB/claude" "$STUB/agy"
ln -s "$STUB/claude" "$H/.local/bin/claude"

# ---------- the main checkout: a clone of a local bare origin, with stand-in installers ----------
O="$TMP/origin.git"; OW="$TMP/origin-work"; R="$TMP/main-checkout"
git init -q --bare -b main "$O" && git init -q -b main "$OW"
mkdir -p "$OW/scripts"
# scripts/automation stand-in: differs prints $STUB/differs-out and exits $STUB/differs-rc ($STUB/differs-slow
# takes 5 s, $STUB/differs-takes-lock names a lock it has a stand-in take); install logs, ends
# its own job as the real one would when the maintenance plist changed (bootout, then bootstrap of all five
# labels), sleeps $STUB/install-secs, waits for $STUB/install-go if $STUB/install-waits is there (at most
# 300 s), and exits $STUB/install-rc with $STUB/install-out
cat > "$OW/scripts/automation" <<'EOF'
#!/bin/bash
echo "automation $* | pgid=$(ps -o pgid= -p $$ | tr -d ' ') | cfg=${CLAUDE_CONFIG_DIR:-}" >> "$STUB/installers.log"
case "$1" in
  differs) [ ! -f "$STUB/differs-slow" ] || sleep 5
           [ ! -f "$STUB/differs-takes-lock" ] || "$STUB/takelock" "$(cat "$STUB/differs-takes-lock")"
           cat "$STUB/differs-out" 2>/dev/null; exit "$(cat "$STUB/differs-rc" 2>/dev/null || echo 0)" ;;
  mark-user-config) exit 0 ;;
  install)
    # whether each paper lock is held while install runs (the round's reinstall holds the windows' alone);
    # -k keeps the file, which the round has open
    t=$("$CANON_GETCONF" DARWIN_USER_TEMP_DIR 2>/dev/null)
    for f in paper-windows paper-test alpaca-stream-tests alpaca-stream-windows; do
      if /usr/bin/lockf -k -t 0 "${t}canon-$f.lock" true 2>/dev/null; then echo "install: $f lock free" >> "$STUB/installers.log"
      else echo "install: $f lock held" >> "$STUB/installers.log"; fi
    done
    if /usr/bin/lockf -k -t 0 "$CLAUDE_CONFIG_DIR/canon/paper-checkout.lock" true 2>/dev/null; then echo "install: paper-checkout lock free" >> "$STUB/installers.log"
    else echo "install: paper-checkout lock held" >> "$STUB/installers.log"; fi
    d="gui/$(id -u)"
    for l in local.canon.maintenance local.canon.lanes-watch local.canon.paper-session local.canon.otel-collector local.canon.omniroute; do
      [ "${2:-}" != --defer-paper ] || [ "$l" != local.canon.paper-session ] || continue
      launchctl bootout "$d/$l" 2>/dev/null
      sleep "$(cat "$STUB/install-secs" 2>/dev/null || echo 0)"
      launchctl bootstrap "$d" "$HOME/Library/LaunchAgents/$l.plist"
    done
    if [ -f "$STUB/install-waits" ]; then for _ in $(seq 1 3000); do [ ! -f "$STUB/install-go" ] || break; sleep 0.1; done; fi
    cat "$STUB/install-out" 2>/dev/null
    echo "install finished" >> "$STUB/installers.log"
    exit "$(cat "$STUB/install-rc" 2>/dev/null || echo 0)" ;;
esac
exit 2
EOF
cat > "$OW/scripts/bootstrap" <<'EOF'
#!/bin/bash
echo "bootstrap $*" >> "$STUB/installers.log"
[ ! -f "$STUB/bootstrap-hangs" ] || sleep 60
cat "$STUB/bootstrap-out" 2>/dev/null
exit "$(cat "$STUB/bootstrap-rc" 2>/dev/null || echo 0)"
EOF
chmod +x "$OW/scripts/automation" "$OW/scripts/bootstrap"; echo 1 > "$OW/tracked"
# main's registry: the pins (d) reads, as canon/upstreams.json gives them; oreg <id> <track> moves one
mkdir -p "$OW/canon"
jq -n '{upstreams: [{id: "mise", track: "tag:v2026.11.5"}, {id: "codex-cli", track: "tag:rust-v0.167.0"},
        {id: "pnpm", track: "tag:v10.34.9"}, {id: "deepseek-harness", track: "tag:dsh-v0.2.1-rc.3"},
        {id: "dsh-tui", track: "tag:v0.17.0"}]}' > "$OW/canon/upstreams.json"
oreg() { jq --arg id "$1" --arg t "$2" '(.upstreams[] | select(.id == $id) | .track) = $t' "$OW/canon/upstreams.json" > "$OW/canon/u.t" && mv "$OW/canon/u.t" "$OW/canon/upstreams.json"; }
# mise's global config as on this machine: every tool at main's pin
mkdir -p "$STUB/global"; echo 0.167.0 > "$STUB/global/codex"; echo 10.34.9 > "$STUB/global/pnpm"
echo 0.2.1-rc.3 > "$STUB/global/npm__deepseek-ai_dsh"; echo 0.17.0 > "$STUB/global/npm__deepseek-harness-tui_dsh-tui"
ocommit() { git -C "$OW" add -A && git -C "$OW" -c user.name=t -c user.email=t@example.com commit -qm "$1" && git -C "$OW" push -q "$O" HEAD:main; }
ocommit first
git clone -q "$O" "$R"
git -C "$R" config user.name t; git -C "$R" config user.email t@example.com

MS="$W/maintenance-status.json"; MU="$W/maintenance-updates.json"
# round: one round as launchd runs it, in a process group of its own (as a launchd job is), whose id the
# stand-in launchctl kills at the job's bootout; once the round exits, launchd's kill of what is left of the
# group (no AbandonProcessGroup) is done too, the worst case
round() {
  : > "$TMP/round.out"
  set -m
  env -i HOME="$H" CLAUDE_CONFIG_DIR="$AH" STUB="$STUB" CANON_GETCONF="$B/getconf" \
      CANON_MAINTENANCE_FETCH_SECS="${FETCH_SECS:-30}" CANON_MAINTENANCE_STEP_SECS="${STEP_SECS:-30}" \
      CANON_MAINTENANCE_UPDATE_SECS="${UPDATE_SECS:-30}" CANON_MAINTENANCE_BOUNDARY_SECS="${BOUNDARY_SECS:-47}" \
      CANON_MAINTENANCE_BOUNDARY_ROUND_SECS=10 \
      /bin/bash "$ROOT/home/.claude/canon/maintenance.sh" "$R" "$B/mise" >> "$TMP/round.out" 2>&1 &
  local p=$!
  set +m
  echo "$p" > "$STUB/pgid-local.canon.maintenance"
  wait "$p"; RC=$?; ROUNDPG=$p; export RC ROUNDPG
  sed -n 's/.*a waiter waits for the windows. lock as process \([0-9]*\)$/\1/p' "$TMP/round.out" >> "$TMP/waiters"
  kill -KILL -- "-$p" 2>/dev/null
  rm -f "$STUB/pgid-local.canon.maintenance"
  return 0
}
# freed <lock file> [tenths]: true once the lock is free, polled for up to 5 s or the tenths given (-k keeps
# the file)
freed() { local i; for i in $(seq 1 "${2:-50}"); do /usr/bin/lockf -k -t 0 "$1" true 2>/dev/null && return 0; sleep 0.1; done; return 1; }
# settled: wait, at most 30 s each, for a reinstall the round started to report, and then for the round's
# lock, which that reinstall holds until it has exited: a round started before then finds it held and does
# nothing
# release <file>: the stand-in takelock started lets its lock go; returns once it is free
release() { : > "$STUB/release"; freed "$1" 300 || t_fail "the stand-in let go of $1 when released"; rm -f "$STUB/release"; }
settled() {
  local i
  for i in $(seq 1 60); do jqt "$MS" '.install == null or .install.state != "started"' && break; sleep 0.5; done
  jqt "$MS" '.install == null or .install.state != "started"' && freed "$AH/canon/maintenance.lock" 300
}
logs_clear() { : > "$STUB/installers.log"; : > "$STUB/updates.log"; : > "$STUB/mise.log"; : > "$STUB/launchctl.log"; }
head_is_origin() { [ "$(git -C "$R" rev-parse HEAD)" = "$(git -C "$O" rev-parse main)" ]; }

echo "maintenance rounds:"
logs_clear; echo 2 > "$OW/tracked"; ocommit second
round
check "fast-forward: the checkout on main, clean and behind, is brought to origin/main" \
      eval '[ "$RC" = 0 ] && head_is_origin && jqt "$MS" ".ff | startswith(\"fast-forwarded \")"'
check "... it asked what differs from the tree, from the checkout" grep -q '^automation differs ' "$STUB/installers.log"
check "... nothing differed: no installer ran, the record says ok and nothing installed" \
      eval '! grep -Eq "^(bootstrap|automation install)" "$STUB/installers.log" && jqt "$MS" ".outcome == \"ok\" and .found == [] and .installed == [] and .failed == []"'
check "... each step logged" eval 'grep -q "(a) fast-forwarded" "$TMP/round.out" && grep -q "(b) compare" "$TMP/round.out" && grep -q "(c) runtime updates" "$TMP/round.out"'
check "... the daily updates ran: claude update and agy update, nothing else" \
      eval '[ "$(cat "$STUB/updates.log")" = "$(printf "claude update\nagy update")" ] && jqt "$MU" ".results == [\"claude: claude: updated (stand-in)\", \"agy: agy: updated (stand-in)\"]"'
check "... Codex, Muse Code, DeepSeek Harness and dsh-tui not updated by (c), said once in the log" \
      eval '! grep -Eiq "codex|dsh|muse" "$STUB/updates.log" && [ "$(grep -c "Codex, Muse Code, DeepSeek Harness and dsh-tui are not updated here" "$TMP/round.out")" = 1 ]'
check "... (d): mise and its global tools already at main's pins: nothing updated, each named" \
      eval '! grep -Eq "^mise (use|self-update)" "$STUB/mise.log" && jqt "$MS" ".pins == [\"mise: at 2026.11.5\", \"codex: at 0.167.0\", \"pnpm: at 10.34.9\", \"npm:@deepseek-ai/dsh: at 0.2.1-rc.3\", \"npm:@deepseek-harness-tui/dsh-tui: at 0.17.0\"]"'

logs_clear; round
check "nothing differs, at origin/main: no installer, no update within the day" \
      eval 'jqt "$MS" ".ff | startswith(\"at origin/main \")" && [ ! -s "$STUB/updates.log" ] && ! grep -Eq "^(bootstrap|automation install)" "$STUB/installers.log" && grep -q "ran less than a day ago" "$TMP/round.out"'

# a tracked change: skipped, nothing fetched or merged, the tree's state left as it is
echo 3 > "$OW/tracked"; ocommit third; echo dirty > "$R/tracked"; logs_clear; round
check "skipped on a dirty tree: SKIPPED, HEAD not moved, the change kept, no compare" \
      eval '[ "$RC" = 0 ] && ! head_is_origin && [ "$(cat "$R/tracked")" = dirty ] && jqt "$MS" ".outcome == \"skipped\" and (.ff | test(\"tracked changes\"))" && ! grep -q differs "$STUB/installers.log"'
git -C "$R" checkout -q -- tracked
git -C "$R" checkout -q -b other; logs_clear; round
check "skipped on another branch: SKIPPED naming it, no branch switched" \
      eval 'jqt "$MS" ".outcome == \"skipped\" and .ff == \"skipped: the checkout is on other, not main\"" && [ "$(git -C "$R" symbolic-ref --short HEAD)" = other ] && ! grep -q differs "$STUB/installers.log"'
git -C "$R" checkout -q main
git -C "$R" fetch -q origin && git -C "$R" merge -q --ff-only origin/main
git -C "$R" commit -q --allow-empty -m local; logs_clear; round
check "skipped when main has a commit origin lacks: nothing reset" \
      eval 'jqt "$MS" ".outcome == \"skipped\" and (.ff | test(\"commits origin/main lacks\"))" && [ "$(git -C "$R" log -1 --format=%s)" = local ]'
git -C "$R" reset -q --hard origin/main 2>/dev/null; git -C "$R" merge -q --ff-only origin/main

# the settings step
printf 'user-config: the settings sources changed since the last settings step\n' > "$STUB/differs-out"; echo 1 > "$STUB/differs-rc"
printf '  EXISTS     %s/settings.json differs; wrote settings.json.canon-proposed beside it. Merge by hand.\n' "$AH" > "$STUB/bootstrap-out"
logs_clear; round
check "installer run: bootstrap --user-config for a settings difference, then the step recorded" \
      eval 'grep -q "^bootstrap --user-config" "$STUB/installers.log" && grep -q "^automation mark-user-config" "$STUB/installers.log" && jqt "$MS" ".installed == [\"bootstrap --user-config\"] and .outcome == \"ok\" and (.found | length) == 1"'
check "... with the config folder the plist names, and a file left to merge said" \
      eval 'grep -q "^bootstrap --user-config.*" "$STUB/installers.log" && grep -q "cfg=$AH" "$STUB/installers.log" && jqt "$MS" ".note | test(\"left for the owner to merge: .*settings.json\")"'
check "... and no automation install for it" eval '! grep -q "^automation install" "$STUB/installers.log"'
echo 1 > "$STUB/bootstrap-rc"; logs_clear; round
check "installer failed: FAILED naming it, the step not recorded as applied" \
      eval 'jqt "$MS" ".outcome == \"failed\" and .failed == [\"bootstrap --user-config (exit 1)\"]" && ! grep -q mark-user-config "$STUB/installers.log"'
rm -f "$STUB/bootstrap-rc" "$STUB/bootstrap-out"

# the reinstall the agent starts: it unloads the agent's own job (whose process group the stand-in launchctl
# kills) and the round's group is killed once it ends; the reinstall must still finish and load all five
mkdir -p "$STUB/loaded"
for l in local.canon.maintenance local.canon.lanes-watch local.canon.paper-session local.canon.otel-collector local.canon.omniroute; do echo running > "$STUB/loaded/$l"; done
printf 'automation: %s/Library/LaunchAgents/local.canon.maintenance.plist differs from what install writes\n' "$H" > "$STUB/differs-out"
# the stand-in reinstall waits for install-go, so "at once" means before it ends, however loaded the machine;
# the compare takes 5 s, as on a loaded machine
echo 1 > "$STUB/install-secs"; : > "$STUB/install-waits"; : > "$STUB/differs-slow"; logs_clear; round; rm -f "$STUB/differs-slow"
check "the reinstall started by the agent: the round ends at once, with the reinstall running" \
      eval '[ "$RC" = 0 ] && grep -q "the reinstall runs on as process" "$TMP/round.out" && ! grep -q "^install finished" "$STUB/installers.log"'
: > "$STUB/install-go"; settled; rm -f "$STUB/install-waits" "$STUB/install-go"
check "... it completes, though its own job was booted out and the round's process group killed" \
      eval 'grep -q "^install finished" "$STUB/installers.log" && jqt "$MS" ".install.state == \"done\" and (.installed | index(\"automation install\")) != null"'
check "... and leaves all five agents loaded" \
      eval '[ "$(ls "$STUB/loaded" | wc -l | tr -d " ")" = 5 ]'
check "... holding the windows' lock while it installs, so no window starts meanwhile, and no other paper lock" \
      eval 'grep -qx "install: paper-windows lock held" "$STUB/installers.log" && grep -qx "install: paper-test lock free" "$STUB/installers.log" && grep -qx "install: alpaca-stream-tests lock free" "$STUB/installers.log" && grep -qx "install: alpaca-stream-windows lock free" "$STUB/installers.log"'
check "... and letting it go once it ends" freed "${LT}canon-paper-windows.lock"
jpg=$(grep -m1 'bootout.*local.canon.maintenance' "$STUB/launchctl.log" >/dev/null && echo seen)
ipg=$(sed -n 's/^automation install | pgid=\([0-9]*\).*/\1/p' "$STUB/installers.log"); export ipg
check "... in a process group of its own, which the job's bootout did not reach (bootout ${jpg:-not seen})" \
      eval '[ -n "$ipg" ] && [ "$ipg" != "$ROUNDPG" ] && [ "$jpg" = seen ] && ! grep -q "Boot-out failed" "$STUB/launchctl.log"'
check "... and the record keeps it as the last change" jqt "$MS" '.last_change.installed == ["automation install"]'
rm -f "$STUB/install-secs" "$STUB/differs-out"; round
check "... and once nothing differs, the install it tried is forgotten" jqt "$MS" '.tried == null and .outcome == "ok"'
printf 'automation: %s/Library/LaunchAgents/local.canon.maintenance.plist differs from what install writes\n' "$H" > "$STUB/differs-out"
printf 'install: FAILED (exit 1):\n  FAILED: could not install %s/.claude/canon/lanes\n' "$H" > "$STUB/install-out"; echo 1 > "$STUB/install-rc"
logs_clear; round; settled
check "an automation install that fails: FAILED, naming what install repeated after its table" \
      eval 'jqt "$MS" ".outcome == \"failed\" and .install.state == \"failed\" and (.failed | index(\"could not install '"$H"'/.claude/canon/lanes\")) != null"'
rm -f "$STUB/install-out" "$STUB/install-rc"
# the reinstall reports, then logs and exits, holding the round's lock until it has: a stand-in holds it 2 s
# past the report, the slow end a loaded machine gives it (seen once at a load average of 34 to 57)
/usr/bin/lockf -k "$AH/canon/maintenance.lock" sleep 2 & HOLDERS="$HOLDERS $!"; sleep 0.3
settled; logs_clear; round
check "the same differences again within a day: install not repeated, FAILED saying so (each install restarts the paper interval)" \
      eval '! grep -q "^automation install" "$STUB/installers.log" && jqt "$MS" ".outcome == \"failed\" and (.failed | map(test(\"^automation install not repeated\")) | any)"'
jq '.tried.at_epoch -= 86401' "$MS" > "$MS.t" && mv "$MS.t" "$MS"; logs_clear; round; settled
check "... a day later: repeated" grep -q "^automation install" "$STUB/installers.log"
logs_clear; round
check "... and not again after it finished, at the same origin/main" eval '! grep -q "^automation install" "$STUB/installers.log"'
echo 3b > "$OW/tracked"; ocommit same-file-again; logs_clear; round; settled
check "the same differences at a new origin/main: installed again" eval 'grep -q "^automation install" "$STUB/installers.log" && jqt "$MS" ".tried.commit == \"$(git -C "$O" rev-parse main)\""'
cp "$STUB/differs-out" "$TMP/differs-out.kept"; echo 'unknown: launchctl did not answer about local.canon.paper-session' > "$STUB/differs-out"; echo 2 > "$STUB/differs-rc"
round
check "a compare that failed: FAILED, and the install tried is not forgotten" jqt "$MS" '.outcome == "failed" and .tried != null and (.failed | map(test("^compare: launchctl did not answer")) | any)'
mv "$TMP/differs-out.kept" "$STUB/differs-out"; echo 1 > "$STUB/differs-rc"
echo 3c > "$OW/tracked"; ocommit timed-out; echo 1 > "$STUB/install-secs"; logs_clear; STEP_SECS=2 round; settled
check "an install that timed out: FAILED, timeout named" jqt "$MS" '.install.state == "failed" and .tried.timeout == true and (.failed | index("automation install (timeout after 2 s)")) != null'
rm -f "$STUB/install-secs"; for l in local.canon.maintenance local.canon.lanes-watch local.canon.paper-session local.canon.otel-collector local.canon.omniroute; do echo running > "$STUB/loaded/$l"; done
logs_clear; round; settled
check "... retried at the next round, at the same origin/main" eval 'grep -q "^automation install" "$STUB/installers.log" && jqt "$MS" ".install.state == \"done\""'
echo 3d > "$OW/tracked"; ocommit window-meanwhile; echo "${LT}canon-paper-windows.lock" > "$STUB/differs-takes-lock"; logs_clear; round
settled
check "a window that took its lock during the compare: the install runs at once without the paper section, nothing deferred" \
      eval 'grep -q "^automation install --defer-paper " "$STUB/installers.log" && grep -q "^install finished" "$STUB/installers.log" && jqt "$MS" ".install.state == \"done\" and .deferred == null"'
rm -f "$STUB/differs-takes-lock"; release "${LT}canon-paper-windows.lock"; logs_clear; round; settled
check "... and the same differences are not installed again once the window has ended" \
      eval '! grep -q "^automation install" "$STUB/installers.log" && jqt "$MS" "(.failed | map(test(\"^automation install not repeated\")) | any)"'
echo 3e > "$OW/tracked"; ocommit test-meanwhile; echo "${LT}canon-paper-test.lock" > "$STUB/differs-takes-lock"; logs_clear; round; settled
check "a paper test that took its lock during the compare: the install runs all the same, since it touches nothing account A uses" \
      eval 'grep -q "^install finished" "$STUB/installers.log" && grep -qx "install: paper-test lock held" "$STUB/installers.log" && jqt "$MS" ".install.state == \"done\""'
rm -f "$STUB/differs-takes-lock"; release "${LT}canon-paper-test.lock"
rm -f "$STUB/differs-out" "$STUB/differs-rc"; round

# a window runs (account B's lock held): only the paper section waits, for the session boundary
BF="$W/maintenance-boundary.json"
# waiting_waiters: how many of the boundary waiters this test's rounds started are alive; no_waiter: none
# is, polled for up to 5 s (one that has run its round is ending)
waiting_waiters() { local p n=0; while read -r p; do ! kill -0 "$p" 2>/dev/null || n=$((n + 1)); done < <(cat "$TMP/waiters" 2>/dev/null); echo "$n"; }
no_waiter() { local i; for i in $(seq 1 50); do [ "$(waiting_waiters)" = 0 ] && return 0; sleep 0.1; done; return 1; }
# group_cpu <process group>: the CPU seconds its processes have used, summed (ps(1) time, [[h:]m:]s)
group_cpu() {
  local l; l=$(pgrep -d, -g "$1" 2>/dev/null) || { echo 0; return; }
  ps -o time= -p "$l" | awk '{ n = split($1, a, ":"); s = a[n] + (n > 1 ? a[n-1] * 60 : 0) + (n > 2 ? a[n-2] * 3600 : 0); t += s } END { print t + 0 }'
}
# boundary_is <state>: maintenance-boundary.json says it, polled for up to 60 s
boundary_is() { local i; for i in $(seq 1 120); do jqt "$BF" ".state == \"$1\"" && return 0; sleep 0.5; done; return 1; }
for l in local.canon.maintenance local.canon.lanes-watch local.canon.paper-session local.canon.otel-collector local.canon.omniroute; do echo running > "$STUB/loaded/$l"; done
PDIFF="automation: $AH/canon/paper-session.sh differs from home/.claude/canon/paper-session.sh"
printf '%s\nautomation: %s/Library/LaunchAgents/local.canon.lanes-watch.plist differs from what install writes\n' "$PDIFF" "$H" > "$STUB/differs-out"; echo 1 > "$STUB/differs-rc"
echo 4 > "$OW/tracked"; ocommit fourth
/usr/bin/lockf -k "${LT}canon-paper-windows.lock" sleep 60 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; round; settled
check "a window's lock held: the main checkout still moves to origin/main" \
      eval '[ "$RC" = 0 ] && head_is_origin && jqt "$MS" "(.ff | startswith(\"fast-forwarded \")) and .outcome == \"ok\""'
check "... the other agents are installed at once, the paper section left out (install --defer-paper)" \
      eval 'grep -q "^automation install --defer-paper " "$STUB/installers.log" && grep -q "^install finished" "$STUB/installers.log" && ! grep -q "bootout.*local.canon.paper-session" "$STUB/launchctl.log" && jqt "$MS" ".install.state == \"done\" and .tried.found == [\"automation: $H/Library/LaunchAgents/local.canon.lanes-watch.plist differs from what install writes\"]"'
check "... the paper checkout deferred to the session boundary, so named in the record" \
      jqt "$MS" '.deferred.what == "the paper checkout" and (.note | test("deferred to the session boundary: the paper checkout"))'
check "... one waiter waits for the windows' lock" eval 'jqt "$BF" ".state == \"waiting\"" && [ "$(waiting_waiters)" = 1 ]'
# lockf(1) -t on a descriptor spins a core while it waits (measured: 70-98% CPU), so the waiter polls asleep
wp=$(tail -n 1 "$TMP/waiters"); c0=$(group_cpu "$wp"); sleep 4; c1=$(group_cpu "$wp")
check "... and waits asleep: under 1 s of CPU in 4 s ($c0 -> $c1), and no wait on a lock uses lockf's own -t" \
      eval '[ -n "$wp" ] && kill -0 "$wp" 2>/dev/null && awk -v a="$c0" -v b="$c1" "BEGIN { exit !(b - a < 1) }" && ! grep -Eq "lockf (-[a-z]+ )*-t +[^0 ]" "$ROOT/home/.claude/canon/maintenance.sh"'
since=$(jq -r '.deferred.since' "$MS")
printf '%s\n' "$PDIFF" > "$STUB/differs-out"; logs_clear; round
check "a second round while the window runs: no second waiter, no install, the first deferral's time kept" \
      eval 'grep -q "a boundary waiter is already waiting; none added" "$TMP/round.out" && [ "$(waiting_waiters)" = 1 ] && ! grep -q "^automation install" "$STUB/installers.log" && jqt "$MS" ".deferred.since == \"$since\""'
# the runner still holds the clone's lock for 4 s after the window's task has let the windows' lock go
/usr/bin/lockf -k "$AH/canon/paper-checkout.lock" sleep 4 & HOLDERS="$HOLDERS $!"; sleep 0.3
logs_clear; kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null
boundary_is ran; settled
check "the window's lock goes free: the waiter's round installs the whole, paper section included, holding that lock" \
      eval 'grep -q "^automation install | " "$STUB/installers.log" && grep -qx "install: paper-windows lock held" "$STUB/installers.log" && jqt "$MS" ".at_boundary == true and .deferred == null and .install.state == \"done\""'
check "... once the runner on its way out has let the clone's own lock go too" grep -qx "install: paper-checkout lock free" "$STUB/installers.log"
check "... it skips the daily updates, moves no pin already at main's, and leaves no waiter" \
      eval '[ ! -s "$STUB/updates.log" ] && ! grep -Eq "^mise (use|self-update)" "$STUB/mise.log" && jqt "$MS" "(.pins | length) == 5" && no_waiter'
check "... and the windows' lock is let go once its install ends" freed "${LT}canon-paper-windows.lock"
# the boundary's round ended before its install, on a paper test's lock: said, and the deferral stays
/usr/bin/lockf -k "${LT}canon-paper-windows.lock" sleep 60 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; round
/usr/bin/lockf -k "${LT}canon-paper-test.lock" sleep 60 & HOLDERS="$HOLDERS $!"; tp=$!; sleep 0.5
kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null
boundary_is missed
check "a boundary round that a paper test's lock ends before its install: said so, the deferral kept" \
      eval 'jqt "$BF" ".why | test(\"ended waited before its install\")" && jqt "$MS" ".deferred != null" && ! grep -q "^automation install | " "$STUB/installers.log" && no_waiter'
kill "$tp" 2>/dev/null; wait "$tp" 2>/dev/null
echo 4b > "$OW/tracked"; ocommit fourth-b
/usr/bin/lockf -k "${LT}canon-paper-windows.lock" sleep 30 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; BOUNDARY_SECS=2 round
boundary_is "timed out"
check "a waiter whose bound passes with the window's lock still held: timed out, by name" \
      eval 'jqt "$BF" ".why == \"the windows'"'"' lock stayed held for 2 s\"" && jqt "$MS" ".deferred != null" && no_waiter'
kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null
logs_clear; round; settled
check "... and the next round with no window installs the whole, clearing the deferral" \
      eval 'grep -q "^automation install | " "$STUB/installers.log" && jqt "$MS" ".deferred == null and .at_boundary == false"'
rm -f "$STUB/differs-out" "$STUB/differs-rc"; round
# a paper test's lock, or the stream's with no window: those runs may run from the checkout, so nothing
echo 4c > "$OW/tracked"; ocommit fourth-c
for hl in "canon-paper-test.lock:a paper test" "canon-alpaca-stream-tests.lock:a run on account A's market-data stream"; do
  /usr/bin/lockf -k "${LT}${hl%%:*}" sleep 30 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
  logs_clear; round; export HL="${hl%%:*} is held: ${hl#*:}"
  check "${hl%%:*} held (${hl#*:}): the round does nothing, naming it" \
        eval '[ "$RC" = 0 ] && ! head_is_origin && [ ! -s "$STUB/installers.log" ] && [ ! -s "$STUB/updates.log" ] && jqt "$MS" ".outcome == \"waited\" and (.ff | test(\"paper lock is held\")) and (.ff | contains(env.HL))"'
  kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null
done
# a window on B and a stream on account A's pair at once (each pair has its own stream lock, ADR 0069): the
# stream may run from the checkout, so the round does nothing, though a window runs too
echo 4d > "$OW/tracked"; ocommit fourth-d
/usr/bin/lockf -k "${LT}canon-paper-windows.lock" sleep 30 & HOLDERS="$HOLDERS $!"; wh=$!
/usr/bin/lockf -k "${LT}canon-alpaca-stream-tests.lock" sleep 30 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; round; export HL="canon-alpaca-stream-tests.lock is held"
check "a window runs and account A's stream lock is held: the round does nothing, naming the stream" \
      eval '[ "$RC" = 0 ] && ! head_is_origin && [ ! -s "$STUB/installers.log" ] && [ ! -s "$STUB/updates.log" ] && jqt "$MS" ".outcome == \"waited\" and (.ff | contains(env.HL))"'
kill "$hp" "$wh" 2>/dev/null; wait "$hp" "$wh" 2>/dev/null
# its own lock held (a reinstall still running): nothing, and the record left as it was
cp "$MS" "$TMP/ms.before"
/usr/bin/lockf -k "$AH/canon/maintenance.lock" sleep 30 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; round
check "its own lock held: nothing this round, the record unchanged" \
      eval '[ "$RC" = 0 ] && cmp -s "$MS" "$TMP/ms.before" && [ ! -s "$STUB/installers.log" ] && grep -q "still runs; nothing this round" "$TMP/round.out"'
kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null

# timeouts: a fetch that hangs (the origin's upload-pack, git-config(1) remote.<name>.uploadpack), and an
# installer that hangs
rm -f "$STUB/differs-out" "$STUB/differs-rc"
printf '#!/bin/bash\nsleep 60\n' > "$STUB/hang-upload-pack"; chmod +x "$STUB/hang-upload-pack"
git -C "$R" config remote.origin.uploadpack "$STUB/hang-upload-pack"
logs_clear; s0=$(date +%s); FETCH_SECS=2 round; took=$(( $(date +%s) - s0 ))
check "a timeout: a fetch that hangs is stopped at its bound (${took} s), FAILED naming it" \
      eval '[ "$took" -lt 15 ] && jqt "$MS" ".outcome == \"failed\" and (.failed | index(\"fetch (timeout)\")) != null and (.ff | test(\"did not finish within 2 s\"))"'
check "... and with origin/main not known, nothing compared or installed" eval '! grep -q differs "$STUB/installers.log"'
git -C "$R" config --unset remote.origin.uploadpack
printf 'user-config: x\n' > "$STUB/differs-out"; echo 1 > "$STUB/differs-rc"; : > "$STUB/bootstrap-hangs"
logs_clear; s0=$(date +%s); STEP_SECS=2 round; took=$(( $(date +%s) - s0 ))
check "... and an installer that hangs (${took} s): FAILED, timeout named" \
      eval '[ "$took" -lt 15 ] && jqt "$MS" ".failed == [\"bootstrap --user-config (timeout after 2 s)\"]"'
rm -f "$STUB/bootstrap-hangs" "$STUB/differs-out" "$STUB/differs-rc"

# the daily updates: due again after a day; one that fails is FAILED; one that hangs is stopped
jq '.at_epoch -= 86401' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; echo 1 > "$STUB/claude-rc"; logs_clear; round
check "updates a day later: run again; a failed claude update is FAILED by name, agy still updated" \
      eval 'grep -q "^claude update" "$STUB/updates.log" && grep -q "^agy update" "$STUB/updates.log" && jqt "$MS" "(.failed | map(test(\"^claude update exited 1\")) | any)"'
rm -f "$STUB/claude-rc"; jq '.at_epoch -= 86401' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; : > "$STUB/agy-hangs"
logs_clear; s0=$(date +%s); UPDATE_SECS=2 round; took=$(( $(date +%s) - s0 ))
check "... an update that hangs is stopped at its bound (${took} s)" \
      eval '[ "$took" -lt 15 ] && jqt "$MU" "(.results | map(test(\"agy update did not finish within 2 s\")) | any)"'
rm -f "$STUB/agy-hangs"; mv "$STUB/agy" "$STUB/agy.away"; jq '.at_epoch -= 86401' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; logs_clear; round
check "... agy not installed: said, not a failure" eval 'jqt "$MU" ".results[1] == \"agy: not installed\"" && jqt "$MS" ".failed == []"'
mv "$STUB/agy.away" "$STUB/agy"
jq '.at_epoch -= 86401' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; echo "${LT}canon-paper-windows.lock" > "$STUB/claude-takes-lock"
echo 5 > "$OW/tracked"; ocommit fifth; logs_clear; round
check "the updates run with the paper lock let go; a window that took its lock meanwhile does not hold the checkout back" \
      eval '[ "$RC" = 0 ] && grep -q "^claude update" "$STUB/updates.log" && head_is_origin && jqt "$MS" ".outcome == \"ok\" and .deferred == null"'
rm -f "$STUB/claude-takes-lock"; release "${LT}canon-paper-windows.lock"; round
# with agy's update after it slow, as on a loaded machine: the lock the stand-in took is still held at the retake
jq '.at_epoch -= 86401' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; echo "${LT}canon-paper-test.lock" > "$STUB/claude-takes-lock"; : > "$STUB/agy-slow"
echo 6 > "$OW/tracked"; ocommit sixth; logs_clear; round; rm -f "$STUB/agy-slow"
check "a paper test that took its lock during the updates, slow as they were: the round ends there, before the fast-forward" \
      eval '[ "$RC" = 0 ] && ! head_is_origin && [ ! -s "$STUB/installers.log" ] && jqt "$MS" ".outcome == \"waited\" and (.ff | test(\"during the updates \\\\(canon-paper-test.lock is held\"))"'
rm -f "$STUB/claude-takes-lock"; release "${LT}canon-paper-test.lock"; round

# (d) the exact pins main's registry records
oreg codex-cli tag:rust-v0.167.1; oreg mise tag:v2026.11.6; echo 7 > "$OW/tracked"; ocommit pins-moved; logs_clear; round
check "pins: codex's pin moved on main: brought to it with mise use --global, from HOME" \
      eval 'grep -q "^mise use --global --yes codex@0.167.1 " "$STUB/mise.log" && [ "$(cat "$STUB/global/codex")" = 0.167.1 ] && jqt "$MS" "(.pins | index(\"codex: 0.167.0 -> 0.167.1\")) != null and .outcome == \"ok\""'
check "... and mise's own pin: mise self-update to that version, plugins left alone" \
      eval 'grep -q "^mise self-update --yes --no-plugins 2026.11.6 " "$STUB/mise.log" && jqt "$MS" "(.pins | index(\"mise: 2026.11.5 -> 2026.11.6\")) != null"'
check "... the tools already at their pins left alone" eval '[ "$(grep -c "^mise use " "$STUB/mise.log")" = 1 ]'
logs_clear; round
check "... and the next round, at the pins, updates nothing" eval '! grep -Eq "^mise (use|self-update)" "$STUB/mise.log" && jqt "$MS" ".pins[0:2] == [\"mise: at 2026.11.6\", \"codex: at 0.167.1\"]"'
oreg pnpm tag:v10.35.0; echo 8 > "$OW/tracked"; ocommit pnpm-moved; echo 1 > "$STUB/use-rc"; logs_clear; round
check "an update that fails: FAILED by name, with mise's message" \
      eval 'jqt "$MS" ".outcome == \"failed\" and (.failed | index(\"pin pnpm: mise use pnpm@10.35.0 exited 1: mise ERROR stand-in could not install pnpm@10.35.0\")) != null"'
rm -f "$STUB/use-rc"; echo 1 > "$STUB/self-update-rc"; oreg mise tag:v2026.11.7; echo 9 > "$OW/tracked"; ocommit mise-moved; logs_clear; round
check "... a self-update that fails: FAILED by name" jqt "$MS" '(.failed | map(test("^pin mise: self-update to 2026.11.7 exited 1")) | any)'
rm -f "$STUB/self-update-rc"; rm -f "$STUB/global/npm__deepseek-harness-tui_dsh-tui"; logs_clear; round
check "... a tool not in mise's global config is not installed, only said" \
      eval '! grep -q "^mise use --global --yes npm:@deepseek-harness-tui" "$STUB/mise.log" && jqt "$MS" "(.pins | index(\"npm:@deepseek-harness-tui/dsh-tui: not in mise'"'"'s global config; left alone\")) != null and .outcome == \"ok\""'
echo 0.17.0 > "$STUB/global/npm__deepseek-harness-tui_dsh-tui"
oreg codex-cli tag:rust-v0.167.2; echo 10 > "$OW/tracked"; ocommit codex-moved-in-a-window
/usr/bin/lockf -k "${LT}canon-paper-windows.lock" sleep 60 & HOLDERS="$HOLDERS $!"; hp=$!; sleep 0.5
logs_clear; round
check "a pin that moved while a window runs: not moved under it, waits for the session boundary, a waiter armed" \
      eval '! grep -q "^mise use" "$STUB/mise.log" && [ "$(cat "$STUB/global/codex")" = 0.167.1 ] && jqt "$MS" "(.pins | index(\"codex: 0.167.1 -> 0.167.2 at the session boundary\")) != null" && [ "$(waiting_waiters)" = 1 ]'
logs_clear; kill "$hp" 2>/dev/null; wait "$hp" 2>/dev/null
boundary_is ran; settled
check "... and the boundary's round brings it to its pin" \
      eval 'grep -q "^mise use --global --yes codex@0.167.2 " "$STUB/mise.log" && [ "$(cat "$STUB/global/codex")" = 0.167.2 ] && jqt "$MS" ".at_boundary == true"'

# ---------- scripts/automation: the plists, differs and the rows ----------
echo "scripts/automation:"
A="$TMP/repo"; mkdir -p "$A/scripts" "$A/home/.claude/canon" "$A/home/.codex" "$A/canon" "$A/.githooks"
cp "$ROOT/scripts/automation" "$ROOT/scripts/lanes" "$ROOT/scripts/bootstrap" "$A/scripts/"
cp "$ROOT/home/.claude/canon/"*.sh "$A/home/.claude/canon/"; cp -R "$ROOT/home/.claude/canon/otel" "$A/home/.claude/canon/"
cp "$ROOT/home/.claude/settings.json" "$ROOT/home/.claude/CLAUDE.md" "$A/home/.claude/"; cp "$ROOT/home/.codex/"* "$A/home/.codex/"
cp "$ROOT/canon/models.json" "$ROOT/mise.gateway.toml" "$A/"; mv "$A/models.json" "$A/canon/"
printf '#!/bin/bash\nexit 0\n' > "$A/.githooks/pre-commit"; chmod +x "$A/.githooks/pre-commit"
git -C "$A" init -q -b main && git -C "$A" remote add origin "$O"
# install's paper step clones the origin; with a local path, its stand-in mise is never run
LA="$H/Library/LaunchAgents"; MP="$LA/local.canon.maintenance.plist"; GP="$LA/local.canon.omniroute.plist"
ainst() { env -i HOME="$H" PATH="$B:/usr/bin:/bin:/usr/sbin:/sbin" STUB="$STUB" CLAUDE_CONFIG_DIR="$AH" CANON_GETCONF="$B/getconf" "$@" "$A/scripts/automation" install > "$TMP/inst.out" 2>&1; }
adiff() { env -i HOME="$H" PATH="$B:/usr/bin:/bin:/usr/sbin:/sbin" STUB="$STUB" CLAUDE_CONFIG_DIR="$AH" CANON_GETCONF="$B/getconf" "$@" "$A/scripts/automation" differs > "$TMP/diff.out" 2>&1; }
astat() { env -i HOME="$H" PATH="$B:/usr/bin:/bin:/usr/sbin:/sbin" STUB="$STUB" CLAUDE_CONFIG_DIR="$AH" CANON_GETCONF="$B/getconf" CANON_CURL="$B/gwcurl" "$A/scripts/automation" status > "$TMP/stat.out" 2>&1; }
rm -rf "$STUB/loaded"; logs_clear
ainst AUTOMATION_SKIP_LAUNCHD=1; rc=$?
check "rehearsal install: exit 0, the maintenance agent's script installed" \
      eval '[ "$rc" = 0 ] && cmp -s "$ROOT/home/.claude/canon/maintenance.sh" "$AH/canon/maintenance.sh"'
margs=""; for i in 0 1 2 3; do margs="$margs|$(plutil -extract "ProgramArguments.$i" raw -o - "$MP" 2>/dev/null)"; done
check "... its plist: the script on this clone with the mise install found" test "$margs" = "|/bin/bash|$AH/canon/maintenance.sh|$A|$B/mise"
check "... every 30 minutes, not at load, its process group abandoned, CLAUDE_CONFIG_DIR the install's" \
      eval '[ "$(plutil -extract StartInterval raw -o - "$MP")" = 1800 ] && [ "$(plutil -extract RunAtLoad raw -o - "$MP")" = false ] && [ "$(plutil -extract AbandonProcessGroup raw -o - "$MP")" = true ] && [ "$(plutil -extract EnvironmentVariables.CLAUDE_CONFIG_DIR raw -o - "$MP")" = "$AH" ]'
SP="$LA/local.canon.nightly-study.plist"
sargs=""; for i in 0 1 2 3; do sargs="$sargs|$(plutil -extract "ProgramArguments.$i" raw -o - "$SP" 2>/dev/null)"; done
check "... the nightly study's agent runs mise.toml's own task, study:nightly, in this clone" \
      eval '[ "$sargs" = "|$B/mise|run|study:nightly|" ] && [ "$(plutil -extract WorkingDirectory raw -o - "$SP")" = "$A" ]'
check "... every 30 minutes, not at load, with no install by mise and only PATH besides" \
      eval '[ "$(plutil -extract StartInterval raw -o - "$SP")" = 1800 ] && [ "$(plutil -extract RunAtLoad raw -o - "$SP")" = false ] && [ "$(plutil -extract EnvironmentVariables.MISE_TASK_RUN_AUTO_INSTALL raw -o - "$SP")" = false ] && [ "$(plutil -extract EnvironmentVariables.PATH raw -o - "$SP")" = /usr/bin:/bin:/usr/sbin:/sbin ] && [ "$(plutil -extract EnvironmentVariables raw -o - "$SP" | wc -l | tr -d " ")" = 2 ]'
check "... OmniRoute not installed: no gateway agent, said" eval '[ ! -e "$GP" ] && grep -q "skipped    OmniRoute is not installed for this clone" "$TMP/inst.out"'
: > "$STUB/omniroute-installed"; ainst AUTOMATION_SKIP_LAUNCHD=1; rc=$?
gargs=""; for i in 0 1 2 3 4; do gargs="$gargs|$(plutil -extract "ProgramArguments.$i" raw -o - "$GP" 2>/dev/null)"; done
check "OmniRoute installed: the gateway agent runs mise.gateway.toml's own task in this clone" \
      eval '[ "$rc" = 0 ] && [ "$gargs" = "|$B/mise|-E|gateway|run|omniroute:serve" ] && [ "$(plutil -extract WorkingDirectory raw -o - "$GP")" = "$A" ]'
check "... kept alive and started at load, with no install by mise and only PATH besides" \
      eval '[ "$(plutil -extract KeepAlive raw -o - "$GP")" = true ] && [ "$(plutil -extract RunAtLoad raw -o - "$GP")" = true ] && [ "$(plutil -extract EnvironmentVariables.MISE_TASK_RUN_AUTO_INSTALL raw -o - "$GP")" = false ] && [ "$(plutil -extract EnvironmentVariables.PATH raw -o - "$GP")" = /usr/bin:/bin:/usr/sbin:/sbin ]'
check "... named by a checksum of mise.gateway.toml, so a change to the task changes the plist" \
      test "$(plutil -extract EnvironmentVariables.CANON_GATEWAY_CONFIG raw -o - "$GP")" = "$(cksum < "$A/mise.gateway.toml" | awk '{ print $1 "-" $2 }')"

# differs, after that install and once the settings step is recorded: nothing
cp "$ROOT/home/.claude/canon/ledger.sh" "$ROOT/home/.claude/canon/statusline.sh" "$AH/canon/"
env -i HOME="$H" PATH="$B:/usr/bin:/bin" CLAUDE_CONFIG_DIR="$AH" "$A/scripts/automation" mark-user-config >/dev/null 2>&1
adiff AUTOMATION_SKIP_LAUNCHD=1; rc=$?
check "differs right after install and the settings step: nothing, exit 0" eval '[ "$rc" = 0 ] && [ ! -s "$TMP/diff.out" ]'
mv "$SP" "$SP.kept"; adiff AUTOMATION_SKIP_LAUNCHD=1; rc=$?
check "... the nightly study's agent not written yet, as on a machine installed before it: an automation line, exit 1" \
      eval '[ "$rc" = 1 ] && [ "$(cat "$TMP/diff.out")" = "automation: $SP differs from what install writes" ]'
mv "$SP.kept" "$SP"
echo "# changed on main" >> "$A/home/.claude/canon/lanes-watch.sh"; echo "# changed" >> "$A/mise.gateway.toml"
adiff AUTOMATION_SKIP_LAUNCHD=1; rc=$?
check "... a script and the gateway task changed on main: automation lines for each, exit 1" \
      eval '[ "$rc" = 1 ] && grep -q "^automation: $AH/canon/lanes-watch.sh differs from home/.claude/canon/lanes-watch.sh" "$TMP/diff.out" && grep -q "^automation: $GP differs" "$TMP/diff.out" && ! grep -q "^user-config" "$TMP/diff.out"'
mkdir -p "$H/.codex"; adiff AUTOMATION_SKIP_LAUNCHD=1
check "... Codex's folder made since the settings step: a user-config line" grep -q '^user-config: the settings sources' "$TMP/diff.out"
echo '{}' > "$A/home/.codex/defaults.toml"
adiff AUTOMATION_SKIP_LAUNCHD=1
check "... a settings source changed: a user-config line" grep -q '^user-config: the settings sources' "$TMP/diff.out"
rm -f "$STUB/omniroute-installed"; adiff AUTOMATION_SKIP_LAUNCHD=1
check "... OmniRoute gone, its agent still written: an automation line, so install removes it" grep -q "^automation: $GP is there, but OmniRoute is not installed" "$TMP/diff.out"
adiff
check "... with launchd asked: an agent not loaded is an automation line" grep -q '^automation: local.canon.maintenance is not loaded' "$TMP/diff.out"

: > "$STUB/omniroute-unknown"; adiff AUTOMATION_SKIP_LAUNCHD=1; rc=$?
check "... mise not saying whether OmniRoute is installed: unknown, exit 2, the agent not called absent" \
      eval '[ "$rc" = 2 ] && grep -q "^unknown: mise did not say whether OmniRoute is installed" "$TMP/diff.out" && ! grep -q "is there, but" "$TMP/diff.out"'
mkdir -p "$STUB/loaded"; ainst; rc=$?
check "... and install keeps the gateway agent as it was, FAILED" \
      eval '[ "$rc" != 0 ] && [ -f "$GP" ] && grep -q "FAILED: mise did not say whether OmniRoute is installed" "$TMP/inst.out" && ! grep -q "bootout.*omniroute" "$STUB/launchctl.log"'
rm -f "$STUB/omniroute-unknown"; rm -rf "$STUB/loaded"

# install with launchd (the stand-in): the maintenance agent reloaded only when its plist changed
mkdir -p "$STUB/loaded"; ainst
check "an install with launchd: the maintenance agent loaded when it was not" grep -q '^  loaded     local.canon.maintenance' "$TMP/inst.out"
check "... the gateway's agent removed, OmniRoute being gone" eval '[ ! -e "$GP" ] && grep -q "^  removed    $GP" "$TMP/inst.out"'
: > "$STUB/omniroute-installed"; ainst; logs_clear; ainst
check "... and kept, not booted out, when its plist is unchanged" \
      eval 'grep -q "^  kept       local.canon.maintenance loaded: its plist is unchanged" "$TMP/inst.out" && ! grep -q "bootout.*local.canon.maintenance" "$STUB/launchctl.log"'
check "... the paper agent kept, its interval running on, with runner and plist unchanged" \
      eval 'grep -q "^  kept       local.canon.paper-session loaded: its runner and plist are unchanged" "$TMP/inst.out" && ! grep -q "bootout.*local.canon.paper-session" "$STUB/launchctl.log"'
check "... the collector and the gateway kept running too" \
      eval 'grep -q "^  kept       local.canon.otel-collector running" "$TMP/inst.out" && grep -q "^  kept       local.canon.omniroute loaded" "$TMP/inst.out" && ! grep -Eq "bootout.*(otel-collector|omniroute)" "$STUB/launchctl.log"'
check "... the nightly study's agent kept, its interval running on" \
      eval 'grep -q "^  kept       local.canon.nightly-study loaded: its plist is unchanged" "$TMP/inst.out" && ! grep -q "bootout.*local.canon.nightly-study" "$STUB/launchctl.log"'
echo "# changed" >> "$A/home/.claude/canon/paper-session.sh"; logs_clear; ainst
check "... and the paper agent reloaded once its runner changed" grep -q "bootout.*local.canon.paper-session" "$STUB/launchctl.log"
check "... loaded after everything else" eval '[ "$(grep -n "^Maintenance:" "$TMP/inst.out" | cut -d: -f1)" -gt "$(grep -n "^Landing:" "$TMP/inst.out" | cut -d: -f1)" ]'

# the rows
cp "$ROOT/home/.claude/canon/maintenance.sh" "$A/home/.claude/canon/maintenance.sh"
now=$(date +%s); at=$(jq -nr --argjson t "$now" '$t | todate')
rec() { jq -n --arg at "$at" --argjson e "$now" "{at: \$at, at_epoch: \$e, outcome: \"ok\", ff: \"at origin/main 0123456789ab\", found: [], installed: [], failed: [], note: \"\", install: null, last_change: null} $1" > "$MS"; }
jq -n --arg at "$at" --argjson e "$now" '{at: $at, at_epoch: $e, results: ["claude: ok", "agy: ok"]}' > "$MU"
rec ''; astat
check "status: a fresh round with nothing different: ok, saying so" eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "nothing differed from main" "$TMP/stat.out"'
rec '| .found = ["automation: x differs"] | .installed = ["automation install"] | .install = {state: "done", at_epoch: $e, failed: []}'; astat
check "... what it found and installed, named" eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "differed: x differs; installed: automation install" "$TMP/stat.out"'
rec '| .outcome = "failed" | .failed = ["bootstrap --user-config (exit 1)"]'; astat
check "... a failed step: FAILED by name" eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "FAILED: bootstrap --user-config (exit 1)" "$TMP/stat.out"'
rec '| .outcome = "skipped" | .ff = "skipped: the checkout is on other, not main"'; astat
check "... the checkout not on main: SKIPPED, saying why" eval 'rowis "$TMP/stat.out" maintenance SKIPPED && grep -q "the checkout is on other, not main" "$TMP/stat.out"'
rec '| .outcome = "waited" | .ff = "not run: the paper lock is held" | .last_change = {at: "earlier", found: ["automation: y"], installed: ["automation install"], failed: []}'; astat
check "... the paper lock held: ok, with the last change shown" eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "last change earlier: installed automation install" "$TMP/stat.out"'
BF="$W/maintenance-boundary.json"
bfile() { jq -n --arg at "$at" --argjson e "$now" "{state: \"waiting\", at: \$at, at_epoch: \$e, since: \$at, since_epoch: \$e, bound: 32400, why: \"\"} $1" > "$BF"; }
rec '| .deferred = {since: $at, since_epoch: $e, what: "the paper checkout"} | .note = "deferred to the session boundary: the paper checkout"'; bfile ''; astat
check "... the paper checkout deferred while a window runs: ok, saying so and that a waiter waits" \
      eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "deferred to the session boundary: the paper checkout (since $at); a waiter waits for the windows lock" "$TMP/stat.out" && ! grep -qi skipped "$TMP/stat.out"'
rec '| .deferred = {since: "earlier", since_epoch: ($e - 32401), what: "the paper checkout"}'; astat
check "... deferred for more than a whole session: FAILED, saying so" \
      eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "deferred to the session boundary: the paper checkout (since earlier); FAILED: deferred for more than one whole session" "$TMP/stat.out"'
rec '| .deferred = {since: $at, since_epoch: $e, what: "the paper checkout"}'; bfile '| .state = "timed out" | .why = "the windows'"'"' lock stayed held for 32400 s"'; astat
check "... a waiter that reached its nine-hour bound: FAILED, by name" \
      eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "FAILED: the boundary waiter timed out at $at: the windows. lock stayed held for 32400 s" "$TMP/stat.out"'
bfile '| .state = "missed" | .why = "the round at the boundary ended waited before its install; the next round that finds a window waits again"'; astat
check "... a boundary round that ended before its install: said, not a failure" \
      eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "at $at the round at the boundary ended waited before its install" "$TMP/stat.out"'
bfile '| .since_epoch = ($e - 33100)'; astat
check "... a waiter that has stopped reporting: FAILED" eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "the boundary waiter started .* has not reported" "$TMP/stat.out"'
rm -f "$BF"
rec '| .pins = ["mise: at 2026.11.5", "codex: at 0.167.0"]'; astat
check "... the pins, all at main's: ok, with their versions" eval 'rowis "$TMP/stat.out" maintenance ok && grep -q "pins at main.s registry: mise 2026.11.5, codex 0.167.0" "$TMP/stat.out"'
rec '| .pins = ["mise: at 2026.11.5", "codex: 0.167.0 -> 0.167.1"]'; astat
check "... a pin moved: named" grep -q "pins: codex: 0.167.0 -> 0.167.1" "$TMP/stat.out"
rec '| .install = {state: "started", at_epoch: ($e - 2000)}'; astat
check "... a reinstall that never reported: FAILED" eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "the reinstall it started has not reported" "$TMP/stat.out"'
rec '| .at_epoch = ($e - 20000)'; astat
check "... no round for hours: STALE" rowis "$TMP/stat.out" maintenance STALE
rec '| .at_epoch = ($e - 20000) | .outcome = "skipped" | .ff = "skipped: the checkout is on other, not main"'; astat
check "... STALE too when the last, hours ago, was skipped" rowis "$TMP/stat.out" maintenance STALE
rec ''; jq '.results = ["FAILED: claude update exited 1: no network"]' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; astat
check "... a failed daily update: FAILED, named" eval 'rowis "$TMP/stat.out" maintenance FAILED && grep -q "updates .*FAILED: claude update exited 1" "$TMP/stat.out"'
rec ''; jq '.results = ["claude: ok", "agy: ok"]' "$MU" > "$MU.t" && mv "$MU.t" "$MU"; echo "# older" >> "$AH/canon/maintenance.sh"; astat
check "... the installed script not the tree's: OUTDATED" rowis "$TMP/stat.out" maintenance OUTDATED
cp "$A/home/.claude/canon/maintenance.sh" "$AH/canon/maintenance.sh"
rm -f "$MS" "$MU"; astat
check "... no round yet: UNKNOWN, naming when the first comes" eval 'rowis "$TMP/stat.out" maintenance UNKNOWN && grep -q "the first comes 30 minutes after install" "$TMP/stat.out"'
rm -f "$STUB/loaded/local.canon.maintenance"; astat
check "... not loaded: OFF" rowis "$TMP/stat.out" maintenance OFF
# the gateway row: the curl stand-in prints $STUB/gw-code for the gateway's port
printf '#!/bin/bash\ncase "$*" in *127.0.0.1:20128*) cat "$STUB/gw-code" 2>/dev/null || exit 7 ;; esac\n' > "$B/gwcurl"; chmod +x "$B/gwcurl"
echo running > "$STUB/loaded/local.canon.omniroute"; printf 401 > "$STUB/gw-code"; astat
check "gateway row: running and refusing a made-up key: ok" eval 'rowis "$TMP/stat.out" "omniroute gateway" ok && grep -q "its API key required" "$TMP/stat.out"'
printf 200 > "$STUB/gw-code"; astat
check "... taking a made-up key: FAILED" eval 'rowis "$TMP/stat.out" "omniroute gateway" FAILED && grep -q "not 401" "$TMP/stat.out"'
echo waiting > "$STUB/loaded/local.canon.omniroute"; printf 401 > "$STUB/gw-code"; astat
check "... not running under launchd, yet a gateway answers: UNKNOWN, another copy holding the port" \
      eval 'rowis "$TMP/stat.out" "omniroute gateway" UNKNOWN && grep -q "another copy of the gateway may hold the port" "$TMP/stat.out"'
echo running > "$STUB/loaded/local.canon.omniroute"; rm -f "$STUB/gw-code"; astat
check "... nothing answering: FAILED, naming the log" eval 'rowis "$TMP/stat.out" "omniroute gateway" FAILED && grep -q "omniroute.log" "$TMP/stat.out"'
rm -f "$GP"; astat
check "... no agent written: absent, not counted against status" rowis "$TMP/stat.out" "omniroute gateway" absent

# the nightly study row (ADR 0089): the driver's own line for the last night it studied, from the records
# beside the ledger of the clone status runs in, and the schedule's heartbeat
ND="$A/ledger/nightly"; mkdir -p "$ND"; SL=local.canon.nightly-study
night() { # night <status> <days since the night's end> [line]
  jq -n --arg s "$1" --argjson e $(( $(date +%s) - $2 * 86400 )) \
    --arg l "${3:-nightly study 2026-11-11 (s): N=8, T=6, pick SPY 5/20, DSR 0.4100, $1: the pick is below 0.95 | paper windows 2026-11-11: 12 ran, 11 ok, 6 fills, fill gap not measured}" \
    '{status: $s, line: $l, end_ns: ($e * 1000000000)}' > "$ND/latest.json"
}
beat() { jq -n --argjson e $(( $(date +%s) - $1 )) --arg s "${2:-nothing new}" --arg l "${3:-}" '{epoch: $e, status: $s, line: $l}' > "$ND/last-firing.json"; }
echo "not running" > "$STUB/loaded/$SL"; night "not yet" 0; beat 60; astat
check "nightly study row: a night studied, not yet, and a fresh firing: ok, with the driver's line and the firing" \
      eval 'rowis "$TMP/stat.out" "nightly study" ok && grep -q "N=8, T=6, pick SPY 5/20, DSR 0.4100, not yet: the pick is below 0.95 | paper windows 2026-11-11: 12 ran" "$TMP/stat.out" && grep -q "last firing 1 min ago: nothing new" "$TMP/stat.out"'
night passed 0; astat
check "... a night that passed: ok" rowis "$TMP/stat.out" "nightly study" ok
night failed 0; astat
check "... a night that failed: FAILED" rowis "$TMP/stat.out" "nightly study" FAILED
night waiting 0 "nightly study (s): waiting: the catalog holds no SPY bars"; astat
check "... no night studied yet, the firing waiting: UNKNOWN, saying what it waits for" \
      eval 'rowis "$TMP/stat.out" "nightly study" UNKNOWN && grep -q "waiting: the catalog holds no SPY bars" "$TMP/stat.out"'
night "not yet" 0; beat 60 waiting "nightly study (s): waiting: the catalog does not cover SPY yet"; astat
check "... a night studied and the last firing waiting: ok, the firing's own line beside the night's" \
      eval 'rowis "$TMP/stat.out" "nightly study" ok && grep -q "not yet: the pick is below 0.95 .* last firing 1 min ago: nightly study (s): waiting: the catalog does not cover SPY yet" "$TMP/stat.out"'
beat 60 failed "nightly study (s): 8 configurations planned, failed: ValueError: the catalog lost bars"; astat
check "... the last firing failed before it knew its night: FAILED, saying why, the night's record kept" \
      eval 'rowis "$TMP/stat.out" "nightly study" FAILED && grep -q "not yet: the pick is below 0.95 .* last firing 1 min ago: nightly study (s): 8 configurations planned, failed: ValueError: the catalog lost bars" "$TMP/stat.out"'
beat 60
night "not yet" 7; astat
check "... the last night studied a week old: STALE, in days" \
      eval 'rowis "$TMP/stat.out" "nightly study" STALE && grep -q "the last night studied ended 7 days ago" "$TMP/stat.out"'
night "not yet" 4; astat
check "... four days old, a long weekend: ok" rowis "$TMP/stat.out" "nightly study" ok
night "not yet" 0; beat 7200; astat
check "... no firing for two hours: STALE" eval 'rowis "$TMP/stat.out" "nightly study" STALE && grep -q "last firing 120 min ago: nothing new (the Mac asleep, or the job not running)" "$TMP/stat.out"'
night failed 0; astat
check "... a failed night outranks a silent schedule: FAILED" rowis "$TMP/stat.out" "nightly study" FAILED
night "not yet" 0; rm -f "$ND/last-firing.json"; astat
check "... no firing yet: UNKNOWN, naming when the first comes" \
      eval 'rowis "$TMP/stat.out" "nightly study" UNKNOWN && grep -q "no firing recorded yet (the first comes 30 minutes after install)" "$TMP/stat.out"'
beat 60; echo '{' > "$ND/last-firing.json"; astat
check "... a heartbeat that cannot be read: UNKNOWN" eval 'rowis "$TMP/stat.out" "nightly study" UNKNOWN && grep -q "last-firing.json is unreadable" "$TMP/stat.out"'
beat 60; rm -f "$ND/latest.json"; astat
check "... no record of a night: UNKNOWN" eval 'rowis "$TMP/stat.out" "nightly study" UNKNOWN && grep -q "no night studied yet" "$TMP/stat.out"'
echo '{' > "$ND/latest.json"; astat
check "... a record that cannot be read: UNKNOWN" eval 'rowis "$TMP/stat.out" "nightly study" UNKNOWN && grep -q "latest.json is unreadable" "$TMP/stat.out"'
check "... and no home folder path in the row" eval '[ "$(grep "nightly study" "$TMP/stat.out" | grep -cF "$H/")" = 0 ]'
rm -f "$STUB/loaded/$SL"; astat
check "... not loaded: OFF" rowis "$TMP/stat.out" "nightly study" OFF

echo "test-maintenance: $pass passed, $fail failed"
[ "$fail" = 0 ]
