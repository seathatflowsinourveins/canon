#!/bin/bash
# land — take a branch to main once every check passes (docs/adr/0014-landing-workflow.md).
#
# The owner's standing instruction is that work lands without a manual merge step. This script is that
# step for people, agents and schedulers alike:
#
#   with an origin remote:  gh must be signed in. Check every address about to be published, push, open a
#       pull request, post the `review` and `signoff` statuses that main requires, and wait for GitHub to
#       squash-merge exactly the commit that was checked, with the title and description that were checked.
#   with no origin remote:  fast-forward main locally.
#
# Either way nothing lands unless its checks pass on exactly what is committed, on a branch that contains
# the current main, and a change that needs an independent review carries a note (ADR 0017). With origin,
# that is scripts/ci --landing here (the quick checks and a secret scan of the whole history, before
# anything is pushed) and the full suite in GitHub's required check before the merge (ADR 0144); with no
# origin there is no hosted run, so the whole of scripts/ci runs here.
#
# Usage: scripts/land [--body <file>] [--reviewed <note>] [--dry-run] [--pr <number>]
#   --body <file>   pull request description (Summary / Test Plan / Evidence); default: for --pr, the pull
#                   request's own body, otherwise the commit messages
#   --reviewed <note>  which independent review ran on this change and what came of it (ADR 0017). Needed
#                   unless every changed path is on the NO_REVIEW list below
#   --dry-run       run the checks and say what would happen; change nothing on GitHub or on main. Exits
#                   non-zero if the change would be refused for a missing note
#   --pr <number>   land a pull request someone else opened, such as the dependency bot's (ADR 0016):
#                   check it out in its own worktree, merge main into it if it is behind, then land it.
#                   With --dry-run, a pull request that is no longer open is reported, and the run goes on
# The title, which is also the squash commit's subject, is the pull request's own title for --pr, else an
# open pull request's own title when there is one, else the last commit's subject. The squash subject
# ends in "(#<number>)", which is added unless the title already ends with it.
# Environment: LAND_WAIT_SECONDS (default 2700, above the hosted check job's 40-minute timeout) and LAND_POLL_SECONDS (default 10) bound the wait for the
# merge. LAND_PR is set by --pr for the run inside the worktree.
# The fix marker (ADR 0073, addition of 2026-11-11): a commit that fixes a finding names the test that failed
# before it in a `Fails-before: <test file>::<test function>` trailer and, optionally, the finding in
# `Confirms: <round or reader>/<finding>`, both git trailers as git-interpret-trailers(1) defines them. No
# maintained convention names the test that failed before a fix: AOSP's and Fuchsia's `Test:` name tests run
# on a change, and the Linux kernel's `Fixes:` and `Closes:` name a commit and a report.
# Every commit's Fails-before and Confirms trailers are carried into the squash message's trailer block, and
# a change on the trading path whose message says it fixes a finding but names no Fails-before gets a
# warning, as does a named test the tree lacks. It never refuses a change for a missing or malformed marker. scripts/fix-index lists them.
# gh flags used are from gh's own help (gh 2.103.3): auth status, pr create --title/--body-file,
# pr merge --squash/--auto/--match-head-commit/--subject/--body-file, pr checks --required --json, pr checkout --worktree,
# pr view --json/--jq (title, body, state), pr list --json/--jq, api (commit statuses; rate_limit --jq).
set -uo pipefail
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
CHECK_ADDRESSES="$(dirname "$SELF")/check-addresses"
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "land: not inside a git repository" >&2; exit 1; }
cd "$ROOT" || exit 1
# die: once gh is in use, a failure also names a spent GitHub budget, whichever gh call met it (spent_budget)
die()  { local b=""; [ "${GH_IN_USE:-0}" = 1 ] && b=$(spent_budget) && b="; $b"; echo "land: $*$b" >&2; exit 1; }
# answered <what failed> <GitHub's answer>: die with the answer, and a budget the answer or /rate_limit names
answered() { local b=""; b=$(spent_budget "$2") && b="; $b"; GH_IN_USE=0; die "$1: ${2:-no answer}$b"; }
note() { echo "land: $*"; }
USAGE="usage: scripts/land [--body <file>] [--reviewed <note>] [--dry-run] [--pr <number>]"

BODY=""; DRY=0; PR=""; REVIEWED=""
while [ $# -gt 0 ]; do
  case "$1" in
    --body)    BODY="${2:-}"; [ $# -ge 2 ] || die "$USAGE"; shift 2 ;;
    --pr)      PR="${2:-}";   [ $# -ge 2 ] || die "$USAGE"; shift 2 ;;
    --reviewed) [ $# -ge 2 ] || die "$USAGE"; REVIEWED="$2"
                case "$REVIEWED" in --*) die "--reviewed needs a note, not another option" ;; esac
                REVIEWED=$(printf '%s' "$REVIEWED" | LC_ALL=C tr -cd '\11\40-\176' | cut -c1-140)
                [ -n "${REVIEWED//[[:space:]]/}" ] || die "--reviewed needs a note in plain ASCII: what ran and what came of it"
                shift 2 ;;
    --dry-run) DRY=1; shift ;;
    *) die "$USAGE" ;;
  esac
done
if [ -n "$BODY" ]; then
  [ -f "$BODY" ] || die "body file not found: $BODY"
  BODY="$(cd "$(dirname "$BODY")" && pwd)/$(basename "$BODY")"
fi
# Set only by the --pr branch below, for the run inside the pull request's worktree.
INNER_PR="${LAND_PR:-}"
case "$INNER_PR" in *[!0-9]*) die "LAND_PR must be a pull request number" ;; esac
[ -z "$INNER_PR" ] || [ -z "$PR" ] || die "--pr cannot be used inside a --pr run"

if command -v mise >/dev/null 2>&1; then MISE=$(command -v mise)
elif [ -x "$HOME/.local/bin/mise" ]; then MISE="$HOME/.local/bin/mise"
else die "mise not found. Run scripts/bootstrap --install."; fi
gh() { "$MISE" exec -- gh "$@"; }
# spent_budget: when GitHub's REST budget (`core`) or its GraphQL budget (`graphql`, which gh's pr commands
# spend) has no call left, print "GitHub's REST budget is spent (0 of <limit>) until <date time zone>, in
# <n> min" and succeed; otherwise, or when it cannot be read, fail. GET /rate_limit "does not count against
# your REST API rate limit", lists both under `resources`, and gives `reset` in UTC epoch seconds
# (docs.github.com, rest/rate-limit and rest/using-the-rest-api/rate-limits-for-the-rest-api, read
# 2026-11-12). A spent budget answers 403 or 429; `gh auth status` GETs the API root and fails on any
# answer but 200 (gh at its pin, pkg/cmd/auth/shared/oauth_scopes.go:35-60), so it reads as signed out.
# A secondary rate limit answers with "an error message that indicates that you exceeded a secondary rate
# limit" (same page); that answer is not read as a spent budget.
#
# spent_budget [<GitHub's answer> [strict]]: with an answer, that answer is read first, since GitHub's own
# response outranks a later /rate_limit read ("If the two disagree, rely on the response headers"). gh
# gives the answer's message and status ("<message> (HTTP <code>)" from gh api, pkg/cmd/api/api.go:685 at
# its pin; "HTTP <code>: <message> (<url>)" or "GraphQL: ..." from the pr commands, go-gh v2.17.0
# pkg/api/errors.go:35,68), not its headers, so the words are read; that a spent primary budget's message says "rate limit" is
# UNVERIFIED (GitHub documents the headers, not the text). With strict, nothing is named unless the answer
# says so, so a call that failed for another reason is not blamed on a budget another call spent; if gh
# words it otherwise, the land behaves as it did before this check.
spent_budget() {
  local said="${1:-}" strict="${2:-}" rated=0 out name limit reset when
  # a secondary limit's answer is not read as a primary one (that its words say so is UNVERIFIED), but a
  # budget /rate_limit shows spent is still named where the call is not strict
  case "$said" in *"secondary rate limit"*) ;; *"rate limit"*|*"HTTP 429"*) rated=1 ;; esac
  [ "$strict" != strict ] || [ "$rated" = 1 ] || return 1
  # gh prints an error body on stdout and exits 1 (gh at its pin, pkg/cmd/api/api_test.go:662-675), so its
  # exit is checked and every field is checked before it is read as a budget
  if out=$(gh api rate_limit --jq '.resources | to_entries[]
        | select((.key == "core" or .key == "graphql") and .value.remaining == 0)
        | "\(.key) \(.value.limit) \(.value.reset)"' 2>/dev/null) \
     && read -r name limit reset <<<"$out" && { [ "$name" = core ] || [ "$name" = graphql ]; } \
     && [[ "$limit" =~ ^[0-9]+$ ]] && [[ "$reset" =~ ^[0-9]+$ ]]; then
    when=$(date -r "$reset" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || date -d "@$reset" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null) \
      || when="epoch $reset"
    [ "$name" = graphql ] && name=GraphQL || name=REST
    echo "GitHub's $name budget is spent (0 of $limit) until $when, in $(( (reset - $(date +%s) + 59) / 60 )) min"
    return 0
  fi
  [ "$rated" = 1 ] || return 1
  echo "GitHub answered that a primary rate limit was exceeded, and /rate_limit shows no spent budget or cannot be read, so which budget is spent and its reset are unknown"
}

# The local path is for a repository with no origin at all. With an origin, landing goes through GitHub
# or not at all, and a pull request's run never lands locally.
remote=""
if git remote get-url origin >/dev/null 2>&1; then
  remote=origin
  # a spent budget fails gh's own check too, so it is read first and named, never called a sign-out
  if spent=$(spent_budget); then die "$spent, so nothing was landed; run this again after then"; fi
  if ! gh auth status >/dev/null 2>&1; then
    # the budget can run out between the read above and gh's own check, which then fails as a sign-out would.
    # Only /rate_limit is read again: gh auth status prints a generic login failure, not GitHub's answer
    # (gh at its pin, pkg/cmd/auth/status/status.go:121-150 and :500-511), so its words are not read.
    if spent=$(spent_budget); then die "$spent, so nothing was landed; run this again after then"; fi
    die "this repository has an origin remote, but gh is not signed in or cannot reach GitHub, so nothing was landed. Sign in with: mise exec -- gh auth login (check with: mise exec -- gh auth status), then run this again"
  fi
  GH_IN_USE=1
fi
[ -n "$remote" ] || [ -z "$INNER_PR" ] || die "pull request $INNER_PR has no origin remote to land through; nothing was landed"
# What a branch must contain before it lands: GitHub's main where there is a remote, the local one otherwise.
base=main
if [ -n "$remote" ]; then
  git fetch -q origin main || die "could not fetch main from origin"
  base=origin/main
fi

# Everything this run creates is removed when it ends, however it ends.
tmpd=""; pr_wt=""; pr_branch=""
cleanup() {
  if [ -n "$pr_wt" ]; then
    git -C "$ROOT" worktree remove --force "$pr_wt" 2>/dev/null || rm -rf "$pr_wt"
    git -C "$ROOT" worktree prune 2>/dev/null
    pr_wt=""
  fi
  if [ -n "$pr_branch" ]; then git -C "$ROOT" branch -q -D "$pr_branch" 2>/dev/null; pr_branch=""; fi
  if [ -n "$tmpd" ]; then rm -rf "$tmpd"; tmpd=""; fi
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# --- a pull request someone else opened ---------------------------------------------------------------
if [ -n "$PR" ]; then
  case "$PR" in *[!0-9]*|'') die "--pr takes a pull request number" ;; esac
  [ -n "$remote" ] || die "--pr needs an origin remote and a signed-in gh"
  e=$(mktemp) || die "could not create a temporary file"
  info=$(gh pr view "$PR" --json headRefName,state,url,isCrossRepository 2>"$e") \
    || { err=$(cat "$e"); rm -f "$e"; answered "could not read pull request $PR" "$err"; }
  rm -f "$e"
  head=$(jq -r .headRefName <<<"$info")
  # A pull request from a fork has its branch elsewhere; landing it from here would publish its commits as
  # a branch of this repository. That needs a person, not this script.
  [ "$(jq -r .isCrossRepository <<<"$info")" = "false" ] || die "pull request $PR comes from a fork; --pr lands only branches of this repository"
  [ "$DRY" -eq 1 ] || [ "$(jq -r .state <<<"$info")" = "OPEN" ] || die "pull request $PR is not open"
  git show-ref --verify -q "refs/heads/$head" \
    && die "a local branch named $head already exists, so pull request $PR is being worked on here; land it from its own checkout"
  first=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
  wt="$(dirname "$first")/canon-worktrees/pr-$PR"
  [ ! -e "$wt" ] || die "$wt already exists; remove it first: git worktree remove $wt"
  mkdir -p "$(dirname "$wt")" || die "could not create $(dirname "$wt")"
  # Neither the worktree nor the branch existed a moment ago (checked above), so whatever is there once
  # the checkout starts was made by this run, and the trap removes it even if the run is interrupted.
  pr_wt="$wt"; pr_branch="$head"
  gh pr checkout "$PR" --worktree "$wt" >/dev/null 2>&1 || die "could not check out pull request $PR into $wt"
  (
    cd "$wt" || exit 1
    if ! git merge-base --is-ancestor "$base" HEAD; then
      note "pull request $PR is behind main; merging main into it (the squash merge still leaves one commit)"
      if ! git merge -q --no-edit "$base"; then
        git merge --abort 2>/dev/null
        echo "land: pull request $PR conflicts with main. Resolve it on $head, or close it so its author opens a fresh one." >&2
        exit 1
      fi
    fi
    args=()
    [ -z "$BODY" ] || args+=(--body "$BODY")
    [ -z "$REVIEWED" ] || args+=(--reviewed "$REVIEWED")
    [ "$DRY" -eq 0 ] || args+=(--dry-run)
    LAND_PR="$PR" exec "$SELF" ${args[@]+"${args[@]}"}
  ) &
  # The inner run is waited for in the background, so that an interrupt reaches this shell at once and is
  # passed on as TERM (a background job ignores INT). The inner run's own trap then stops it before it
  # pushes or merges anything further, and this one removes the worktree and branch.
  inner=$!
  # shellcheck disable=SC2329  # called from the traps below
  stop_inner() { kill -TERM "$inner" 2>/dev/null; wait "$inner" 2>/dev/null; cleanup; exit "$1"; }
  trap 'stop_inner 130' INT
  trap 'stop_inner 143' TERM
  wait "$inner"; rc=$?
  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM
  cleanup
  if [ "$rc" -eq 0 ] && [ "$DRY" -eq 0 ] && [ -f "$first/.canon/watch.json" ]; then
    # so the session brief stops listing it before the next daily watch
    jq --argjson n "$PR" 'if (.bot_prs | type) == "array" then .bot_prs |= map(select(.number != $n)) else . end' "$first/.canon/watch.json" \
      > "$first/.canon/watch.json.tmp" && mv "$first/.canon/watch.json.tmp" "$first/.canon/watch.json"
  fi
  exit "$rc"
fi

# --- the current branch -------------------------------------------------------------------------------
branch=$(git branch --show-current)
[ -n "$branch" ] || die "HEAD is detached; check out the branch you want to land"
[ "$branch" != "main" ] || die "you are on main; land a branch"
status=$(git status --porcelain) || die "could not read the working tree's status"
[ -z "$status" ] || die "the working tree has uncommitted changes; commit them first, so the checks run on what will land"
git rev-parse --verify -q "$base" >/dev/null || die "there is no $base to land on"
ahead=$(git rev-list --count "$base..$branch") || die "could not count the commits on $branch"
[ "$ahead" -gt 0 ] || die "$branch has nothing that main lacks"
# A branch behind main: one never pushed is rebased onto it here, as AGENTS.md's Landing step 2 says; one
# already pushed (its pull request may be open) is not, since pushing a rebased branch again needs a forced
# push. Merging main into it needs none, and the squash merge still leaves one commit on main. The remote's
# branch counts as this one's only when it is an ancestor of it; a same-named branch with other history (an
# earlier pull request's, say) does not. With no remote, nothing this script lands through has the branch.
# `git ls-remote --exit-code` exits 2 when no ref matches; the full ref name keeps `x/<branch>` out.
# The rebase is git's own (git-rebase(1)): on a conflict it is aborted, which puts the branch back where it
# was, and the conflicting paths are named; a rebase that leaves nothing ahead of main is reset back too.
# The working tree is clean (checked above), so nothing is lost. A dry run changes no branch: it predicts a
# conflict with git-merge-tree(1) and otherwise says that the rebase would happen.
rebase_onto_base() {
  local err conflicts before
  if [ "$DRY" -eq 1 ]; then
    # git-merge-tree(1) --write-tree merges in memory and touches no branch, index or file; it exits 1 when
    # the merge conflicts. A merge, not a replay of each commit, so it predicts the rebase, it does not run it.
    if ! conflicts=$(git merge-tree --write-tree --name-only --no-messages "$base" "$branch" 2>/dev/null); then
      conflicts=$(printf '%s\n' "$conflicts" | sed 1d | sed "s/.*/'&'/" | paste -sd, - | sed 's/,/, /g')
      die "dry run: $branch does not contain the current main and was never pushed, and rebasing it onto $base would conflict in ${conflicts:-a path git did not name}; resolve it by hand: git rebase $base"
    fi
    note "dry run: $branch does not contain the current main and was never pushed, so a run without --dry-run rebases it onto $base first; it is left as it is here, and the checks below run on it unrebased"
    return 0
  fi
  note "$branch does not contain the current main and was never pushed; rebasing it onto $base"
  before=$(git rev-parse HEAD) || die "could not read the head of $branch"
  if ! err=$(git rebase -q "$base" 2>&1 >/dev/null); then
    conflicts=$(git diff --name-only --diff-filter=U 2>/dev/null | sed "s/.*/'&'/" | paste -sd, - | sed 's/,/, /g')
    git rebase --abort 2>/dev/null \
      || die "rebasing $branch onto $base failed and could not be undone, so a rebase is still in progress here. Look at git status, then git rebase --abort (or resolve it and git rebase --continue). Nothing landed"
    [ -z "$conflicts" ] \
      || die "rebasing $branch onto $base conflicts in $conflicts; the rebase was undone and nothing landed. Resolve it by hand: git rebase $base, fix the files, git rebase --continue, then run this again"
    err=${err:-nothing}
    die "rebasing $branch onto $base failed, so it was undone and nothing landed. git said: ${err:0:400}"
  fi
  if [ "$(git rev-list --count "$base..$branch" 2>/dev/null || echo 0)" -eq 0 ]; then
    git reset -q --hard "$before" \
      || die "rebasing $branch onto $base left nothing that main lacks, and $branch could not be put back at ${before:0:12}: git reset --hard $before"
    die "$branch has nothing that main lacks once rebased: every commit on it is already on main. It was left as it was; nothing landed"
  fi
  # The rebase brought main's own copy of this script, scripts/ci and check-addresses into the working
  # tree; run that copy, so the rules applied are main's, not those the branch was cut from.
  local args=()
  [ -z "$BODY" ] || args+=(--body "$BODY")
  [ -z "$REVIEWED" ] || args+=(--reviewed "$REVIEWED")
  note "rebased; running main's copy of scripts/land on it"
  exec "$SELF" ${args[@]+"${args[@]}"}
}
if ! git merge-base --is-ancestor "$base" "$branch"; then
  behind="$branch does not contain the current main"
  if [ -z "$remote" ]; then rebase_onto_base
  else
    pushed_ref=$(git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" 2>/dev/null); lsrc=$?
    pushed_sha=${pushed_ref%%[[:space:]]*}
    case "$lsrc" in
      0) git merge-base --is-ancestor "$pushed_sha" "$branch" 2>/dev/null \
           || die "$behind, and $remote already has a $branch with other history (an earlier pull request's, or someone else's). Give this one a new name and rebase it: git branch -m <new-name>, then git rebase $base. For a pull request someone else opened, use --pr"
         die "$behind, and it is already pushed to $remote, so a rebase could only be pushed with force. Merge main into it instead: git merge $base, then run this again (the squash merge still leaves one commit). For a pull request someone else opened, use --pr" ;;
      2) rebase_onto_base ;;
      *) die "$behind, and whether it is already pushed to $remote could not be read. Not pushed: git rebase $base. Already pushed: git merge $base. Then run this again" ;;
    esac
  fi
fi

# The checks below decide whether a change may merge. A model's review does not; what the gate asks is
# that an independent review has run before the push (ADR 0017). The note is the lander's own statement,
# recorded on the commit as the `review` status.
# A note is needed unless EVERY changed path is on this list. Each entry is <statuses>:<pattern>, where the
# statuses are git's A (added), M (modified), D (deleted), and * in a pattern does not cross a /.
#   README.md, packages/*/README.md, catalog/README.md   documentation
#   M:docs/adr/NNNN-*.md                                 an edit to an existing decision record (a new one,
#                                                        or one made by renaming, needs the verifier)
#   M:uv.lock                                            the dependency bot's lockfile-only pull request,
#                                                        which lands on passing checks (ADR 0016 rule 1)
NO_REVIEW='AMD:README.md AMD:packages/*/README.md AMD:catalog/README.md M:docs/adr/[0-9][0-9][0-9][0-9]-*.md M:uv.lock'
# Renames are listed as a delete plus an add, and names come NUL-separated, which is the one form git never
# quotes, so moving a file or naming it oddly does not slip past.
no_review() {   # no_review <status> <path>: succeeds if the path is on the list with that status
  local st="$1" path="$2" entry statuses pattern
  for entry in $NO_REVIEW; do
    statuses=${entry%%:*}; pattern=${entry#*:}
    case "$statuses" in *"$st"*) ;; *) continue ;; esac
    # shellcheck disable=SC2254  # the pattern is meant to match as a glob
    case "$path" in $pattern) ;; *) continue ;; esac
    [ "${path//[!\/]/}" = "${pattern//[!\/]/}" ] && return 0      # same depth, so * stayed in one directory
  done
  return 1
}
# The trading path: the paths of ADR 0073 rule 1 that ADR 0074 item 4 calls the trading path (the adapter,
# the session window and what it runs, the gate), plus the paper runner and the sandbox node on Alpaca's
# live data, as ADR 0073's addition of 2026-11-11 names them. Unlike NO_REVIEW, * here crosses a /, so a
# module moved into a subpackage of the adapter stays on the path. scripts/test-land checks that every
# pattern matches a tracked file.
#   packages/canon-alpaca/src/canon_alpaca/*.py                         the adapter
#   session_window, session_ma_cross, ma_cross, position_cap            the session window and what it runs
#   paper_node, home/.claude/canon/paper-session.sh, sandbox_node       the paper runner, the sandbox node
#   ranking, returns_matrix, ledger, variant_study, backtest           the gate
TRADING_PATHS='packages/canon-alpaca/src/canon_alpaca/*.py src/canon_trading/session_window.py src/canon_trading/session_ma_cross.py src/canon_trading/ma_cross.py src/canon_trading/position_cap.py src/canon_trading/paper_node.py home/.claude/canon/paper-session.sh src/canon_trading/sandbox_node.py src/canon_trading/ranking.py src/canon_trading/returns_matrix.py src/canon_trading/ledger.py src/canon_trading/variant_study.py src/canon_trading/backtest.py'
on_trading_path() {   # on_trading_path <path>
  local pattern
  for pattern in $TRADING_PATHS; do
    # shellcheck disable=SC2254  # the pattern is meant to match as a glob
    case "$1" in $pattern) return 0 ;; esac
  done
  return 1
}
set -f      # the list's patterns must not expand against files in the working tree
tmpd=$(mktemp -d) || die "could not create a temporary directory"
git diff --name-status --no-renames -z "$base...$branch" > "$tmpd/changed" \
  || die "could not list what $branch changes, so the review gate cannot be applied"
needs=(); trading=(); count=0
while IFS= read -r -d '' st && IFS= read -r -d '' path; do
  count=$((count + 1))
  no_review "$st" "$path" || needs+=("$path")
  ! on_trading_path "$path" || trading+=("$path")
done < "$tmpd/changed"
set +f
[ "$count" -gt 0 ] || die "git listed no changed paths for $branch, so the review gate cannot be applied"

set +f
missing_note=0
if [ ${#needs[@]} -gt 0 ] && [ -z "$REVIEWED" ]; then
  cmd="scripts/land"
  [ -z "$INNER_PR" ] || cmd="$cmd --pr $INNER_PR"
  [ -z "$BODY" ] || cmd="$cmd --body $(printf '%q' "$BODY")"
  shown=$(printf '%s ' "${needs[@]:0:4}"); [ ${#needs[@]} -le 4 ] || shown="${shown}and $((${#needs[@]} - 4)) more "
  msg="this change touches ${shown}and needs an independent review first: /code-review for code, the evidence-verifier for a decision record. Resolve what it finds, then land with: $cmd --reviewed \"<what ran and what came of it>\""
  [ "$DRY" -eq 1 ] || die "$msg"
  echo "land: dry run: $msg" >&2
  missing_note=1
fi
if [ ${#needs[@]} -eq 0 ]; then review_default="not needed: documentation or lockfile only"; fi

# The open pull request for this branch, by number from here on. Looking it up by branch name alone would
# also find an earlier, already merged pull request of a branch that had the same name.
# `--head` takes a bare branch name, so a fork's pull request from a branch of the same name is left out
# by its own flag.
open_pr() { gh pr list --head "$branch" --base main --state open --json number,url,isCrossRepository \
              --jq '[.[] | select(.isCrossRepository | not)][0] | select(. != null) | "\(.number) \(.url)"'; }
existing=""
if [ -n "$remote" ]; then
  existing=$(open_pr) || die "could not list the pull requests for $branch"
fi
# The pull request whose title is used: for a --pr run, that pull request; otherwise the open one, if any.
# A dry run on a pull request that is no longer open says so and goes on, as the --pr branch above lets it.
text_pr=""
if [ -n "$INNER_PR" ]; then
  if [ -z "$existing" ]; then
    [ "$DRY" -eq 1 ] || die "pull request $INNER_PR is not open for $branch; nothing was landed"
    note "dry run: pull request $INNER_PR is not open, so a run without --dry-run stops here"
  else
    [ "${existing%% *}" = "$INNER_PR" ] \
      || die "the open pull request for $branch is ${existing#* }, not pull request $INNER_PR; nothing was landed"
  fi
  text_pr="$INNER_PR"
elif [ -n "$existing" ]; then
  text_pr="${existing%% *}"
fi

# The pull request's title and description, which also become the squash commit's subject and message.
# Title: that pull request's own title, else the last commit's subject. Description: --body; else, for
# a --pr run, the pull request's own body; else the commits' own messages. A --pr run may have merged main
# into the branch, so its last commit and messages are not the pull request's own text. Merge commits, such
# as one that brought main into a pushed branch, are left out of the title and the description.
if [ -n "$text_pr" ]; then
  title=$(gh pr view "$text_pr" --json title --jq .title) \
    || die "could not read the title of pull request $text_pr; nothing was landed"
  [ -n "$title" ] || die "pull request $text_pr has an empty title; nothing was landed"
else
  title=$(git log -1 --no-merges --format=%s "$base..$branch") || die "could not read the last commit on $branch"
  [ -n "$title" ] || die "$branch has no commit of its own beside merges, so there is no subject to land it under"
fi
pr_body="$BODY"
if [ -z "$pr_body" ]; then
  pr_body="$tmpd/body"
  if [ -n "$INNER_PR" ]; then
    gh pr view "$INNER_PR" --json body --jq .body > "$pr_body" \
      || die "could not read the description of pull request $INNER_PR; nothing was landed"
  elif [ "$(git rev-list --count --no-merges "$base..$branch")" -eq 1 ]; then
    git log -1 --no-merges --format=%b "$base..$branch" > "$pr_body"
  else git log --reverse --no-merges --format='* %s%n%n%b' "$base..$branch" > "$pr_body"; fi \
    || die "could not read the commit messages on $branch"
fi
# The squash message keeps one trailer block, its last paragraph, so a Fails-before or Confirms trailer on
# any commit but the last, or missing from a --body file, is added here. git-interpret-trailers(1) reads
# the message (--no-divider: a `---` line in a description is markdown, not the end of a patch's message)
# but does not write it, since it also normalises a last paragraph it reads as trailers, and a bare URL
# line in an Evidence section is one (`https://x` would become `https: //x`). The missing lines go after
# the last paragraph when every line of it is a `Key: value` trailer, else in a paragraph of their own.
# Values already there are not repeated. The --body file itself is not changed.
fb=$(git log --reverse --no-merges --format='%(trailers:key=Fails-before,valueonly,unfold)' "$base..$branch") \
  || die "could not read the trailers of the commits on $branch"
cf=$(git log --reverse --no-merges --format='%(trailers:key=Confirms,valueonly,unfold)' "$base..$branch") \
  || die "could not read the trailers of the commits on $branch"
have=$( { printf '%s\n\n' "$title"; cat "$pr_body"; } | git interpret-trailers --parse --no-divider \
        | sed -n 's/^[Ff][Aa][Ii][Ll][Ss]-[Bb][Ee][Ff][Oo][Rr][Ee]: */Fails-before: /p; s/^[Cc][Oo][Nn][Ff][Ii][Rr][Mm][Ss]: */Confirms: /p') \
  || die "git could not read the trailers of the squash message"
missing=()
while IFS= read -r line; do
  case "$line" in "Fails-before: " | "Confirms: ") continue ;; esac
  case $'\n'"$have"$'\n' in *$'\n'"$line"$'\n'*) continue ;; esac
  missing+=("$line"); have="$have"$'\n'"$line"
done < <(while IFS= read -r v; do [ -z "$v" ] || printf 'Fails-before: %s\n' "$v"; done <<<"$fb"
         while IFS= read -r v; do [ -z "$v" ] || printf 'Confirms: %s\n' "$v"; done <<<"$cf")
if [ ${#missing[@]} -gt 0 ]; then
  text=$(cat "$pr_body") || die "could not read $pr_body"
  last=$(awk 'BEGIN { RS = "" } { p = $0 } END { print p }' <<<"$text")
  {
    # grep, not ${text//[[:space:]]/}: bash 3.2 runs that pattern substitution in time that grows faster
    # than the text under a UTF-8 locale (4 s on 2 KB, minutes on 48 KB); grep reads it once. LC_ALL=C
    # reads bytes, so text that is not valid UTF-8 still counts as text and is kept.
    if [ "$(LC_ALL=C grep -c '[^[:space:]]' <<<"$text")" = 0 ]; then :
    elif [ -n "$last" ] && [ "$(grep -cvE '^[A-Za-z0-9-]+:[[:space:]]' <<<"$last")" = 0 ]; then printf '%s\n' "$text"
    else printf '%s\n\n' "$text"; fi
    printf '%s\n' "${missing[@]}"
  } > "$tmpd/body.marked" || die "could not write the squash message"
  mv "$tmpd/body.marked" "$tmpd/body" || die "could not write the squash message"
  pr_body="$tmpd/body"
fi
# fix_marks: the warnings about the fix marker, on what the squash commit will say. Warnings only.
fix_marks() {
  local msg trailers named v file fn src classes cls
  msg=$(printf '%s\n\n' "$title"; cat "$pr_body")
  trailers=$(printf '%s\n' "$msg" | git interpret-trailers --parse --no-divider)
  named=$(printf '%s\n' "$trailers" | sed -n 's/^[Ff][Aa][Ii][Ll][Ss]-[Bb][Ee][Ff][Oo][Rr][Ee]: *//p')
  # grep reads to the end of its input (no -q), as scripts/test-canon asks of every pipe under pipefail
  if [ ${#trading[@]} -gt 0 ] && [ -z "$named" ]; then
    if [ "$(printf '%s\n' "$trailers" | grep -ci '^Confirms:')" -gt 0 ] \
       || [ "$(printf '%s\n' "$msg" | grep -ciwE 'fix|fixes|fixing|finding|findings|defect|defects')" -gt 0 ]; then
      echo "land: warning: this change touches the trading path (${trading[0]}$([ ${#trading[@]} -le 1 ] || echo " and $((${#trading[@]} - 1)) more")) and its message says it fixes a finding, but it carries no Fails-before trailer naming the test that failed before the fix (ADR 0073)"
    fi
  fi
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    file=${v%%::*}; fn=${v##*::}; fn=${fn%%\[*}; classes=${v#*::}; classes=${classes%"${v##*::}"}
    if [ "$file" = "$v" ] || ! [[ "$fn" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
       || ! [[ "$classes" =~ ^([A-Za-z_][A-Za-z0-9_]*::)*$ ]]; then
      echo "land: warning: Fails-before: $v is not in the form <test file>::<test function>"
    elif ! src=$(git show "$branch:$file" 2>/dev/null); then
      echo "land: warning: Fails-before names $v, but $file is not in the tree"
    elif [ "$(grep -cE "^[[:space:]]*(async[[:space:]]+)?def[[:space:]]+${fn}[[:space:]]*[(]" <<<"$src")" = 0 ]; then
      echo "land: warning: Fails-before names $v, but $file defines no $fn"
    else
      while [ -n "$classes" ]; do
        cls=${classes%%::*}; classes=${classes#*::}
        if [ "$(grep -cE "^[[:space:]]*class[[:space:]]+${cls}[[:space:]]*[(:]" <<<"$src")" = 0 ]; then
          echo "land: warning: Fails-before names $v, but $file defines no class $cls"; break
        fi
      done
    fi
  done <<<"$named"
}
fix_marks
# A public repository shows everything pushed, and every piece of text this script posts, so nothing goes
# out that carries a personal address (ADR 0014).
review_note="${REVIEWED:-${review_default:-}}"
if [ -n "$remote" ]; then
  [ -x "$CHECK_ADDRESSES" ] || die "$CHECK_ADDRESSES is missing, so the addresses cannot be checked"
  "$CHECK_ADDRESSES" --title "$title" --title "$branch" --note "${review_note:-none}" --body "$pr_body" "$base..$branch" \
    || die "nothing was pushed: what $branch would publish carries an address that may not be public (see above)"
fi

# finish <what would happen>: the end of a dry run
finish_dry() {
  note "dry run: would $1"
  if [ "$missing_note" -eq 1 ]; then echo "land: dry run: refused for now, because the change needs --reviewed" >&2; exit 1; fi
  exit 0
}

if [ -n "$remote" ]; then
  note "$branch is $ahead commit(s) ahead of main. Running the landing checks locally on the committed tree; GitHub's required check runs the rest."
  "$ROOT/scripts/ci" --landing || die "checks failed; nothing landed"
else
  note "$branch is $ahead commit(s) ahead of main. Running every check (no origin remote, so no hosted run)."
  "$ROOT/scripts/ci" || die "checks failed; nothing landed"
fi

if [ -z "$remote" ]; then
  [ "$DRY" -eq 0 ] || finish_dry "fast-forward main to $(git rev-parse --short HEAD) (no origin remote)"
  # Moves the main ref only. No checkout, so other sessions sharing the repository are not disturbed,
  # and it refuses anything that is not a fast-forward. Git also refuses if main is checked out in
  # another worktree; that has to be done there.
  git fetch -q . "$branch:main" \
    || die "main could not be fast-forwarded. If main is checked out in another worktree, run there: git merge --ff-only $branch"
  note "landed locally: main is now $(git rev-parse --short main). (No origin remote.)"
  if [ -n "$REVIEWED" ]; then
    note "review note: \"$REVIEWED\". It is not recorded anywhere, because there is no remote to post it to."
  fi
  exit 0
fi

[ "$DRY" -eq 0 ] || finish_dry "push $branch, open a pull request if there is none, record the review, sign off and squash-merge it"
sha=$(git rev-parse HEAD)
git push -q -u "$remote" "$branch" || die "push failed"
found=$(open_pr) || die "could not list the pull requests for $branch"
if [ -z "$found" ]; then
  [ -z "$existing" ] || die "${existing#* } is no longer open; nothing was merged"
  gh pr create --base main --head "$branch" --title "$title" --body-file "$pr_body" >/dev/null \
    || die "could not open the pull request"
  found=$(open_pr) || die "could not list the pull requests for $branch"
fi
[ -n "$found" ] || die "no open pull request found for $branch"
num=${found%% *}; url=${found#* }
# The title checked above belongs to the pull request found before the push; a different one is not merged.
[ -z "$existing" ] || [ "$num" = "${existing%% *}" ] || die "the open pull request for $branch is now $url, not ${existing#* }; nothing was merged"
[ -z "$INNER_PR" ] || [ "$num" = "$INNER_PR" ] || die "the open pull request for $branch is $url, not pull request $INNER_PR"

# Record the review first: `signoff` is the status the ruleset waits for, so nothing can merge before the
# note is on the commit. (A status description holds 140 characters; the note was cut to that when read.)
[ -n "$review_note" ] || die "no review note to record on $url"
# refused <context> <gh's answer>: a status GitHub did not take fails the land, naming it and what GitHub
# said (and, through die, a spent budget)
refused() { answered "GitHub refused the $1 status on $url, so nothing was merged" "$2"; }
answer=$(gh api -X POST "repos/{owner}/{repo}/statuses/$sha" -f state=success -f context=review \
   -f description="$review_note" 2>&1 >/dev/null) || refused review "$answer"

# Local sign-off. scripts/ci --landing has just passed on exactly this commit, so record that as the
# `signoff` commit status, which the ruleset on main requires. A status belongs to one commit, so a later
# push needs its own sign-off. This is 37signals' local-CI practice (basecamp/gh-signoff) with the same
# status name, done through GitHub's commit status API.
answer=$(gh api -X POST "repos/{owner}/{repo}/statuses/$sha" -f state=success -f context=signoff \
   -f description="scripts/ci --landing (quick checks, history secret scan, macOS self-tests on macOS) passed locally" 2>&1 >/dev/null) || refused signoff "$answer"

# The ruleset also requires the hosted workflow's aggregating job, backed by the full scripts/ci suite on
# GitHub's runners. Both merge calls name the commit that was checked, so GitHub refuses to merge anything else,
# and give the squash commit the subject and message checked above, so text edited on GitHub does not
# reach main. If every requirement is already met the first one merges; otherwise auto-merge is asked
# for, which gh also turns into a merge at once when the pull request has meanwhile become mergeable
# (gh at its pin, pkg/cmd/pr/merge/merge.go:593), so its zero exit shows the request accepted, not
# auto-merge armed. Either way this script waits until GitHub reports the pull request merged, so landing stays one
# command that ends with main updated.
subject="$title"
case "$title" in *" (#$num)") ;; *) subject="$title (#$num)" ;; esac
merge=(--squash --match-head-commit "$sha" --subject "$subject" --body-file "$pr_body")
if err=$(gh pr merge "$num" "${merge[@]}" 2>&1 >/dev/null); then
  auto=0
elif spent=$(spent_budget "$err" strict); then
  # a merge refused on a rate limit is not retried as auto-merge, which would meet the same limit
  GH_IN_USE=0; die "signed off, but GitHub refused the merge of $url: $err; $spent. Nothing was merged by that call, and the pull request's state was not read; run this again after the reset"
elif err_auto=$(gh pr merge "$num" --auto "${merge[@]}" 2>&1 >/dev/null); then
  auto=1; note "signed off; auto-merge requested; waiting for the hosted checks on $url"
else
  die "signed off, but GitHub would neither merge nor enable auto-merge on $url. It said: ${err:-nothing} / ${err_auto:-nothing}"
fi
asked="the merge of $url"; [ "$auto" -eq 0 ] || asked="the auto-merge request for $url"
seen=""; readerr=""   # the last state read that succeeded, and what gh said when one failed
waited=0; limit="${LAND_WAIT_SECONDS:-2700}"; poll="${LAND_POLL_SECONDS:-10}"
# unread: a read in the wait failed. On a spent budget the merge's outcome cannot be read until the reset,
# so the land stops and says so, rather than polling on or calling it not merged.
unread() {
  local spent
  spent=$(spent_budget "$1" strict) || return 0
  GH_IN_USE=0
  die "GitHub accepted $asked, but whether it has merged cannot be read: $spent. After the reset: git fetch origin main:main"
}
while :; do
  if view=$(gh pr view "$num" --json state,headRefOid --jq '"\(.state) \(.headRefOid)"' 2>"$tmpd/err"); then
    seen=$view
  else
    readerr=$(cat "$tmpd/err"); unread "$readerr"; view=""
  fi
  state=${view%% *}; headsha=${view#* }
  [ "$state" != "MERGED" ] || break
  [ "$state" != "CLOSED" ] || die "$url was closed without being merged; nothing landed"
  [ -z "$view" ] || [ "$headsha" = "$sha" ] \
    || die "the head of $url is now ${headsha:0:12}, not the checked commit ${sha:0:12}; nothing else is merged. Land again from the new head."
  # with --json, gh pr checks writes the checks and exits 0, pending or failed (gh at its pin:
  # pkg/cmd/pr/checks/checks.go:189-190), so a failure here is a failed read
  failed=$(gh pr checks "$num" --required --json name,bucket \
             --jq '[.[] | select(.bucket == "fail" or .bucket == "cancel") | .name] | join(", ")' 2>"$tmpd/err") \
    || unread "$(cat "$tmpd/err")"
  [ -z "$failed" ] || die "a required check failed on $url: $failed. Push a fix to $branch and land again."
  if [ "$waited" -ge "$limit" ]; then
    # say only what was read: the last state read, or that it could not be read. Whether auto-merge is
    # still on is not read (only state and head are), so no later merge is promised.
    then_do="look at the pull request, and once it is merged run: git fetch origin main:main"
    if [ -z "$view" ] && [ -z "$seen" ]; then
      die "GitHub accepted $asked, but its state could not be read before ${limit}s (gh said: ${readerr:-nothing}), so whether it merged is not confirmed; $then_do"
    elif [ -z "$view" ]; then
      die "GitHub accepted $asked; it was open at the last read that succeeded, and the last read before ${limit}s failed (gh said: ${readerr:-nothing}), so whether it merged is not confirmed; $then_do"
    fi
    die "GitHub accepted $asked, and it was still open at the last read after ${limit}s, so the merge is not confirmed; $then_do"
  fi
  sleep "$poll"; waited=$((waited + (poll > 0 ? poll : 1)))
done

# Bring the local main up to date. Git will not move a branch that is checked out in another worktree,
# so in that case say where to do it; the landing itself is already done.
if git fetch -q origin main:main 2>/dev/null; then
  note "landed: $url is squash-merged; main is now $(git rev-parse --short main)."
else
  git fetch -q origin main || die "$url is merged, but origin could not be fetched to confirm main"
  note "landed: $url is squash-merged; GitHub's main is now $(git rev-parse --short origin/main)."
  note "main is checked out in another worktree; update it there with: git merge --ff-only origin/main"
fi
note "the next change starts from main, for example: git switch -c <name> main"
