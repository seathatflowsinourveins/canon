#!/bin/bash
# test-protector-runner — offline checks of scripts/automation's run-protector, the standing protector runner
# (U-g; ADR 0146's seam rule, ADR 0069's locks, ADR 0142's named go). Everything runs in a temporary folder
# with HOME and CLAUDE_CONFIG_DIR pointed there, on a clone of a local bare origin made by the installed copy
# of home/.claude/canon/paper-session.sh, with a stand-in `mise` for `mise run paper:protector` (it records
# its arguments, its folder and its git directories, takes a lockf(1) lock on one account lock file, waiting
# at most its --lock-wait, holds it for a planned time and exits with a planned code) and a stand-in `date`
# for New York's weekday and hour. Bounds are shortened through the runner's test overrides. Nothing reaches
# the network, Alpaca or a keychain. Needs macOS's lockf(1) and timeout(1). Exit 0 if every case passes.
# shellcheck disable=SC2016,SC2034  # stub bodies and eval'd checks are single-quoted: they expand, and read the variables set before them, when they run
set -uo pipefail
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for t in /usr/bin/lockf /usr/bin/timeout /usr/bin/jq; do
  [ -x "$t" ] || { echo "test-protector-runner: skip (no $t here; macOS only)"; echo "test-protector-runner: 0 passed, 0 failed, 1 skipped"; exit 0; }
done
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-protector-runner.XXXXXX") \
  || { echo "test-protector-runner: could not create a temp folder" >&2; exit 1; }
TMP=$(cd "$TMP" && pwd -P)
HOLDERS=""
cleanup() { local p; for p in $HOLDERS; do pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; done; [ -n "${KEEP:-}" ] || rm -rf "${TMP:?}"; }
trap cleanup EXIT
GIT_CEILING_DIRECTORIES=$(cd "$TMP/.." && pwd -P); export GIT_CEILING_DIRECTORIES
pass=0; fail=0
t_pass() { pass=$((pass+1)); echo "  pass  $1"; }
t_fail() { fail=$((fail+1)); echo "  FAIL  $1"; }
check()  { local label="$1"; shift; if "$@"; then t_pass "$label"; else t_fail "$label"; fi; }

H="$TMP/home"; AH="$H/.claude"; C="$AH/canon"; B="$TMP/bin"; STUB="$TMP/stub"
mkdir -p "$C/watch" "$B" "$STUB"
export STUB
# origin: a bare repository whose main has one commit
O="$TMP/origin.git"; OW="$TMP/ow"
if ! { git init -q --bare "$O" && git init -q "$OW" && echo '[tools]' > "$OW/mise.toml" \
       && git -C "$OW" add -A && git -C "$OW" -c user.name=t -c user.email=t@example.com commit -qm one \
       && git -C "$OW" push -q "$O" HEAD:main; }; then echo "test-protector-runner: could not make the origin" >&2; exit 1; fi
MAIN=$(git -C "$O" rev-parse main)
/usr/bin/install -m 755 "$ROOT/home/.claude/canon/paper-session.sh" "$C/protector-checkout.sh"

# date: New York's weekday and hour come from $STUB/ny ("<%u> <%H>"), everything else from date(1)
cat > "$B/date" <<'EOF'
#!/bin/bash
for a in "$@"; do case "$a" in '+%u %H') cat "$STUB/ny"; exit 0 ;; esac; done
exec /bin/date "$@"
EOF
# mise: `mise run paper:protector <account> ...`, one line of $STUB/plan per call:
# (a line is spent by a call that takes the lock or refuses by it; one refused by a held lock keeps it)
#   refuse <words>                 refused before any lock, exit 3
#   <hold s> <stop s> <rc> [freeze | write=<level> | early=<s> | quiet]
#                                  take the lock (waiting --lock-wait), print the start line with its end
#                                  epoch and a first protective line, hold to that end, stop (write=: AAA's
#                                  level into the book first), release, exit rc; with CANON_PROTECTOR_LEVEL_BOOK
#                                  set it reads the book once it holds the lock
cat > "$B/mise" <<'EOF'
#!/bin/bash
[ "$1 $2" = "run paper:protector" ] || { echo "stand-in mise: unexpected $*" >&2; exit 99; }
shift 2
n=$(( $(cat "$STUB/count" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STUB/count"
step=$(( $(cat "$STUB/step" 2>/dev/null || echo 0) + 1 ))   # a call refused by the lock keeps its plan line
plan=$(sed -n "${step}p" "$STUB/plan"); [ -n "$plan" ] || plan="refuse no starting holding"
dirs=$(git rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null | tr '\n' ' ')
printf 'call %s cwd=%s head=%s dirs=%s args=%s\n' "$n" "$PWD" "$(git rev-parse HEAD 2>/dev/null)" "$dirs" "$*" >> "$STUB/calls"
wait=0; holds=""; inbox=""; account=$1
while [ $# -gt 0 ]; do case "$1" in --lock-wait) wait=$2; shift ;; --holds-dir) holds=$2; shift ;; --inbox) inbox=$2; shift ;; esac; shift; done
read -r k hold stop rc extra <<< "$plan"
if [ "$k" = refuse ]; then echo "$step" > "$STUB/step"; echo "paper:protector: refused: ${plan#refuse }; nothing started" >&2; exit 3; fi
extra=${rc:-}; rc=$stop; stop=$hold; hold=$k
exec 7>>"$STUB/account.lock"
if ! /usr/bin/lockf -t "$wait" 7 2>/dev/null; then
  if [ "$wait" = 0 ]; then echo "paper:protector: refused: canon-paper-$account.lock: lock is held; nothing started" >&2
  else echo "paper:protector: refused: canon-paper-$account.lock: lock is held after waiting $wait s; nothing started" >&2; fi
  exit 3
fi
echo "$step" > "$STUB/step"
echo "LOCKED $n $(/bin/date +%s)" >> "$STUB/timeline"
if [ -n "$(ls -A "$holds" 2>/dev/null)" ]; then echo "paper:protector: refused: holds folder is not empty; nothing started" >&2; echo "RELEASED $n $(/bin/date +%s)" >> "$STUB/timeline"; exit 3; fi
if [ -n "$(ls -A "$inbox" 2>/dev/null)" ]; then echo "paper:protector: refused: inbox is not empty; nothing started" >&2; echo "RELEASED $n $(/bin/date +%s)" >> "$STUB/timeline"; exit 3; fi
if [ -n "${CANON_PROTECTOR_LEVEL_BOOK:-}" ]; then   # the node's read, once it holds the lock
  levels=$(jq -jer --arg a "$account" 'if .schema == 1 and (.entries | type) == "array" then [.entries[] | select(.account_label == $a) | (.instrument_id | sub("[.]ALPACA$"; "")) + "=" + .last_level] | join(",") else error("schema") end' "$CANON_PROTECTOR_LEVEL_BOOK" 2>/dev/null) \
    || { echo "paper:protector: refused: level book unreadable at $CANON_PROTECTOR_LEVEL_BOOK; nothing started" >&2; echo "RELEASED $n $(/bin/date +%s)" >> "$STUB/timeline"; exit 3; }
  echo "BOOK $n $(/bin/date +%s) $levels" >> "$STUB/timeline"
fi
end=$(( $(/bin/date +%s) + hold ))
echo "paper:protector: $account, OWN1, overnight, boats; ends 2026-11-13T20:00:00-05:00 (epoch $end)"
[ "$extra" = quiet ] || echo "2026-11-13T20:00:01.000000000Z [INFO] OwnerProtector-001: AAA.ALPACA: holding level 9.5; one observation cannot elect"
if [ "$extra" = freeze ]; then
  echo "2026-11-13T20:00:02.000000000Z [INFO] OwnerProtector-001: <--[EVT] OrderRejected(instrument_id=AAA.ALPACA, client_order_id=canon-protect-1, reason='stand-in rejection', ts_event=1)"
  echo "2026-11-13T20:00:02.000000000Z [INFO] OwnerProtector-001: AAA.ALPACA: frozen: our protective sell ended REJECTED; inspect it; no new sell"
fi
case "$extra" in early=*)
  sleep "${extra#early=}"
  echo "RELEASED $n $(/bin/date +%s)" >> "$STUB/timeline"
  exit "$rc" ;;
esac
while [ "$(/bin/date +%s)" -lt "$end" ]; do sleep 0.1; done
case "$extra" in write=*)   # the stop's book write (U-e), made while this node still holds the lock
  jq --arg l "${extra#write=}" '.entries |= map(if .instrument_id == "AAA.ALPACA" then .last_level = $l else . end)' "$CANON_PROTECTOR_LEVEL_BOOK" > "$CANON_PROTECTOR_LEVEL_BOOK.t" \
    && mv "$CANON_PROTECTOR_LEVEL_BOOK.t" "$CANON_PROTECTOR_LEVEL_BOOK" && echo "WROTE $n $(/bin/date +%s)" >> "$STUB/timeline" ;;
esac
sleep "$stop"
echo "RELEASED $n $(/bin/date +%s)" >> "$STUB/timeline"
exit "$rc"
EOF
chmod +x "$B/date" "$B/mise"

# fresh <account> [row]: a new instance folder and empty stand-in state
fresh() {
  INST="$C/protector/$1"; rm -rf "$INST" "${STUB:?}"/* "$C/watch/protector-$1.json" "$C/watch/owner-levels.json"
  rm -rf "$C/protector-$1-checkout" "$C/protector-$1-checkout"-run-* "$C/protector-$1-checkout.lock" "$C/protector-$1-checkout.lock"
  mkdir -p "$INST/holds" "$INST/inbox"
  printf 'account=%s\nrow=%s\n' "$1" "${2:-OWN1}" > "$INST/instance"
  : > "$STUB/plan"; : > "$STUB/calls"; : > "$STUB/timeline"; echo "3 21" > "$STUB/ny"
  echo '{"schema": 1, "entries": []}' > "$C/watch/owner-levels.json"
  ST="$C/watch/protector-$1.json"; CL="$C/protector-$1-checkout"
}
# runner <account>: one firing, as launchd runs it, with the bounds shortened
runner() {
  env -i HOME="$H" PATH=/usr/bin:/bin:/usr/sbin:/sbin TZ=UTC STUB="$STUB" CLAUDE_CONFIG_DIR="$AH" \
    CANON_PROTECTOR_DATE="$B/date" CANON_PROTECTOR_LEAD=2 CANON_PROTECTOR_STOP_BUDGET=2 CANON_PROTECTOR_POLL=0.2 \
    CANON_PROTECTOR_RETRY_SECS="${RETRY_SECS:-1}" CANON_PROTECTOR_RETRY_BOUND="${RETRY_BOUND:-8}" CANON_PROTECTOR_ENDS_SECS=20 \
    /usr/bin/timeout 120 /bin/bash "$ROOT/scripts/automation" run-protector "$B/mise" "$CL" "$O" "$INST" > "$TMP/runner.out" 2>&1
}
calls() { wc -l < "$STUB/calls" | tr -d ' '; }
call() { sed -n "${1}p" "$STUB/calls"; }
at() { awk -v k="$1" -v n="$2" '$1 == k && $2 == n { print $3; exit }' "$STUB/timeline"; }
st() { jq -e "$1" "$ST" >/dev/null 2>&1; }
rec() { jq -se "$1" "$INST/runs.jsonl" >/dev/null 2>&1; }

echo "case 1: at the boundary the successor waits on the lock and holds it within the stop budget"
fresh windows
printf '%s\n' "4 0.5 0" "4 0.5 0" "refuse no starting holding" > "$STUB/plan"
runner
check "three starts: the predecessor, its successor, and the refused third" [ "$(calls)" = 3 ]
w=$(call 2 | sed -n 's/.*--lock-wait \([0-9]*\).*/\1/p')
check "the successor carries a bounded --lock-wait of its lead and the stop budget (got '${w}')" eval '[ -n "$w" ] && [ "$w" -ge 3 ] && [ "$w" -le 5 ]'
check "the predecessor started with no wait" eval '! grep -q -- --lock-wait <<<"$(call 1)"'
r1=$(at RELEASED 1); l2=$(at LOCKED 2)
check "never two holders: the successor locked after the predecessor released" eval '[ -n "$r1" ] && [ -n "$l2" ] && [ "$l2" -ge "$r1" ]'
check "the successor held the lock within the stop budget of the predecessor's exit" eval '[ -n "$r1" ] && [ -n "$l2" ] && [ $((l2 - r1)) -le 2 ]'
check "no lock-is-held refusal between the runner's own starts" eval '! grep -q "lock is held" "$TMP/runner.out"'
check "the seam gap is in the status" st '(.last_seam.run_to_line_secs | type) == "number" and .last_seam.run_to_line_secs >= 0 and .last_seam.run_to_line_secs <= 4'
check "the seam gap is in the successor's run record" rec 'map(select(.seam != null)) | length >= 1 and (.[0].seam.run_to_line_secs | type) == "number"'
check "the seam gap is in the runner's log" grep -q 'seam after ' "$TMP/runner.out"

echo "case 2: a lock held by a hand-run is retried every few seconds, then started once free"
fresh windows
printf '%s\n' "2 0 0" "refuse no starting holding" > "$STUB/plan"
/usr/bin/lockf -k "$STUB/account.lock" sleep 3 & HOLDERS="$HOLDERS $!"
sleep 0.3
runner
check "refused by the held lock, retried, then started" eval '[ "$(calls)" -ge 3 ] && grep -q "^LOCKED" "$STUB/timeline"'
check "each refusal is logged by name" grep -q 'lock_held: .*retry' "$TMP/runner.out"
fresh windows
printf '%s\n' "2 0 0" > "$STUB/plan"
/usr/bin/lockf -k "$STUB/account.lock" sleep 30 & h=$!; HOLDERS="$HOLDERS $h"
sleep 0.3
RETRY_BOUND=3 runner
kill "$h" 2>/dev/null; pkill -P "$h" 2>/dev/null; wait "$h" 2>/dev/null
check "past the bound the firing ends by name" st '.outcome == "failed" and (.note | test("lock_held_bound"))'
check "past the bound no node held the lock" [ ! -s "$STUB/timeline" ]

echo "case 3: a hold that appears between two runs refuses the next start, and the runner stays stopped"
fresh windows
printf '%s\n' "3 0.2 0" "3 0 0" > "$STUB/plan"
( i=0; while ! grep -q '^LOCKED 1 ' "$STUB/timeline" 2>/dev/null && [ $((i += 1)) -le 300 ]; do sleep 0.1; done; echo stop > "$INST/holds/owner" ) &
runner
check "only the first run started" [ "$(calls)" = 1 ]
check "the status names the hold" st '.outcome == "held" and (.note | test("hold"))'
runner
check "a later firing starts nothing while the hold is there" [ "$(calls)" = 1 ]
check "and says it is held" st '.outcome == "held"'

echo "case 4: on C, no start without the lead's standing go naming protect and the row"
fresh protect OWN1
runner
check "no go file: nothing starts" [ "$(calls)" = 0 ]
check "no go file: refused by name" st '.outcome == "refused" and (.note | test("go"))'
echo "protect OWN3" > "$INST/go"; runner
check "a go naming another row: nothing starts, by name" eval '[ "$(calls)" = 0 ] && st '"'"'.outcome == "refused" and (.note | test("go"))'"'"''
echo "windows OWN1" > "$INST/go"; runner
check "a go naming another account: nothing starts, by name" eval '[ "$(calls)" = 0 ] && st '"'"'.outcome == "refused" and (.note | test("go"))'"'"''
echo "protect OWN1" > "$INST/go"; runner
check "with 'protect OWN1' the start carries --lead-go protect OWN1" eval 'grep -q -- "--lead-go protect OWN1" <<<"$(call 1)"'

echo "case 5: the level book is read in each start's step, by the node once it holds the lock"
fresh windows
printf '%s\n' "3 0.2 0" "1 0 0" "refuse no starting holding" > "$STUB/plan"
book() { jq -n --arg l "$1" '{schema: 1, entries: [{account_label: "windows", instrument_id: "AAA.ALPACA", protection_start_ns: 1, last_level: $l, quantity: "10", written_ns: 5, run: "r"}, {account_label: "protect", instrument_id: "CCC.ALPACA", protection_start_ns: 1, last_level: "4", quantity: "1", written_ns: 5, run: "r"}]}' > "$C/watch/owner-levels.json"; }
bookread() { awk -v n="$1" '$1 == "BOOK" && $2 == n { print $4; exit }' "$STUB/timeline"; }
book 9.5
( i=0; while ! grep -q '^BOOK 1 ' "$STUB/timeline" 2>/dev/null && [ $((i += 1)) -le 300 ]; do sleep 0.1; done; book 9.75 ) &
runner
check "both starts had the book named to them and read it" eval '[ -n "$(bookread 1)" ] && [ -n "$(bookread 2)" ]'
check "the first start read the book's level" [ "$(bookread 1)" = AAA=9.5 ]
check "a level changed between two runs reaches the second" [ "$(bookread 2)" = AAA=9.75 ]
check "the runner reads no book and passes no --levels of its own" eval '! grep -q -- "--levels" "$STUB/calls"'
fresh windows
printf '%s\n' "1 0 0" > "$STUB/plan"
echo 'not json' > "$C/watch/owner-levels.json"; runner
check "an unreadable book refuses the start by name" eval '! grep -q "^BOOK" "$STUB/timeline" && st '"'"'.outcome == "refused" and (.note | test("level book"))'"'"''
rm -f "$C/watch/owner-levels.json"; : > "$STUB/timeline"; rm -f "$STUB/step"; runner
check "a missing book refuses the start by name" eval '! grep -q "^BOOK" "$STUB/timeline" && st '"'"'.outcome == "refused" and (.note | test("level book"))'"'"''

echo "case 6: each start runs in a detached linked worktree of the runner's clone, removed after the run"
fresh windows
printf '%s\n' "1 0 0" "refuse no starting holding" > "$STUB/plan"
runner
cwd=$(call 1 | sed -n 's/.* cwd=\([^ ]*\) .*/\1/p')
check "it ran somewhere other than the clone" eval '[ -n "$cwd" ] && [ "$cwd" != "$CL" ]'
check "a linked worktree whose common git directory is the clone's" eval 'grep -q "dirs=[^ ]*/worktrees/[^ ]* $CL/.git " <<<"$(call 1)"'
check "detached at the fetched main commit" eval 'grep -q "head=$MAIN " <<<"$(call 1)" && ! grep -q "^branch " <<<"$(git -C "$CL" worktree list --porcelain)"'
check "the worktree is removed after its run" eval '[ ! -e "$cwd" ] && [ "$(git -C "$CL" worktree list --porcelain | grep -c '"'"'^worktree '"'"')" = 1 ]'

echo "case 7: account A is not started in the movers recorder's hours"
fresh tests
echo "3 10" > "$STUB/ny"; runner
check "nothing starts on a weekday at 10:00" [ "$(calls)" = 0 ]
check "the status says why" st '.outcome == "idle" and (.note | test("recorder"))'
echo "3 21" > "$STUB/ny"; printf '%s\n' "refuse no starting holding" > "$STUB/plan"; runner
check "at 21:00 it starts" [ "$(calls)" = 1 ]

echo "case 8: a holding frozen on a DENIED or REJECTED sell is alerted at once and armed again by the next start"
fresh windows
printf '%s\n' "4 0.2 0 freeze" "1 0 0" "refuse no starting holding" > "$STUB/plan"
book 9.5
runner &
rp=$!
seen=0; for _ in $(seq 1 25); do st '.frozen | length >= 1 and (.[0] | test("REJECTED"))' && st '.outcome == "running"' && { seen=1; break; }; sleep 0.1; done
wait "$rp"
check "the freeze reaches the status while its run still runs" [ "$seen" = 1 ]
check "the next start is made, and reads the book's level" eval '[ "$(calls)" -ge 2 ] && [ "$(bookread 2)" = AAA=9.5 ]'
check "the run record counts the REJECTED end with its reason" rec '.[0].rejected == 1 and .[0].denied == 0 and (.[0].ends[0].reason | test("stand-in rejection"))'

echo "case 9: a successor launched early reads the book only once it holds the lock, after its predecessor's stop write"
fresh windows
printf '%s\n' "4 0.5 0 write=9.9" "1 0 0" "refuse no starting holding" > "$STUB/plan"
book 9.5
runner
b2=$(awk '$1 == "BOOK" && $2 == 2 { print $3; exit }' "$STUB/timeline"); w1=$(at WROTE 1); r1=$(at RELEASED 1); l2=$(at LOCKED 2)
check "the successor was launched early with a lock wait" eval 'grep -q -- "--lock-wait " <<<"$(call 2)"'
check "the predecessor wrote at its stop, holding the lock" eval '[ -n "$w1" ] && [ -n "$r1" ] && [ "$w1" -le "$r1" ]'
check "the successor read the book only after it took the lock" eval '[ -n "$b2" ] && [ -n "$l2" ] && [ "$b2" -ge "$l2" ] && [ "$l2" -ge "$r1" ]'
check "and so read the predecessor's write" [ "$(bookread 2)" = AAA=9.9 ]

echo "case 11: a worktree still used by a run the runner lost is never removed, and the firing ends by name"
fresh windows
printf '%s\n' "2 0 0" > "$STUB/plan"
mkdir -p "$CL-run-a" "$CL-run-b"; echo orphan > "$CL-run-a/marker"; echo orphan > "$CL-run-b/marker"
/usr/bin/lockf -k "$CL-run-a.lock" sleep 30 & h=$!; HOLDERS="$HOLDERS $h"
/usr/bin/lockf -k "$CL-run-b.lock" sleep 30 & h2=$!; HOLDERS="$HOLDERS $h2"
sleep 0.3
runner
check "both busy worktrees are left in place with what they held" eval '[ "$(cat "$CL-run-a/marker" 2>/dev/null)" = orphan ] && [ "$(cat "$CL-run-b/marker" 2>/dev/null)" = orphan ]'
check "nothing started on either" [ "$(calls)" = 0 ]
check "the firing ended by name" st '.outcome == "failed" and (.note | test("worktree_busy"))'
kill "$h" "$h2" 2>/dev/null; pkill -P "$h" 2>/dev/null; pkill -P "$h2" 2>/dev/null; wait "$h" "$h2" 2>/dev/null
fresh windows
printf '%s\n' "1 0 0" "refuse no starting holding" > "$STUB/plan"
mkdir -p "$CL-run-a"; echo orphan > "$CL-run-a/marker"
/usr/bin/lockf -k "$CL-run-a.lock" sleep 30 & h=$!; HOLDERS="$HOLDERS $h"
sleep 0.3
runner
c1=$(call 1 | sed -n 's/.* cwd=\([^ ]*\) .*/\1/p')
check "one busy slot: the run starts in the other (got '$c1') and the busy one is kept" eval '[ "$c1" = "$CL-run-b" ] && [ "$(cat "$CL-run-a/marker" 2>/dev/null)" = orphan ]'
kill "$h" 2>/dev/null; pkill -P "$h" 2>/dev/null; wait "$h" 2>/dev/null
fresh windows
printf '%s\n' "2 0 0" "refuse no starting holding" > "$STUB/plan"
/usr/bin/lockf -k "$STUB/account.lock" sleep 3 & h=$!; HOLDERS="$HOLDERS $h"
sleep 0.3
runner
wait "$h" 2>/dev/null
c1=$(call 1 | sed -n 's/.* cwd=\([^ ]*\) .*/\1/p'); c2=$(call 2 | sed -n 's/.* cwd=\([^ ]*\) .*/\1/p')
check "a lock retry reuses its worktree for the retried start (got '$c1' and '$c2')" eval '[ -n "$c1" ] && [ "$c1" = "$c2" ]'

echo "case 10: install-protector writes one instance's agent, which plain install does not; status shows its row"
LA="$TMP/LaunchAgents"; mkdir -p "$LA"
printf '#!/bin/bash\nexit 1\n' > "$B/launchctl"; chmod +x "$B/launchctl"
auto() { env -i HOME="$H" PATH="$B:/usr/bin:/bin:/usr/sbin:/sbin" STUB="$STUB" CLAUDE_CONFIG_DIR="$AH" CANON_LAUNCHAGENTS_DIR="$LA" \
           AUTOMATION_SKIP_LAUNCHD=1 /usr/bin/timeout 300 /bin/bash "$ROOT/scripts/automation" "$@" > "$TMP/auto.out" 2>&1; }
PP="$LA/local.canon.protector-protect.plist"
rm -rf "$C/protector/protect"   # case 4's instance, its go included
rm -f "$C/watch/owner-levels.json"
auto install-protector protect F2
check "F2 is refused by name and nothing is written" eval 'grep -q "F2 is refused" "$TMP/auto.out" && [ ! -e "$PP" ]'
auto install-protector protect OWN3
check "the plist runs the installed runner's run-protector on this instance" eval '[ "$(plutil -extract ProgramArguments.2 raw -o - "$PP")" = run-protector ] && [ "$(plutil -extract ProgramArguments.1 raw -o - "$PP")" = "$C/protector-runner.sh" ] && [ "$(plutil -extract ProgramArguments.6 raw -o - "$PP")" = "$C/protector/protect" ] && [ "$(plutil -extract StartInterval raw -o - "$PP")" = 60 ]'
check "the instance names its account and row, with empty holds and inbox, and no go written" eval 'grep -qx "row=OWN3" "$C/protector/protect/instance" && [ -d "$C/protector/protect/holds" ] && [ -d "$C/protector/protect/inbox" ] && [ ! -e "$C/protector/protect/go" ]'
check "the runner and its checkout helper are installed copies of this tree" eval 'cmp -s "$ROOT/scripts/automation" "$C/protector-runner.sh" && cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$C/protector-checkout.sh"'
check "an absent level book is written empty, U-e's schema 1" eval '[ "$(jq -c . "$C/watch/owner-levels.json")" = '"'"'{"schema":1,"entries":[]}'"'"' ]'
echo '{"schema": 1, "entries": [{"kept": 1}]}' > "$C/watch/owner-levels.json"
auto install-protector protect OWN3
check "an existing level book is never overwritten" eval 'grep -q kept "$C/watch/owner-levels.json"'
check "plain install does not install a protector runner" eval '! grep -q "protector" <(sed -n "/^do_install() {/,/^}/p" "$ROOT/scripts/automation")'
jq -n --argjson e "$(date +%s)" '{at_epoch: $e, account: "protect", row: "OWN3", outcome: "running", note: "run ends at epoch 1", commit: "x", last_seam: {run_to_line_secs: 3}, frozen: ["AAA.ALPACA: frozen: our protective sell ended DENIED"]}' > "$C/watch/protector-protect.json"
auto status
check "status shows the instance's row, FROZEN while a freeze lasts, with its observed run interval" eval 'grep -Eq "^  protector protect +FROZEN .*run end to observed line 3 s" "$TMP/auto.out"'
check "status never calls a run interval the measured quote seam" grep -q 'quote seam not measured' "$TMP/auto.out"
jq '.frozen = []' "$C/watch/protector-protect.json" > "$TMP/s.json" && mv "$TMP/s.json" "$C/watch/protector-protect.json"
auto status
check "and ok once it has been armed again" eval 'grep -Eq "^  protector protect +ok " "$TMP/auto.out"'
auto uninstall-protector protect
check "uninstall-protector removes its plist and leaves its records" eval '[ ! -e "$PP" ] && [ -d "$C/protector/protect" ]'

echo "case 12 (review S1 / P2-1): an early exit measures from the exit, never the future planned end"
fresh windows
printf '%s\n' "30 0 1 early=1" "2 0 0" "refuse no starting holding" > "$STUB/plan"
runner
r1=$(at RELEASED 1); l2=$(at LOCKED 2)
check "S1 the successor starts after the early exit" eval '[ -n "$r1" ] && [ -n "$l2" ] && [ "$l2" -ge "$r1" ]'
check "S1 status never reports a negative gap" st '.last_seam.run_to_line_secs >= 0'
check "S1 the gap starts at the observed early exit" st ".last_seam.from_epoch >= $r1 and .last_seam.from_epoch <= $r1 + 1"
check "S1 the successor record also measures from the early exit" rec ".[1].seam.from_epoch >= $r1 and .[1].seam.from_epoch <= $r1 + 1 and .[1].seam.run_to_line_secs >= 0"
check "S1 the observed interval is labelled with what it measures" st '.last_seam.measurement == "run_end_to_observed_line"'
check "S1 no judged-quote timestamp or gap is invented from a waiting line" st '.last_seam.quote_seam | has("from_epoch") and has("to_epoch") and has("gap_secs") and .from_epoch == null and .to_epoch == null and .gap_secs == null'
check "S1 the missing quote endpoint is named in the run record" rec '.[1].seam.quote_seam.missing_endpoints == ["predecessor last judged quote"]'

echo "case 13 (review S3 / P2-2, restated by the lead 18:42): an end kept across a held firing is a hold gap at the next real start"
fresh windows
printf '%s\n' "3 4 0" "2 0 0" "refuse no starting holding" > "$STUB/plan"
runner
r1=$(at RELEASED 1)
planned=$(jq -sr '.[0].planned_end_epoch' "$INST/runs.jsonl")
check "S3 the first firing names the expired seam wait" st '.outcome == "failed" and (.note | test("seam_wait_ran_out"))'
check "S3 the last run end persists its exit and planned end" st ".last_end.exit_epoch >= $r1 and .last_end.exit_epoch <= $r1 + 1 and .last_end.planned_end_epoch == $planned"
last_end=$(jq -c '.last_end' "$ST")
echo stop > "$INST/holds/owner"
runner
check "S3 a held firing keeps the last end, its reason and times, marks the hold on it and starts nothing" eval '[ "$(calls)" = 2 ] && [ "$(jq -c ".last_end | del(.held_by)" "$ST")" = "$last_end" ] && st '"'"'.outcome == "held" and (.last_end.held_by | test("holds"))'"'"''
seam_before=$(jq -c .last_seam "$ST")
rm -f "$INST/holds/owner"
runner
l3=$(at LOCKED 3)
check "S3 the next firing starts after the predecessor exits" eval '[ -n "$l3" ] && [ "$l3" -ge "$r1" ]'
check "S3 the gap across the hold is not a seam: the seam is as it was" eval '[ "$(jq -c .last_seam "$ST")" = "$seam_before" ]'
check "S3 the cross-firing gap is a hold gap, measured, naming the hold and the end before it" st ".last_gap.kind == \"hold_gap\" and .last_gap.after == \"failure\" and (.last_gap.end_note | test(\"seam_wait_ran_out\")) and (.last_gap.held_by | test(\"holds\")) and .last_gap.from_epoch == $planned and .last_gap.run_to_line_secs >= 4"
check "S3 the successor run record has the same hold gap and no seam" rec ".[2].seam == null and .[2].gap.kind == \"hold_gap\" and .[2].gap.from_epoch == $planned"
check "S3 the hold gap is logged" grep -q 'hold_gap after failure' "$TMP/runner.out"
check "S3 a cross-firing record also names the missing quote endpoint" rec '.[2].gap.quote_seam.missing_endpoints == ["predecessor last judged quote"]'

echo "case 14 (review S5 / P2-3): a transient checkout failure is reported before exit and retried before the seam"
fresh windows
printf '%s\n' "8 0.2 0 freeze" "2 0 0" "refuse no starting holding" > "$STUB/plan"
mv "$C/protector-checkout.sh" "$C/protector-checkout.real.sh"
cat > "$C/protector-checkout.sh" <<'EOF'
#!/bin/bash
n=$(( $(cat "$STUB/helper" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STUB/helper"
echo "$n $(/bin/date +%s)" >> "$STUB/prepares"
if [ "$n" = 2 ] || { [ -f "$STUB/always-fail" ] && [ "$n" -ge 2 ]; }; then
  echo "stand-in: checkout unavailable" >&2; exit 1
fi
exec /bin/bash "${0%.sh}.real.sh" "$@"
EOF
RETRY_SECS=2 runner &
rp=$!
seen=0; i=0
while kill -0 "$rp" 2>/dev/null && [ $((i += 1)) -le 120 ]; do
  if st '.outcome == "failed" and (.note | test("checkout_failed")) and (.frozen | length) > 0' \
     && ! grep -q '^RELEASED 1 ' "$STUB/timeline"; then seen=1; break; fi
  sleep 0.1
done
cleared=0; i=0   # F5: after the recovered prepare and before the successor is launched, the status no longer carries the failure
while kill -0 "$rp" 2>/dev/null && [ $((i += 1)) -le 300 ]; do
  [ "$(calls)" = 1 ] || break   # the successor's own start would rewrite the status: too late to tell
  if grep -q '^3 ' "$STUB/prepares" 2>/dev/null && st '.outcome == "running" and (.note | test("checkout_failed") | not)'; then
    cleared=1; break
  fi
  sleep 0.1
done
wait "$rp"
planned=$(jq -sr '.[0].planned_end_epoch' "$INST/runs.jsonl")
retry_at=$(awk '$1 == 3 { print $2; exit }' "$STUB/prepares")
check "S5 checkout failure stays visible alongside a freeze while the predecessor runs" [ "$seen" = 1 ]
check "S5 preparation is retried before end minus lead" eval '[ -n "$retry_at" ] && [ "$retry_at" -lt $((planned - 2)) ]'
check "S5 a recovered checkout still launches the successor for the seam" eval '[ "$(calls)" -ge 2 ] && grep -q -- "--lock-wait " <<<"$(call 2)" && rec ".[1].launched_epoch < $planned and .[1].started_epoch != null"'
check "S5 recovery clears the checkout failure from the status before the successor is launched" [ "$cleared" = 1 ]
check "S5 recovery leaves no checkout failure in the final status" st '.outcome == "refused" and (.note | test("checkout_failed") | not)'

echo "case 15 (review S5 / P2-3): repeated checkout failures stop retrying at end minus lead"
fresh windows
printf '%s\n' "6 0.2 0" > "$STUB/plan"
: > "$STUB/always-fail"
RETRY_SECS=1 runner
planned=$(jq -sr '.[0].planned_end_epoch' "$INST/runs.jsonl")
last_try=$(awk 'END { print $2 }' "$STUB/prepares")
check "S5 persistent failure is retried, but never at or after end minus lead" eval '[ "$(cat "$STUB/helper")" -ge 3 ] && [ "$last_try" -lt $((planned - 2)) ]'
check "S5 an exhausted preparation deadline is named" st '.outcome == "failed" and (.note | test("prepare_retry_bound.*checkout_failed"))'
check "S5 persistent failure starts no successor and records the predecessor end" eval '[ "$(calls)" = 1 ] && st '"'"'(.last_end.exit_epoch | type) == "number"'"'"''
mv -f "$C/protector-checkout.real.sh" "$C/protector-checkout.sh"

echo "case 16: starts with no protective log line still record the missing quote endpoint"
fresh windows
printf '%s\n' "3 0 0 quiet" "2 0 0 quiet" "refuse no starting holding" > "$STUB/plan"
runner
check "a start with no protective line publishes an unmeasured interval in status" st '.last_seam != null and (.last_seam.successor_started_epoch | type) == "number" and .last_seam.run_to_line_secs == null'
check "no absent protective line is assigned an observed timestamp in the record" rec '.[1].seam.to_epoch == null and .[1].seam.to_line == "none seen"'
check "the status names the missing quote endpoint even with no matching line" st '.last_seam.quote_seam.missing_endpoints == ["predecessor last judged quote"]'
check "the quiet run record names the missing quote endpoint" rec '.[1].seam.quote_seam.missing_endpoints == ["predecessor last judged quote"]'

echo "case 17 (review F1, the lead 18:42): an end by schedule is a pause at the next start, not a seam"
fresh windows
printf '%s\n' "3 0 0" "2 0 0" "2 0 0" "refuse no starting holding" > "$STUB/plan"
(sleep 1; echo "6 12" > "$STUB/ny") &   # Saturday during the first run: the schedule refuses the launch after the successor
runner
wait
check "F1 the schedule's end is kept with its reason, and nothing started on Saturday after the successor" eval 'st '"'"'.outcome == "idle" and .last_end.end_reason == "schedule"'"'"' && [ "$(calls)" = 2 ]'
seam_before=$(jq -c .last_seam "$ST")
# stand-in for 48 h elapsing: shift the kept end back by two days (the harness cannot wait two days)
jq '.last_end.planned_end_epoch -= 172800 | .last_end.exit_epoch -= 172800' "$ST" > "$ST.t" && mv "$ST.t" "$ST"
echo "7 20" > "$STUB/ny"
runner
check "F1 a start after a scheduled pause leaves the seam as it was" eval '[ "$(jq -c .last_seam "$ST")" = "$seam_before" ]'
check "F1 the pause is recorded with its length" st '.last_gap.kind == "pause" and .last_gap.after == "schedule" and .last_gap.from_epoch < (.last_gap.successor_started_epoch - 172000)'
check "F1 the run record keeps a pause out of its seam" rec '.[2].seam == null and .[2].gap.kind == "pause"'

echo "case 18 (review F1, the lead 18:42): an end by hold is a hold gap naming the hold, not a seam"
fresh windows
printf '%s\n' "4 0 0" "2 0 0" "refuse no starting holding" > "$STUB/plan"
(sleep 1; echo stop > "$INST/holds/owner") &
runner
wait
check "F1 the hold's end is kept with its reason and names the hold" st '.outcome == "held" and .last_end.end_reason == "hold" and (.last_end.end_note | test("holds"))'
rm -f "$INST/holds/owner"
seam_before=$(jq -c .last_seam "$ST")
runner
check "F1 a start after a hold leaves the seam as it was" eval '[ "$(jq -c .last_seam "$ST")" = "$seam_before" ]'
check "F1 the hold gap is recorded with its length and the hold named" st '.last_gap.kind == "hold_gap" and .last_gap.after == "hold" and (.last_gap.end_note | test("holds")) and (.last_gap.from_epoch | type) == "number"'

echo "case 19 (review F2): a predecessor that dies while the runner prepares is stamped at its exit"
fresh windows
printf '%s\n' "30 0 1 early=1" "2 0 0" "refuse no starting holding" > "$STUB/plan"
mv "$C/protector-checkout.sh" "$C/protector-checkout.real.sh"
cat > "$C/protector-checkout.sh" <<'EOS'
#!/bin/bash
n=$(( $(cat "$STUB/helper" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STUB/helper"
[ "$n" != 2 ] || sleep 6
exec /bin/bash "${0%.sh}.real.sh" "$@"
EOS
runner
mv -f "$C/protector-checkout.real.sh" "$C/protector-checkout.sh"
r1=$(at RELEASED 1); l2=$(at LOCKED 2)
check "F2 the seam starts within 1 s of the predecessor's real exit" st ".last_seam.from_epoch <= $r1 + 1"
check "F2 the measured interval covers the real exit to the successor's line" st ".last_seam.run_to_line_secs >= ($l2 - $r1 - 1)"

echo "case 20 (the lead 18:42): after a killed runner the next start records a seam named after a kill"
fresh windows
printf '%s\n' "2 0 0" "8 0 0" "2 0 0" "refuse no starting holding" > "$STUB/plan"
runner &
rp=$!
i=0; while ! grep -q '^LOCKED 2 ' "$STUB/timeline" 2>/dev/null && [ $((i += 1)) -le 200 ]; do sleep 0.1; done
sleep 0.5
for p in $(pgrep -f "$ROOT/scripts/automation run-protector $B/mise $CL"); do kill -9 "$p" 2>/dev/null; done
wait "$rp" 2>/dev/null
i=0; while ! grep -q '^RELEASED 2 ' "$STUB/timeline" 2>/dev/null && [ $((i += 1)) -le 200 ]; do sleep 0.1; done
check "a killed runner leaves its status running" st '.outcome == "running"'
runner
check "the next start's seam is named after a kill" st '.last_seam.kind == "seam" and .last_seam.after == "kill" and (.last_seam.end_note | test("without naming its end"))'

echo "case 21: every start is handed the instance's symbol-holds folder, and an entry there holds one symbol, never the runner"
fresh windows
mkdir -p "$INST/symbol-holds"; : > "$INST/symbol-holds/AAA"
printf '%s\n' "2 0 0" "2 0 0" "refuse no starting holding" > "$STUB/plan"
runner
check "an entry in symbol-holds/ stops no start: three starts" [ "$(calls)" = 3 ]
check "each start carries --symbol-holds-dir of the instance" eval '[ "$(grep -c -- "--symbol-holds-dir $INST/symbol-holds" "$STUB/calls")" = 3 ]'
check "the runner never reads it as a hold" eval '! st ".outcome == \"held\""'

echo "test-protector-runner: $pass passed, $fail failed"
[ "$fail" = 0 ]
