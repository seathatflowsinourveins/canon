#!/bin/bash
# lanes — report every Claude Code session on this machine from the local event ledger (ADR 0007).
#
# Input contracts (nothing here parses session transcripts, whose format is documented as internal):
#   ledger lines    written by home/.claude/canon/ledger.sh from documented hook payloads
#                   https://code.claude.com/docs/en/hooks.md
#   snapshots       written by home/.claude/canon/statusline.sh
#                   https://code.claude.com/docs/en/statusline.md
#   usage readings  ${CLAUDE_CONFIG_DIR:-~/.claude}/canon/rate-limits/<session>.json, written by the status line,
#                   those changed in the last eight days: per window (rate_limits.five_hour, .seven_day) the
#                   input's used_percentage (0 to 100) and resets_at (epoch seconds), present for Pro, Max and
#                   Ultra subscribers after a session's first API response, each window possibly absent, and t,
#                   when that session's reading was last new. The report's Usage row shows, per window, the
#                   newest reading, with its reset time and age, or "not reported" when there is no readable
#                   reading, or the newest was read USAGE_STALE_MIN (30) or more minutes ago, or has reset.
#                   The status-line input has no per-model window. The Agent SDK documents usage rows a model can
#                   scope (https://code.claude.com/docs/en/agent-sdk/typescript.md, SDKUsageReport, experimental)
#                   and per-model limit events (https://code.claude.com/docs/en/agent-sdk/python.md,
#                   RateLimitEvent's RateLimitInfo); neither is read here.
#
# Usage: scripts/lanes [--days N] [--quiet-min N] [--json]
#        scripts/lanes --selftest
# --days N covers the ledger files of the last N UTC dates, today included (default 2); the header says which.
# Only the snapshots of sessions that appear in that window are read.
# Exit:  0 report printed; 2 usage error; 4 no ledger file in the window (hooks not installed, or no
#        sessions in that period), with only the Usage row printed ({"usage": ...} with --json); 1 selftest or
#        another step failed. Paths under $HOME are printed as ~, and a session started there is lane "~".
# A line that is not a JSON object with a session id and a ts of the form YYYY-MM-DDTHH:MM:SSZ is counted
# as unreadable and skipped. Events are ordered by t (epoch seconds with milliseconds, when the line has it),
# else by ts; at an equal time a prompt sorts before the Stop that ends it.
# States, decided from the last turn boundary (UserPromptSubmit against Stop, StopFailure, and a SessionStart
# whose source is not "compact", which Claude Code writes in the middle of a turn that compacts); events
# after it, such as PreCompact or SubagentStop, do not reopen a finished turn:
#   working | idle (turn finished) | QUIET (turn open, silent past the threshold) |
#   abandoned (turn open, silent for six hours or more: the app was closed mid-turn) | ended |
#   unknown (no turn boundary in the window, so whether a turn is open cannot be told; never flagged QUIET).
# Known limit: a background subagent still working after its parent turn's Stop reads as idle.
#
# --rates [--window MIN] prints a manifest of every running worker of every runtime: lane, runtime, model,
# state, output tokens per second over the last MIN minutes (default 10), and spend where the runtime
# reports it. Every figure comes from a documented contract; a runtime without one is listed as
# "not measured" with the reason, never estimated. Its inputs, besides the ledger and snapshots above:
#   OTLP log file   ${CANON_OTLP_FILE:-~/.claude/canon/otel/logs.jsonl}, JSON Lines of OTLP/JSON
#                   ExportLogsServiceRequest objects, as OpenTelemetry's file exporter and the Collector's
#                   file exporter write them, and the copies it rotates beside it, those written within the window:
#                   https://opentelemetry.io/docs/specs/otel/protocol/file-exporter/
#                   https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/fileexporter
#                   https://github.com/open-telemetry/opentelemetry-proto/blob/main/docs/specification.md (JSON)
#     Claude Code   event api_request: session.id, model, output_tokens, duration_ms, cost_usd
#                   https://code.claude.com/docs/en/monitoring-usage.md
#     Codex CLI     event codex.sse_event with event.kind response.completed: conversation.id, model,
#                   output_token_count; event codex.turn_cost: usage.estimated_usd (opt in via [otel];
#                   https://learn.chatgpt.com/docs/config-file/config-advanced, attribute names read from
#                   codex-rs/otel/src/events/session_telemetry.rs and shared.rs at the pinned tag)
#                   Only these attributes are copied out; every other one (Codex sends account fields) is not.
#   process table   ps(1) and lsof(1) for running codex, muse, agy and dsh processes and their directory.
#                   Claude Code sessions come from the ledger, not from the process table.
# TOK/S is the output tokens of the requests that finished in the window divided by the window's seconds.
# GEN is output tokens over the requests' own durations, from the requests that carry one (Claude Code).
# Neither is a model's speed alone: TOK/S is the work done, and GEN, like Claude HUD's "out:" (a response's
# output tokens over the API time it added, src/speed.ts at v0.15.0), counts the wait for the first token too.
# The fleet line (JSON: fleet) sums TOK/S over the measured workers, and takes GEN over all their timed requests
# as one ratio, the total of those requests' output tokens over the total of their durations, so each request
# weighs as long as it ran. Codex's response.completed carries tokens and ttft_ms but no duration
# (codex-rs/otel/src/events/session_telemetry.rs, sse_event_completed, at the pinned tag), so its requests
# are in TOK/S and not in GEN.
# Claude Code rows are the ledger's sessions that are working or QUIET, or idle or unknown and heard from
# within six hours (the abandoned threshold); a session closed without a SessionEnd shows until then.
# A Codex conversation row means it reported events in the window, not that its process still runs.
# Usage: scripts/lanes --rates [--window MIN] [--days N] [--json]
# Usage: scripts/lanes prune [--apply] [--protect FILE]   (removes landed lanes; described above its code)
set -euo pipefail

# ---- prune: remove the worktrees and local branches of landed lanes (the owner's instruction of 2026-11-11:
# a lane's workspace is removed once its change is on main and its tree is clean) ---------------------------
# Contracts: `git worktree list --porcelain`, `git for-each-ref`, `git merge-base --is-ancestor`, `git status
# --porcelain` and `git branch -D` (https://git-scm.com/docs/git-worktree, git-for-each-ref, git-merge-base,
# git-status, git-branch); `gh pr list --state all --head <branch> --json number,state,headRefOid`
# (https://cli.github.com/manual/gh_pr_list), run as `mise exec -- gh`; removal through Orca's own CLI,
# `orca worktree rm --worktree path:<path>`, which refuses a dirty tree and keeps the branch.
# A worktree and its branch are removable only when ALL hold: GitHub records a MERGED pull request for the head
# branch; the tree is clean (`git status --porcelain`, untracked files included, ignored files not, except
# that files under catalog/ or ledger/, which git ignores and which cannot be fetched again, count as dirty); the branch
# tip is that merged pull request's head commit, or an ancestor of main (origin/main or local main). Squash
# merges never make the tip an ancestor, so GitHub's own record decides, not a merge test.
# Known limits: a new lane that reuses the branch name of a merged one and has no commit yet is an ancestor of main
# and reads as landed; ignored files other than under catalog/ and ledger/ are not looked for.
# Never removed, whatever GitHub says: the main checkout (first entry of the worktree list), the worktree the
# command runs in, a worktree named paper-checkout or wt-main, a locked worktree, a detached one, the branch
# main, and anything in the protect file. Protect file: --protect FILE, else $CANON_PRUNE_PROTECT, else
# ${CLAUDE_CONFIG_DIR:-~/.claude}/canon/prune-protect (absent is fine: nothing extra protected). One entry per
# line: a worktree folder name, an absolute path or a branch name, each possibly a shell pattern such as review-*; blank lines and #-lines are ignored. It
# lists the open lanes; it is read from that file and not from Orca's open dispatches, which a script cannot
# list (only a coordinator can).
# Usage: scripts/lanes prune [--apply] [--protect FILE]
# Dry run unless --apply. Exit 0 done (also when nothing is removable); 1 a check or a removal failed (gh
# unavailable stops before anything is removed); 2 usage error.
prune_usage() {
  [ -z "${1:-}" ] || echo "lanes prune: $1" >&2
  echo "usage: scripts/lanes prune [--apply] [--protect FILE]" >&2
  exit 2
}
prune_main() {
  local apply=0 pfile="${CANON_PRUNE_PROTECT:-}" explicit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply)   apply=1; shift ;;
      --protect) [ $# -ge 2 ] || prune_usage "--protect needs a file"; pfile="$2"; explicit=1; shift 2 ;;
      *) prune_usage "unknown argument: $1" ;;
    esac
  done
  command -v jq >/dev/null 2>&1 || { echo "lanes prune: ERROR: jq not found" >&2; return 1; }
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "lanes prune: ERROR: not inside a git repository" >&2; return 1; }
  [ -n "$pfile" ] || pfile="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/canon/prune-protect"
  if [ ! -r "$pfile" ]; then
    { [ "$explicit" = 0 ] && [ -z "${CANON_PRUNE_PROTECT:-}" ]; } \
      || { echo "lanes prune: ERROR: protect file not found: $pfile" >&2; return 1; }
    pfile=""
  fi
  local protect="" here main_ref wt_list rc=0
  [ -z "$pfile" ] || protect=$(sed -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//' -e '/^#/d' -e '/^$/d' "$pfile")
  here=$(git rev-parse --show-toplevel) || return 1
  main_ref=""
  for r in refs/remotes/origin/main refs/heads/main; do
    git rev-parse -q --verify "$r" >/dev/null 2>&1 && main_ref="$main_ref $r"
  done
  [ -n "$main_ref" ] || { echo "lanes prune: ERROR: no main or origin/main to compare against" >&2; return 1; }
  wt_list=$(git worktree list --porcelain) || return 1

  # an entry matches a name as a shell pattern, so review-* protects every worktree named that way
  is_protected() { local e; while IFS= read -r e; do [ -n "$e" ] || continue
    # shellcheck disable=SC2254  # the entry is meant to be a pattern
    case "$1" in $e) return 0 ;; esac; done <<EOF_P
$protect
EOF_P
    return 1; }
  local n_rm=0 n_keep=0 kept_reasons="" plan
  plan=$(mktemp) || return 1
  # shellcheck disable=SC2064  # the paths are fixed now on purpose
  trap "rm -f '$plan' '$plan.out'" RETURN
  # one line per candidate: <kind> <path|-> <branch> <verdict>; verdict is "remove" or "keep: <reason>"
  local path="" head="" branch="" detached=0 locked=0 prunable=0 first=1 main_path="" line
  prune_flush() {
    [ -n "$path" ] || return 0
    local verdict=""
    if [ "$first" = 1 ]; then main_path="$path"; first=0; verdict="keep: main checkout"; fi
    if [ -z "$verdict" ]; then
      if [ "$path" = "$here" ]; then verdict="keep: the worktree this ran in"
      elif [ "$(basename "$path")" = paper-checkout ] || [ "$(basename "$path")" = wt-main ]; then
        verdict="keep: reading or paper checkout"
      elif is_protected "$(basename "$path")" || is_protected "$path" || { [ -n "$branch" ] && is_protected "$branch"; }; then
        verdict="keep: protected (open lane)"
      elif [ "$locked" = 1 ]; then verdict="keep: locked"
      elif [ "$prunable" = 1 ] || [ ! -d "$path" ]; then verdict="keep: directory missing (git worktree prune)"
      elif [ "$branch" = main ]; then verdict="keep: the branch main"
      elif [ "$detached" = 1 ] || [ -z "$branch" ]; then verdict="keep: detached HEAD, no branch"
      elif [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then verdict="keep: dirty tree"
      elif data=$(find "$path" \( -name .git -o -name .venv -o -name node_modules \) -prune -o -type f \( -path '*/catalog/*' -o -path '*/ledger/*' \) ! -name README.md -print 2>/dev/null) && [ -n "$data" ]; then
        verdict="keep: local data in catalog/ or ledger/ (ignored by git)"
      fi
    fi
    printf 'wt\t%s\t%s\t%s\n' "$path" "${branch:--}" "${verdict:-check}" >> "$plan"
    path=""; head=""; branch=""; detached=0; locked=0; prunable=0
  }
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*) prune_flush; path="${line#worktree }" ;;
      "HEAD "*)     head="${line#HEAD }" ;;
      "branch "*)   branch="${line#branch refs/heads/}" ;;
      detached)     detached=1 ;;
      locked*)      locked=1 ;;
      prunable*)    prunable=1 ;;
    esac
  done <<EOF_WT
$wt_list
EOF_WT
  prune_flush
  : "$head"
  # branches without a worktree
  local b v r try why data wt_branches
  wt_branches=$(awk -F'\t' '$3 != "-" {print $3}' "$plan")
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    grep -qxF -e "$b" <<<"$wt_branches" && continue
    if [ "$b" = main ]; then v="keep: main"
    elif is_protected "$b"; then v="keep: protected (open lane)"
    else v="check"; fi
    printf 'br\t-\t%s\t%s\n' "$b" "$v" >> "$plan"
  done < <(git for-each-ref --format='%(refname:short)' refs/heads)

  # GitHub's record, for what survived the local checks
  local out="$plan.out" kind p br v tip prs merged_heads open ancestor
  : > "$out"
  # shellcheck disable=SC2094  # $plan is read here and only removed on the error returns inside
  while IFS=$'\t' read -r kind p br v; do
    if [ "$v" = check ]; then
      tip=$(git rev-parse -q --verify "refs/heads/$br") || { v="keep: branch missing"; printf '%s\t%s\t%s\t%s\n' "$kind" "$p" "$br" "$v" >> "$out"; continue; }
      # up to three tries: GitHub's API answers an occasional 502
      try=0; prs=""
      while [ "$try" -lt 3 ]; do
        prs=$(mise exec -- gh pr list --state all --head "$br" --json number,state,headRefOid --limit 50) && break
        try=$((try + 1)); prs=""; [ "$try" -ge 3 ] || sleep "${PRUNE_RETRY_SLEEP:-2}"
      done
      if [ -z "$prs" ]; then
        echo "lanes prune: ERROR: gh pr list failed for $br; nothing was removed" >&2
        rm -f "$plan" "$out"; return 1
      fi
      open=$(printf '%s' "$prs" | jq -r '[.[] | select(.state == "OPEN")] | length')
      merged_heads=$(printf '%s' "$prs" | jq -r '.[] | select(.state == "MERGED") | .headRefOid')
      ancestor=0
      for r in $main_ref; do git merge-base --is-ancestor "$tip" "$r" 2>/dev/null && ancestor=1; done
      if [ "$open" != 0 ]; then v="keep: open pull request"
      elif [ -z "$merged_heads" ]; then v="keep: no merged pull request"
      elif grep -qxF "$tip" <<<"$merged_heads" || [ "$ancestor" = 1 ]; then v="remove"
      else v="keep: commits beyond the merged head"; fi
    fi
    printf '%s\t%s\t%s\t%s\n' "$kind" "$p" "$br" "$v" >> "$out"
  done < "$plan"

  local orca_bin=""
  if [ "$apply" = 1 ] && grep -q $'\tremove$' "$out"; then
    if command -v orca >/dev/null 2>&1; then orca_bin=orca
    elif [ -x /Applications/Orca.app/Contents/Resources/bin/orca ]; then orca_bin=/Applications/Orca.app/Contents/Resources/bin/orca
    else echo "lanes prune: ERROR: orca CLI not found; nothing was removed" >&2; rm -f "$plan" "$out"; return 1; fi
  fi
  [ "$apply" = 1 ] && echo "lanes prune: applying" || echo "lanes prune: dry run (nothing is changed; --apply removes)"
  while IFS=$'\t' read -r kind p br v; do
    if [ "$v" = remove ]; then
      if [ "$apply" = 1 ]; then
        if [ "$kind" = wt ] && ! why=$("$orca_bin" worktree rm --worktree "path:$p" 2>&1); then
          echo "FAILED  $p ($br): orca worktree rm: ${why%%$'\n'*}"; rc=1; continue
        fi
        if [ "$kind" = wt ] && [ -e "$p" ]; then echo "FAILED  $p ($br): folder still there"; rc=1; continue; fi
        if ! git -C "$main_path" branch -D "$br" >/dev/null 2>&1; then
          echo "FAILED  $br: git branch -D"; rc=1; continue
        fi
        echo "removed $([ "$kind" = wt ] && echo "$p " || true)$br"
      else
        echo "remove  $([ "$kind" = wt ] && echo "$p " || echo "(branch only) ")$br"
      fi
      n_rm=$((n_rm + 1))
    else
      echo "keep    $([ "$kind" = wt ] && echo "$p " || echo "(branch only) ")$br: ${v#keep: }"
      n_keep=$((n_keep + 1)); kept_reasons="$kept_reasons
${v#keep: }"
    fi
  done < "$out"
  echo "lanes prune: $n_rm $([ "$apply" = 1 ] && echo removed || echo removable), $n_keep kept"
  printf '%s\n' "$kept_reasons" | sed '/^$/d' | sort | uniq -c | sed 's/^ *\([0-9]*\) \(.*\)/  \1  \2/'
  rm -f "$plan" "$out"
  return "$rc"
}
if [ "${1:-}" = prune ]; then shift; prune_main "$@"; exit $?; fi

CFG="${CANON_LEDGER_HOME:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/canon}"
DAYS=2
QUIET=15
JSON=0
SELFTEST=0
RATES=0
WINDOW=10
USAGE_STALE_MIN=30
usage() {
  [ -z "${1:-}" ] || echo "lanes: $1" >&2
  echo "usage: scripts/lanes [--days N] [--quiet-min N] [--json] | --rates [--window MIN] [--days N] [--json] | --selftest" >&2
  exit 2
}
while [ $# -gt 0 ]; do
  case "$1" in
    --days)      [ $# -ge 2 ] || usage "--days needs a value"; DAYS="$2"; shift 2 ;;
    --quiet-min) [ $# -ge 2 ] || usage "--quiet-min needs a value"; QUIET="$2"; shift 2 ;;
    --json)      JSON=1; shift ;;
    --rates)     RATES=1; shift ;;
    --window)    [ $# -ge 2 ] || usage "--window needs a value"; WINDOW="$2"; shift 2 ;;
    --selftest)  SELFTEST=1; shift ;;
    *) usage ;;
  esac
done
case "$DAYS" in ''|*[!0-9]*) usage "--days needs a whole number of 1 or more" ;; esac
case "$QUIET" in ''|*[!0-9]*) usage "--quiet-min needs a whole number of 1 or more" ;; esac
case "$WINDOW" in ''|*[!0-9]*) usage "--window needs a whole number of 1 or more" ;; esac
DAYS=$((10#$DAYS)); QUIET=$((10#$QUIET)); WINDOW=$((10#$WINDOW))
[ "$WINDOW" -ge 1 ] || usage "--window needs a whole number of 1 or more"
[ "$DAYS" -ge 1 ] || usage "--days needs a whole number of 1 or more"
[ "$QUIET" -ge 1 ] || usage "--quiet-min needs a whole number of 1 or more"
command -v jq >/dev/null 2>&1 || { echo "lanes: ERROR: jq not found" >&2; exit 1; }

# utc_day <epoch seconds> -> YYYY-MM-DD in UTC (GNU date or BSD date)
if date --version >/dev/null 2>&1; then
  utc_day() { date -u -d "@$1" +%Y-%m-%d; }
else
  utc_day() { date -u -r "$1" +%Y-%m-%d; }
fi

# build_report -> one JSON object on stdout
build_report() {
  local now from to day i f files="" any=0 t
  now=$(date -u +%s)
  to=$(utc_day "$now")
  from=$(utc_day $((now - (DAYS - 1) * 86400)))
  i=$((DAYS - 1))
  while [ "$i" -ge 0 ]; do
    day=$(utc_day $((now - i * 86400)))
    [ ! -f "$CFG/ledger/$day.jsonl" ] || files="$files$CFG/ledger/$day.jsonl
"
    i=$((i - 1))
  done
  if [ -z "$files" ]; then
    for f in "$CFG"/ledger/*.jsonl; do [ -e "$f" ] && { any=1; break; }; done
    if [ "$any" = 1 ]; then
      echo "lanes: no ledger file from $from to $to (UTC) at $CFG/ledger. Widen the window with --days N." >&2
    else
      echo "lanes: ledger is empty at $CFG/ledger. Install the machine-level hooks with: scripts/bootstrap --user-config" >&2
    fi
    return 4
  fi
  t=$(mktemp -d) || return 1
  # events and snapshots go through files, never through argv, so their number has no limit
  printf '%s' "$files" | while IFS= read -r f; do cat "$f"; done \
    | jq -cR '(try fromjson catch null) as $o
        | if ($o | type) == "object" and $o.sid != null and ($o.ts | type) == "string"
             and ($o.ts | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
             and (($o.ts | try fromdateiso8601 catch null) != null)
          then ($o.ts | fromdateiso8601) as $e
               | $o + {_e: $e, _k: (if ($o.t | type) == "number" then $o.t else $e end)}
          else {"_bad": true} end' > "$t/events" \
    || { rm -rf "$t"; echo "lanes: ERROR: could not read the ledger" >&2; return 1; }
  jq -r 'select(._bad != true) | .sid | tostring' "$t/events" | sort -u > "$t/sids" \
    || { rm -rf "$t"; echo "lanes: ERROR: could not list sessions" >&2; return 1; }
  while IFS= read -r f; do
    case "$f" in ''|.*|*/*) continue ;; esac
    [ ! -f "$CFG/sessions/$f.json" ] || { cat "$CFG/sessions/$f.json"; echo; }
  done < "$t/sids" \
    | jq -cR 'try fromjson catch empty | select(type == "object" and .sid != null)' > "$t/snaps" \
    || { rm -rf "$t"; echo "lanes: ERROR: could not read session snapshots" >&2; return 1; }
  jq -s --argjson now "$now" --argjson quiet "$QUIET" --argjson days "$DAYS" --arg from "$from" --arg to "$to" --arg home "$HOME" \
     --slurpfile snaps "$t/snaps" '
      def count(f): map(select(f)) | length;
      def tally: group_by(.) | map({name: .[0], n: length}) | sort_by(-.n);
      def boundary: .ev == "UserPromptSubmit" or .ev == "Stop" or .ev == "StopFailure"
                    or (.ev == "SessionStart" and .source != "compact");
      # at an equal time: a turn opens before anything else, and Stop or SessionEnd comes last
      def rank: if .ev == "UserPromptSubmit" or .ev == "SessionStart" then 0
                elif .ev == "Stop" or .ev == "StopFailure" or .ev == "SessionEnd" then 2 else 1 end;
      (map(select(._bad == true)) | length) as $bad
      | map(select(._bad != true)) as $ev
      | ($snaps | map({key: (.sid | tostring), value: .}) | from_entries) as $snap
      | {
          generated_at: ($now | todate),
          period: {from: $from, to: $to, days: $days},
          quiet_threshold_min: $quiet,
          events: ($ev | length),
          unreadable_lines: $bad,
          sessions: (
            $ev | group_by(.sid) | map(
              sort_by([._k, rank]) as $e
              | ([range(0; $e | length) | select($e[.] | boundary)] | last) as $bi
              | (if $bi == null then null else $e[$bi] end) as $turn
              | ((($now - ($e | map(._e) | max)) / 60) | floor) as $q
              | ($e | count(.ev == "PostToolUse")) as $tools
              | ($e | count(.ev == "PostToolUseFailure")) as $fail
              | ($e | count(.ev == "StopFailure")) as $stopfail
              | ($e | count(.ev == "PostModelSwitch")) as $switch
              | ($e | count(.ev == "PermissionDenied")) as $denied
              | ($e | count(.ev == "PreCompact")) as $compact
              | (if ($e[(($bi // -1) + 1):] | any(.ev == "SessionEnd")) then "ended"
                 elif $turn == null then "unknown"
                 elif $turn.ev != "UserPromptSubmit" then "idle"
                 elif $q >= 360 then "abandoned"
                 elif $q >= $quiet then "QUIET"
                 else "working" end) as $state
              | ($e[0].sid | tostring) as $sid
              | {
                  sid: $sid,
                  # a session started in the home folder is "~", not the user name
                  lane: ((($e | map(.cwd // empty | select(type == "string" and . != "")) | last) // "?")
                         | if . == $home then "~" else split("/") | last end),
                  state: $state,
                  quiet_min: $q,
                  prompts: ($e | count(.ev == "UserPromptSubmit")),
                  tools: $tools,
                  fail: $fail,
                  denied: $denied,
                  compactions: $compact,
                  model_switches: $switch,
                  subagents: ($e | count(.ev == "SubagentStart")),
                  model: ($snap[$sid].model // null),
                  ctx_pct: ($snap[$sid].ctx_pct // null),
                  cost_usd: ($snap[$sid].cost_usd // null),
                  flags: [
                    (if $state == "QUIET" then "QUIET" else empty end),
                    (if $fail >= 3 and ($fail / ($tools + $fail)) >= 0.2 then "failures" else empty end),
                    (if $stopfail > 0 then "api-failure" else empty end),
                    (if $switch > 0 then "model-switch" else empty end),
                    (if $denied > 0 then "denied" else empty end),
                    (if $compact >= 2 then "compactions" else empty end)
                  ]
                }
            ) | sort_by((.flags | length) * -1, .quiet_min)
          ),
          mix: {
            tools:     ($ev | map(select(.ev == "PostToolUse" and (.tool // "" | startswith("mcp__") | not)) | .tool // "?") | tally | .[0:8]),
            mcp:       ($ev | map(select(.ev == "PostToolUse" and (.tool // "" | startswith("mcp__"))) | .tool) | tally | .[0:8]),
            skills:    ($ev | map(select(.ev == "PostToolUse" and .skill != null) | .skill) | tally),
            subagents: (($ev | map(select(.ev == "SubagentStart") | .agent // "?")) as $started
                        | (if ($started | length) > 0 then $started
                           else ($ev | map(select(.ev == "PostToolUse" and .subagent != null) | .subagent)) end)
                        | tally)
          }
        }' "$t/events" || { rm -rf "$t"; echo "lanes: ERROR: could not build the report" >&2; return 1; }
  rm -rf "$t"
}

print_report() {
  local r="$1"
  echo "$r" | jq -r '"Lanes at " + .generated_at + ", covering " + .period.from + " to " + .period.to
                     + " UTC (" + (.period.days | tostring) + " day(s))  (events: " + (.events | tostring)
                     + ", quiet threshold: " + (.quiet_threshold_min | tostring) + "m)"'
  local bad; bad=$(echo "$r" | jq -r '.unreadable_lines')
  [ "$bad" = "0" ] || echo "WARNING: $bad unreadable ledger line(s) skipped"
  {
    printf 'LANE\tSTATE\tQUIET\tPROMPTS\tTOOLS\tFAIL\tSUBAGENTS\tMODEL\tCTX\tCOST\tFLAGS\tSESSION\n'
    echo "$r" | jq -r '.sessions[] | [
        .lane, .state, ((.quiet_min | tostring) + "m"), .prompts, .tools, .fail, .subagents,
        (.model // "-"),
        (if .ctx_pct != null then ((.ctx_pct | floor | tostring) + "%") else "-" end),
        (if .cost_usd != null then ("$" + (((.cost_usd * 100) | round) / 100 | tostring)) else "-" end),
        (if (.flags | length) > 0 then (.flags | join(",")) else "-" end),
        .sid[0:8]
      ] | @tsv'
  } | column -t -s "$(printf '\t')"
  echo
  echo "$r" | jq -r '
    def line(k): "  " + k + ": " + (if (.mix[k] | length) == 0 then "none recorded"
                 else (.mix[k] | map(.name + " x" + (.n | tostring)) | join(", ")) end);
    "Use over the window:", line("tools"), line("mcp"), line("skills"), line("subagents")'
  local flagged; flagged=$(echo "$r" | jq '[.sessions[] | select((.flags | length) > 0)] | length')
  echo
  echo "$flagged of $(echo "$r" | jq '.sessions | length') session(s) flagged. MODEL, CTX and COST come from the status line and are '-' for sessions that never drew one."
  # the selftest builds a report without one
  if [ "$(echo "$r" | jq 'has("usage")')" = true ]; then echo; print_usage "$(echo "$r" | jq -c '.usage')"; fi
}

# usage_reading -> one JSON object on stdout: the usage readings, judged against USAGE_STALE_MIN. A number
# appears in it only for a window read within that time and not yet reset. It reads the folder where the
# status line writes, which CANON_LEDGER_HOME does not move. A file that is not a reading is skipped and counted.
usage_reading() {
  local d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/canon/rate-limits" f present=false t
  t=$(mktemp) || return 1
  if [ -d "$d" ]; then
    present=true
    # only the fields read below, at most 4 KB of each file, one line per file (a bad one as null)
    find "$d" -maxdepth 1 -type f -name '*.json' -mtime -8 2>/dev/null | while IFS= read -r f; do
      head -c 4096 "$f" | jq -c -s 'if length == 1 and (.[0] | type) == "object" and (.[0].rate_limits | type) == "object"
                                       and (.[0].t | type) == "number" then .[0] | {rate_limits, t} else null end' 2>/dev/null \
        || echo null
    done > "$t"
  fi
  jq -n -c --argjson stale "$USAGE_STALE_MIN" --arg dir "$d" --argjson present "$present" --slurpfile all "$t" '
    (now | floor) as $now
    | ($all | map(select(. != null and .t <= $now + 60))) as $ok
    | ($all | length - ($ok | length)) as $bad
    | (if ($present | not) or ($all | length) == 0
       then "no reading in \($dir) (rate_limits reach the status line only for Pro, Max and Ultra subscribers, or behind a gateway with a spend limit, after a session\u0027s first API response)"
       elif ($ok | length) == 0 then "no readable reading in \($dir)"
       else null end) as $why
    | def win($k):
        ($ok | map(.t as $t | .rate_limits[$k]? | select(type == "object" and (.used_percentage | type) == "number"
                     and .used_percentage >= 0 and .used_percentage <= 100
                     and (.resets_at | type) == "number" and .resets_at > 0 and .resets_at <= $now + 8 * 86400)
                   | . + {t: $t}) | sort_by(.t, .used_percentage) | last) as $w
        | if $why != null then {used_pct: null, resets_at: null, age_min: null, note: "not reported"}
          elif $w == null then {used_pct: null, resets_at: null, age_min: null, note: "not reported: no reading of this window"}
          else ((([($now - $w.t), 0] | max) / 60) | floor) as $age
            | if $age >= $stale then {used_pct: null, resets_at: null, age_min: $age,
                                       note: "not reported: last read \($age) min ago, older than \($stale) min"}
              elif $w.resets_at <= $now then {used_pct: null, resets_at: null, age_min: $age,
                                               note: "not reported: the window reset at \($w.resets_at | todate)"}
              else {used_pct: $w.used_percentage, resets_at: ($w.resets_at | todate), age_min: $age, note: ""} end
          end;
    {dir: $dir, stale_after_min: $stale, readable: ($why == null), note: ($why // ""), skipped_files: $bad,
     seven_day: win("seven_day"), five_hour: win("five_hour"),
     source: "rate_limits in the status-line input (https://code.claude.com/docs/en/statusline.md), which has no per-model window; the Agent SDK documents usage rows a model can scope (SDKUsageReport, experimental) and per-model limit events (RateLimitEvent), not read here"}'
  local rc=$?
  rm -f "$t"
  return "$rc"
}

print_usage() {
  echo "$1" | jq -r '
    def hm: sub(":[0-9]{2}Z$"; " UTC") | sub("T"; " ");
    def w($k): .[$k] as $w | (if $k == "seven_day" then "7-day" else "5-hour" end) + " "
      + (if $w.used_pct != null
         then ((($w.used_pct * 10) | round) / 10 | tostring) + "% (resets " + ($w.resets_at | hm) + ", read " + ($w.age_min | tostring) + " min ago)"
         else $w.note end);
    "Usage: " + (if .readable then w("seven_day") + ", " + w("five_hour") else "not reported: " + .note end)
      + "; stale after " + (.stale_after_min | tostring) + " min"
      + (if (.skipped_files // 0) > 0 then " (\(.skipped_files) unreadable reading file(s) skipped)" else "" end),
    "  source: " + .source'
}

# otlp_records <file>: one compact record per token-bearing event, {rt, sid, model, t, out, dur, cost},
# or {"_bad":true} for a line that is not a JSON object. Nothing else is copied out of the file.
otlp_records() {
  jq -cR '
    def av: if .stringValue != null then .stringValue elif .intValue != null then .intValue
            elif .doubleValue != null then .doubleValue elif .boolValue != null then .boolValue else null end;
    def num: if type == "number" then . elif type == "string" then (try tonumber catch null) else null end;
    def iso: try (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch null;
    (try fromjson catch null) as $o
    | if ($o | type) != "object" then {_bad: true} else try (
        $o.resourceLogs[]? | .scopeLogs[]? | .logRecords[]?
        | ((.attributes // []) | map(select(.key | type == "string") | {key, value: (.value | av)}) | from_entries) as $a
        | (($a["event.name"] // .body.stringValue? // "") | tostring) as $n
        | (((.timeUnixNano // 0) | num) // 0) as $tn
        | (((.observedTimeUnixNano // 0) | num) // 0) as $on
        | (if $tn > 0 then $tn / 1e9
           else ((if ($a["event.timestamp"] | type) == "string" then ($a["event.timestamp"] | iso) else null end)
                 // (if $on > 0 then $on / 1e9 else null end)) end) as $t
        | (if $n == "api_request" or $n == "claude_code.api_request" then
             {rt: "claude-code", sid: $a["session.id"], out: ($a.output_tokens | num),
              dur: ($a.duration_ms | num), cost: ($a.cost_usd | num)}
           elif $n == "codex.sse_event" and $a["event.kind"] == "response.completed" then
             {rt: "codex", sid: $a["conversation.id"], out: ($a.output_token_count | num), dur: null, cost: null}
           elif $n == "codex.turn_cost" then
             {rt: "codex", sid: $a["conversation.id"], out: null, dur: null, cost: ($a["usage.estimated_usd"] | num)}
           else empty end)
        + {model: (if ($a.model | type) == "string" then $a.model else null end), t: $t}
        | select((.sid | type) == "string" and .sid != "" and .t != null)
      ) catch {_bad: true} end' "$1"
}

# proc_list: TSV pid, elapsed, runtime, directory for each top-level codex, muse, agy or dsh process.
# The program is argv[0], or for node and bun the first argument that is not a flag. A process with an
# ancestor of the same runtime is a helper of that worker and is left out. Known limit: any program named
# muse, agy or dsh is taken for that runtime. DeepSeek's npm target is @deepseek-ai/dsh/lib/bin.js
# (apps/cli/package.json at dsh-v0.2.1-rc.3); dsh-TUI v0.17.0's package.json names bin/dsh-tui.js.
# Recognise those exact package suffixes under node/bun too.
proc_list() {
  local pid et rt cwd
  ps -axo pid=,ppid=,etime=,args= 2>/dev/null | awk '
    function base(x) { sub(/.*\//, "", x); return x }
    function rt(   n, k) { n = base($4)
      if (n == "node" || n == "bun") { n = ""; for (k = 5; k <= NF; k++) if (substr($k, 1, 1) != "-") {
        if ($k ~ /\/@deepseek-ai\/dsh\/lib\/bin\.js$/) return "deepseek-harness"
        if ($k ~ /\/@deepseek-harness-tui\/dsh-tui\/bin\/dsh-tui\.js$/) return "deepseek-harness"
        n = base($k); break } }
      if (n == "codex") return "codex"; if (n == "muse") return "muse-code"
      if (n == "agy") return "antigravity"; if (n == "dsh" || n == "dsh-tui") return "deepseek-harness"
      return "" }
    { pid[NR] = $1; ppid[NR] = $2; et[NR] = $3; run[NR] = rt(); byp[$1] = run[NR]; par[$1] = $2 }
    function helper(i,   p, d) { p = ppid[i]; for (d = 0; d < 64 && p != "" && p != "0"; d++) {
        if (byp[p] == run[i]) return 1; p = par[p] } return 0 }
    END { for (i = 1; i <= NR; i++) if (run[i] != "" && !helper(i)) print pid[i] "\t" et[i] "\t" run[i] }' \
    | while IFS="$(printf '\t')" read -r pid et rt; do
        # the first n line, read by one awk that reads to the end, so no writer is cut off under pipefail
        cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | awk '!f && sub(/^n/, "") { print; f = 1 }')
        printf '%s\t%s\t%s\t%s\n' "$pid" "$et" "$rt" "$cwd"
      done
}

# rates_report -> one JSON object on stdout
rates_report() {
  local now otlp t base rc=0 present=false reg
  now=$(date -u +%s)
  # the model canon/models.json registers for Codex (ADR 0059 rule 4), from the repository this copy runs in;
  # empty when there is none (the installed copy under the Claude config folder), and then nothing is flagged
  reg=$(jq -r '[.runtimes[]? | select(.runtime == "codex") | .model // empty] | first // empty' \
        "${CANON_MODELS_FILE:-$(dirname "$0")/../canon/models.json}" 2>/dev/null) || reg=""
  otlp="${CANON_OTLP_FILE:-$CFG/otel/logs.jsonl}"
  t=$(mktemp -d) || return 1
  base=$(build_report 2>"$t/ledger.err") || rc=$?
  if [ "$rc" = 4 ]; then base='{"sessions":[]}'; elif [ "$rc" != 0 ]; then cat "$t/ledger.err" >&2; rm -rf "$t"; return 1; fi
  printf '%s' "$base" > "$t/base"
  : > "$t/otlp"
  if [ -f "$otlp" ]; then
    present=true
    # the file exporter's rotated copies, <stem>-<UTC time>-size<.ext> beside it (fileexporter README at
    # v0.165.0, "File Rotation"); one last written before the window began holds no event in it. They are
    # listed before the current file is read, so a rotation during the read cannot count its events twice.
    local f stem="${otlp##*/}" ext=""
    case "$stem" in *.*) ext=".${stem##*.}"; stem="${stem%.*}" ;; esac
    find "$(dirname "$otlp")" -maxdepth 1 -type f -name "$stem-[0-9][0-9][0-9][0-9]-*$ext" -mmin "-$((WINDOW + 2))" > "$t/rotated" 2>/dev/null
    otlp_records "$otlp" > "$t/otlp" || { rm -rf "$t"; echo "lanes: ERROR: could not read $otlp" >&2; return 1; }
    while IFS= read -r f; do
      otlp_records "$f" >> "$t/otlp" || { rm -rf "$t"; echo "lanes: ERROR: could not read $f" >&2; return 1; }
    done < "$t/rotated"
  fi
  proc_list | jq -R 'split("\t") | {pid: .[0], etime: .[1], rt: .[2], cwd: (.[3] // "")}' | jq -s . > "$t/procs" \
    || { rm -rf "$t"; echo "lanes: ERROR: could not list processes" >&2; return 1; }
  jq -n --argjson now "$now" --argjson win "$WINDOW" --arg otlp "$otlp" --argjson present "$present" --arg reg "$reg" \
     --argjson ledger "$([ "$rc" = 0 ] && echo true || echo false)" --rawfile ledger_err "$t/ledger.err" \
     --argjson have_lsof "$(command -v lsof >/dev/null 2>&1 && echo true || echo false)" \
     --slurpfile base "$t/base" --slurpfile rec "$t/otlp" --slurpfile procs "$t/procs" '
    def r2: if . == null then null else ((. * 100) | round) / 100 end;
    def r4: if . == null then null else ((. * 10000) | round) / 10000 end;
    ($rec | map(select(._bad != true))) as $r
    | ($now - $win * 60) as $from
    | ($r | map(select(.t >= $from and .t <= $now + 60))) as $w
    | ($r | map(select(.rt == "claude-code") | {key: .sid, value: true}) | from_entries) as $seen
    | def measure($rt; $sid):
        ($w | map(select(.rt == $rt and .sid == $sid))) as $m
        | ($m | map(select(.out != null)) | length) as $counted
        | ($m | map(.out // 0) | add // 0) as $out
        | ($m | map(select(.dur != null and .dur > 0))) as $timed
        | ($timed | map(.dur) | add) as $dur
        | {out_tokens: $out, tok_s: (($out / ($win * 60)) | r2),
           gen_tok_s: (if $dur != null then ((($timed | map(.out // 0) | add) / ($dur / 1000)) | r2) else null end),
           spend_window_usd: ($m | map(.cost // empty) | if length > 0 then add | r4 else null end),
           measured: true, note: "", model_seen: ($m | map(.model // empty) | last),
           models_seen: ($m | map(.model // empty) | unique)}
        # events with no token count (a cost-only turn, a completion with no usage) are not a measured zero
        | if $counted > 0 then . else . + {out_tokens: null, tok_s: null, gen_tok_s: null, measured: false,
            note: "not measured: no event in the window carries an output token count"} end;
      def unmeasured($why): {out_tokens: null, tok_s: null, gen_tok_s: null, spend_window_usd: null,
                             measured: false, note: ("not measured: " + $why), model_seen: null, models_seen: []};
    ($r | map(select(.rt == "codex")) | length > 0) as $codex_otlp
    | {
        generated_at: ($now | todate),
        window_min: $win,
        otlp_file: $otlp,
        otlp_file_present: $present,
        otlp_unreadable_lines: ($rec | map(select(._bad == true)) | length),
        ledger_present: $ledger,
        ledger_note: ($ledger_err | sub("^lanes: "; "") | sub("\n+$"; "")),
        warnings: [
          ($procs[0] | map(select(.cwd == "")) | length) as $nocwd
          | if $nocwd > 0 then "directory not read for \($nocwd) process(es)" + (if $have_lsof then " (lsof gave none: exited, or another user\u0027s)" else " (lsof not found)" end) else empty end
        ],
        workers: [
          ( $base[0].sessions[]
            | select(.state == "working" or .state == "QUIET"
                     or ((.state == "idle" or .state == "unknown") and .quiet_min < 360))
            | . as $s
            | (if $present | not then unmeasured("no OTLP log file (ADR 0007 tier 3 not enabled)")
               elif $seen[$s.sid] then measure("claude-code"; $s.sid)
               else unmeasured("this session sent no api_request event to the OTLP file (telemetry not enabled for it)") end) as $m
            | {lane: $s.lane, runtime: "claude-code", model: ($m.model_seen // $s.model), state: $s.state,
               id: $s.sid, spend_session_usd: $s.cost_usd} + ($m | del(.model_seen, .models_seen)) ),
          ( $w | map(select(.rt == "codex")) | group_by(.sid)[] | .[0].sid as $sid
            | measure("codex"; $sid) as $m
            # any turn in the window on another model marks it, not only the last (ADR 0005: a build any part
            # of which ran on another model is labelled)
            | ([($m.models_seen // [])[] | select(. != $reg)]) as $others
            | ($reg != "" and ($others | length) > 0) as $off
            | {lane: "-", runtime: "codex", model: $m.model_seen, state: "events in window", id: $sid, spend_session_usd: null}
              + ($m | del(.model_seen, .models_seen))
              + {registered_model: (if $reg == "" then null else $reg end), off_model: $off,
                 note: ((if $off then "OFF-MODEL: \($others | join(", ")), not the registered \($reg) (canon/models.json); " else "" end)
                        + (if $m.measured then "" else $m.note + "; " end)
                        + (if $reg == "" then "registered model not read: no canon/models.json beside this copy; " else "" end)
                        + "per conversation; no documented field names its directory or process")} ),
          ( $procs[0][]
            | {lane: (if .cwd == "" then "?" else (.cwd | split("/") | last) end), runtime: .rt, model: null,
               state: ("running " + .etime), id: ("pid " + .pid), spend_session_usd: null}
              + (if .rt == "codex" then
                   (if $codex_otlp then unmeasured("tokens are reported per conversation; no documented field links a process to its conversation")
                    else unmeasured("Codex sends no telemetry here: [otel] exporter is none by default, and it has only OTLP exporters") end)
                 elif .rt == "muse-code" then unmeasured("Muse Code documents no token telemetry: its event log has no documented path or schema")
                 elif .rt == "antigravity" then unmeasured("Antigravity documents no token telemetry for interactive sessions")
                 else unmeasured("DeepSeek Harness documents no token telemetry") end | del(.model_seen, .models_seen)) )
        ],
        sources: [
          {runtime: "claude-code", source: "OTLP api_request events (tok/s, spend); ledger and status line (lanes, state, session cost)",
           url: "https://code.claude.com/docs/en/monitoring-usage.md"},
          {runtime: "codex", source: "OTLP codex.sse_event response.completed and codex.turn_cost events; process table",
           url: "https://learn.chatgpt.com/docs/config-file/config-advanced"},
          {runtime: "muse-code", source: "process table only; no documented token source", url: "https://dev.meta.ai/docs/muse-code"},
          {runtime: "antigravity", source: "process table only; no documented token source", url: "https://antigravity.google/docs/settings/"},
          {runtime: "deepseek-harness", source: "process table only; no documented token source",
           url: "https://github.com/deepseek-ai/deepseek-harness"}
        ]
      }
    | . as $rep
    | ($rep.workers | map(select(.measured == true) | {key: .id, value: true}) | from_entries) as $listed
    | ($w | map(select($listed[.sid] == true and .dur != null and .dur > 0))) as $timed
    | ($timed | map(.dur) | add) as $tdur
    | $rep + {fleet: {
        working: ($rep.workers | map(select(.runtime == "claude-code" and .state == "working")) | length),
        tok_s: ($rep.workers | map(select(.measured == true) | .tok_s | numbers) | add // 0 | r2),
        gen_tok_s: (if $tdur != null then (($timed | map(.out // 0) | add) / ($tdur / 1000) | r2) else null end),
        gen_requests: ($timed | length)}}' || { rm -rf "$t"; echo "lanes: ERROR: could not build the rates manifest" >&2; return 1; }
  rm -rf "$t"
}

print_rates() {
  local r="$1"
  echo "$r" | jq -r '"Workers at " + .generated_at + ", output tokens over the last " + (.window_min | tostring) + " min"
    + "  (OTLP file: " + .otlp_file + (if .otlp_file_present then "" else ", absent" end) + ")"'
  echo "$r" | jq -r 'if .otlp_unreadable_lines > 0 then "WARNING: \(.otlp_unreadable_lines) unreadable OTLP line(s) skipped" else empty end,
                     if .ledger_present then empty else "WARNING: no Claude Code session is listed: " + .ledger_note end,
                     (.warnings[] | "WARNING: " + .)'
  {
    printf 'LANE\tRUNTIME\tMODEL\tSTATE\tTOK/S\tGEN\tOUT\tSPEND\tID\tNOTE\n'
    echo "$r" | jq -r '
      def usd: if . == null then null else "$" + (((. * 100) | round) / 100 | tostring) end;
      .workers[] | [
        .lane, .runtime, (.model // "-"), (.state | gsub(" "; "_")),
        (.tok_s // "-" | tostring), (.gen_tok_s // "-" | tostring), (.out_tokens // "-" | tostring),
        ([(.spend_window_usd | usd | if . then . + " win" else empty end),
          (.spend_session_usd | usd | if . then . + " session" else empty end)] | if length > 0 then join(", ") else "-" end),
        (.id | if startswith("pid ") then . else .[0:8] end),
        (if .note == "" then "-" else .note end)
      ] | @tsv'
  } | column -t -s "$(printf '\t')"
  echo "$r" | jq -r '.fleet // empty
    | "Fleet: \(.working) Claude Code session(s) working; \(.tok_s) tok/s output over the window"
      + (if .gen_tok_s != null then ", \(.gen_tok_s) tok/s generating over \(.gen_requests) timed request(s) (Claude Code; Codex reports no duration)"
         else ", no timed request in the window" end)'
  echo
  echo "Sources:"
  echo "$r" | jq -r '.sources[] | "  " + .runtime + ": " + .source + "  " + .url'
}

selftest() {
  local tmp; tmp=$(mktemp -d)
  mkdir -p "$tmp/ledger" "$tmp/sessions"
  ago() { date -u -v-"$1"M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "$1 minutes ago" +%Y-%m-%dT%H:%M:%SZ; }
  # ev <minutes ago> <event> <sid> <cwd> [extra json fields]: appends to the ledger file of that UTC date
  ev() {
    local ts; ts=$(ago "$1")
    printf '{"ts":"%s","ev":"%s","sid":"%s","cwd":"%s"%s}\n' "$ts" "$2" "$3" "$4" "${5:+,$5}" >> "$tmp/ledger/${ts:0:10}.jsonl"
  }
  local i
  # A: turn open, silent for 25 minutes -> QUIET
  ev 30 UserPromptSubmit aaaaaaaa-1 /w/alpha
  ev 25 PostToolUse      aaaaaaaa-1 /w/alpha '"tool":"Bash"'
  # B: many tool failures, then finished -> idle + failures
  ev 12 UserPromptSubmit bbbbbbbb-2 /w/beta
  for i in 1 2 3 4; do ev 11 PostToolUseFailure bbbbbbbb-2 /w/beta '"tool":"Bash"'; done
  for i in 1 2; do ev 10 PostToolUse bbbbbbbb-2 /w/beta '"tool":"Read"'; done
  ev 9 Stop bbbbbbbb-2 /w/beta
  # C: model switch, denial, two compactions, API failure
  ev 8 UserPromptSubmit cccccccc-3 /w/gamma
  ev 7 PostModelSwitch  cccccccc-3 /w/gamma '"from_model":"x","to_model":"y"'
  ev 7 PermissionDenied cccccccc-3 /w/gamma '"tool":"Bash"'
  ev 6 PreCompact       cccccccc-3 /w/gamma
  ev 5 PreCompact       cccccccc-3 /w/gamma
  ev 4 StopFailure      cccccccc-3 /w/gamma
  # D: healthy and active, uses a skill, an MCP tool and a subagent
  ev 2 UserPromptSubmit dddddddd-4 /w/delta
  ev 1 PostToolUse      dddddddd-4 /w/delta '"tool":"Skill","skill":"lane-report"'
  ev 1 PostToolUse      dddddddd-4 /w/delta '"tool":"mcp__alpaca__get_account"'
  ev 1 SubagentStart    dddddddd-4 /w/delta '"agent":"upstream-scout"'
  ev 0 PostToolUse      dddddddd-4 /w/delta '"tool":"Edit"'
  # E: turn left open seven hours ago (app closed mid-turn) -> abandoned, and not flagged QUIET
  ev 420 UserPromptSubmit eeeeeeee-5 /w/epsilon
  # F: turn finished 40 minutes ago, then idle compaction and a late subagent stop -> still idle
  ev 45 UserPromptSubmit ffffffff-6 /w/zeta
  ev 40 Stop             ffffffff-6 /w/zeta
  ev 30 PreCompact       ffffffff-6 /w/zeta '"trigger":"auto"'
  ev 29 SubagentStop     ffffffff-6 /w/zeta
  # G: a status-line line with an empty directory must not blank the lane name
  ev 3 UserPromptSubmit  gggggggg-7 /w/eta
  ev 2 PostModelSwitch   gggggggg-7 ""
  ev 1 Stop              gggggggg-7 /w/eta
  ev 0 PreCompact        gggggggg-7 ""
  # H: a session five days ago, outside the default two-day window
  ev 7200 UserPromptSubmit hhhhhhhh-8 /w/theta
  # I: a turn that auto-compacts (SessionStart compact mid-turn) and then stalls -> QUIET
  ev 60 UserPromptSubmit iiiiiiii-9 /w/iota
  ev 55 PreCompact       iiiiiiii-9 /w/iota '"trigger":"auto"'
  ev 54 SessionStart     iiiiiiii-9 /w/iota '"source":"compact"'
  ev 50 PostToolUse      iiiiiiii-9 /w/iota '"tool":"Bash"'
  # K: a Stop with no ts is counted as unreadable, as is a line whose ts cannot be parsed
  ev 20 UserPromptSubmit kkkkkkkk-10 /w/kappa
  local today; today=$(date -u +%Y-%m-%d)
  {
    echo '{"ev":"Stop","sid":"kkkkkkkk-10","cwd":"/w/kappa"}'
    echo '{"ts":"2026-13-40T99:00:00Z","ev":"Stop","sid":"kkkkkkkk-10"}'
    echo '{"ts":"yesterday","ev":"Stop","sid":"kkkkkkkk-10"}'
  } >> "$tmp/ledger/$today.jsonl"
  # L1, L2: a prompt and its Stop in the same second, written Stop first -> idle, with and without t
  local lts lt; lts=$(ago 20); lt=$(jq -nr --arg ts "$lts" '$ts | fromdateiso8601')
  {
    printf '{"ts":"%s","t":%s.9,"ev":"Stop","sid":"llllllll-11","cwd":"/w/lambda1"}\n' "$lts" "$lt"
    printf '{"ts":"%s","t":%s.1,"ev":"UserPromptSubmit","sid":"llllllll-11","cwd":"/w/lambda1"}\n' "$lts" "$lt"
    printf '{"ts":"%s","ev":"Stop","sid":"llllllll-12","cwd":"/w/lambda2"}\n' "$lts"
    printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"llllllll-12","cwd":"/w/lambda2"}\n' "$lts"
  } >> "$tmp/ledger/${lts:0:10}.jsonl"
  # M: only a late PreCompact in the window (its prompt is in an older file) -> unknown, not QUIET
  ev 30 PreCompact       mmmmmmmm-13 /w/mu '"trigger":"auto"'
  # one corrupt line must be counted, not crash the report
  echo '{"ts": broken' >> "$tmp/ledger/$today.jsonl"
  echo '{"sid":"dddddddd-4","model":"claude-opus-5-5","ctx_pct":23.4,"cost_usd":1.2345}' > "$tmp/sessions/dddddddd-4.json"
  # many large snapshots of sessions outside the window, and one corrupt one: none may break the report
  local pad; pad=$(printf '%04096d' 0)
  for i in $(seq 1 300); do printf '{"sid":"old-%s","model":"m","pad":"%s"}\n' "$i" "$pad" > "$tmp/sessions/old-$i.json"; done
  echo '{"sid": broken' > "$tmp/sessions/old-corrupt.json"

  local r rwide fails=0 rc
  r=$(CFG="$tmp" build_report) || { echo "  FAIL  report could not be built"; rm -rf "$tmp"; return 1; }
  rwide=$(CFG="$tmp" DAYS=7 build_report) || { echo "  FAIL  seven-day report could not be built"; rm -rf "$tmp"; return 1; }
  check() { # name, jq boolean expression [, report]
    if printf '%s' "${3:-$r}" | jq -e "$2" >/dev/null 2>&1; then echo "  pass  $1"; else echo "  FAIL  $1"; fails=$((fails+1)); fi
  }
  check "twelve sessions in the two-day window"  '.sessions | length == 12'
  check "epsilon abandoned, not QUIET"   '.sessions[] | select(.lane=="epsilon") | .state=="abandoned" and (.flags | length == 0)'
  check "corrupt and ts-less lines counted"      '.unreadable_lines == 4'
  check "iota QUIET after compacting mid-turn"   '.sessions[] | select(.lane=="iota") | .state=="QUIET" and (.flags | index("QUIET") != null)'
  check "same-second Stop written first, with t: idle"    '.sessions[] | select(.lane=="lambda1") | .state=="idle"'
  check "same-second Stop written first, without t: idle" '.sessions[] | select(.lane=="lambda2") | .state=="idle"'
  check "no turn boundary in the window: unknown, not QUIET" '.sessions[] | select(.lane=="mu") | .state=="unknown" and (.flags | length == 0)'
  check "alpha is QUIET"                 '.sessions[] | select(.lane=="alpha") | .state=="QUIET" and (.flags | index("QUIET") != null)'
  check "beta idle with failures flag"   '.sessions[] | select(.lane=="beta") | .state=="idle" and .fail==4 and (.flags | index("failures") != null)'
  check "gamma model-switch flag"        '.sessions[] | select(.lane=="gamma") | .flags | index("model-switch") != null'
  check "gamma denied flag"              '.sessions[] | select(.lane=="gamma") | .flags | index("denied") != null'
  check "gamma compactions flag"         '.sessions[] | select(.lane=="gamma") | .flags | index("compactions") != null'
  check "gamma api-failure flag"         '.sessions[] | select(.lane=="gamma") | .flags | index("api-failure") != null'
  check "delta working, no flags"        '.sessions[] | select(.lane=="delta") | .state=="working" and (.flags | length == 0)'
  check "delta snapshot joined"          '.sessions[] | select(.lane=="delta") | .model=="claude-opus-5-5" and .cost_usd==1.2345'
  check "zeta idle after late PreCompact and SubagentStop" '.sessions[] | select(.lane=="zeta") | .state=="idle" and (.flags | length == 0)'
  check "empty cwd keeps the lane name"  '[.sessions[] | select(.sid=="gggggggg-7") | .lane] == ["eta"]'
  check "five-day-old session left out"  '[.sessions[] | select(.lane=="theta")] | length == 0'
  # $today was read before the report was built; the second date covers a run that crosses UTC midnight
  check "period covers yesterday to today" "(.period.to == \"$today\" or .period.to == \"$(date -u +%Y-%m-%d)\") and .period.days == 2 and .period.from != .period.to"
  check "--days 7 includes it"           '[.sessions[] | select(.lane=="theta")] | length == 1' "$rwide"
  check "skill use tallied"              '.mix.skills | map(.name) | index("lane-report") != null'
  check "MCP use tallied"                '.mix.mcp | map(.name) | index("mcp__alpaca__get_account") != null'
  check "subagent use tallied"           '.mix.subagents | map(.name) | index("upstream-scout") != null'
  # usage errors exit 2, never "unbound variable"
  for i in "--days" "--quiet-min" "--days x" "--days 0" "--quiet-min -1"; do
    rc=0
    # shellcheck disable=SC2086  # the case is split into words on purpose
    "$BASH" "$0" $i >/dev/null 2>&1 || rc=$?
    if [ "$rc" = 2 ]; then echo "  pass  usage error: $i"; else echo "  FAIL  usage error: $i (exit $rc)"; fails=$((fails+1)); fi
  done
  # an empty window is exit 4 and names the period
  rc=0; CANON_LEDGER_HOME="$tmp/none" "$BASH" "$0" >/dev/null 2>&1 || rc=$?
  if [ "$rc" = 4 ]; then echo "  pass  empty ledger exits 4"; else echo "  FAIL  empty ledger exits 4 (exit $rc)"; fails=$((fails+1)); fi
  echo
  CFG="$tmp" print_report "$r" | sed -n '1p'
  CFG="$tmp" print_report "$r" >/dev/null || { echo "  FAIL  report could not be printed"; fails=$((fails+1)); }
  rm -rf "$tmp"
  echo
  if [ "$fails" -eq 0 ]; then echo "lanes: selftest passed"; else echo "lanes: selftest FAILED ($fails)"; return 1; fi
}

if [ "$SELFTEST" = 1 ]; then selftest; exit $?; fi
# What is printed shows no home folder path, so no user name: the owner pastes this output into conversations.
# $HOME reads as ~ in the text and the JSON alike (a path's meaning is unchanged for a reader on this machine).
# Only the home folder itself or a path under it is replaced, never a sibling such as $HOME-old.
home_out() {
  # patterns and replacements go through variables: bash 3.2 mishandles a quoted "/" or an escaped ~ inline
  # shellcheck disable=SC2088  # a literal ~ is the point
  local l p1="$HOME/" r1="~/" p2="$HOME\"" r2="~\"" p3="$HOME " r3="~ "
  while IFS= read -r l || [ -n "$l" ]; do
    l=${l//"$p1"/$r1}; l=${l//"$p2"/$r2}; l=${l//"$p3"/$r3}; [[ "$l" != *"$HOME" ]] || l="${l%"$HOME"}~"
    printf '%s\n' "$l"
  done
}
if [ "$RATES" = 1 ]; then
  R=$(rates_report) || exit $?
  if [ "$JSON" = 1 ]; then echo "$R"; else print_rates "$R"; fi | home_out
  exit 0
fi
# the usage row never stops the session report: a failure to read it is reported in the row itself
U=$(usage_reading 2>/dev/null) || U=""
[ -n "$U" ] || U='{"readable": false, "note": "the usage readings could not be read (scripts/lanes error)", "stale_after_min": '"$USAGE_STALE_MIN"', "skipped_files": 0,
  "seven_day": {"used_pct": null, "resets_at": null, "age_min": null, "note": "not reported"},
  "five_hour": {"used_pct": null, "resets_at": null, "age_min": null, "note": "not reported"},
  "source": "rate_limits in the status-line input (https://code.claude.com/docs/en/statusline.md)"}'
# with no ledger in the window the usage reading is still printed, as {"usage": ...} with --json, and the exit stays 4
R=$(build_report) || { rc=$?; if [ "$rc" = 4 ]; then if [ "$JSON" = 1 ]; then echo "$U" | jq '{usage: .}'; else print_usage "$U"; fi | home_out; fi; exit "$rc"; }
R=$(echo "$R" | jq --argjson u "$U" '. + {usage: $u}')
if [ "$JSON" = 1 ]; then echo "$R"; else print_report "$R"; fi | home_out
