#!/bin/bash
# Offline carrier checks for the frozen L2 brief (2026-11-13), N1-N6.
# Contract/pattern: scripts/test-lanes:438-446, the failing osascript stand-in.
# All state is under one system temp folder; neither osascript nor a paper task
# runs. The task body is copied with security, timeout, uv and carrier stand-ins.
# The N6 golden notice follows exit_monitor._notice at d75db684:808-819;
# no Python, environment setup, keychain or network is needed by this self-test.
# shellcheck disable=SC2016 # jq filters and stub bodies expand in their own runtime
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d /tmp/canon-test-exit-monitor-notify.XXXXXX) || exit 1
trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0

check() {
  local label="$1"; shift
  if "$@"; then pass=$((pass + 1)); echo "  pass  $label"
  else fail=$((fail + 1)); echo "  FAIL  $label"; fi
}
need() {
  local label="$1"; shift
  if "$@"; then return 0; fi
  echo "    $label"; return 1
}
jqt() { jq -e "$2" "$1" >/dev/null 2>&1; }
calls() { jq -se "length == $1" "$TEST/calls.jsonl" >/dev/null; }
fresh() {
  TEST="$TMP/$1"; CFG="$TEST/config"; BOX="$CFG/canon/exit-monitor/A"
  mkdir -p "$BOX" "$CFG/canon/exit-monitor/B" "$TMP/home" || return 1
  : > "$TEST/calls.jsonl"
  MODE=ok; NO_NOTIFY=0
}
notice() {
  jq -cn --arg key "$1" --arg flag "$2" --arg state "${3:-uncovered}" --arg account "${4:-A}" '
    {at: "2026-11-13T15:00:00+00:00", key: ("exit-monitor:" + $account + ":" + $key),
     sid: ("exit-monitor:" + $account), lane: ("exit monitor " + $account),
     flag: $flag, state: $state, quiet_min: 0, fail: 0}'
}
run_notify() {
  env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME="$TMP/home" CLAUDE_CONFIG_DIR="$CFG" \
    CASE_DIR="$TEST" OSA_MODE="$MODE" CANON_EXITMON_NO_NOTIFY="$NO_NOTIFY" \
    CANON_EXITMON_OSASCRIPT="$TMP/osa" CANON_EXITMON_NOTIFY_SECS="${NOTIFY_SECS:-30}" ALPACA_API_KEY=fixture-only \
    ALPACA_SECRET_KEY=fixture-only ALPACA_EXTRA_TEST=fixture-only \
    /bin/bash "$ROOT/scripts/exit-monitor-notify" "${1:-A}" > "$TEST/stdout" 2> "$TEST/stderr"
  RC=$?
}

# Record argv and environment NAMES only. All ALPACA values above are synthetic.
cat > "$TMP/osa" <<'STUB'
#!/bin/bash
set -eu
compgen -e | sort > "$CASE_DIR/environment-names"
jq -cn --args '$ARGS.positional' -- "$@" >> "$CASE_DIR/calls.jsonl"
case "$OSA_MODE" in
  fail) exit 9 ;;
  hang) exec sleep 60 ;;
  block-record) mkdir "$CASE_DIR/config/canon/exit-monitor/A/delivered.json" ;;
esac
STUB
chmod +x "$TMP/osa"

n1() {
  local flag='TEST 2 frozen; " & display dialog "argument, not code"'
  fresh N1 || return 1
  notice one "$flag" > "$BOX/alerts.jsonl"
  run_notify
  need 'first notification must succeed' test "$RC" = 0 || return 1
  need 'exactly one notification' calls 1 || return 1
  need 'flag is argv[6], subtitle is the lane, script is fixed' \
    jq -se --arg flag "$flag" '.[0] == ["-e", "on run argv", "-e",
      "display notification (item 1 of argv) with title \"Canon exit monitor\" subtitle (item 2 of argv)",
      "-e", "end run", $flag, "exit monitor A"]' "$TEST/calls.jsonl" >/dev/null || return 1

  fresh N1-batch || return 1
  {
    notice a ordinary-1 dormant
    notice b ordinary-2 unknown
    notice c ordinary-3 dormant
    notice d ordinary-4 dormant
    notice e ordinary-5 dormant
    notice z frozen-first uncovered
  } > "$BOX/alerts.jsonl"
  run_notify
  need 'one summary for six keys' calls 1 || return 1
  need 'uncovered first, at most four flags, total count and lane' \
    jqt "$TEST/calls.jsonl" '.[6] == "6 new flag(s): frozen-first  ·  ordinary-1  ·  ordinary-2  ·  ordinary-3" and .[7] == "exit monitor A"' || return 1
  need 'the summary acknowledges all six keys' jqt "$BOX/delivered.json" 'length == 6'
}

n2() {
  local started took
  fresh N2 || return 1
  notice retry frozen > "$BOX/alerts.jsonl"
  MODE=fail; run_notify
  need 'notifier failure is not a carrier failure' test "$RC" = 0 || return 1
  need 'failed key stays pending' jqt "$BOX/notify-status.json" '.pending == 1 and .sent_now == 0 and .notified == false' || return 1
  need 'failed key is not delivered' jqt "$BOX/delivered.json" '. == []' || return 1
  MODE=ok; run_notify
  need 'retry succeeds' jqt "$BOX/notify-status.json" '.pending == 0 and .sent_now == 1 and .notified == true' || return 1
  run_notify
  need 'successful key is never resent' calls 2 || return 1
  need 'nothing due has null notified' jqt "$BOX/notify-status.json" '.pending == 0 and .sent_now == 0 and .notified == null' || return 1

  fresh N2-timeout || return 1
  notice timeout frozen > "$BOX/alerts.jsonl"
  MODE=hang; NOTIFY_SECS=2; started=$(date +%s); run_notify; took=$(( $(date +%s) - started )); NOTIFY_SECS=30
  # the bound through its seam (2 s), so a loaded machine does not fail a 30 s window
  need "hung notification must stop at its bound (observed $took s)" test "$took" -ge 1 || return 1
  need "hung notification must fit the bound + 5 s kill (observed $took s)" test "$took" -le 20 || return 1
  need 'timeout remains pending and exits zero' test "$RC" = 0 || return 1
  need 'timeout is not delivery' jqt "$BOX/notify-status.json" '.pending == 1 and .sent_now == 0 and .notified == false' || return 1
  MODE=ok; run_notify; run_notify
  need 'timed-out key is retried once, then remembered' calls 2 || return 1

  # Simulate the send/record gap with a failed receipt write after osascript
  # returns success. Recovery may duplicate that send once, then remembers it.
  fresh N2-record || return 1
  notice interrupted frozen > "$BOX/alerts.jsonl"
  MODE=block-record; run_notify
  need 'failed receipt write must be nonzero' test "$RC" != 0 || return 1
  rmdir "$BOX/delivered.json" || return 1
  MODE=ok; run_notify; run_notify
  need 'one resend closes the send/record gap' calls 2
}

n3() {
  fresh N3 || return 1
  {
    notice outside-window expired
    jq -cn 'range(0; 2000) | {key: "recent", lane: "exit monitor A", flag: "recent", state: "dormant"}'
    printf '%s\n' 'not-json' 'null' '[]' '"string"' '{}' '{"key":3}' '{"key":null}'
    notice newest fresh
  } > "$BOX/alerts.jsonl"
  cp "$BOX/alerts.jsonl" "$TEST/outbox-before"
  run_notify
  need 'outbox parsing must succeed' test "$RC" = 0 || return 1
  need 'outbox bytes are unchanged' cmp -s "$TEST/outbox-before" "$BOX/alerts.jsonl" || return 1
  need 'only last 2000 lines, valid string keys, and unique keys' \
    jqt "$BOX/delivered.json" 'sort == ["exit-monitor:A:newest", "recent"]' || return 1
  need 'stand-in must have captured its environment names' test -s "$TEST/environment-names" || return 1
  if grep -q '^ALPACA_' "$TEST/environment-names"; then echo '    ALPACA_ name reached notifier'; return 1; fi
  notice own-b 'account B frozen' uncovered B > "$CFG/canon/exit-monitor/B/alerts.jsonl"
  run_notify B
  need 'B gets its own subtitle and delivery record' jqt "$CFG/canon/exit-monitor/B/delivered.json" '. == ["exit-monitor:B:own-b"]' || return 1
  need 'A receipt is not changed by B' jqt "$BOX/delivered.json" 'length == 2' || return 1
  need 'A and B each notified once' calls 2 || return 1
  need 'B subtitle is its lane' jq -se '.[1][7] == "exit monitor B"' "$TEST/calls.jsonl" >/dev/null || return 1
  fresh N3-default || return 1
  BOX="$TEST/.claude/canon/exit-monitor/B"; mkdir -p "$BOX"
  notice home 'default directory' uncovered B > "$BOX/alerts.jsonl"
  env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME="$TEST" CASE_DIR="$TEST" OSA_MODE=ok \
    CANON_EXITMON_OSASCRIPT="$TMP/osa" /bin/bash "$ROOT/scripts/exit-monitor-notify" B \
    > "$TEST/stdout" 2> "$TEST/stderr"
  RC=$?
  need 'empty ALPACA environment and default HOME directory work' test "$RC" = 0 || return 1
  need 'default directory receipt is written' jqt "$BOX/delivered.json" '. == ["exit-monitor:B:home"]'
}

n4() {
  fresh N4 || return 1
  run_notify
  need 'missing outbox means nothing due' test "$RC" = 0 || return 1
  need 'status includes UTC timestamp and null when empty' jqt "$BOX/notify-status.json" \
    '(.checked_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and .pending == 0 and .sent_now == 0 and .notified == null' || return 1
  ln "$BOX/notify-status.json" "$TEST/old-status" || return 1
  notice disabled frozen > "$BOX/alerts.jsonl"
  NO_NOTIFY=1; run_notify
  need 'NO_NOTIFY keeps due keys pending' jqt "$BOX/notify-status.json" '.pending == 1 and .sent_now == 0 and .notified == false' || return 1
  need 'NO_NOTIFY sends nothing' calls 0 || return 1
  need 'status is replaced, not truncated in place' jqt "$TEST/old-status" '.notified == null' || return 1
  NO_NOTIFY=0; run_notify
  need 'reenabling delivers the pending key' calls 1 || return 1
  rm "$BOX/notify-status.json"; mkdir "$BOX/notify-status.json"
  run_notify
  need 'unwritable status fails' test "$RC" != 0 || return 1
  need 'write failure is named on stderr' test -s "$TEST/stderr" || return 1
  fresh N4-outbox || return 1
  mkdir "$BOX/alerts.jsonl"; run_notify
  need 'unreadable outbox fails' test "$RC" != 0 || return 1
  need 'read failure rewrites status with unknown pending count' jqt "$BOX/notify-status.json" \
    '.pending == null and .sent_now == 0 and .notified == false and (.error | contains("alerts.jsonl"))' || return 1
  fresh N4-receipt || return 1
  printf '%s\n' '{broken' > "$BOX/delivered.json"; run_notify
  need 'corrupt receipt fails instead of forgetting delivery' test "$RC" != 0
}

n5() {
  local task account code carrier_code want
  fresh N5 || return 1
  mkdir "$TEST/bin"
  task=$(sed -n '/^\[tasks\."paper:exit-monitor"\]/,/^\[tasks\."paper:close"\]/p' "$ROOT/mise.toml")
  need 'task has its 3m bound' grep -q '^timeout = "3m" ' <<< "$task" || return 1
  printf '%s\n' "$task" | sed -n "/^run = '''$/,/^'''$/p" | sed '1d;$d' > "$TEST/task.raw"
  need 'pass retains its 50s KILL bound' grep -q '/usr/bin/timeout -s KILL 50 uv run --locked python -m canon_trading.exit_monitor' "$TEST/task.raw" || return 1
  # Execute only this copied body. Absolute keychain and timeout commands are
  # replaced before execution, and PATH contains a uv stand-in, never real uv.
  sed -e "s|/usr/bin/security|$TEST/bin/security|g" \
      -e "s|/usr/bin/timeout|$TEST/bin/timeout|g" \
      -e "s|\"\$MISE_PROJECT_ROOT/scripts/exit-monitor-notify\"|$TEST/bin/carrier|g" "$TEST/task.raw" > "$TEST/task.sh"
  cat > "$TEST/bin/security" <<'STUB'
#!/bin/bash
printf '%s\n' fixture-only
STUB
  cat > "$TEST/bin/timeout" <<'STUB'
#!/bin/bash
if [ "$1" = -s ]; then shift 3; else shift; fi
exec "$@"
STUB
  cat > "$TEST/bin/uv" <<'STUB'
#!/bin/bash
printf 'pass %s\n' "$*" >> "$CASE_DIR/task.log"
exit "$PASS_RC"
STUB
  cat > "$TEST/bin/carrier" <<'STUB'
#!/bin/bash
printf 'carrier %s\n' "$*" >> "$CASE_DIR/task.log"
compgen -e | sort > "$CASE_DIR/task-environment-names"
exit "$CARRIER_RC"
STUB
  chmod +x "$TEST/bin/security" "$TEST/bin/timeout" "$TEST/bin/uv" "$TEST/bin/carrier"
  for account in tests windows; do
    case "$account" in tests) want=A ;; windows) want=B ;; esac
    for code in 0 7 137; do
      for carrier_code in 0 9; do
        : > "$TEST/task.log"
        env -i PATH="$TEST/bin:/usr/bin:/bin" HOME="$TMP/home" CASE_DIR="$TEST" \
          usage_account="$account" PASS_RC="$code" CARRIER_RC="$carrier_code" \
          /bin/bash -e "$TEST/task.sh" > "$TEST/task.stdout" 2> "$TEST/task.stderr"
        RC=$?
        need "pass exit $code preserved ($account, carrier $carrier_code)" test "$RC" = "$code" || return 1
        need 'pass then carrier, exactly once each, for the selected account' \
          test "$(cat "$TEST/task.log")" = "pass run --locked python -m canon_trading.exit_monitor $want
carrier $want" || return 1
        need 'carrier environment was captured' test -s "$TEST/task-environment-names" || return 1
        if grep -Eq '^ALPACA_(API_KEY|SECRET_KEY)$' "$TEST/task-environment-names"; then
          echo '    task passed a key variable to the carrier'; return 1
        fi
        if [ "$carrier_code" != 0 ]; then
          need 'carrier failure must be named on stderr' grep -q 'carrier' "$TEST/task.stderr" || return 1
        fi
      done
    done
  done
  : > "$TEST/task.log"
  env -i PATH="$TEST/bin:/usr/bin:/bin" HOME="$TMP/home" CASE_DIR="$TEST" \
    usage_account=protect PASS_RC=0 CARRIER_RC=0 /bin/bash "$TEST/task.sh" 2> "$TEST/task.stderr"
  RC=$?
  need 'C is still refused before any pass or carrier' test "$RC" = 3 || return 1
  need 'C triggers neither stand-in' test ! -s "$TEST/task.log"
}

n6() {
  local flag='TEST quantity 2 uncovered, remainder 2, age 0s engine; frozen by the protector; next act protect'
  fresh N6 || return 1
  # Fixture matching the base _notice(A, now, key, message, "uncovered")
  # contract, with consecutive episode alert_count keys (:1045 at the base).
  # Direct Python generation is not run by this bash-only self-test.
  notice 'TEST:2026-11-13T15:00:00+00:00:uncovered:0' "$flag" > "$BOX/alerts.jsonl"
  run_notify
  need 'first frozen pass delivers immediately' test "$RC" = 0 || return 1
  need 'frozen flag arrives verbatim on that first run' \
    jq -se --arg flag "$flag" 'length == 1 and .[0][6] == $flag' "$TEST/calls.jsonl" >/dev/null || return 1
  notice 'TEST:2026-11-13T15:00:00+00:00:uncovered:1' "$flag" >> "$BOX/alerts.jsonl"
  run_notify; run_notify
  need 'repeat key delivers once, original is not sent again' calls 2 || return 1
  need 'both alert_count keys are remembered' jqt "$BOX/delivered.json" 'length == 2' || return 1
  need 'repeat run had just one due flag, unchanged' \
    jq -se --arg flag "$flag" '.[1][6] == $flag' "$TEST/calls.jsonl" >/dev/null
}

# Review round (code review, 2026-11-13): one run at a time, a pruned receipt,
# a key's latest line, and a status that tells a send not recorded apart.
n7() {
  fresh N7-lock || return 1
  notice held frozen > "$BOX/alerts.jsonl"
  mkdir "$BOX/.notify.lock" || return 1
  run_notify
  need 'a fresh lock sends nothing and exits 0' eval 'test "$RC" = 0 && calls 0' || return 1
  touch -t 202601010000 "$BOX/.notify.lock" || return 1
  run_notify
  need 'a stale lock is taken over and the alert sent' calls 1 || return 1
  need 'the lock is released after the run' test ! -e "$BOX/.notify.lock" || return 1

  fresh N7-prune || return 1
  printf '%s\n' '["exit-monitor:A:gone"]' > "$BOX/delivered.json"
  notice kept frozen > "$BOX/alerts.jsonl"
  run_notify
  need 'a delivered key no longer in the window is dropped' \
    jqt "$BOX/delivered.json" '. == ["exit-monitor:A:kept"]' || return 1

  fresh N7-latest || return 1
  { notice same 'old text'; notice same 'new text'; } > "$BOX/alerts.jsonl"
  run_notify
  need "a repeated key shows its latest line's flag" \
    jq -se '.[0][6] == "new text"' "$TEST/calls.jsonl" >/dev/null || return 1

  fresh N7-status || return 1
  notice recorded frozen > "$BOX/alerts.jsonl"
  MODE=block-record; run_notify
  need 'a send not recorded says notified, nothing pending, and its error' \
    jqt "$BOX/notify-status.json" '.notified == true and .sent_now == 1 and .pending == 0 and (.error | test("delivered"))'
}

check 'N1: argv, title, lane, batching and uncovered priority' n1
check 'N2: receipt, retry, 30s timeout and send/record gap' n2
check 'N3: read-only last 2000 lines, malformed rows and no ALPACA environment' n3
check 'N4: atomic status, no-notify and file errors' n4
check 'N5: pass then carrier, exit preservation and credential-free invocation' n5
check 'N6: frozen notice on first pass and once per repeat key' n6
check 'N7: one run at a time, pruned receipt, latest line, honest status' n7
echo "exit-monitor-notify: $pass passed, $fail failed, 0 skipped"
[ "$fail" -eq 0 ]
