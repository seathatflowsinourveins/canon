#!/bin/bash
# test-account-lock — checks of scripts/account-lock, which holds one Alpaca account's lock, and its stream lock
# when asked, while a command runs (docs/adr/0110, change (g); the paper locks are docs/adr/0069's).
#
# The cases are the ones scripts/test-lanes has for the paper locks ("paper lock deadline", "two accounts"):
# the lock is held while the command runs and free after it, a second run waits its bound and runs nothing, the
# deadline and a stop leave nothing running and the lock free, the live locks and the paper locks do not wait
# for each other, and a temporary folder that is not known stops the run before any lock.
# No case touches a real lock: every run is a copy of the script whose getconf is swapped for a stand-in that
# names a folder of the test's own, and a copy that still names the real getconf is a failed case and is not
# run. No case reads a credential or reaches the network; the commands run are stand-ins.
# Exit 0 if every case behaves as expected, 1 otherwise.
# shellcheck disable=SC2016  # stand-in bodies and eval'd checks are single-quoted so they expand when they run
set -uo pipefail
# run from a git hook, git exports GIT_DIR and friends; clear them
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars 2>/dev/null)
# the script refuses a run while this is set (the case below sets it itself); a caller's own must not reach the rest
unset CANON_PAPER_SESSION_DIR
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-account-lock.XXXXXX") \
  || { echo "test-account-lock: could not create a temp folder under ${TMPDIR:-/tmp}; nothing was written" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT
TMP=$(cd "$TMP" && pwd -P)
pass=0; fail=0; skipped=0; skips=""
t_pass() { pass=$((pass+1)); echo "  pass  $1"; }
t_fail() { fail=$((fail+1)); echo "  FAIL  $1"; }
# skip <case> <why>: the case checked nothing here. A case name holds no " (", which scripts/ci reads as the
# start of the reason.
skip()   { skipped=$((skipped+1)); skips="$skips; $1"; echo "  skip  $1 ($2)"; }
check()  { local label="$1"; shift; if "$@"; then t_pass "$label"; else t_fail "$label"; fi; }

AL="$ROOT/scripts/account-lock"; MT="$ROOT/mise.toml"
# shellcheck disable=SC2034  # read by the eval'd checks
SW="$ROOT/src/canon_trading/session_window.py"
LIVE_LOCK=canon-live.lock; LIVE_STREAM=canon-alpaca-stream-live.lock

# ---------- the names, as written ----------
echo "account-lock, as written:"
check "the live account's locks are $LIVE_LOCK and $LIVE_STREAM" \
      grep -qx "  live) alock=$LIVE_LOCK; slock=$LIVE_STREAM ;;" "$AL"
# named apart from every paper lock: no task, runner or module of the paper side names either file
# shellcheck disable=SC2034  # read by the eval'd check
others=$(grep -rlE "canon-live\.lock|canon-alpaca-stream-live\.lock" "$MT" "$ROOT/home" "$ROOT/scripts" "$ROOT/src" "$ROOT/packages" "$ROOT/tests" 2>/dev/null \
  | grep -v -e '/scripts/account-lock$' -e '/scripts/test-account-lock$' -e '__pycache__' -e '/\.venv/' | tr '\n' ' ')
check "... and nothing else in mise.toml, home/, scripts/, src/, packages/ or tests/ names either (named in: ${others:-none})" test -z "$others"
check "the paper accounts' locks are the ones mise.toml's paper tasks open: tests and windows, each with its stream lock" \
      eval 'grep -qx "  tests) alock=canon-paper-test.lock; slock=canon-alpaca-stream-tests.lock ;;" "$AL" && grep -qx "  windows) alock=canon-paper-windows.lock; slock=canon-alpaca-stream-windows.lock ;;" "$AL" && grep -qF "exec 9>>\"\${tmp}canon-paper-test.lock\"" "$MT" && grep -qF "exec 9>>\"\${tmp}canon-paper-windows.lock\"" "$MT" && grep -qF "exec 7>>\"\${tmp}canon-alpaca-stream-tests.lock\"" "$MT" && grep -qF "exec 7>>\"\${tmp}canon-alpaca-stream-windows.lock\"" "$MT"'
check "account C's lock is the one mise.toml's paper tasks open for protect, and its stream lock the one paper_start takes for it" \
      eval 'grep -qx "  protect) alock=canon-paper-protect.lock; slock=canon-alpaca-stream-protect.lock ;;" "$AL" && grep -qF "protect) svc=canon-alpaca-paper-protect; lock=canon-paper-protect.lock ;;" "$MT" && grep -qxF "    \"protect\": \"canon-paper-protect.lock\"," "$SW"'
# the Python holder (session_window.paper_start, which paper:protector starts under) builds each paper
# account's stream lock from the account's name, so no search for a literal name finds it there
check "... as it takes every paper account's: the account lock by these names, then canon-alpaca-stream-<account>.lock" \
      eval 'grep -qF "for name in (PAPER_ACCOUNT_LOCKS[account], f\"canon-alpaca-stream-{account}.lock\"):" "$SW" && grep -qxF "    \"tests\": \"canon-paper-test.lock\"," "$SW" && grep -qxF "    \"windows\": \"canon-paper-windows.lock\"," "$SW"'
check "... and it knows no account but live, tests, windows and protect" \
      eval '[ "$(grep -cE "^  [a-z]+\) alock=" "$AL")" = 4 ]'
# shellcheck disable=SC2034  # read by the eval'd check
lw_paper=$(awk -v q="'''" '$0 == "[tasks.\"paper:test\"]" {t=1; next} /^\[/ {t=0} t && $0 == "run = " q {b=1; next} b && $0 == q {exit} b' "$MT" | sed -n '/^lock_wait() {/,/^}/p')
# shellcheck disable=SC2034  # read by the eval'd check
lw_script=$(sed -n '/^lock_wait() {/,/^}/p' "$AL")
check "its lock_wait is paper:test's own text, so a wait does not spin a core (ADR 0065)" \
      eval '[ -n "$lw_paper" ] && [ "$lw_script" = "$lw_paper" ]'
check "the account's lock is taken on descriptor 9, then the stream lock on 7, each by lock_wait, and never lockf's descriptor form with a wait" \
      eval '[ "$(grep -n "^exec 9>>\"\${tmp}\${alock}\" || " "$AL" | cut -d: -f1)" -lt "$(grep -n "^  exec 7>>\"\${tmp}\${slock}\" || " "$AL" | cut -d: -f1)" ] && grep -qxF "if lock_wait 9 \"\$lockwait\"; then held=yes; else held=no; fi" "$AL" && grep -qxF "  if lock_wait 7 \"\$left\"; then sheld=yes; else sheld=no; fi" "$AL" && ! grep -Eq "/usr/bin/lockf -t [^0 ]" "$AL"'
check "the lock folder is the per-user temporary folder and nothing else: one assignment, from getconf, and no variable or option moves it" \
      eval '[ "$(grep -c "^tmp=" "$AL")" = 1 ] && grep -qxF "tmp=\"\$(/usr/bin/getconf DARWIN_USER_TEMP_DIR)\" || tmp=\"\"" "$AL" && ! grep -Eq "\\\$\{?(TMPDIR|LOCK)" "$AL"'
check "... and the one variable of the environment it reads is the one it refuses a run for: CANON_PAPER_SESSION_DIR, which moves the Python holder's folder" \
      eval '[ "$(LC_ALL=C grep -cE "\\\$\{?[A-Z][A-Z_]+" "$AL")" = 1 ] && grep -qxF "if [ -n \"\${CANON_PAPER_SESSION_DIR:-}\" ]; then" "$AL" && grep -qxF "PAPER_DIR_ENV = \"CANON_PAPER_SESSION_DIR\"" "$SW"'
check "from a terminal the command is exec'd, after both locks are held" \
      eval '[ "$(grep -n "^\[ ! -t 0 \] || exec \"\$@\"\$" "$AL" | cut -d: -f1)" -gt "$(grep -n "^locked=1\$" "$AL" | cut -d: -f1)" ]'
# timeout passes a SIGTERM it gets on to the command (man timeout), so a SIGTERM to its whole group as well would
# tell the command twice, and break off a cancel that a plain handler had begun
check "a stop tells timeout alone to end, never its whole group, so the command is told once" \
      eval 'grep -qxF "        kill -TERM \"\$g\" 2>/dev/null" "$AL" && [ "$(grep -c "kill -TERM" "$AL")" = 1 ]'

# ---------- a wrong call ----------
echo "a wrong call:"
G="$TMP/getconf"; L="$TMP/locks"; W="$TMP/work"; mkdir -p "$G" "$L" "$W"
printf '#!/bin/bash\necho "%s/"\n' "$L" > "$G/names-the-test-folder"; chmod +x "$G/names-the-test-folder"
# copy_with <getconf stand-in> <to>: the script with its getconf swapped; fails unless the real one is gone
copy_with() {
  sed "s#/usr/bin/getconf DARWIN_USER_TEMP_DIR#$1#" "$AL" > "$2" && chmod +x "$2" \
    && ! grep -q "/usr/bin/getconf" "$2" && grep -qF "tmp=\"\$($1)\"" "$2"
}
if ! copy_with "$G/names-the-test-folder" "$TMP/account-lock"; then
  t_fail "a copy of scripts/account-lock with its getconf swapped for the test's stand-in"
  echo "test-account-lock: $pass passed, $fail failed, 0 skipped"; exit 1
fi
C="$TMP/account-lock"
printf '#!/bin/bash\necho ran >> "%s/ran"\n' "$W" > "$W/noted"; chmod +x "$W/noted"
# wrong <label> <arguments...>: exit 3, refused by name (a line that ends "nothing was run"), nothing run, no lock
# file made
wrong() {
  local label="$1"; shift
  rm -f "${W:?}/ran" "${L:?}"/*
  "$C" "$@" > "$W/out" 2>&1 < /dev/null; rc=$?
  check "$label: exit 3, refused by name, nothing run, no lock file made" eval '[ "$rc" = 3 ] && grep -q "^account-lock: .*; nothing was run\$" "$W/out" && [ ! -e "$W/ran" ] && [ -z "$(ls -A "$L")" ]'
}
wrong "no argument"
wrong "an account that is not one" other --wait 1 --deadline 5 -- "$W/noted"
check "... refused by name" grep -q "no account named 'other'; the names are live, tests, windows and protect" "$W/out"
wrong "no deadline" live --wait 1 -- "$W/noted"
wrong "no wait" live --deadline 5 -- "$W/noted"
wrong "a deadline of 0" live --wait 1 --deadline 0 -- "$W/noted"
wrong "a wait that is not a whole number" live --wait 1.5 --deadline 5 -- "$W/noted"
wrong "a grace that is not a whole number" live --wait 1 --deadline 5 --grace soon -- "$W/noted"
# a leading zero: the shell's arithmetic reads it as octal, where 08 is an error that skips the refusal of a
# held lock and 010 is eight
wrong "a wait with a leading zero (08)" live --wait 08 --deadline 5 -- "$W/noted"
check "... refused by name" grep -q "'08' has a leading zero, which the shell's arithmetic would read as octal" "$W/out"
wrong "a deadline with a leading zero (010)" live --wait 1 --deadline 010 -- "$W/noted"
wrong "a grace with a leading zero (09)" live --wait 1 --deadline 5 --grace 09 -- "$W/noted"
wrong "an option it does not have" live --wait 1 --deadline 5 --lock-dir "$W" -- "$W/noted"
wrong "no -- before the command" live --wait 1 --deadline 5 "$W/noted"
wrong "no command" live --wait 1 --deadline 5 --

# ---------- the temporary folder, when getconf gives none ----------
echo "per-user temporary folder:"
printf '#!/bin/bash\nexit 1\n' > "$G/fails"; printf '#!/bin/bash\nexit 0\n' > "$G/says-nothing"; printf '#!/bin/bash\necho relative/\n' > "$G/says-relative"
chmod +x "$G/fails" "$G/says-nothing" "$G/says-relative"
for how in fails says-nothing says-relative; do
  mkdir -p "$W/cwd-$how"; rm -f "${W:?}/ran"
  if ! copy_with "$G/$how" "$W/account-lock-$how"; then t_fail "a copy whose getconf $how"; continue; fi
  (cd "$W/cwd-$how" && "$W/account-lock-$how" live --stream --wait 1 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null); rc=$?
  check "a getconf that $how: refused before any lock, nothing run, nothing made in its folder, exit 1" \
        eval '[ "$rc" = 1 ] && grep -q "per-user temporary folder is not known" "$W/out" && [ ! -e "$W/ran" ] && [ -z "$(ls -A "$W/cwd-$how")" ]'
done

# ---------- a lock file that cannot be opened ----------
# The folder getconf names is not there, and the caller has passed descriptors 9 and 7 down, open on files of
# its own (a paper task's body and an outer run of this script hold 9 and 7): the run must end at the failed
# open, not lock what the caller passed and carry on.
echo "a lock file that cannot be opened:"
printf '#!/bin/bash\necho "%s/"\n' "$W/no-such-folder" > "$G/names-no-folder"; chmod +x "$G/names-no-folder"
if ! copy_with "$G/names-no-folder" "$W/account-lock-no-folder"; then t_fail "a copy whose getconf names a folder that is not there"
else
  rm -f "${W:?}/ran"
  "$W/account-lock-no-folder" live --stream --wait 1 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null 9>> "$W/callers-9" 7>> "$W/callers-7"; rc=$?
  check "the account's lock file cannot be opened, with the caller's own descriptors 9 and 7 passed down: refused by name, nothing run, exit 1" \
        eval '[ "$rc" = 1 ] && grep -q "account live.s lock file could not be opened in the per-user temporary folder; nothing was run" "$W/out" && [ ! -e "$W/ran" ] && [ ! -e "$W/no-such-folder" ]'
fi

# ---------- a clock that gives no time ----------
# swapped <sed expression> <to> <gone>: the script with its getconf swapped for the test folder's stand-in, as every
# copy is, and one more change; fails unless the real getconf is gone, no line matches <gone> (what the change takes
# out, an extended regular expression) and the copy differs from the plain copy
swapped() {
  sed -e "s#/usr/bin/getconf DARWIN_USER_TEMP_DIR#$G/names-the-test-folder#" -e "$1" "$AL" > "$2" && chmod +x "$2" \
    && ! grep -q "/usr/bin/getconf" "$2" && grep -qF "tmp=\"\$($G/names-the-test-folder)\"" "$2" \
    && ! grep -Eq -e "$3" "$2" && ! cmp -s "$2" "$C"
}
echo "a clock that gives no time:"
printf '#!/bin/bash\nexit 0\n' > "$G/no-clock"; chmod +x "$G/no-clock"
if ! swapped "s#/bin/date +%s#$G/no-clock#g" "$W/account-lock-no-clock" "/bin/date"; then
  t_fail "a copy whose clock is swapped for one that prints nothing"
else
  rm -f "${W:?}/ran" "${L:?}"/*
  "$W/account-lock-no-clock" live --stream --wait 1 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?
  check "a clock read that returns nothing: refused by name before any lock, nothing run, no lock file made, exit 1" \
        eval '[ "$rc" = 1 ] && grep -q "the clock gave no time" "$W/out" && grep -q "nothing was run" "$W/out" && [ ! -e "$W/ran" ] && [ -z "$(ls -A "$L")" ]'
fi

# ---------- a variable that moves the Python holder's lock folder ----------
# CANON_PAPER_SESSION_DIR names the records folder whose parent paper:protector's holder locks in
# (session_window.default_log_dir, protector_node.run), so with it set a run here and a run there would each
# hold a lock the other never asks for: refused by name, for every account, before any lock
echo "a variable that would move a paper task's lock:"
for acct in live tests windows protect; do
  rm -f "${W:?}/ran" "${L:?}"/*; rm -rf "${W:?}/elsewhere"
  CANON_PAPER_SESSION_DIR="$W/elsewhere/records" "$C" "$acct" --stream --wait 1 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?
  check "$acct with CANON_PAPER_SESSION_DIR set: refused by name, nothing run, no lock file made here or there, exit 1" \
        eval '[ "$rc" = 1 ] && grep -q "CANON_PAPER_SESSION_DIR is set" "$W/out" && grep -q "nothing was run" "$W/out" && [ ! -e "$W/ran" ] && [ -z "$(ls -A "$L")" ] && [ ! -e "$W/elsewhere" ]'
done

# ---------- the locks held and waited for ----------
if [ ! -x /usr/bin/lockf ] || [ ! -x /usr/bin/timeout ]; then
  skip "account-lock under lockf and timeout" "no /usr/bin/lockf or /usr/bin/timeout here (macOS only)"
else
  echo "the locks, held and waited for:"
  # probe: a command that notes, for each lock file, whether another open of it can take the lock (0) or it is
  # held (75), as the next run would find it, and ends 7
  cat > "$W/probe" <<PROBE
#!/bin/bash
for f in $LIVE_LOCK $LIVE_STREAM canon-paper-test.lock canon-alpaca-stream-tests.lock canon-paper-windows.lock canon-alpaca-stream-windows.lock canon-paper-protect.lock canon-alpaca-stream-protect.lock; do
  /usr/bin/lockf -k -t 0 "$L/\$f" true 2>/dev/null; echo "\$f \$?"
done > "$W/probed"
exit 7
PROBE
  chmod +x "$W/probe"
  probed() { grep -qx "$1 $2" "$W/probed"; }   # probed <lock file> <0|75>
  free() { /usr/bin/lockf -k -t 0 "$L/$1" true 2>/dev/null; }
  # hold <lock file>: another process holds it until `release`
  hold() { /usr/bin/lockf -k "$L/$1" sleep 60 & hp="$hp $!"; for _ in $(seq 50); do free "$1" || break; sleep 0.1; done; }
  release() { for p in $hp; do kill "$p" 2>/dev/null; wait "$p" 2>/dev/null; done; hp=""; }
  hp=""
  run() { rm -f "${W:?}/probed" "${W:?}/ran"; s0=$(date +%s); "$C" "$@" > "$W/out" 2>&1 < /dev/null; rc=$?; took=$(( $(date +%s) - s0 )); }

  run live --wait 2 --deadline 30 -- "$W/probe"
  check "live: the command runs holding the live account's lock and no other, and its exit status (7) is the run's" \
        eval '[ "$rc" = 7 ] && probed $LIVE_LOCK 75 && probed $LIVE_STREAM 0 && probed canon-paper-test.lock 0 && probed canon-paper-windows.lock 0'
  check "... and the lock is free once it has ended" free "$LIVE_LOCK"
  run live --stream --wait 2 --deadline 30 -- "$W/probe"
  check "live --stream: it holds the live account's lock and the live stream lock, and no paper lock" \
        eval '[ "$rc" = 7 ] && probed $LIVE_LOCK 75 && probed $LIVE_STREAM 75 && probed canon-paper-test.lock 0 && probed canon-alpaca-stream-tests.lock 0 && probed canon-paper-windows.lock 0 && probed canon-alpaca-stream-windows.lock 0'
  check "... both free once it has ended" eval 'free $LIVE_LOCK && free $LIVE_STREAM'
  run tests --stream --wait 2 --deadline 30 -- "$W/probe"
  check "tests --stream: account A's lock and stream lock, as paper:test and paper:data take them, and no other" \
        eval '[ "$rc" = 7 ] && probed canon-paper-test.lock 75 && probed canon-alpaca-stream-tests.lock 75 && probed $LIVE_LOCK 0 && probed $LIVE_STREAM 0 && probed canon-paper-windows.lock 0'
  run windows --stream --wait 2 --deadline 30 -- "$W/probe"
  check "windows --stream: account B's lock and stream lock, as paper:session takes them, and no other" \
        eval '[ "$rc" = 7 ] && probed canon-paper-windows.lock 75 && probed canon-alpaca-stream-windows.lock 75 && probed $LIVE_LOCK 0 && probed canon-paper-test.lock 0'

  run protect --wait 2 --deadline 30 -- "$W/probe"
  check "protect: account C's lock, as paper:protect takes it, and no other" \
        eval '[ "$rc" = 7 ] && probed canon-paper-protect.lock 75 && probed canon-alpaca-stream-protect.lock 0 && probed $LIVE_LOCK 0 && probed canon-paper-test.lock 0 && probed canon-paper-windows.lock 0'
  run protect --stream --wait 2 --deadline 30 -- "$W/probe"
  check "protect --stream: account C's lock and its stream lock, the two paper:protector's holder takes, and no other" \
        eval '[ "$rc" = 7 ] && probed canon-paper-protect.lock 75 && probed canon-alpaca-stream-protect.lock 75 && probed $LIVE_LOCK 0 && probed $LIVE_STREAM 0 && probed canon-paper-test.lock 0 && probed canon-paper-windows.lock 0'
  hold canon-alpaca-stream-protect.lock
  run protect --stream --wait 2 --deadline 30 -- "$W/noted"
  check "protect --stream while another run holds account C's stream lock: it waits out its 2 s (${took} s), runs nothing, exit 1" \
        eval '[ "$rc" = 1 ] && [ "$took" -lt 20 ] && [ ! -e "$W/ran" ] && grep -q "account protect.s market-data stream lock stayed held (2 s for both locks); nothing was run" "$W/out"'
  release

  hold "$LIVE_LOCK"
  run live --wait 2 --deadline 30 -- "$W/noted"
  check "live while another run holds the live account's lock: it waits its 2 s (${took} s), runs nothing, exit 1" \
        eval '[ "$rc" = 1 ] && [ "$took" -lt 20 ] && [ ! -e "$W/ran" ] && grep -q "account live.s lock stayed held for 2 s; nothing was run" "$W/out"'
  run tests --stream --wait 2 --deadline 30 -- "$W/probe"
  check "... and a run on paper account A meanwhile runs at once (${took} s): the live lock is no paper run's" \
        eval '[ "$rc" = 7 ] && [ "$took" -lt 20 ] && probed canon-paper-test.lock 75'
  # the folder is not the environment's: with TMPDIR naming another folder the run still finds the held lock
  mkdir -p "$W/other-tmp"; rm -f "${W:?}/ran"
  s0=$(date +%s); TMPDIR="$W/other-tmp/" "$C" live --wait 2 --deadline 30 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?; took=$(( $(date +%s) - s0 ))
  check "... and so does a run whose TMPDIR names another folder (${took} s): nothing run, no lock file made there, exit 1" \
        eval '[ "$rc" = 1 ] && [ ! -e "$W/ran" ] && [ -z "$(ls -A "$W/other-tmp")" ] && grep -q "account live.s lock stayed held for 2 s; nothing was run" "$W/out"'
  release
  hold "$LIVE_STREAM"
  run live --stream --wait 2 --deadline 30 -- "$W/noted"
  check "live --stream while another run holds the live stream lock: it waits out its 2 s (${took} s), runs nothing, exit 1" \
        eval '[ "$rc" = 1 ] && [ "$took" -lt 20 ] && [ ! -e "$W/ran" ] && grep -q "account live.s market-data stream lock stayed held (2 s for both locks); nothing was run" "$W/out"'
  check "... and the live account's lock is free again" free "$LIVE_LOCK"
  run live --wait 2 --deadline 30 -- "$W/probe"
  check "... while a run that asks for no stream runs at once under the account's lock" eval '[ "$rc" = 7 ] && probed $LIVE_LOCK 75 && probed $LIVE_STREAM 75'
  release
  # the stream lock's file cannot be opened (a folder has its name), the account's lock already held by this run
  mkdir -p "$TMP/locks-stream-blocked/$LIVE_STREAM"
  printf '#!/bin/bash\necho "%s/"\n' "$TMP/locks-stream-blocked" > "$G/names-blocked-stream"; chmod +x "$G/names-blocked-stream"
  if ! copy_with "$G/names-blocked-stream" "$W/account-lock-blocked-stream"; then t_fail "a copy whose getconf names a folder where the stream lock cannot be opened"
  else
    rm -f "${W:?}/ran"
    "$W/account-lock-blocked-stream" live --stream --wait 1 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null 7>> "$W/callers-7"; rc=$?
    check "the stream lock's file cannot be opened, with the caller's own descriptor 7 passed down: refused by name, nothing run, exit 1" \
          eval '[ "$rc" = 1 ] && grep -q "account live.s market-data stream lock file could not be opened in the per-user temporary folder; nothing was run" "$W/out" && [ ! -e "$W/ran" ]'
  fi
  # the command reads the run's own standard input, not an empty one
  out=$(echo "a line on standard input" | "$C" live --wait 2 --deadline 30 -- /bin/cat 2> "$W/err"); rc=$?
  check "live with a line piped in: the command reads it (read: '${out}'), exit 0" eval '[ "$rc" = 0 ] && [ "$out" = "a line on standard input" ]'

  # ---------- a lock step that fails ----------
  # The command runs only past a marker each lock step sets when it holds its lock, so a step that breaks in any
  # way refuses. First the call that broke it as first written: another run holds both live locks and the wait
  # is padded. It is now refused as a wrong call, before any lock step, so this case shows the call, not a step.
  echo "a lock step that fails:"
  hold "$LIVE_LOCK"; hold "$LIVE_STREAM"
  run live --stream --wait 09 --deadline 30 -- "$W/noted"
  check "live --stream --wait 09 while another run holds both live locks: nothing run, refused by name, a non-zero exit ($rc)" \
        eval '[ "$rc" != 0 ] && [ ! -e "$W/ran" ] && grep -q "nothing was run" "$W/out"'
  release
  # Then with two checks taken out of a copy, the whole-number check of the wait and the leading-zero check (in
  # either form: as first written they were one line), so that a wait the shell's arithmetic cannot read reaches
  # lock_wait itself: a padded one, one that is not a number, and a word (at which bash 3.2 ends the whole shell,
  # with status 0). Each broke the step in the script as first written, and the command ran or the run read as done.
  # Each is run without --stream and with it. Without it nothing after the account's step refuses, so that step's
  # own refusal is all that stands between the broken step and the command; with it, the account's step must
  # still be the one that refuses. So the line asked for is that step's own, or, for the word, the exit's.
  if ! swapped '/^whole "\$lockwait" || usage/d; /^if ! whole "\$lockwait"/d; s/case "\$secs" in 0?\*)/case "$secs" in no-such-value)/' "$W/account-lock-unchecked" \
       '^whole "\$lockwait" [|][|] usage|^if ! whole "\$lockwait"|in 0[?][*][)]'; then
    t_fail "a copy with the checks of its numbers taken out"
  else
    for how in "" " --stream"; do
      for w in 08 1.5 soon; do
        # shellcheck disable=SC2034  # read by the eval'd check
        case "$w" in
          soon) line="the run ended inside a lock step, before its locks were held; nothing was run" ;;
          *) line="the step that takes account live.s lock failed, so the lock is not held; nothing was run" ;;
        esac
        rm -f "${W:?}/ran"
        # shellcheck disable=SC2086  # $how is --stream or nothing
        "$W/account-lock-unchecked" live $how --wait "$w" --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?
        check "with the checks of its numbers taken out, --wait $w$how breaks the account's lock step: refused at that step by its own line, or for a word by the exit's, nothing run, exit 1, both locks free" \
              eval '[ "$rc" = 1 ] && [ ! -e "$W/ran" ] && grep -q "^account-lock: $line\$" "$W/out" && free $LIVE_LOCK && free $LIVE_STREAM'
      done
      rm -f "${W:?}/ran"
      # shellcheck disable=SC2086  # $how is --stream or nothing
      "$W/account-lock-unchecked" live $how --wait 2 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?
      check "... and the same copy, called well$how, runs its command (so it is the broken step that was refused)" eval '[ "$rc" = 0 ] && [ -e "$W/ran" ]'
    done
  fi
  # and the stream lock's step alone, the account's lock already held: its wait swapped for one the shell cannot read
  if ! swapped 's/lock_wait 7 "\$left"/lock_wait 7 "08"/' "$W/account-lock-stream-step" 'lock_wait 7 "\$left"'; then
    t_fail "a copy whose stream lock step is given a wait the shell cannot read"
  else
    rm -f "${W:?}/ran"
    "$W/account-lock-stream-step" live --stream --wait 2 --deadline 5 -- "$W/noted" > "$W/out" 2>&1 < /dev/null; rc=$?
    check "the stream lock's step breaks after the account's lock is held: refused by name, nothing run, exit 1, both locks free" \
          eval '[ "$rc" = 1 ] && [ ! -e "$W/ran" ] && grep -q "the step that takes account live.s market-data stream lock failed, so the lock is not held; nothing was run" "$W/out" && free $LIVE_LOCK && free $LIVE_STREAM'
  fi
  for f in canon-paper-test.lock canon-alpaca-stream-tests.lock canon-paper-windows.lock canon-alpaca-stream-windows.lock canon-paper-protect.lock canon-alpaca-stream-protect.lock; do hold "$f"; done
  run live --stream --wait 2 --deadline 30 -- "$W/probe"
  check "live --stream while every paper account's lock and stream lock is held: it runs at once (${took} s), under its own" \
        eval '[ "$rc" = 7 ] && [ "$took" -lt 20 ] && probed $LIVE_LOCK 75 && probed $LIVE_STREAM 75'
  release

  # ---------- the deadline, and a stop before it ----------
  # hang <folder> <trap line>: a command that hangs, with a child that ignores SIGTERM (scripts/test-lanes'
  # stand-in for uv); cleans <folder>: one that, told to end, notes it and ends, its child still ignoring SIGTERM
  echo "the deadline, and a stop before it:"
  hang() {
    mkdir -p "$1"
    cat > "$1/cmd" <<HANG
#!/bin/bash
$2
echo \$\$ > "$1/cmd.pid"
/bin/bash -c 'trap "" TERM; echo \$\$ > "$1/child.pid"; sleep 60' &
wait
HANG
    chmod +x "$1/cmd"
  }
  cleans() {
    mkdir -p "$1"
    cat > "$1/cmd" <<CLEANS
#!/bin/bash
trap 'echo cleaned > "$1/cleaned"; exit 0' TERM
echo \$\$ > "$1/cmd.pid"
/bin/bash -c 'trap "" TERM; echo \$\$ > "$1/child.pid"; sleep 60' &
while :; do sleep 0.2; done
CLEANS
    chmod +x "$1/cmd"
  }
  # ready <folder> <pid>: until the stand-in's child has started, or the run has ended (a readiness signal, not
  # a wall-clock bound)
  ready() { while [ ! -s "$1/child.pid" ] && kill -0 "$2" 2>/dev/null; do sleep 0.1; done; }
  left_up() { local f up=""; for f in cmd.pid child.pid; do [ -s "$1/$f" ] && kill -0 "$(cat "$1/$f")" 2>/dev/null && up="$up ${f%.pid}"; done; echo "$up"; }
  settle() { for _ in $(seq 300); do [ -z "$(left_up "$1")" ] && break; sleep 0.1; done; }   # a ceiling a real hang alone reaches
  reap() {
    local f g
    for f in cmd.pid child.pid; do
      [ -s "$1/$f" ] || continue
      g=$(ps -o pgid= -p "$(cat "$1/$f")" 2>/dev/null | tr -d ' ')
      [ -z "$g" ] || kill -KILL -- "-$g" 2>/dev/null; kill -KILL "$(cat "$1/$f")" 2>/dev/null
    done
  }
  # shellcheck disable=SC2034  # held, orc, up and took are read by the eval'd checks
  for how in "the command ignores SIGTERM" "the command keeps SIGTERM's default"; do
    D="$TMP/deadline-${how##* }"; trapline=""; [ "$how" = "the command ignores SIGTERM" ] && trapline="trap '' TERM"
    hang "$D" "$trapline"
    "$C" live --stream --wait 2 --deadline 4 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"
    free "$LIVE_LOCK"; held=$?
    wait "$op"; orc=$?
    settle "$D"; up=$(left_up "$D")
    check "live, $how: a second run cannot take the lock while it runs" eval '[ -s "$D/child.pid" ] && [ "$held" != 0 ]'
    check "... the deadline stops it and fails the run (exit $orc)" test "$orc" != 0
    check "... nothing it started is left running (left:${up:- none})" test -z "$up"
    check "... and both locks are free for the next run" eval 'free $LIVE_LOCK && free $LIVE_STREAM'
    reap "$D"
  done
  # with a grace: SIGTERM at the deadline, so a command that cancels what it sent can; SIGKILL after it
  # shellcheck disable=SC2034  # orc, up and took are read by the eval'd checks
  {
    D="$TMP/grace-cleans"; cleans "$D"
    "$C" live --wait 2 --deadline 3 --grace 10 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; s0=$(date +%s); wait "$op"; orc=$?; took=$(( $(date +%s) - s0 ))
    settle "$D"; up=$(left_up "$D")
    check "live --grace 10, a command that cleans up when told to end: it is told at the deadline and cleans up, well inside the grace (${took} s)" \
          eval '[ -s "$D/cleaned" ] && [ "$took" -lt 10 ] && [ "$orc" != 0 ]'
    check "... its child that ignored SIGTERM is not left (left:${up:- none}), and the lock is free" eval '[ -z "$up" ] && free $LIVE_LOCK'
    reap "$D"
    D="$TMP/grace-ignores"; hang "$D" "trap '' TERM"
    "$C" live --wait 2 --deadline 2 --grace 2 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; s0=$(date +%s); wait "$op"; orc=$?; took=$(( $(date +%s) - s0 ))
    settle "$D"; up=$(left_up "$D")
    check "live --grace 2, a command that ignores SIGTERM: killed once the grace is over (${took} s), nothing left (left:${up:- none}), the lock free" \
          eval '[ "$orc" != 0 ] && [ "$took" -lt 20 ] && [ -z "$up" ] && free $LIVE_LOCK'
    reap "$D"
  }
  # a stop before the deadline: a SIGTERM to the script (a mise task's timeout, launchd, a person's kill) or to
  # the leader of the command's process group
  # shellcheck disable=SC2034  # orc, up and took are read by the eval'd checks
  for to in "the script" "the group's leader"; do
    D="$TMP/early-${to##* }"; hang "$D" ""
    "$C" live --stream --wait 2 --deadline 60 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; s0=$(date +%s)
    if [ "$to" = "the script" ]; then kill -TERM "$op" 2>/dev/null
    else kill -TERM "$(ps -o pgid= -p "$(cat "$D/cmd.pid" 2>/dev/null)" 2>/dev/null | tr -d ' ')" 2>/dev/null; fi
    wait "$op"; orc=$?; took=$(( $(date +%s) - s0 ))
    settle "$D"; up=$(left_up "$D")
    check "live, a SIGTERM to $to before the deadline: the run fails, nothing it started is left (left:${up:- none}), both locks free, in ${took} s" \
          eval '[ -s "$D/child.pid" ] && [ "$orc" != 0 ] && [ -z "$up" ] && free $LIVE_LOCK && free $LIVE_STREAM && [ "$took" -lt 30 ]'
    reap "$D"
  done
  # shellcheck disable=SC2034  # orc, up and took are read by the eval'd check
  {
    D="$TMP/early-grace"; cleans "$D"
    "$C" live --wait 2 --deadline 60 --grace 10 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; s0=$(date +%s); kill -TERM "$op" 2>/dev/null; wait "$op"; orc=$?; took=$(( $(date +%s) - s0 ))
    settle "$D"; up=$(left_up "$D")
    check "live --grace 10, a SIGTERM to the script: the command is told to end and cleans up (${took} s), then nothing is left (left:${up:- none}), the lock free" \
          eval '[ -s "$D/cleaned" ] && [ "$orc" = 143 ] && [ "$took" -lt 10 ] && [ -z "$up" ] && free $LIVE_LOCK'
    reap "$D"
  }
  # a second stop while the first is under way (a task's timeout, then a closed terminal's SIGHUP) is only noted:
  # the run ends with the first stop's status, and the script does not signal the command a second time.
  # lingers <folder>: a command that, told to end, notes it and keeps running, as a cleanup that takes its time
  lingers() {
    mkdir -p "$1"
    cat > "$1/cmd" <<LINGERS
#!/bin/bash
trap 'echo told >> "$1/told"' TERM
echo \$\$ > "$1/cmd.pid"
/bin/bash -c 'trap "" TERM; echo \$\$ > "$1/child.pid"; sleep 60' &
while :; do sleep 0.2; done
LINGERS
    chmod +x "$1/cmd"
  }
  # shellcheck disable=SC2034  # orc, up and took are read by the eval'd check
  {
    D="$TMP/early-twice"; lingers "$D"
    "$C" live --wait 2 --deadline 60 --grace 4 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; s0=$(date +%s); kill -TERM "$op" 2>/dev/null
    # until the command has been told to end, which the first stop does (a readiness signal, not a wall-clock bound)
    while [ ! -s "$D/told" ] && kill -0 "$op" 2>/dev/null; do sleep 0.1; done
    kill -HUP "$op" 2>/dev/null; wait "$op"; orc=$?; took=$(( $(date +%s) - s0 ))
    settle "$D"; up=$(left_up "$D")
    check "live --grace 4, a SIGTERM to the script and then a SIGHUP during the grace: the run ends as the first stop ends it (exit $orc, 143 expected), in ${took} s, nothing left (left:${up:- none}), the lock free" \
          eval '[ -s "$D/told" ] && [ "$orc" = 143 ] && [ "$took" -lt 20 ] && [ -z "$up" ] && free $LIVE_LOCK'
    reap "$D"
  }
  # one stop tells the command once: timeout passes on the SIGTERM it gets, so one more from the script to the
  # whole group would reach the command as a second, and break off a cancel that a plain handler had begun. The
  # stand-in counts each SIGTERM as it arrives (perl's sigaction, not its deferred %SIG) and ends by itself.
  if [ ! -x /usr/bin/perl ]; then
    skip "account-lock tells the command to end once" "no /usr/bin/perl here"
  else
    D="$TMP/told-once"; mkdir -p "$D"
    cat > "$D/cmd" <<ONCE
#!/usr/bin/perl
use strict; use POSIX;
sigaction(SIGTERM, POSIX::SigAction->new(sub { open(my \$f, '>>', "$D/terms"); print \$f "t\n"; close \$f; }));
open(my \$p, '>', "$D/child.pid"); print \$p "\$\$\n"; close \$p;
my \$end = time + 2; while (time < \$end) { select(undef, undef, undef, 0.05); }
ONCE
    chmod +x "$D/cmd"
    "$C" live --wait 2 --deadline 60 --grace 10 -- "$D/cmd" > "$D/out" 2>&1 < /dev/null & op=$!
    ready "$D" "$op"; kill -TERM "$op" 2>/dev/null; wait "$op"; orc=$?
    # shellcheck disable=SC2034  # read by the eval'd check
    told=$(wc -l < "$D/terms" 2>/dev/null | tr -d ' ')
    check "live --grace 10, one SIGTERM to the script: the command is told to end once (told ${told:-0} times), and the run ends 143 ($orc)" \
          eval '[ "${told:-0}" = 1 ] && [ "$orc" = 143 ]'
  fi

  # ---------- from a terminal ----------
  echo "from a terminal:"
  if [ ! -x /usr/bin/expect ] || ! /usr/bin/expect -c 'spawn -noecho true; expect eof' >/dev/null 2>&1; then
    skip "account-lock from a terminal" "no /usr/bin/expect that can open a pseudo-terminal here"
  else
    rm -f "${W:?}/probed"
    # shellcheck disable=SC2034  # rc is read by the eval'd check
    { AL_COPY="$C" AL_PROBE="$W/probe" /usr/bin/expect -c 'set timeout 30; spawn -noecho $env(AL_COPY) live --stream --wait 2 --deadline 30 -- $env(AL_PROBE); expect eof; lassign [wait] p s o v; exit $v' > "$W/out" 2>&1; rc=$?; }
    check "live --stream on a pseudo-terminal: the command is exec'd holding both locks, and its exit status (7) is the run's" \
          eval '[ "$rc" = 7 ] && probed $LIVE_LOCK 75 && probed $LIVE_STREAM 75 && probed canon-paper-test.lock 0'
    check "... both free once it has ended" eval 'free $LIVE_LOCK && free $LIVE_STREAM'
  fi
fi

# A skipped case checked nothing: one line, last, with the count and the names (as scripts/test-lanes ends).
if [ "$skipped" -gt 0 ]; then
  echo "test-account-lock: $pass passed, $fail failed, $skipped skipped, so NOT CHECKED here:${skips#;}"
else
  echo "test-account-lock: $pass passed, $fail failed, 0 skipped"
fi
[ "$fail" -eq 0 ]
