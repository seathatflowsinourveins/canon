#!/bin/bash
# ci — every check this repo has, in one place (docs/adr/0013-quality-gates.md).
#
# The commit gate (.githooks/pre-commit), scripts/land and the GitHub workflow (.github/workflows/ci.yml)
# all run this script, so a change is judged the same way on this Mac and in CI. Tools come from the pinned
# toolchain: mise.toml + mise.lock for shellcheck, gitleaks, actionlint and uv; uv.lock for ruff, ty and
# pytest. PATH is set once from `mise env`, with the directories mise manages first whatever order the
# caller's PATH had (toolchain_first, below); a tool counts as present only if it is in a directory mise
# manages, so a missing tool fails its check by name.
#
# What is checked:
#   shell files   every tracked file (git ls-files, so staged new files too) whose first line is a sh or
#                 bash shebang: `bash -n` and shellcheck
#   test scripts  every tracked executable scripts/test-*, each as its own check, in name order
#   workflows     actionlint on .github/workflows/*.yml and *.yaml; a skip line when there are none
#   pytest        skipped tests are listed under the `ok pytest` line with their reasons
#   skipped cases a test script's skipped cases are listed under its `ok` line, and counted and named again
#                 in one line before the last (on GitHub also as a warning annotation), so a green run
#                 does not read as a check of them
#   mise configs  before anything runs: a config mise loads from a folder above the checkout (anything but
#                 the checkout's, the global one and /etc/mise) stops the run, naming the file
#
# `uv lock --check` and one `uv run --locked` (which creates the Python environment) run first; then every
# check runs as a background job writing to its own temp file, and the results are printed in a fixed order.
# Checks run without git's repository-local variables (GIT_DIR, GIT_INDEX_FILE, ...), which a commit hook
# sets, except the staged secret scan, which needs them.
#
# Usage: scripts/ci            check everything; the secret scan covers the whole git history
#        scripts/ci --staged   same, but the secret scan covers only what is staged (used by pre-commit)
# A tool that is missing is a failure, never a skip. Exit 0 only if every check passes.
# Slots: one of CANON_CI_SLOTS (default 3) machine-wide slots is held for the whole run (take_slot, below).
# CANON_TEST_CI=1 (set by scripts/test-ci) skips scripts/test-ci itself, with a skip line.
set -uo pipefail
# Priority: once, at the top, this script runs itself again under nice(1) (`man nice`, "nice -n increment utility")
# at a fixed increment of 5, so every check it starts inherits the lower priority and a run of checks yields to
# the paper tasks and to whatever else the machine is doing. CANON_CI_NICED marks the second run.
if [ -z "${CANON_CI_NICED:-}" ]; then CANON_CI_NICED=1 exec nice -n 5 "$0" "$@"; fi
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT" || exit 1
STAGED=0; [ "${1:-}" = "--staged" ] && STAGED=1

if command -v mise >/dev/null 2>&1; then MISE=$(command -v mise)
elif [ -x "$HOME/.local/bin/mise" ]; then MISE="$HOME/.local/bin/mise"
else echo "ci: FAIL: mise not found. Run scripts/bootstrap --install."; exit 1; fi

# Only configs this checkout, the user's global mise config or /etc/mise hold may shape the checks. mise
# reads "config files in every directory from the filesystem root down to the current directory" (mise
# docs, configuration.md) unless a `ceiling_paths` directory stops it, so a mise.toml (or .tool-versions)
# in a folder above this checkout would change the tools, env or tasks every check gets, here and nowhere
# else. Named and refused, not ignored: `mise config ls --json` lists the files in use (`mise help config
# ls`). This sees folders above the checkout only; a self-test that writes its own config in a temp folder
# bounds mise there itself (MISE_CEILING_PATHS). The global folder is compared as given and as resolved.
command -v jq >/dev/null 2>&1 || { echo "ci: FAIL: jq not found; it reads \`mise config ls --json\`. Run scripts/bootstrap --check."; exit 1; }
if ! MISE_CONFIGS=$("$MISE" config ls --json); then echo "ci: FAIL: \`mise config ls --json\` failed."; exit 1; fi
GLOBAL_MISE="${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}"
GLOBAL_MISE="${GLOBAL_MISE%/}"
GLOBAL_MISE_P=$(cd "$GLOBAL_MISE" 2>/dev/null && pwd -P) || GLOBAL_MISE_P="$GLOBAL_MISE"
if ! STRAY=$(jq -r --arg r "$ROOT" --arg rp "$(pwd -P)" --arg g "$GLOBAL_MISE" --arg gp "$GLOBAL_MISE_P" \
       --arg gf "${MISE_GLOBAL_CONFIG_FILE:-}" '.[].path as $p
       | select(($p == $gf) or ([$r, $rp, $g, $gp, "/etc/mise"] | any(. as $d | $p | startswith($d + "/"))) | not) | $p' \
       <<<"$MISE_CONFIGS"); then
  echo "ci: FAIL: could not read the output of \`mise config ls --json\`:"; printf '%s\n' "${MISE_CONFIGS:0:400}"; exit 1
fi
if [ -n "$STRAY" ]; then
  echo "ci: FAIL: mise loads a config from outside this checkout, its global config and /etc/mise:"
  printf '  %s\n' "$STRAY"
  echo "  It changes what every check runs. Move it, or, if it serves other projects, set MISE_CEILING_PATHS"
  echo "  to a folder between it and this checkout (mise's ceiling_paths setting), then run this again."
  exit 1
fi

# Load the toolchain once: `mise env -s bash` prints the exports, `mise env --paths` the directories mise
# manages (both documented in `mise env --help`).
if ! MISE_ENV_SH=$("$MISE" env -s bash); then echo "ci: FAIL: \`mise env -s bash\` failed."; exit 1; fi
if ! MISE_PATHS=$("$MISE" env --paths); then echo "ci: FAIL: \`mise env --paths\` failed."; exit 1; fi
eval "$MISE_ENV_SH"
# Then the directories mise manages go first on PATH, in mise's order, and each later copy of one is dropped.
# With `mise activate`, "mise adds each selected tool's bin directory to the front of PATH"
# (https://mise.jdx.dev/dev-tools/shims.html),
# and so does mise-action on GitHub, but `mise env` leaves a directory the caller's PATH already lists where
# it is (observed with mise 2026.11.5). An agent that Orca starts after a workspace's setup runs under
# `bash -lc`, whose /etc/profile runs macOS's path_helper, which moves /usr/bin and the other system
# directories ahead of the mise ones zsh had put first; every check then ran /usr/bin/python3 (3.9) as
# `python3`, and a tool found under a mise directory by has_tool could be run from an earlier one.
# `mise env --paths` lists the global config's tools too, as an activated shell has them first.
toolchain_first() {
  local d p new="" nl=$'\n'
  local -a parts
  while IFS= read -r d; do [ -n "$d" ] && new="${new:+$new:}$d"; done <<<"$MISE_PATHS"
  [ -n "$new" ] || return 0
  IFS=: read -r -a parts <<<"$PATH"
  for p in ${parts[@]+"${parts[@]}"}; do
    case "$nl$MISE_PATHS$nl" in *"$nl$p$nl"*) [ -n "$p" ] && continue ;; esac
    new="$new:$p"
  done
  PATH=$new; export PATH
}
toolchain_first
# has_tool <name>: true if <name> is an executable in a directory mise manages
has_tool() {
  local d
  while IFS= read -r d; do [ -n "$d" ] && [ -x "$d/$1" ] && return 0; done <<<"$MISE_PATHS"
  return 1
}
# tool <name> [args...]: run a tool from the mise toolchain, or fail naming it
tool() {
  if ! has_tool "$1"; then
    echo "$1: not found in the mise toolchain (mise.toml, mise.lock). Run scripts/bootstrap --install."
    return 127
  fi
  "$@"
}

WORK=$(mktemp -d "${TMPDIR:-/tmp}/canon-ci.XXXXXX") || { echo "ci: FAIL: mktemp failed."; exit 1; }
SLOT_DIR=""
# Removing SLOT_DIR is what releases the slot at once (see take_slot).
trap 'rm -rf "$WORK"; [ -z "$SLOT_DIR" ] || rm -rf "${SLOT_DIR:?}"' EXIT

# On INT or TERM, stop every background check and the processes it started, then exit 128 + signal.
# Background jobs of a non-interactive shell ignore SIGINT, so Ctrl-C reaches them only through this.
PIDS=()
tree() { local c; echo "$1"; for c in $(pgrep -P "$1"); do tree "$c"; done; }
stop_jobs() {
  local p all=""
  [ "${#PIDS[@]}" -gt 0 ] || return 0
  for p in "${PIDS[@]}"; do all="$all $(tree "$p")"; done
  # shellcheck disable=SC2086  # a list of process ids
  kill -TERM $all 2>/dev/null
  wait 2>/dev/null
}
trap 'stop_jobs; echo "ci: interrupted"; exit 130' INT
trap 'stop_jobs; echo "ci: terminated"; exit 143' TERM

# One of CANON_CI_SLOTS (default 3) machine-wide slots, taken before the first check and held until this
# script exits, so parallel lanes cannot drive the machine's load past what the self-tests tolerate. Each
# slot is a lock file ${TMPDIR:-/tmp}/canon-ci-slot.N held with the operating system's own tool: macOS
# lockf(1) or, where lockf is absent (GitHub's ubuntu-24.04 runner), util-linux flock(1); `man lockf`,
# `man flock`. Neither offers N slots (searched: both lock one file), so N single-slot locks are tried in
# turn. The lock is held by a live process, never by a file's existence: a helper runs under the tool and
# ends when this script's process or SLOT_DIR is gone, so a killed run frees its slot within a second and a
# leftover file blocks nobody. CANON_CI_SLOT_HELD (exported once a slot is held; scripts/test-ci sets it)
# makes a nested run skip the wait. Both tools exit 75 for "busy" (lockf -t 0, flock -E 75).
slot_try() { # slot_try <file>: take it, or return 1 when busy
  local f="$1"
  rm -f "$SLOT_DIR/held" "$SLOT_DIR/done"
  # shellcheck disable=SC2016  # the helper's own shell expands these
  local hold='touch "$1/held"; while kill -0 "$2" 2>/dev/null && [ -d "$1" ]; do sleep 0.2; done'
  # started from a subshell of a subshell, so it is no job of this shell: the `wait`s below and in stop_jobs
  # would otherwise wait for the helper, which ends only when this script does
  ( (
    if command -v lockf >/dev/null 2>&1; then lockf -k -s -t 0 "$f" sh -c "$hold" sh "$SLOT_DIR" "$$"
    else flock -n -E 75 "$f" sh -c "$hold" sh "$SLOT_DIR" "$$"; fi
    echo "$?" >"$SLOT_DIR/done"
  ) </dev/null >/dev/null 2>&1 & )
  local t=0 rc
  while [ ! -e "$SLOT_DIR/held" ] && [ ! -s "$SLOT_DIR/done" ]; do
    t=$((t + 1)); [ "$t" -le 400 ] || { echo "ci: FAIL: the slot helper for $f did not report in 20 s."; exit 1; }
    sleep 0.05
  done
  [ -e "$SLOT_DIR/held" ] && return 0
  rc=$(cat "$SLOT_DIR/done")
  # 75 is "busy"; any other status is a real failure (an unwritable lock file, say), never a wait
  [ "$rc" = 75 ] || { echo "ci: FAIL: could not lock $f (status $rc)."; exit 1; }
  return 1
}
take_slot() {
  local n="${CANON_CI_SLOTS:-3}" i announced=0
  case "$n" in ''|*[!0-9]*|0*) echo "ci: FAIL: CANON_CI_SLOTS must be a positive number without leading zeros, not '$n'."; exit 1 ;; esac
  command -v lockf >/dev/null 2>&1 || command -v flock >/dev/null 2>&1 \
    || { echo "ci: FAIL: neither lockf nor flock found; one is needed to take a slot."; exit 1; }
  SLOT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/canon-ci-held.XXXXXX") || { echo "ci: FAIL: mktemp failed."; exit 1; }
  while :; do
    for ((i = 1; i <= n; i++)); do
      if slot_try "${TMPDIR:-/tmp}/canon-ci-slot.$i"; then CANON_CI_SLOT_HELD=$i; export CANON_CI_SLOT_HELD; return 0; fi
    done
    [ "$announced" = 1 ] || { echo "ci: waiting for a slot"; announced=1; }
    sleep 0.5
  done
}
[ -n "${CANON_CI_SLOT_HELD:-}" ] || take_slot

# Run from a git hook, this script inherits GIT_DIR, GIT_INDEX_FILE and the other repository-local
# variables that `git rev-parse --local-env-vars` lists. With them set, a check that builds a scratch
# repository (git init, git config, git commit) would write to this repository instead. So every check
# runs with them removed, except the two that need the index being committed:
#   - the shell-file and test-script lists below, built in this shell, so staged new files are included;
#   - `gitleaks git --pre-commit --staged`, which scans that index (job --git-env).
if ! GIT_LOCAL_VARS=$(git rev-parse --local-env-vars); then
  echo "ci: FAIL: \`git rev-parse --local-env-vars\` failed."; exit 1
fi
without_git_env() {
  local v
  while IFS= read -r v; do [ -n "$v" ] && unset "$v"; done <<<"$GIT_LOCAL_VARS"
}

# Entries are printed in the order they are added. KIND is head, job or skip.
n=0; KIND=(); TEXT=(); NOTE=()
head_line() { n=$((n+1)); KIND[n]="head"; TEXT[n]="$1"; NOTE[n]=""; }
skip_line() { n=$((n+1)); KIND[n]="skip"; TEXT[n]="$1"; NOTE[n]=""; }
# job [--skips] [--git-env] <label> <command...>: start a check in the background, without git's local
# variables unless --git-env is given. On success, --skips lists pytest's SKIPPED lines and --notes the
# `  skip  ` lines a test script prints, and the `<name>: skip (` line of a script that skips as a whole
# (test-maintenance off macOS), so a skip inside a check stays visible.
NOTES='^  skip  |^[a-z][a-z-]*: skip \('
job() {
  local note="" keep=0
  while :; do
    case "$1" in
      --skips) note='^SKIPPED'; shift ;;
      --notes) note=$NOTES; shift ;;
      --git-env) keep=1; shift ;;
      *) break ;;
    esac
  done
  n=$((n+1)); KIND[n]="job"; TEXT[n]="$1"; NOTE[n]="$note"; shift
  ( [ "$keep" -eq 1 ] || without_git_env; "$@" >"$WORK/$n.out" 2>&1; echo "$?" >"$WORK/$n.rc" ) &
  PIDS+=("$!")
}
# now <label> <command...>: run a check in the foreground, without git's local variables
now() {
  n=$((n+1)); KIND[n]="job"; TEXT[n]="$1"; NOTE[n]=""; shift
  ( without_git_env; "$@" ) >"$WORK/$n.out" 2>&1; local rc=$?
  echo "$rc" >"$WORK/$n.rc"
  return "$rc"
}

# Shell files: regular files in the index (so staged new files are included) whose first line is a sh or
# bash shebang. Symlinks (mode 120000) are left out: the file they point to is checked under its own path.
# A file deleted from the working tree is checked from its staged content in --staged mode, and is listed
# with a skip line otherwise.
SHELL_FILES=(); MISSING=()
list_ok=1
shebang='^#!.*[/[:space:]](ba)?sh([[:space:]]|$)'
if git ls-files -s -z >"$WORK/files" 2>"$WORK/files.err"; then
  mkdir -p "$WORK/staged" "$WORK/blobs"
  prev=""; k=0
  while IFS= read -r -d '' entry; do
    mode=${entry%% *}; f=${entry#*$'\t'}; sha=${entry#* }; sha=${sha%% *}
    [ "$f" = "$prev" ] && continue; prev=$f        # one entry per path, also during a merge
    case "$mode" in 100644|100755) ;; *) continue ;; esac
    src=$f
    if [ ! -f "$f" ]; then
      k=$((k+1)); src="$WORK/blobs/$k"
      git cat-file blob "$sha" >"$src" 2>>"$WORK/files.err" || { list_ok=0; continue; }
    fi
    first=""; IFS= read -r first <"$src" || true
    [[ "$first" =~ $shebang ]] || continue
    if [ "$src" = "$f" ]; then SHELL_FILES+=("$f")
    elif [ "$STAGED" -eq 1 ]; then
      case "$f" in */*) mkdir -p "$WORK/staged/${f%/*}" ;; esac
      mv "$src" "$WORK/staged/$f"; SHELL_FILES+=("$WORK/staged/$f")
    else
      MISSING+=("$f")
    fi
  done <"$WORK/files"
else
  list_ok=0
fi
list_failed() { echo "git ls-files failed:"; cat "$WORK/files.err"; return 1; }
syntax() {
  [ "${#SHELL_FILES[@]}" -gt 0 ] || { echo "no shell files found"; return 1; }
  local f rc=0; for f in "${SHELL_FILES[@]}"; do bash -n "$f" || rc=1; done; return "$rc"
}
lint_shell() {
  [ "${#SHELL_FILES[@]}" -gt 0 ] || { echo "no shell files found"; return 1; }
  tool shellcheck "${SHELL_FILES[@]}"
}

# Test scripts: tracked files directly in scripts/ named test-*, in the sorted order git ls-files gives
# (its `*` also matches `/`, so paths in subdirectories are dropped here). One that is not executable in the
# index, or is missing from the working tree, gets a FAIL line instead of being run.
TESTS=(); TEST_MODES=()
tests_ok=1
if git ls-files -s -z -- 'scripts/test-*' >"$WORK/tests" 2>"$WORK/tests.err"; then
  prev=""
  while IFS= read -r -d '' entry; do
    mode=${entry%% *}; path=${entry#*$'\t'}
    [ "$path" = "$prev" ] && continue; prev=$path
    case "${path#scripts/}" in */*) continue ;; esac
    TESTS+=("$path"); TEST_MODES+=("$mode")
  done <"$WORK/tests"
else
  tests_ok=0
fi
tests_failed() { echo "git ls-files failed:"; cat "$WORK/tests.err"; return 1; }
not_executable() { echo "$1 is tracked with mode $2, not 100755; run: git update-index --chmod=+x $1"; return 1; }
not_present() { echo "$1 is tracked but missing from the working tree"; return 1; }

head_line "Canon and harness:"
job "canon registry, lock and ADRs"      scripts/canon lint
job "release-rule self-test"             scripts/canon selftest
if [ "$list_ok" -eq 1 ]; then
  job "shell syntax (${#SHELL_FILES[@]} files)"  syntax
  job "shellcheck"                       lint_shell
  if [ "${#MISSING[@]}" -gt 0 ]; then
    for f in "${MISSING[@]}"; do skip_line "shell checks for $f (deleted from the working tree)"; done
  fi
else
  job "shell file list"                  list_failed
fi
job "lane report self-test"              scripts/lanes --selftest
job "practice survey self-test"          scripts/survey-github selftest
if [ "$tests_ok" -eq 0 ]; then
  job "test script list"                 tests_failed
fi
if [ "${#TESTS[@]}" -gt 0 ]; then
  for j in "${!TESTS[@]}"; do
    t=${TESTS[j]}; name=${t##*/}
    if [ "${TEST_MODES[j]}" != 100755 ]; then
      job "$name (not executable)"       not_executable "$t" "${TEST_MODES[j]}"
    elif [ ! -f "$t" ]; then
      job "$name (missing)"              not_present "$t"
    elif [ "$name" = test-ci ] && [ -n "${CANON_TEST_CI:-}" ]; then
      skip_line "$name (running inside scripts/test-ci)"
    else
      job --notes "$name"                "$t"
    fi
  done
fi

# The Python checks share one environment: check the lock and create the environment before they start.
head_line "Python workspace:"
py_ok=0
if now "uv.lock matches the manifests"   tool uv lock --check; then
  if now "Python environment (uv run --locked)"  tool uv run --locked python -c pass; then py_ok=1
  else why="the Python environment could not be created"; fi
else
  why="uv.lock does not match the manifests"
  skip_line "Python environment ($why)"
fi
if [ "$py_ok" -eq 0 ]; then
  for label in "ruff lint" "ruff format" "ty type check" "pytest"; do skip_line "$label ($why)"; done
fi
if [ "$py_ok" -eq 1 ]; then
  job "ruff lint"                        tool uv run --locked ruff check .
  job "ruff format"                      tool uv run --locked ruff format --check .
  job "ty type check"                    tool uv run --locked ty check
  job --skips "pytest"                   tool uv run --locked pytest -q -rfEs --no-fold-skipped
fi

head_line "Supply chain:"
WORKFLOWS=()
for f in .github/workflows/*.yml .github/workflows/*.yaml; do [ -f "$f" ] && WORKFLOWS+=("$f"); done
if [ "${#WORKFLOWS[@]}" -gt 0 ]; then
  job "actionlint (${#WORKFLOWS[@]} workflow files)"  tool actionlint "${WORKFLOWS[@]}"
else
  skip_line "actionlint (no workflow files in .github/workflows)"
fi
if [ "$STAGED" -eq 1 ]; then
  job --git-env "gitleaks (staged changes)"  tool gitleaks git --pre-commit --staged --no-banner --redact
else
  job "gitleaks (git history)"           tool gitleaks git --no-banner --redact
  job "gitleaks (working tree)"          tool gitleaks dir . --no-banner --redact
fi

wait

# indent <file> [max lines]: print a file indented, reading it to the end
indent() {
  awk -v max="${2:-0}" '
    max == 0 || NR <= max { print "        " $0 }
    END { if (max > 0 && NR > max) printf "        ... %d more lines\n", NR - max }' "$1"
}

# failing <file>: a failing check's output, its first 40 lines; when it is longer, the failure lines after
# them first, so a failing case past the first 40 lines is named and not cut off (a hosted test-land failure
# showed none of its cases). A failure line starts with FAIL, FAILED or ERROR as its status word, at most two
# spaces in, as the self-tests and pytest's summary print them; a passing case whose label holds FAILED, or a
# self-test's quoted inner output (indented further), is not one.
failing() {
  awk 'NR <= 40 { head[NR] = $0; next }
       /^ ? ?(FAIL|FAILED|ERROR)( |$)/ { if (c < 30) bad[++c] = $0; else more++ }
       END { for (i = 1; i <= c; i++) print "        " bad[i]
             if (more > 0) printf "        ... %d more failure lines\n", more
             if (c > 0) print "        --- its first 40 lines:"
             for (i = 1; i <= NR && i <= 40; i++) print "        " head[i]
             if (NR > 40) printf "        ... %d more lines\n", NR - 40 }' "$1"
}

fail=0
SKIPPED=()   # "<test script>: <case>" for every case a passing test script skipped
i=1
while [ "$i" -le "$n" ]; do
  case "${KIND[i]}" in
    head) echo "${TEXT[i]}" ;;
    skip) printf '  skip  %s\n' "${TEXT[i]}" ;;
    job)
      rc=1; [ -s "$WORK/$i.rc" ] && rc=$(cat "$WORK/$i.rc")
      if [ "$rc" = 0 ]; then
        printf '  ok    %s\n' "${TEXT[i]}"
        if [ -n "${NOTE[i]}" ]; then
          grep -E "${NOTE[i]}" "$WORK/$i.out" >"$WORK/$i.skips"
          indent "$WORK/$i.skips"
          if [ "${NOTE[i]}" = "$NOTES" ]; then
            # the case's name is what precedes its reason: "  skip  <case> (<why>)"; a name holds no " ("
            while IFS= read -r l; do
              case "$l" in "  skip  "*) c=${l#  skip  }; c=${c%% (*} ;; *) c="every case" ;; esac
              SKIPPED+=("${TEXT[i]}: $c")
            done <"$WORK/$i.skips"
          fi
        fi
      else
        printf '  FAIL  %s\n' "${TEXT[i]}"
        [ -s "$WORK/$i.rc" ] || echo "        the check stopped without recording an exit status"
        [ -f "$WORK/$i.out" ] && failing "$WORK/$i.out"
        fail=1
      fi ;;
  esac
  i=$((i+1))
done

# Every skipped self-test case once more, counted and named in one line, and on GitHub as a warning annotation
# (workflow commands, "Setting a warning message"), so the hosted Ubuntu run's skips are not quiet lines in a
# long log: there, the macOS-only cases are run by the workflow's macOS job instead (ADR 0082).
if [ "${#SKIPPED[@]}" -gt 0 ]; then
  list=$(printf '; %s' "${SKIPPED[@]}"); list=${list#; }
  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    # a workflow command's data escapes %, CR and LF (actions/toolkit, command.ts: escapeData)
    data=${list//%/%25}; data=${data//$'\r'/%0D}; data=${data//$'\n'/%0A}
    echo "::warning title=${#SKIPPED[@]} self-test case(s) skipped::not checked on this runner: $data"
  fi
  echo "ci: ${#SKIPPED[@]} self-test case(s) skipped, so NOT CHECKED here: $list"
fi
if [ "$fail" -eq 0 ]; then echo "ci: all checks passed"; else echo "ci: FAILED"; exit 1; fi
