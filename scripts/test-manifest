# Reader regressions are checked independently so the red run names every reproduced defect.
html_reader_regressions() {
  SOURCE_WARN=1 "$T/repo/scripts/manifest" --html "$T/reader.html" --run "$EXPECTED_RUN" || true
  "$T/repo/scripts/manifest" --html "$T/plain.html" --run "$EXPECTED_RUN"
