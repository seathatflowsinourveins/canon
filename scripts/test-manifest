echo '  pass  digest ten-line contract from read-only fixture sources'
digest_failures() {
  for fixture in 'TASKS:3:tasks' 'WORKERS:5:orca_workers' 'RATES:5:rates' 'PULLS:7:pulls' 'CHECKS:7:pr_101_checks' 'STATUSES:7:pr_101_statuses' 'ORIGIN:6:origin_main' 'WORKTREES:6:worktrees' 'WORKTREE_STATUS:6:worktree_status_0' 'AHEAD:6:worktree_ahead_0' 'LANDINGS:2:landings' 'AUTOMATION:8:automation'; do
    source=${fixture%%:*}; rest=${fixture#*:}; line=${rest%%:*}; key=${rest#*:}
    if env "${source}_RC=7" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/failed-digest"; then
      echo "FAIL: digest swallowed $source failure"; return 1
    fi
    python3 - "$T/failed-digest" "$line" "$key" <<'PY'
import sys
from pathlib import Path
lines = Path(sys.argv[1]).read_text().splitlines()
assert len(lines) == 10, lines
assert "UNVERIFIED" in lines[int(sys.argv[2]) - 1] and sys.argv[3] in lines[int(sys.argv[2]) - 1], lines
assert sys.argv[3] in lines[9], lines[9]
PY
  done
}
