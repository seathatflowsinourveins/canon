#!/bin/bash
# Offline contracts: scripts/bootstrap's runtime TSV, scripts/manifest's command reports,
# Orca's pinned task/gate JSON and ps(1)/lsof(1) rows (ADR 0059). No network, Orca or credentials.
# shellcheck disable=SC2016  # the stub evaluates its own positional parameters
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/repo/scripts" "$T/repo/canon" "$T/bin" "$T/login-fixture/.codex"
mkdir -p "$T/repo/.canon" "$T/trees/dirty" "$T/trees/review" "$T/trees/merged" "$T/trees/idle"
cp "$ROOT/scripts/bootstrap" "$T/repo/scripts/"
cp -R "$ROOT/home" "$T/repo/home"
cp "$ROOT/canon/models.json" "$ROOT/canon/upstreams.json" "$T/repo/canon/"
cp "$ROOT/canon/upstreams.lock.json" "$T/repo/canon/"
for tool in jq python3; do
  ln -s "$(command -v "$tool")" "$T/bin/$tool"
done
export HOME="$T/login-fixture" CODEX_HOME="$T/login-fixture/.codex"
export CLAUDE_CONFIG_DIR="$HOME/.claude"
export PATH="$T/bin:/usr/bin:/bin" USER=login-fixture LOGNAME=login-fixture
unset DSH_HOME ORCA_CLI_COMMAND ORCA_DEV_REPO_ROOT
# bootstrap's desktop profile row looks for the app here, at nothing, never at the real one
unset DSH_DESKTOP_SETTINGS DSH_DESKTOP_RECORD DSH_DESKTOP_RECORD_PATH
export DSH_DESKTOP_APP="$T/no-desktop-app"
for tool in security xcode-select; do printf '#!/bin/bash\nexit 1\n' > "$T/bin/$tool"; done
for tool in claude codex agy muse dsh; do
  printf '#!/bin/bash\n[ "$1" = --version ] && { echo "7.8.9"; exit; }; exit 1\n' > "$T/bin/$tool"
done
cat > "$T/bin/mise" <<'STUB'
#!/bin/bash
case "$1" in --version) echo '2026.11.5 stub';; where) exit 1;; exec) echo '7.8.9';; *) exit 1;; esac
STUB
chmod +x "$T/bin/security" "$T/bin/xcode-select" "$T/bin/mise" "$T/bin/claude" "$T/bin/codex" "$T/bin/agy" "$T/bin/muse" "$T/bin/dsh"
mkdir -p "$HOME/.gemini/antigravity-cli"
echo '{"model":"Gemini configured label"}' > "$HOME/.gemini/antigravity-cli/settings.json"
cat > "$T/bin/dsh" <<'STUB'
#!/bin/bash
if [ "$1" = --version ]; then echo 0.2.1-rc.3; exit; fi
touch "$HOME/dsh-unsafe-command"
exit 90
STUB
cat > "$CODEX_HOME/config.toml" <<'CONFIG'
model = "top-model"
model_reasoning_effort = "low"
profile = "review"
[profiles.review]
model = "profile-model"
model_reasoning_effort = "max"
CONFIG
"$T/repo/scripts/bootstrap" --check > "$T/bootstrap" 2>&1 || true
for runtime in 'Claude Code' Codex 'Muse Code' Antigravity 'DeepSeek Harness' Orca OmniRoute; do
  if ! grep -qF "$(printf '  %s\t' "$runtime")" "$T/bootstrap"; then
    echo "FAIL: bootstrap runtime missing: $runtime"; exit 1
  fi
done
grep -q 'profile-model' "$T/bootstrap"
grep -q 'profiles.review' "$T/bootstrap"
grep -q 'DeepSeek Harness.*not reported (--dump-config rewrites cordis.yml' "$T/bootstrap"
grep -q 'apps/cli/src/profile-boot.ts:194-198' "$T/bootstrap"
test ! -e "$HOME/dsh-unsafe-command"
grep -q 'Antigravity.*not reported (configured label: Gemini configured label' "$T/bootstrap"
# A documented command may exist and report nothing; keep its name and the reason in the row.
printf '#!/bin/bash\nexit 0\n' > "$T/bin/muse"
"$T/repo/scripts/bootstrap" --check > "$T/bootstrap" 2>&1 || true
grep -q 'Muse Code.*not reported (muse --version failed, timed out or returned no output)' "$T/bootstrap"
mv "$T/bin/codex" "$T/codex-away"
"$T/repo/scripts/bootstrap" --check > "$T/bootstrap" 2>&1 || true
grep -q "$(printf '  Codex\tnot reported')" "$T/bootstrap"
grep -q 'codex not on PATH' "$T/bootstrap"
mv "$T/codex-away" "$T/bin/codex"
# Text and JSON keep their three original report inputs, supplied here by stand-ins.
test -x "$ROOT/scripts/manifest" || { echo 'FAIL: scripts/manifest missing'; exit 1; }
cp "$ROOT/scripts/manifest" "$T/repo/scripts/"
mv "$T/repo/scripts/bootstrap" "$T/bootstrap-real"
cat > "$T/repo/scripts/bootstrap" <<'STUB'
#!/bin/bash
[ "$*" = --check ] || exit 90
cat "${BOOTSTRAP_FILE:-$HOME/../bootstrap}"
exit "${BOOTSTRAP_RC:-0}"
STUB
cat > "$T/repo/scripts/automation" <<'STUB'
#!/bin/bash
[ "$*" = status ] || exit 90
if [ "${HTML_FIXTURE:-0}" = 1 ]; then
  cat "${AUTOMATION_FILE:-$HOME/../html-automation}"
  exit "${AUTOMATION_RC:-0}"
fi
printf 'Automation (ADR 0011):\n  maintenance  ok  %s/log; owner %s; contact fixture@example.com\n  codex  ok  accounts/16b71170-7ca8-4b90-b1a8-f22eb93aaff5/home\n' "$HOME" "$(id -un)"
STUB
cat > "$T/repo/scripts/canon" <<'STUB'
#!/bin/bash
case "$*" in
  list) printf 'FIELD ID ROLE PIN SOURCE\nagent codex tool 0123456789ab example/project\n'; exit "${CANON_RC:-0}" ;;
  'outdated --json') cat "$HOME/../html-drift"; exit "${DRIFT_RC:-0}" ;;
  *) exit 90 ;;
esac
STUB
chmod +x "$T/repo/scripts/"*
"$T/repo/scripts/manifest" > "$T/text"
"$T/repo/scripts/manifest" --json > "$T/json"
jq -e '(.runtimes | length == 7) and all(.runtimes[]; all(.[]; type == "string" and length > 0))' "$T/json" >/dev/null
jq -e '.bootstrap.command == "scripts/bootstrap --check" and .automation.command == "scripts/automation status" and .canon.command == "scripts/canon list"' "$T/json" >/dev/null
jq -e '(.automation.report | contains("maintenance")) and (.canon.report | contains("0123456789ab"))' "$T/json" >/dev/null
for output in "$T/text" "$T/json"; do
  for runtime in 'Claude Code' Codex 'Muse Code' Antigravity 'DeepSeek Harness' Orca OmniRoute; do grep -qF "$runtime" "$output"; done
  if grep -Eq '[[:alnum:]._%+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,}' "$output"; then echo 'FAIL: email leaked'; exit 1; fi
  if grep -qF login-fixture "$output"; then echo 'FAIL: fixture account leaked'; exit 1; fi
  if grep -qF "$(id -un)" "$output"; then echo 'FAIL: login account leaked'; exit 1; fi
  if grep -qF 16b71170-7ca8 "$output"; then echo 'FAIL: account folder id leaked'; exit 1; fi
done
# A short login name is replaced only as a whole word: the runtime table still parses
USER=code LOGNAME=code "$T/repo/scripts/manifest" --json > "$T/short"
jq -e '(.runtimes | length == 7) and (.runtime_parse_error == null) and (.bootstrap.report | contains("codex"))' "$T/short" >/dev/null
usage_refused() {
  if "$T/repo/scripts/manifest" "$@" > /dev/null 2> "$T/usage"; then echo "FAIL: usage '$*' accepted"; exit 1; fi
  grep -q '^usage: scripts/manifest' "$T/usage" || { echo "FAIL: usage '$*' printed no usage line"; exit 1; }
}
usage_refused --bogus; usage_refused ''; usage_refused --json extra
if BOOTSTRAP_RC=1 "$T/repo/scripts/manifest" --json > "$T/failure"; then echo 'FAIL: swallowed bootstrap failure'; exit 1; fi
jq -e '.bootstrap.exit_code == 1 and (.bootstrap.report | length > 0)' "$T/failure" >/dev/null
# A changed/missing runtime table must not silently become an empty JSON inventory.
cp "$T/bootstrap" "$T/bootstrap-complete"
printf 'Toolchain: not reported\n' > "$T/bootstrap"
if "$T/repo/scripts/manifest" --json > "$T/unparsed"; then echo 'FAIL: missing runtime table accepted'; exit 1; fi
jq -e '.runtime_parse_error | contains("not reported")' "$T/unparsed" >/dev/null
mv "$T/bootstrap-complete" "$T/bootstrap"
# The npm bin target is lib/bin.js, not argv basename dsh (pinned apps/cli/package.json).
cat > "$T/bin/ps" <<'STUB'
#!/bin/bash
printf '301 1 00:30 node /opt/lib/node_modules/@deepseek-ai/dsh/lib/bin.js --profile dsh-tui\n'
printf '302 301 00:20 node /opt/lib/node_modules/@deepseek-ai/dsh/lib/bin.js\n'
printf '303 1 00:40 node /opt/lib/node_modules/@deepseek-harness-tui/dsh-tui/bin/dsh-tui.js .\n'
STUB
cat > "$T/bin/lsof" <<'STUB'
#!/bin/bash
echo 'n/work/review'
STUB
chmod +x "$T/bin/ps" "$T/bin/lsof"
CANON_LEDGER_HOME="$T/absent" "$ROOT/scripts/lanes" --rates --json > "$T/rates"
jq -e '[.workers[] | select(.runtime == "deepseek-harness")] | length == 2 and (map(.id) | sort == ["pid 301", "pid 303"]) and all(.[]; (.measured | not) and (.note | startswith("not measured")))' "$T/rates" >/dev/null
CANON_LEDGER_HOME="$T/absent" "$ROOT/scripts/lanes" --rates > "$T/rates-text"
grep -q 'deepseek-harness.*not measured' "$T/rates-text"
grep -q 'deepseek-harness: process table only' "$T/rates-text"
# HTML is a snapshot of read-only reports, scoped by an explicit Run. Stand-ins reject
# every other command, including run-use, network access and reading the working branch.
export HTML_FIXTURE=1 EXPECTED_RUN='run_fixture'
{
  printf 'Toolchain:\n  %-24s %-9s %s\n' mise ok 'toolchain fixture'
  printf '  %-24s %-9s %s\n' 'account config' OWNER '/Users/another-login/.codex/accounts/16b71170-7ca8-4b90-b1a8-f22eb93aaff5/home/config.toml'
  printf '  %-24s %-9s %s\n' allowance ok 'ALLOWANCE_CANARY 91%'
  printf '  %-24s %-9s %s\n' 'paper key pair (windows)' ok 'FULL_WIDTH_CANARY'
  printf '  %-24s %-9s %s\n' 'user CLAUDE.md' ok ''
  printf '  %-24s %-9s %s\n' 'curl' MISSING ''
  printf 'Machine-level config:\n  %-24s %-9s %s\n' 'settings' ok 'OTHER_SECTION_CANARY'
  sed -n '/^Runtimes/,$p' "$T/bootstrap"
} > "$T/html-bootstrap"
mv "$T/html-bootstrap" "$T/bootstrap"
cat > "$T/html-automation" <<'FIXTURE'
Automation:
  maintenance         ok        main snapshot checked
  paper session       ok        last window ended flat; next window scheduled
  landing             ok        local sign-off and GitHub checks
  OTLP collector      ok        /Users/another-login/.claude/canon/otel/logs.jsonl
FIXTURE
cat > "$T/repo/scripts/lanes" <<'STUB'
#!/bin/bash
[ "$*" = '--rates --json' ] || exit 90
cat "${RATES_FILE:-$HOME/../html-rates}"
exit "${RATES_RC:-0}"
STUB
cat > "$T/html-rates" <<'FIXTURE'
{"generated_at":"2026-11-11T20:00:00Z","window_min":10,"otlp_file":"/Users/another-login/private/ACCOUNT_PATH_CANARY","workers":[{"lane":"builder <one>","runtime":"claude-code","model":"fixture-model","state":"working","tok_s":12.5,"measured":true,"note":"","out_tokens":7500,"spend_window_usd":987.65},{"lane":"-","runtime":"codex","model":"fixture-codex","state":"events in window","tok_s":0,"measured":true,"note":"per conversation","spend_session_usd":654.32},{"lane":"reviewer","runtime":"muse-code","model":null,"state":"running 00:30","tok_s":null,"measured":false,"note":"not measured: no token telemetry"}],"usage":{"ALLOWANCE_CANARY":91}}
FIXTURE
cat > "$T/html-drift" <<'FIXTURE'
[{"id":"foundation-fixture","role":"foundation","pinned":"v1.0","newest":"v1.1","newest_stable":"v1.1","status":"NEWER"},{"id":"stable-fixture","role":"tool","pinned":"v2rc1","newest":"v2.0","newest_stable":"v2.0","status":"STABLE-AVAILABLE"},{"id":"unparseable-fixture","role":"tool","pinned":"v3.0.post1","newest":null,"newest_stable":null,"status":"UNPARSEABLE"}]
FIXTURE
cat > "$T/bin/orca" <<'STUB'
#!/bin/bash
[ "$1" = orchestration ] && [ "$3" = --run ] && [ "$4" = "$EXPECTED_RUN" ] && [ "$5" = --json ] || exit 90
case "$2" in
  task-list)
    [ "$#" = 6 ] && [ "$6" = --full ] || exit 90
    if [ "${SOURCE_WARN:-0}" = 1 ]; then echo 'ORCA_WARNING_CANARY' >&2; fi
    if [ "${TASKS_BAD:-0}" = 1 ]; then echo '{broken'; exit 0; fi
    if [ "${WRONG_RUN:-0}" = 1 ]; then echo '{"ok":true,"result":{"runId":"other_run","tasks":[]}}'; exit 0; fi
    if [ -n "${TASKS_FILE:-}" ]; then cat "$TASKS_FILE"; else cat "$HOME/../html-tasks"; fi
    exit "${TASKS_RC:-0}" ;;
  gate-list)
    printf '{"ok":true,"result":{"runId":"run_fixture","gates":[{"id":"gate_fixture","taskId":"task_blocked","status":"open","question":"Choose <safe> & quoted option"}]}}\n'
    exit "${GATES_RC:-0}" ;;
  worker-list)
    case "$*" in
      'orchestration worker-list --run run_fixture --json --full --limit 100') cat "${WORKERS_FILE:-$HOME/../html-workers}" ;;
      'orchestration worker-list --run run_fixture --json --full --limit 100 --cursor second-page') cat "$HOME/../html-workers-2" ;;
      *) exit 90 ;;
    esac
    exit "${WORKERS_RC:-0}" ;;
  *) exit 90 ;;
esac
STUB
cat > "$T/bin/git" <<'STUB'
#!/bin/bash
[ "$1" = -C ] || exit 90
target="$2"; shift 2
case "$*" in
  'status --porcelain --untracked-files=all')
    [ "${GIT_OPTIONAL_LOCKS:-}" = 0 ] || touch "$HOME/../status-took-lock"
    case "$target" in */trees/idle) [ "${PRUNABLE_TREE:-0}" = 1 ] && { echo "fatal: cannot change to '$target'" >&2; exit 128; } ;; esac
    case "$target" in */trees/dirty) echo ' M strategy.py' ;; esac
    exit "${WORKTREE_STATUS_RC:-0}" ;;
esac
[ "$target" = "$(cd "$HOME/../repo" && pwd)" ] || exit 90
case "$*" in
  'show -s --format=%H%n%s main')
    if [ "${SOURCE_WARN:-0}" = 1 ]; then echo 'GIT_WARNING_CANARY' >&2; fi
    printf '0123456789abcdef0123456789abcdef01234567\nMain <fixture> & subject\n'; exit "${MAIN_RC:-0}" ;;
  'show 0123456789abcdef0123456789abcdef01234567:canon/paper-schedule')
    printf '%s\n# SCHEDULE_COMMENT_CANARY\n' "${SCHEDULE_VALUE:-mover}"; exit "${SCHEDULE_RC:-0}" ;;
  'show 0123456789abcdef0123456789abcdef01234567:docs/roadmap.md')
    if [ "${ROADMAP_BAD:-0}" = 1 ]; then echo 'no table'; else
      printf '| # | Step | Done means | State | Record |\n|---|---|---|---|---|\n| 1 | The `fixture` harness | Evidence <safe> | Done | ADR 0001 |\n| 8 | Paper comparison | Complete a paper trial | Not started | ADR 0010 |\n'
    fi
    exit "${ROADMAP_RC:-0}" ;;
  'rev-parse --verify refs/remotes/origin/main') echo 0123456789abcdef0123456789abcdef01234567; exit "${ORIGIN_RC:-0}" ;;
  'worktree list --porcelain -z')
    printf 'worktree %s\0HEAD 0123456789abcdef0123456789abcdef01234567\0branch refs/heads/main\0\0' "$target"
    for branch in dirty review merged idle; do
      case "$branch" in dirty) sha=1111111111111111111111111111111111111111 ;; review) sha=2222222222222222222222222222222222222222 ;; merged) sha=3333333333333333333333333333333333333333 ;; idle) sha=4444444444444444444444444444444444444444 ;; esac
      if [ "$branch" = idle ] && [ "${WORKTREE_HEAD_BAD:-0}" = 1 ]; then sha=not-a-sha; fi
      branch_name="$branch"
      if [ "$branch" = merged ]; then branch_name="${MERGED_BRANCH:-$branch}"; fi
      if [ "$branch" = idle ] && [ "${PRUNABLE_TREE:-0}" = 1 ]; then
        printf 'worktree %s/../trees/%s\0HEAD %s\0branch refs/heads/%s\0prunable gitdir file points to non-existent location\0\0' "$HOME" "$branch" "$sha" "$branch_name"; continue
      fi
      printf 'worktree %s/../trees/%s\0HEAD %s\0branch refs/heads/%s\0\0' "$HOME" "$branch" "$sha" "$branch_name"
    done
    exit "${WORKTREES_RC:-0}" ;;
  'rev-list --count 0123456789abcdef0123456789abcdef01234567..0123456789abcdef0123456789abcdef01234567'|'rev-list --count 0123456789abcdef0123456789abcdef01234567..1111111111111111111111111111111111111111'|'rev-list --count 0123456789abcdef0123456789abcdef01234567..4444444444444444444444444444444444444444') echo 0; exit "${AHEAD_RC:-0}" ;;
  'rev-list --count 0123456789abcdef0123456789abcdef01234567..'*) echo 2; exit "${AHEAD_RC:-0}" ;;
  log*)
    case "$*" in *'--since=2026-11-11T00:00:00+00:00 origin/main') ;; *) exit 90 ;; esac
    printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\t1794391200\tLand fixture one (#101)\nbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\t1794394800\tLand fixture two (#102)\n'
    exit "${LANDINGS_RC:-0}" ;;
  *) exit 90 ;;
esac
STUB
for tool in curl wget; do printf '#!/bin/bash\ntouch "$HOME/../network-called"\nexit 90\n' > "$T/bin/$tool"; done
cat > "$T/bin/gh" <<'STUB'
#!/bin/bash
[ "$1" = api ] && [ "$2" = --method ] && [ "$3" = GET ] || exit 90
case "$4" in
  'repos/{owner}/{repo}/pulls?state=all&per_page=100')
    [ "$5" = --paginate ] && [ "$6" = --slurp ] || exit 90
    cat "${PULLS_FILE:-$HOME/../html-pulls}"; exit "${PULLS_RC:-0}" ;;
  'repos/{owner}/{repo}/commits/2222222222222222222222222222222222222222/check-runs?per_page=100')
    if [ "${CHECKS_EMPTY:-0}" = 1 ]; then echo 'checks unavailable' >&2; exit 7; fi
    jq -n --arg name "${CHECK_NAME:-ci}" '[{check_runs:[{name:$name,status:"completed",conclusion:"success"}]}]'; exit "${CHECKS_RC:-0}" ;;
  'repos/{owner}/{repo}/commits/2222222222222222222222222222222222222222/status?per_page=100')
    if [ "${CHECKS_EMPTY:-0}" = 1 ]; then echo 'statuses unavailable' >&2; exit 7; fi
    echo '[{"state":"pending","statuses":[{"context":"review","state":"pending"}]}]'; exit "${STATUSES_RC:-0}" ;;
  'repos/{owner}/{repo}/rules/branches/main?per_page=100')
    [ "$#" = 4 ] || exit 90
    echo rules >> "$HOME/../rules-reads"
    echo '[{"type":"required_status_checks","ruleset_id":42,"ruleset_source_type":"Repository","ruleset_source":"fixture/repo","parameters":{"required_status_checks":[{"context":"ci"},{"context":"review"},{"context":"signoff"}]}}]'
    exit "${RULES_RC:-0}" ;;
  *) exit 90 ;;
esac
STUB
cat > "$T/html-tasks" <<'FIXTURE'
{"ok":true,"result":{"runId":"run_fixture","tasks":[{"id":"task_ready","status":"ready","task_title":"Build <img src=x onerror=alert(1)> & inspect","spec":"Build fixture","created_at":"2026-11-11 00:00:00","result":null},{"id":"task_review","status":"ready","task_title":"Claude review and land review branch","spec":"branch review","created_at":"2026-11-10 00:00:00","result":null},{"id":"task_landing","status":"dispatched","task_title":"Claude landing","spec":"Land tested work","created_at":"2026-11-11 01:00:00","result":null},{"id":"task_blocked","status":"blocked","task_title":"Wait for fixture","spec":"Wait","created_at":"2026-11-11 00:00:00","result":null},{"id":"task_returned","status":"failed","task_title":"Build again","spec":"Implement","created_at":"2026-11-11 00:00:00","result":"Returned to builder: fix the fixture"}]}}
FIXTURE
cat > "$T/html-workers" <<'FIXTURE'
{"ok":true,"result":{"scope":{"run":"run_fixture","source":"flag"},"workers":[{"taskId":"task_landing","workerState":"running","projection":{"provider":{"id":"claude","model":"fixture"},"liveness":{"verdict":"live"},"stage":{"activity":"working"}}},{"taskId":"task_ready","workerState":"running","projection":{"provider":{"id":"codex","model":"fixture"},"liveness":{"verdict":"unverifiable","reason":"stale_status"},"stage":{"activity":"unknown"}}}],"page":{"hasMore":true,"nextCursor":"second-page","total":3},"warnings":["Showing 2 of 3 Dispatches, newest first; more are on later pages. Follow page.nextCursor with --cursor."]}}
FIXTURE
cat > "$T/html-workers-2" <<'FIXTURE'
{"ok":true,"result":{"scope":{"run":"run_fixture","source":"flag"},"workers":[{"taskId":"old_task","workerState":"succeeded","projection":{"provider":{"id":"muse","model":"fixture"},"liveness":{"verdict":"exited"},"stage":{"activity":"done"}}}],"page":{"hasMore":false,"nextCursor":null,"total":3}}}
FIXTURE
cat > "$T/html-pulls" <<'FIXTURE'
[[{"number":101,"state":"open","title":"Review fixture","head":{"sha":"2222222222222222222222222222222222222222","ref":"review","repo":{"full_name":"fixture/repo"}},"base":{"repo":{"full_name":"fixture/repo"}},"merged_at":null},{"number":99,"state":"closed","title":"Merged fixture","head":{"sha":"3333333333333333333333333333333333333333","ref":"merged","repo":{"full_name":"fixture/repo"}},"base":{"repo":{"full_name":"fixture/repo"}},"merged_at":"2026-11-11T01:00:00Z"}]]
FIXTURE
jq -n --slurpfile rows "$T/html-drift" '{checked_at:"2026-11-11T12:34:00Z",ok:true,newer:[$rows[0][] | select(.status != "UNPARSEABLE")],unparseable:[$rows[0][] | select(.status == "UNPARSEABLE") | {id,pinned}],errors:[]}' > "$T/repo/.canon/watch.json"
watch_fp=$(cat "$T/repo/canon/upstreams.json" "$T/repo/canon/upstreams.lock.json" | cksum | awk '{print $1 "-" $2}')
jq --arg fp "$watch_fp" '.registry=$fp | .retagged=[] | .stale=[]' "$T/repo/.canon/watch.json" > "$T/watch-fp"
mv "$T/watch-fp" "$T/repo/.canon/watch.json"
jq '.result.tasks |= map(if .id=="task_landing" then .dispatch_id="dispatch_landing" else . end)' "$T/html-tasks" > "$T/tasks-ids"
mv "$T/tasks-ids" "$T/html-tasks"
jq '.result.workers[0].dispatchId="dispatch_landing" | .result.workers[1].dispatchId="dispatch_builder"' "$T/html-workers" > "$T/worker-ids"
mv "$T/worker-ids" "$T/html-workers"
jq '.result.workers[0].dispatchId="dispatch_old"' "$T/html-workers-2" > "$T/worker-ids"
mv "$T/worker-ids" "$T/html-workers-2"
chmod +x "$T/repo/scripts/lanes" "$T/bin/orca" "$T/bin/git" "$T/bin/curl" "$T/bin/wget" "$T/bin/gh"
ln -s orca "$T/bin/orca-ide"
html_cached_drift() {
  local status=0
  mv "$T/repo/scripts/canon" "$T/canon-stub"
  cp "$ROOT/scripts/canon" "$T/repo/scripts/canon"
  "$T/repo/scripts/manifest" --html "$T/no-network.html" --run "$EXPECTED_RUN" || status=$?
  mv "$T/canon-stub" "$T/repo/scripts/canon"
  if [ -e "$T/network-called" ]; then
    echo 'FAIL: HTML polled upstream tags through the real canon command'; return 1
  fi
  [ "$status" = 0 ] || { echo 'FAIL: cached drift render failed'; return 1; }
}
html_cached_drift
echo '  pass  cached drift does not poll upstream through real canon'
html_contract() {
  "$T/repo/scripts/manifest" --html "$T/status page.html" --run "$EXPECTED_RUN" || {
    echo 'FAIL: HTML fixture render rejected or source failed'
    if [ -f "$T/status page.html" ]; then
      python3 - "$T/status page.html" <<'PY'
import re
import sys
from pathlib import Path
for row in re.findall(r'<tr data-source="[^\"]+">.*?</tr>', Path(sys.argv[1]).read_text()):
    if "UNVERIFIED" in row:
        print(row)
PY
    fi
    return 1
  }
  python3 - "$T/status page.html" <<'PY'
import re
import sys
from html.parser import HTMLParser
from pathlib import Path

page = Path(sys.argv[1]).read_text()

class Snapshot(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()
        self.text = []

    def handle_starttag(self, tag, attrs):
        assert tag not in {"script", "link", "iframe", "img", "object", "embed"}, tag
        attrs = dict(attrs)
        self.ids.add(attrs.get("id"))
        for name, value in attrs.items():
            assert not name.startswith("on"), name
            if name in {"src", "href"}:
                assert value.startswith("#"), value

    def handle_data(self, data):
        self.text.append(data)

snapshot = Snapshot()
snapshot.feed(page)
assert {"tasks", "gates", "main", "paper", "roadmap", "drift", "automation", "toolchain", "workers", "runtimes", "sources"} <= snapshot.ids
text = " ".join(snapshot.text)
for value in ("run_fixture", "Build <img src=x onerror=alert(1)> & inspect", "task_blocked", "Choose <safe> & quoted option", "Main <fixture> & subject", "mover", "last window ended flat", "The ", "fixture", "Not started", "foundation-fixture", "STABLE-AVAILABLE", "UNPARSEABLE", "toolchain fixture", "builder <one>", "12.5", "not measured: no token telemetry", "Codex", "profile-model"):
    assert value in text, value
for private in ("ALLOWANCE_CANARY", "ACCOUNT_PATH_CANARY", "another-login", "/Users/", "accounts/", "login-fixture", "987.65", "654.32", "7500", "Spend", "Output tokens</th>"):
    assert private not in page, private
assert "<style>" in page and not re.search(r"@import|url\s*\(", page, re.I)
assert "{{" not in page
PY
}
