    "recent alerts are not automation rows": "ALERT_ROW_CANARY" not in read("usage-row.html"),
    "URL, slash command and escaped closing tag survive": all(value in read("paths.html") for value in ("https://example.com/a", "/code-review", "/model", "/autocompact", "</tag>")),
    "spaced account path removed": all(value not in read("paths.html") for value in ("Jane", "Doe", "PROFILE_CANARY", "Support/orca")),
