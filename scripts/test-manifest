  printf '  %-18s %-9s %s\n' 'landscape watch' INCOMPLETE 'last checked: 0 newer, 0 advanced, 0 retagged' >> "$T/v2-automation"
  printf '  %-18s %-9s %s\n' 'watch lock' STALE-LOCK 'lock needs inspection' >> "$T/v2-automation"
  BOOTSTRAP_FILE="$T/v2-bootstrap" AUTOMATION_FILE="$T/v2-automation" "$T/repo/scripts/manifest" --html "$T/v2-statuses.html" --run "$EXPECTED_RUN" || true
  sed 's/last window ended flat; next window scheduled/\/var\/folders\/fixture\/latest.json is unreadable | LAST_RUN_CANARY ok | LAST_EXIT_CANARY 0; log ~\/Library\/Application Support\/private.log/' "$T/html-automation" > "$T/v2-path-automation"
  AUTOMATION_FILE="$T/v2-path-automation" "$T/repo/scripts/manifest" --html "$T/v2-paths.html" --run "$EXPECTED_RUN" || true
  CHECKS_EMPTY=1 "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-no-checks" || true
  cp "$T/repo/.canon/watch.json" "$T/watch-good"
  jq '.registry="wrong"' "$T/watch-good" > "$T/repo/.canon/watch.json"
  "$T/repo/scripts/manifest" --html "$T/v2-stale-watch.html" --run "$EXPECTED_RUN" || true
  jq '.newer=[] | .unparseable=[] | .retagged=["RETAGGED_CANARY"] | .stale=["STALE_PIN_CANARY"]' "$T/watch-good" > "$T/repo/.canon/watch.json"
  "$T/repo/scripts/manifest" --html "$T/v2-retagged.html" --run "$EXPECTED_RUN" || true
  jq '.ok=false | .newer=[] | .unparseable=[{id:"incomplete"}] | .errors=null' "$T/watch-good" > "$T/repo/.canon/watch.json"
  "$T/repo/scripts/manifest" --html "$T/v2-bad-watch.html" --run "$EXPECTED_RUN" > "$T/v2-bad-watch.out" 2> "$T/v2-bad-watch.err" || true
  mv "$T/watch-good" "$T/repo/.canon/watch.json"
  jq '.warnings=null' "$T/html-rates" > "$T/v2-bad-rates"
  RATES_FILE="$T/v2-bad-rates" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-bad-rates.out" 2> "$T/v2-bad-rates.err" || true
  jq '.result.workers=[null]' "$T/html-workers" > "$T/v2-bad-workers"
  WORKERS_FILE="$T/v2-bad-workers" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-bad-workers.out" 2> "$T/v2-bad-workers.err" || true
  WORKTREE_HEAD_BAD=1 "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-bad-tree" || true
  jq '.result.workers[0].projection.provider=null' "$T/html-workers" > "$T/v2-unknown-reviewer"
  WORKERS_FILE="$T/v2-unknown-reviewer" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-unknown-reviewer.out" || true
  jq '.result.workers += [{dispatchId:"old_dispatch",taskId:"task_landing",workerState:"succeeded",projection:{provider:{id:"codex",model:"old"},liveness:{verdict:"exited"}}}]' "$T/html-workers" > "$T/v2-history-workers"
  WORKERS_FILE="$T/v2-history-workers" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-history-reviewer.out" || true
  jq '.result.tasks += [{id:"review_target",status:"ready",task_title:"Claude review target",spec:"Base: commit 3333333333333333333333333333333333333333 on login-fixture/merged",created_at:"2026-11-11 00:00:00"}]' "$T/html-tasks" > "$T/v2-branch-tasks"
  jq '.[0][1].head.ref="login-fixture/merged"' "$T/html-pulls" > "$T/v2-branch-pulls"
  MERGED_BRANCH=login-fixture/merged TASKS_FILE="$T/v2-branch-tasks" PULLS_FILE="$T/v2-branch-pulls" "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/v2-branch-match" || true
  python3 - "$T" <<'PY'
import re
import sys
from html import unescape
from pathlib import Path
root = Path(sys.argv[1])
def read(name):
    path = root / name
    return unescape(path.read_text()) if path.exists() else ""
def line(name, number):
    values = read(name).splitlines()
    return values[number - 1] if len(values) == 10 else ""
statuses = read("v2-statuses.html")
results = {
    "multi-word and overflowing status tokens": all(re.search(name + r'</td><td><span[^>]*>' + status + '</span>', statuses) for name, status in (("auto-compact window", "NOT SET"), ("landscape watch", "INCOMPLETE"), ("watch lock", "STALE-LOCK"))),
    "path removal preserves neighboring status fields": all(value in read("v2-paths.html") for value in ("LAST_RUN_CANARY", "LAST_EXIT_CANARY")),
