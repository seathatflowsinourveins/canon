echo '  pass  HTML panels, escaping, privacy and local assets from fixtures'
# A failed source still produces a page and names the failing source with its exit code.
for source in BOOTSTRAP AUTOMATION CANON RATES TASKS GATES MAIN SCHEDULE ROADMAP; do
  if env "${source}_RC=7" "$T/repo/scripts/manifest" --run "$EXPECTED_RUN" --html "$T/failed.html"; then
    echo "FAIL: HTML swallowed $source failure"; exit 1
  fi
  grep -qF 'UNVERIFIED' "$T/failed.html"
  source_key=$(printf '%s' "$source" | tr '[:upper:]' '[:lower:]')
  grep -Eq "data-source=\"$source_key\".*exit 7.*UNVERIFIED" "$T/failed.html"
done
echo '  pass  HTML names all failing report sources and returns nonzero'
# Malformed tasks are unavailable; a count of zero would falsely say the Run was empty.
html_unavailable_tasks() {
