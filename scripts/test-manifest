digest_contract() {
  "$T/repo/scripts/manifest" --digest --run "$EXPECTED_RUN" --since 2026-11-11T00:00:00Z > "$T/digest" || {
    cat "$T/digest"; echo 'FAIL: digest fixture render rejected or source failed'; return 1;
  }
  python3 - "$T/digest" <<'PY'
import sys
from pathlib import Path
lines = Path(sys.argv[1]).read_text().splitlines()
assert len(lines) == 10, lines
for index, terms in enumerate((('Review queue', '2', 'oldest'), ('Landings', '2', '#101', '#102'), ('Tasks', 'ready=2', 'dispatched=1', 'blocked=1', 'failed=1'), ('Returned', '1', 'result text'), ('Workers', 'claude', 'codex', 'muse', 'stalled=1', 'exited=1', '12.5', 'all lanes'), ('Worktrees', 'total=5', 'uncommitted=1', 'awaiting review=1', 'removable=2'), ('Open PRs', '#101', 'ci=success', 'review=pending'), ('Paper session', 'last window ended flat'), ('Gate', 'landing', 'ok'), ('Sources failed', 'none'))):
    for term in terms:
        assert term in lines[index], (index, term, lines[index])
for private in ('987.65', '654.32', 'ALLOWANCE_CANARY', 'ACCOUNT_PATH_CANARY', '/Users/', 'login-fixture'):
    assert private not in '\n'.join(lines), private
PY
}
