    echo 'FAIL: malformed HTML tasks accepted'; return 1
  fi
  grep -qF 'UNVERIFIED' "$T/bad-tasks.html"
  if grep -qF '0 tasks' "$T/bad-tasks.html"; then
    echo 'FAIL: unavailable tasks presented as an empty Run'; return 1
  fi
}
