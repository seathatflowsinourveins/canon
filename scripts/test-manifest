    "watch checksum mismatch is unverified": "UNVERIFIED" in read("v2-stale-watch.html") and "registry" in read("v2-stale-watch.html"),
    "watch retagged and stale pins remain visible": all(value in read("v2-retagged.html") for value in ("RETAGGED_CANARY", "STALE_PIN_CANARY", "UNVERIFIED")),
    "malformed cache writes a failure page": 'data-source="drift"' in read("v2-bad-watch.html") and "UNVERIFIED" in read("v2-bad-watch.html"),
    "null rate warnings stay a named failure": "UNVERIFIED (rates)" in line("v2-bad-rates.out", 5),
    "invalid worker row stays a named failure": "UNVERIFIED" in line("v2-bad-workers.out", 5) and "orca_workers" in line("v2-bad-workers.out", 5),
    "invalid worktree head does not become zero": "UNVERIFIED" in line("v2-bad-tree", 6) and "worktrees" in line("v2-bad-tree", 6),
    "unknown assigned runtime is not counted as Claude": ": 1; oldest=" in line("v2-unknown-reviewer.out", 1),
    "review queue uses the current dispatch": ": 2; oldest=" in line("v2-history-reviewer.out", 1),
    "redacted on-branch specs retain open work": "awaiting review=2" in line("v2-branch-match", 6) and "removable=1" in line("v2-branch-match", 6),
    "awaiting review rule is explicit": "ahead + open task/PR" in line("v2-branch-match", 6),
}
for name, result in results.items():
    print(("  pass  " if result else "  FAIL  ") + name)
assert all(results.values()), "round-2 medium and low findings"
PY
