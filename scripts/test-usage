#!/bin/bash
# test-usage — offline checks of the subscription usage reading: home/.claude/canon/statusline.sh writes the
# status-line input's rate_limits.five_hour and .seven_day to canon/rate-limits/<session>.json, and
# scripts/lanes prints the newest reading of each window as its Usage row (ADR 0007). Inputs follow the
# documented status-line JSON (https://code.claude.com/docs/en/statusline.md: used_percentage 0 to 100,
# resets_at in epoch seconds, each window possibly absent; cost.total_cost_usd cumulative). Both scripts run
# with CLAUDE_CONFIG_DIR pointed at a temp folder, so nothing outside it is read or changed. Cases: both
# windows, an idle re-render, several sessions, one window absent, a stale reading, a window past its reset,
# out-of-range windows, no reading, and malformed input and files; in every input case the status line exits 0
# and prints what it printed before the usage reading was added.
# Exit 0 if every case behaves as expected, 1 otherwise.
# shellcheck disable=SC2016,SC2034  # checks are single-quoted and read their variables when check evals them
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-usage.XXXXXX") \
  || { echo "test-usage: could not create a temp folder under ${TMPDIR:-/tmp}; nothing was written" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT
command -v jq >/dev/null 2>&1 || { echo "test-usage: jq not found" >&2; exit 1; }
pass=0; fail=0
ok()  { pass=$((pass + 1)); echo "  ok    $1"; }
bad() { fail=$((fail + 1)); echo "  FAIL  $1"; }
check() { if eval "$2"; then ok "$1"; else bad "$1"; fi; }

CFG="$TMP/config"
DIR="$CFG/canon/rate-limits"
FILE="$DIR/s1.json"
NOW=$(date -u +%s)
R5=$((NOW + 3600)); R7=$((NOW + 3 * 86400))
# status line: the line it prints and its exit code; stderr kept apart
sl() { printf '%s' "$1" | CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>"$TMP/sl.err"; echo "rc=$?"; }
# lanes, with its ledger in a second folder, as CANON_LEDGER_HOME moves it: the readings must still be found
LEDGER="$TMP/ledger-home"
lanes() { CLAUDE_CONFIG_DIR="$CFG" CANON_LEDGER_HOME="$LEDGER" "$ROOT/scripts/lanes" "$@" 2>"$TMP/lanes.err"; }
row() { lanes | grep "^Usage:"; }
# one ledger line, so the report path that prints the row runs
mkdir -p "$LEDGER/ledger"
printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"s1","cwd":"/w/proj"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  > "$LEDGER/ledger/$(date -u +%Y-%m-%d).jsonl"
# session <id> <cost>: the session fields of a status-line input
session() { printf '"session_id":"%s","cwd":"/secret/path/proj","workspace":{"current_dir":"/secret/path/proj"},"model":{"id":"claude-opus-5-5","display_name":"Opus"},"effort":{"level":"medium"},"context_window":{"used_percentage":12.7},"cost":{"total_cost_usd":%s}' "$1" "$2"; }
# input <id> <cost> <five_hour JSON or empty> <seven_day JSON or empty>
input() {
  local r="" w
  [ -z "$3" ] || r="\"five_hour\":$3"
  [ -z "$4" ] || { w="\"seven_day\":$4"; r="${r:+$r,}$w"; }
  printf '{%s,"rate_limits":{%s}}' "$(session "$1" "$2")" "$r"
}
win() { printf '{"used_percentage":%s,"resets_at":%s}' "$1" "$2"; }
# age <file> <minutes>: make a stored reading that many minutes old
age() { jq -c --argjson t "$((NOW - $2 * 60))" '.t = $t' "$1" > "$TMP/f" && mv "$TMP/f" "$1"; }
SHOWN="Opus · medium · ctx 12% · \$1.23 · proj
rc=0"

echo "both windows present"
out=$(sl "{$(session s1 1.234),\"rate_limits\":{\"five_hour\":$(win 23.5 $R5),\"seven_day\":$(win 41.2 $R7),\"spend_limit\":{\"used_percentage\":5,\"resets_at\":$R7,\"used_usd\":9}}}")
check "status line prints what it printed before" '[ "$out" = "$SHOWN" ] && [ ! -s "$TMP/sl.err" ]'
check "the session's file holds only the two windows and the time" \
  'jq -e --argjson r5 $R5 --argjson r7 $R7 --argjson now $NOW "keys == [\"rate_limits\",\"t\"] and .t >= \$now
     and .rate_limits == {five_hour: {used_percentage: 23.5, resets_at: \$r5}, seven_day: {used_percentage: 41.2, resets_at: \$r7}}" "$FILE" >/dev/null'
# leaks <file>: the file names a path, model or spend figure; each is matched literally, so a "1.234" is not
# "1" and "234" around any character (a timestamp such as 1823400000 is not the session's spend)
leaks() { grep -qF -e secret -e opus -e Opus -e used_usd -e spend -e 1.234 "$1"; }
printf '{"t":1823400000}' > "$TMP/lookalike"
check "the leak test reads a number that only looks like the spend figure as clean" '! leaks "$TMP/lookalike"'
for term in secret opus Opus used_usd spend 1.234; do
  printf '{"x":"%s"}' "$term" > "$TMP/leak"
  check "... and finds $term" 'leaks "$TMP/leak"'
done
check "no path, model or spend in the file" '[ -s "$FILE" ] && ! leaks "$FILE"'
check "no temporary file left beside it" '[ "$(ls -A "$DIR" | grep -c tmp)" = 0 ]'
r=$(row)
check "lanes shows both percentages, resets and ages" \
  'case "$r" in "Usage: 7-day 41.2% (resets "*" UTC, read 0 min ago), 5-hour 23.5% (resets "*" UTC, read 0 min ago); stale after 30 min") true ;; *) false ;; esac'
check "lanes finds the readings where the status line wrote them, with CANON_LEDGER_HOME elsewhere" '[ -n "$r" ] && [ ! -e "$LEDGER/rate-limits" ]'
check "lanes names the source and that it has no per-model window" \
  '[ "$(lanes | grep "^  source:")" = "  source: rate_limits in the status-line input (https://code.claude.com/docs/en/statusline.md), which has no per-model window; the Agent SDK documents usage rows a model can scope (SDKUsageReport, experimental) and per-model limit events (RateLimitEvent), not read here" ]'
check "lanes --json carries the numbers" \
  'lanes --json | jq -e ".usage.readable and .usage.seven_day.used_pct == 41.2 and .usage.five_hour.used_pct == 23.5" >/dev/null'

echo "an input without rate_limits keeps the reading"
before=$(cat "$FILE")
out=$(sl "{$(session s1 1.234)}")
check "status line unchanged" '[ "$out" = "$SHOWN" ]'
check "reading kept" '[ "$(cat "$FILE")" = "$before" ]'

echo "an idle re-render"
age "$FILE" 20
before=$(cat "$FILE")
sl "$(input s1 1.234 "$(win 23.5 $R5)" "$(win 41.2 $R7)")" >/dev/null
check "the same numbers and the same cost leave the reading and its age alone" \
  '[ "$(cat "$FILE")" = "$before" ] && case "$(row)" in *"41.2% (resets "*", read 2"[01]" min ago)"*) true ;; *) false ;; esac'
sl "$(input s1 1.5 "$(win 23.5 $R5)" "$(win 41.2 $R7)")" >/dev/null
check "a new response (the cost moved) with the same numbers refreshes the age" \
  'case "$(row)" in "Usage: 7-day 41.2% (resets "*", read 0 min ago)"*) true ;; *) false ;; esac'

echo "several sessions"
sl "$(input s2 0.5 "$(win 10 $R5)" "$(win 20 $R7)")" >/dev/null
age "$DIR/s2.json" 25; age "$FILE" 20
sl "$(input s2 0.5 "$(win 10 $R5)" "$(win 20 $R7)")" >/dev/null
check "an idle session's older reading does not displace a newer one" \
  'case "$(row)" in "Usage: 7-day 41.2% (resets "*", read 2"[01]" min ago), 5-hour 23.5% "*) true ;; *) false ;; esac'
sl "$(input s3 0.1 "" "$(win 45 $R7)")" >/dev/null
check "a session with one window shows it and keeps the others' reading of the other window" \
  'case "$(row)" in "Usage: 7-day 45% (resets "*", read 0 min ago), 5-hour 23.5% (resets "*", read 2"[01]" min ago)"*) true ;; *) false ;; esac'
check "each session wrote its own file" '[ -f "$DIR/s2.json" ] && [ -f "$DIR/s3.json" ] && jq -e ".rate_limits | keys == [\"seven_day\"]" "$DIR/s3.json" >/dev/null'

echo "a stale reading"
for f in "$DIR"/*.json; do age "$f" 40; done
r=$(row)
check "not reported, with its age and the threshold, and no number" \
  '[ "$r" = "Usage: 7-day not reported: last read 40 min ago, older than 30 min, 5-hour not reported: last read 40 min ago, older than 30 min; stale after 30 min" ] || case "$r" in *"last read 41 min ago"*) ! printf "%s" "$r" | grep "%" >/dev/null ;; *) false ;; esac'
check "lanes --json shows no number for it" \
  'lanes --json | jq -e ".usage.seven_day.used_pct == null and .usage.five_hour.used_pct == null and .usage.seven_day.age_min >= 40" >/dev/null'
age "$DIR/s3.json" 20
check "20 minutes old is still current" 'case "$(row)" in "Usage: 7-day 45% "*", read 2"[01]" min ago), 5-hour not reported: last read"*) true ;; *) false ;; esac'

echo "a window past its reset"
rm -f "$DIR"/*.json
printf '{"rate_limits":{"five_hour":{"used_percentage":99,"resets_at":%s}},"t":%s}\n' "$((NOW - 5))" "$NOW" > "$FILE"
check "the reset window is not reported and its number not shown" \
  'case "$(row)" in *99*) false ;; *"5-hour not reported: the window reset at"*) true ;; *) false ;; esac'

echo "out-of-range windows"
rm -f "$DIR"/*.json
for w in "$(win 5 1000000000000000000)" "$(win 5 $((R7 * 1000)))" "$(win 5 $((NOW - 60)))" "$(win 4120 $R7)" "$(win -1 $R7)" \
         '{"used_percentage":"41","resets_at":1}' '{"used_percentage":4}' '"x"'; do
  out=$(sl "$(input s1 1.234 "" "$w")")
  check "status line unchanged and nothing written for seven_day $w" '[ "$out" = "$SHOWN" ] && [ ! -e "$FILE" ]'
done
printf '{"rate_limits":{"seven_day":{"used_percentage":5,"resets_at":1e18}},"t":%s}\n' "$NOW" > "$FILE"
lanes > "$TMP/huge"; rc=$?
check "a stored resets_at too large for a date does not stop lanes" '[ "$rc" = 0 ] && grep -q "^Usage: 7-day not reported: no reading of this window" "$TMP/huge"'
rm -f "$FILE"

echo "malformed input"
mkdir -p "$DIR"; sl "$(input s1 3 "" "$(win 7 $R7)")" >/dev/null
good=$(cat "$FILE")
for in_ in 'not json at all' '' '[1,2]' '{"rate_limits":"x"}' "{$(session s1 3),\"rate_limits\":\"x\"}" \
           "{$(session s1 3),\"rate_limits\":{\"five_hour\":\"x\",\"seven_day\":null}}" \
           "{\"session_id\":\"../s1\",\"rate_limits\":{\"seven_day\":$(win 9 $R7)}}"; do
  out=$(sl "$in_")
  check "status line exits 0 and prints a line (none for empty input, as before) for: ${in_:-<empty>}" \
    '[ "${out##*rc=}" = 0 ] && if [ -z "$in_" ]; then [ "$out" = "rc=0" ]; else [ "$(printf "%s\n" "$out" | sed -n 1p)" != "rc=0" ]; fi'
  check "reading untouched by: ${in_:-<empty>}" '[ "$(cat "$FILE")" = "$good" ] && [ "$(ls "$DIR")" = "s1.json" ] && [ ! -e "$CFG/canon/s1.json" ]'
done
check "non-JSON input prints what it printed before" \
  '[ "$(sl "not json at all")" = "status line: could not parse input
rc=0" ]'
printf 'garbage' > "$FILE"
sl "$(input s1 4 "" "$(win 8 $R7)")" >/dev/null
check "a corrupt file of the session's is replaced by its next reading" 'jq -e ".rate_limits.seven_day.used_percentage == 8" "$FILE" >/dev/null'
out=$(printf "%s" "$(input s1 1.234 "" "$(win 1 $R7)")" | CLAUDE_CONFIG_DIR=/dev/null/x "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "a config dir that cannot be written does not fail the status line" '[ "$out" = "$SHOWN" ]'

echo "the renderer"
STUBS="$TMP/stubs"; mkdir -p "$STUBS"
# a stub renderer: records its input, prints a line with a hyperlink, an address, the owner and the home user
cat > "$STUBS/hud" <<STUB
#!/bin/bash
cat > "$STUBS/hud.in"
printf '\033]8;;https://github.com/exampleowner/repo/tree/exampleowner/x\033\\\\exampleowner/x\033]8;;\033\\\\ me@example.com %s\nline two\n' "\${HOME##*/}"
STUB
printf '#!/bin/bash\nexit 1\n' > "$STUBS/fails"; printf '#!/bin/bash\ncat >/dev/null\n' > "$STUBS/silent"
printf '#!/bin/bash\ncat >/dev/null; echo "[claude-hud] needs Node 22.18 or later. Type /hud to fix it."\n' > "$STUBS/ownerror"
chmod +x "$STUBS"/*
OWNER_IN="{$(session s9 1.234),\"workspace\":{\"current_dir\":\"/secret/path/proj\",\"repo\":{\"host\":\"github.com\",\"owner\":\"exampleowner\",\"name\":\"repo\"}}}"
out=$(printf '%s' "$OWNER_IN" | HOME=/Users/exampleuser CLAUDE_CONFIG_DIR="$CFG" CANON_STATUSLINE_RENDERER="$STUBS/hud" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "the renderer's lines are shown, scrubbed of links, addresses, the owner and the home user" \
  '[ "$out" = "~/x <email> ~
line two
rc=0" ]'
# the HUD colours the branch, so the owner's handle follows a colour code (ESC [ 36 m) that ends in a letter
printf '#!/bin/bash\ncat >/dev/null; printf "\\033[35mgit:(\\033[0m\\033[36mexampleowner/x\\033[0m) mexampleowner\\n"\n' > "$STUBS/coloured"; chmod +x "$STUBS/coloured"
out=$(printf '%s' "$OWNER_IN" | CLAUDE_CONFIG_DIR="$CFG" CANON_STATUSLINE_RENDERER="$STUBS/coloured" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null)
check "the owner is scrubbed right after a colour code, and still not inside another word" \
  '[ "$out" = "$(printf "\033[35mgit:(\033[0m\033[36m~/x\033[0m) mexampleowner")" ] || { echo "    got: $(printf "%s" "$out" | LC_ALL=C cat -v)"; false; }'
out=$(printf '%s' "{$(session s9 1.234),\"workspace\":{\"current_dir\":\"/w/devtools\",\"repo\":{\"owner\":\"dev\"}}}" | HOME=/Users/dev CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null)
check "the owner and the home user are scrubbed as whole words, not inside another word" '[ "$out" = "Opus · medium · ctx 12% · \$1.23 · devtools" ]'
check "the renderer is given the model id as its display name" 'jq -e ".model.display_name == \"claude-opus-5-5\" and .model.id == \"claude-opus-5-5\"" "$STUBS/hud.in" >/dev/null'
check "the writes still happen with a renderer" '[ -f "$CFG/canon/sessions/s9.json" ]'
# the context window the renderer is given: the session's compaction window (model-config.md), not the full one
ctx() { rm -f "$STUBS/hud.in"; printf '%s' "{$(session s9 1.234),\"context_window\":{\"context_window_size\":$1,\"used_percentage\":40}}" \
  | CLAUDE_CONFIG_DIR="$CFG" CANON_STATUSLINE_RENDERER="$STUBS/hud" env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW "${@:2}" \
    "$ROOT/home/.claude/canon/statusline.sh" >/dev/null 2>&1
  jq -c '.context_window' "$STUBS/hud.in"; }
printf '{"autoCompactWindow":300000,"modelSettings":{"claude-opus-5-5":{"autoCompactWindow":600000}}}\n' > "$CFG/settings.json"
check "the model's own window (/autocompact) wins over the window for every model" '[ "$(ctx 1000000 env)" = "{\"context_window_size\":600000}" ]'
check "the environment's window wins over both, read with its k suffix" \
  '[ "$(ctx 1000000 env CLAUDE_CODE_AUTO_COMPACT_WINDOW=200k)" = "{\"context_window_size\":200000}" ]'
check "an environment window that is not a size is ignored" \
  '[ "$(ctx 1000000 env CLAUDE_CODE_AUTO_COMPACT_WINDOW=junk)" = "{\"context_window_size\":600000}" ]'
check "the window is capped at the model's" '[ "$(ctx 200000 env)" = "{\"context_window_size\":200000}" ]'
sess() { rm -f "$STUBS/hud.in"; printf '%s' "{$(session s9 1.234),\"model\":{\"id\":\"$1\"},\"context_window\":{\"context_window_size\":1000000,\"used_percentage\":40}}" \
  | CLAUDE_CONFIG_DIR="$CFG" CANON_STATUSLINE_RENDERER="$STUBS/hud" env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW \
    "$ROOT/home/.claude/canon/statusline.sh" >/dev/null 2>&1; jq -c '.context_window' "$STUBS/hud.in"; }
for id in 'claude-opus-5-5[1m]' claude-opus-5-5-20261101 us.anthropic.claude-opus-5-5-v1:0 claude-opus-5-5@20261101 \
  arn:aws:bedrock:us-east-1:000000000000:inference-profile/us.anthropic.claude-opus-5-5-v1:0; do
  check "the model's entry is found under its canonical name for $id" '[ "$(sess "$id")" = "{\"context_window_size\":600000}" ]'
done
check "an environment window's suffix is read in either case, and a fraction is not read" \
  '[ "$(ctx 1000000 env CLAUDE_CODE_AUTO_COMPACT_WINDOW=200K)" = "{\"context_window_size\":200000}" ] && [ "$(ctx 1000000 env CLAUDE_CODE_AUTO_COMPACT_WINDOW=1.5M)" = "{\"context_window_size\":600000}" ]'
printf '{"autoCompactWindow":300000,"modelSettings":{"claude-opus-5-5[1m]":{"effortLevel":"high"},"claude-opus-5-5":{"autoCompactWindow":600000}}}\n' > "$CFG/settings.json"
check "an entry under the exact ID without a window does not hide the canonical entry's" '[ "$(sess 'claude-opus-5-5[1m]')" = "{\"context_window_size\":600000}" ]'
printf '{"autoCompactWindow":300000,"modelSettings":{"claude-opus-5-5":{"autoCompactWindow":"auto"}}}\n' > "$CFG/settings.json"
check "the model's \"auto\" (the tuned window) is not replaced by the window for every model" \
  '[ "$(ctx 1000000 env)" = "{\"context_window_size\":1000000,\"used_percentage\":40}" ]'
printf '{"autoCompactWindow":300000}\n' > "$CFG/settings.json"
check "with no window for the model, the window for every model" '[ "$(ctx 1000000 env)" = "{\"context_window_size\":300000}" ]'
printf 'not json' > "$CFG/settings.json"
check "unreadable settings: the input as it came" \
  '[ "$(ctx 1000000 env)" = "{\"context_window_size\":1000000,\"used_percentage\":40}" ] && jq -e ".model.display_name == \"claude-opus-5-5\"" "$STUBS/hud.in" >/dev/null'
rm -f "$CFG/settings.json"
check "no settings: the input as it came" '[ "$(ctx 1000000 env)" = "{\"context_window_size\":1000000,\"used_percentage\":40}" ]'
for r in fails silent ownerror missing; do
  out=$(printf '%s' "{$(session s9 1.234)}" | CLAUDE_CONFIG_DIR="$CFG" CANON_STATUSLINE_RENDERER="$STUBS/$r" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
  check "a renderer that is $r: canon's line, marked" '[ "$out" = "Opus · medium · ctx 12% · \$1.23 · proj (hud failed)
rc=0" ]'
done
out=$(printf '%s' "{$(session s9 1.234),\"cwd\":\"/w/exampleuser-x\",\"workspace\":{\"current_dir\":\"/w/me@example.com\"}}" | HOME=/Users/exampleuser CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "canon's own line is scrubbed too" '[ "$out" = "Opus · medium · ctx 12% · \$1.23 · <email>
rc=0" ]'
# the HUD found in the plugin cache, run with the node on PATH
# 0.15.0 and 0.9.0 in the enabled marketplace (0.15.0 is newer by number, older by text), and a newer copy
# under another marketplace that settings do not enable
HUDC="$CFG/plugins/cache/claude-hud/claude-hud/0.15.0"
mkdir -p "$HUDC" "$CFG/plugins/cache/claude-hud/claude-hud/0.9.0" "$CFG/plugins/cache/other/claude-hud/9.0.0" "$STUBS/bin"
: > "$HUDC/hud.mjs"; : > "$CFG/plugins/cache/claude-hud/claude-hud/0.9.0/hud.mjs"; : > "$CFG/plugins/cache/other/claude-hud/9.0.0/hud.mjs"
out=$(printf '%s' "{$(session s9 1.234)}" | PATH="$STUBS/bin:$PATH" CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "a HUD in the cache that settings do not enable is not run" '[ "$out" = "$SHOWN" ]'
printf '{"enabledPlugins":{"claude-hud@claude-hud":true}}\n' > "$CFG/settings.json"
printf '#!/bin/bash\n[ "$1" = "%s" ] && { cat >/dev/null; echo "hud line"; }\n' "$HUDC/hud.mjs" > "$STUBS/bin/node"; chmod +x "$STUBS/bin/node"
out=$(printf '%s' "{$(session s9 1.234)}" | PATH="$STUBS/bin:$PATH" CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "the enabled marketplace's newest HUD by number is run with node, not another marketplace's" '[ "$out" = "hud line
rc=0" ]'
printf '#!/bin/bash\nexit 3\n' > "$STUBS/bin/node"
out=$(printf '%s' "{$(session s9 1.234)}" | PATH="$STUBS/bin:$PATH" CLAUDE_CONFIG_DIR="$CFG" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; echo "rc=$?")
check "an installed HUD that fails: canon's line, marked" '[ "$out" = "Opus · medium · ctx 12% · \$1.23 · proj (hud failed)
rc=0" ]'
rm -rf "${CFG:?}/plugins" "${CFG:?}/settings.json"

echo "malformed and missing readings"
printf 'garbage' > "$DIR/bad.json"
check "an unreadable file is skipped and counted" \
  'case "$(row)" in "Usage: 7-day 8% "*"; stale after 30 min (1 unreadable reading file(s) skipped)") true ;; *) false ;; esac'
for content in 'garbage' '{"rate_limits":"x","t":1}' '[]' '{"rate_limits":{}}{"rate_limits":{}}' "{\"rate_limits\":{},\"t\":$((NOW + 3600))}"; do
  rm -f "$DIR"/*.json; printf '%s' "$content" > "$FILE"
  check "unreadable reading not reported: $content" \
    'case "$(row)" in "Usage: not reported: no readable reading in $DIR; stale after 30 min (1 unreadable"*) true ;; *) false ;; esac'
done
rm -rf "${DIR:?}"
out=$(HOME="$TMP" lanes; HOME="$TMP" lanes --json)
check "a path under HOME is printed as ~, in the text and the JSON" \
  'case "$out" in *"$TMP"*) false ;; *"no reading in ~/config/canon/rate-limits"*"\"dir\": \"~/config/canon/rate-limits\""*) true ;; *) false ;; esac'
out=$(HOME="$TMP/con" lanes --json)
check "a sibling of the home folder is not shortened" '[ "$(printf "%s" "$out" | jq -r .usage.dir)" = "$DIR" ]'
printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"s-home","cwd":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$TMP" \
  >> "$LEDGER/ledger/$(date -u +%Y-%m-%d).jsonl"
check "a session started in the home folder is lane ~, not the user name" \
  'HOME="$TMP" lanes --json | jq -e "[.sessions[] | select(.sid == \"s-home\")] | length == 1 and .[0].lane == \"~\"" >/dev/null'
check "no reading: not reported" 'case "$(row)" in "Usage: not reported: no reading in $DIR "*) true ;; *) false ;; esac'
rm -rf "${LEDGER:?}/ledger"
lanes > "$TMP/noledger"; rc=$?
check "with no ledger the row still prints and the exit stays 4" '[ "$rc" = 4 ] && grep -q "^Usage: not reported" "$TMP/noledger"'
lanes --json > "$TMP/noledger.json"; rc=$?
check "with no ledger --json still gives the reading and the exit stays 4" \
  '[ "$rc" = 4 ] && jq -e ".usage.readable == false" "$TMP/noledger.json" >/dev/null'

# The fleet label (home/.claude/canon/fleet-rate.sh, ADR 0007): a cached summary of scripts/lanes --rates, shown
# by the HUD through --extra-cmd. The report is a stub that counts its runs and prints a fixed --json report.
FR="$TMP/fleet"; mkdir -p "$FR/canon"
cp "$ROOT/home/.claude/canon/fleet-rate.sh" "$FR/canon/fleet-rate.sh"
cat > "$TMP/lanes-stub" <<'STUB'
#!/bin/bash
echo run >> "$FLEET_STUB_COUNT"; sleep "${FLEET_STUB_SLEEP:-0}"
printf '%s\n' '{"workers":[{"runtime":"claude-code","state":"working","measured":true,"tok_s":100.4},
{"runtime":"claude-code","state":"idle","measured":true,"tok_s":20.2},{"runtime":"claude-code","state":"working","measured":false,"tok_s":null},
{"runtime":"codex","state":"events in window","measured":true,"tok_s":5}]}'
STUB
chmod +x "$TMP/lanes-stub"
fr() { CLAUDE_CONFIG_DIR="$FR" FLEET_RATE_LANES="$TMP/lanes-stub" FLEET_STUB_COUNT="$TMP/fleet.count" "$FR/canon/fleet-rate.sh"; }
# waitfor <file>: up to 10 s for a background refresh to leave it
waitfor() { local i; for i in $(seq 1 50); do [ -s "$1" ] && return 0; sleep 0.2; done; return 1; }
runs() { [ -f "$TMP/fleet.count" ] && wc -l < "$TMP/fleet.count" | tr -d ' ' || echo 0; }
# unlocked: up to 10 s for a refresh to end; a lock still held fails the next case by name
unlocked() { local i; for i in $(seq 1 50); do [ ! -d "$FR/canon/fleet-rate.lock" ] && return 0; sleep 0.2; done; bad "a refresh still held the lock after 10 s"; return 1; }
FNOW=$(date -u +%s)
rm -f "$TMP/fleet.count"; out=$(fr); rc=$?
check "fleet label, no summary yet: no label, exit 0" '[ "$rc" = 0 ] && [ -z "$out" ]'
waitfor "$FR/canon/fleet-rate.json"
check "... and one refresh writes the summary: measured tok/s of every runtime summed, working Claude Code sessions counted" \
  '[ "$(jq -r .label "$FR/canon/fleet-rate.json")" = "Fleet 126 tok/s · 2 working" ] && [ "$(runs)" = 1 ]'
unlocked
rm -f "$TMP/fleet.count"; out=$(fr)
check "a fresh summary: its label as the HUD's JSON, and no refresh" \
  '[ "$out" = "{\"label\":\"Fleet 126 tok/s · 2 working\"}" ] && sleep 1 && [ "$(runs)" = 0 ]'
printf '{"t":%s,"label":"Fleet 7 tok/s · 1 working"}' "$((FNOW - 120))" > "$FR/canon/fleet-rate.json"
rm -f "$TMP/fleet.count" "$FR/canon/fleet-rate.tried"
s0=$(date +%s); out=$(FLEET_STUB_SLEEP=3 fr); out2=$(FLEET_STUB_SLEEP=3 fr); s1=$(date +%s)
check "a stale summary: shown at once by two renders while the report runs, which starts once" \
  '[ "$out" = "{\"label\":\"Fleet 7 tok/s · 1 working\"}" ] && [ "$out2" = "$out" ] && [ $((s1 - s0)) -le 4 ] && sleep 4 && [ "$(runs)" = 1 ]'
unlocked
printf '{"t":%s,"label":"Fleet 7 tok/s · 1 working"}' "$((FNOW - 700))" > "$FR/canon/fleet-rate.json"
out=$(CLAUDE_CONFIG_DIR="$FR" FLEET_RATE_LANES=/nonexistent "$FR/canon/fleet-rate.sh")
check "a summary older than ten minutes, with no report to refresh it: no label" '[ -z "$out" ]'
mkdir "$FR/canon/fleet-rate.lock"; touch -t 202001010000 "$FR/canon/fleet-rate.lock"; rm -f "$TMP/fleet.count" "$FR/canon/fleet-rate.tried"
fr >/dev/null; waitfor "$TMP/fleet.count"
check "a lock left by a stopped run is taken after two minutes" '[ "$(runs)" = 1 ]'
unlocked
# a report that fails: tried once a TTL, not on every render, and no temporary file left
printf '#!/bin/bash\necho run >> "$FLEET_STUB_COUNT"; exit 1\n' > "$TMP/lanes-fail"; chmod +x "$TMP/lanes-fail"
rm -f "$TMP/fleet.count" "$FR/canon/fleet-rate.tried" "$FR/canon/fleet-rate.json"
for i in 1 2 3 4; do CLAUDE_CONFIG_DIR="$FR" FLEET_RATE_LANES="$TMP/lanes-fail" FLEET_STUB_COUNT="$TMP/fleet.count" "$FR/canon/fleet-rate.sh" >/dev/null; unlocked; done
check "a report that fails runs once in a TTL however often the line renders, and leaves no temporary file" \
  '[ "$(runs)" = 1 ] && [ -z "$(find "$FR/canon" -name "fleet-rate.??????" 2>/dev/null)" ]'
# a report that hangs is stopped by the timeout
printf '#!/bin/bash\nsleep 30\n' > "$TMP/lanes-hang"; chmod +x "$TMP/lanes-hang"; rm -f "$FR/canon/fleet-rate.tried"
CLAUDE_CONFIG_DIR="$FR" FLEET_RATE_LANES="$TMP/lanes-hang" FLEET_RATE_SECS=1 "$FR/canon/fleet-rate.sh" >/dev/null
check "a report that hangs is stopped by its timeout and frees the lock" 'sleep 1; unlocked'
# a summary dated ahead of the clock: no label, and a refresh
printf '{"t":%s,"label":"Fleet 7 tok/s · 1 working"}' "$((FNOW + 3600))" > "$FR/canon/fleet-rate.json"
rm -f "$TMP/fleet.count" "$FR/canon/fleet-rate.tried"; out=$(fr); waitfor "$TMP/fleet.count"
check "a summary dated ahead of the clock: no label, and a refresh starts" '[ -z "$out" ] && [ "$(runs)" = 1 ]'
unlocked
# the status line hands the HUD the label's command and the opt-in, only when fleet-rate.sh is installed
HC="$TMP/hc"; mkdir -p "$HC/canon" "$HC/plugins/cache/mp/claude-hud/1.0.0" "$TMP/nodebin"
printf '{"enabledPlugins":{"claude-hud@mp":true}}' > "$HC/settings.json"
: > "$HC/plugins/cache/mp/claude-hud/1.0.0/hud.mjs"
printf '#!/bin/bash\necho "args=${*:2} allow=${CLAUDE_HUD_ALLOW_EXTRA_CMD:-unset}"\n' > "$TMP/nodebin/node"; chmod +x "$TMP/nodebin/node"
hsl() { printf '%s' "$(input s9 1 "" "")" | PATH="$TMP/nodebin:$PATH" CLAUDE_CONFIG_DIR="$HC" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; }
out=$(hsl)
check "no fleet-rate.sh installed: the HUD gets no --extra-cmd" 'case "$out" in "args= allow=1") true ;; *) false ;; esac'
cp "$ROOT/home/.claude/canon/fleet-rate.sh" "$HC/canon/"
out=$(hsl)
check "fleet-rate.sh installed: the HUD gets --extra-cmd with its path and CLAUDE_HUD_ALLOW_EXTRA_CMD=1" \
  '[ "$out" = "args=--extra-cmd $(printf %q "$HC/canon/fleet-rate.sh") allow=1" ] || { echo "    got: $out"; false; }'
out=$(printf 'not json' | PATH="$TMP/nodebin:$PATH" CLAUDE_CONFIG_DIR="$HC" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null)
check "an input that is not JSON still runs the enabled HUD" \
  '[ "$out" = "args=--extra-cmd $(printf %q "$HC/canon/fleet-rate.sh") allow=1" ] || { echo "    got: $out"; false; }'
# the session's lines changed (cost.total_lines_added and cost.total_lines_removed, statusline.md): passed after the
# script's path only when both are whole numbers, and shown before the fleet figure
lsl() { printf '%s' "{$(session s9 1),\"cost\":{\"total_cost_usd\":1,$1}}" | PATH="$TMP/nodebin:$PATH" CLAUDE_CONFIG_DIR="$HC" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; }
out=$(lsl '"total_lines_added":156,"total_lines_removed":23')
check "the session's lines added and removed follow the script's path in --extra-cmd" \
  '[ "$out" = "args=--extra-cmd $(printf %q "$HC/canon/fleet-rate.sh") 156 23 allow=1" ] || { echo "    got: $out"; false; }'
for bad_ in '"total_lines_added":12.7,"total_lines_removed":3' '"total_lines_added":5,"total_lines_removed":-1' \
            '"total_lines_added":"156; touch x","total_lines_removed":2' '"total_lines_added":5'; do
  out=$(lsl "$bad_")
  check "lines that are not two whole numbers are not passed: $bad_" \
    '[ "$out" = "args=--extra-cmd $(printf %q "$HC/canon/fleet-rate.sh") allow=1" ] || { echo "    got: $out"; false; }'
done
printf '{"t":%s,"label":"Fleet 126 tok/s · 2 working"}' "$(date -u +%s)" > "$FR/canon/fleet-rate.json"
frl() { CLAUDE_CONFIG_DIR="$FR" FLEET_RATE_LANES=/nonexistent "$FR/canon/fleet-rate.sh" "$@"; }
check "the label: the lines changed, the HUD's separator, then the fleet figure" \
  '[ "$(frl 156 23)" = "{\"label\":\"+156 -23 │ Fleet 126 tok/s · 2 working\"}" ]'
FL='{"label":"Fleet 126 tok/s · 2 working"}'
check "no lines changed, or lines that are not two whole numbers of at most nine digits: the fleet figure alone" \
  '[ "$(frl 0 0)" = "$FL" ] && [ "$(frl 5)" = "$FL" ] && [ "$(frl "1;x" 2)" = "$FL" ] && [ "$(frl 1234567890 1)" = "$FL" ] && [ "$(frl -1 2)" = "$FL" ]'
# the HUD cuts a label at 50 characters (src/extra-cmd.ts), so a count of a million or more is written as the HUD
# writes token counts (src/utils/format.ts)
printf '{"t":%s,"label":"Fleet 1234 tok/s · 12 working"}' "$(date -u +%s)" > "$FR/canon/fleet-rate.json"
check "a million lines or more are written as the HUD writes token counts, so the label keeps within its 50 characters" \
  '[ "$(frl 999999 1234567)" = "{\"label\":\"+999999 -1.2M │ Fleet 1234 tok/s · 12 working\"}" ] && [ "$(frl 999999999 999999999 | jq -r ".label | length")" -le 50 ] || { echo "    got: $(frl 999999 1234567)"; false; }'
printf '{"t":%s,"label":"Fleet 7 tok/s · 1 working"}' "$(( $(date -u +%s) - 700 ))" > "$FR/canon/fleet-rate.json"
check "a fleet summary too old to show: the lines changed alone" '[ "$(frl 0 4)" = "{\"label\":\"+0 -4\"}" ]'
rm -f "$FR/canon/fleet-rate.json"
check "no summary and no lines changed: nothing" '[ -z "$(frl 0 0)" ] && [ -z "$(frl)" ]'
rm -rf "${FR:?}/canon/fleet-rate.lock"
# Node: PATH's, unless it is a version manager's shim (or PATH has none); then the Node mise gives for the home
# folder, looked up at most once an hour and kept in canon/hud-node with the lookup's time (none found is kept too,
# and the shim runs), and looked up again at once when the kept Node is no longer executable
SH="$TMP/shimcase"; mkdir -p "$SH/shims" "$SH/real" "$SH/real2" "$SH/mise" "$SH/mise2" "$SH/nomise"
printf '#!/bin/bash\ncat >/dev/null; echo via-shim\n' > "$SH/shims/node"
printf '#!/bin/bash\ncat >/dev/null; echo via-real\n' > "$SH/real/node"
printf '#!/bin/bash\ncat >/dev/null; echo via-real2\n' > "$SH/real2/node"
printf '#!/bin/bash\necho "$*" >> "%s/mise.calls"\n[ "$1 $3 $4" = "-C which node" ] && [ "$2" = "$HOME" ] && echo "%s/real/node"\n' "$SH" "$SH" > "$SH/mise/mise"
printf '#!/bin/bash\necho "$*" >> "%s/mise.calls"\n[ "$1 $3 $4" = "-C which node" ] && [ "$2" = "$HOME" ] && echo "%s/real2/node"\n' "$SH" "$SH" > "$SH/mise2/mise"
printf '#!/bin/bash\necho "$*" >> "%s/mise.calls"\nexit 1\n' "$SH" > "$SH/nomise/mise"
chmod +x "$SH"/*/*
calls() { [ -f "$SH/mise.calls" ] && wc -l < "$SH/mise.calls" | tr -d ' ' || echo 0; }
ssl() { printf '%s' "$(input s9 1 "" "")" | PATH="$SH/shims:$1:$PATH" CLAUDE_CONFIG_DIR="$HC" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null; }
kept() { printf '%s\n%s\n' "$1" "$2" > "$HC/canon/hud-node"; rm -f "$SH/mise.calls"; }
rm -f "$HC/canon/hud-node" "$SH/mise.calls"
out=$(ssl "$SH/mise")
check "a shim on PATH: the HUD runs on the Node mise gives for the home folder, kept with the lookup's time" \
  '[ "$out" = "via-real" ] && [ "$(sed -n 1p "$HC/canon/hud-node")" = "$SH/real/node" ] && [ "$(calls)" = 1 ] \
   && [ "$(sed -n 2p "$HC/canon/hud-node")" -ge "$(( $(date -u +%s) - 60 ))" ] 2>/dev/null || { echo "    got: $out, calls $(calls)"; false; }'
out=$(ssl "$SH/nomise")
check "the kept Node is used within the hour, with no lookup" '[ "$out" = "via-real" ] && [ "$(calls)" = 1 ]'
chmod -x "$SH/real/node"
out=$(ssl "$SH/nomise")
check "a kept Node no longer executable is looked up again, and with none from mise the shim runs" \
  '[ "$out" = "via-shim" ] && [ "$(calls)" = 2 ] || { echo "    got: $out, calls $(calls)"; false; }'
out=$(ssl "$SH/nomise")
check "none from mise is kept too: the shim runs, with no further lookup within the hour" \
  '[ "$out" = "via-shim" ] && [ "$(calls)" = 2 ] || { echo "    got: $out, calls $(calls)"; false; }'
chmod +x "$SH/real/node"
kept "$SH/real/node" "$(( $(date -u +%s) - 3601 ))"; out=$(ssl "$SH/mise2")
kept "$SH/real/node" "$(( $(date -u +%s) + 600 ))"; out2=$(ssl "$SH/mise2")
check "a Node kept over an hour, or dated ahead of the clock, is looked up again, so a change in mise is followed" \
  '[ "$out" = "via-real2" ] && [ "$out2" = "via-real2" ] && [ "$(calls)" = 1 ] && [ "$(sed -n 1p "$HC/canon/hud-node")" = "$SH/real2/node" ] \
   || { echo "    got: $out, $out2, calls $(calls)"; false; }'
kept "$SH/shims/node" "$(date -u +%s)"
out=$(ssl "$SH/mise")
check "a kept path that is itself a shim is not used" '[ "$out" = "via-real" ] && [ "$(calls)" = 1 ]'
# a PATH of the mise stub and the folders of the tools the status line and the stub run, none holding a node
NP="$SH/mise"
for t_ in jq perl cat mv mkdir bash; do
  d_=$(dirname "$(command -v "$t_")"); case ":$NP:" in *":$d_:"*) ;; *) NP="$NP:$d_" ;; esac
done
if (IFS=:; for d_ in $NP; do [ -e "$d_/node" ] && exit 0; done; exit 1); then
  echo "  skip  no node on PATH: a folder holding jq, perl or the shell tools here also holds a node"
else
  rm -f "$HC/canon/hud-node" "$SH/mise.calls"
  out=$(printf '%s' "$(input s9 1 "" "")" | PATH="$NP" CLAUDE_CONFIG_DIR="$HC" "$ROOT/home/.claude/canon/statusline.sh" 2>/dev/null)
  check "no node on PATH: the Node mise gives for the home folder" '[ "$out" = "via-real" ] && [ "$(calls)" = 1 ] || { echo "    got: $out"; false; }'
fi
rm -f "$HC/canon/hud-node"

echo
echo "test-usage: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
