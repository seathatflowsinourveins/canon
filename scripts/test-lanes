      eval '! git -C "$FK" symbolic-ref -q HEAD >/dev/null && [ -e "$FK/.venv/kept" ] && [ ! -e "$FK/catalog/bars" ] && [ ! -e "$FK/untracked" ]'
check "... running no hook the clone holds (core.hooksPath=/dev/null, git-config(1))" test ! -e "$TMP/hook-ran"
check "... and no local branch, one named like a remote one included (actions/checkout deletes refs/heads/*)" \
      eval '[ -z "$(git -C "$FK" for-each-ref refs/heads)" ] && ! grep -q "recreating" "$TMP/fire.out"'
# a local config setting that runs a command (core.fsmonitor, git-config(1)), which git status would run
printf '#!/bin/sh\necho ran > "%s"\n' "$TMP/fsmonitor-ran" > "$TMP/fsmonitor"; chmod +x "$TMP/fsmonitor"
git -C "$FK" config core.fsmonitor "$TMP/fsmonitor"; rm -f "$TMP/fsmonitor-ran"
fire "$B/mise" "$FK" "$OURL" --session auto; rc=$?
check "a clone with local config the runner did not write is made again: it runs no command that config names" \
      eval '[ "$rc" = 0 ] && ran | grep -qF "commit=$want" && [ ! -e "$TMP/fsmonitor-ran" ] && [ -z "$(git -C "$FK" config --local --get core.fsmonitor)" ]'
lines=$(grep -c "run paper:session" "$STUB/mise.log")
mv "$O" "$O.away"; echo 3 > "$OW/tracked"
fire "$B/mise" "$FK" "$OURL" --session auto; rc=$?
check "a failed fetch fails the firing: exit 1, nothing run, the clone where it was" \
      eval '[ "$rc" = 1 ] && [ "$(grep -c "run paper:session" "$STUB/mise.log")" = "$lines" ] && [ "$(git -C "$FK" rev-parse HEAD)" = "$want" ]'
check "... and says so in last-firing.json, which status reads" \
      jqt "$FD/last-firing.json" '(.outcome | startswith("failed: could not fetch main from")) and .commit == "none: nothing ran"'
# an https origin nothing answers on this machine (port 9, refused at once): the message names its host and
# path, not its scheme, query or fragment (git's own message follows; git strips user information itself)
fire "$B/mise" "$TMP/fire-refused" "https://127.0.0.1:9/example/repo.git?q=1#f" --session auto; rc=$?
check "... naming an https origin by host and path only" \
      eval '[ "$rc" = 1 ] && jqt "$FD/last-firing.json" ".outcome | startswith(\"failed: could not fetch main from 127.0.0.1:9/example/repo.git: \")"'
mv "$O.away" "$O"
git -C "$FK" remote set-url origin "$TMP/elsewhere.git"
fire "$B/mise" "$FK" "$OURL" --session auto; rc=$?
check "a clone with another origin is made again from the right one" \
      eval '[ "$rc" = 0 ] && [ "$(git -C "$FK" remote get-url origin)" = "$OURL" ] && ran | grep -qF "commit=$want"'
mkdir -p "$TMP/someones"; echo mine > "$TMP/someones/file"
