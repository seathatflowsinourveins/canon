# ---------- paper session firing ----------
# the runner as the agent runs it: no environment but HOME (launchd gives it HOME), the mise stub logging
# what it was asked to run, from where and at which commit
echo "paper session firing:"
FK="$TMP/fire-checkout"; FD="$TMP/fire-records"
fire() { env -i HOME="$HOME" STUB="$STUB" GIT_CONFIG_GLOBAL="$GIT_CONFIG_GLOBAL" CANON_PAPER_SESSION_DIR="$FD" \
           /bin/bash "$ROOT/home/.claude/canon/paper-session.sh" "$@" > "$TMP/fire.out" 2>&1; }
ran() { grep "run paper:session" "$STUB/mise.log" | tail -1; }
: > "$STUB/mise.log"
fire "$B/mise" "$FK" "$OURL" --session auto --minutes 25; rc=$?
want=$(git -C "$O" rev-parse main)
