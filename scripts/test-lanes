#!/bin/bash
# test-lanes — offline checks of the machine-level observability pieces around scripts/lanes:
# home/.claude/canon/statusline.sh, home/.claude/canon/lanes-watch.sh, scripts/lanes --rates, scripts/automation
# and scripts/bootstrap. (scripts/lanes checks itself: scripts/lanes --selftest.)
# Inputs follow the documented payloads (https://code.claude.com/docs/en/hooks.md,
# https://code.claude.com/docs/en/statusline.md). Every script runs as a copy in a temp folder, with HOME,
# CLAUDE_CONFIG_DIR and CANON_LAUNCHAGENTS_DIR pointed there (the --rates cases run scripts/lanes in place, with
# HOME and its inputs pointed there) and stubs first on PATH for launchctl,
# osascript, mise, xcode-select, curl and claude, so nothing outside the temp folder is read or changed and
# nothing reaches the network. The --install case for a missing CLI drops the claude stub from PATH and uses
# a curl stub that serves an installer stub recording the version it was asked for. A case that needs a macOS-only tool is skipped with a line saying so.
# One exception: the paper:store case writes to the real login keychain, under a throwaway service only, and
# deletes what it wrote on exit (ADR 0033).
# Exit 0 if every case behaves as expected, 1 otherwise.
# shellcheck disable=SC2016  # stub bodies and eval'd checks are single-quoted so they expand when they run
set -uo pipefail
# run from a git hook, git exports GIT_DIR and friends; clear them so the temp repositories stay separate
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# An explicit template: macOS's mktemp -d without one skips a TMPDIR that does not exist and uses another
# folder (observed), so a missing TMPDIR stops here instead.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-lanes.XXXXXX") \
  || { echo "test-lanes: could not create a temp folder under ${TMPDIR:-/tmp}; nothing was written" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0; skipped=0

t_pass() { pass=$((pass+1)); echo "  pass  $1"; }
t_fail() { fail=$((fail+1)); echo "  FAIL  $1"; }
skip()   { skipped=$((skipped+1)); echo "  skip  $1 ($2)"; }
# check <label> <command...>: passes when the command succeeds
check()  { local label="$1"; shift; if "$@"; then t_pass "$label"; else t_fail "$label"; fi; }
jqt()    { jq -e "$2" "$1" >/dev/null 2>&1; }                 # jqt <file> <jq boolean>
rowis()  { grep -Eq "^  $2 +$3( |\$)" "$1"; }                  # rowis <output file> <row name> <label>
iso()    { jq -nr --argjson t "$1" '$t | todate'; }           # epoch seconds -> ISO 8601 UTC
NOW=$(date -u +%s)

# ---------- stubs ----------
B="$TMP/bin"; mkdir -p "$B"
cat > "$B/mise" <<'EOF'
#!/bin/bash
# mise stub: version from $STUB/mise-version; exec logs MISE_EXEC_AUTO_INSTALL and fakes the tools
echo "mise $* | exec_auto_install=${MISE_EXEC_AUTO_INSTALL:-unset} | pwd=$PWD | commit=${CANON_COMMIT:-} | path=${PATH:-unset}" >> "$STUB/mise.log"
case "${1:-}" in
  --version) cat "$STUB/mise-version"; exit 0 ;;
  trust|install) exit 0 ;;
  exec) shift; [ "${1:-}" = "--" ] && shift ;;
  *) exit 0 ;;
esac
cmd="$1"; shift
if [ "$cmd" = gh ]; then
  case "$1 $2" in
    "auth status") exit "$(cat "$STUB/gh-auth-rc" 2>/dev/null || echo 0)" ;;
    "run list")
      expr=""; while [ $# -gt 0 ]; do [ "$1" = "--jq" ] && expr="$2"; [ "$1" = "--json" ] && echo "fields $2" >> "$STUB/gh.log"; shift; done
      jq -r "$expr" "$STUB/gh-runs.json"; exit $? ;;
  esac
  exit 0
fi
echo "$cmd 1.0 (stub)"
EOF
cat > "$B/launchctl" <<'EOF'
#!/bin/bash
echo "launchctl $*" >> "$STUB/launchctl.log"
case "${1:-}" in
  print) [ -f "$STUB/launchctl-print" ] || exit 113; cat "$STUB/launchctl-print" ;;
  bootout) [ -f "$STUB/bootout-fails" ] && exit 5; rm -f "$STUB/launchctl-print" ;;
esac
exit 0
EOF
printf '#!/bin/bash\necho "osascript $*" >> "$STUB/osascript.log"\n' > "$B/osascript"
printf '#!/bin/bash\n[ "${1:-}" = -p ] && echo /Library/Developer/CommandLineTools\nexit 0\n' > "$B/xcode-select"
printf '#!/bin/bash\n[ "${1:-}" = --version ] && { echo "curl stub"; exit 0; }\necho "curl stub: no network in tests" >&2\nexit 1\n' > "$B/curl"
printf '#!/bin/bash\ncat "$STUB/claude-version"\n' > "$B/claude"   # claude stub: --version from $STUB/claude-version
# security stub: logs its arguments; find-generic-password succeeds for an account listed in $STUB/keychain,
# else exits 44 as Apple's does for an absent item. It never holds a value.
cat > "$B/security" <<'EOF'
#!/bin/bash
echo "security $*" >> "$STUB/security.log"
[ "${1:-}" = find-generic-password ] || exit 1
acct=""; while [ $# -gt 0 ]; do [ "$1" = -a ] && acct="$2"; shift; done
grep -qxF "$acct" "$STUB/keychain" 2>/dev/null || exit 44
echo 'keychain: "stub"'
EOF
chmod +x "$B"/*
export STUB="$TMP/stub"; mkdir -p "$STUB"
export PATH="$B:$PATH"
REAL_HOME="$HOME"   # the paper:store case needs the user's own login keychain, which security finds through HOME
export HOME="$TMP/home"; mkdir -p "$HOME"
unset CLAUDE_CONFIG_DIR CANON_LEDGER_HOME AUTOMATION_SKIP_LAUNCHD CANON_LAUNCHAGENTS_DIR
PINNED=$(sed -n 's/^MISE_VERSION="v\([^"]*\)".*/\1/p' "$ROOT/scripts/bootstrap")
echo "$PINNED macos-arm64 (stub)" > "$STUB/mise-version"
CCPIN="2.1.321"   # the claude-code pin the bootstrap fixture's registry sets, whatever the real one is
echo "$CCPIN (Claude Code)" > "$STUB/claude-version"

# ---------- event ledger ----------
echo "event ledger:"
LG="$TMP/lg"
echo '{"hook_event_name":"SessionStart","session_id":"s1","cwd":"/w","source":"compact"}' | CLAUDE_CONFIG_DIR="$LG" "$ROOT/home/.claude/canon/ledger.sh"
cat "$LG"/canon/ledger/*.jsonl > "$TMP/lg.jsonl" 2>/dev/null
check "ledger line has ts and a sub-second t of the same moment" \
      jqt "$TMP/lg.jsonl" '(.t | type) == "number" and (.t | floor) == (.ts | fromdateiso8601)'
check "ledger records the SessionStart source"     jqt "$TMP/lg.jsonl" '.source == "compact"'

# ---------- rates manifest (scripts/lanes --rates) ----------
# Fixtures: a ledger and status-line snapshot, an OTLP JSON Lines file shaped as Claude Code's api_request and
# Codex's codex.sse_event and codex.turn_cost events (https://code.claude.com/docs/en/monitoring-usage.md,
# https://opentelemetry.io/docs/specs/otel/protocol/file-exporter/), and ps and lsof stubs for the process table.
echo "rates manifest:"
unset CANON_OTLP_FILE
RD="$TMP/rates"; RB="$TMP/rates-bin"; mkdir -p "$RD/ledger" "$RD/sessions" "$RD/otel" "$RB"
cat > "$RB/ps" <<'STUB'
#!/bin/bash
# ps stub: the process table, as ps -axo pid=,ppid=,etime=,args= prints it
cat <<'T'
  101     1    01:02:03 /opt/bin/codex --model x
  102   101       05:00 /opt/bin/codex app-server
  103     1       10:00 /usr/local/bin/node --no-warnings /opt/lib/bin/dsh-tui .
  107   102       01:00 /bin/zsh -c codex exec
  108   107       01:00 /opt/bin/codex exec
  104     1       02:00 /opt/bin/muse
  105     1       03:00 /opt/bin/agy
  106     1       04:00 /usr/bin/other codex
T
STUB
cat > "$RB/lsof" <<'STUB'
#!/bin/bash
# lsof stub: -a -p PID -d cwd -Fn -> the directory /w/proc-PID
while [ $# -gt 0 ]; do [ "$1" = -p ] && pid="$2"; shift; done
[ "$pid" = 105 ] && exit 1   # a process lsof cannot read
printf 'p%s\nfcwd\nn/w/proc-%s\n' "$pid" "$pid"
STUB
chmod +x "$RB/ps" "$RB/lsof"
rday=$(date -u +%Y-%m-%d)
rts() { iso $((NOW - $1)); }   # rts <seconds ago> -> ISO 8601 UTC
{
  printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"s-otel","cwd":"/w/otel"}\n' "$(rts 300)"
  printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"s-none","cwd":"/w/none"}\n' "$(rts 300)"
  printf '{"ts":"%s","ev":"Stop","sid":"s-none","cwd":"/w/none"}\n' "$(rts 200)"
  printf '{"ts":"%s","ev":"UserPromptSubmit","sid":"s-ended","cwd":"/w/ended"}\n' "$(rts 300)"
  printf '{"ts":"%s","ev":"SessionEnd","sid":"s-ended","cwd":"/w/ended"}\n' "$(rts 100)"
  printf '{"ts":"%s","ev":"Stop","sid":"s-old","cwd":"/w/old"}\n' "$(rts 25200)"
} > "$RD/ledger/$rday.jsonl"
echo '{"sid":"s-otel","model":"claude-opus-5-5","cost_usd":2.5}' > "$RD/sessions/s-otel.json"
# rec <attributes json array> [timeUnixNano]: one OTLP/JSON logs request line
rec() { jq -cn --argjson a "$1" --arg tn "${2:-}" \
  '{resourceLogs: [{resource: {attributes: []}, scopeLogs: [{scope: {}, logRecords: [
     ({attributes: $a} + (if $tn == "" then {} else {timeUnixNano: $tn} end))]}]}]}'; }
s() { printf '{"key":"%s","value":{"stringValue":"%s"}}' "$1" "$2"; }
n() { printf '{"key":"%s","value":{"%s":%s}}' "$1" "$2" "$3"; }
{
  # two Claude Code requests in the window, one by timeUnixNano and one by event.timestamp only: 1200 tokens over 6 s
  rec "[$(s event.name api_request),$(s session.id s-otel),$(s model claude-opus-5-5),$(n output_tokens intValue '"600"'),$(n duration_ms doubleValue 2500),$(n cost_usd doubleValue 0.12)]" "$((NOW - 120))000000000"
  rec "[$(s event.name api_request),$(s session.id s-otel),$(s event.timestamp "$(jq -nr --argjson t $((NOW - 60)) '$t | strftime("%Y-%m-%dT%H:%M:%S.123Z")')"),$(n output_tokens intValue 600),$(n duration_ms intValue '"3500"'),$(n cost_usd doubleValue 0.08)]"
  # one outside the window
  rec "[$(s event.name api_request),$(s session.id s-otel),$(n output_tokens intValue 9999),$(n duration_ms intValue 1)]" "$((NOW - 1800))000000000"
  # Codex: a completed response (with an account field that must not be copied), another kind, and a turn cost
  rec "[$(s event.name codex.sse_event),$(s event.kind response.completed),$(s conversation.id c-1),$(s model gpt-x),$(s user.email someone@example.com),$(s output_token_count 1200)]" "$((NOW - 90))000000000"
  rec "[$(s event.name codex.sse_event),$(s event.kind response.output_text.delta),$(s conversation.id c-1),$(s output_token_count 777)]" "$((NOW - 80))000000000"
  rec "[$(s event.name codex.turn_cost),$(s conversation.id c-1),$(n usage.estimated_usd doubleValue 0.05)]" "$((NOW - 70))000000000"
  # an event.timestamp with an offset falls back to observedTimeUnixNano: 300 more tokens in the window
  jq -cn --arg on "$((NOW - 30))000000000" '{resourceLogs: [{scopeLogs: [{logRecords: [{timeUnixNano: "0", observedTimeUnixNano: $on,
     attributes: [{key: "event.name", value: {stringValue: "api_request"}}, {key: "session.id", value: {stringValue: "s-otel"}},
                  {key: "event.timestamp", value: {stringValue: "2026-11-10T12:00:00.123+01:00"}},
                  {key: "output_tokens", value: {intValue: "300"}}]}]}]}]}'
  echo '{"resourceMetrics":[]}'
  echo '{"resourceLogs": broken'
  echo '{"resourceLogs":[{"scopeLogs":[{"logRecords":[{"attributes":["x"]}]}]}]}'
} > "$RD/otel/logs.jsonl"
# runs scripts/lanes in place, with HOME and both inputs pointed into the temp folder
rates() { PATH="$RB:$PATH" HOME="$RD" CLAUDE_CONFIG_DIR="$RD" CANON_LEDGER_HOME="$RD" \
          CANON_OTLP_FILE="${CANON_OTLP_FILE:-$RD/otel/logs.jsonl}" "$ROOT/scripts/lanes" --rates "$@"; }
rates --json > "$TMP/rates.json" 2>"$TMP/rates.err"; rc=$?
check "rates manifest: exit 0"                     test "$rc" = 0
w() { jqt "$TMP/rates.json" "$1"; }
check "claude session with telemetry: 1500 tokens over 10 min is 2.5 tok/s; 1200 over 6 s of requests is 200 generating (one by observed time, no duration)" \
      w '.workers[] | select(.id == "s-otel") | .tok_s == 2.5 and .gen_tok_s == 200 and .out_tokens == 1500 and .measured'
check "... spend in the window and for the session" w '.workers[] | select(.id == "s-otel") | .spend_window_usd == 0.2 and .spend_session_usd == 2.5'
check "... model from the events"                  w '.workers[] | select(.id == "s-otel") | .model == "claude-opus-5-5" and .lane == "otel"'
check "claude session without telemetry: not measured, saying why" \
      w '.workers[] | select(.id == "s-none") | (.measured | not) and .tok_s == null and (.note | test("sent no api_request"))'
check "ended session left out"                     w '[.workers[] | select(.id == "s-ended")] | length == 0'
check "idle session silent for seven hours left out" w '[.workers[] | select(.id == "s-old")] | length == 0'
check "codex conversation: only response.completed counts, 2 tok/s, spend from turn_cost" \
      w '.workers[] | select(.runtime == "codex" and .id == "c-1") | .tok_s == 2 and .out_tokens == 1200 and .spend_window_usd == 0.05 and .model == "gpt-x"'
check "one codex process row; its helpers, direct or through a shell, are left out" \
      w '[.workers[] | select(.runtime == "codex" and (.id | startswith("pid")))] | length == 1 and .[0].id == "pid 101" and .[0].lane == "proc-101"'
check "... not measured, pointing at the conversation rows" w '.workers[] | select(.id == "pid 101") | .note | test("per conversation")'
check "dsh-tui under node with a flag is a DeepSeek Harness worker" w '.workers[] | select(.id == "pid 103") | .runtime == "deepseek-harness" and (.measured | not)'
check "muse and agy listed as not measured"        w '([.workers[] | select(.runtime == "muse-code" or .runtime == "antigravity") | select(.measured | not)] | length) == 2'
check "an unrelated process naming codex in its arguments is left out" w '[.workers[] | select(.id == "pid 106")] | length == 0'
check "a directory lsof cannot read: lane ?, and a warning" \
      w '(.workers[] | select(.id == "pid 105") | .lane == "?") and (.warnings | any(test("directory not read for 1")))'
check "corrupt and misshapen OTLP lines counted, metrics line not" w '.otlp_unreadable_lines == 2'
check "no attribute beyond the named ones is copied out" eval '! grep -q "someone@example.com" "$TMP/rates.json"'
check "every runtime names its source"             w '[.sources[].runtime] == ["claude-code","codex","muse-code","antigravity","deepseek-harness"]'
rates > "$TMP/rates.out" 2>&1; rc=$?
check "rates table prints, one line per worker"    eval '[ "$rc" = 0 ] && [ "$(grep -cE "^(otel|none|-|proc-[0-9]+|\?) " "$TMP/rates.out")" = 7 ]'
CANON_OTLP_FILE="$RD/otel/absent.jsonl" rates --json > "$TMP/rates.json" 2>/dev/null; rc=$?
check "no OTLP file: exit 0, every row not measured" w '.otlp_file_present == false and ([.workers[] | select(.measured)] | length == 0)'
check "... the claude row names the missing file"  w '.workers[] | select(.id == "s-otel") | .note | test("no OTLP log file")'
check "... the codex row says its exporter is off" w '.workers[] | select(.id == "pid 101") | .note | test("exporter is none")'
mv "$RD/ledger" "$RD/ledger.off"
rates --json > "$TMP/rates.json" 2>/dev/null; rc=$?
check "no ledger: exit 0, processes still listed"  eval '[ "$rc" = 0 ] && jqt "$TMP/rates.json" ".ledger_present == false and ([.workers[] | select(.runtime == \"muse-code\")] | length == 1)"'
check "... with the ledger's own hint"             w '.ledger_note | test("ledger is empty")'
mv "$RD/ledger.off" "$RD/ledger"
rc=0; rates --window 0 >/dev/null 2>&1 || rc=$?
check "--window 0: usage error, exit 2"            test "$rc" = 2

# ---------- status line ----------
echo "status line:"
SL="$TMP/sl"; mkdir -p "$SL/canon/sessions"
echo '{"sid":"s1","model":"model-a"}' > "$SL/canon/sessions/s1.json"
echo '{"session_id":"s1","model":{"id":"model-b"}}' | CLAUDE_CONFIG_DIR="$SL" "$ROOT/home/.claude/canon/statusline.sh" >/dev/null
echo '{"session_id":"s1","model":{"id":"model-c"},"workspace":{"current_dir":"/w/alpha"},"cwd":"/w/alpha"}' \
  | CLAUDE_CONFIG_DIR="$SL" "$ROOT/home/.claude/canon/statusline.sh" >/dev/null
cat "$SL"/canon/ledger/*.jsonl > "$TMP/sl.jsonl" 2>/dev/null
check "model change without a directory writes no cwd" jqt "$TMP/sl.jsonl" 'select(.to_model == "model-b") | has("cwd") | not'
check "model change with a directory records it"      jqt "$TMP/sl.jsonl" 'select(.to_model == "model-c") | .cwd == "/w/alpha"'

# ---------- lane watchdog ----------
echo "lane watchdog:"
WD="$TMP/wd"; mkdir -p "$WD/canon"
printf '#!/bin/bash\n/usr/bin/printenv PATH > "%s/lanes-path"\ncat "%s/report.json"\nexit "$(cat "%s/lanes-rc")"\n' "$STUB" "$STUB" "$STUB" > "$WD/canon/lanes"
chmod +x "$WD/canon/lanes"
report() { # report <sid> <flags json> [state]: one-session lanes report
  jq -n --arg sid "$1" --argjson flags "$2" --arg state "${3:-working}" \
    '{sessions: [{sid: $sid, lane: "alpha", state: $state, quiet_min: 20, fail: 0, flags: $flags}]}' > "$STUB/report.json"
}
watch() { CLAUDE_CONFIG_DIR="$WD" CANON_WATCH_NO_NOTIFY=1 "$ROOT/home/.claude/canon/lanes-watch.sh" 2>/dev/null; }
st="$WD/canon/watch/lanes-status.json"
echo 0 > "$STUB/lanes-rc"
report s1 '["QUIET"]' QUIET; watch
check "first flag alerts"                         jqt "$st" '.ok and .new_alerts == 1'
report s1 '[]'; watch
check "cleared flag stays remembered"             jqt "$WD/canon/watch/alerted.json" 'index("s1:QUIET") != null'
report s1 '["QUIET"]' QUIET; watch
check "returning flag does not alert again"       jqt "$st" '.ok and .new_alerts == 0'
check "one alert recorded in all"                 test "$(wc -l < "$WD/canon/watch/alerts.jsonl" | tr -d ' ')" = 1
report s2 '[]'; watch
check "key dropped once its session leaves"       jqt "$WD/canon/watch/alerted.json" '. == []'
echo 4 > "$STUB/lanes-rc"; : > "$STUB/report.json"
watch
check "empty ledger, no hooks: not ok"            jqt "$st" '.ok == false'
jq -n --arg c "\"$WD\"/canon/ledger.sh" '{hooks: {UserPromptSubmit: [{hooks: [{type: "command", command: $c}]}], Stop: [{hooks: [{type: "command", command: $c}]}]}}' > "$WD/settings.json"
watch
check "empty ledger, hook registered but missing: not ok" jqt "$st" '.ok == false'
printf '#!/bin/bash\nexit 0\n' > "$WD/canon/ledger.sh"; chmod +x "$WD/canon/ledger.sh"
watch
check "empty ledger, hook installed and registered: ok" jqt "$st" '.ok == true'
rm -f "$STUB/lanes-path" "$st"   # the run before wrote both; only this one may
env -i HOME="$TMP/elsewhere" CLAUDE_CONFIG_DIR="$WD" CANON_WATCH_NO_NOTIFY=1 /bin/bash "$ROOT/home/.claude/canon/lanes-watch.sh"   # stderr kept: empty unless it fails
check "with an empty environment the lanes report gets the watchdog's PATH, exported" \
      eval 'jqt "$st" ".ok == true" && [ "$(cat "$STUB/lanes-path" 2>/dev/null)" = /usr/bin:/bin:/usr/sbin:/sbin ]'

# ---------- automation ----------
echo "automation:"
R="$TMP/repo"; AH="$TMP/auto-home"
mkdir -p "$R/scripts" "$R/.githooks" "$R/.claude/hooks" "$R/.github/workflows" "$R/.canon" "$R/home/.claude/canon" \
         "$AH/scheduled-tasks/canon-landscape-refresh" "$AH/canon/watch"
cp "$ROOT/scripts/automation" "$ROOT/scripts/lanes" "$R/scripts/"
cp "$ROOT/home/.claude/canon/lanes-watch.sh" "$ROOT/home/.claude/canon/paper-session.sh" "$R/home/.claude/canon/"
printf '#!/bin/bash\nexit 0\n' > "$R/.githooks/pre-commit"; cp "$R/.githooks/pre-commit" "$R/.claude/hooks/canon-watch.sh"
chmod +x "$R/.githooks/pre-commit" "$R/.claude/hooks/canon-watch.sh"
echo '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"canon-watch.sh"}]}]}}' > "$R/.claude/settings.json"
: > "$R/.github/dependabot.yml"; : > "$R/.github/workflows/watch.yml"; : > "$AH/scheduled-tasks/canon-landscape-refresh/SKILL.md"
git -C "$R" init -q && git -C "$R" config core.hooksPath .githooks && git -C "$R" remote add origin https://github.com/example/repo.git
jq -n --arg at "$(iso "$NOW")" '{checked_at: $at, ok: true, sessions: 1, flagged_now: 0, ledger_kb: 1}' > "$AH/canon/watch/lanes-status.json"
mkdir -p "$R/canon"; echo '{"upstreams": []}' > "$R/canon/upstreams.json"; echo '{"pins": {}}' > "$R/canon/upstreams.lock.json"
# the checksum canon-watch.sh records for the tree's registry and lock
FP=$(cat "$R/canon/upstreams.json" "$R/canon/upstreams.lock.json" | cksum | awk '{ print $1 "-" $2 }')
watchjson() { # watchjson <age in seconds> <ok> [extra jq]
  jq -n --arg at "$(iso $((NOW - $1)))" --argjson e $((NOW - $1)) --argjson ok "$2" --arg fp "$FP" \
    "{checked_at: \$at, checked_at_epoch: \$e, registry: \$fp, ok: \$ok, newer: [], advanced: [], retagged: [], stale: [], bot_prs: [], errors: []} ${3:-}" > "$R/.canon/watch.json"
}
runs() { jq -n --arg at "$(iso "$NOW")" --arg s "$1" "[{createdAt: \$at, status: \$s} + $2]" > "$STUB/gh-runs.json"; }
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 0\n' > "$STUB/launchctl-print"
PD="$TMP/paper-session"; mkdir -p "$PD"
paper() { # paper <result> <age in seconds>: the session windows' latest record
  jq -n --arg r "$1" --argjson e $((NOW - $2)) --arg c "$(printf 'a%.0s' {1..40})" \
    '{session: "regular", result: $r, started: "20261111T143500Z", started_epoch: $e, left: [], commit: $c}' > "$PD/latest.json"
}
heartbeat() { # heartbeat <age in seconds> [outcome] [scheduled: true|false]: what the last run wrote
  jq -n --argjson e $((NOW - $1)) --arg o "${2:-a regular window}" --argjson s "${3:-true}" \
    '{at_epoch: $e, outcome: $o, commit: "b123456789abcdef0123456789abcdef01234567", scheduled: $s}' > "$PD/last-firing.json"
}
fired() { # fired <age in seconds>: the stamp the runner writes as each scheduled firing starts
  jq -n --argjson e $((NOW - $1)) '{at_epoch: $e}' > "$PD/scheduled-firing.json"
}
paper ok 600; heartbeat 60; fired 60
status() { CLAUDE_CONFIG_DIR="$AH" CANON_PAPER_SESSION_DIR="$PD" "$R/scripts/automation" status > "$TMP/status.out" 2>&1; }
watchjson 60 true; runs completed '{conclusion: "success"}'
status; rc=$?
check "all healthy: exit 0"                       test "$rc" = 0
watchjson 60 false; status; rc=$?
check "landscape watch not ok: INCOMPLETE, exit 1" eval 'rowis "$TMP/status.out" "landscape watch" INCOMPLETE && [ "$rc" != 0 ]'
watchjson $((5 * 86400)) true; status; rc=$?
check "landscape watch days old: STALE, exit 1"   eval 'rowis "$TMP/status.out" "landscape watch" STALE && [ "$rc" != 0 ]'
watchjson 60 true '| .stale = ["superpowers"]'; status; rc=$?
check "stale lock: STALE-LOCK, exit 1"            eval 'rowis "$TMP/status.out" "landscape watch" STALE-LOCK && [ "$rc" != 0 ]'
check "... naming the id and the resolve to run"  grep -q 'stale for superpowers.*scripts/canon resolve superpowers' "$TMP/status.out"
check "... not as an incomplete run"              eval '! grep -q "could not check everything" "$TMP/status.out"'
watchjson 60 true '| .registry = "1-1"'; status; rc=$?
check "a result for another registry: UNKNOWN"    eval 'rowis "$TMP/status.out" "landscape watch" UNKNOWN && [ "$rc" != 0 ]'
check "... and its counts are not shown"          eval '! grep -q "0 newer" "$TMP/status.out"'
watchjson 60 true '| del(.bot_prs)'; status; rc=$?
check "UNKNOWN row makes status exit 1"           eval 'rowis "$TMP/status.out" "dependency bot" UNKNOWN && [ "$rc" != 0 ]'
watchjson 60 true
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 1\n' > "$STUB/launchctl-print"; status; rc=$?
check "watchdog last exit 1: FAILED, exit 1"      eval 'rowis "$TMP/status.out" "lane watchdog" FAILED && [ "$rc" != 0 ]'
printf '\tstate = not running\n\truns = 0\n\tlast exit code = (never exited)\n' > "$STUB/launchctl-print"; status; rc=$?
check "watchdog with no exit code: UNKNOWN"       eval 'rowis "$TMP/status.out" "lane watchdog" UNKNOWN && [ "$rc" != 0 ]'
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 0\n' > "$STUB/launchctl-print"
runs in_progress '{conclusion: ""}'; status; rc=$?
check "hosted run in progress, empty conclusion: ok" eval 'rowis "$TMP/status.out" "hosted watch" ok && [ "$rc" = 0 ]'
check "hosted watch asks for the run status"      grep -q 'status' "$STUB/gh.log"
runs queued '{}'; status; rc=$?
check "hosted run queued, no conclusion: ok"      eval 'rowis "$TMP/status.out" "hosted watch" ok && [ "$rc" = 0 ]'
runs completed '{conclusion: ""}'; status; rc=$?
check "hosted run completed, empty conclusion: UNKNOWN" eval 'rowis "$TMP/status.out" "hosted watch" UNKNOWN && [ "$rc" != 0 ]'
runs completed '{conclusion: "failure"}'; status; rc=$?
check "hosted run failed: FAILED, exit 1"         eval 'rowis "$TMP/status.out" "hosted watch" FAILED && [ "$rc" != 0 ]'
runs completed '{conclusion: "success"}'
check "paper session ok: its row shows the last window" eval 'rowis "$TMP/status.out" "paper session" ok && grep -q "last window 20261111T143500Z" "$TMP/status.out"'
check "... the commit it ran, and the last firing's"   eval 'grep -q "regular, commit aaaaaaaaaaaa): ok" "$TMP/status.out" && grep -q "a regular window at b123456789ab |" "$TMP/status.out"'
jq 'del(.commit)' "$PD/latest.json" > "$PD/l" && mv "$PD/l" "$PD/latest.json"; status
check "a record without a commit says so"         grep -q "commit not recorded)" "$TMP/status.out"
heartbeat 60 "failed: could not fetch main from https://github.com/example/repo.git: no answer"; status; rc=$?
check "a firing that could not fetch main: FAILED, exit 1, naming why" \
      eval 'rowis "$TMP/status.out" "paper session" FAILED && [ "$rc" != 0 ] && grep -q "could not fetch main" "$TMP/status.out"'
mv "$PD/latest.json" "$PD/kept.json"; status
check "... FAILED too when no window has a record yet" rowis "$TMP/status.out" "paper session" FAILED
mv "$PD/kept.json" "$PD/latest.json"
heartbeat 60
paper running 600; status; rc=$?
check "paper window running for 10 minutes: ok"   eval 'rowis "$TMP/status.out" "paper session" ok && [ "$rc" = 0 ]'
paper running $((75 * 60)); status; rc=$?
check "paper window running after 75 minutes: DIED, exit 1" eval 'rowis "$TMP/status.out" "paper session" DIED && [ "$rc" != 0 ]'
paper "failed: not left flat: [position of 1 SPY]" 600; status; rc=$?
check "paper window failed: FAILED, exit 1"       eval 'rowis "$TMP/status.out" "paper session" FAILED && [ "$rc" != 0 ]'
paper "refused: the paper account is not flat in SPY" 600; status; rc=$?
check "paper window refused: REFUSED, exit 1"     eval 'rowis "$TMP/status.out" "paper session" REFUSED && [ "$rc" != 0 ]'
rm -f "$PD/latest.json"; status; rc=$?
check "no paper window yet: UNKNOWN, exit 1"      eval 'rowis "$TMP/status.out" "paper session" UNKNOWN && [ "$rc" != 0 ]'
paper ok 600; fired $((3 * 3600)); heartbeat $((3 * 3600)); status; rc=$?
check "no firing for three hours: STALE, exit 1"  eval 'rowis "$TMP/status.out" "paper session" STALE && [ "$rc" != 0 ]'
heartbeat 60 "a regular window" false; status; rc=$?
check "... STALE still when a window run by hand has just written the heartbeat" \
      eval 'rowis "$TMP/status.out" "paper session" STALE && [ "$rc" != 0 ] && grep -q "by hand" "$TMP/status.out"'
rm -f "$PD/last-firing.json"; status; rc=$?
check "... and STALE with no heartbeat at all"   eval 'rowis "$TMP/status.out" "paper session" STALE && [ "$rc" != 0 ]'
fired 6000; heartbeat 6000; status; rc=$?
check "a stamp 100 minutes old (a firing held to its deadline, launchd missing intervals meanwhile): not STALE" \
      eval 'rowis "$TMP/status.out" "paper session" ok && [ "$rc" = 0 ]'
rm -f "$PD/scheduled-firing.json"; heartbeat 60; status; rc=$?
check "no scheduled firing recorded: UNKNOWN, exit 1, whatever the heartbeat says" \
      eval 'rowis "$TMP/status.out" "paper session" UNKNOWN && [ "$rc" != 0 ]'
check "... naming an installed runner that differs from this tree's, which writes no stamp" \
      grep -q "installed runner differs from this tree's: run scripts/automation install" "$TMP/status.out"
echo '{' > "$PD/scheduled-firing.json"; status; rc=$?
check "an unreadable firing stamp: UNKNOWN, exit 1" eval 'rowis "$TMP/status.out" "paper session" UNKNOWN && [ "$rc" != 0 ]'
fired 60; echo 'not json' > "$PD/last-firing.json"; status; rc=$?
check "an unreadable heartbeat: UNKNOWN, exit 1"  eval 'rowis "$TMP/status.out" "paper session" UNKNOWN && [ "$rc" != 0 ]'
heartbeat 60; status; rc=$?
check "fresh stamp and heartbeat again: ok"       eval 'rowis "$TMP/status.out" "paper session" ok && [ "$rc" = 0 ]'
heartbeat -1; status; rc=$?
check "a heartbeat written within the same second (a negative whole age): ok" \
      eval 'rowis "$TMP/status.out" "paper session" ok && [ "$rc" = 0 ]'
heartbeat 60
git -C "$R" remote set-url origin "https://someone:s3cr3t-t0ken@example.com/example/repo@v2?q=1"; status
check "the landing row names the origin by host and path, an @ in the path kept, its user information never" \
      eval 'grep -q "squash merge (example.com/example/repo@v2)" "$TMP/status.out" && ! grep -q s3cr3t "$TMP/status.out"'
git -C "$R" remote set-url origin https://github.com/example/repo.git
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 1\n' > "$STUB/launchctl-print"; status; rc=$?
check "an ok record, but the last firing exited 1: FAILED" eval 'rowis "$TMP/status.out" "paper session" FAILED && [ "$rc" != 0 ]'
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 0\n' > "$STUB/launchctl-print"
