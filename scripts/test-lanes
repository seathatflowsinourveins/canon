pin_settings '.env.ANTHROPIC_DEFAULT_SONNET_MODEL = "claude-sonnet-4-5"'; rc=$?
check "another alias pinned to another model: MISMATCH, exit 1" eval 'rowis "$TMP/bs.out" "sonnet alias" MISMATCH && [ "$rc" != 0 ]'
