fire "$B/mise" "$FK" "git@github.com:example/repo.git" --session auto; rc=$?
check "an origin that is not https is refused: exit 1, nothing run" \
      eval '[ "$rc" = 1 ] && grep -q "must be an https URL" "$TMP/fire.out" && [ "$(grep -c "run paper:session" "$STUB/mise.log")" = "$lines" ]'
for cred in "https://someone:s3cr3t-t0ken@example.com/example/repo.git" "https://s3cr3t-t0ken@example.com/example/repo.git" \
            "x-access-token:s3cr3t-t0ken@example.com:example/repo.git"; do
  rm -f "$FD/last-firing.json"; fire "$B/mise" "$FK" "$cred" --session auto; rc=$?
  check "an origin with credentials in it (${cred%%@*}@...) is refused: exit 1, nothing run, the secret in no output or record" \
        eval '[ "$rc" = 1 ] && grep -Eq "carries credentials|must be an https URL" "$TMP/fire.out" && ! grep -rq "s3cr3t" "$TMP/fire.out" "$FD" "$FK/.git/config" && [ "$(grep -c "run paper:session" "$STUB/mise.log")" = "$lines" ]'
done
rm -f "$FD/scheduled-firing.json"
fire --checkout-only "$B/mise" "$FK" "$OURL"; rc=$?
check "--checkout-only checks out and runs nothing" \
      eval '[ "$rc" = 0 ] && [ "$(grep -c "run paper:session" "$STUB/mise.log")" = "$lines" ] && grep -q "is at origin/main $want" "$TMP/fire.out"'
check "... and stamps no scheduled firing"        test ! -e "$FD/scheduled-firing.json"

UH="$TMP/un-home"; UA="$TMP/un-agents"
uninst() { CLAUDE_CONFIG_DIR="$UH" CANON_LAUNCHAGENTS_DIR="$UA" "$R/scripts/automation" uninstall > "$TMP/uninstall.out" 2>&1; }
mkdir -p "$UH/canon" "$UA"; : > "$UH/canon/lanes"; : > "$UH/canon/lanes-watch.sh"; : > "$UA/local.canon.lanes-watch.plist"
: > "$UA/local.canon.paper-session.plist"; : > "$UH/canon/paper-session.sh"
fire --checkout-only "$B/mise" "$UH/canon/paper-checkout" "$OURL"
printf '\tstate = not running\n' > "$STUB/launchctl-print"; rm -f "$STUB/bootout-fails"; : > "$STUB/mise.log"
uninst; rc=$?
check "uninstall removes everything: exit 0"      eval '[ "$rc" = 0 ] && [ ! -e "$UH/canon/lanes" ] && [ ! -e "$UA/local.canon.lanes-watch.plist" ] && [ ! -e "$UA/local.canon.paper-session.plist" ]'
check "... the paper runner, its clone, and the trust mise gave the clone's mise.toml" \
      eval '[ ! -e "$UH/canon/paper-session.sh" ] && [ ! -e "$UH/canon/paper-checkout" ] && grep -qF "mise trust --untrust $UH/canon/paper-checkout/mise.toml" "$STUB/mise.log"'
mkdir -p "$UH/canon/paper-checkout"; echo mine > "$UH/canon/paper-checkout/file"; : > "$STUB/mise.log"
uninst; rc=$?
check "a paper-checkout install did not make is kept, named and its mise trust untouched: exit 1" \
      eval '[ "$rc" != 0 ] && [ -e "$UH/canon/paper-checkout/file" ] && grep -q "is not the clone install made" "$TMP/uninstall.out" && ! grep -q "trust --untrust" "$STUB/mise.log"'
rm -rf "$UH/canon/paper-checkout"
if [ "$(id -u)" = 0 ]; then
  skip "uninstall that leaves things" "a read-only directory does not stop root"
else
  : > "$UH/canon/lanes"; printf '\tstate = not running\n' > "$STUB/launchctl-print"; : > "$STUB/bootout-fails"
  chmod 555 "$UH/canon"
  uninst; rc=$?
  chmod 755 "$UH/canon"; rm -f "$STUB/bootout-fails"
  check "uninstall that leaves things: exit 1, names them" \
        eval '[ "$rc" != 0 ] && grep -q "not removed" "$TMP/uninstall.out" && grep -q "$UH/canon/lanes" "$TMP/uninstall.out" && grep -q "local.canon.lanes-watch" "$TMP/uninstall.out"'
fi

# ---------- the paper lock's owner has a deadline ----------
# Each paper task waits for the paper lock, then holds it while uv and Python run. A process that hangs there
# must neither keep the lock for good nor outlive it, or the next run would trade beside it. mise's per-task
# `timeout` stops a task's processes with SIGTERM, then SIGKILL 5 s later (mise docs, tasks/task-configuration,
# "timeout"). Checked statically: each paper task declares one above its own lock wait, paper:session's above
# that wait plus the window's ceiling (session_window.STALE_RUNNING_SECS). Then each task's own body, from
# mise.toml with only its lock folder moved into $TMP, runs under the real mise with a 2 s timeout and a uv
# stand-in that ignores SIGTERM and starts a child that ignores it too: a second run cannot take the lock while
# it runs, and once mise has stopped it nothing it started is left and the lock is free.
echo "paper lock deadline:"
task_part() { # task_part <task> <key>|run: a mise.toml task's `key = "value"`, or its run body
  awk -v q="'''" -v hdr="[tasks.\"$1\"]" -v want="$2" '
    inb { if ($0 == q) { inb = 0; if (s && want == "run") exit; next } if (s && want == "run") print; next }
    $0 == "run = " q { inb = 1; next }
    /^\[/ { s = ($0 == hdr); next }
    s && want != "run" && index($0, want " = ") == 1 { v = substr($0, length(want) + 4); gsub(/"/, "", v); print v; exit }' "$ROOT/mise.toml"
}
secs() { case "$1" in *h) echo $(( ${1%h} * 3600 )) ;; *m) echo $(( ${1%m} * 60 )) ;; *s) echo "${1%s}" ;; *) echo 0 ;; esac; }
ceiling=$(( $(sed -n 's/^STALE_RUNNING_SECS = \([0-9 *]*\)$/\1/p' "$ROOT/src/canon_trading/session_window.py") + 0 ))
# shellcheck disable=SC2034  # need is read by the eval'd check
for t in paper:session paper:test; do
  to=$(secs "$(task_part "$t" timeout)")
  w=$(task_part "$t" run | grep -oE 'lockf( -[a-z]+)* -t [0-9]+' | grep -oE '[0-9]+$' | head -1)
  need=$(( ${w:-0} + 1 )); extra=""
  if [ "$t" = paper:session ]; then need=$(( ${w:-0} + ceiling )); extra=" plus the window's ceiling (${ceiling} s)"; fi
  check "$t declares a mise timeout (${to} s) above its lock wait (${w:-none} s)$extra" \
        eval '[ -n "$w" ] && [ "$ceiling" -gt 0 ] && [ "$to" -ge "$need" ]'
done
check "scripts/automation's PAPER_DEADLINE is paper:session's timeout, which its silent-schedule bound counts" \
      test "$(sed -n 's/^PAPER_DEADLINE=\([0-9]*\).*/\1/p' "$ROOT/scripts/automation")" = "$(secs "$(task_part paper:session timeout)")"
LMISE=$(PATH="${PATH#"$B:"}" command -v mise 2>/dev/null) || LMISE=""
[ -n "$LMISE" ] || [ ! -x "$REAL_HOME/.local/bin/mise" ] || LMISE="$REAL_HOME/.local/bin/mise"
if [ ! -x /usr/bin/lockf ] || [ ! -x /usr/bin/getconf ]; then
  skip "paper lock deadline, run under mise" "no /usr/bin/lockf here (macOS only)"
elif [ -z "$LMISE" ]; then
  skip "paper lock deadline, run under mise" "no mise outside the stubs"
else
  getconf='$(/usr/bin/getconf DARWIN_USER_TEMP_DIR)'   # in a variable: a / in an inline pattern ends it
  # shellcheck disable=SC2034  # held and orc are read by the eval'd checks
  for t in paper:session paper:test; do
    LD="$TMP/deadline-${t#paper:}"; mkdir -p "$LD/bin"
    body=$(task_part "$t" run)
    moved=${body//"$getconf"/"$LD/"}
    if [ -z "$body" ] || [[ "$moved" == *getconf* ]] || [[ "$moved" != *"$LD/"* ]] || [[ "$moved" == *"{{"* ]]; then
      t_fail "$t's body found in mise.toml, its lock folder moved into the test's"; continue
    fi
    cat > "$LD/bin/uv" <<'EOF'
#!/bin/bash
# a uv that hangs: it ignores SIGTERM, and so does the child it starts
trap '' TERM
echo $$ > "$LD/uv.pid"
/bin/bash -c 'trap "" TERM; echo $$ > "$LD/child.pid"; sleep 60' &
wait
EOF
    chmod +x "$LD/bin/uv"
    { printf '[tasks.owner]\ntimeout = "2s"\nenv.ALPACA_API_KEY = "stand-in"\nenv.ALPACA_SECRET_KEY = "stand-in"\n'
      printf "run = '''\n%s\n'''\n" "$moved"; } > "$LD/mise.toml"
    (cd "$LD" && env -i HOME="$HOME" LD="$LD" PATH="$LD/bin:/usr/bin:/bin" "$LMISE" run owner > "$LD/out" 2>&1) & op=$!
    for _ in $(seq 100); do [ -s "$LD/child.pid" ] && break; sleep 0.1; done
    /usr/bin/lockf -k -t 0 "$LD/canon-paper-test.lock" true 2>/dev/null; held=$?
    wait "$op"; orc=$?
    up=""; for f in uv.pid child.pid; do [ -s "$LD/$f" ] && kill -0 "$(cat "$LD/$f")" 2>/dev/null && up="$up ${f%.pid}"; done
    /usr/bin/lockf -k -t 0 "$LD/canon-paper-test.lock" true 2>/dev/null; free=$?
    check "$t, its owner hung: a second run cannot take the lock meanwhile" eval '[ -s "$LD/child.pid" ] && [ "$held" != 0 ]'
    check "... mise stops it at the timeout and fails the task"              eval '[ "$orc" != 0 ] && grep -q "timed out" "$LD/out"'
    check "... nothing it started is left running (left:${up:- none})"     test -z "$up"
    check "... and the lock is free for the next run"                         test "$free" = 0
    for f in uv.pid child.pid; do [ -s "$LD/$f" ] && kill -KILL "$(cat "$LD/$f")" 2>/dev/null; done
  done
fi

# ---------- bootstrap ----------
echo "bootstrap:"
BS="$TMP/bs"; mkdir -p "$BS/scripts" "$BS/canon"; cp "$ROOT/scripts/bootstrap" "$BS/scripts/"; cp -R "$ROOT/home" "$BS/home"; : > "$BS/mise.toml"
jq -n --arg t "tag:v$CCPIN" '{upstreams: [{id: "claude-code", track: $t}]}' > "$BS/canon/upstreams.json"
bs() { "$BS/scripts/bootstrap" "$@" > "$TMP/bs.out" 2>&1; }
C="$TMP/cfg dir"
: > "$STUB/mise.log"
bs --check
check "check probes tools with exec_auto_install off" eval 'grep "exec --" "$STUB/mise.log" > "$TMP/execs" && ! grep -qv "exec_auto_install=false" "$TMP/execs"'
check "pinned mise version: ok"                   rowis "$TMP/bs.out" mise ok
echo "2026.1.1 macos-arm64 (stub)" > "$STUB/mise-version"; bs --check; rc=$?
check "other mise version: OUTDATED, exit 1"      eval 'rowis "$TMP/bs.out" mise OUTDATED && [ "$rc" != 0 ]'
echo "$PINNED macos-arm64 (stub)" > "$STUB/mise-version"; bs --check
check "claude CLI at the pin: ok, showing both"   eval 'rowis "$TMP/bs.out" "claude CLI" ok && grep -q "claude CLI .*$CCPIN; pinned $CCPIN" "$TMP/bs.out"'
echo "9999.0.0 (Claude Code)" > "$STUB/claude-version"; bs --check
check "claude CLI above the pin (9999.0.0): ok"   eval 'rowis "$TMP/bs.out" "claude CLI" ok && grep -q "claude CLI .*pinned $CCPIN" "$TMP/bs.out"'
echo "2.2.0 (Claude Code)" > "$STUB/claude-version"; bs --check
check "claude CLI above the pin with a lower last field (2.2.0): ok" rowis "$TMP/bs.out" "claude CLI" ok
echo "0.0.1 (Claude Code)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI below the pin (0.0.1): BEHIND, exit 1" eval 'rowis "$TMP/bs.out" "claude CLI" BEHIND && [ "$rc" != 0 ]'
check "... with the fix: claude install <pin>"    grep -q "run: claude install $CCPIN\$" "$TMP/bs.out"
echo "2.1.99 (Claude Code)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI below the pin as numbers, above it as text (2.1.99): BEHIND" \
      eval 'rowis "$TMP/bs.out" "claude CLI" BEHIND && [ "$rc" != 0 ]'
echo "Claude Code (dev build)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI version unparseable: UNKNOWN, exit 1" eval 'rowis "$TMP/bs.out" "claude CLI" UNKNOWN && [ "$rc" != 0 ]'
echo "$CCPIN (Claude Code)" > "$STUB/claude-version"

: > "$STUB/security.log"; rm -f "$STUB/keychain"; bs --check; rc=$?
check "paper key pair absent: reported, names both" \
      eval 'rowis "$TMP/bs.out" "paper key pair" absent && grep -q "ALPACA_API_KEY ALPACA_SECRET_KEY; to enter the pair: mise run paper:store" "$TMP/bs.out"'
echo ALPACA_API_KEY > "$STUB/keychain"; bs --check
check "paper key pair half there: absent, names the missing one" \
      eval 'rowis "$TMP/bs.out" "paper key pair" absent && grep -q "item for: ALPACA_SECRET_KEY;" "$TMP/bs.out"'
printf 'ALPACA_API_KEY\nALPACA_SECRET_KEY\n' > "$STUB/keychain"; bs --check; rc_present=$?
check "paper key pair present: ok"                 rowis "$TMP/bs.out" "paper key pair" ok
check "... and its absence does not change the exit status" test "$rc" = "$rc_present"
check "paper row looks items up by service and account only, never -w or -g" \
      eval 'grep -q "find-generic-password -s canon-alpaca-paper -a ALPACA_SECRET_KEY\$" "$STUB/security.log" && ! grep -Eq " -(w|g)( |\$)" "$STUB/security.log"'
rm -f "$STUB/keychain"
# every keychain service mise.toml's paper tasks name is the one the bootstrap row looks up (ADR 0029)
paper_names() { grep -oE '(-s |svc=)[A-Za-z0-9"$_-]+' "$ROOT/mise.toml" | sed -E 's/^(-s |svc=)//' | grep -vxF '"$svc"'; }
# shellcheck disable=SC2034  # read by the eval'd check below
psvc=$(sed -n 's/^PAPER_SERVICE="\([^"]*\)".*/\1/p' "$ROOT/scripts/bootstrap")
check "mise.toml's paper tasks name only bootstrap's keychain service" \
      eval '[ -n "$psvc" ] && [ "$(paper_names | wc -l | tr -d " ")" -ge 5 ] && ! paper_names | grep -vxF "$psvc" | grep -q .'

# ---------- paper:store on a terminal, against the real security ----------
# The stub above cannot see how Apple's security behaves on a terminal (ADR 0033: with -w last it prompts on
# the terminal and never reads a pipe). So paper:store's own body, taken from mise.toml with only the
# service changed to a throwaway one, runs on a pseudo-terminal made by expect, typed a made-up pair, with a
# curl stand-in first on PATH answering for Alpaca's paper API. It writes to the real login keychain under
# that throwaway service only, and the EXIT trap deletes those items however the run ends.
echo "paper:store on a terminal:"
tsvc="canon-test-lanes-throwaway-$$-$RANDOM"
pstore_body=$(awk -v q="'''" '/^\[tasks\."paper:store"\]$/ {t=1; next} t && $0 == "run = " q {b=1; next} b && $0 == q {exit} b' "$ROOT/mise.toml")
body=${pstore_body/"svc=$psvc"/"svc=$tsvc"}
pkey=PKMADEUPMADEUPMADEUP; psecret=madeupsecretmadeupsecretmadeupsecret   # made-up; never a real pair
paper_cleanup() {
  local a
  for a in ALPACA_API_KEY ALPACA_SECRET_KEY probe; do
    HOME="$REAL_HOME" /usr/bin/security delete-generic-password -s "$tsvc" -a "$a" >/dev/null 2>&1
  done
}
pabsent() { local a; for a in ALPACA_API_KEY ALPACA_SECRET_KEY ${1:+"$1"}; do
  HOME="$REAL_HOME" /usr/bin/security find-generic-password -s "$tsvc" -a "$a" >/dev/null 2>&1; [ $? = 44 ] || return 1; done; }
pread() { HOME="$REAL_HOME" /usr/bin/security find-generic-password -s "$tsvc" -a "$1" -w 2>/dev/null; }
if [ ! -x /usr/bin/security ]; then skip "paper:store on a terminal" "no /usr/bin/security here (macOS only)"
elif [ ! -x /usr/bin/expect ]; then skip "paper:store on a terminal" "no /usr/bin/expect to make a pseudo-terminal"
elif ! /usr/bin/expect -c 'spawn -noecho true; expect eof' >/dev/null 2>&1; then
  skip "paper:store on a terminal" "expect could not open a pseudo-terminal here"
elif ! HOME="$REAL_HOME" /usr/bin/security default-keychain >/dev/null 2>&1; then
  skip "paper:store on a terminal" "no default keychain for this user"
elif [ -z "$psvc" ] || [ "$tsvc" = "$psvc" ] || [[ "$body" == *"$psvc"* ]] || [[ "$body" != *"svc=$tsvc"* ]]; then
  t_fail "paper:store's body found in mise.toml, its service swapped for a throwaway one"
elif [[ "$body" == *"{{"* || "$body" == *"{%"* || "$body" == *"{#"* ]]; then
  t_fail "paper:store's body holds no Tera delimiter, so mise runs it as written (ADR 0029)"
else
  trap 'paper_cleanup; rm -rf "$TMP"' EXIT
  trap 'exit 1' INT TERM HUP
  # a locked keychain can wait on an unlock dialog, so the probe gets 10 s and is then stopped
  HOME="$REAL_HOME" /usr/bin/security add-generic-password -a probe -s "$tsvc" -X 00 >/dev/null 2>&1 & ppid_=$!
  for _ in $(seq 100); do kill -0 "$ppid_" 2>/dev/null || break; sleep 0.1; done
  if kill -0 "$ppid_" 2>/dev/null; then kill "$ppid_" 2>/dev/null; wait "$ppid_" 2>/dev/null; prc=timeout
  else wait "$ppid_"; prc=$?; fi
  if [ "$prc" != 0 ]; then
    skip "paper:store on a terminal" "the login keychain took no new item within 10 s (locked, or no access: $prc)"
  else
    paper_cleanup
    PB="$TMP/paper-bin"; mkdir -p "$PB"
    # curl stand-in: takes the headers on stdin as curl -H @- would, prints the status code in $STUB/curl-code
    printf '#!/bin/bash\ncat > /dev/null\ncat "$STUB/curl-code"\n' > "$PB/curl"; chmod +x "$PB/curl"
    cat > "$TMP/pstore.exp" <<'EOF'
# Type the made-up pair at paper:store's two hidden prompts; exit 97 if security prompts on the terminal.
set timeout 30
proc finish {} { lassign [wait] pid sid oserr value; exit $value }
spawn -noecho bash -c $env(PSTORE_BODY)
expect {
  "key ID (hidden): " { send -- "$env(PSTORE_KEY)\r" }
  timeout { puts "\n<<no key prompt>>"; exit 98 }
  eof { finish }
}
expect {
  "secret key (hidden): " { send -- "$env(PSTORE_SECRET)\r" }
  timeout { puts "\n<<no secret prompt>>"; exit 98 }
  eof { finish }
}
expect {
  -re "password data for new item|retype password" { puts "\n<<security prompted on the terminal>>"; exit 97 }
  timeout { puts "\n<<no end>>"; exit 98 }
  eof { finish }
}
EOF
    pstore() {
      echo "$1" > "$STUB/curl-code"
      PATH="$PB:$PATH" HOME="$REAL_HOME" PSTORE_BODY="$body" PSTORE_KEY="$pkey" PSTORE_SECRET="$psecret" \
        /usr/bin/expect -f "$TMP/pstore.exp" > "$TMP/pstore.out" 2>&1
    }
    pstore 200; rc=$?
    check "paper:store, the paper API answering 200: exit 0, saying it stored the pair" \
          eval '[ "$rc" = 0 ] && grep -q "stored ALPACA_API_KEY and ALPACA_SECRET_KEY" "$TMP/pstore.out"'
    check "... no prompt of security's on the terminal" eval '! grep -Eq "password data for new item|retype password|security prompted" "$TMP/pstore.out"'
    check "... both items read back equal to what was typed" \
          eval '[ "$(pread ALPACA_API_KEY)" = "$pkey" ] && [ "$(pread ALPACA_SECRET_KEY)" = "$psecret" ]'
    check "... neither value on the terminal" eval '! grep -qF -e "$pkey" -e "$psecret" "$TMP/pstore.out"'
    pstore 200; rc=$?
    check "paper:store with the items there: refused, exit 1" eval '[ "$rc" = 1 ] && grep -q "already in the login keychain" "$TMP/pstore.out"'
    paper_cleanup
    pstore 401; rc=$?
    check "paper:store, the paper API answering 401: exit 1, nothing stored" \
          eval '[ "$rc" = 1 ] && grep -q "answered 401" "$TMP/pstore.out" && pabsent'
  fi
  paper_cleanup
  check "throwaway keychain items gone, the probe too" pabsent probe
fi

mkdir -p "$C/canon"; echo "# previous" > "$C/canon/ledger.sh"
CLAUDE_CONFIG_DIR="$C" bs --user-config; rc=$?
check "user-config into a directory with a space: exit 0" test "$rc" = 0
bak=$(find "$C/canon" -name 'ledger.sh.replaced-*'); bak=${bak%%$'\n'*}
check "differing ledger.sh kept beside the new one" eval '[ -n "$bak" ] && [ "$(cat "$bak")" = "# previous" ] && cmp -s "$C/canon/ledger.sh" "$ROOT/home/.claude/canon/ledger.sh" && grep -q "kept" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C" bs --user-config
check "identical scripts are not backed up again" test "$(find "$C/canon" -name '*.replaced-*' | wc -l | tr -d ' ')" = 1
cmd=$(jq -r '.hooks.SessionStart[0].hooks[0].command' "$C/settings.json")
echo '{"hook_event_name":"SessionStart","session_id":"t1","cwd":"/w/x"}' | CLAUDE_CONFIG_DIR="$C" sh -c "$cmd"
check "installed hook command runs the installed ledger.sh" eval 'cat "$C"/canon/ledger/*.jsonl 2>/dev/null | jq -e "select(.sid == \"t1\")" >/dev/null'
scmd=$(jq -r '.statusLine.command' "$C/settings.json")
out=$(echo '{"session_id":"t1","model":{"id":"m"}}' | CLAUDE_CONFIG_DIR="$C" sh -c "$scmd")
check "installed status line command runs"        test -n "$out" -a -f "$C/canon/sessions/t1.json"
CLAUDE_CONFIG_DIR="$C" bs --check
check "check finds the hooks where they are called" eval 'rowis "$TMP/bs.out" "event ledger hooks" ok && rowis "$TMP/bs.out" "status line" ok'
C2="$TMP/cfg2"; mkdir -p "$C2/canon"; cp "$ROOT/home/.claude/canon/"*.sh "$C2/canon/"; cp "$ROOT/home/.claude/settings.json" "$C2/settings.json"
CLAUDE_CONFIG_DIR="$C2" bs --check
check "check rejects hooks that call another directory" eval 'rowis "$TMP/bs.out" "event ledger hooks" MISSING && rowis "$TMP/bs.out" "status line" MISSING'
CLAUDE_CONFIG_DIR="$TMP/bad\$dir" bs --user-config; rc=$?
check "unquotable config directory refused"       eval '[ "$rc" != 0 ] && [ ! -e "$TMP/bad\$dir" ]'

: > "$STUB/mise.log"
bs --install; rc=$?
# shellcheck disable=SC2034  # read by the eval'd check below
want=$(printf 'eval "$("%s" activate zsh)"' "$B/mise")
check "install writes the mise it used into ~/.zshrc" eval '[ "$rc" = 0 ] && grep -qxF "$want" "$HOME/.zshrc"'
check "install ran mise install with that mise"   grep -q '^mise install' "$STUB/mise.log"

check "install with a claude CLI at the pin runs no installer" eval '[ "$rc" = 0 ] && grep -q "Claude Code CLI $CCPIN (pinned $CCPIN)" "$TMP/bs.out"'

# --install with no claude on PATH: a curl stub serves an installer stub that records its arguments and puts
# a claude in ~/.local/bin that reports $STUB/installed-version, so nothing is downloaded
B3="$TMP/bin-noclaude"; mkdir -p "$B3"
for f in "$B"/*; do [ "${f##*/}" = claude ] || cp "$f" "$B3/"; done
cat > "$B3/curl" <<'EOF'
#!/bin/bash
out=""; url=""
while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift ;; https://*) url="$1" ;; esac; shift; done
echo "curl $url" >> "$STUB/curl.log"
[ -n "$out" ] || exit 1
cat > "$out" <<'INST'
#!/bin/bash
echo "installer $*" >> "$STUB/installer.log"
mkdir -p "$HOME/.local/bin"
printf '#!/bin/bash\ncat "%s/installed-version"\n' "$STUB" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
INST
EOF
chmod +x "$B3/curl"
P3="$B3"; IFS=: read -r -a dirs <<<"$PATH"
for d in "${dirs[@]}"; do [ "$d" = "$B" ] || [ -x "$d/claude" ] || P3="$P3:$d"; done
# inst_cli <version the installed CLI reports, or "none"> <version the installer leaves>: run --install
inst_cli() {
  rm -f "$HOME/.local/bin/claude"; : > "$STUB/curl.log"; : > "$STUB/installer.log"
  if [ "$1" != none ]; then
    mkdir -p "$HOME/.local/bin"
    printf '#!/bin/bash\necho "%s (Claude Code)"\n' "$1" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
  fi
  echo "$2 (Claude Code)" > "$STUB/installed-version"
  PATH="$P3" bs --install
}
inst_cli none "$CCPIN"; rc=$?
check "install with no CLI fetches the Claude Code installer" eval '[ "$rc" = 0 ] && grep -qxF "curl https://claude.ai/install.sh" "$STUB/curl.log"'
check "... and runs it for the registry's claude-code pin" grep -qxF "installer $CCPIN" "$STUB/installer.log"
inst_cli 0.0.1 "$CCPIN"; rc=$?
check "install with a CLI below the pin runs the installer for the pin" eval '[ "$rc" = 0 ] && grep -qxF "installer $CCPIN" "$STUB/installer.log"'
inst_cli 0.0.1 0.0.1; rc=$?
check "install that leaves the CLI below the pin: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "Claude Code CLI is 0.0.1, still below the pin $CCPIN" "$TMP/bs.out"'
inst_cli none "dev build"; rc=$?
check "install that leaves an unreadable version: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "cannot read a version from the Claude Code CLI" "$TMP/bs.out"'
inst_cli 9999.0.0 0.0.1; rc=$?
check "install with a CLI above the pin runs no installer" eval '[ "$rc" = 0 ] && [ ! -s "$STUB/installer.log" ]'
rm -f "$HOME/.local/bin/claude"

echo "test-lanes: $pass passed, $fail failed, $skipped skipped"
[ "$fail" -eq 0 ]
