check "the same allowlist in another order: ok"    eval 'rowis "$TMP/bs.out" "model allowlist" ok && [ "$rc" = 0 ]'
pin_settings 'del(.modelPicker)'; rc=$?
check "no picker row: MISSING, exit 1"             eval 'rowis "$TMP/bs.out" "picker rows" MISSING && [ "$rc" != 0 ]'
pin_settings '.autoUpdatesChannel = "stable"'; rc=$?
check "the stable channel: MISMATCH, exit 1"        eval 'rowis "$TMP/bs.out" "update channel" MISMATCH && [ "$rc" != 0 ]'
jq '.autoUpdatesChannel = "stable"' "$C/settings.json" > "$C3/settings.json"; DISABLE_UPDATES=1 CLAUDE_CONFIG_DIR="$C3" bs --check
check "... and an off switch in the environment is named in the same row" \
      eval 'rowis "$TMP/bs.out" "update channel" MISMATCH && grep -q "this environment also sets DISABLE_UPDATES" "$TMP/bs.out"'
pin_settings 'del(.autoUpdatesChannel)'; rc=$?
check "no channel named: NOT SET, the install-time channel applies, exit 1" \
      eval 'rowis "$TMP/bs.out" "update channel" "NOT SET" && grep -q "channel chosen at install time" "$TMP/bs.out" && [ "$rc" != 0 ]'
pin_settings '.env.DISABLE_AUTOUPDATER = "1"'; rc=$?
check "DISABLE_AUTOUPDATER in the settings: OFF, exit 1" \
      eval 'rowis "$TMP/bs.out" "update channel" OFF && grep -q "sets DISABLE_AUTOUPDATER" "$TMP/bs.out" && [ "$rc" != 0 ]'
jq '.' "$C/settings.json" > "$C3/settings.json"; DISABLE_AUTOUPDATER=1 CLAUDE_CONFIG_DIR="$C3" bs --check; rc=$?
check "... in this environment only, as Orca sets it: OFF for this session, not a failure" \
      eval 'rowis "$TMP/bs.out" "update channel" OFF && grep -q "this environment sets DISABLE_AUTOUPDATER" "$TMP/bs.out" && [ "$rc" = 0 ]'
cp "$BS/canon/models.json" "$TMP/models.keep"
jq '(.lanes[] | select(.alias == "fable") | .model) = "claude-fable-9"' "$TMP/models.keep" > "$BS/canon/models.json"
pin_settings '.env.ANTHROPIC_DEFAULT_FABLE_MODEL = "claude-fable-9"'; rc=$?
check "a model moved in canon/models.json: the pin check follows it (PINNED, not MISMATCH)" \
      eval 'rowis "$TMP/bs.out" "fable alias" PINNED && [ "$rc" != 0 ]'
echo '{' > "$BS/canon/models.json"; pin_settings '.'; rc=$?
check "canon/models.json unreadable: UNKNOWN, exit 1" eval 'rowis "$TMP/bs.out" "model settings" UNKNOWN && [ "$rc" != 0 ]'
jq 'del(.claude_code)' "$TMP/models.keep" > "$BS/canon/models.json"; pin_settings '.'; rc=$?
check "canon/models.json with no session default lane: UNKNOWN, exit 1" eval 'rowis "$TMP/bs.out" "model settings" UNKNOWN && [ "$rc" != 0 ]'
cp "$TMP/models.keep" "$BS/canon/models.json"
cp "$BS/home/.claude/settings.json" "$TMP/template.keep"
jq '.env.ANTHROPIC_DEFAULT_WIDGET_MODEL = "claude-widget-1"' "$TMP/template.keep" > "$BS/home/.claude/settings.json"
pin_settings '.'; rc=$?
check "a template that pins an alias: MISMATCH, exit 1" \
      eval 'rowis "$TMP/bs.out" "widget alias" MISMATCH && grep -q "home/.claude/settings.json pins ANTHROPIC_DEFAULT_WIDGET_MODEL" "$TMP/bs.out" && [ "$rc" != 0 ]'
jq 'del(.availableModels)' "$TMP/template.keep" > "$BS/home/.claude/settings.json"; pin_settings '.'; rc=$?
check "a template with no allowlist: UNKNOWN, exit 1, not a silent pass" \
      eval 'rowis "$TMP/bs.out" "model settings" UNKNOWN && [ "$rc" != 0 ]'
cp "$TMP/template.keep" "$BS/home/.claude/settings.json"
# --user-config on settings an earlier template rendered: the values ADR 0059 and ADR 0065 retire go, the
# owner's stay
C5="$TMP/cfg5"; CLAUDE_CONFIG_DIR="$C5" bs --user-config   # canon's own render for this directory
jq '.autoUpdatesChannel = "stable" | .env.ANTHROPIC_DEFAULT_FABLE_MODEL = "claude-fable-5-2" | del(.availableModels, .modelPicker)' \
  "$C5/settings.json" > "$C3/settings.json"; cp "$C3/settings.json" "$C5/settings.json"; C3="$C5"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "an earlier render: stable and the fable pin retired, latest, the allowlist and picker row in their place" \
      eval 'jqt "$C3/settings.json" ".autoUpdatesChannel == \"latest\" and (.env | has(\"ANTHROPIC_DEFAULT_FABLE_MODEL\") | not)" && grep -q "retired    autoUpdatesChannel, env.ANTHROPIC_DEFAULT_FABLE_MODEL" "$TMP/bs.out"'
check "... which is then the template's own render byte for byte: no copy to merge by hand" \
      eval 'grep -q "unchanged  $C3/settings.json\$" "$TMP/bs.out" && [ ! -e "$C3/settings.json.canon-proposed" ]'
C3="$TMP/cfg3"
jq '.model = "fable"' "$C/settings.json" > "$C3/settings.json"; CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "the earlier template's model fable is kept, and named" \
      eval 'jqt "$C3/settings.json" ".model == \"fable\"" && grep -q "KEPT .*sets model to another value" "$TMP/bs.out"'
jq '.autoUpdatesChannel = "latest" | .env.ANTHROPIC_DEFAULT_FABLE_MODEL = "claude-fable-5-1"' "$C/settings.json" > "$C3/settings.json"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "values the owner set (latest by name, a pin canon never set) are left alone" \
      jqt "$C3/settings.json" '.autoUpdatesChannel == "latest" and .env.ANTHROPIC_DEFAULT_FABLE_MODEL == "claude-fable-5-1"'
# A live settings.json that holds every key and hook entry the template sets, plus the owner's own keys and
# another tool's hook entries, has nothing to merge: unchanged, untouched, no .canon-proposed copy
C6="$TMP/cfg6"; CLAUDE_CONFIG_DIR="$C6" bs --user-config
jq '.ownKey = 1 | .env.OWN_VAR = "x" | .hooks.Stop += [{hooks: [{type: "command", command: "/opt/cockpit/hook.sh"}]}]
    | .hooks.Notification = [{matcher: "", hooks: [{type: "command", command: "/opt/cockpit/hook.sh"}]}]' \
  "$C6/settings.json" > "$TMP/s6"; cp "$TMP/s6" "$C6/settings.json"
CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "a superset of the template: unchanged, left as it is, no copy to merge by hand" \
      eval 'grep -q "unchanged  $C6/settings.json\$" "$TMP/bs.out" && cmp -s "$C6/settings.json" "$TMP/s6" && [ ! -e "$C6/settings.json.canon-proposed" ]'
jq '.hooks.Stop |= map(select(any(.hooks[]; .command | test("ledger")) | not))' "$TMP/s6" > "$C6/settings.json"
CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "one missing a template hook entry: EXISTS, naming the event and the command, with a copy to merge" \
      eval 'grep -q "EXISTS     $C6/settings.json differs from the template: hook Stop .*ledger.sh" "$TMP/bs.out" && [ -e "$C6/settings.json.canon-proposed" ]'
cp "$TMP/s6" "$C6/settings.json"; CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "... and once it holds them again: unchanged, the earlier run's copy removed" \
      eval 'grep -q "unchanged  $C6/settings.json\$" "$TMP/bs.out" && [ ! -e "$C6/settings.json.canon-proposed" ]'
jq '(.hooks.Stop[] | select(any(.hooks[]; .command | test("ledger")))) |= (.matcher = "")' "$TMP/s6" > "$C6/settings.json"
CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "a hook entry whose matcher is \"\" where the template gives none: the same, unchanged" \
      eval 'grep -q "unchanged  $C6/settings.json\$" "$TMP/bs.out" && [ ! -e "$C6/settings.json.canon-proposed" ]'
jq '(.hooks.Stop[].hooks[] | select(.command | test("ledger"))) |= del(.async)' "$TMP/s6" > "$C6/settings.json"
CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "a template hook present by command but with a field changed: EXISTS, naming it" \
      eval 'grep -q "EXISTS     $C6/settings.json differs from the template: hook Stop .*ledger.sh" "$TMP/bs.out" && [ -e "$C6/settings.json.canon-proposed" ]'
rm -f "$C6/settings.json.canon-proposed"
jq '.showThinkingSummaries = (.showThinkingSummaries | not)' "$TMP/s6" > "$C6/settings.json"
CLAUDE_CONFIG_DIR="$C6" bs --user-config
check "one with a template key set otherwise: EXISTS, naming the key" \
      eval 'grep -q "EXISTS     $C6/settings.json differs from the template: showThinkingSummaries" "$TMP/bs.out" && [ -e "$C6/settings.json.canon-proposed" ]'

# Antigravity's default model and self-updater (ADR 0059)
# shellcheck disable=SC2034  # read by the eval'd checks below
agy_label=$(jq -r '.runtimes[] | select(.runtime == "antigravity") | .label' "$ROOT/canon/models.json")
AS="$HOME/.gemini/antigravity-cli/settings.json"
