#!/bin/bash
# test-lanes — offline checks of the machine-level observability pieces around scripts/lanes:
# home/.claude/canon/statusline.sh, home/.claude/canon/lanes-watch.sh, scripts/automation and
# scripts/bootstrap. (scripts/lanes checks itself: scripts/lanes --selftest.)
# Inputs follow the documented payloads (https://code.claude.com/docs/en/hooks.md,
# https://code.claude.com/docs/en/statusline.md). Every script runs as a copy in a temp folder, with HOME,
# CLAUDE_CONFIG_DIR and CANON_LAUNCHAGENTS_DIR pointed there and stubs first on PATH for launchctl,
# osascript, mise, xcode-select, curl and claude, so nothing outside the temp folder is read or changed and
# nothing reaches the network. The --install case for a missing CLI drops the claude stub from PATH and uses
# a curl stub that serves an installer stub recording the version it was asked for. A case that needs a macOS-only tool is skipped with a line saying so.
# Exit 0 if every case behaves as expected, 1 otherwise.
# shellcheck disable=SC2016  # stub bodies and eval'd checks are single-quoted so they expand when they run
set -uo pipefail
# run from a git hook, git exports GIT_DIR and friends; clear them so the temp repositories stay separate
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0; skipped=0

t_pass() { pass=$((pass+1)); echo "  pass  $1"; }
t_fail() { fail=$((fail+1)); echo "  FAIL  $1"; }
skip()   { skipped=$((skipped+1)); echo "  skip  $1 ($2)"; }
# check <label> <command...>: passes when the command succeeds
check()  { local label="$1"; shift; if "$@"; then t_pass "$label"; else t_fail "$label"; fi; }
jqt()    { jq -e "$2" "$1" >/dev/null 2>&1; }                 # jqt <file> <jq boolean>
rowis()  { grep -Eq "^  $2 +$3( |\$)" "$1"; }                  # rowis <output file> <row name> <label>
iso()    { jq -nr --argjson t "$1" '$t | todate'; }           # epoch seconds -> ISO 8601 UTC
NOW=$(date -u +%s)

# ---------- stubs ----------
B="$TMP/bin"; mkdir -p "$B"
cat > "$B/mise" <<'EOF'
#!/bin/bash
# mise stub: version from $STUB/mise-version; exec logs MISE_EXEC_AUTO_INSTALL and fakes the tools
echo "mise $* | exec_auto_install=${MISE_EXEC_AUTO_INSTALL:-unset}" >> "$STUB/mise.log"
case "${1:-}" in
  --version) cat "$STUB/mise-version"; exit 0 ;;
  trust|install) exit 0 ;;
  exec) shift; [ "${1:-}" = "--" ] && shift ;;
  *) exit 0 ;;
esac
cmd="$1"; shift
if [ "$cmd" = gh ]; then
  case "$1 $2" in
    "auth status") exit "$(cat "$STUB/gh-auth-rc" 2>/dev/null || echo 0)" ;;
    "run list")
      expr=""; while [ $# -gt 0 ]; do [ "$1" = "--jq" ] && expr="$2"; [ "$1" = "--json" ] && echo "fields $2" >> "$STUB/gh.log"; shift; done
      jq -r "$expr" "$STUB/gh-runs.json"; exit $? ;;
  esac
  exit 0
fi
echo "$cmd 1.0 (stub)"
EOF
cat > "$B/launchctl" <<'EOF'
#!/bin/bash
echo "launchctl $*" >> "$STUB/launchctl.log"
case "${1:-}" in
  print) [ -f "$STUB/launchctl-print" ] || exit 113; cat "$STUB/launchctl-print" ;;
  bootout) [ -f "$STUB/bootout-fails" ] && exit 5; rm -f "$STUB/launchctl-print" ;;
esac
exit 0
EOF
printf '#!/bin/bash\necho "osascript $*" >> "$STUB/osascript.log"\n' > "$B/osascript"
printf '#!/bin/bash\n[ "${1:-}" = -p ] && echo /Library/Developer/CommandLineTools\nexit 0\n' > "$B/xcode-select"
printf '#!/bin/bash\n[ "${1:-}" = --version ] && { echo "curl stub"; exit 0; }\necho "curl stub: no network in tests" >&2\nexit 1\n' > "$B/curl"
printf '#!/bin/bash\ncat "$STUB/claude-version"\n' > "$B/claude"   # claude stub: --version from $STUB/claude-version
# security stub: logs its arguments; find-generic-password succeeds for an account listed in $STUB/keychain,
# else exits 44 as Apple's does for an absent item. It never holds a value.
cat > "$B/security" <<'EOF'
#!/bin/bash
echo "security $*" >> "$STUB/security.log"
[ "${1:-}" = find-generic-password ] || exit 1
acct=""; while [ $# -gt 0 ]; do [ "$1" = -a ] && acct="$2"; shift; done
grep -qxF "$acct" "$STUB/keychain" 2>/dev/null || exit 44
echo 'keychain: "stub"'
EOF
chmod +x "$B"/*
export STUB="$TMP/stub"; mkdir -p "$STUB"
export PATH="$B:$PATH"
export HOME="$TMP/home"; mkdir -p "$HOME"
unset CLAUDE_CONFIG_DIR CANON_LEDGER_HOME AUTOMATION_SKIP_LAUNCHD CANON_LAUNCHAGENTS_DIR
PINNED=$(sed -n 's/^MISE_VERSION="v\([^"]*\)".*/\1/p' "$ROOT/scripts/bootstrap")
echo "$PINNED macos-arm64 (stub)" > "$STUB/mise-version"
CCPIN="2.1.321"   # the claude-code pin the bootstrap fixture's registry sets, whatever the real one is
echo "$CCPIN (Claude Code)" > "$STUB/claude-version"

# ---------- event ledger ----------
echo "event ledger:"
LG="$TMP/lg"
echo '{"hook_event_name":"SessionStart","session_id":"s1","cwd":"/w","source":"compact"}' | CLAUDE_CONFIG_DIR="$LG" "$ROOT/home/.claude/canon/ledger.sh"
cat "$LG"/canon/ledger/*.jsonl > "$TMP/lg.jsonl" 2>/dev/null
check "ledger line has ts and a sub-second t of the same moment" \
      jqt "$TMP/lg.jsonl" '(.t | type) == "number" and (.t | floor) == (.ts | fromdateiso8601)'
check "ledger records the SessionStart source"     jqt "$TMP/lg.jsonl" '.source == "compact"'

# ---------- status line ----------
echo "status line:"
SL="$TMP/sl"; mkdir -p "$SL/canon/sessions"
echo '{"sid":"s1","model":"model-a"}' > "$SL/canon/sessions/s1.json"
echo '{"session_id":"s1","model":{"id":"model-b"}}' | CLAUDE_CONFIG_DIR="$SL" "$ROOT/home/.claude/canon/statusline.sh" >/dev/null
echo '{"session_id":"s1","model":{"id":"model-c"},"workspace":{"current_dir":"/w/alpha"},"cwd":"/w/alpha"}' \
  | CLAUDE_CONFIG_DIR="$SL" "$ROOT/home/.claude/canon/statusline.sh" >/dev/null
cat "$SL"/canon/ledger/*.jsonl > "$TMP/sl.jsonl" 2>/dev/null
check "model change without a directory writes no cwd" jqt "$TMP/sl.jsonl" 'select(.to_model == "model-b") | has("cwd") | not'
check "model change with a directory records it"      jqt "$TMP/sl.jsonl" 'select(.to_model == "model-c") | .cwd == "/w/alpha"'

# ---------- lane watchdog ----------
echo "lane watchdog:"
WD="$TMP/wd"; mkdir -p "$WD/canon"
printf '#!/bin/bash\ncat "%s/report.json"\nexit "$(cat "%s/lanes-rc")"\n' "$STUB" "$STUB" > "$WD/canon/lanes"
chmod +x "$WD/canon/lanes"
report() { # report <sid> <flags json> [state]: one-session lanes report
  jq -n --arg sid "$1" --argjson flags "$2" --arg state "${3:-working}" \
    '{sessions: [{sid: $sid, lane: "alpha", state: $state, quiet_min: 20, fail: 0, flags: $flags}]}' > "$STUB/report.json"
}
watch() { CLAUDE_CONFIG_DIR="$WD" CANON_WATCH_NO_NOTIFY=1 "$ROOT/home/.claude/canon/lanes-watch.sh" 2>/dev/null; }
st="$WD/canon/watch/lanes-status.json"
echo 0 > "$STUB/lanes-rc"
report s1 '["QUIET"]' QUIET; watch
check "first flag alerts"                         jqt "$st" '.ok and .new_alerts == 1'
report s1 '[]'; watch
check "cleared flag stays remembered"             jqt "$WD/canon/watch/alerted.json" 'index("s1:QUIET") != null'
report s1 '["QUIET"]' QUIET; watch
check "returning flag does not alert again"       jqt "$st" '.ok and .new_alerts == 0'
check "one alert recorded in all"                 test "$(wc -l < "$WD/canon/watch/alerts.jsonl" | tr -d ' ')" = 1
report s2 '[]'; watch
check "key dropped once its session leaves"       jqt "$WD/canon/watch/alerted.json" '. == []'
echo 4 > "$STUB/lanes-rc"; : > "$STUB/report.json"
watch
check "empty ledger, no hooks: not ok"            jqt "$st" '.ok == false'
jq -n --arg c "\"$WD\"/canon/ledger.sh" '{hooks: {UserPromptSubmit: [{hooks: [{type: "command", command: $c}]}], Stop: [{hooks: [{type: "command", command: $c}]}]}}' > "$WD/settings.json"
watch
check "empty ledger, hook registered but missing: not ok" jqt "$st" '.ok == false'
printf '#!/bin/bash\nexit 0\n' > "$WD/canon/ledger.sh"; chmod +x "$WD/canon/ledger.sh"
watch
check "empty ledger, hook installed and registered: ok" jqt "$st" '.ok == true'

# ---------- automation ----------
echo "automation:"
R="$TMP/repo"; AH="$TMP/auto-home"
mkdir -p "$R/scripts" "$R/.githooks" "$R/.claude/hooks" "$R/.github/workflows" "$R/.canon" "$R/home/.claude/canon" \
         "$AH/scheduled-tasks/canon-landscape-refresh" "$AH/canon/watch"
cp "$ROOT/scripts/automation" "$ROOT/scripts/lanes" "$R/scripts/"
cp "$ROOT/home/.claude/canon/lanes-watch.sh" "$R/home/.claude/canon/"
printf '#!/bin/bash\nexit 0\n' > "$R/.githooks/pre-commit"; cp "$R/.githooks/pre-commit" "$R/.claude/hooks/canon-watch.sh"
chmod +x "$R/.githooks/pre-commit" "$R/.claude/hooks/canon-watch.sh"
echo '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"canon-watch.sh"}]}]}}' > "$R/.claude/settings.json"
: > "$R/.github/dependabot.yml"; : > "$R/.github/workflows/watch.yml"; : > "$AH/scheduled-tasks/canon-landscape-refresh/SKILL.md"
git -C "$R" init -q && git -C "$R" config core.hooksPath .githooks && git -C "$R" remote add origin https://github.com/example/repo.git
jq -n --arg at "$(iso "$NOW")" '{checked_at: $at, ok: true, sessions: 1, flagged_now: 0, ledger_kb: 1}' > "$AH/canon/watch/lanes-status.json"
mkdir -p "$R/canon"; echo '{"upstreams": []}' > "$R/canon/upstreams.json"; echo '{"pins": {}}' > "$R/canon/upstreams.lock.json"
# the checksum canon-watch.sh records for the tree's registry and lock
FP=$(cat "$R/canon/upstreams.json" "$R/canon/upstreams.lock.json" | cksum | awk '{ print $1 "-" $2 }')
watchjson() { # watchjson <age in seconds> <ok> [extra jq]
  jq -n --arg at "$(iso $((NOW - $1)))" --argjson e $((NOW - $1)) --argjson ok "$2" --arg fp "$FP" \
    "{checked_at: \$at, checked_at_epoch: \$e, registry: \$fp, ok: \$ok, newer: [], advanced: [], retagged: [], stale: [], bot_prs: [], errors: []} ${3:-}" > "$R/.canon/watch.json"
}
runs() { jq -n --arg at "$(iso "$NOW")" --arg s "$1" "[{createdAt: \$at, status: \$s} + $2]" > "$STUB/gh-runs.json"; }
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 0\n' > "$STUB/launchctl-print"
status() { CLAUDE_CONFIG_DIR="$AH" "$R/scripts/automation" status > "$TMP/status.out" 2>&1; }
watchjson 60 true; runs completed '{conclusion: "success"}'
status; rc=$?
check "all healthy: exit 0"                       test "$rc" = 0
watchjson 60 false; status; rc=$?
check "landscape watch not ok: INCOMPLETE, exit 1" eval 'rowis "$TMP/status.out" "landscape watch" INCOMPLETE && [ "$rc" != 0 ]'
watchjson $((5 * 86400)) true; status; rc=$?
check "landscape watch days old: STALE, exit 1"   eval 'rowis "$TMP/status.out" "landscape watch" STALE && [ "$rc" != 0 ]'
watchjson 60 true '| .stale = ["superpowers"]'; status; rc=$?
check "stale lock: STALE-LOCK, exit 1"            eval 'rowis "$TMP/status.out" "landscape watch" STALE-LOCK && [ "$rc" != 0 ]'
check "... naming the id and the resolve to run"  grep -q 'stale for superpowers.*scripts/canon resolve superpowers' "$TMP/status.out"
check "... not as an incomplete run"              eval '! grep -q "could not check everything" "$TMP/status.out"'
watchjson 60 true '| .registry = "1-1"'; status; rc=$?
check "a result for another registry: UNKNOWN"    eval 'rowis "$TMP/status.out" "landscape watch" UNKNOWN && [ "$rc" != 0 ]'
check "... and its counts are not shown"          eval '! grep -q "0 newer" "$TMP/status.out"'
watchjson 60 true '| del(.bot_prs)'; status; rc=$?
check "UNKNOWN row makes status exit 1"           eval 'rowis "$TMP/status.out" "dependency bot" UNKNOWN && [ "$rc" != 0 ]'
watchjson 60 true
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 1\n' > "$STUB/launchctl-print"; status; rc=$?
check "watchdog last exit 1: FAILED, exit 1"      eval 'rowis "$TMP/status.out" "lane watchdog" FAILED && [ "$rc" != 0 ]'
printf '\tstate = not running\n\truns = 0\n\tlast exit code = (never exited)\n' > "$STUB/launchctl-print"; status; rc=$?
check "watchdog with no exit code: UNKNOWN"       eval 'rowis "$TMP/status.out" "lane watchdog" UNKNOWN && [ "$rc" != 0 ]'
printf '\tstate = not running\n\truns = 3\n\tlast exit code = 0\n' > "$STUB/launchctl-print"
runs in_progress '{conclusion: ""}'; status; rc=$?
check "hosted run in progress, empty conclusion: ok" eval 'rowis "$TMP/status.out" "hosted watch" ok && [ "$rc" = 0 ]'
check "hosted watch asks for the run status"      grep -q 'status' "$STUB/gh.log"
runs queued '{}'; status; rc=$?
check "hosted run queued, no conclusion: ok"      eval 'rowis "$TMP/status.out" "hosted watch" ok && [ "$rc" = 0 ]'
runs completed '{conclusion: ""}'; status; rc=$?
check "hosted run completed, empty conclusion: UNKNOWN" eval 'rowis "$TMP/status.out" "hosted watch" UNKNOWN && [ "$rc" != 0 ]'
runs completed '{conclusion: "failure"}'; status; rc=$?
check "hosted run failed: FAILED, exit 1"         eval 'rowis "$TMP/status.out" "hosted watch" FAILED && [ "$rc" != 0 ]'
runs completed '{conclusion: "success"}'

if command -v plutil >/dev/null 2>&1; then
  : > "$STUB/launchctl.log"
  inst() { CLAUDE_CONFIG_DIR="$AH" CANON_LAUNCHAGENTS_DIR="$TMP/agents" AUTOMATION_SKIP_LAUNCHD=1 "$R/scripts/automation" install > "$TMP/install.out" 2>&1; }
  inst; rc=$?
  check "rehearsal install: exit 0"               test "$rc" = 0
  helper=$(git -C "$R" config --get-all credential.https://github.com.helper | tr '\n' '|')
  check "rehearsal sets the credential helper, with the mise found on PATH" \
        test "$helper" = "|!\"$B/mise\" exec -- gh auth git-credential|"
  check "rehearsal makes no launchctl change"     eval '! grep -Eq "bootstrap|bootout" "$STUB/launchctl.log"'
  # the agent must run the watchdog against the directory install used, whatever HOME is
  P="$TMP/agents/local.canon.lanes-watch.plist"
  rm -f "$AH/canon/watch/lanes-status.json"
  pe=$(plutil -extract EnvironmentVariables.CLAUDE_CONFIG_DIR raw -o - "$P" 2>/dev/null) || pe=""
  pa=$(plutil -extract ProgramArguments.1 raw -o - "$P" 2>/dev/null) || pa=""
  if [ -n "$pe" ]; then
    env -i HOME="$TMP/elsewhere" CLAUDE_CONFIG_DIR="$pe" CANON_WATCH_NO_NOTIFY=1 /bin/bash "$pa" 2>/dev/null
  else
    env -i HOME="$TMP/elsewhere" CANON_WATCH_NO_NOTIFY=1 /bin/bash "$pa" 2>/dev/null
  fi
  check "agent environment points the watchdog at the installed directory" \
        eval '[ "$pe" = "$AH" ] && jqt "$AH/canon/watch/lanes-status.json" "has(\"checked_at\")"'
  rm "$R/scripts/lanes"; inst; rc=$?
  check "failed copy makes install exit 1"        eval '[ "$rc" != 0 ] && grep -q "FAILED: could not install" "$TMP/install.out"'
else
  skip "automation install rehearsal" "needs plutil, which is macOS-only"
fi

UH="$TMP/un-home"; UA="$TMP/un-agents"
uninst() { CLAUDE_CONFIG_DIR="$UH" CANON_LAUNCHAGENTS_DIR="$UA" "$R/scripts/automation" uninstall > "$TMP/uninstall.out" 2>&1; }
mkdir -p "$UH/canon" "$UA"; : > "$UH/canon/lanes"; : > "$UH/canon/lanes-watch.sh"; : > "$UA/local.canon.lanes-watch.plist"
printf '\tstate = not running\n' > "$STUB/launchctl-print"; rm -f "$STUB/bootout-fails"
uninst; rc=$?
check "uninstall removes everything: exit 0"      eval '[ "$rc" = 0 ] && [ ! -e "$UH/canon/lanes" ] && [ ! -e "$UA/local.canon.lanes-watch.plist" ]'
if [ "$(id -u)" = 0 ]; then
  skip "uninstall that leaves things" "a read-only directory does not stop root"
else
  : > "$UH/canon/lanes"; printf '\tstate = not running\n' > "$STUB/launchctl-print"; : > "$STUB/bootout-fails"
  chmod 555 "$UH/canon"
  uninst; rc=$?
  chmod 755 "$UH/canon"; rm -f "$STUB/bootout-fails"
  check "uninstall that leaves things: exit 1, names them" \
        eval '[ "$rc" != 0 ] && grep -q "not removed" "$TMP/uninstall.out" && grep -q "$UH/canon/lanes" "$TMP/uninstall.out" && grep -q "local.canon.lanes-watch" "$TMP/uninstall.out"'
fi

# ---------- bootstrap ----------
echo "bootstrap:"
BS="$TMP/bs"; mkdir -p "$BS/scripts" "$BS/canon"; cp "$ROOT/scripts/bootstrap" "$BS/scripts/"; cp -R "$ROOT/home" "$BS/home"; : > "$BS/mise.toml"
jq -n --arg t "tag:v$CCPIN" '{upstreams: [{id: "claude-code", track: $t}]}' > "$BS/canon/upstreams.json"
bs() { "$BS/scripts/bootstrap" "$@" > "$TMP/bs.out" 2>&1; }
C="$TMP/cfg dir"
: > "$STUB/mise.log"
bs --check
check "check probes tools with exec_auto_install off" eval 'grep "exec --" "$STUB/mise.log" > "$TMP/execs" && ! grep -qv "exec_auto_install=false" "$TMP/execs"'
check "pinned mise version: ok"                   rowis "$TMP/bs.out" mise ok
echo "2026.1.1 macos-arm64 (stub)" > "$STUB/mise-version"; bs --check; rc=$?
check "other mise version: OUTDATED, exit 1"      eval 'rowis "$TMP/bs.out" mise OUTDATED && [ "$rc" != 0 ]'
echo "$PINNED macos-arm64 (stub)" > "$STUB/mise-version"; bs --check
check "claude CLI at the pin: ok, showing both"   eval 'rowis "$TMP/bs.out" "claude CLI" ok && grep -q "claude CLI .*$CCPIN; pinned $CCPIN" "$TMP/bs.out"'
echo "9999.0.0 (Claude Code)" > "$STUB/claude-version"; bs --check
check "claude CLI above the pin (9999.0.0): ok"   eval 'rowis "$TMP/bs.out" "claude CLI" ok && grep -q "claude CLI .*pinned $CCPIN" "$TMP/bs.out"'
echo "2.2.0 (Claude Code)" > "$STUB/claude-version"; bs --check
check "claude CLI above the pin with a lower last field (2.2.0): ok" rowis "$TMP/bs.out" "claude CLI" ok
echo "0.0.1 (Claude Code)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI below the pin (0.0.1): BEHIND, exit 1" eval 'rowis "$TMP/bs.out" "claude CLI" BEHIND && [ "$rc" != 0 ]'
check "... with the fix: claude install <pin>"    grep -q "run: claude install $CCPIN\$" "$TMP/bs.out"
echo "2.1.99 (Claude Code)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI below the pin as numbers, above it as text (2.1.99): BEHIND" \
      eval 'rowis "$TMP/bs.out" "claude CLI" BEHIND && [ "$rc" != 0 ]'
echo "Claude Code (dev build)" > "$STUB/claude-version"; bs --check; rc=$?
check "claude CLI version unparseable: UNKNOWN, exit 1" eval 'rowis "$TMP/bs.out" "claude CLI" UNKNOWN && [ "$rc" != 0 ]'
echo "$CCPIN (Claude Code)" > "$STUB/claude-version"

: > "$STUB/security.log"; rm -f "$STUB/keychain"; bs --check; rc=$?
check "paper key pair absent: reported, names both" \
      eval 'rowis "$TMP/bs.out" "paper key pair" absent && grep -q "ALPACA_API_KEY ALPACA_SECRET_KEY; to enter the pair: mise run paper:store" "$TMP/bs.out"'
echo ALPACA_API_KEY > "$STUB/keychain"; bs --check
check "paper key pair half there: absent, names the missing one" \
      eval 'rowis "$TMP/bs.out" "paper key pair" absent && grep -q "item for: ALPACA_SECRET_KEY;" "$TMP/bs.out"'
printf 'ALPACA_API_KEY\nALPACA_SECRET_KEY\n' > "$STUB/keychain"; bs --check; rc_present=$?
check "paper key pair present: ok"                 rowis "$TMP/bs.out" "paper key pair" ok
check "... and its absence does not change the exit status" test "$rc" = "$rc_present"
check "paper row looks items up by service and account only, never -w or -g" \
      eval 'grep -q "find-generic-password -s canon-alpaca-paper -a ALPACA_SECRET_KEY\$" "$STUB/security.log" && ! grep -Eq " -(w|g)( |\$)" "$STUB/security.log"'
rm -f "$STUB/keychain"
# every keychain service mise.toml's paper tasks name is the one the bootstrap row looks up (ADR 0029)
paper_names() { grep -oE '(-s |svc=)[A-Za-z0-9"$_-]+' "$ROOT/mise.toml" | sed -E 's/^(-s |svc=)//' | grep -vxF '"$svc"'; }
# shellcheck disable=SC2034  # read by the eval'd check below
psvc=$(sed -n 's/^PAPER_SERVICE="\([^"]*\)".*/\1/p' "$ROOT/scripts/bootstrap")
check "mise.toml's paper tasks name only bootstrap's keychain service" \
      eval '[ -n "$psvc" ] && [ "$(paper_names | wc -l | tr -d " ")" -ge 5 ] && ! paper_names | grep -vxF "$psvc" | grep -q .'

mkdir -p "$C/canon"; echo "# previous" > "$C/canon/ledger.sh"
CLAUDE_CONFIG_DIR="$C" bs --user-config; rc=$?
check "user-config into a directory with a space: exit 0" test "$rc" = 0
bak=$(find "$C/canon" -name 'ledger.sh.replaced-*'); bak=${bak%%$'\n'*}
check "differing ledger.sh kept beside the new one" eval '[ -n "$bak" ] && [ "$(cat "$bak")" = "# previous" ] && cmp -s "$C/canon/ledger.sh" "$ROOT/home/.claude/canon/ledger.sh" && grep -q "kept" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C" bs --user-config
check "identical scripts are not backed up again" test "$(find "$C/canon" -name '*.replaced-*' | wc -l | tr -d ' ')" = 1
cmd=$(jq -r '.hooks.SessionStart[0].hooks[0].command' "$C/settings.json")
echo '{"hook_event_name":"SessionStart","session_id":"t1","cwd":"/w/x"}' | CLAUDE_CONFIG_DIR="$C" sh -c "$cmd"
check "installed hook command runs the installed ledger.sh" eval 'cat "$C"/canon/ledger/*.jsonl 2>/dev/null | jq -e "select(.sid == \"t1\")" >/dev/null'
scmd=$(jq -r '.statusLine.command' "$C/settings.json")
out=$(echo '{"session_id":"t1","model":{"id":"m"}}' | CLAUDE_CONFIG_DIR="$C" sh -c "$scmd")
check "installed status line command runs"        test -n "$out" -a -f "$C/canon/sessions/t1.json"
CLAUDE_CONFIG_DIR="$C" bs --check
check "check finds the hooks where they are called" eval 'rowis "$TMP/bs.out" "event ledger hooks" ok && rowis "$TMP/bs.out" "status line" ok'
C2="$TMP/cfg2"; mkdir -p "$C2/canon"; cp "$ROOT/home/.claude/canon/"*.sh "$C2/canon/"; cp "$ROOT/home/.claude/settings.json" "$C2/settings.json"
CLAUDE_CONFIG_DIR="$C2" bs --check
check "check rejects hooks that call another directory" eval 'rowis "$TMP/bs.out" "event ledger hooks" MISSING && rowis "$TMP/bs.out" "status line" MISSING'
CLAUDE_CONFIG_DIR="$TMP/bad\$dir" bs --user-config; rc=$?
check "unquotable config directory refused"       eval '[ "$rc" != 0 ] && [ ! -e "$TMP/bad\$dir" ]'

: > "$STUB/mise.log"
bs --install; rc=$?
# shellcheck disable=SC2034  # read by the eval'd check below
want=$(printf 'eval "$("%s" activate zsh)"' "$B/mise")
check "install writes the mise it used into ~/.zshrc" eval '[ "$rc" = 0 ] && grep -qxF "$want" "$HOME/.zshrc"'
check "install ran mise install with that mise"   grep -q '^mise install' "$STUB/mise.log"

check "install with a claude CLI at the pin runs no installer" eval '[ "$rc" = 0 ] && grep -q "Claude Code CLI $CCPIN (pinned $CCPIN)" "$TMP/bs.out"'

# --install with no claude on PATH: a curl stub serves an installer stub that records its arguments and puts
# a claude in ~/.local/bin that reports $STUB/installed-version, so nothing is downloaded
B3="$TMP/bin-noclaude"; mkdir -p "$B3"
for f in "$B"/*; do [ "${f##*/}" = claude ] || cp "$f" "$B3/"; done
cat > "$B3/curl" <<'EOF'
#!/bin/bash
out=""; url=""
while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift ;; https://*) url="$1" ;; esac; shift; done
echo "curl $url" >> "$STUB/curl.log"
[ -n "$out" ] || exit 1
cat > "$out" <<'INST'
#!/bin/bash
echo "installer $*" >> "$STUB/installer.log"
mkdir -p "$HOME/.local/bin"
printf '#!/bin/bash\ncat "%s/installed-version"\n' "$STUB" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
INST
EOF
chmod +x "$B3/curl"
P3="$B3"; IFS=: read -r -a dirs <<<"$PATH"
for d in "${dirs[@]}"; do [ "$d" = "$B" ] || [ -x "$d/claude" ] || P3="$P3:$d"; done
# inst_cli <version the installed CLI reports, or "none"> <version the installer leaves>: run --install
inst_cli() {
  rm -f "$HOME/.local/bin/claude"; : > "$STUB/curl.log"; : > "$STUB/installer.log"
  if [ "$1" != none ]; then
    mkdir -p "$HOME/.local/bin"
    printf '#!/bin/bash\necho "%s (Claude Code)"\n' "$1" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
  fi
  echo "$2 (Claude Code)" > "$STUB/installed-version"
  PATH="$P3" bs --install
}
inst_cli none "$CCPIN"; rc=$?
check "install with no CLI fetches the Claude Code installer" eval '[ "$rc" = 0 ] && grep -qxF "curl https://claude.ai/install.sh" "$STUB/curl.log"'
check "... and runs it for the registry's claude-code pin" grep -qxF "installer $CCPIN" "$STUB/installer.log"
inst_cli 0.0.1 "$CCPIN"; rc=$?
check "install with a CLI below the pin runs the installer for the pin" eval '[ "$rc" = 0 ] && grep -qxF "installer $CCPIN" "$STUB/installer.log"'
inst_cli 0.0.1 0.0.1; rc=$?
check "install that leaves the CLI below the pin: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "Claude Code CLI is 0.0.1, still below the pin $CCPIN" "$TMP/bs.out"'
inst_cli none "dev build"; rc=$?
check "install that leaves an unreadable version: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "cannot read a version from the Claude Code CLI" "$TMP/bs.out"'
inst_cli 9999.0.0 0.0.1; rc=$?
check "install with a CLI above the pin runs no installer" eval '[ "$rc" = 0 ] && [ ! -s "$STUB/installer.log" ]'
rm -f "$HOME/.local/bin/claude"

echo "test-lanes: $pass passed, $fail failed, $skipped skipped"
[ "$fail" -eq 0 ]
