      eval 'rowis "$TMP/bs.out" "model allowlist" MISMATCH && grep -q "admits claude-fable-5-1" "$TMP/bs.out" && [ "$rc" != 0 ]'
pin_settings '.modelPicker = {"options": [{"model": "claude-fable-5-2", "label": "Lead"}]}'; rc=$?
check "a picker the owner relabelled: OWNER, exit 0" eval 'rowis "$TMP/bs.out" "picker rows" OWNER && [ "$rc" = 0 ]'
pin_settings '.model = "fable"'; rc=$?
