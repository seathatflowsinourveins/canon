      jqt "$HOME/.claude/settings.json" '.env.OTEL_LOGS_EXPORTER == "otlp" and (.env | has("ANTHROPIC_DEFAULT_FABLE_MODEL") | not)'
rm -rf "$HOME/.claude"
# a settings.json that is canon's previous render: after the merge it is canon's file byte for byte
mkdir -p "$HOME/.claude"
jq '.env |= with_entries(select(.key | test("^(CLAUDE_CODE_ENABLE_TELEMETRY$|OTEL_)") | not))' \
  "$ROOT/home/.claude/settings.json" > "$HOME/.claude/settings.json"
bs --user-config
check "the previous render plus the merge is the new render: no copy to merge by hand" \
      eval 'cmp -s "$HOME/.claude/settings.json" "$ROOT/home/.claude/settings.json" && [ ! -e "$HOME/.claude/settings.json.canon-proposed" ]'
bs --user-config
check "... and a second run finds it unchanged"   grep -q "unchanged  $HOME/.claude/settings.json" "$TMP/bs.out"
rm -rf "$HOME/.claude"
cmd=$(jq -r '.hooks.SessionStart[0].hooks[0].command' "$C/settings.json")
echo '{"hook_event_name":"SessionStart","session_id":"t1","cwd":"/w/x"}' | CLAUDE_CONFIG_DIR="$C" sh -c "$cmd"
check "installed hook command runs the installed ledger.sh" eval 'cat "$C"/canon/ledger/*.jsonl 2>/dev/null | jq -e "select(.sid == \"t1\")" >/dev/null'
scmd=$(jq -r '.statusLine.command' "$C/settings.json")
out=$(echo '{"session_id":"t1","model":{"id":"m"}}' | CLAUDE_CONFIG_DIR="$C" sh -c "$scmd")
check "installed status line command runs"        test -n "$out" -a -f "$C/canon/sessions/t1.json"
CLAUDE_CONFIG_DIR="$C" bs --check
check "check finds the hooks where they are called" eval 'rowis "$TMP/bs.out" "event ledger hooks" ok && rowis "$TMP/bs.out" "status line" ok'
C2="$TMP/cfg2"; mkdir -p "$C2/canon"; cp "$ROOT/home/.claude/canon/"*.sh "$C2/canon/"; cp "$ROOT/home/.claude/settings.json" "$C2/settings.json"
CLAUDE_CONFIG_DIR="$C2" bs --check
check "check rejects hooks that call another directory" eval 'rowis "$TMP/bs.out" "event ledger hooks" MISSING && rowis "$TMP/bs.out" "status line" MISSING'

# model settings (ADR 0005, ADR 0059; https://code.claude.com/docs/en/model-config.md): the template is held
# to canon/models.json, and the installed settings to the template
# shellcheck disable=SC2034  # read by the eval'd checks below
fable_id=$(jq -r '[.lanes[] | select(.lane == "orchestrator") | .model] | .[0]' "$ROOT/canon/models.json")
# shellcheck disable=SC2034
build_alias=$(jq -r '.claude_code.session_default_lane as $l | [.lanes[] | select(.lane == $l) | .alias] | .[0]' "$ROOT/canon/models.json")
check "the template pins no alias (ADR 0059)"     jqt "$ROOT/home/.claude/settings.json" '[.env // {} | keys[] | select(test("^ANTHROPIC_DEFAULT_.+_MODEL$"))] | length == 0'
check "the template's allowlist and picker rows are canon/models.json's, naming the orchestrator lane's ID" \
      eval 'jq -e --slurpfile m "$ROOT/canon/models.json" --arg f "$fable_id" ".availableModels == \$m[0].claude_code.available_models and [.modelPicker.options[].model] == \$m[0].claude_code.picker_rows and (.availableModels | index(\$f)) != null and \$m[0].claude_code.picker_rows == [\$f]" "$ROOT/home/.claude/settings.json" >/dev/null'
check "... the allowlist admits each family alias but fable, so the picker's legacy Fable row is hidden" \
      jqt "$ROOT/home/.claude/settings.json" '(.availableModels | index("fable")) == null and ([.availableModels[] | select(startswith("claude-fable-"))] | length) == 1'
check "the template's default model is the session_default_lane's alias" \
      eval '[ -n "$build_alias" ] && [ "$(jq -r .model "$ROOT/home/.claude/settings.json")" = "$build_alias" ]'
check "the template names the latest channel (ADR 0065)" jqt "$ROOT/home/.claude/settings.json" '.autoUpdatesChannel == "latest"'
CLAUDE_CONFIG_DIR="$C" bs --check
check "installed settings as the template: no alias pinned, model keys ok" \
      eval 'rowis "$TMP/bs.out" "model alias pins" ok && rowis "$TMP/bs.out" "default model" ok && rowis "$TMP/bs.out" "model allowlist" ok && rowis "$TMP/bs.out" "picker rows" ok && rowis "$TMP/bs.out" "update channel" ok'
C3="$TMP/cfg3"; mkdir -p "$C3/canon"; cp "$C/canon/"*.sh "$C3/canon/"; cp "$C/CLAUDE.md" "$C3/"
