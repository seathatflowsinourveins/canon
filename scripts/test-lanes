      eval '[ "$rc" = 0 ] && [ "$(git -C "$FK" rev-parse HEAD)" = "$want" ]'
check "... mise run paper:session --session auto --minutes 25, in the clone, CANON_COMMIT the commit" \
      eval 'ran | grep -qF "mise run paper:session --session auto --minutes 25 |" && ran | grep -qF "| pwd=$(cd "$FK" && pwd) | commit=$want |"'
check "... with PATH exported, which mise's exec() templates need to start a shell" \
      eval 'ran | grep -qE "\| path=/usr/bin:/bin:/usr/sbin:/sbin\$"'
check "... and stamps the firing's start, which status reads to tell a schedule gone silent" \
      jqt "$FD/scheduled-firing.json" '(.at_epoch | type) == "number" and (now - .at_epoch) < 120'
echo 2 > "$OW/tracked"; ocommit second; want=$(git -C "$O" rev-parse main)
mkdir -p "$FK/.venv" "$FK/catalog"; : > "$FK/.venv/kept"; : > "$FK/catalog/bars"; : > "$FK/untracked"; echo local > "$FK/tracked"
# state left in the clone's .git: a hook git would run at checkout and a local branch; neither may act or
# stay in the next firing
printf '#!/bin/sh\necho ran > "%s"\n' "$TMP/hook-ran" > "$FK/.git/hooks/post-checkout"; chmod +x "$FK/.git/hooks/post-checkout"
git -C "$FK" branch -q planted; git -C "$FK" branch -q origin/main; rm -f "$TMP/hook-ran"
fire "$B/mise" "$FK" "$OURL" --session auto; rc=$?
check "the next firing runs the main origin has now"  eval '[ "$rc" = 0 ] && ran | grep -qF "commit=$want" && [ "$(cat "$FK/tracked")" = 2 ]'
