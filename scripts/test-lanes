check "an unwritable settings.json: exit 1, named, not reported added, left as it was" \
      eval '[ "$rc" != 0 ] && ! grep -q "  added  .*settings.json" "$TMP/bs.out" && grep -q "could not write $C4/settings.json" "$TMP/bs.out" && jqt "$C4/settings.json" ".env == {\"MY_VAR\": \"1\"}"'
chmod 644 "$C4/settings.json"
# a per-signal logs endpoint or protocol overrides the general one canon sets, so the logs are not local
jq '.env.OTEL_EXPORTER_OTLP_LOGS_ENDPOINT = "http://collector.example.com:4318/v1/logs"' "$C/settings.json" > "$C4/settings.json"
CLAUDE_CONFIG_DIR="$C4" bs --check
check "a per-signal logs endpoint in the settings: OWNER, saying the logs do not reach the local collector, its value not shown" \
      eval 'rowis "$TMP/bs.out" "telemetry settings" OWNER && grep -q "do not reach the local collector: .*sets OTEL_EXPORTER_OTLP_LOGS_ENDPOINT" "$TMP/bs.out" && ! grep -q "collector.example.com" "$TMP/bs.out"'
cp "$C/settings.json" "$C4/settings.json"
CLAUDE_CONFIG_DIR="$C4" OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/json bs --check
check "... and one in the environment: OWNER, naming it" \
      eval 'rowis "$TMP/bs.out" "telemetry settings" OWNER && grep -q "this environment sets OTEL_EXPORTER_OTLP_LOGS_PROTOCOL" "$TMP/bs.out"'
rm -rf "$HOME/.codex"
# JSON keeps the last of two equal keys, so a second "env" (or any repeated key) drops the first silently;
# two changes that each add one merge without a textual conflict. Every tracked JSON file is held to it.
check "no tracked JSON file repeats a key at any level" \
      eval 'git -C "$ROOT" ls-files -z "*.json" | (cd "$ROOT" && xargs -0 python3 -I -c "import json, sys
def pairs(p):
    ks = [k for k, _ in p]
    d = sorted({k for k in ks if ks.count(k) > 1})
    if d: raise ValueError(\"repeated key: \" + \", \".join(d))
    return dict(p)
bad = 0
for f in sys.argv[1:]:
    try: json.load(open(f), object_pairs_hook=pairs)
    except ValueError as e: print(\"        \" + f + \": \" + str(e)); bad = 1
sys.exit(bad)")'
# a settings.json with no env at all (a render from before either block) gets the telemetry variables
mkdir -p "$HOME/.claude"; jq 'del(.env)' "$ROOT/home/.claude/settings.json" > "$HOME/.claude/settings.json"
