rm -f "$HOME/.codex/config.toml.replaced-"*   # so the copies counted below are this run's
printf 'model = "o3"\n\n[profiles.fast]\nmodel = "x"' > "$CX"   # no newline at the end, as an editor may leave it
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "an existing settings.json gets the missing telemetry variables, keeping its own" \
      jqt "$C3/settings.json" '.model == "mine" and .env.MY_VAR == "1" and .env.CLAUDE_CODE_ENABLE_TELEMETRY == "1" and .env.OTEL_LOGS_EXPORTER == "otlp"'
check "... and the model keys it lacks, the owner's model kept and named (ADR 0059)" \
      eval 'jqt "$C3/settings.json" ".availableModels == $(jq -c .availableModels "$ROOT/home/.claude/settings.json") and .modelPicker == $(jq -c .modelPicker "$ROOT/home/.claude/settings.json") and (.env | has(\"ANTHROPIC_DEFAULT_FABLE_MODEL\") | not)" && grep -q "KEPT .*sets model to another value than home/.claude/settings.json" "$TMP/bs.out"'
check "... leaves a value the owner set, and names it" \
      eval 'jqt "$C3/settings.json" ".env.OTEL_METRICS_EXPORTER == \"otlp\"" && grep -q "sets OTEL_METRICS_EXPORTER to another value" "$TMP/bs.out"'
check "... keeping the previous file beside it" \
      eval 'f=$(find "$C3" -name "settings.json.replaced-*" | awk "NR == 1"); [ -n "$f" ] && jqt "$f" ".env | has(\"OTEL_LOGS_EXPORTER\") | not"'
check "an existing Codex config gets the table appended, its own lines kept" \
      eval 'grep -qxF "model = \"o3\"" "$CX" && grep -qxF "model = \"x\"" "$CX" && grep -qxF "[otel]" "$CX" && [ -n "$(find "$HOME/.codex" -name "config.toml.replaced-*")" ]'
check "... on a line of its own after the last one"  grep -qxF '[profiles.fast]' "$CX"
# Codex's default model and effort (ADR 0059): the key it lacks goes at the top, one it sets is the owner's
check "... the default effort it lacked written at its top, its own model kept and named" \
      eval 'tomlis "$CX" "d[\"model_reasoning_effort\"] == \"max\" and d[\"model\"] == \"o3\" and d[\"profiles\"][\"fast\"][\"model\"] == \"x\"" && grep -q "added      model_reasoning_effort to $CX" "$TMP/bs.out" && grep -q "KEPT       $CX sets model to another value" "$TMP/bs.out"'
check "... with each step's copy of the file kept under its own name" \
      test "$(find "$HOME/.codex" -name "config.toml.replaced-*" | wc -l | tr -d ' ')" = 2
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "a second run adds nothing again"           eval '[ "$(grep -c "^\[otel\]" "$CX")" = 1 ] && grep -q "unchanged  \[otel\]" "$TMP/bs.out" && [ "$(grep -c "^model_reasoning_effort" "$CX")" = 1 ]'
CLAUDE_CONFIG_DIR="$C3" bs --check
check "check names the owner's differing value, without failing on it" \
      eval 'rowis "$TMP/bs.out" "telemetry settings" OWNER && grep -q "sets OTEL_METRICS_EXPORTER to another value" "$TMP/bs.out"'
echo '{"env":[]}' > "$C3/settings.json"; CLAUDE_CONFIG_DIR="$C3" bs --user-config; rc=$?
check "an env that is not an object: named, the run finishes" \
      eval 'grep -q "not a JSON object with an object env" "$TMP/bs.out" && grep -q "New Claude Code sessions" "$TMP/bs.out"'
CXDEF=$(grep -v -e '^#' -e '^$' "$ROOT/home/.codex/defaults.toml")   # canon's defaults, so the otel cases below change nothing else
printf '%s\n[otel]\nexporter = "none"\n' "$CXDEF" > "$CX"; cp "$CX" "$TMP/cx.before"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "a Codex config with its own otel table is left as it is, and named" \
      eval 'cmp -s "$CX" "$TMP/cx.before" && grep -q "sets otel itself; left as the owner set it" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C3" bs --check
check "... and check calls it OWNER"              rowis "$TMP/bs.out" "codex telemetry" OWNER
# Codex's config is read as TOML (claims of a second reader, 2026-11-10): a quoted key is the owner's otel
# table, and an [otel] line inside a multi-line string is no table at all
printf "model = \"o3\"\nmodel_reasoning_effort = \"low\"\n['otel']\nexporter = 'none'\n" > "$CX"; cp "$CX" "$TMP/cx.before"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "a quoted ['otel'] table is the owner's: left as it is, still valid TOML" \
      eval 'cmp -s "$CX" "$TMP/cx.before" && tomlis "$CX" "d[\"otel\"] == {\"exporter\": \"none\"}" && grep -q "sets otel itself" "$TMP/bs.out"'
printf 'instructions = """\nsome text\n[otel]\nmore text\n"""\n' > "$CX"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "an [otel] line inside a multi-line string is not a table: canon's is added, the string kept" \
      eval 'tomlis "$CX" "d[\"otel\"][\"log_sse_deltas\"] is False and \"[otel]\" in d[\"instructions\"]" && grep -q "added      \[otel\]" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C3" bs --check
check "... and check reads it as canon's"         rowis "$TMP/bs.out" "codex telemetry" ok
awk '{ print } /^\[otel\]$/ { print "environment = \"dev\"" }' "$CX" > "$TMP/cx.extra"; cp "$TMP/cx.extra" "$CX"
CLAUDE_CONFIG_DIR="$C3" bs --check
check "canon's table with a key of the owner's added is still canon's" \
      eval 'tomlis "$CX" "d[\"otel\"][\"environment\"] == \"dev\"" && rowis "$TMP/bs.out" "codex telemetry" ok'
printf 'model = \n' > "$CX"; cp "$CX" "$TMP/cx.before"
CLAUDE_CONFIG_DIR="$C3" bs --user-config
check "a Codex config that is not TOML is left as it is, and named" \
      eval 'cmp -s "$CX" "$TMP/cx.before" && grep -q "INVALID    $CX is not valid TOML" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C3" bs --check
check "... and check calls it INVALID"            rowis "$TMP/bs.out" "codex telemetry" INVALID
NP="$TMP/no-tomllib"; mkdir -p "$NP"; printf '#!/bin/sh\nexit 1\n' > "$NP/python3"; chmod +x "$NP/python3"
if [ -n "$TOOL_MISE" ]; then
  check "a caller whose first python3 has no tomllib still gets the toolchain's: the run does not depend on it" \
        eval 'p=$(HOME="$CALLER_HOME" PATH="$NP:$CALLER_PATH" toml_python) && [ "$p" != "$NP/python3" ] && has_tomllib "$p"'
  # the PATH fallback branch on its own: with mise out of the way that first python3 is the only candidate,
  # and it must be rejected rather than selected and left to fail two thousand lines later
  check "... and with mise out of the way, a first python3 without tomllib is rejected, not selected" \
        eval '! (TOOL_MISE= HOME="$CALLER_HOME" PATH="$NP:$CALLER_PATH" toml_python)'
else
  skip "a caller whose first python3 has no tomllib still gets the toolchain's" "no mise here to find it through"
