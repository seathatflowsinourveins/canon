mkdir -p "$(dirname "$AS")"; CLAUDE_CONFIG_DIR="$C" bs --user-config
check "an Antigravity folder with no settings: a file holding only the model, readable by its owner alone" \
      eval 'jqt "$AS" ". == {\"model\": \"$agy_label\"}" && [ "$(ls -l "$AS" | cut -c1-10)" = "-rw-------" ]'
echo '{"trustedWorkspaces": ["/w"]}' > "$AS"; CLAUDE_CONFIG_DIR="$C" bs --user-config
check "settings with no model: the model added, the rest kept, a copy beside it" \
      eval 'jqt "$AS" ".model == \"$agy_label\" and .trustedWorkspaces == [\"/w\"]" && [ -n "$(find "$(dirname "$AS")" -name "settings.json.replaced-*")" ]'
CLAUDE_CONFIG_DIR="$C" bs --check
check "... and check calls it ok"                   rowis "$TMP/bs.out" "agy default model" ok
echo '{"model": "Gemini 3.8 Flash (High)"}' > "$AS"; cp "$AS" "$TMP/as.before"; CLAUDE_CONFIG_DIR="$C" bs --user-config
check "a model the owner chose is left as it is, and named" \
      eval 'cmp -s "$AS" "$TMP/as.before" && grep -q "KEPT       $AS sets model to Gemini 3.8 Flash (High)" "$TMP/bs.out"'
CLAUDE_CONFIG_DIR="$C" bs --check
check "... and check calls it OWNER"                rowis "$TMP/bs.out" "agy default model" OWNER
echo '[]' > "$AS"; CLAUDE_CONFIG_DIR="$C" bs --user-config
check "settings that are not a JSON object: INVALID, left as they are" eval 'jqt "$AS" ". == []" && grep -q "INVALID    $AS" "$TMP/bs.out"'
rm -rf "$HOME/.gemini"
jq 'del(.runtimes)' "$TMP/models.keep" > "$BS/canon/models.json"; mkdir -p "$(dirname "$AS")"; rm -f "$C/CLAUDE.md"
CLAUDE_CONFIG_DIR="$C" bs --user-config; rc=$?
check "no Antigravity label in canon/models.json: UNKNOWN, CLAUDE.md still installed, the run fails" \
      eval 'grep -q "UNKNOWN    canon/models.json gives no label for antigravity" "$TMP/bs.out" && [ -f "$C/CLAUDE.md" ] && [ ! -e "$AS" ] && [ "$rc" != 0 ]'
cp "$TMP/models.keep" "$BS/canon/models.json"; rm -rf "$HOME/.gemini"
# codex defaults: an active profile that sets the model overrides the top level, so check names it
mkdir -p "$HOME/.codex"
printf '%s\nprofile = "fast"\n\n[profiles.fast]\nmodel = "o3"\n' "$CXDEF" > "$CX"
CLAUDE_CONFIG_DIR="$C" bs --check
check "codex defaults with an active profile setting another model: OWNER, naming the profile" \
      eval 'rowis "$TMP/bs.out" "codex defaults" OWNER && grep -q "active profile fast" "$TMP/bs.out"'
printf '%s\n' "$CXDEF" > "$CX"; CLAUDE_CONFIG_DIR="$C" bs --check
check "codex defaults as home/.codex/defaults.toml: ok" rowis "$TMP/bs.out" "codex defaults" ok
: > "$CX"; CLAUDE_CONFIG_DIR="$C" bs --check
check "an empty Codex config: NOT SET, naming the fix" eval 'rowis "$TMP/bs.out" "codex defaults" "NOT SET" && grep -q "lacks model, model_reasoning_effort" "$TMP/bs.out"'
if [ "$(id -u)" = 0 ]; then skip "an unreadable Codex config" "root reads a file whatever its mode"
else
  printf '%s\n' "$CXDEF" > "$CX"; chmod 000 "$CX"; CLAUDE_CONFIG_DIR="$C" bs --check; chmod 644 "$CX"
  check "an unreadable Codex config: UNKNOWN, saying it cannot be read, not called invalid TOML" \
        eval 'rowis "$TMP/bs.out" "codex defaults" UNKNOWN && grep -q "config.toml cannot be read" "$TMP/bs.out"'
fi
check "home/.codex/defaults.toml holds what canon/models.json gives Codex" \
      eval 'tomlis "$ROOT/home/.codex/defaults.toml" "d == {\"model\": \"$(jq -r ".runtimes[] | select(.runtime == \"codex\") | .model" "$ROOT/canon/models.json")\", \"model_reasoning_effort\": \"$(jq -r ".runtimes[] | select(.runtime == \"codex\") | .effort" "$ROOT/canon/models.json")\"}"'
rm -rf "$HOME/.codex"
CLAUDE_CONFIG_DIR="$TMP/bad\$dir" bs --user-config; rc=$?
check "unquotable config directory refused"       eval '[ "$rc" != 0 ] && [ ! -e "$TMP/bad\$dir" ]'

: > "$STUB/mise.log"
bs --install; rc=$?
# shellcheck disable=SC2034  # read by the eval'd check below
want=$(printf 'eval "$("%s" activate zsh)"' "$B/mise")
check "install writes the mise it used into ~/.zshrc" eval '[ "$rc" = 0 ] && grep -qxF "$want" "$HOME/.zshrc"'
check "install ran mise install with that mise"   grep -q '^mise install' "$STUB/mise.log"

check "install with a claude CLI at the pin runs no installer" eval '[ "$rc" = 0 ] && grep -q "Claude Code CLI $CCPIN (pinned $CCPIN)" "$TMP/bs.out"'
check "install writes no line turning Antigravity's self-updater off (ADR 0059)" eval '! grep -q AGY_CLI_DISABLE_AUTO_UPDATE "$HOME/.zshrc"'
# canon's earlier pair, written by the ADR 0045 --install, comes out; an owner's line of the same name stays
cp "$HOME/.zshrc" "$TMP/zshrc.keep"
{ cat "$TMP/zshrc.keep"; echo ''; echo '# Antigravity CLI: background self-updater off, so agy stays at its pin (docs/adr/0045)'
  echo 'export AGY_CLI_DISABLE_AUTO_UPDATE=true'; echo 'alias ll="ls -l"'; } > "$HOME/.zshrc"
bs --check
check "check with canon's earlier agy line: OFF, naming the fix" eval 'rowis "$TMP/bs.out" "agy self-updater" OFF && grep -q "run scripts/bootstrap --install" "$TMP/bs.out"'
bs --install; rc=$?
check "install removes canon's agy pair and the blank line before it, keeping every other line" \
      eval '[ "$rc" = 0 ] && [ "$(cat "$HOME/.zshrc")" = "$(cat "$TMP/zshrc.keep"; echo '"'"'alias ll="ls -l"'"'"')" ] && grep -q "removed    canon'"'"'s AGY_CLI_DISABLE_AUTO_UPDATE=true" "$TMP/bs.out"'
check "... keeping a copy of the previous ~/.zshrc"  eval 'f=$(find "$HOME" -maxdepth 1 -name ".zshrc.replaced-*" | awk "NR == 1"); [ -n "$f" ] && grep -q AGY_CLI_DISABLE_AUTO_UPDATE "$f"'
echo 'export AGY_CLI_DISABLE_AUTO_UPDATE=true' >> "$HOME/.zshrc"; cp "$HOME/.zshrc" "$TMP/zshrc.owner"
bs --install
check "an owner's own AGY_CLI_DISABLE_AUTO_UPDATE line is left alone, and named" \
      eval 'cmp -s "$HOME/.zshrc" "$TMP/zshrc.owner" && grep -q "KEPT       .*names AGY_CLI_DISABLE_AUTO_UPDATE in a line that is not canon" "$TMP/bs.out"'
bs --check
check "... and check calls it OWNER"                rowis "$TMP/bs.out" "agy self-updater" OWNER
cp "$TMP/zshrc.keep" "$HOME/.zshrc"; rm -f "$HOME/.zshrc.replaced-"*

# --install with no claude on PATH: a curl stub serves an installer stub that records its arguments and puts
# a claude in ~/.local/bin that reports $STUB/installed-version, so nothing is downloaded
B3="$TMP/bin-noclaude"; mkdir -p "$B3"
for f in "$B"/*; do [ "${f##*/}" = claude ] || cp "$f" "$B3/"; done
cat > "$B3/curl" <<'EOF'
#!/bin/bash
out=""; url=""
while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift ;; https://*) url="$1" ;; esac; shift; done
echo "curl $url" >> "$STUB/curl.log"
[ -n "$out" ] || exit 1
cat > "$out" <<'INST'
#!/bin/bash
echo "installer $*" >> "$STUB/installer.log"
mkdir -p "$HOME/.local/bin"
printf '#!/bin/bash\ncat "%s/installed-version"\n' "$STUB" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
INST
EOF
chmod +x "$B3/curl"
P3="$B3"; IFS=: read -r -a dirs <<<"$PATH"
for d in "${dirs[@]}"; do [ "$d" = "$B" ] || [ -x "$d/claude" ] || P3="$P3:$d"; done
# inst_cli <version the installed CLI reports, or "none"> <version the installer leaves>: run --install
inst_cli() {
  rm -f "$HOME/.local/bin/claude"; : > "$STUB/curl.log"; : > "$STUB/installer.log"
  if [ "$1" != none ]; then
    mkdir -p "$HOME/.local/bin"
    printf '#!/bin/bash\necho "%s (Claude Code)"\n' "$1" > "$HOME/.local/bin/claude"; chmod +x "$HOME/.local/bin/claude"
  fi
  echo "$2 (Claude Code)" > "$STUB/installed-version"
  PATH="$P3" bs --install
}
inst_cli none "$CCPIN"; rc=$?
check "install with no CLI fetches the Claude Code installer" eval '[ "$rc" = 0 ] && grep -qxF "curl https://claude.ai/install.sh" "$STUB/curl.log"'
check "... and runs it for the registry's claude-code pin" grep -qxF "installer $CCPIN" "$STUB/installer.log"
inst_cli 0.0.1 "$CCPIN"; rc=$?
check "install with a CLI below the pin runs the installer for the pin" eval '[ "$rc" = 0 ] && grep -qxF "installer $CCPIN" "$STUB/installer.log"'
inst_cli 0.0.1 0.0.1; rc=$?
check "install that leaves the CLI below the pin: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "Claude Code CLI is 0.0.1, still below the pin $CCPIN" "$TMP/bs.out"'
inst_cli none "dev build"; rc=$?
check "install that leaves an unreadable version: exit 1, saying so" \
      eval '[ "$rc" != 0 ] && grep -q "cannot read a version from the Claude Code CLI" "$TMP/bs.out"'
inst_cli 9999.0.0 0.0.1; rc=$?
check "install with a CLI above the pin runs no installer" eval '[ "$rc" = 0 ] && [ ! -s "$STUB/installer.log" ]'
rm -f "$HOME/.local/bin/claude"

check "this clone's own git config is as the run found it (core.hooksPath, the github.com credential helper)" \
      eval '[ "$(real_git core.hooksPath)" = "$REAL_HOOKS" ] && [ "$(real_git credential.https://github.com.helper)" = "$REAL_HELPER" ]'
echo "test-lanes: $pass passed, $fail failed, $skipped skipped"
# A skipped case checked nothing (GitHub's Ubuntu runner has no lockf(1), plutil or launchd, so the runner, the
# paper lock's deadline and the install rehearsal run only on a Mac; ADR 0050): said last, and on GitHub as a
# warning annotation (workflow commands, "Setting a warning message"), so a green run does not read as a
# check of them.
if [ "$skipped" -gt 0 ]; then
  echo "test-lanes: NOT CHECKED here (skipped):${skips#;}"
  [ "${GITHUB_ACTIONS:-}" != true ] || echo "::warning title=test-lanes skipped $skipped case(s)::not checked on this runner:${skips#;}"
fi
[ "$fail" -eq 0 ]
