#!/bin/bash
# dsh-profiles — read-only: name every installed DeepSeek Harness profile package the record does not hold.
#
# Contract (AGENTS.md rule 3), read at the pinned source deepseek-harness@ddac96760b6e (dsh-v0.2.2-rc.2):
#   packages/boot/app-boot/README.md
#     L52  "A profile lives at `$DSH_HOME/profiles/<name>`" — one folder under profiles/ is one profile.
#     L58  `compatibility.json` maps exact `package-name@version` keys to lists of exact DSH runtime
#          versions, and "A missing file means no exemptions."
#     L142 runtime resolution entries live at `$DSH_HOME/profiles/node_modules`, which is not a profile.
#   packages/boot/app-boot/src/profile.ts
#     L165-172 resolveProfileDir refuses '', '.', '..', node_modules and a name with / or \ as a
#          profile name, and accepts any other, one starting with a dot among them.
#   packages/boot/plugin-manager/README.md
#     L54  registry installs use `saveExact: true`, so a recorded spec is exact.
#     L40  "Disabling retains the dependency" — this check reads what each profile's package.json
#          declares installed, not the `dsh.profile.bundles` selection. A disabled bundle still holds
#          its dependency, so its row is judged by what is installed. That is this check's limit: a
#          selection change alone cannot make a row ok.
#
# Read-only: it opens only the record, each profile's package.json and its compatibility.json when
# present. Nothing else under DSH_HOME is opened (no sessions/, storages/, .credentials.yaml or log, and
# not ~/.dsh-tui). It runs no dsh, dsh-tui, pnpm, npm, node, curl or git, and writes no file.
#
# Usage: scripts/dsh-profiles [--record <file>]
#   --record <file>  the record to compare against; the default is home/dsh/profiles.json in the
#                    repository this script sits in. Only its .profiles object is read:
#                    profile name -> package name -> exact spec.
#
# Rows, one per profile in name order (the recorded profiles and every folder under
# ${DSH_HOME:-$HOME/.dsh}/profiles/ that holds a package.json and whose name dsh accepts as a profile's:
# a dot-folder is one, node_modules is not; profile.ts L165-172), in the format of scripts/bootstrap's row:
#   ok          N packages as recorded
#   DIFFERS     the differences in package-name order, separated by '; ':
#                 NOT RECORDED <name> <spec>       a dependency the record lacks
#                 <name> <spec>, recorded <spec>   a dependency with another spec
#                 MISSING <name>                   a recorded package the profile lacks
#                 EXEMPTION <key>                  a compatibility.json key
#                 EXEMPTION file unreadable        a compatibility.json that is not one JSON object
#   UNRECORDED  N packages, in no record
#   UNKNOWN     <package.json>: not JSON ...     a package.json the check cannot read: not JSON, not one
#                                                JSON value, not a JSON object, or a dependencies field
#                                                that is not an object of strings; or one it read but
#                                                cannot be compared with the record
#   absent      <folder>: no package.json        a recorded profile with no profile folder
# and, after them, one row "dsh profiles UNKNOWN" counting the folders whose name holds a control
# character, which are not read.
#
# Exit status: 0 when every row is ok or absent; 1 otherwise; 2 for a usage error or a record that
# cannot be read.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd -P) || {
  printf 'dsh-profiles: cannot find the repository this script sits in\n' >&2
  exit 2
}
# Assembled from a name so neither new script holds an absolute-home-path literal (scripts/test-dsh-profiles, P7).
repo_home=home
RECORD="$ROOT/$repo_home/dsh/profiles.json"

usage() {
  printf 'dsh-profiles: usage: scripts/dsh-profiles [--record <file>]\n' >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --record)
      [ "$#" -ge 2 ] || usage
      RECORD=$2
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

if [ -z "${DSH_HOME:-}" ] && [ -z "${HOME:-}" ]; then
  printf 'dsh-profiles: neither DSH_HOME nor HOME is set; no profile folder can be read\n' >&2
  exit 2
fi
profiles_dir="${DSH_HOME:-$HOME/.dsh}/profiles"

row() { printf '  %-24s %-9s %s\n' "$1" "$2" "$3"; }

# The record is usable only as .profiles: an object of profiles, each an object of exact string specs.
# A profile name must be one dsh accepts (deepseek-harness packages/boot/app-boot/src/profile.ts
# L165-172 refuses '', '.', '..', node_modules and a name with / or \), so none reaches outside
# profiles/; and it holds no control character, since names are handled one per line and printed.
record=$(jq -c -e '
  def string_map: type == "object" and all(.[]; type == "string");
  def profile_name: . != "." and . != ".." and . != "node_modules" and test("^[^/\\\\]+$")
    and (explode | all(.[]; . > 31 and . != 127));
  if type == "object"
     and (.profiles | type) == "object"
     and (.profiles | all(.[]; string_map))
     and (.profiles | keys | all(.[]; profile_name))
  then .profiles
  else error("not a usable record")
  end
' "$RECORD" 2>/dev/null) || {
  printf 'dsh-profiles: cannot read record: %s\n' "$RECORD" >&2
  exit 2
}
recorded_names=$(printf '%s' "$record" | jq -r 'keys[]')

# Every folder directly under profiles/ that holds a package.json and has a name dsh accepts as a
# profile's (profile.ts L165-172): one starting with a dot is, node_modules is not, since dsh keeps
# runtime resolution entries there (app-boot README L142). A folder whose name holds a control character
# cannot be handled one per line or printed, so it is counted, and the count is a row of its own.
found_names=""
unprintable=0
if [ -d "$profiles_dir" ]; then
  shopt -s dotglob   # bash 3.2 and later still never match . or .. with *
  for folder in "$profiles_dir"/*/; do
    [ -d "$folder" ] || continue
    [ -e "${folder}package.json" ] || continue
    found_name=${folder%/}
    found_name=${found_name##*/}
    case $found_name in
      . | .. | node_modules | *\\*) continue ;;
      *[[:cntrl:]]*) unprintable=$((unprintable + 1)); continue ;;
    esac
    found_names="$found_names$found_name"$'\n'
  done
  shopt -u dotglob
fi

names=$(printf '%s\n%s' "$recorded_names" "$found_names" | LC_ALL=C sort -u)

status_bad=0
while IFS= read -r name; do
  [ -n "$name" ] || continue
  folder="$profiles_dir/$name"
  manifest="$folder/package.json"

  is_recorded=0
  if grep -Fxq -e "$name" <<< "$recorded_names"; then
    is_recorded=1
  fi

  if [ ! -e "$manifest" ]; then
    # A recorded profile whose folder is not a profile: absent, and that alone does not fail the run.
    if [ "$is_recorded" -eq 1 ]; then
      row "dsh profile $name" absent "$folder: no package.json"
    fi
    continue
  fi

  # Read whole: a file holding no JSON value or several is no manifest, whichever value a reader took.
  manifest_values=$(jq -c -s '.' "$manifest" 2>/dev/null) || {
    row "dsh profile $name" UNKNOWN "$manifest: not JSON"
    status_bad=1
    continue
  }
  manifest_json=$(jq -c 'if length == 1 then .[0] else error("not one value") end' \
    <<< "$manifest_values" 2>/dev/null) || {
    row "dsh profile $name" UNKNOWN "$manifest: not one JSON value"
    status_bad=1
    continue
  }
  if ! jq -e 'type == "object"' <<< "$manifest_json" >/dev/null 2>&1; then
    row "dsh profile $name" UNKNOWN "$manifest: not a JSON object"
    status_bad=1
    continue
  fi
  if ! jq -e '
        if .dependencies == null then true
        elif (.dependencies | type) != "object" then false
        else (.dependencies | all(.[]; type == "string")) end
      ' <<< "$manifest_json" >/dev/null 2>&1; then
    row "dsh profile $name" UNKNOWN "$manifest: dependencies is not an object of strings"
    status_bad=1
    continue
  fi
  dep_count=$(jq -r '(.dependencies // {}) | length' <<< "$manifest_json")

  if [ "$is_recorded" -eq 0 ]; then
    row "dsh profile $name" UNRECORDED "$dep_count packages, in no record"
    status_bad=1
    continue
  fi

  # The recorded specs for this profile; the validated record guarantees they are strings.
  # shellcheck disable=SC2016  # a jq program, not shell
  record_profile=$(printf '%s' "$record" | jq -c --arg name "$name" '.[$name]')

  # compatibility.json: exact `package-name@version` keys granting exemptions (app-boot README L56).
  # {} or no file says nothing; anything but one JSON object reads "EXEMPTION file unreadable".
  compatibility="$folder/compatibility.json"
  exemptions='{}'
  exemptions_unreadable=0
  if [ -e "$compatibility" ]; then
    if compatibility_json=$(jq -c -s \
         'if length == 1 and (.[0] | type) == "object" then .[0] else error("not one object") end' \
         "$compatibility" 2>/dev/null); then
      exemptions=$compatibility_json
    else
      exemptions_unreadable=1
    fi
  fi

  # A comparison that fails is UNKNOWN: an empty result would read as ok.
  # shellcheck disable=SC2016  # a jq program, not shell
  if ! detail=$(jq -r -n \
    --argjson manifest "$manifest_json" \
    --argjson recorded "$record_profile" \
    --argjson exemptions "$exemptions" '
      ($manifest.dependencies // {}) as $have
      | $recorded as $want
      | [
          ($have | to_entries[] | .key as $package | .value as $spec
            | if ($want | has($package) | not)
              then {sort: $package, text: "NOT RECORDED \($package) \($spec)"}
              elif $want[$package] != $spec
              then {sort: $package, text: "\($package) \($spec), recorded \($want[$package])"}
              else empty end),
          ($want | to_entries[] | .key as $package
            | select($have | has($package) | not)
            | {sort: $package, text: "MISSING \($package)"}),
          ($exemptions | to_entries[] | {sort: .key, text: "EXEMPTION \(.key)"})
        ]
      | sort_by([.sort, .text])
      | map(.text)
      | join("; ")
    ' 2>/dev/null); then
    row "dsh profile $name" UNKNOWN "$manifest: cannot be compared with the record"
    status_bad=1
    continue
  fi

  if [ "$exemptions_unreadable" -eq 1 ]; then
    if [ -n "$detail" ]; then
      detail="$detail; EXEMPTION file unreadable"
    else
      detail="EXEMPTION file unreadable"
    fi
  fi

  if [ -n "$detail" ]; then
    row "dsh profile $name" DIFFERS "$detail"
    status_bad=1
  else
    row "dsh profile $name" ok "$dep_count packages as recorded"
  fi
done <<< "$names"

if [ "$unprintable" -gt 0 ]; then
  row "dsh profiles" UNKNOWN "folders in $profiles_dir whose name holds a control character, not read: $unprintable"
  status_bad=1
fi

exit "$status_bad"
