#!/bin/bash
# automation — install, inspect and remove this repo's standing automation (docs/adr/0011-automation.md).
#
#   Layer                  Runs                              Mechanism (contract)
#   commit gate            on every `git commit`             .githooks/pre-commit via core.hooksPath (githooks(5))
#   landscape watch        once a day, at session start      .claude/hooks/canon-watch.sh, async SessionStart hook
#   lane watchdog          every 10 minutes, Mac awake       launchd user agent (launchd.plist(5), launchctl(1))
#   paper session          70 s after each firing, awake     launchd user agent running one window, if Alpaca's
#                                                            clock says a session is open and main's
#                                                            canon/paper-schedule says to (ADR 0050)
#   movers recorder        weekdays 04:00-20:00 New York     launchd user agent: back-to-back data-only
#                                                            movers-screener runs, at most 80 polls each
#   OTLP collector         always, Mac awake                 launchd user agent running the pinned otelcol on
#                                                            127.0.0.1, writing ~/.claude/canon/otel/logs.jsonl
#                                                            for scripts/lanes --rates (ADR 0007)
#   weekly refresh         weekly, desktop app open          Claude desktop scheduled task (created from a session)
#   maintenance            every 30 minutes, Mac awake       launchd user agent: this clone to origin/main by
#                                                            fast-forward, then the installers for what differs
#                                                            from main, and the runtimes' updates once a day
#                                                            (home/.claude/canon/maintenance.sh, ADR 0065)
#   OmniRoute gateway      always, Mac awake, once OmniRoute  launchd user agent running mise.gateway.toml's
#                          is installed                      omniroute:serve in this clone (ADR 0056)
#   nightly study          every 30 minutes, Mac awake       launchd user agent running mise.toml's study:nightly
#                                                            in this clone: the latest recorded night studied
#                                                            once, nothing when there is none (ADR 0089)
#
# Usage: scripts/automation status | install [--defer-paper] | uninstall | differs | mark-user-config
# `install --defer-paper` installs everything but the paper session's runner, plist and clone, and leaves its
# agent loaded as it is: the maintenance agent's round while a window runs from them, which defers that part
# to the session boundary (home/.claude/canon/maintenance.sh, ADR 0065).
# `install` uses no sudo and touches: this clone's git config, ~/.claude/canon/ (the paper session's
# runner and its clone of origin's main, ~/.claude/canon/paper-checkout, the recorder's runner and main clone,
# ~/.claude/canon/movers-checkout, the maintenance script and the collector's config included), and six files
# in ~/Library/LaunchAgents/, seven once OmniRoute is installed. It reloads the maintenance and gateway agents only when a plist changed or
# the job is not loaded, so a reinstall the maintenance agent starts does not stop that agent's own job (a new
# script reaches its next round, which runs the file anew), and the gateway is not restarted for nothing.
# `differs` changes nothing: it prints one line per thing an installer manages that differs from this tree,
# `automation: <what>` (scripts/automation install), `user-config: <what>` (scripts/bootstrap --user-config)
# or `unknown: <why>` for what it could not compare, and exits 0 when nothing differs, 1 when something does,
# 2 when something could not be compared. --user-config never overwrites settings.json (scripts/bootstrap), so
# its part is the three scripts it installs and a checksum of the sources it reads (home/.claude but its canon/
# folder, home/.codex, canon/models.json and scripts/bootstrap), against the one `mark-user-config` recorded
# after the last run the maintenance agent made. The collector is
# the otelcol mise installed for this clone (`scripts/bootstrap --install`), named by its absolute path. The watchdog's plist sets CLAUDE_CONFIG_DIR to the directory install used.
# `uninstall` reverses exactly that, the trust `mise run` gave the clone's mise.toml included, leaves the
# ledger, the alert history, the windows' records and the collector's logs.jsonl alone, and exits non-zero naming anything it could not
# remove.
# `status` exits non-zero when any row is not ok, including rows it could not check (UNKNOWN).
#
# Overrides: CLAUDE_CONFIG_DIR replaces ~/.claude; CANON_LAUNCHAGENTS_DIR replaces ~/Library/LaunchAgents
# and CANON_PAPER_SESSION_DIR the session windows' record folder, CANON_UNLOAD_SECS the wait for a job to
# leave launchd (default 30), CANON_LAUNCHCTL_SECS the bound on each launchctl call (default 30) and
# CANON_LOCKF lockf(1) (tests only); AUTOMATION_SKIP_LAUNCHD=1 is a rehearsal of `install` that does every step except the
# launchctl calls. mise is the one on PATH, else ~/.local/bin/mise; its absolute path goes into the git
# credential helper.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CANON_HOME="$CLAUDE_HOME/canon"
LABEL="local.canon.lanes-watch"
AGENTS_DIR="${CANON_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"   # override only for tests
PLIST="$AGENTS_DIR/$LABEL.plist"
DOMAIN="gui/$(id -u)"
INTERVAL=600
TASK_ID="canon-landscape-refresh"
PAPER_LABEL="local.canon.paper-session"
PAPER_PLIST="$AGENTS_DIR/$PAPER_LABEL.plist"
# launchd counts StartInterval from the end of the last firing, not its start (observed on macOS 27.2: a 20 s
# interval and a 15 s job started every 35 s, with ProcessType Background and Standard alike), so the interval
# is the pause after each firing: above the 60 s gap (session_window.GAP_SECS), so the firing after a window
# is not skipped, and short, so account B is idle about a minute and a firing's start-up between two windows
# while a session is open (ADR 0050, 2026-11-13; 600 s from 2026-11-11)
PAPER_INTERVAL=70
PAPER_MINUTES=25
PAPER_REGULAR_STRATEGY=Mover                          # the regular session's strategy (ADR 0091); no other part names one
PAPER_STALE=4200                                      # a record `running` after 70 minutes, if it gives none
PAPER_DEADLINE=6300                                   # mise.toml's paper:session timeout, 105 minutes
# the longest firing: the runner's fetch bound, then its bound on the whole `mise run`, which is that timeout
# and its allowance for mise's own start (paper-session.sh FETCH_SECS, TASK_SECS, START_SECS)
PAPER_FIRING=$((120 + PAPER_DEADLINE + 300))
# launchd misses every interval while a firing runs (launchd.plist(5)), so the next firing starts at most one
# interval after the longest firing ends; with no stamp for longer, and 300 s more, the schedule has stopped
PAPER_SILENT=$((PAPER_FIRING + PAPER_INTERVAL + 300))
WATCH_SECS=120                                        # lanes-watch.sh's bound on the lanes report it runs
WATCH_NOTIFY_SECS=30                                  # ...and on its notification (NOTIFY_SECS)
# the watchdog stamps each check as it starts; the next starts at most an interval after the longest ends
# (each bound with the 5 s timeout -k gives a command that ignores SIGTERM)
WATCH_SILENT=$((WATCH_SECS + 5 + WATCH_NOTIFY_SECS + 5 + INTERVAL + 300))
PAPER_CHECKOUT="$CANON_HOME/paper-checkout"           # the clone each firing brings to origin's main
# the windows' records: in the per-user temporary folder (getconf(1)), or empty when getconf gives none, which
# the paper row then says rather than read a relative folder (CANON_GETCONF replaces getconf: tests only)
PAPER_TMP=$("${CANON_GETCONF:-/usr/bin/getconf}" DARWIN_USER_TEMP_DIR 2>/dev/null) || PAPER_TMP=""
case "$PAPER_TMP" in /*/) ;; *) PAPER_TMP="" ;; esac
PAPER_DIR="${CANON_PAPER_SESSION_DIR:-${PAPER_TMP:+${PAPER_TMP}canon-paper-session}}"
STALE_DAYS=2
OTEL_LABEL="local.canon.otel-collector"
OTEL_PLIST="$AGENTS_DIR/$OTEL_LABEL.plist"
OTEL_DIR="$CANON_HOME/otel"                           # config.yaml and the logs.jsonl scripts/lanes reads
MAINT_LABEL="local.canon.maintenance"
MAINT_PLIST="$AGENTS_DIR/$MAINT_LABEL.plist"
MAINT_INTERVAL=1800                                   # every 30 minutes
MAINT_STEP=900                                        # maintenance.sh STEP_SECS: its bound on each installer
# the longest round: the fetch (120), local git (6 x 30), the compare, the settings step, the two daily updates
# and the reinstall it starts, which holds its lock (5 x MAINT_STEP); then an interval and 300 s
# a round at its longest: the fetch (120), ten bounded git and mise calls (30 each, 5 of kill grace), five
# steps (differs, the settings step, two updates, install, each MAINT_STEP and 5), the pins (mise and four
# tools: two mise calls of 30 and one step each), then an interval and 300
MAINT_SILENT=$((120 + 10 * 35 + 5 * (MAINT_STEP + 5) + 5 * (2 * 35 + MAINT_STEP + 5) + MAINT_INTERVAL + 300))
# maintenance.sh BOUNDARY_SECS: its boundary waiter's bound, the longest session and an hour; a paper section
# deferred for longer has outlived a whole session, which the row reads as a fault
MAINT_BOUNDARY=32400
UC_MARK="$CANON_HOME/watch/user-config.applied"        # the sources' checksum at the last --user-config it ran
GW_LABEL="local.canon.omniroute"
GW_PLIST="$AGENTS_DIR/$GW_LABEL.plist"
RECORDER_LABEL="local.canon.movers-recorder"
RECORDER_PLIST="$AGENTS_DIR/$RECORDER_LABEL.plist"
RECORDER_RUNNER="$CANON_HOME/movers-recorder.sh"
RECORDER_HELPER="$CANON_HOME/movers-checkout.sh"
RECORDER_CHECKOUT="$CANON_HOME/movers-checkout"
recorder_lock_path() { printf '%s.recorder.lock\n' "${1:-$RECORDER_CHECKOUT}"; }
RECORDER_STATUS="$CANON_HOME/watch/movers-recorder.json"
RECORDER_INTERVAL=60
RECORDER_FAILURE_BOUND=3                             # UNCALIBRATED; alert/count bound, never a retry latch
RECORDER_LOCK_SECS=${CANON_RECORDER_LOCK_SECS:-60}     # UNCALIBRATED; wait for leftover uv's checkout lock
# paper-session.sh's 300 s mise start (the two keychain reads included), paper:data's 600 s sync,
# session_window.START_UP_SECS (30), and the last poll's 3 x ADAPTER_CALL_SECS (129.2), rounded up.
RECORDER_HEADROOM=$((300 + 600 + 30 + 388))
RECORDER_STOP_ROOM=60                                # staggered cleanup bounds plus launching the command
RECORDER_SILENT=6600                                  # longest outer bound (6093), fetch (120), interval and margin
STUDY_LABEL="local.canon.nightly-study"
STUDY_PLIST="$AGENTS_DIR/$STUDY_LABEL.plist"
STUDY_INTERVAL=1800                                   # every 30 minutes; a firing with no new night does nothing
STUDY_DEADLINE=3600                                   # mise.toml's study:nightly timeout, 60 minutes
# launchd counts the interval from the end of a firing (above), so with no heartbeat for the longest firing,
# an interval and 300 s more, the schedule has stopped
STUDY_SILENT=$((STUDY_DEADLINE + STUDY_INTERVAL + 300))
STUDY_STALE_DAYS=5                                    # a long weekend is four days without a new night
# the study's records: beside the ledger, in the main checkout (canon_trading.ledger.default_ledger_path: the
# folder that holds the clone's common git directory), whichever worktree asks (CANON_NIGHTLY_DIR: tests only)
STUDY_MAIN=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || STUDY_MAIN=""
case "$STUDY_MAIN" in /*) STUDY_MAIN=$(dirname "$STUDY_MAIN") ;; *) STUDY_MAIN="$ROOT" ;; esac
STUDY_DIR="${CANON_NIGHTLY_DIR:-$STUDY_MAIN/ledger/nightly}"
# jq: a commit as status shows it, the first 12 of a full id plus what follows it ("with uncommitted
# changes"), or the text a record gives in its place ("unknown: <why>")
# shellcheck disable=SC2016  # jq program, not shell
PAPER_COMMIT='def short: (. // "not recorded") as $c | if ($c | test("^[0-9a-f]{40}")) then $c[0:12] + $c[40:] else $c end; '

# note: prints a line; one that reports a failure (FAILED: or SKIPPED:) is kept in FAILS too, so install can
# repeat it after the status table, where the owner's eye ends
FAILS=""
note() { printf '%s\n' "$*"; case "$*" in *FAILED:*|*SKIPPED:*) FAILS="$FAILS"$'\n'"$*" ;; esac; }

# lc <launchctl arguments>: launchctl, each call bounded at LAUNCHCTL_SECS by timeout(1) (SIGTERM, then
# SIGKILL 5 s later), so a launchd that does not answer fails the call, exit 124 or 137, instead of holding
# install, uninstall or status (a bound on the wait below bounds no single call in it)
LAUNCHCTL_SECS=${CANON_LAUNCHCTL_SECS:-30}
case "$LAUNCHCTL_SECS" in ''|*[!0-9]*) LAUNCHCTL_SECS=30 ;; esac
# --foreground: launchctl stays in the caller's process group, so a Ctrl-C at install reaches it (timeout(1))
lc() { /usr/bin/timeout --foreground -k 5 "$LAUNCHCTL_SECS" launchctl "$@"; }
# no_answer <rc>: whether lc ended at its bound
no_answer() { [ "$1" = 124 ] || [ "$1" = 137 ]; }
# loaded <label>: 0 when `launchctl print` finds the label, 2 when it did not answer, 1 otherwise
loaded() { local rc=0; lc print "$DOMAIN/$1" >/dev/null 2>&1 || rc=$?; if [ "$rc" = 0 ]; then return 0; elif no_answer "$rc"; then return 2; fi; return 1; }
# unload <label>: `launchctl bootout`, then wait, at most UNLOAD_SECS of elapsed time, until `launchctl print`
# no longer finds the label. bootout returns while a running job is still stopping, and a bootstrap of the
# same label then fails with 5, Input/output error (observed on this Mac with a throwaway label whose job
# takes 4 s to exit on SIGTERM); the kept-alive collector is such a job. Returns 0 when the label is gone; 2,
# with launchctl's message in UNLOAD_ERR, when bootout was refused for a label print still finds; 3 when
# launchctl did not answer within LAUNCHCTL_SECS; 1 when the label is still loaded once the wait is over.
# UNLOAD_ABSENT=1 says there was nothing to unload.
# the lock(1) that tells whether a window still runs from the paper clone (CANON_LOCKF: tests only)
LOCKF=${CANON_LOCKF:-/usr/bin/lockf}
UNLOAD_SECS=${CANON_UNLOAD_SECS:-30}
case "$UNLOAD_SECS" in ''|*[!0-9]*) UNLOAD_SECS=30 ;; esac
UNLOAD_ERR="" UNLOAD_ABSENT=0
unload() {
  local end=$((SECONDS + UNLOAD_SECS)) rc=0 st
  UNLOAD_ABSENT=0
  UNLOAD_ERR=$(lc bootout "$DOMAIN/$1" 2>&1) || rc=$?
  if no_answer "$rc"; then return 3; fi
  if [ "$rc" != 0 ]; then
    loaded "$1"; st=$?
    if [ "$st" = 1 ]; then UNLOAD_ABSENT=1; return 0; fi   # it was not loaded
    [ "$st" != 2 ] || return 3
    UNLOAD_ERR=${UNLOAD_ERR//$'\n'/; }; return 2
  fi
  while :; do
    loaded "$1"; st=$?
    [ "$st" != 1 ] || return 0
    [ "$st" != 2 ] || return 3
    [ "$SECONDS" -lt "$end" ] || return 1
    sleep 0.5
  done
}
# unload_note <label> <rc of unload>: the line a failed unload gets
unload_note() {
  case "$2" in
    2) note "  FAILED: launchctl bootout refused $1: ${UNLOAD_ERR:-no message}; run: scripts/automation install" ;;
    3) note "  FAILED: launchctl did not answer within ${LAUNCHCTL_SECS} s about $1, so the new one was not loaded; run: scripts/automation install" ;;
    *) note "  FAILED: the earlier $1 was still stopping after ${UNLOAD_SECS} s, so the new one was not loaded; run: scripts/automation install" ;;
  esac
}
# boot <label> <plist> <what loaded says>: bootstrap the plist; on a refusal it says plainly what launchd has
# loaded for the label now, and what to run
boot() {
  local rc=0 st
  lc bootstrap "$DOMAIN" "$2" || rc=$?
  if [ "$rc" = 0 ]; then note "  loaded     $1 $3"; return 0; fi
  if no_answer "$rc"; then
    note "  FAILED: launchctl bootstrap of $1 did not answer within ${LAUNCHCTL_SECS} s; whether it is loaded is not known; run: scripts/automation install"; return 1
  fi
  loaded "$1"; st=$?
  if [ "$st" = 0 ]; then
    note "  FAILED: launchctl bootstrap refused $1; launchd still has a job loaded for it, not this install's; run: scripts/automation install"
  elif [ "$st" = 2 ]; then note "  FAILED: launchctl bootstrap refused $1, and launchctl did not answer whether anything is loaded for it; run: scripts/automation install"
  else note "  FAILED: launchctl bootstrap refused $1; nothing is loaded for it now; run: scripts/automation install"; fi
  return 1
}
# load <label> <plist> <what loaded says>: unload any earlier job of the label, then boot the plist
load() {
  local rc
  unload "$1"; rc=$?
  if [ "$rc" != 0 ]; then unload_note "$1" "$rc"; return 1; fi
  boot "$1" "$2" "$3"
}
# what a row says shows no home folder path: the owner pastes this output, so $HOME reads as ~
# (only the home folder itself or a path under it, not a sibling such as $HOME-old; the patterns go through
# variables, as bash 3.2 mishandles a quoted "/" or an escaped ~ inline)
# shellcheck disable=SC2088  # a literal ~ is the point
row() { local m="$3" p1="$HOME/" r1="~/" p3="$HOME " r3="~ "; m=${m//"$p1"/$r1}; m=${m//"$p3"/$r3}; [[ "$m" != *"$HOME" ]] || m="${m%"$HOME"}~"
  printf '  %-18s %-9s %s\n' "$1" "$2" "$m"; }
# check_row <name> <label> <text>: prints the row and counts any label but ok as unhealthy
check_row() { row "$1" "$2" "$3"; [ "$2" = ok ] || bad=1; }
# paper_worse <label>: the paper row's label becomes <label> when that is worse than the one it has ($lab)
# (a refusal exits 1 too, so REFUSED outranks the FAILED that exit code gives)
paper_rank() { case "$1" in ok) echo 0 ;; UNKNOWN) echo 1 ;; OUTDATED) echo 2 ;; STALE) echo 3 ;; REFUSED) echo 5 ;; DIED) echo 6 ;; *) echo 4 ;; esac; }
paper_worse() { [ "$(paper_rank "$1")" -le "$(paper_rank "$lab")" ] || lab=$1; }

# find_mise -> absolute path of mise: the one on PATH first, then ~/.local/bin/mise. Fails with a message
# when there is neither, or when the path holds a character that cannot be quoted in a git helper.
find_mise() {
  local m
  m=$(command -v mise 2>/dev/null) || m=""
  if [ -n "$m" ]; then
    case "$m" in /*) ;; *) m="$(cd "$(dirname "$m")" && pwd)/$(basename "$m")" ;; esac
  elif [ -x "$HOME/.local/bin/mise" ]; then
    m="$HOME/.local/bin/mise"
  else
    echo "mise not found on PATH or at $HOME/.local/bin/mise; run: scripts/bootstrap --install" >&2; return 1
  fi
  case "$m" in *[\"\$\`\\]*) echo "mise path $m holds a quote, \$, backquote or backslash; not supported" >&2; return 1 ;; esac
  printf '%s\n' "$m"
}

# host_path <url>: the URL as a message names it: scheme, user information (RFC 3986 section 3.2.1: before
# an @ in the authority, the part before the first /), query and fragment dropped
host_path() {
  local u=$1 a; [[ "$u" == *://* ]] && u=${u#*://}
  a=${u%%/*}; u=${a##*@}${u#"$a"}; printf '%s' "${u%%[?#]*}"
}

# repo_label <url>: the host and the repository's name, without its owner, which is an account name
# (an SSH remote, host:owner/name, and a trailing / are read too)
repo_label() { local v; v=$(host_path "$1"); v=${v%/}; printf '%s, repository %s' "${v%%[:/]*}" "${v##*[:/]}"; }

xml() { local s=${1//&/\&amp;}; s=${s//</\&lt;}; printf '%s' "${s//>/\&gt;}"; }

# The agent gets CLAUDE_CONFIG_DIR (launchd.plist(5) EnvironmentVariables), so the watchdog and the
# installed lanes read the same directory this install wrote to; they find it the way every script here does.
write_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "${1:-$PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$c/lanes-watch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>$(xml "$CLAUDE_HOME")</string>
  </dict>
  <key>StartInterval</key>
  <integer>$INTERVAL</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$c/watch/lanes-watch.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/lanes-watch.log</string>
</dict>
</plist>
EOF
}

# The session window agent runs ~/.claude/canon/paper-session.sh, which brings its own clone to the main the
# origin has at that firing, or fails the firing, and runs `mise run paper:session --session auto --mover
# --regular-strategy Mover` there, Mover on the day's top mover in the regular part and every extended
# part, overnight included; a part's explicit bridge_reason runs the named SessionMaCross limit bridge
# instead (ADR 0083, ADR 0091). --regular-strategy names the regular part; --mover selects the others:
# the task reads the paper pair from the login keychain, takes the paper lock and runs one window, or prints
# "nothing to run" when Alpaca's clock says no session is open (weekends and holidays included). Not run at
# load. No checkout a person uses is read or written (ADR 0050). CANON_PAPER_SCHEDULED=1 (launchd.plist(5),
# EnvironmentVariables) tells the runner and the window that the schedule started them: only they stamp the
# firing and write the records status reads.
# write_paper_plist <mise> <origin url> [file, else PAPER_PLIST]
write_paper_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "${3:-$PAPER_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$PAPER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$c/paper-session.sh</string>
    <string>$(xml "$1")</string>
    <string>$(xml "$PAPER_CHECKOUT")</string>
    <string>$(xml "$2")</string>
    <string>--session</string>
    <string>auto</string>
    <string>--minutes</string>
    <string>$PAPER_MINUTES</string>
    <string>--mover</string>
    <string>--regular-strategy</string>
    <string>$PAPER_REGULAR_STRATEGY</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CANON_PAPER_SCHEDULED</key>
    <string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$c</string>
  <key>StartInterval</key>
  <integer>$PAPER_INTERVAL</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$c/watch/paper-session.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/paper-session.log</string>
</dict>
</plist>
EOF
}

# launchd.plist(5) StartInterval misses firings while a job runs. A short interval lets the wrapper gate
# every start in America/New_York (including DST), independently of the machine's calendar time zone.
# The wrapper is this script's record-movers command. Its private copy of paper-session.sh's documented
# --checkout-only mode supplies its own origin/main clone, independently of a deferred paper install.
# No new paper:data choice is needed: ADR 0070's
# movers-screener is the existing REST-only recorder (ADR 0070, scheduled-recorder addition of 2026-11-11).
# The checksum makes a runner change reload its job once the running loop has let its lock go.
write_recorder_plist() {
  cat > "${3:-$RECORDER_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$RECORDER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(xml "$RECORDER_RUNNER")</string>
    <string>record-movers</string>
    <string>$(xml "$1")</string>
    <string>$(xml "$RECORDER_CHECKOUT")</string>
    <string>$(xml "$2")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONFIG_DIR</key><string>$(xml "$CLAUDE_HOME")</string>
    <key>CANON_RECORDER_CODE</key><string>$(cksum < "$ROOT/scripts/automation" | awk '{ print $1 "-" $2 }')</string>
  </dict>
  <key>WorkingDirectory</key><string>$(xml "$CANON_HOME")</string>
  <key>StartInterval</key><integer>$RECORDER_INTERVAL</integer>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$(xml "$CANON_HOME/watch/movers-recorder.log")</string>
  <key>StandardErrorPath</key><string>$(xml "$CANON_HOME/watch/movers-recorder.log")</string>
</dict>
</plist>
EOF
}

install_recorder() {
  local rc=0
  # The loop holds this lock before touching its clone, including the gaps between batches. Install
  # holds it through preflight and reload, so neither side can strand a batch during replacement.
  exec 6>>"$(recorder_lock_path)" || { note "  FAILED: could not open the recorder install lock"; return 1; }
  "$LOCKF" -t 0 6 2>/dev/null || rc=$?
  case "$rc" in
    0) install_recorder_files; rc=$? ;;
    75) note "  deferred   movers recorder: a recorder is running; retry at a later maintenance round"; rc=0 ;;
    *) note "  FAILED: could not take the recorder install lock (exit $rc)"; rc=1 ;;
  esac
  exec 6>&-
  return "$rc"
}

# Called only with the recorder's loop lock held; note() stays in the installer shell so failures are
# repeated after its table as for the other jobs. Closing descriptor 6 above releases it on every path.
install_recorder_files() {
  local m url t out
  m=$(find_mise 2>&1) || { note "  FAILED: $m"; return 1; }
  url=$(git -C "$ROOT" remote get-url origin 2>/dev/null) && [ -n "$url" ] \
    || { reject_recorder_origin "no origin remote for the movers recorder"; return 1; }
  # paper-session.sh's origin contract, checked before even a temporary plist can hold a URL with user
  # information, a query or a fragment. The helper still checks and fetches the actual origin below.
  case "$url" in https://*|/*) ;; *) reject_recorder_origin "the recorder origin must be https"; return 1 ;; esac
  if [[ "$url" =~ ^https://[^/?#]*@ ]]; then reject_recorder_origin "the recorder origin carries credentials"; return 1; fi
  case "$url" in *[?#]*) reject_recorder_origin "the recorder origin has a query or fragment"; return 1 ;; esac
  t=$(mktemp "$AGENTS_DIR/.$RECORDER_LABEL.XXXXXX") || { note "  FAILED: could not write $RECORDER_PLIST"; return 1; }
  if ! write_recorder_plist "$m" "$url" "$t" || ! plutil -lint "$t" >/dev/null; then
    rm -f "$t"; note "  FAILED: could not write $RECORDER_PLIST"; return 1
  fi
  if cmp -s "$ROOT/scripts/automation" "$RECORDER_RUNNER" \
     && cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$RECORDER_HELPER" && cmp -s "$t" "$RECORDER_PLIST"; then
    if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = 1 ] || loaded "$RECORDER_LABEL"; then
      rm -f "$t"; note "  kept       $RECORDER_LABEL loaded: its runner, helper and plist are unchanged"; return 0
    fi
  fi
  # Unload before replacing anything the job runs, or refreshing its clone. A refusal leaves all three
  # installed files and the checkout as they were. The loop lock excludes a firing throughout this step.
  stop_recorder || { rm -f "$t"; return 1; }
  /usr/bin/install -m 755 "$ROOT/home/.claude/canon/paper-session.sh" "$RECORDER_HELPER" \
    || { rm -f "$t"; note "  FAILED: could not install $RECORDER_HELPER"; return 1; }
  if ! out=$(/bin/bash "$RECORDER_HELPER" --checkout-only "$m" "$RECORDER_CHECKOUT" "$url" 2>&1); then
    rm -f "$t" "$RECORDER_PLIST"
    note "  FAILED: ${out//$'\n'/; } (recorder not loaded; its plist removed)"; return 1
  fi
  /usr/bin/install -m 755 "$ROOT/scripts/automation" "$RECORDER_RUNNER" \
    || { rm -f "$t"; note "  FAILED: could not install $RECORDER_RUNNER"; return 1; }
  mv -f "$t" "$RECORDER_PLIST" || { rm -f "$t"; note "  FAILED: could not write $RECORDER_PLIST"; return 1; }
  note "  wrote      $RECORDER_PLIST"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = 1 ]; then note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"; return 0; fi
  boot "$RECORDER_LABEL" "$RECORDER_PLIST" "(weekdays 04:00-20:00 America/New_York; first check in $RECORDER_INTERVAL s)"
}

stop_recorder() {
  local rc=0
  [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != 1 ] || return 0
  unload "$RECORDER_LABEL" || rc=$?
  [ "$rc" = 0 ] || { unload_note "$RECORDER_LABEL" "$rc"; return 1; }
}

reject_recorder_origin() {
  stop_recorder || return 1
  rm -f "$RECORDER_PLIST" || { note "  FAILED: could not remove $RECORDER_PLIST"; return 1; }
  note "  FAILED: $1 (recorder not loaded; its plist removed)"
  return 1
}

# record-movers <mise> <checkout> <origin>: the former hand-run screener loop, bounded by New York's
# weekday window. Contracts: date(1) TZ and +formats; lockf(1) descriptor locks; paper-session.sh's
# --recorder-checkout; mise v2026.11.6 run --timeout (docs/cli/run.md), task.run_auto_install and ceiling_paths;
# timeout(1) -k and signal forwarding; mise.toml's bounded() trap/wait cleanup contract. The task retains
# all credential access and ADR 0070's GET-only guard; this wrapper reads
# no credential. A failure ends this firing; the next firing starts fresh. A failed fetch alone can use
# the last good main commit, named in status. CANON_RECORDER_DATE replaces date for offline tests,
# and CANON_LOCKF replaces lockf as above.
do_record_movers() {
  [ "$#" = 3 ] || { echo "usage: automation record-movers <mise> <checkout> <origin>" >&2; return 2; }
  local m=$1 dir=$2 url=$3 date_bin=${CANON_RECORDER_DATE:-/bin/date}
  local epoch=0 weekday day="unknown" hour minute second stamp left polls rc commit="none: nothing ran" t ceiling close_epoch run_budget gap_start
  local failed_firings=0 fetch_note="" out wait_end prepared_commit="" completed_batches=0 prior_failure="" batch_pid=""
  export PATH=/usr/bin:/bin:/usr/sbin:/sbin
  recorder_time() {
    local next_epoch next_weekday next_day next_hour next_minute next_second
    stamp=$(TZ=America/New_York "$date_bin" '+%s %u %Y-%m-%d %H %M %S') || return 1
    read -r next_epoch next_weekday next_day next_hour next_minute next_second <<< "$stamp"
    [[ "$next_epoch" =~ ^[0-9]+$ && "$next_weekday" =~ ^[1-7]$ && "$next_hour" =~ ^[0-2][0-9]$ \
       && "$next_minute" =~ ^[0-5][0-9]$ && "$next_second" =~ ^[0-5][0-9]$ ]] || return 1
    epoch=$next_epoch; weekday=$next_weekday; day=$next_day
    hour=$((10#$next_hour)); minute=$((10#$next_minute)); second=$((10#$next_second))
  }
  recorder_store() {
    mkdir -p "${RECORDER_STATUS%/*}" && t=$(mktemp "$RECORDER_STATUS.XXXXXX") || return 1
    if printf '%s\n' "$1" > "$t" && mv -f "$t" "$RECORDER_STATUS"; then return 0; fi
    rm -f "$t"; return 1
  }
  recorder_write() {
    local message=$3
    local record
    [ -z "$fetch_note" ] || message="$message; $fetch_note"
    if [ "$failed_firings" -ge "$RECORDER_FAILURE_BOUND" ]; then
      message="consecutive_failed_firings_bound (UNCALIBRATED): at least $RECORDER_FAILURE_BOUND; $message"
    fi
    record=$(jq -n --argjson e "$epoch" --arg d "$day" --arg o "$1" --argjson r "$2" --arg n "$message" --arg c "$commit" \
         --argjson f "$failed_firings" --argjson b "$RECORDER_FAILURE_BOUND" \
         '{at_epoch: $e, day: $d, outcome: $o, exit_code: $r, note: $n, commit: $c,
           consecutive_failed_firings: $f, failure_bound: $b}') || return 1
    recorder_store "$record"
  }
  recorder_fail() {
    local message="$2; firing ended; next firing retries"
    echo "movers-recorder: $message" >&2
    if ! recorder_time; then
      # jq's documented now gives a fresh epoch even when date cannot supply New York fields.
      epoch=$(jq -nr 'now | floor') || return 1
      message="time_failed: New York time unavailable; timestamp from jq now; $message"
    fi
    [ "$failed_firings" -ge "$RECORDER_FAILURE_BOUND" ] || failed_firings=$((failed_firings + 1))
    recorder_write failed "$1" "$message" || return 1
    return "$1"
  }
  recorder_finish() {
    if [ "$completed_batches" = 0 ] && [ -n "$prior_failure" ]; then
      echo "movers-recorder: no batch completed; previous failed status retained"
      recorder_store "$prior_failure"
    else
      failed_firings=0
      recorder_write "$1" 0 "$2"
    fi
  }
  recorder_stop() {
    # timeout(1) forwards TERM to its command group; pinned mise forwards it to its task groups,
    # whose paper:data bounded() trap kills uv. Keep the wrapper/clone lock until wait completes.
    trap '' TERM HUP INT
    if [ -n "$batch_pid" ]; then
      kill -TERM "$batch_pid" 2>/dev/null || :
      wait "$batch_pid" 2>/dev/null || :
    fi
    exec 8>&-
    recorder_fail "$1" "firing_interrupted: received $2; batch stopped"
    exit "$1"
  }
  # This is a weekday data-collection policy: market holidays and early-close afternoons still poll.
  recorder_open() { [ "$weekday" -lt 6 ] && [ "$hour" -ge 4 ] && [ "$hour" -lt 20 ]; }
  recorder_budget() {
    close_epoch=$(TZ=America/New_York "$date_bin" -j -f '%Y-%m-%d %H:%M:%S' "$day 20:00:00" +%s) || return 1
    [[ "$close_epoch" =~ ^[0-9]+$ ]] || return 1
    left=$((close_epoch - epoch)); polls=0
    if [ "$left" -ge $((RECORDER_HEADROOM + RECORDER_STOP_ROOM)) ]; then
      polls=$(((left - RECORDER_HEADROOM - RECORDER_STOP_ROOM) / 60 + 1))
      [ "$polls" -le 80 ] || polls=80
    fi
  }
  recorder_gap() {
    printf -v gap_start '%s %02d:%02d:%02d America/New_York' "$day" "$hour" "$minute" "$second"
    stamp="recording gap: from $gap_start to $day 20:00:00 America/New_York; startup, HTTP and cleanup headroom reserved"
    echo "movers-recorder: $stamp"
    recorder_finish ok "$stamp"
  }
  if [ -f "$RECORDER_STATUS" ]; then
    failed_firings=$(jq -er --argjson b "$RECORDER_FAILURE_BOUND" '(.consecutive_failed_firings // 0)
      | if type == "number" and . >= 0 and floor == . then [., $b] | min else 0 end' "$RECORDER_STATUS") \
      || { failed_firings=0; recorder_fail 1 "status_unreadable: previous recorder status"; return $?; }
    prior_failure=$(jq -ce 'select(.outcome == "failed")' "$RECORDER_STATUS") || prior_failure=""
  fi
  recorder_time || { recorder_fail 1 "time_failed: could not read New York time; nothing was run"; return $?; }
  case "$dir" in /*) ;; *) recorder_fail 1 "the checkout must be absolute"; return $? ;; esac
  mkdir -p "$(dirname "$dir")" || { recorder_fail 1 "checkout_parent_failed: could not create the checkout parent"; return $?; }
  exec 9>>"$(recorder_lock_path "$dir")" || { recorder_fail 1 "recorder_lock_failed: could not open the recorder lock"; return $?; }
  rc=0; "$LOCKF" -t 0 9 2>/dev/null || rc=$?
  # Outside the window there is nothing to record, so a lock held then (maintenance's mise self-update, an
  # install) ends the firing idle rather than counting a failure.
  if [ "$rc" = 75 ] && ! recorder_open; then
    recorder_finish idle "outside weekdays 04:00-20:00 America/New_York (the recorder lock was held)"; return $?
  fi
  case "$rc" in
    0) ;;
    75) recorder_fail 1 "recorder_lock_held: another recorder or installer holds the checkout; nothing was run"; return $? ;;
    *) recorder_fail 1 "could not take the recorder lock (exit $rc); nothing was run"; return $? ;;
  esac
  if ! recorder_open; then recorder_finish idle "outside weekdays 04:00-20:00 America/New_York"; return $?; fi
  ceiling=$(cd "$(dirname "$dir")" && pwd -P) || { recorder_fail 1 "could not resolve the checkout parent"; return $?; }
  case "$ceiling" in *:*|*,*) recorder_fail 1 "the checkout parent holds a mise ceiling list separator"; return $? ;; esac
  while recorder_open; do
    fetch_note=""; commit="none: nothing ran"; prepared_commit=""
    recorder_budget || { recorder_fail 1 "could not compute the New York close"; return $?; }
    [ "$polls" -gt 0 ] || { recorder_gap; return $?; }
    # The helper and the run use separate locks: 9 excludes other recorders for the entire loop; the
    # helper and each batch hold the clone's descriptor-8 lock so no checkout refresh removes a live run.
    recorder_write running 0 "preparing origin/main" || return 1
    out=$(CANON_RECORDER_LOCK_SECS="$RECORDER_LOCK_SECS" /bin/bash "$RECORDER_HELPER" --recorder-checkout "$m" "$dir" "$url" 9>&- 2>&1) \
      || { rc=$?; recorder_fail "$rc" "checkout_failed: ${out//$'\n'/; } (exit $rc); nothing was run"; return $?; }
    echo "$out"
    if [[ "$out" == *"fetch_failed, checkout at "* ]]; then
      fetch_note="fetch_failed, checkout at ${out##*fetch_failed, checkout at }; no batch started"
    fi
    exec 8>>"$dir.lock" || { recorder_fail 1 "could not open the checkout lock"; return $?; }
    [[ "$RECORDER_LOCK_SECS" =~ ^[1-9][0-9]*$ ]] || { recorder_fail 1 "invalid recorder checkout wait bound"; return $?; }
    wait_end=$((SECONDS + RECORDER_LOCK_SECS))
    while :; do
      rc=0; "$LOCKF" -t 0 8 2>/dev/null || rc=$?
      [ "$rc" != 0 ] || break
      [ "$rc" = 75 ] || { recorder_fail 1 "checkout_lock_failed: lockf exited $rc"; return $?; }
      [ "$SECONDS" -lt "$wait_end" ] || { recorder_fail 1 "checkout_lock_timeout: still held after $RECORDER_LOCK_SECS s (UNCALIBRATED)"; return $?; }
      sleep 1
    done
    prepared_commit=$(git -C "$dir" -c core.hooksPath=/dev/null rev-parse --verify HEAD) \
      || { recorder_fail 1 "could not read the checkout commit"; return $?; }
    recorder_time || { recorder_fail 1 "could not read New York time"; return $?; }
    recorder_open || break
    recorder_budget || { recorder_fail 1 "could not compute the New York close"; return $?; }
    [ "$polls" -gt 0 ] || { recorder_gap; return $?; }
    run_budget=$((RECORDER_HEADROOM + (polls - 1) * 60))
    commit=$prepared_commit
    [ -z "$fetch_note" ] || fetch_note="fetch_failed, ran at ${commit:0:12}"
    recorder_write running 0 "$polls polls" || return 1
    echo "movers-recorder: $day running origin/main $commit, $polls polls"
    rc=0
    # mise's global timeout terminates its command trees with a 5 s grace (pinned run.rs/terminate_all).
    # It fires before the outer TERM/KILL bound; both fit before the close, with launch time reserved.
    trap 'recorder_stop 143 TERM' TERM
    trap 'recorder_stop 129 HUP' HUP
    trap 'recorder_stop 130 INT' INT
    (cd "$dir" && MISE_CEILING_PATHS="$ceiling" MISE_TASK_RUN_AUTO_INSTALL=false CANON_COMMIT="$commit" \
      exec /usr/bin/timeout -k 5 "$((run_budget + 30))" "$m" run --timeout "$((run_budget + 5))s" paper:data movers-screener --minutes "$polls" < /dev/null) 9>&- &
    batch_pid=$!
    wait "$batch_pid" || rc=$?
    batch_pid=""
    trap - TERM HUP INT
    exec 8>&-
    [ "$rc" = 0 ] || { recorder_fail "$rc" "batch_failed: paper:data movers-screener exited $rc"; return $?; }
    completed_batches=$((completed_batches + 1))
    recorder_time || { recorder_fail 1 "could not read New York time"; return $?; }
    if [ "$polls" -lt 80 ] && recorder_open; then recorder_gap; return $?; fi
  done
  recorder_finish ok "weekday recording window finished"
}

show_recorder_status() {
  local pr rc=0 v label state last sig cfg recorder_canon status
  cfg=$(plutil -extract EnvironmentVariables.CLAUDE_CONFIG_DIR raw -o - "$RECORDER_PLIST" 2>/dev/null) || cfg=""
  recorder_canon="${cfg:-$CLAUDE_HOME}/canon"; status="$recorder_canon/watch/movers-recorder.json"
  pr=$(lc print "$DOMAIN/$RECORDER_LABEL" 2>/dev/null) || rc=$?
  if no_answer "$rc"; then check_row "movers recorder" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s"; return; fi
  if [ "$rc" != 0 ]; then check_row "movers recorder" OFF "run: scripts/automation install"; return; fi
  # shellcheck disable=SC2016  # jq program, not shell
  v=$(jq -er --argjson now "$(date +%s)" --argjson silent "$RECORDER_SILENT" "$PAPER_COMMIT"'
      select(type == "object" and (.at_epoch | type) == "number"
             and (.exit_code | type) == "number"
             and (.outcome == "idle" or .outcome == "running" or .outcome == "ok" or .outcome == "failed"))
      | (if .outcome == "failed" then "FAILED" elif $now - .at_epoch > $silent then "STALE" else "ok" end)
        + "\t" + .outcome + "; " + (.note // "") + "; exit " + (.exit_code | tostring)
        + "; origin/main " + (.commit | short)' "$status" 2>/dev/null) || v=""
  if [ -n "$v" ]; then label=${v%%$'\t'*}; v=${v#*$'\t'}
  else label=UNKNOWN; v="no readable recorder status at $status (first check $RECORDER_INTERVAL s after install)"; fi
  state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / { print $2; exit }')
  last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / { print $2; exit }')
  sig=$(lc list 2>/dev/null | awk -v l="$RECORDER_LABEL" '$3 == l { print $2; exit }')
  case "$last" in ''|0|*[!0-9-]*) ;; *) label=FAILED; v="$v; last firing exit $last" ;; esac
  if [[ "$sig" =~ ^-[0-9]+$ ]]; then label=FAILED; v="$v; last firing stopped by signal ${sig#-}"; fi
  if [[ "$v" == running\;* ]] && [ "$state" != running ] && [ "$label" = ok ]; then
    label=FAILED; v="$v; record says running, launchd state=${state:-unknown}"
  fi
  if ! cmp -s "$ROOT/scripts/automation" "$recorder_canon/movers-recorder.sh" \
     || ! cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$recorder_canon/movers-checkout.sh"; then
    [ "$(paper_rank OUTDATED)" -le "$(paper_rank "$label")" ] || label=OUTDATED
    v="$v; installed recorder differs from this tree: run scripts/automation install"
  fi
  check_row "movers recorder" "$label" "$v | weekdays 04:00-20:00 New York; log $recorder_canon/watch/movers-recorder.log"
}

# The collector agent runs otelcol with the config from home/.claude/canon/otel/, kept alive by launchd
# (launchd.plist(5) KeepAlive, RunAtLoad; KeepAlive true, so a SIGKILL or a clean exit is restarted too);
# CANON_OTEL_DIR tells the config where to write logs.jsonl. Its own log, at service.telemetry.logs.level
# warn, is empty while it runs well; a failed start (a port in use) writes about 440 bytes, and
# ThrottleInterval spawns it at most once a minute, so a restart loop adds at most about 0.63 MB a day
# (1440 x 440 B) until the next install empties the file (ADR 0007).
# write_otel_plist <otelcol path> [file, else OTEL_PLIST]
OTEL_THROTTLE=60
write_otel_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "${2:-$OTEL_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$OTEL_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$1")</string>
    <string>--config</string>
    <string>$(xml "$OTEL_DIR")/config.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CANON_OTEL_DIR</key>
    <string>$(xml "$OTEL_DIR")</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$(xml "$OTEL_DIR")</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>$OTEL_THROTTLE</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$c/watch/otel-collector.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/otel-collector.log</string>
</dict>
</plist>
EOF
}

# The maintenance agent runs ~/.claude/canon/maintenance.sh on this clone (the main checkout install ran from)
# with the mise this install found, every MAINT_INTERVAL, not at load (the first round comes an interval after
# install). AbandonProcessGroup: the reinstall a round starts is a job of its own process group and outlives
# the round, which launchd's kill of the job's process group would otherwise end (launchd.plist(5)).
# CLAUDE_CONFIG_DIR, as for the watchdog, so the installers it runs write to the folder this install used.
# write_maint_plist <mise> [file, else MAINT_PLIST]
write_maint_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "${2:-$MAINT_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$MAINT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$c/maintenance.sh</string>
    <string>$(xml "$ROOT")</string>
    <string>$(xml "$1")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>$(xml "$CLAUDE_HOME")</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$c</string>
  <key>StartInterval</key>
  <integer>$MAINT_INTERVAL</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$c/watch/maintenance.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/maintenance.log</string>
</dict>
</plist>
EOF
}

# install_maint: installs the maintenance agent's script and plist, last. Its job is reloaded only when the plist
# changed or it is not loaded: a reinstall the agent started then never stops the agent's own job, and its
# interval is not restarted; a changed script needs no reload, since each round runs the file anew.
install_maint() {
  local m t
  if ! m=$(find_mise 2>&1); then note "  FAILED: $m"; return 1; fi
  if ! /usr/bin/install -m 755 "$ROOT/home/.claude/canon/maintenance.sh" "$CANON_HOME/maintenance.sh"; then
    note "  FAILED: could not install $CANON_HOME/maintenance.sh"; return 1
  fi
  note "  installed  $CANON_HOME/maintenance.sh"
  t=$(mktemp "$AGENTS_DIR/.$MAINT_LABEL.XXXXXX") || { note "  FAILED: could not write $MAINT_PLIST"; return 1; }
  write_maint_plist "$m" "$t" || { rm -f "$t"; note "  FAILED: could not write $MAINT_PLIST"; return 1; }
  load_if_changed "$MAINT_LABEL" "$t" "$MAINT_PLIST" "the next round runs the new script" \
    "(every $((MAINT_INTERVAL / 60)) minutes; the first round $((MAINT_INTERVAL / 60)) minutes from now)"
}

# load_if_changed <label> <new plist> <plist> <why keeping is enough> <what loaded says>: checks the new plist,
# puts it in place, and reloads the job only when the plist changed or the job is not loaded
load_if_changed() {
  local same=0 st
  if ! plutil -lint "$2" >/dev/null; then rm -f "$2"; note "  FAILED: could not write a valid $3"; return 1; fi
  cmp -s "$2" "$3" && same=1
  if ! mv -f "$2" "$3"; then rm -f "$2"; note "  FAILED: could not write $3"; return 1; fi
  note "  wrote      $3"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"; return 0; fi
  if [ "$same" = 1 ]; then
    loaded "$1"; st=$?
    if [ "$st" = 0 ]; then note "  kept       $1 loaded: its plist is unchanged ($4)"; return 0; fi
    if [ "$st" = 2 ]; then note "  FAILED: launchctl did not answer within ${LAUNCHCTL_SECS} s about $1; run: scripts/automation install"; return 1; fi
  fi
  load "$1" "$3" "$5"
}

# The OmniRoute gateway agent (ADR 0056) runs mise.gateway.toml's own task, `mise -E gateway run omniroute:serve`,
# in this clone, kept alive by launchd (KeepAlive, RunAtLoad, ThrottleInterval as the collector's): the task
# reads its storage key from the login keychain, clears the environment and starts the gateway on
# 127.0.0.1:20128 with ADR 0056's settings; nothing is set here but PATH, which mise needs (paper-session.sh),
# MISE_TASK_RUN_AUTO_INSTALL=false (mise settings, task.run_auto_install: "Install missing tools automatically
# before tasks run"), so a moved pin is never installed by the agent, and CANON_GATEWAY_CONFIG, a checksum of
# mise.gateway.toml that the task ignores, so a change to the task changes the plist and the next install
# reloads the gateway. A SIGTERM to `mise run` ends its task (observed with mise 2026.11.5), so a bootout stops
# the gateway. It takes no paper lock.
# write_gw_plist <mise> [file, else GW_PLIST]
write_gw_plist() {
  local c sum; c=$(xml "$CANON_HOME")
  sum=$(cksum < "$ROOT/mise.gateway.toml" 2>/dev/null | awk '{ print $1 "-" $2 }')
  cat > "${2:-$GW_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$GW_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$1")</string>
    <string>-E</string>
    <string>gateway</string>
    <string>run</string>
    <string>omniroute:serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MISE_TASK_RUN_AUTO_INSTALL</key>
    <string>false</string>
    <key>CANON_GATEWAY_CONFIG</key>
    <string>${sum:-none}</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$(xml "$ROOT")</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>$OTEL_THROTTLE</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$c/watch/omniroute.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/omniroute.log</string>
</dict>
</plist>
EOF
}
# gw_state <mise>: whether mise has the gateway environment's omniroute installed for this clone (as
# scripts/bootstrap's omniroute row asks): "installed"; "absent" when mise.gateway.toml is gone or mise says
# "not installed" (mise 2026.11.5: "mise ERROR npm:omniroute not installed", observed); otherwise
# "unknown: <mise's first line>", which neither loads nor removes an agent
gw_state() {
  local out
  [ -f "$ROOT/mise.gateway.toml" ] || { echo absent; return; }
  if out=$(cd "$ROOT" && MISE_ENV=gateway "$1" where npm:omniroute 2>&1); then echo installed
  elif grep -q 'npm:omniroute[^ ]* not installed' <<<"$out"; then echo absent
  else echo "unknown: ${out%%$'\n'*}"; fi
}
install_gw() {
  local m t
  if ! m=$(find_mise 2>&1); then note "  FAILED: $m"; return 1; fi
  local gs; gs=$(gw_state "$m")
  case "$gs" in
    installed) ;;
    absent)
      note "  skipped    OmniRoute is not installed for this clone (on request: mise -E gateway install --locked npm:omniroute; ADR 0056)"
      [ -f "$GW_PLIST" ] || return 0
      # an agent from an earlier install would restart a gateway that is gone every ThrottleInterval
      if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then note "  kept       $GW_PLIST (AUTOMATION_SKIP_LAUNCHD=1: not unloaded, so not removed)"; return 0; fi
      local rc; unload "$GW_LABEL"; rc=$?
      if [ "$rc" != 0 ]; then unload_note "$GW_LABEL" "$rc"; return 1; fi
      rm -f "$GW_PLIST" && note "  removed    $GW_PLIST, the agent of a gateway no longer installed"; return 0 ;;
    *)
      if [ -f "$GW_PLIST" ]; then note "  FAILED: mise did not say whether OmniRoute is installed (${gs#unknown: }); $GW_PLIST kept as it was"; return 1; fi
      note "  skipped    mise did not say whether OmniRoute is installed (${gs#unknown: }); no gateway agent written"; return 0 ;;
  esac
  t=$(mktemp "$AGENTS_DIR/.$GW_LABEL.XXXXXX") || { note "  FAILED: could not write $GW_PLIST"; return 1; }
  write_gw_plist "$m" "$t" || { rm -f "$t"; note "  FAILED: could not write $GW_PLIST"; return 1; }
  load_if_changed "$GW_LABEL" "$t" "$GW_PLIST" "the gateway keeps running" "(kept running on 127.0.0.1:20128, its API key required)"
}

# The nightly study agent (ADR 0089) runs mise.toml's own task, `mise run study:nightly`, in this clone, every
# STUDY_INTERVAL and not at load: one firing of canon_trading.nightly_study, which studies the latest recorded
# night once it is recorded whole and does nothing otherwise, so a Mac asleep at one firing loses nothing. It
# reads no credential, opens no stream and takes no paper lock. PATH and MISE_TASK_RUN_AUTO_INSTALL as for the
# gateway agent above. Its records are in STUDY_DIR, beside the ledger.
# write_study_plist <mise> [file, else STUDY_PLIST]
write_study_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "${2:-$STUDY_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$STUDY_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$1")</string>
    <string>run</string>
    <string>study:nightly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MISE_TASK_RUN_AUTO_INSTALL</key>
    <string>false</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$(xml "$ROOT")</string>
  <key>StartInterval</key>
  <integer>$STUDY_INTERVAL</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$c/watch/nightly-study.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/nightly-study.log</string>
</dict>
</plist>
EOF
}
# install_study: writes the nightly study's agent; its job is reloaded only when the plist changed or it is not
# loaded, so a reinstall does not restart its interval (the task itself is read from mise.toml at each firing)
install_study() {
  local m t
  if ! m=$(find_mise 2>&1); then note "  FAILED: $m"; return 1; fi
  t=$(mktemp "$AGENTS_DIR/.$STUDY_LABEL.XXXXXX") || { note "  FAILED: could not write $STUDY_PLIST"; return 1; }
  write_study_plist "$m" "$t" || { rm -f "$t"; note "  FAILED: could not write $STUDY_PLIST"; return 1; }
  load_if_changed "$STUDY_LABEL" "$t" "$STUDY_PLIST" "the next firing runs the task as mise.toml has it" \
    "(every $((STUDY_INTERVAL / 60)) minutes; a night is studied once, after 20:05 New York and the recorder's consolidation)"
}

# install_otel: installs the collector's config and agent; returns 1 naming what failed. The config is
# validated before it replaces the installed one, so a refused config never reaches a running agent; on a
# failure before the plist is written, an agent loaded by an earlier install is left as it was, and says so.
# The plist names the versioned binary mise installed, so a move of the otelcol pin needs this install again
# (status says FAILED when that binary is gone).
install_otel() {
  local m bin out src="$ROOT/home/.claude/canon/otel/config.yaml" prev=""
  [ -e "$OTEL_PLIST" ] && prev=" (an agent from an earlier install is left as it was)"
  if ! m=$(find_mise 2>&1); then note "  FAILED: $m$prev"; return 1; fi
  if ! bin=$(cd "$ROOT" && "$m" which otelcol 2>/dev/null) || [ -z "$bin" ] || [ ! -x "$bin" ]; then
    note "  FAILED: mise has no otelcol installed for this clone; run: scripts/bootstrap --install$prev"; return 1
  fi
  mkdir -p "$OTEL_DIR" || { note "  FAILED: cannot create $OTEL_DIR$prev"; return 1; }
  if ! out=$(CANON_OTEL_DIR="$OTEL_DIR" "$bin" validate --config "$src" 2>&1); then
    note "  FAILED: otelcol validate refused the config: ${out//$'\n'/; }$prev"; return 1
  fi
  # config and plist as they are, and the job loaded: kept running, its events and log with it
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != "1" ] && cmp -s "$src" "$OTEL_DIR/config.yaml" && [ -f "$OTEL_PLIST" ]; then
    local t
    if t=$(mktemp "$AGENTS_DIR/.$OTEL_LABEL.XXXXXX") && write_otel_plist "$bin" "$t" && cmp -s "$t" "$OTEL_PLIST" && loaded "$OTEL_LABEL"; then
      rm -f "$t"; note "  kept       $OTEL_LABEL running: its config and plist are unchanged"; return 0
    fi
    rm -f "${t:-}"
  fi
  if ! /usr/bin/install -m 644 "$src" "$OTEL_DIR/config.yaml"; then
    note "  FAILED: could not install $OTEL_DIR/config.yaml$prev"; return 1
  fi
  note "  installed  $OTEL_DIR/config.yaml"
  # the collector's own log, which launchd only appends to, starts again with each install
  : > "$CANON_HOME/watch/otel-collector.log" 2>/dev/null || true
  if ! write_otel_plist "$bin" || ! plutil -lint "$OTEL_PLIST" >/dev/null; then
    note "  FAILED: could not write a valid $OTEL_PLIST"; return 1
  fi
  note "  wrote      $OTEL_PLIST ($bin)"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"; return 0; fi
  load "$OTEL_LABEL" "$OTEL_PLIST" "(kept running; OTLP on 127.0.0.1:4317 and :4318, writing $OTEL_DIR/logs.jsonl)"
}

do_install() {
  local ok=0
  note "Commit gate:"
  if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if git -C "$ROOT" config --local core.hooksPath .githooks; then note "  core.hooksPath = .githooks (this clone only)"
    else note "  FAILED: could not set core.hooksPath"; ok=1; fi
  else
    note "  SKIPPED: $ROOT is not a git repository"; ok=1
  fi

  note "Lane watchdog:"
  mkdir -p "$CANON_HOME/watch" "$AGENTS_DIR" || { note "  FAILED: cannot create directories"; return 1; }
  local f
  for f in "scripts/lanes:lanes" "home/.claude/canon/lanes-watch.sh:lanes-watch.sh"; do
    if /usr/bin/install -m 755 "$ROOT/${f%%:*}" "$CANON_HOME/${f#*:}"; then note "  installed  $CANON_HOME/${f#*:}"
    else note "  FAILED: could not install $CANON_HOME/${f#*:}"; ok=1; fi
  done
  write_plist || { note "  FAILED: could not write $PLIST"; return 1; }
  if ! plutil -lint "$PLIST" >/dev/null; then note "  FAILED: generated plist is invalid"; return 1; fi
  note "  wrote      $PLIST"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then      # rehearsal: every step except the launchctl calls
    note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"
  else
    load "$LABEL" "$PLIST" "(every $((INTERVAL / 60)) minutes; first run now)" || ok=1
  fi
  note "Paper session:"
  local paper_mise paper_url out
  if [ "${DEFER_PAPER:-0}" = 1 ]; then
    note "  deferred   to the session boundary: the paper checkout ($CANON_HOME/paper-session.sh, $PAPER_CHECKOUT and $PAPER_PLIST left as they are, $PAPER_LABEL loaded as it is, while a window runs from them)"
  elif ! paper_mise=$(find_mise 2>&1); then
    note "  FAILED: $paper_mise"; ok=1
  elif ! paper_url=$(git -C "$ROOT" remote get-url origin 2>/dev/null) || [ -z "$paper_url" ]; then
    note "  FAILED: no origin remote, so there is no main to fetch for the windows"; ok=1
  else
    # the old job is unloaded before anything it runs is replaced, so no firing of it runs the new runner or
    # the clone while install moves them; one that would not unload leaves all of them as they were
    # with runner and plist as they are and the job loaded, it is left alone: a reload starts its 35-minute
    # interval again (ADR 0050), and each firing makes its clone anew anyway
    local paper_unloaded=0 paper_keep=0 pt=""
    if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != "1" ] && [ -f "$PAPER_PLIST" ] \
       && cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh" \
       && pt=$(mktemp "$AGENTS_DIR/.$PAPER_LABEL.XXXXXX") && write_paper_plist "$paper_mise" "$paper_url" "$pt" \
       && cmp -s "$pt" "$PAPER_PLIST" && loaded "$PAPER_LABEL"; then paper_keep=1; fi
    rm -f "${pt:-}"
    if [ "$paper_keep" != 1 ] && [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != "1" ]; then unload "$PAPER_LABEL"; paper_unloaded=$?; fi
    if [ "$paper_keep" = 1 ]; then
      note "  kept       $PAPER_LABEL loaded: its runner and plist are unchanged (its interval runs on)"
    elif [ "$paper_unloaded" != 0 ]; then
      unload_note "$PAPER_LABEL" "$paper_unloaded"; ok=1
      note "  kept       $CANON_HOME/paper-session.sh, $PAPER_CHECKOUT and $PAPER_PLIST as they were, under the job still loaded"
    elif ! /usr/bin/install -m 755 "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh"; then
      note "  FAILED: could not install $CANON_HOME/paper-session.sh"; ok=1
    else
      note "  installed  $CANON_HOME/paper-session.sh"
      if ! out=$(/bin/bash "$CANON_HOME/paper-session.sh" --checkout-only "$paper_mise" "$PAPER_CHECKOUT" "$paper_url" 2>&1); then
        # no plist left behind for launchd to load at the next login, the old main-checkout one included
        rm -f "$PAPER_PLIST"
        note "  FAILED: ${out//$'\n'/; } (not loaded; $PAPER_PLIST removed)"; ok=1
      else
        note "  ${out#paper-session: }"
        if ! write_paper_plist "$paper_mise" "$paper_url" || ! plutil -lint "$PAPER_PLIST" >/dev/null; then
          note "  FAILED: could not write a valid $PAPER_PLIST"; ok=1
        else
          note "  wrote      $PAPER_PLIST"
          if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then
            note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"
          else
            boot "$PAPER_LABEL" "$PAPER_PLIST" "($PAPER_INTERVAL s after each firing ends; a window only when a session is open)" || ok=1
          fi
        fi
      fi
    fi
  fi
  note "Movers recorder:"
  install_recorder || ok=1
  note "OTLP collector:"
  install_otel || ok=1
  note "OmniRoute gateway:"
  install_gw || ok=1
  note "Nightly study:"
  install_study || ok=1
  note "Landing:"
  local mise_bin
  if ! git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    note "  no GitHub remote; scripts/land fast-forwards main locally"
  elif ! mise_bin=$(find_mise 2>&1); then
    note "  FAILED: $mise_bin"; ok=1
  elif git -C "$ROOT" config --local --replace-all credential.https://github.com.helper "" \
       && git -C "$ROOT" config --local --add credential.https://github.com.helper "!\"$mise_bin\" exec -- gh auth git-credential"; then
    # Lets git use gh's sign-in for github.com in this repository only (what `gh auth setup-git` does
    # globally), routed through mise so it survives a change of gh version.
    note "  git uses gh's sign-in for github.com in this repository (through $mise_bin)"
  else
    note "  FAILED: could not set the git credential helper"; ok=1
  fi
  # last: when the agent's own round started this install, a reload of its job comes after everything else
  note "Maintenance:"
  install_maint || ok=1
  note "Landscape watch: registered in .claude/settings.json; nothing to install."
  note "Weekly refresh: created from a Claude desktop session, not from this script."
  return "$ok"
}

# do_uninstall: returns 1, naming what is left, when any removal fails. The files a job runs are removed only
# once its job is unloaded: removed under a job still loaded, they left launchd firing it at programs that
# were gone (a second reader's claim), and a retry would find nothing to tell it what to unload.
do_uninstall() {
  local left="" f l rc still="" fs
  for l in "$MAINT_LABEL" "$LABEL" "$PAPER_LABEL" "$RECORDER_LABEL" "$OTEL_LABEL" "$GW_LABEL" "$STUDY_LABEL"; do
    unload "$l"; rc=$?
    case "$rc" in
      0) if [ "$UNLOAD_ABSENT" = 1 ]; then note "  $l was not loaded"; else note "  unloaded   $l"; fi; continue ;;
      2) note "  FAILED: launchctl bootout refused $l: ${UNLOAD_ERR:-no message}" ;;
      3) note "  FAILED: launchctl did not answer within ${LAUNCHCTL_SECS} s about $l" ;;
      *) note "  FAILED: $l is still loaded after ${UNLOAD_SECS} s" ;;
    esac
    still="$still $l "; left="$left
  launchd job $l"
  done
  for l in "$MAINT_LABEL" "$LABEL" "$PAPER_LABEL" "$RECORDER_LABEL" "$OTEL_LABEL" "$GW_LABEL" "$STUDY_LABEL"; do
    case "$l" in
      "$LABEL") fs="$PLIST|$CANON_HOME/lanes|$CANON_HOME/lanes-watch.sh" ;;
      "$PAPER_LABEL") fs="$PAPER_PLIST|$CANON_HOME/paper-session.sh" ;;
      "$RECORDER_LABEL") fs="$RECORDER_PLIST|$RECORDER_RUNNER|$RECORDER_HELPER" ;;
      "$MAINT_LABEL") fs="$MAINT_PLIST|$CANON_HOME/maintenance.sh|$CANON_HOME/maintenance.lock" ;;
      "$GW_LABEL") fs="$GW_PLIST" ;;
      "$STUDY_LABEL") fs="$STUDY_PLIST" ;;
      *) fs="$OTEL_PLIST|$OTEL_DIR/config.yaml" ;;
    esac
    if [[ "$still" == *" $l "* ]]; then
      note "  kept       ${fs//|/, }: $l is still loaded and runs them; run uninstall again once it is not"
      left="$left
  ${fs//|/, }"; continue
    fi
    local IFS='|'
    for f in $fs; do
      [ -e "$f" ] || continue
      if rm -f "$f" && [ ! -e "$f" ]; then note "  removed    $f"
      else note "  FAILED: could not remove $f"; left="$left
  $f"; fi
    done
    unset IFS
  done
  # marked <git dir>: as the runner's own check (home/.claude/canon/paper-session.sh), a git directory, not a
  # link, whose config carries the mark; a run stopped part way leaves it as .git.old or .git.new
  marked() { [ -d "$1" ] && [ ! -L "$1" ] && [ "$(git config --file "$1/config" --get canon.paperCheckout 2>/dev/null)" = true ]; }
  if [ ! -e "$PAPER_CHECKOUT" ]; then :
  elif [[ "$still" == *" $PAPER_LABEL "* ]]; then
    note "  kept       $PAPER_CHECKOUT: $PAPER_LABEL is still loaded and runs from it"
    left="$left
  $PAPER_CHECKOUT"
  else
    local m
    # only the clone install made: its own git config marks it
    if ! marked "$PAPER_CHECKOUT/.git" && ! marked "$PAPER_CHECKOUT/.git.old" && ! marked "$PAPER_CHECKOUT/.git.new"; then
      note "  FAILED: $PAPER_CHECKOUT is not the clone install made; not touching it"; left="$left
  $PAPER_CHECKOUT"
    # with no lockf, whether a window runs from it cannot be told, so it is kept (AGENTS.md rule 5; a second
    # reader, Codex, found the removal went ahead)
    elif [ ! -x "$LOCKF" ]; then
      note "  FAILED: no $LOCKF to tell whether a window still runs from $PAPER_CHECKOUT; not removing it"
      left="$left
  $PAPER_CHECKOUT"
    # a window still running from it holds its lock (paper-session.sh), even after the bootout above
    elif ! "$LOCKF" -k -t 0 "$PAPER_CHECKOUT.lock" true 2>/dev/null; then
      note "  FAILED: a window is still running from $PAPER_CHECKOUT; not removing it (run uninstall again once it ends)"
      left="$left
  $PAPER_CHECKOUT"
    else
      # `mise run` trusted the clone's mise.toml at its first firing (mise trust docs); that goes with it.
      # mise refuses to untrust a path that is not there, and a clone with no mise.toml never ran mise.
      if [ ! -e "$PAPER_CHECKOUT/mise.toml" ]; then :
      elif ! m=$(find_mise 2>&1); then note "  FAILED: $m, so the clone's mise trust stays"; left="$left
  mise trust of $PAPER_CHECKOUT/mise.toml"
      elif "$m" trust --untrust "$PAPER_CHECKOUT/mise.toml" >/dev/null 2>&1; then note "  untrusted  $PAPER_CHECKOUT/mise.toml (mise)"
      else note "  FAILED: mise could not untrust $PAPER_CHECKOUT/mise.toml"; left="$left
  mise trust of $PAPER_CHECKOUT/mise.toml"; fi
      if rm -rf "$PAPER_CHECKOUT" "$PAPER_CHECKOUT.lock" && [ ! -e "$PAPER_CHECKOUT" ]; then note "  removed    $PAPER_CHECKOUT"
      else note "  FAILED: could not remove $PAPER_CHECKOUT"; left="$left
  $PAPER_CHECKOUT"; fi
    fi
  fi
  # The recorder has a separate clone, prepared by paper-session.sh's --checkout-only contract. Keep it
  # whenever its job or either clone lock is still held; recorded market data lives outside this clone.
  if [ -e "$RECORDER_CHECKOUT" ]; then
    if [[ "$still" == *" $RECORDER_LABEL "* ]] || [ ! -x "$LOCKF" ] \
       || ! "$LOCKF" -k -t 0 "$(recorder_lock_path)" true 2>/dev/null \
       || ! "$LOCKF" -k -t 0 "$RECORDER_CHECKOUT.lock" true 2>/dev/null; then
      note "  FAILED: movers recorder may still run from $RECORDER_CHECKOUT; not removing it"; left="$left
  $RECORDER_CHECKOUT"
    elif ! marked "$RECORDER_CHECKOUT/.git" && ! marked "$RECORDER_CHECKOUT/.git.old" && ! marked "$RECORDER_CHECKOUT/.git.new"; then
      note "  FAILED: $RECORDER_CHECKOUT is not the clone the recorder made; not touching it"; left="$left
  $RECORDER_CHECKOUT"
    else
      local recorder_mise
      if [ ! -e "$RECORDER_CHECKOUT/mise.toml" ]; then :
      elif ! recorder_mise=$(find_mise 2>&1); then
        note "  FAILED: $recorder_mise, so the recorder clone's mise trust stays"; left="$left
  mise trust of $RECORDER_CHECKOUT/mise.toml"
      elif ! "$recorder_mise" trust --untrust "$RECORDER_CHECKOUT/mise.toml" >/dev/null 2>&1; then
        note "  FAILED: could not remove mise trust of $RECORDER_CHECKOUT/mise.toml"; left="$left
  mise trust of $RECORDER_CHECKOUT/mise.toml"
      fi
      if rm -rf "$RECORDER_CHECKOUT" "$RECORDER_CHECKOUT.lock" "$(recorder_lock_path)" && [ ! -e "$RECORDER_CHECKOUT" ]; then
        note "  removed    $RECORDER_CHECKOUT"
      else note "  FAILED: could not remove $RECORDER_CHECKOUT"; left="$left
  $RECORDER_CHECKOUT"; fi
    fi
  fi
  if [ "$(git -C "$ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ]; then
    if git -C "$ROOT" config --local --unset core.hooksPath; then note "  unset      core.hooksPath"
    else note "  FAILED: could not unset core.hooksPath"; left="$left
  core.hooksPath in $ROOT"; fi
  fi
  if git -C "$ROOT" config --local --get-all credential.https://github.com.helper >/dev/null 2>&1; then
    if git -C "$ROOT" config --local --unset-all credential.https://github.com.helper; then
      note "  unset      git sign-in helper for github.com (this repository only)"
    else note "  FAILED: could not unset the git sign-in helper"; left="$left
  credential.https://github.com.helper in $ROOT"; fi
  fi
  note "Left in place: $CANON_HOME/ledger, $CANON_HOME/watch (alert history), the session windows' records"
  note "in ${PAPER_DIR:-the per-user temporary folder}, $OTEL_DIR/logs.jsonl (and its rotated copies) and the weekly scheduled task."
  if [ -n "$PAPER_TMP" ]; then note "The data-only logs stay in ${PAPER_TMP}canon-paper-data."
  else note "The data-only logs stay in the per-user temporary folder's canon-paper-data."; fi
  note "Remove the weekly task from the desktop app's Scheduled list."
  if [ -n "$left" ]; then note "uninstall: not removed:$left"; return 1; fi
}

# uc_sources: a checksum of what scripts/bootstrap --user-config reads from this tree, by relative path, so the
# clone's place does not change it: home/.claude but its canon/ folder (whose three scripts are compared whole),
# home/.codex, canon/models.json and scripts/bootstrap itself
# The settings step also writes only where a runtime's own folder exists (Codex's, Antigravity's, dsh-tui's
# profile; scripts/bootstrap), so which of those exist is part of what it was run for.
uc_sources() {
  local dir
  { (cd "$ROOT" && { find home/.claude home/.codex -type f ! -path 'home/.claude/canon/*' -print; echo canon/models.json; echo scripts/bootstrap; } \
       | LC_ALL=C sort | while IFS= read -r f; do printf '%s %s\n' "$f" "$(cksum < "$f" 2>/dev/null || echo missing)"; done)
    for dir in "${CODEX_HOME:-$HOME/.codex}" "$HOME/.gemini/antigravity-cli" "${DSH_HOME:-$HOME/.dsh}/profiles/dsh-tui"; do
      if [ -d "$dir" ]; then echo "present $dir"; else echo "absent $dir"; fi
    done
  } | cksum | awk '{ print $1 "-" $2 }'
}
do_mark_user_config() {
  mkdir -p "$CANON_HOME/watch" && uc_sources > "$UC_MARK" && note "recorded the settings step's sources: $(cat "$UC_MARK")"
}

# do_differs: what `install` and `scripts/bootstrap --user-config` would change, one line each (usage above).
# The plists are rendered by the functions install uses, into a temporary folder, and compared whole.
do_differs() {
  local d=0 u=0 t m url bin f st l p gw=0
  say() { printf '%s: %s\n' "$1" "$2"; if [ "$1" = unknown ]; then u=1; else d=1; fi; }
  t=$(mktemp -d "${TMPDIR:-/tmp}/automation-differs.XXXXXX") || { say unknown "cannot create a temporary folder"; return 2; }
  [ "$(git -C "$ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ] || say automation "commit gate: core.hooksPath is not .githooks"
  for f in "scripts/lanes:lanes" "home/.claude/canon/lanes-watch.sh:lanes-watch.sh" \
           "home/.claude/canon/paper-session.sh:paper-session.sh" "home/.claude/canon/maintenance.sh:maintenance.sh" \
           "scripts/automation:movers-recorder.sh" "home/.claude/canon/paper-session.sh:movers-checkout.sh"; do
    cmp -s "$ROOT/${f%%:*}" "$CANON_HOME/${f#*:}" || say automation "$CANON_HOME/${f#*:} differs from ${f%%:*}"
  done
  cmp -s "$ROOT/home/.claude/canon/otel/config.yaml" "$OTEL_DIR/config.yaml" || say automation "$OTEL_DIR/config.yaml differs from home/.claude/canon/otel/config.yaml"
  if ! m=$(find_mise 2>&1); then
    say unknown "$m"
  else
    write_plist "$t/w" && { cmp -s "$t/w" "$PLIST" || say automation "$PLIST differs from what install writes"; }
    write_maint_plist "$m" "$t/m" && { cmp -s "$t/m" "$MAINT_PLIST" || say automation "$MAINT_PLIST differs from what install writes"; }
    write_study_plist "$m" "$t/s" && { cmp -s "$t/s" "$STUDY_PLIST" || say automation "$STUDY_PLIST differs from what install writes"; }
    if url=$(git -C "$ROOT" remote get-url origin 2>/dev/null) && [ -n "$url" ]; then
      write_paper_plist "$m" "$url" "$t/p" && { cmp -s "$t/p" "$PAPER_PLIST" || say automation "$PAPER_PLIST differs from what install writes"; }
      write_recorder_plist "$m" "$url" "$t/r" && { cmp -s "$t/r" "$RECORDER_PLIST" || say automation "$RECORDER_PLIST differs from what install writes"; }
      [ "$(git -C "$ROOT" config --local --get-all credential.https://github.com.helper 2>/dev/null | tail -n 1)" = "!\"$m\" exec -- gh auth git-credential" ] \
        || say automation "landing: the git sign-in helper is not the one install sets"
    else
      say unknown "no origin remote, so there is no main for the paper session plist"
    fi
    # the gateway only where OmniRoute is installed, as install has it
    case "$(gw_state "$m")" in
      installed) gw=1; write_gw_plist "$m" "$t/g" && { cmp -s "$t/g" "$GW_PLIST" || say automation "$GW_PLIST differs from what install writes"; } ;;
      absent) [ ! -f "$GW_PLIST" ] || say automation "$GW_PLIST is there, but OmniRoute is not installed for this clone (install removes it)" ;;
      *) [ ! -f "$GW_PLIST" ] || say unknown "mise did not say whether OmniRoute is installed, so $GW_PLIST cannot be compared" ;;
    esac
    if bin=$(cd "$ROOT" && "$m" which otelcol 2>/dev/null) && [ -n "$bin" ] && [ -x "$bin" ]; then
      write_otel_plist "$bin" "$t/o" && { cmp -s "$t/o" "$OTEL_PLIST" || say automation "$OTEL_PLIST differs from what install writes"; }
    else
      say unknown "mise has no otelcol installed for this clone, so the collector's plist cannot be compared; run: scripts/bootstrap --install"
    fi
  fi
  rm -rf "${t:?}"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != "1" ]; then
    for l in "$LABEL" "$PAPER_LABEL" "$RECORDER_LABEL" "$OTEL_LABEL" "$MAINT_LABEL" "$GW_LABEL" "$STUDY_LABEL"; do
      [ "$l" != "$GW_LABEL" ] || [ "$gw" = 1 ] || continue
      loaded "$l"; st=$?
      if [ "$st" = 1 ]; then say automation "$l is not loaded"; elif [ "$st" = 2 ]; then say unknown "launchctl did not answer about $l"; fi
    done
  fi
  for f in ledger.sh statusline.sh fleet-rate.sh; do
    cmp -s "$ROOT/home/.claude/canon/$f" "$CLAUDE_HOME/canon/$f" || say user-config "$CLAUDE_HOME/canon/$f differs from home/.claude/canon/$f"
  done
  if [ ! -f "$UC_MARK" ]; then say user-config "no record of an earlier settings step by the maintenance agent"
  else
    p=$(uc_sources)
    [ "$(cat "$UC_MARK" 2>/dev/null)" = "$p" ] || say user-config "the settings sources (home/.claude, home/.codex, canon/models.json, scripts/bootstrap), or which runtimes' folders exist, changed since the last settings step"
  fi
  if [ "$u" = 1 ]; then return 2; fi
  return "$d"
}

do_status() {
  local bad=0 v fp
  note "Automation (ADR 0011):"

  if [ "$(git -C "$ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ] && [ -x "$ROOT/.githooks/pre-commit" ]; then
    row "commit gate" ok "git runs .githooks/pre-commit before every commit"
  else row "commit gate" OFF "run: scripts/automation install"; bad=1; fi

  if grep -q 'canon-watch.sh' "$ROOT/.claude/settings.json" 2>/dev/null && [ -x "$ROOT/.claude/hooks/canon-watch.sh" ]; then
    # the checksum .claude/hooks/canon-watch.sh records: a result is shown only for the registry and lock
    # this tree has now
    fp=$(cat "$ROOT/canon/upstreams.json" "$ROOT/canon/upstreams.lock.json" 2>/dev/null | cksum | awk '{ print $1 "-" $2 }')
    if [ -f "$ROOT/.canon/watch.json" ] && [ "$(jq -r '.registry // ""' "$ROOT/.canon/watch.json" 2>/dev/null)" != "$fp" ]; then
      check_row "landscape watch" UNKNOWN "the last result was for another registry or lock than this tree has now; it runs again at the next session start here"
    elif [ -f "$ROOT/.canon/watch.json" ]; then
      # not ok when the last run was incomplete, when the lock is stale for some pin (a resolve the owner
      # approves fixes it), or when it is older than STALE_DAYS (no session has started here since)
      v=$(jq -r --argjson now "$(date -u +%s)" --argjson stale "$STALE_DAYS" '
            (((($now - (.checked_at_epoch // (.checked_at | fromdateiso8601))) / 86400) | floor)) as $d
            | ((.stale // []) | length > 0) as $sl
            | (if .ok != true then "INCOMPLETE" elif $sl then "STALE-LOCK" elif $d > $stale then "STALE" else "ok" end) + "\t"
              + "last " + .checked_at + " (" + ($d | tostring) + " day(s) ago): "
              + (.newer | length | tostring) + " newer, " + (.advanced | length | tostring) + " advanced, "
              + (.retagged | length | tostring) + " retagged"
              + (if .ok != true then "; the run could not check everything: " + ((.errors // []) | join("; "))
                 else "" end)
              + (if $sl then "; the lock is stale for " + (.stale | join(", "))
                   + ", so those pins were not compared; fix: " + (.stale | map("scripts/canon resolve " + .) | join(", "))
                   + " (it runs without a prompt and lands only reviewed; ADR 0028)"
                 else "" end)
              + (if .ok == true and ($sl | not) and $d > $stale then "; it runs at session start in this repo" else "" end)' \
          "$ROOT/.canon/watch.json" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t.canon/watch.json is unreadable')
      check_row "landscape watch" "${v%%$'\t'*}" "${v#*$'\t'}"
    else check_row "landscape watch" UNKNOWN "registered; has not run yet (runs at the next session start in this repo)"; fi
  else check_row "landscape watch" OFF "hook missing from .claude/settings.json"; fi

  local pr prc state runs last label
  # A session's ledger hook writes under its own CLAUDE_CONFIG_DIR (ledger.sh), and the watchdog reads only the
  # folder its plist names (write_plist): sessions of a shell whose Claude config is another folder are not
  # watched at all, which the row says, never ok. The watchdog's own status file is in its folder (wd).
  local wcfg wd wmis=""
  wcfg=$(plutil -extract EnvironmentVariables.CLAUDE_CONFIG_DIR raw -o - "$PLIST" 2>/dev/null) || wcfg=""
  wd="${wcfg:-$CLAUDE_HOME}/canon/watch"
  if [ -n "$wcfg" ] && [ "$(cd "$wcfg" 2>/dev/null && pwd -P || echo "$wcfg")" != "$(cd "$CLAUDE_HOME" 2>/dev/null && pwd -P || echo "$CLAUDE_HOME")" ]; then wmis=1; fi
  prc=0; pr=$(lc print "$DOMAIN/$LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    # launchctl(1) says this output is not an API, so a value it does not show is UNKNOWN, never ok
    state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
    runs=$(printf '%s\n' "$pr" | awk -F' = ' '/^\truns = / && s == "" { s = $2 } END { print s }')
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    v="state=${state:-?}  runs=${runs:-?}  last exit code=${last:-?}"
    case "$last" in
      0) label=ok ;;
      ''|*[!0-9-]*) label=UNKNOWN; v="$v (no exit code to check)" ;;
      *) label=FAILED; v="$v; see $wd/lanes-watch.log" ;;
    esac
    if [ -f "$wd/lanes-status.json" ]; then
      v="$v | $(jq -r 'if .ok == true then "last check " + .checked_at + ": " + (.sessions | tostring) + " session(s), " + (.flagged_now | tostring) + " flagged, ledger " + (.ledger_kb | tostring) + " KB" else "LAST CHECK FAILED: " + (.error // "no error recorded") end' "$wd/lanes-status.json" 2>/dev/null)"
      jq -e '.ok == true' "$wd/lanes-status.json" >/dev/null 2>&1 || label=FAILED
      # a watchdog that hangs, or a job launchd no longer runs, leaves the last check as it was
      local age
      age=$(jq -r --argjson now "$(date -u +%s)" '($now - (.checked_at | fromdateiso8601)) | floor' "$wd/lanes-status.json" 2>/dev/null)
      if ! [[ "$age" =~ ^-?[0-9]+$ ]]; then
        [ "$label" != ok ] || label=UNKNOWN; v="$v; the last check's time is unreadable"
      elif [ "$age" -gt "$WATCH_SILENT" ]; then
        [ "$label" != ok ] || label=STALE; v="$v; no check for $((age / 60)) min (the Mac asleep, a check that hangs, or the job not running)"
      fi
    else
      [ "$label" != ok ] || label=UNKNOWN
      v="$v | no status file yet at $wd/lanes-status.json"
    fi
    if [ -n "$wmis" ]; then
      label=FAILED; v="$v; the watchdog reads $wcfg, while this shell's sessions write to $CLAUDE_HOME, so they are not watched: run scripts/automation install from this shell, or use one Claude config folder"
    fi
    check_row "lane watchdog" "$label" "$v"
  elif no_answer "$prc"; then check_row "lane watchdog" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "lane watchdog" OFF "run: scripts/automation install"; fi

  prc=0; pr=$(lc print "$DOMAIN/$PAPER_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ] && [ -z "$PAPER_DIR" ]; then
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    v="loaded, last exit code=${last:-?}, but the per-user temporary folder is not known (getconf DARWIN_USER_TEMP_DIR gave none), so the windows' records cannot be found"
    cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh" || v="$v; the installed runner differs from this tree's: run scripts/automation install"
    check_row "paper session" UNKNOWN "$v"
  elif [ "$prc" = 0 ]; then
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    # launchctl(1), list: "The second column displays the last exit status of the job. If the number in this
    # column is negative, it represents the negative of the signal which stopped the job"; launchctl print
    # then shows no exit code
    local sig lab txt heard hb_at fired o
    sig=$(lc list 2>/dev/null | awk -v l="$PAPER_LABEL" '$3 == l { print $2; exit }')
    # the last run's heartbeat, read first: a run newer than a `running` record took the paper lock after it
    hb_at=null heard=""
    if [ -f "$PAPER_DIR/last-firing.json" ]; then
      # shellcheck disable=SC2016  # jq program, not shell
      # a record without its time and outcome is unreadable, never ok (`{}` read ok, a second reader's claim)
      heard=$(jq -r --argjson now "$(date -u +%s)" "$PAPER_COMMIT"'select((.at_epoch | type) == "number" and (.outcome | type) == "string")
                    | (($now - .at_epoch) | floor | tostring) + "\t"
                    + (if .scheduled == false then "by hand: " else "" end)
                    + .outcome + (if (.commit // "") | test("^[0-9a-f]{40}") then " at " + (.commit | short) else "" end)' \
              "$PAPER_DIR/last-firing.json" 2>/dev/null)
      # only a run that held the lock counts: the runner's own failures ran nothing ("none: nothing ran")
      [[ "$heard" =~ ^-?[0-9]+$'\t' ]] \
        && hb_at=$(jq 'select((.commit // "") | startswith("none") | not) | .at_epoch | numbers' "$PAPER_DIR/last-firing.json" 2>/dev/null)
      [ -n "$hb_at" ] || hb_at=null
    fi
    if [ -f "$PAPER_DIR/latest.json" ]; then
      # the window's own record decides; a `running` one past its stale_after, or older than a run that came
      # after it (which held the paper lock, so the window was no longer running), belongs to a window that died;
      # so does a `stopping` one (a signal came and the wind-down never finished: session_window._shown_record)
      # shellcheck disable=SC2016  # jq program, not shell
      v=$(jq -r --argjson now "$(date -u +%s)" --argjson stale "$PAPER_STALE" --argjson heard "$hb_at" "$PAPER_COMMIT"'
            ((($now - (.started_epoch // 0)) / 60) | floor) as $m
            | (.result // "") as $r
            | ($heard != null and $heard > (.started_epoch // 0)) as $later
            | ($r | startswith("running") or startswith("stopping")) as $open
            | ($open and (($m * 60) > (.stale_after // $stale) or $later)) as $died
            | (if $r == "ok" then "ok" elif $died then "DIED" elif $open then "ok"
               elif ($r | startswith("refused")) then "REFUSED" else "FAILED" end) + "\t"
              + "last window " + (.started // "?") + " of " + (.strategy // "SessionMaCross")
              + " (" + ($m | tostring) + " min ago, " + (.session // "?")
              + ", account " + (.account // "not recorded" | tostring) + ", commit " + (.commit | short) + "): "
              + (if $died and ($r | startswith("stopping")) then $r + ", and it never did: the wind-down was cut short"
                   + " (a kill after the signal); the account may not be flat, and the next window starts only once it is"
                 elif $died and $later then "still running by its record, but a run after it took the paper lock, so it died;"
                   + " the account may not be flat, and the next window starts only once it is"
                 elif $died then "still running after " + ($m | tostring)
                   + " min, so it died; the next window starts only once the account is flat" else $r end)
              + (if ((.left // []) | length) > 0 then "; left: " + ((.left // []) | join(", ")) else "" end)' \
          "$PAPER_DIR/latest.json" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t%s is unreadable' "$PAPER_DIR/latest.json")
    else
      v=$(printf 'UNKNOWN\tno window has run yet (records in %s)' "$PAPER_DIR")
    fi
    lab=${v%%$'\t'*} txt=${v#*$'\t'}
    # Each check below can only make the label worse (paper_worse), so a schedule gone silent never hides a
    # window that died or failed. Failures the record cannot show: a firing that ended before Python wrote
    # anything (an empty keychain item, a lock wait run out) or was stopped by a signal, and a schedule that
    # has stopped firing. A schedule that is off (canon/paper-schedule on main, which paper:session reads at
    # every scheduled firing) is in the row as that firing's own heartbeat, "skipped: the schedule is off":
    # the firings go on, so every check here still holds. The runner stamps each scheduled firing's start in scheduled-firing.json, which no
    # run by hand writes; with no stamp, an unreadable one or one older than the longest firing and an
    # interval, the row is not ok, whatever last-firing.json says.
    case "$last" in
      0|''|*[!0-9-]*) ;;
      *) paper_worse FAILED; txt="$txt; the last firing exited $last" ;;
    esac
    if [[ "$sig" =~ ^-[0-9]+$ ]]; then paper_worse FAILED; txt="$txt; the last firing was stopped by signal ${sig#-}"; fi
    if [ ! -f "$PAPER_DIR/last-firing.json" ]; then
      paper_worse UNKNOWN; txt="$txt | no last-firing.json in $PAPER_DIR: no run has left its heartbeat"
    elif [[ "$heard" =~ ^-?[0-9]+$'\t' ]]; then   # negative within a second: at_epoch has a fraction
      # a run that failed before or outside a window (the fetch of main included) fails the row too
      o=${heard#*$'\t'}
      case "${o#by hand: }" in failed:*) paper_worse FAILED ;; esac
      txt="$txt | last run $(( ${heard%%$'\t'*} / 60 )) min ago: $o"
    else
      paper_worse UNKNOWN; txt="$txt | $PAPER_DIR/last-firing.json is unreadable"
    fi
    fired=$(jq -r --argjson now "$(date -u +%s)" '($now - .at_epoch) | floor' "$PAPER_DIR/scheduled-firing.json" 2>/dev/null)
    if [ ! -f "$PAPER_DIR/scheduled-firing.json" ]; then
      paper_worse UNKNOWN; txt="$txt | no scheduled firing recorded yet (the first comes $PAPER_INTERVAL s after install)"
    elif ! [[ "$fired" =~ ^-?[0-9]+$ ]]; then
      paper_worse UNKNOWN; txt="$txt | $PAPER_DIR/scheduled-firing.json is unreadable, so whether the schedule fires is not known"
    elif [ "$fired" -gt "$PAPER_SILENT" ]; then
      paper_worse STALE; txt="$txt | no scheduled firing for $((fired / 60)) min (the Mac asleep, or the job not running)"
    else
      txt="$txt | last scheduled firing $((fired / 60)) min ago"
      # launchd starts the next firing an interval after one ends, or after the job is loaded: with the job
      # not running and nothing written since for more than two intervals and 300 s, a firing is overdue by
      # more than one interval. What a firing writes last is its stamp, heartbeat, record or log; an install
      # rewrites the plist as it loads the job. File times, as the firing's end is in no record; GNU stat
      # -c %Y, else BSD stat -f %m (stat(1) on each)
      local pstate pend=0 pf pm
      pstate=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
      if [ "$pstate" != running ]; then
        for pf in "$PAPER_DIR/scheduled-firing.json" "$PAPER_DIR/last-firing.json" "$PAPER_DIR/latest.json" \
                  "$CANON_HOME/watch/paper-session.log" "$PAPER_PLIST"; do
          pm=$(stat -c %Y "$pf" 2>/dev/null || stat -f %m "$pf" 2>/dev/null) || continue
          [[ "$pm" =~ ^[0-9]+$ ]] || continue
          [ "$pm" -le "$pend" ] || pend=$pm
        done
        if [ "$pend" -gt 0 ]; then
          pend=$(( $(date +%s) - pend ))
          if [ "$pend" -gt $((2 * PAPER_INTERVAL + 300)) ]; then
            paper_worse STALE; txt="$txt | overdue: nothing from a scheduled firing for $((pend / 60)) min, while launchd starts one $PAPER_INTERVAL s after the last ends (the Mac asleep, or the schedule stopped)"
          fi
        fi
      fi
    fi
    # the runner launchd runs is the installed copy, which only install replaces
    if ! cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh"; then
      paper_worse OUTDATED; txt="$txt; the installed runner differs from this tree's: run scripts/automation install"
    fi
    txt="$txt | last exit code=${last:-?}; log $CANON_HOME/watch/paper-session.log"
    check_row "paper session" "$lab" "$txt"
  elif no_answer "$prc"; then check_row "paper session" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "paper session" OFF "run: scripts/automation install"; fi

  show_recorder_status

  # The collector: launchd must show it running (KeepAlive restarts it); the file's age is shown, not judged,
  # since a quiet hour with no session writes nothing.
  prc=0; pr=$(lc print "$DOMAIN/$OTEL_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    local lf="$OTEL_DIR/logs.jsonl" mt obin
    # the binary the agent runs: a move of the pin, or a mise prune, can remove it
    obin=$(plutil -extract ProgramArguments.0 raw -o - "$OTEL_PLIST" 2>/dev/null) || obin=""
    case "$state" in
      running) label=ok; v="running" ;;
      '') label=UNKNOWN; v="launchctl shows no state" ;;
      *) label=FAILED; v="state=$state, last exit code=${last:-?}; see $CANON_HOME/watch/otel-collector.log" ;;
    esac
    if [ -n "$obin" ] && [ ! -x "$obin" ]; then
      label=FAILED; v="$v; its binary $obin is gone (the otelcol pin moved?); run: scripts/bootstrap --install, then scripts/automation install"
    fi
    if [ -f "$lf" ]; then
      # the file's mtime: GNU stat -c %Y, else BSD stat -f %m (stat(1) on each)
      mt=$(stat -c %Y "$lf" 2>/dev/null || stat -f %m "$lf" 2>/dev/null) || mt=""
      if [ -n "$mt" ] && [ -z "${mt//[0-9]/}" ]; then
        v="$v | $lf last written $(( ($(date -u +%s) - mt) / 60 )) min ago"
      else v="$v | $lf present, its age unreadable"; fi
    else
      v="$v | no $lf yet: no session has sent an event (settings: scripts/bootstrap --user-config)"
    fi
    check_row "otlp collector" "$label" "$v"
  elif no_answer "$prc"; then check_row "otlp collector" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "otlp collector" OFF "run: scripts/automation install"; fi

  # The maintenance agent: its last round's record, written by maintenance.sh in the folder its plist names.
  # FAILED names each failed step; SKIPPED when the checkout was not brought to main (another branch, tracked
  # changes, commits origin lacks); a round that found a paper test's or the stream's lock held did nothing
  # and is ok. A paper section deferred while a window runs reads "deferred to the session boundary: the
  # paper checkout", ok until it has waited longer than a whole session (MAINT_BOUNDARY), then FAILED, as is
  # a boundary waiter that timed out, failed or stopped reporting (maintenance-boundary.json). The pins say
  # the versions main's registry records, or what moved and what FAILED.
  prc=0; pr=$(lc print "$DOMAIN/$MAINT_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    local mcfg mw ms mu mlab mtxt
    mcfg=$(plutil -extract EnvironmentVariables.CLAUDE_CONFIG_DIR raw -o - "$MAINT_PLIST" 2>/dev/null) || mcfg=""
    mw="${mcfg:-$CLAUDE_HOME}/canon/watch"; ms="$mw/maintenance-status.json"; mu="$mw/maintenance-updates.json"
    local mb; mb=$(jq -c 'objects' "$mw/maintenance-boundary.json" 2>/dev/null) || mb=""
    [ -n "$mb" ] || mb=null
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    maint_rank() { case "$1" in ok) echo 0 ;; UNKNOWN) echo 1 ;; SKIPPED) echo 2 ;; OUTDATED) echo 3 ;; STALE) echo 4 ;; *) echo 5 ;; esac; }
    maint_worse() { [ "$(maint_rank "$1")" -le "$(maint_rank "$mlab")" ] || mlab=$1; }
    if [ -f "$ms" ]; then
      v=$(jq -r --argjson now "$(date -u +%s)" --argjson silent "$MAINT_SILENT" --argjson step "$MAINT_STEP" \
               --argjson bound "$MAINT_BOUNDARY" --argjson b "$mb" '
            def what: map(sub("^(automation|user-config): "; "")) | join("; ");
            ((($now - .at_epoch) / 60) | floor) as $m
            | (.install // null) as $ins
            | ($ins != null and $ins.state == "started" and ($now - $ins.at_epoch) > ($step + 300)) as $lost
            | (.deferred // null) as $d
            | ($d != null and ($now - ($d.since_epoch // $now)) > $bound) as $overdue
            | (if $d == null or $b == null then ""
               elif $b.state == "waiting" and ($now - ($b.since_epoch // $now)) > ($bound + 600) then
                 "FAILED: the boundary waiter started " + ($b.since // "?") + " has not reported"
               elif $b.state == "waiting" then "a waiter waits for the windows lock (since " + ($b.since // "?") + ")"
               elif $b.state == "at the boundary" then "its round at the boundary runs"
               elif $b.state == "timed out" then "FAILED: the boundary waiter timed out at " + ($b.at // "?") + ": " + ($b.why // "")
               elif $b.state == "failed" then "FAILED: the boundary waiter at " + ($b.at // "?") + ": " + ($b.why // "")
               elif $b.state == "missed" then "at " + ($b.at // "?") + " " + ($b.why // "")
               else "" end) as $w
            | (.pins // []) as $p | ($p | map(select(test(": at ") | not))) as $pc
            | (if (.failed | length) > 0 or $lost or $overdue or ($w | startswith("FAILED")) then "FAILED" elif ($m * 60) > $silent then "STALE"
               elif .outcome == "skipped" then "SKIPPED" else "ok" end) + "\t"
              + "last round " + .at + " (" + ($m | tostring) + " min ago): " + .ff
              + (if (.found | length) > 0 then "; differed: " + (.found | what)
                 elif .outcome == "ok" then "; nothing differed from main" else "" end)
              + (if (.installed | length) > 0 then "; installed: " + (.installed | join(", ")) else "" end)
              + (if $ins != null and $ins.state == "started" then
                   (if $lost then "; the reinstall it started has not reported" else "; its reinstall is running" end)
                 else "" end)
              + (if (.failed | length) > 0 then "; FAILED: " + (.failed | join("; ")) else "" end)
              + (if (.note // "") != "" then "; " + .note else "" end)
              + (if $d != null and ((.note // "") | test("deferred to the session boundary") | not) then
                   "; deferred to the session boundary: " + ($d.what // "the paper checkout") else "" end)
              + (if $d != null then " (since " + ($d.since // "?") + ")"
                   + (if $overdue then "; FAILED: deferred for more than one whole session" else "" end)
                   + (if $w != "" then "; " + $w else "" end) else "" end)
              + (if ($p | length) == 0 then ""
                 elif ($pc | length) == 0 then "; pins at main'"'"'s registry: " + ($p | map(sub(": at "; " ")) | join(", "))
                 else "; pins: " + ($pc | join("; ")) end)
              + (if (.found | length) == 0 and .last_change != null then
                   " | last change " + .last_change.at + ": installed "
                   + (if (.last_change.installed | length) > 0 then (.last_change.installed | join(", ")) else "nothing" end)
                   + (if (.last_change.failed | length) > 0 then ", FAILED: " + (.last_change.failed | join("; ")) else "" end)
                 else "" end)' "$ms" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t%s is unreadable' "$ms")
    else
      v=$(printf 'UNKNOWN\tloaded; no round yet (the first comes %s minutes after install)' "$((MAINT_INTERVAL / 60))")
    fi
    mlab=${v%%$'\t'*} mtxt=${v#*$'\t'}
    if [ -f "$mu" ]; then
      v=$(jq -r '"updates " + .at + ": " + (.results | join("; "))' "$mu" 2>/dev/null) || v=""
      if [ -z "$v" ]; then maint_worse UNKNOWN; mtxt="$mtxt | $mu is unreadable"
      else mtxt="$mtxt | $v"; case "$v" in *FAILED:*) maint_worse FAILED ;; esac; fi
    fi
    case "$last" in
      0|''|*[!0-9-]*) ;;
      *) maint_worse FAILED; mtxt="$mtxt; the last round exited $last" ;;
    esac
    if ! cmp -s "$ROOT/home/.claude/canon/maintenance.sh" "$CANON_HOME/maintenance.sh"; then
      maint_worse OUTDATED; mtxt="$mtxt; the installed script differs from this tree's (its next round on main installs it)"
    fi
    check_row "maintenance" "$mlab" "$mtxt | log $mw/maintenance.log"
  elif no_answer "$prc"; then check_row "maintenance" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "maintenance" OFF "run: scripts/automation install"; fi

  # The OmniRoute gateway, only where install wrote its agent (OmniRoute installed): launchd must show it
  # running, and an inference route must refuse a made-up key with 401, as omniroute:check asks
  # (mise.gateway.toml; GET /v1/models follows the dashboard login, not the API key). CANON_CURL: tests only.
  if [ ! -f "$GW_PLIST" ]; then
    row "omniroute gateway" absent "no agent: OmniRoute is not installed for this clone, or install has not run since (ADR 0056)"
  else
    prc=0; pr=$(lc print "$DOMAIN/$GW_LABEL" 2>/dev/null) || prc=$?
    if [ "$prc" = 0 ]; then
      local gcode
      state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
      # (the header from a here-string, not a pipe: under pipefail a curl that never read it would fail the probe)
      gcode=$("${CANON_CURL:-/usr/bin/curl}" -q --noproxy '*' -sS -o /dev/null -w '%{http_code}' --max-time 10 -H @- -H 'Content-Type: application/json' \
            --data-binary '{}' http://127.0.0.1:20128/v1/chat/completions 2>/dev/null \
            <<<"Authorization: Bearer canon-made-up-$(/usr/bin/openssl rand -hex 16 2>/dev/null)") || gcode=000
      case "$state:$gcode" in
        running:401) label=ok; v="running on 127.0.0.1:20128, its API key required" ;;
        *:401) label=UNKNOWN; v="launchd shows state=${state:-?}, but 127.0.0.1:20128 refuses a made-up key: another copy of the gateway may hold the port" ;;
        *:000) label=FAILED; v="state=${state:-?}, and nothing answers on 127.0.0.1:20128; see $CANON_HOME/watch/omniroute.log (a missing storage key: mise -E gateway run omniroute:store)" ;;
        *) label=FAILED; v="state=${state:-?}; a made-up key got $gcode, not 401: its API key is not required" ;;
      esac
      check_row "omniroute gateway" "$label" "$v"
    elif no_answer "$prc"; then check_row "omniroute gateway" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
    else check_row "omniroute gateway" OFF "run: scripts/automation install"; fi
  fi

  # The nightly study (ADR 0089): the last night it studied, in one line the driver wrote (its date, N, T, the
  # pick's DSR, passed or not yet, and the paper windows of that day), and whether the schedule still fires.
  # FAILED for a night that failed, or a last firing that failed or exited non-zero; UNKNOWN until a first
  # night is studied; STALE when no firing left its heartbeat for the longest firing and an interval, or the
  # last night studied is older than a long weekend. A firing that waited (for the recorder, or for the gate's
  # fix) or failed is shown with its own line, which says why, beside the last night studied. A check can only
  # make the row's label worse (study_worse).
  prc=0; pr=$(lc print "$DOMAIN/$STUDY_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    local sl="$STUDY_DIR/latest.json" sf="$STUDY_DIR/last-firing.json" slab stxt sfired sage sword sline
    study_worse() { [ "$(paper_rank "$1")" -le "$(paper_rank "$slab")" ] || slab=$1; }
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    sage=""
    if [ -f "$sl" ]; then
      # shellcheck disable=SC2016  # jq program, not shell
      v=$(jq -r '(.status // "") as $s
                 | (if $s == "failed" then "FAILED" elif $s == "passed" or $s == "not yet" then "ok" else "UNKNOWN" end)
                   + "\t" + (if (.line // "") == "" then "its record has no line" else .line end)' "$sl" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t%s is unreadable' "$sl")
      # shellcheck disable=SC2016  # jq program, not shell
      sage=$(jq -r --argjson now "$(date -u +%s)" 'if (.end_ns | type) == "number" then (($now - .end_ns / 1e9) / 86400 | floor) else "" end' "$sl" 2>/dev/null) || sage=""
    else
      v=$(printf 'UNKNOWN\tno night studied yet')
    fi
    slab=${v%%$'\t'*} stxt=${v#*$'\t'}
    if [[ "$sage" =~ ^[0-9]+$ ]] && [ "$sage" -gt "$STUDY_STALE_DAYS" ]; then
      study_worse STALE; stxt="$stxt | the last night studied ended $sage days ago (the recorder, or its consolidation, may have stopped)"
    fi
    if [ -f "$sf" ]; then
      sfired=$(jq -r '(.epoch | floor | tostring) + "\t" + (.status // "?")' "$sf" 2>/dev/null) || sfired=""
      if [[ "${sfired%%$'\t'*}" =~ ^[0-9]+$ ]]; then
        sage=$(( $(date -u +%s) - ${sfired%%$'\t'*} )); sword=${sfired#*$'\t'}
        sline=$(jq -r '.line // ""' "$sf" 2>/dev/null) || sline=""
        case "$sword" in
          waiting|failed) stxt="$stxt | last firing $((sage / 60)) min ago: ${sline:-$sword}" ;;
          *) stxt="$stxt | last firing $((sage / 60)) min ago: $sword" ;;
        esac
        [ "$sword" != failed ] || study_worse FAILED
        if [ "$sage" -gt "$STUDY_SILENT" ]; then study_worse STALE; stxt="$stxt (the Mac asleep, or the job not running)"; fi
      else
        study_worse UNKNOWN; stxt="$stxt | $sf is unreadable, so whether the schedule fires is not known"
      fi
    else
      study_worse UNKNOWN; stxt="$stxt | no firing recorded yet (the first comes $((STUDY_INTERVAL / 60)) minutes after install)"
    fi
    case "$last" in
      0|''|*[!0-9-]*) ;;
      *) study_worse FAILED; stxt="$stxt; the last firing exited $last" ;;
    esac
    check_row "nightly study" "$slab" "$stxt | log $CANON_HOME/watch/nightly-study.log"
  elif no_answer "$prc"; then check_row "nightly study" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "nightly study" OFF "run: scripts/automation install"; fi

  if [ -f "$CLAUDE_HOME/scheduled-tasks/$TASK_ID/SKILL.md" ]; then
    row "weekly refresh" ok "task file present at $CLAUDE_HOME/scheduled-tasks/$TASK_ID; whether it is still scheduled shows only in the desktop app"
  else row "weekly refresh" OFF "not scheduled; ask Claude in the desktop app to schedule the landscape refresh"; bad=1; fi

  local origin mise_bin mise_err=""
  mise_bin=$(find_mise 2>/dev/null) || { mise_err=$(find_mise 2>&1); mise_bin=""; }
  if origin=$(git -C "$ROOT" remote get-url origin 2>/dev/null); then
    # scripts/land's spent_budget, read first as land reads it: GET /rate_limit is not counted against the
    # budget, and a spent one fails gh's own check, which would read as signed out (see scripts/land)
    local name limit reset when spent=""
    if [ -n "$mise_bin" ] && read -r name limit reset < <(cd "$ROOT" && "$mise_bin" exec -- gh api rate_limit --jq '.resources | to_entries[]
          | select((.key == "core" or .key == "graphql") and .value.remaining == 0)
          | "\(.key) \(.value.limit) \(.value.reset)"' 2>/dev/null) && [ -n "$reset" ]; then
      when=$(date -r "$reset" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || date -d "@$reset" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null) \
        || when="epoch $reset"
      [ "$name" = graphql ] && name=GraphQL || name=REST
      spent="GitHub's $name budget is spent (0 of $limit) until $when"
    fi
    if [ -z "$mise_bin" ]; then
      check_row "landing" UNKNOWN "cannot ask gh whether it is signed in: $mise_err"
    elif [ -n "$spent" ]; then
      check_row "landing" UNKNOWN "$spent, so scripts/land cannot land on $(repo_label "$origin") before then"
    elif (cd "$ROOT" && "$mise_bin" exec -- gh auth status >/dev/null 2>&1); then
      row "landing" ok "scripts/land: pull request, local sign-off, squash merge ($(repo_label "$origin"))"
    else row "landing" OFF "gh is not signed in, so scripts/land cannot reach $(repo_label "$origin"); run: gh auth login"; bad=1; fi
  else
    row "landing" ok "scripts/land: fast-forwards main locally (no GitHub remote)"
  fi

  if [ -f "$ROOT/.github/dependabot.yml" ] && [ -n "$origin" ]; then
    v=$(jq -r 'if (has("bot_prs") | not) then "UNKNOWN\tconfig present; the last watch ran before the bot was added, so its pull requests are not listed yet"
               elif .bot_prs == null then "UNKNOWN\tconfig present; its pull requests could not be listed at the last watch"
               else "ok\tconfig present; " + (.bot_prs | length | tostring) + " pull request(s) open at the last watch (" + .checked_at + ")" end' "$ROOT/.canon/watch.json" 2>/dev/null)
    [ -n "$v" ] || v=$(printf 'UNKNOWN\tconfig present; .canon/watch.json is missing or unreadable, so open pull requests are not known')
    check_row "dependency bot" "${v%%$'\t'*}" "${v#*$'\t'}"
  elif [ -f "$ROOT/.github/dependabot.yml" ]; then
    row "dependency bot" OFF "config present, but Dependabot needs a GitHub remote"
  else row "dependency bot" OFF ".github/dependabot.yml is missing (ADR 0016)"; bad=1; fi

  # GitHub switches a schedule off after 60 days without activity in a public repository.
  if [ -f "$ROOT/.github/workflows/watch.yml" ] && [ -n "$origin" ]; then
    # A run that is queued or in progress has no conclusion yet (missing or empty), so its status decides first.
    v=""
    # shellcheck disable=SC2016  # jq program, not shell
    [ -z "$mise_bin" ] || v=$( (cd "$ROOT" && "$mise_bin" exec -- gh run list --workflow watch.yml --limit 1 --json status,conclusion,createdAt \
            --jq '.[0] | if . == null then "UNKNOWN\tno run yet; start one with: gh workflow run watch.yml"
                         else (((now - (.createdAt | fromdateiso8601)) / 86400) | floor) as $d
                              | (.status // "") as $s | (.conclusion // "") as $c
                              | if $d > 2 then "STALE\tlast run " + ($d | tostring) + " days ago (" + (if $s == "" then "status unknown" else $s end) + "); the schedule may be off: gh workflow enable watch.yml"
                                elif $s != "" and $s != "completed" then "ok\tlast run " + .createdAt + ": " + $s
                                elif $c == "success" then "ok\tlast run " + .createdAt + ": success"
                                elif $c == "" then "UNKNOWN\tlast run " + .createdAt + ": status " + (if $s == "" then "missing" else $s end) + ", no conclusion"
                                else "FAILED\tlast run " + .createdAt + ": " + $c + "; see: gh run list --workflow watch.yml" end end') 2>/dev/null)
    [ -n "$v" ] || v=$(printf 'UNKNOWN\tthe last run could not be read from GitHub%s' "${mise_err:+: $mise_err}")
    check_row "hosted watch" "${v%%$'\t'*}" "${v#*$'\t'}"
  fi

  if [ -f "$CANON_HOME/watch/alerts.jsonl" ]; then
    note "Recent alerts:"; tail -3 "$CANON_HOME/watch/alerts.jsonl" | jq -r '"  " + .at + "  " + .lane + ": " + .flag' 2>/dev/null
  fi
  return "$bad"
}

case "${1:-}" in
  recorder-lock-path) recorder_lock_path ;;
  record-movers) shift; do_record_movers "$@" ;;
  status)    do_status ;;
  # the failures again after the status table, the last lines the owner sees, and the exit code with them
  install)   case "${2:-}" in --defer-paper) DEFER_PAPER=1 ;; '') ;; *) note "usage: scripts/automation install [--defer-paper]"; exit 2 ;; esac
             do_install; rc=$?; echo; do_status
             if [ "$rc" != 0 ]; then printf '\ninstall: FAILED (exit %s):%s\n' "$rc" "$FAILS"; fi
             exit "$rc" ;;
  uninstall) do_uninstall ;;
  differs)   do_differs ;;
  mark-user-config) do_mark_user_config ;;
  *) note "usage: scripts/automation status | install [--defer-paper] | uninstall | differs | mark-user-config"; exit 2 ;;
esac
