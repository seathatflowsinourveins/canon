#!/bin/bash
# automation — install, inspect and remove this repo's standing automation (docs/adr/0011-automation.md).
#
#   Layer                  Runs                              Mechanism (contract)
#   commit gate            on every `git commit`             .githooks/pre-commit via core.hooksPath (githooks(5))
#   landscape watch        once a day, at session start      .claude/hooks/canon-watch.sh, async SessionStart hook
#   lane watchdog          every 10 minutes, Mac awake       launchd user agent (launchd.plist(5), launchctl(1))
#   paper session          every 35 minutes, Mac awake       launchd user agent running one window, if Alpaca's
#                                                            clock says a session is open (ADR 0050)
#   OTLP collector         always, Mac awake                 launchd user agent running the pinned otelcol on
#                                                            127.0.0.1, writing ~/.claude/canon/otel/logs.jsonl
#                                                            for scripts/lanes --rates (ADR 0007)
#   weekly refresh         weekly, desktop app open          Claude desktop scheduled task (created from a session)
#
# Usage: scripts/automation status | install | uninstall
# `install` uses no sudo and touches: this clone's git config, ~/.claude/canon/ (the paper session's
# runner and its clone of origin's main, ~/.claude/canon/paper-checkout, and the collector's config,
# ~/.claude/canon/otel/config.yaml, included), and three files in ~/Library/LaunchAgents/. The collector is
# the otelcol mise installed for this clone (`scripts/bootstrap --install`), named by its absolute path. The watchdog's plist sets CLAUDE_CONFIG_DIR to the directory install used.
# `uninstall` reverses exactly that, the trust `mise run` gave the clone's mise.toml included, leaves the
# ledger, the alert history, the windows' records and the collector's logs.jsonl alone, and exits non-zero naming anything it could not
# remove.
# `status` exits non-zero when any row is not ok, including rows it could not check (UNKNOWN).
#
# Overrides: CLAUDE_CONFIG_DIR replaces ~/.claude; CANON_LAUNCHAGENTS_DIR replaces ~/Library/LaunchAgents
# and CANON_PAPER_SESSION_DIR the session windows' record folder, CANON_UNLOAD_SECS the wait for a job to
# leave launchd (default 30), CANON_LAUNCHCTL_SECS the bound on each launchctl call (default 30) and
# CANON_LOCKF lockf(1) (tests only); AUTOMATION_SKIP_LAUNCHD=1 is a rehearsal of `install` that does every step except the
# launchctl calls. mise is the one on PATH, else ~/.local/bin/mise; its absolute path goes into the git
# credential helper.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CANON_HOME="$CLAUDE_HOME/canon"
LABEL="local.canon.lanes-watch"
AGENTS_DIR="${CANON_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"   # override only for tests
PLIST="$AGENTS_DIR/$LABEL.plist"
DOMAIN="gui/$(id -u)"
INTERVAL=600
TASK_ID="canon-landscape-refresh"
PAPER_LABEL="local.canon.paper-session"
PAPER_PLIST="$AGENTS_DIR/$PAPER_LABEL.plist"
PAPER_INTERVAL=2100                                   # every 35 minutes...
PAPER_MINUTES=25                                      # ...a 25-minute window: with start-up, stop and the
                                                      # account check it ends before the next firing less
                                                      # the 300 s gap (session_window.GAP_SECS)
PAPER_STALE=4200                                      # a record `running` after 70 minutes, if it gives none
PAPER_DEADLINE=6300                                   # mise.toml's paper:session timeout, 105 minutes
# the longest firing: the runner's fetch bound, then its bound on the whole `mise run`, which is that timeout
# and its allowance for mise's own start (paper-session.sh FETCH_SECS, TASK_SECS, START_SECS)
PAPER_FIRING=$((120 + PAPER_DEADLINE + 300))
# launchd misses every interval while a firing runs (launchd.plist(5)), so the next firing starts at most one
# interval after the longest firing ends; with no stamp for longer, and 300 s more, the schedule has stopped
PAPER_SILENT=$((PAPER_FIRING + PAPER_INTERVAL + 300))
WATCH_SECS=120                                        # lanes-watch.sh's bound on the lanes report it runs
WATCH_NOTIFY_SECS=30                                  # ...and on its notification (NOTIFY_SECS)
# the watchdog stamps each check as it starts; the next starts at most an interval after the longest ends
# (each bound with the 5 s timeout -k gives a command that ignores SIGTERM)
WATCH_SILENT=$((WATCH_SECS + 5 + WATCH_NOTIFY_SECS + 5 + INTERVAL + 300))
PAPER_CHECKOUT="$CANON_HOME/paper-checkout"           # the clone each firing brings to origin's main
PAPER_DIR="${CANON_PAPER_SESSION_DIR:-$(/usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null)canon-paper-session}"
STALE_DAYS=2
OTEL_LABEL="local.canon.otel-collector"
OTEL_PLIST="$AGENTS_DIR/$OTEL_LABEL.plist"
OTEL_DIR="$CANON_HOME/otel"                           # config.yaml and the logs.jsonl scripts/lanes reads
# jq: a commit as status shows it, the first 12 of a full id plus what follows it ("with uncommitted
# changes"), or the text a record gives in its place ("unknown: <why>")
# shellcheck disable=SC2016  # jq program, not shell
PAPER_COMMIT='def short: (. // "not recorded") as $c | if ($c | test("^[0-9a-f]{40}")) then $c[0:12] + $c[40:] else $c end; '

# note: prints a line; one that reports a failure (FAILED: or SKIPPED:) is kept in FAILS too, so install can
# repeat it after the status table, where the owner's eye ends
FAILS=""
note() { printf '%s\n' "$*"; case "$*" in *FAILED:*|*SKIPPED:*) FAILS="$FAILS"$'\n'"$*" ;; esac; }

# lc <launchctl arguments>: launchctl, each call bounded at LAUNCHCTL_SECS by timeout(1) (SIGTERM, then
# SIGKILL 5 s later), so a launchd that does not answer fails the call, exit 124 or 137, instead of holding
# install, uninstall or status (a bound on the wait below bounds no single call in it)
LAUNCHCTL_SECS=${CANON_LAUNCHCTL_SECS:-30}
case "$LAUNCHCTL_SECS" in ''|*[!0-9]*) LAUNCHCTL_SECS=30 ;; esac
# --foreground: launchctl stays in the caller's process group, so a Ctrl-C at install reaches it (timeout(1))
lc() { /usr/bin/timeout --foreground -k 5 "$LAUNCHCTL_SECS" launchctl "$@"; }
# no_answer <rc>: whether lc ended at its bound
no_answer() { [ "$1" = 124 ] || [ "$1" = 137 ]; }
# loaded <label>: 0 when `launchctl print` finds the label, 2 when it did not answer, 1 otherwise
loaded() { local rc=0; lc print "$DOMAIN/$1" >/dev/null 2>&1 || rc=$?; if [ "$rc" = 0 ]; then return 0; elif no_answer "$rc"; then return 2; fi; return 1; }
# unload <label>: `launchctl bootout`, then wait, at most UNLOAD_SECS of elapsed time, until `launchctl print`
# no longer finds the label. bootout returns while a running job is still stopping, and a bootstrap of the
# same label then fails with 5, Input/output error (observed on this Mac with a throwaway label whose job
# takes 4 s to exit on SIGTERM); the kept-alive collector is such a job. Returns 0 when the label is gone; 2,
# with launchctl's message in UNLOAD_ERR, when bootout was refused for a label print still finds; 3 when
# launchctl did not answer within LAUNCHCTL_SECS; 1 when the label is still loaded once the wait is over.
# UNLOAD_ABSENT=1 says there was nothing to unload.
# the lock(1) that tells whether a window still runs from the paper clone (CANON_LOCKF: tests only)
LOCKF=${CANON_LOCKF:-/usr/bin/lockf}
UNLOAD_SECS=${CANON_UNLOAD_SECS:-30}
case "$UNLOAD_SECS" in ''|*[!0-9]*) UNLOAD_SECS=30 ;; esac
UNLOAD_ERR="" UNLOAD_ABSENT=0
unload() {
  local end=$((SECONDS + UNLOAD_SECS)) rc=0 st
  UNLOAD_ABSENT=0
  UNLOAD_ERR=$(lc bootout "$DOMAIN/$1" 2>&1) || rc=$?
  if no_answer "$rc"; then return 3; fi
  if [ "$rc" != 0 ]; then
    loaded "$1"; st=$?
    if [ "$st" = 1 ]; then UNLOAD_ABSENT=1; return 0; fi   # it was not loaded
    [ "$st" != 2 ] || return 3
    UNLOAD_ERR=${UNLOAD_ERR//$'\n'/; }; return 2
  fi
  while :; do
    loaded "$1"; st=$?
    [ "$st" != 1 ] || return 0
    [ "$st" != 2 ] || return 3
    [ "$SECONDS" -lt "$end" ] || return 1
    sleep 0.5
  done
}
# unload_note <label> <rc of unload>: the line a failed unload gets
unload_note() {
  case "$2" in
    2) note "  FAILED: launchctl bootout refused $1: ${UNLOAD_ERR:-no message}; run: scripts/automation install" ;;
    3) note "  FAILED: launchctl did not answer within ${LAUNCHCTL_SECS} s about $1, so the new one was not loaded; run: scripts/automation install" ;;
    *) note "  FAILED: the earlier $1 was still stopping after ${UNLOAD_SECS} s, so the new one was not loaded; run: scripts/automation install" ;;
  esac
}
# boot <label> <plist> <what loaded says>: bootstrap the plist; on a refusal it says plainly what launchd has
# loaded for the label now, and what to run
boot() {
  local rc=0 st
  lc bootstrap "$DOMAIN" "$2" || rc=$?
  if [ "$rc" = 0 ]; then note "  loaded     $1 $3"; return 0; fi
  if no_answer "$rc"; then
    note "  FAILED: launchctl bootstrap of $1 did not answer within ${LAUNCHCTL_SECS} s; whether it is loaded is not known; run: scripts/automation install"; return 1
  fi
  loaded "$1"; st=$?
  if [ "$st" = 0 ]; then
    note "  FAILED: launchctl bootstrap refused $1; launchd still has a job loaded for it, not this install's; run: scripts/automation install"
  elif [ "$st" = 2 ]; then note "  FAILED: launchctl bootstrap refused $1, and launchctl did not answer whether anything is loaded for it; run: scripts/automation install"
  else note "  FAILED: launchctl bootstrap refused $1; nothing is loaded for it now; run: scripts/automation install"; fi
  return 1
}
# load <label> <plist> <what loaded says>: unload any earlier job of the label, then boot the plist
load() {
  local rc
  unload "$1"; rc=$?
  if [ "$rc" != 0 ]; then unload_note "$1" "$rc"; return 1; fi
  boot "$1" "$2" "$3"
}
row() { printf '  %-18s %-9s %s\n' "$1" "$2" "$3"; }
# check_row <name> <label> <text>: prints the row and counts any label but ok as unhealthy
check_row() { row "$1" "$2" "$3"; [ "$2" = ok ] || bad=1; }
# paper_worse <label>: the paper row's label becomes <label> when that is worse than the one it has ($lab)
# (a refusal exits 1 too, so REFUSED outranks the FAILED that exit code gives)
paper_rank() { case "$1" in ok) echo 0 ;; UNKNOWN) echo 1 ;; OUTDATED) echo 2 ;; STALE) echo 3 ;; REFUSED) echo 5 ;; DIED) echo 6 ;; *) echo 4 ;; esac; }
paper_worse() { [ "$(paper_rank "$1")" -le "$(paper_rank "$lab")" ] || lab=$1; }

# find_mise -> absolute path of mise: the one on PATH first, then ~/.local/bin/mise. Fails with a message
# when there is neither, or when the path holds a character that cannot be quoted in a git helper.
find_mise() {
  local m
  m=$(command -v mise 2>/dev/null) || m=""
  if [ -n "$m" ]; then
    case "$m" in /*) ;; *) m="$(cd "$(dirname "$m")" && pwd)/$(basename "$m")" ;; esac
  elif [ -x "$HOME/.local/bin/mise" ]; then
    m="$HOME/.local/bin/mise"
  else
    echo "mise not found on PATH or at $HOME/.local/bin/mise; run: scripts/bootstrap --install" >&2; return 1
  fi
  case "$m" in *[\"\$\`\\]*) echo "mise path $m holds a quote, \$, backquote or backslash; not supported" >&2; return 1 ;; esac
  printf '%s\n' "$m"
}

# host_path <url>: the URL as a message names it: scheme, user information (RFC 3986 section 3.2.1: before
# an @ in the authority, the part before the first /), query and fragment dropped
host_path() {
  local u=$1 a; [[ "$u" == *://* ]] && u=${u#*://}
  a=${u%%/*}; u=${a##*@}${u#"$a"}; printf '%s' "${u%%[?#]*}"
}

xml() { local s=${1//&/\&amp;}; s=${s//</\&lt;}; printf '%s' "${s//>/\&gt;}"; }

# The agent gets CLAUDE_CONFIG_DIR (launchd.plist(5) EnvironmentVariables), so the watchdog and the
# installed lanes read the same directory this install wrote to; they find it the way every script here does.
write_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$c/lanes-watch.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CLAUDE_CONFIG_DIR</key>
    <string>$(xml "$CLAUDE_HOME")</string>
  </dict>
  <key>StartInterval</key>
  <integer>$INTERVAL</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$c/watch/lanes-watch.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/lanes-watch.log</string>
</dict>
</plist>
EOF
}

# The session window agent runs ~/.claude/canon/paper-session.sh, which brings its own clone to the main the
# origin has at that firing, or fails the firing, and runs `mise run paper:session --session auto` there:
# the task reads the paper pair from the login keychain, takes the paper lock and runs one window, or prints
# "nothing to run" when Alpaca's clock says no session is open (weekends and holidays included). Not run at
# load. No checkout a person uses is read or written (ADR 0050). CANON_PAPER_SCHEDULED=1 (launchd.plist(5),
# EnvironmentVariables) tells the runner and the window that the schedule started them: only they stamp the
# firing and write the records status reads.
# write_paper_plist <mise> <origin url>
write_paper_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "$PAPER_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$PAPER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$c/paper-session.sh</string>
    <string>$(xml "$1")</string>
    <string>$(xml "$PAPER_CHECKOUT")</string>
    <string>$(xml "$2")</string>
    <string>--session</string>
    <string>auto</string>
    <string>--minutes</string>
    <string>$PAPER_MINUTES</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CANON_PAPER_SCHEDULED</key>
    <string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$c</string>
  <key>StartInterval</key>
  <integer>$PAPER_INTERVAL</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$c/watch/paper-session.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/paper-session.log</string>
</dict>
</plist>
EOF
}

# The collector agent runs otelcol with the config from home/.claude/canon/otel/, kept alive by launchd
# (launchd.plist(5) KeepAlive, RunAtLoad; KeepAlive true, so a SIGKILL or a clean exit is restarted too);
# CANON_OTEL_DIR tells the config where to write logs.jsonl. Its own log, at service.telemetry.logs.level
# warn, is empty while it runs well; a failed start (a port in use) writes about 440 bytes, and
# ThrottleInterval spawns it at most once a minute, so a restart loop adds at most about 0.63 MB a day
# (1440 x 440 B) until the next install empties the file (ADR 0007).
# write_otel_plist <otelcol path>
OTEL_THROTTLE=60
write_otel_plist() {
  local c; c=$(xml "$CANON_HOME")
  cat > "$OTEL_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$OTEL_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$1")</string>
    <string>--config</string>
    <string>$(xml "$OTEL_DIR")/config.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CANON_OTEL_DIR</key>
    <string>$(xml "$OTEL_DIR")</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$(xml "$OTEL_DIR")</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>$OTEL_THROTTLE</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$c/watch/otel-collector.log</string>
  <key>StandardErrorPath</key>
  <string>$c/watch/otel-collector.log</string>
</dict>
</plist>
EOF
}

# install_otel: installs the collector's config and agent; returns 1 naming what failed. The config is
# validated before it replaces the installed one, so a refused config never reaches a running agent; on a
# failure before the plist is written, an agent loaded by an earlier install is left as it was, and says so.
# The plist names the versioned binary mise installed, so a move of the otelcol pin needs this install again
# (status says FAILED when that binary is gone).
install_otel() {
  local m bin out src="$ROOT/home/.claude/canon/otel/config.yaml" prev=""
  [ -e "$OTEL_PLIST" ] && prev=" (an agent from an earlier install is left as it was)"
  if ! m=$(find_mise 2>&1); then note "  FAILED: $m$prev"; return 1; fi
  if ! bin=$(cd "$ROOT" && "$m" which otelcol 2>/dev/null) || [ -z "$bin" ] || [ ! -x "$bin" ]; then
    note "  FAILED: mise has no otelcol installed for this clone; run: scripts/bootstrap --install$prev"; return 1
  fi
  mkdir -p "$OTEL_DIR" || { note "  FAILED: cannot create $OTEL_DIR$prev"; return 1; }
  if ! out=$(CANON_OTEL_DIR="$OTEL_DIR" "$bin" validate --config "$src" 2>&1); then
    note "  FAILED: otelcol validate refused the config: ${out//$'\n'/; }$prev"; return 1
  fi
  if ! /usr/bin/install -m 644 "$src" "$OTEL_DIR/config.yaml"; then
    note "  FAILED: could not install $OTEL_DIR/config.yaml$prev"; return 1
  fi
  note "  installed  $OTEL_DIR/config.yaml"
  # the collector's own log, which launchd only appends to, starts again with each install
  : > "$CANON_HOME/watch/otel-collector.log" 2>/dev/null || true
  if ! write_otel_plist "$bin" || ! plutil -lint "$OTEL_PLIST" >/dev/null; then
    note "  FAILED: could not write a valid $OTEL_PLIST"; return 1
  fi
  note "  wrote      $OTEL_PLIST ($bin)"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"; return 0; fi
  load "$OTEL_LABEL" "$OTEL_PLIST" "(kept running; OTLP on 127.0.0.1:4317 and :4318, writing $OTEL_DIR/logs.jsonl)"
}

do_install() {
  local ok=0
  note "Commit gate:"
  if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    if git -C "$ROOT" config --local core.hooksPath .githooks; then note "  core.hooksPath = .githooks (this clone only)"
    else note "  FAILED: could not set core.hooksPath"; ok=1; fi
  else
    note "  SKIPPED: $ROOT is not a git repository"; ok=1
  fi

  note "Lane watchdog:"
  mkdir -p "$CANON_HOME/watch" "$AGENTS_DIR" || { note "  FAILED: cannot create directories"; return 1; }
  local f
  for f in "scripts/lanes:lanes" "home/.claude/canon/lanes-watch.sh:lanes-watch.sh"; do
    if /usr/bin/install -m 755 "$ROOT/${f%%:*}" "$CANON_HOME/${f#*:}"; then note "  installed  $CANON_HOME/${f#*:}"
    else note "  FAILED: could not install $CANON_HOME/${f#*:}"; ok=1; fi
  done
  write_plist || { note "  FAILED: could not write $PLIST"; return 1; }
  if ! plutil -lint "$PLIST" >/dev/null; then note "  FAILED: generated plist is invalid"; return 1; fi
  note "  wrote      $PLIST"
  if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then      # rehearsal: every step except the launchctl calls
    note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"
  else
    load "$LABEL" "$PLIST" "(every $((INTERVAL / 60)) minutes; first run now)" || ok=1
  fi
  note "Paper session:"
  local paper_mise paper_url out
  if ! paper_mise=$(find_mise 2>&1); then
    note "  FAILED: $paper_mise"; ok=1
  elif ! paper_url=$(git -C "$ROOT" remote get-url origin 2>/dev/null) || [ -z "$paper_url" ]; then
    note "  FAILED: no origin remote, so there is no main to fetch for the windows"; ok=1
  else
    # the old job is unloaded before anything it runs is replaced, so no firing of it runs the new runner or
    # the clone while install moves them; one that would not unload leaves all of them as they were
    local paper_unloaded=0
    if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" != "1" ]; then unload "$PAPER_LABEL"; paper_unloaded=$?; fi
    if [ "$paper_unloaded" != 0 ]; then
      unload_note "$PAPER_LABEL" "$paper_unloaded"; ok=1
      note "  kept       $CANON_HOME/paper-session.sh, $PAPER_CHECKOUT and $PAPER_PLIST as they were, under the job still loaded"
    elif ! /usr/bin/install -m 755 "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh"; then
      note "  FAILED: could not install $CANON_HOME/paper-session.sh"; ok=1
    else
      note "  installed  $CANON_HOME/paper-session.sh"
      if ! out=$(/bin/bash "$CANON_HOME/paper-session.sh" --checkout-only "$paper_mise" "$PAPER_CHECKOUT" "$paper_url" 2>&1); then
        # no plist left behind for launchd to load at the next login, the old main-checkout one included
        rm -f "$PAPER_PLIST"
        note "  FAILED: ${out//$'\n'/; } (not loaded; $PAPER_PLIST removed)"; ok=1
      else
        note "  ${out#paper-session: }"
        if ! write_paper_plist "$paper_mise" "$paper_url" || ! plutil -lint "$PAPER_PLIST" >/dev/null; then
          note "  FAILED: could not write a valid $PAPER_PLIST"; ok=1
        else
          note "  wrote      $PAPER_PLIST"
          if [ "${AUTOMATION_SKIP_LAUNCHD:-0}" = "1" ]; then
            note "  not loaded (AUTOMATION_SKIP_LAUNCHD=1)"
          else
            boot "$PAPER_LABEL" "$PAPER_PLIST" "(every $((PAPER_INTERVAL / 60)) minutes; a window only when a session is open)" || ok=1
          fi
        fi
      fi
    fi
  fi
  note "OTLP collector:"
  install_otel || ok=1
  note "Landing:"
  local mise_bin
  if ! git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    note "  no GitHub remote; scripts/land fast-forwards main locally"
  elif ! mise_bin=$(find_mise 2>&1); then
    note "  FAILED: $mise_bin"; ok=1
  elif git -C "$ROOT" config --local --replace-all credential.https://github.com.helper "" \
       && git -C "$ROOT" config --local --add credential.https://github.com.helper "!\"$mise_bin\" exec -- gh auth git-credential"; then
    # Lets git use gh's sign-in for github.com in this repository only (what `gh auth setup-git` does
    # globally), routed through mise so it survives a change of gh version.
    note "  git uses gh's sign-in for github.com in this repository (through $mise_bin)"
  else
    note "  FAILED: could not set the git credential helper"; ok=1
  fi
  note "Landscape watch: registered in .claude/settings.json; nothing to install."
  note "Weekly refresh: created from a Claude desktop session, not from this script."
  return "$ok"
}

# do_uninstall: returns 1, naming what is left, when any removal fails. The files a job runs are removed only
# once its job is unloaded: removed under a job still loaded, they left launchd firing it at programs that
# were gone (a second reader's claim), and a retry would find nothing to tell it what to unload.
do_uninstall() {
  local left="" f l rc still="" fs
  for l in "$LABEL" "$PAPER_LABEL" "$OTEL_LABEL"; do
    unload "$l"; rc=$?
    case "$rc" in
      0) if [ "$UNLOAD_ABSENT" = 1 ]; then note "  $l was not loaded"; else note "  unloaded   $l"; fi; continue ;;
      2) note "  FAILED: launchctl bootout refused $l: ${UNLOAD_ERR:-no message}" ;;
      3) note "  FAILED: launchctl did not answer within ${LAUNCHCTL_SECS} s about $l" ;;
      *) note "  FAILED: $l is still loaded after ${UNLOAD_SECS} s" ;;
    esac
    still="$still $l "; left="$left
  launchd job $l"
  done
  for l in "$LABEL" "$PAPER_LABEL" "$OTEL_LABEL"; do
    case "$l" in
      "$LABEL") fs="$PLIST|$CANON_HOME/lanes|$CANON_HOME/lanes-watch.sh" ;;
      "$PAPER_LABEL") fs="$PAPER_PLIST|$CANON_HOME/paper-session.sh" ;;
      *) fs="$OTEL_PLIST|$OTEL_DIR/config.yaml" ;;
    esac
    if [[ "$still" == *" $l "* ]]; then
      note "  kept       ${fs//|/, }: $l is still loaded and runs them; run uninstall again once it is not"
      left="$left
  ${fs//|/, }"; continue
    fi
    local IFS='|'
    for f in $fs; do
      [ -e "$f" ] || continue
      if rm -f "$f" && [ ! -e "$f" ]; then note "  removed    $f"
      else note "  FAILED: could not remove $f"; left="$left
  $f"; fi
    done
    unset IFS
  done
  # marked <git dir>: as the runner's own check (home/.claude/canon/paper-session.sh), a git directory, not a
  # link, whose config carries the mark; a run stopped part way leaves it as .git.old or .git.new
  marked() { [ -d "$1" ] && [ ! -L "$1" ] && [ "$(git config --file "$1/config" --get canon.paperCheckout 2>/dev/null)" = true ]; }
  if [ ! -e "$PAPER_CHECKOUT" ]; then :
  elif [[ "$still" == *" $PAPER_LABEL "* ]]; then
    note "  kept       $PAPER_CHECKOUT: $PAPER_LABEL is still loaded and runs from it"
    left="$left
  $PAPER_CHECKOUT"
  else
    local m
    # only the clone install made: its own git config marks it
    if ! marked "$PAPER_CHECKOUT/.git" && ! marked "$PAPER_CHECKOUT/.git.old" && ! marked "$PAPER_CHECKOUT/.git.new"; then
      note "  FAILED: $PAPER_CHECKOUT is not the clone install made; not touching it"; left="$left
  $PAPER_CHECKOUT"
    # with no lockf, whether a window runs from it cannot be told, so it is kept (AGENTS.md rule 5; a second
    # reader, Codex, found the removal went ahead)
    elif [ ! -x "$LOCKF" ]; then
      note "  FAILED: no $LOCKF to tell whether a window still runs from $PAPER_CHECKOUT; not removing it"
      left="$left
  $PAPER_CHECKOUT"
    # a window still running from it holds its lock (paper-session.sh), even after the bootout above
    elif ! "$LOCKF" -k -t 0 "$PAPER_CHECKOUT.lock" true 2>/dev/null; then
      note "  FAILED: a window is still running from $PAPER_CHECKOUT; not removing it (run uninstall again once it ends)"
      left="$left
  $PAPER_CHECKOUT"
    else
      # `mise run` trusted the clone's mise.toml at its first firing (mise trust docs); that goes with it.
      # mise refuses to untrust a path that is not there, and a clone with no mise.toml never ran mise.
      if [ ! -e "$PAPER_CHECKOUT/mise.toml" ]; then :
      elif ! m=$(find_mise 2>&1); then note "  FAILED: $m, so the clone's mise trust stays"; left="$left
  mise trust of $PAPER_CHECKOUT/mise.toml"
      elif "$m" trust --untrust "$PAPER_CHECKOUT/mise.toml" >/dev/null 2>&1; then note "  untrusted  $PAPER_CHECKOUT/mise.toml (mise)"
      else note "  FAILED: mise could not untrust $PAPER_CHECKOUT/mise.toml"; left="$left
  mise trust of $PAPER_CHECKOUT/mise.toml"; fi
      if rm -rf "$PAPER_CHECKOUT" "$PAPER_CHECKOUT.lock" && [ ! -e "$PAPER_CHECKOUT" ]; then note "  removed    $PAPER_CHECKOUT"
      else note "  FAILED: could not remove $PAPER_CHECKOUT"; left="$left
  $PAPER_CHECKOUT"; fi
    fi
  fi
  if [ "$(git -C "$ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ]; then
    if git -C "$ROOT" config --local --unset core.hooksPath; then note "  unset      core.hooksPath"
    else note "  FAILED: could not unset core.hooksPath"; left="$left
  core.hooksPath in $ROOT"; fi
  fi
  if git -C "$ROOT" config --local --get-all credential.https://github.com.helper >/dev/null 2>&1; then
    if git -C "$ROOT" config --local --unset-all credential.https://github.com.helper; then
      note "  unset      git sign-in helper for github.com (this repository only)"
    else note "  FAILED: could not unset the git sign-in helper"; left="$left
  credential.https://github.com.helper in $ROOT"; fi
  fi
  note "Left in place: $CANON_HOME/ledger, $CANON_HOME/watch (alert history), the session windows' records"
  note "in $PAPER_DIR, $OTEL_DIR/logs.jsonl (and its rotated copies) and the weekly scheduled task."
  note "Remove the weekly task from the desktop app's Scheduled list."
  if [ -n "$left" ]; then note "uninstall: not removed:$left"; return 1; fi
}

do_status() {
  local bad=0 v fp
  note "Automation (ADR 0011):"

  if [ "$(git -C "$ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ] && [ -x "$ROOT/.githooks/pre-commit" ]; then
    row "commit gate" ok "git runs .githooks/pre-commit before every commit"
  else row "commit gate" OFF "run: scripts/automation install"; bad=1; fi

  if grep -q 'canon-watch.sh' "$ROOT/.claude/settings.json" 2>/dev/null && [ -x "$ROOT/.claude/hooks/canon-watch.sh" ]; then
    # the checksum .claude/hooks/canon-watch.sh records: a result is shown only for the registry and lock
    # this tree has now
    fp=$(cat "$ROOT/canon/upstreams.json" "$ROOT/canon/upstreams.lock.json" 2>/dev/null | cksum | awk '{ print $1 "-" $2 }')
    if [ -f "$ROOT/.canon/watch.json" ] && [ "$(jq -r '.registry // ""' "$ROOT/.canon/watch.json" 2>/dev/null)" != "$fp" ]; then
      check_row "landscape watch" UNKNOWN "the last result was for another registry or lock than this tree has now; it runs again at the next session start here"
    elif [ -f "$ROOT/.canon/watch.json" ]; then
      # not ok when the last run was incomplete, when the lock is stale for some pin (a resolve the owner
      # approves fixes it), or when it is older than STALE_DAYS (no session has started here since)
      v=$(jq -r --argjson now "$(date -u +%s)" --argjson stale "$STALE_DAYS" '
            (((($now - (.checked_at_epoch // (.checked_at | fromdateiso8601))) / 86400) | floor)) as $d
            | ((.stale // []) | length > 0) as $sl
            | (if .ok != true then "INCOMPLETE" elif $sl then "STALE-LOCK" elif $d > $stale then "STALE" else "ok" end) + "\t"
              + "last " + .checked_at + " (" + ($d | tostring) + " day(s) ago): "
              + (.newer | length | tostring) + " newer, " + (.advanced | length | tostring) + " advanced, "
              + (.retagged | length | tostring) + " retagged"
              + (if .ok != true then "; the run could not check everything: " + ((.errors // []) | join("; "))
                 else "" end)
              + (if $sl then "; the lock is stale for " + (.stale | join(", "))
                   + ", so those pins were not compared; fix: " + (.stale | map("scripts/canon resolve " + .) | join(", "))
                   + " (it runs without a prompt and lands only reviewed; ADR 0028)"
                 else "" end)
              + (if .ok == true and ($sl | not) and $d > $stale then "; it runs at session start in this repo" else "" end)' \
          "$ROOT/.canon/watch.json" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t.canon/watch.json is unreadable')
      check_row "landscape watch" "${v%%$'\t'*}" "${v#*$'\t'}"
    else check_row "landscape watch" UNKNOWN "registered; has not run yet (runs at the next session start in this repo)"; fi
  else check_row "landscape watch" OFF "hook missing from .claude/settings.json"; fi

  local pr prc state runs last label
  prc=0; pr=$(lc print "$DOMAIN/$LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    # launchctl(1) says this output is not an API, so a value it does not show is UNKNOWN, never ok
    state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
    runs=$(printf '%s\n' "$pr" | awk -F' = ' '/^\truns = / && s == "" { s = $2 } END { print s }')
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    v="state=${state:-?}  runs=${runs:-?}  last exit code=${last:-?}"
    case "$last" in
      0) label=ok ;;
      ''|*[!0-9-]*) label=UNKNOWN; v="$v (no exit code to check)" ;;
      *) label=FAILED; v="$v; see $CANON_HOME/watch/lanes-watch.log" ;;
    esac
    if [ -f "$CANON_HOME/watch/lanes-status.json" ]; then
      v="$v | $(jq -r 'if .ok == true then "last check " + .checked_at + ": " + (.sessions | tostring) + " session(s), " + (.flagged_now | tostring) + " flagged, ledger " + (.ledger_kb | tostring) + " KB" else "LAST CHECK FAILED: " + (.error // "no error recorded") end' "$CANON_HOME/watch/lanes-status.json" 2>/dev/null)"
      jq -e '.ok == true' "$CANON_HOME/watch/lanes-status.json" >/dev/null 2>&1 || label=FAILED
      # a watchdog that hangs, or a job launchd no longer runs, leaves the last check as it was
      local age
      age=$(jq -r --argjson now "$(date -u +%s)" '($now - (.checked_at | fromdateiso8601)) | floor' "$CANON_HOME/watch/lanes-status.json" 2>/dev/null)
      if ! [[ "$age" =~ ^-?[0-9]+$ ]]; then
        [ "$label" != ok ] || label=UNKNOWN; v="$v; the last check's time is unreadable"
      elif [ "$age" -gt "$WATCH_SILENT" ]; then
        [ "$label" != ok ] || label=STALE; v="$v; no check for $((age / 60)) min (the Mac asleep, a check that hangs, or the job not running)"
      fi
    else
      [ "$label" != ok ] || label=UNKNOWN
      v="$v | no status file yet at $CANON_HOME/watch/lanes-status.json"
    fi
    check_row "lane watchdog" "$label" "$v"
  elif no_answer "$prc"; then check_row "lane watchdog" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "lane watchdog" OFF "run: scripts/automation install"; fi

  prc=0; pr=$(lc print "$DOMAIN/$PAPER_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    # launchctl(1), list: "The second column displays the last exit status of the job. If the number in this
    # column is negative, it represents the negative of the signal which stopped the job"; launchctl print
    # then shows no exit code
    local sig lab txt heard hb_at fired o
    sig=$(lc list 2>/dev/null | awk -v l="$PAPER_LABEL" '$3 == l { print $2; exit }')
    # the last run's heartbeat, read first: a run newer than a `running` record took the paper lock after it
    hb_at=null heard=""
    if [ -f "$PAPER_DIR/last-firing.json" ]; then
      # shellcheck disable=SC2016  # jq program, not shell
      # a record without its time and outcome is unreadable, never ok (`{}` read ok, a second reader's claim)
      heard=$(jq -r --argjson now "$(date -u +%s)" "$PAPER_COMMIT"'select((.at_epoch | type) == "number" and (.outcome | type) == "string")
                    | (($now - .at_epoch) | floor | tostring) + "\t"
                    + (if .scheduled == false then "by hand: " else "" end)
                    + .outcome + (if (.commit // "") | test("^[0-9a-f]{40}") then " at " + (.commit | short) else "" end)' \
              "$PAPER_DIR/last-firing.json" 2>/dev/null)
      # only a run that held the lock counts: the runner's own failures ran nothing ("none: nothing ran")
      [[ "$heard" =~ ^-?[0-9]+$'\t' ]] \
        && hb_at=$(jq 'select((.commit // "") | startswith("none") | not) | .at_epoch | numbers' "$PAPER_DIR/last-firing.json" 2>/dev/null)
      [ -n "$hb_at" ] || hb_at=null
    fi
    if [ -f "$PAPER_DIR/latest.json" ]; then
      # the window's own record decides; a `running` one past its stale_after, or older than a run that came
      # after it (which held the paper lock, so the window was no longer running), belongs to a window that died
      # shellcheck disable=SC2016  # jq program, not shell
      v=$(jq -r --argjson now "$(date -u +%s)" --argjson stale "$PAPER_STALE" --argjson heard "$hb_at" "$PAPER_COMMIT"'
            ((($now - (.started_epoch // 0)) / 60) | floor) as $m
            | (.result // "") as $r
            | ($heard != null and $heard > (.started_epoch // 0)) as $later
            | (($r | startswith("running")) and (($m * 60) > (.stale_after // $stale) or $later)) as $died
            | (if $r == "ok" then "ok" elif $died then "DIED" elif ($r | startswith("running")) then "ok"
               elif ($r | startswith("refused")) then "REFUSED" else "FAILED" end) + "\t"
              + "last window " + (.started // "?") + " (" + ($m | tostring) + " min ago, " + (.session // "?")
              + ", commit " + (.commit | short) + "): "
              + (if $died and $later then "still running by its record, but a run after it took the paper lock, so it died;"
                   + " the account may not be flat, and the next window starts only once it is"
                 elif $died then "still running after " + ($m | tostring)
                   + " min, so it died; the next window starts only once the account is flat" else $r end)
              + (if ((.left // []) | length) > 0 then "; left: " + ((.left // []) | join(", ")) else "" end)' \
          "$PAPER_DIR/latest.json" 2>/dev/null)
      [ -n "$v" ] || v=$(printf 'UNKNOWN\t%s is unreadable' "$PAPER_DIR/latest.json")
    else
      v=$(printf 'UNKNOWN\tno window has run yet (records in %s)' "$PAPER_DIR")
    fi
    lab=${v%%$'\t'*} txt=${v#*$'\t'}
    # Each check below can only make the label worse (paper_worse), so a schedule gone silent never hides a
    # window that died or failed. Failures the record cannot show: a firing that ended before Python wrote
    # anything (an empty keychain item, a lock wait run out) or was stopped by a signal, and a schedule that
    # has stopped firing. The runner stamps each scheduled firing's start in scheduled-firing.json, which no
    # run by hand writes; with no stamp, an unreadable one or one older than the longest firing and an
    # interval, the row is not ok, whatever last-firing.json says.
    case "$last" in
      0|''|*[!0-9-]*) ;;
      *) paper_worse FAILED; txt="$txt; the last firing exited $last" ;;
    esac
    if [[ "$sig" =~ ^-[0-9]+$ ]]; then paper_worse FAILED; txt="$txt; the last firing was stopped by signal ${sig#-}"; fi
    if [ ! -f "$PAPER_DIR/last-firing.json" ]; then
      paper_worse UNKNOWN; txt="$txt | no last-firing.json in $PAPER_DIR: no run has left its heartbeat"
    elif [[ "$heard" =~ ^-?[0-9]+$'\t' ]]; then   # negative within a second: at_epoch has a fraction
      # a run that failed before or outside a window (the fetch of main included) fails the row too
      o=${heard#*$'\t'}
      case "${o#by hand: }" in failed:*) paper_worse FAILED ;; esac
      txt="$txt | last run $(( ${heard%%$'\t'*} / 60 )) min ago: $o"
    else
      paper_worse UNKNOWN; txt="$txt | $PAPER_DIR/last-firing.json is unreadable"
    fi
    fired=$(jq -r --argjson now "$(date -u +%s)" '($now - .at_epoch) | floor' "$PAPER_DIR/scheduled-firing.json" 2>/dev/null)
    if [ ! -f "$PAPER_DIR/scheduled-firing.json" ]; then
      paper_worse UNKNOWN; txt="$txt | no scheduled firing recorded yet (the first comes $((PAPER_INTERVAL / 60)) min after install)"
    elif ! [[ "$fired" =~ ^-?[0-9]+$ ]]; then
      paper_worse UNKNOWN; txt="$txt | $PAPER_DIR/scheduled-firing.json is unreadable, so whether the schedule fires is not known"
    elif [ "$fired" -gt "$PAPER_SILENT" ]; then
      paper_worse STALE; txt="$txt | no scheduled firing for $((fired / 60)) min (the Mac asleep, or the job not running)"
    else
      txt="$txt | last scheduled firing $((fired / 60)) min ago"
    fi
    # the runner launchd runs is the installed copy, which only install replaces
    if ! cmp -s "$ROOT/home/.claude/canon/paper-session.sh" "$CANON_HOME/paper-session.sh"; then
      paper_worse OUTDATED; txt="$txt; the installed runner differs from this tree's: run scripts/automation install"
    fi
    txt="$txt | last exit code=${last:-?}; log $CANON_HOME/watch/paper-session.log"
    check_row "paper session" "$lab" "$txt"
  elif no_answer "$prc"; then check_row "paper session" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "paper session" OFF "run: scripts/automation install"; fi

  # The collector: launchd must show it running (KeepAlive restarts it); the file's age is shown, not judged,
  # since a quiet hour with no session writes nothing.
  prc=0; pr=$(lc print "$DOMAIN/$OTEL_LABEL" 2>/dev/null) || prc=$?
  if [ "$prc" = 0 ]; then
    state=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tstate = / && s == "" { s = $2 } END { print s }')
    last=$(printf '%s\n' "$pr" | awk -F' = ' '/^\tlast exit code = / && s == "" { s = $2 } END { print s }')
    local lf="$OTEL_DIR/logs.jsonl" mt obin
    # the binary the agent runs: a move of the pin, or a mise prune, can remove it
    obin=$(plutil -extract ProgramArguments.0 raw -o - "$OTEL_PLIST" 2>/dev/null) || obin=""
    case "$state" in
      running) label=ok; v="running" ;;
      '') label=UNKNOWN; v="launchctl shows no state" ;;
      *) label=FAILED; v="state=$state, last exit code=${last:-?}; see $CANON_HOME/watch/otel-collector.log" ;;
    esac
    if [ -n "$obin" ] && [ ! -x "$obin" ]; then
      label=FAILED; v="$v; its binary $obin is gone (the otelcol pin moved?); run: scripts/bootstrap --install, then scripts/automation install"
    fi
    if [ -f "$lf" ]; then
      # the file's mtime: GNU stat -c %Y, else BSD stat -f %m (stat(1) on each)
      mt=$(stat -c %Y "$lf" 2>/dev/null || stat -f %m "$lf" 2>/dev/null) || mt=""
      if [ -n "$mt" ] && [ -z "${mt//[0-9]/}" ]; then
        v="$v | $lf last written $(( ($(date -u +%s) - mt) / 60 )) min ago"
      else v="$v | $lf present, its age unreadable"; fi
    else
      v="$v | no $lf yet: no session has sent an event (settings: scripts/bootstrap --user-config)"
    fi
    check_row "otlp collector" "$label" "$v"
  elif no_answer "$prc"; then check_row "otlp collector" UNKNOWN "launchctl did not answer within ${LAUNCHCTL_SECS} s, so whether it is loaded is not known"
  else check_row "otlp collector" OFF "run: scripts/automation install"; fi

  if [ -f "$CLAUDE_HOME/scheduled-tasks/$TASK_ID/SKILL.md" ]; then
    row "weekly refresh" ok "task file present at $CLAUDE_HOME/scheduled-tasks/$TASK_ID; whether it is still scheduled shows only in the desktop app"
  else row "weekly refresh" OFF "not scheduled; ask Claude in the desktop app to schedule the landscape refresh"; bad=1; fi

  local origin mise_bin mise_err=""
  mise_bin=$(find_mise 2>/dev/null) || { mise_err=$(find_mise 2>&1); mise_bin=""; }
  if origin=$(git -C "$ROOT" remote get-url origin 2>/dev/null); then
    if [ -z "$mise_bin" ]; then
      check_row "landing" UNKNOWN "cannot ask gh whether it is signed in: $mise_err"
    elif (cd "$ROOT" && "$mise_bin" exec -- gh auth status >/dev/null 2>&1); then
      row "landing" ok "scripts/land: pull request, local sign-off, squash merge ($(host_path "$origin"))"
    else row "landing" OFF "gh is not signed in, so scripts/land cannot reach $(host_path "$origin"); run: gh auth login"; bad=1; fi
  else
    row "landing" ok "scripts/land: fast-forwards main locally (no GitHub remote)"
  fi

  if [ -f "$ROOT/.github/dependabot.yml" ] && [ -n "$origin" ]; then
    v=$(jq -r 'if (has("bot_prs") | not) then "UNKNOWN\tconfig present; the last watch ran before the bot was added, so its pull requests are not listed yet"
               elif .bot_prs == null then "UNKNOWN\tconfig present; its pull requests could not be listed at the last watch"
               else "ok\tconfig present; " + (.bot_prs | length | tostring) + " pull request(s) open at the last watch (" + .checked_at + ")" end' "$ROOT/.canon/watch.json" 2>/dev/null)
    [ -n "$v" ] || v=$(printf 'UNKNOWN\tconfig present; .canon/watch.json is missing or unreadable, so open pull requests are not known')
    check_row "dependency bot" "${v%%$'\t'*}" "${v#*$'\t'}"
  elif [ -f "$ROOT/.github/dependabot.yml" ]; then
    row "dependency bot" OFF "config present, but Dependabot needs a GitHub remote"
  else row "dependency bot" OFF ".github/dependabot.yml is missing (ADR 0016)"; bad=1; fi

  # GitHub switches a schedule off after 60 days without activity in a public repository.
  if [ -f "$ROOT/.github/workflows/watch.yml" ] && [ -n "$origin" ]; then
    # A run that is queued or in progress has no conclusion yet (missing or empty), so its status decides first.
    v=""
    # shellcheck disable=SC2016  # jq program, not shell
    [ -z "$mise_bin" ] || v=$( (cd "$ROOT" && "$mise_bin" exec -- gh run list --workflow watch.yml --limit 1 --json status,conclusion,createdAt \
            --jq '.[0] | if . == null then "UNKNOWN\tno run yet; start one with: gh workflow run watch.yml"
                         else (((now - (.createdAt | fromdateiso8601)) / 86400) | floor) as $d
                              | (.status // "") as $s | (.conclusion // "") as $c
                              | if $d > 2 then "STALE\tlast run " + ($d | tostring) + " days ago (" + (if $s == "" then "status unknown" else $s end) + "); the schedule may be off: gh workflow enable watch.yml"
                                elif $s != "" and $s != "completed" then "ok\tlast run " + .createdAt + ": " + $s
                                elif $c == "success" then "ok\tlast run " + .createdAt + ": success"
                                elif $c == "" then "UNKNOWN\tlast run " + .createdAt + ": status " + (if $s == "" then "missing" else $s end) + ", no conclusion"
                                else "FAILED\tlast run " + .createdAt + ": " + $c + "; see: gh run list --workflow watch.yml" end end') 2>/dev/null)
    [ -n "$v" ] || v=$(printf 'UNKNOWN\tthe last run could not be read from GitHub%s' "${mise_err:+: $mise_err}")
    check_row "hosted watch" "${v%%$'\t'*}" "${v#*$'\t'}"
  fi

  if [ -f "$CANON_HOME/watch/alerts.jsonl" ]; then
    note "Recent alerts:"; tail -3 "$CANON_HOME/watch/alerts.jsonl" | jq -r '"  " + .at + "  " + .lane + ": " + .flag' 2>/dev/null
  fi
  return "$bad"
}

case "${1:-}" in
  status)    do_status ;;
  # the failures again after the status table, the last lines the owner sees, and the exit code with them
  install)   do_install; rc=$?; echo; do_status
             if [ "$rc" != 0 ]; then printf '\ninstall: FAILED (exit %s):%s\n' "$rc" "$FAILS"; fi
             exit "$rc" ;;
  uninstall) do_uninstall ;;
  *) note "usage: scripts/automation status | install | uninstall"; exit 2 ;;
esac
