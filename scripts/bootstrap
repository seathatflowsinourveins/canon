#!/bin/bash
# bootstrap — install the pinned toolchain on macOS and the machine-level Claude Code config.
# Decisions: docs/adr/0008-toolchain.md and docs/adr/0007-observability.md.
#
# Every installer below is the upstream's own documented method:
#   Command Line Tools  xcode-select --install                       (Apple; needs a click, so not automated)
#   mise                https://mise.jdx.dev/installing-mise.html     (https://mise.run, MISE_VERSION pins)
#   Claude Code         https://code.claude.com/docs/en/setup.md      (https://claude.ai/install.sh, version arg:
#                                                                      the claude-code pin in canon/upstreams.json)
#
# Usage:
#   scripts/bootstrap --check                       show what is installed; changes nothing
#   scripts/bootstrap --install [--with-user-config] install mise, the tools in mise.toml, the pinned Claude Code CLI
#                                                    (installed or upgraded when absent or below the pin)
#   scripts/bootstrap --user-config                 install home/.claude/ into ~/.claude/ only
# Nothing here uses sudo. mise is the one on PATH, else ~/.local/bin/mise; --install fetches it when there is
# neither, and writes its absolute path into the ~/.zshrc activation line. --check probes tools with mise's
# exec_auto_install setting off (MISE_EXEC_AUTO_INSTALL=false), so a missing tool is reported, not installed,
# and labels mise OUTDATED unless its version is MISE_VERSION. It labels the claude CLI BEHIND when its version
# is below the registry's claude-code pin, and UNKNOWN when its version or the pin cannot be read. The pin
# must be tracked as tag:v<N>.<N>... (or tag:<N>.<N>...); scripts/canon lint refuses any other shape.
# --install runs the vendor installer with the pinned version when the CLI is absent or below the pin, leaves
# one at or above it alone, and then fails if the CLI's version is unreadable or still below the pin. The CLI
# then follows the autoUpdatesChannel that home/.claude/settings.json sets, never below its minimumVersion.
# CLAUDE_CONFIG_DIR replaces ~/.claude. --user-config never overwrites settings.json or CLAUDE.md there: a
# differing one gets a <name>.canon-proposed copy beside it. It replaces canon/ledger.sh and
# canon/statusline.sh, keeping a differing previous copy beside each as <name>.replaced-<UTC time>. The
# installed settings call the scripts in the config directory actually used.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MISE_VERSION="v2026.11.5"      # canon/upstreams.json: mise
# Claude Code: the version is the registry's claude-code pin (claude_pin below), not a channel; later updates
# follow home/.claude/settings.json (ADR 0008: the one tool allowed to auto-update)
LOCAL_BIN="$HOME/.local/bin"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

note()  { printf '%s\n' "$*"; }
die()  { printf 'bootstrap: ERROR: %s\n' "$*" >&2; exit 1; }
row()  { printf '  %-24s %-9s %s\n' "$1" "$2" "$3"; }
have_clt() { xcode-select -p >/dev/null 2>&1; }
first_line() { awk 'NR == 1'; }   # reads all input, so no pipe is cut short under pipefail

# dotted <text>: true when the text is a dotted version of digits only ("2.1.321")
dotted() { printf '%s' "$1" | grep -Eqx '[0-9]+(\.[0-9]+)*'; }

# ver_ge <a> <b>: true when dotted version a is at or above b, comparing each field as a number (a missing
# field counts as 0, so 2.1 equals 2.1.0)
ver_ge() {
  local a="$1" b="$2" x y
  while [ -n "$a" ] || [ -n "$b" ]; do
    x=${a%%.*}; y=${b%%.*}
    case "$a" in *.*) a=${a#*.} ;; *) a="" ;; esac
    case "$b" in *.*) b=${b#*.} ;; *) b="" ;; esac
    [ $((10#${x:-0})) -eq $((10#${y:-0})) ] && continue
    [ $((10#${x:-0})) -gt $((10#${y:-0})) ]; return
  done
  return 0
}

# claude_pin: the claude-code version canon/upstreams.json pins ("tag:v2.1.321" -> 2.1.321); empty when jq,
# the registry or the entry is missing, or the track is not tag:v<dotted version> or tag:<dotted version>
# (scripts/canon lint holds the registry to the same shape)
claude_pin() {
  local t
  t=$(jq -r '.upstreams[]? | select(.id == "claude-code") | .track // empty' "$ROOT/canon/upstreams.json" 2>/dev/null \
      | first_line) || t=""
  case "$t" in tag:*) t=${t#tag:}; t=${t#v} ;; *) return 0 ;; esac
  if [ -n "$t" ] && dotted "$t"; then printf '%s' "$t"; fi
}

# have_claude: true when a claude CLI is in ~/.local/bin or on PATH
have_claude() { [ -x "$LOCAL_BIN/claude" ] || command -v claude >/dev/null 2>&1; }
# claude_version: the first line the CLI prints for --version, ~/.local/bin first; empty when it prints none
claude_version() { ( "$LOCAL_BIN/claude" --version 2>/dev/null || claude --version 2>/dev/null ) | first_line; }

# unquotable <path>: true when the path cannot be written inside double quotes in a shell command
unquotable() { case "$1" in *[\"\$\`\\]*|*$'\n'*) return 0 ;; *) return 1 ;; esac; }

# mise: the one on PATH first, then ~/.local/bin/mise; empty when there is neither
MISE=""
if m=$(command -v mise 2>/dev/null) && [ -n "$m" ]; then
  case "$m" in /*) MISE="$m" ;; *) MISE="$(cd "$(dirname "$m")" && pwd)/$(basename "$m")" ;; esac
elif [ -x "$LOCAL_BIN/mise" ]; then
  MISE="$LOCAL_BIN/mise"
fi

# hook_path <command>: the file a settings.json command in this repo's forms runs (quotes dropped,
# $HOME and a leading ~ expanded)
hook_path() {
  local p=${1//\"/}
  case "$p" in \~/*) p="$HOME/${p#\~/}" ;; esac
  p=${p//\$\{HOME\}/$HOME}; p=${p//\$HOME/$HOME}
  printf '%s' "$p"
}

# check_hooks: every event home/.claude/settings.json registers must run an executable ledger.sh in the
# installed settings, and the status line an executable statusline.sh, at the paths those commands name
check_hooks() {
  local s="$CLAUDE_HOME/settings.json" ev c p ok miss="" seen=""
  if [ ! -f "$s" ] || ! jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    row "event ledger hooks" MISSING "no readable $s; run: scripts/bootstrap --user-config"
    row "status line" MISSING "no readable $s; run: scripts/bootstrap --user-config"
    return 1
  fi
  for ev in $(jq -r '.hooks | keys[]' "$ROOT/home/.claude/settings.json"); do
    ok=0
    while IFS= read -r c; do
      p=$(hook_path "$c")
      if [ -x "$p" ]; then ok=1; seen="$p"; fi
    done < <(jq -r --arg ev "$ev" '.hooks[$ev][]?.hooks[]?.command // empty | select(test("ledger\\.sh"))' "$s")
    [ "$ok" = 1 ] || miss="$miss $ev"
  done
  local rc=0
  if [ -z "$miss" ]; then row "event ledger hooks" ok "$seen"
  else row "event ledger hooks" MISSING "no executable ledger.sh for:$miss; run: scripts/bootstrap --user-config"; rc=1; fi
  c=$(jq -r '.statusLine.command // empty' "$s")
  p=$(hook_path "$c")
  if [ -n "$c" ] && [ -x "$p" ]; then row "status line" ok "$p"
  else row "status line" MISSING "${c:+$p is not executable; }run: scripts/bootstrap --user-config"; rc=1; fi
  return "$rc"
}

# paper_row: whether both Alpaca paper key items are in the login keychain (ADR 0029). It looks each item up
# by service and account without -w or -g, so no value is read (man security: find-generic-password). An
# absent pair is reported and never fails the check: only the paper tests need it.
PAPER_SERVICE="canon-alpaca-paper"   # the service mise.toml's paper tasks use
paper_row() {
  local a miss=""
  if ! command -v security >/dev/null 2>&1; then row "paper key pair" absent "no security command here (macOS only)"; return 0; fi
  for a in ALPACA_API_KEY ALPACA_SECRET_KEY; do
    security find-generic-password -s "$PAPER_SERVICE" -a "$a" >/dev/null 2>&1 || miss="$miss $a"
  done
  if [ -z "$miss" ]; then row "paper key pair" ok "login keychain, service $PAPER_SERVICE"
  else row "paper key pair" absent "no keychain item for:$miss; to enter the pair: mise run paper:store"; fi
}

check() {
  local missing=0 v t pin
  note "Toolchain (ADR 0008):"
  if have_clt; then row "Command Line Tools" ok "$(xcode-select -p)"; else row "Command Line Tools" MISSING "run: xcode-select --install"; missing=1; fi
  # /usr/bin/git is a stub that opens an install dialog when the tools are absent, so only call it when they exist
  if have_clt; then row git ok "$(git --version 2>/dev/null)"; else row git MISSING "comes with Command Line Tools"; missing=1; fi
  for t in curl jq; do
    if command -v "$t" >/dev/null 2>&1; then row "$t" ok "$("$t" --version 2>/dev/null | first_line)"; else row "$t" MISSING ""; missing=1; fi
  done
  if [ -n "$MISE" ] && [ -x "$MISE" ]; then
    v=$("$MISE" --version 2>/dev/null | first_line) || v=""
    if [ "v${v%% *}" = "$MISE_VERSION" ]; then row mise ok "$MISE: $v"
    else row mise OUTDATED "$MISE: ${v:-no version}; pinned $MISE_VERSION (canon/upstreams.json)"; missing=1; fi
    for t in python uv node gh; do
      if v=$(cd "$ROOT" && MISE_EXEC_AUTO_INSTALL=false "$MISE" exec -- "$t" --version 2>/dev/null | first_line) && [ -n "$v" ]; then
        row "$t (mise)" ok "$v"
      else row "$t (mise)" MISSING "run: scripts/bootstrap --install"; missing=1; fi
    done
  else
    row mise MISSING "run: scripts/bootstrap --install"; missing=1
    for t in python uv node gh; do row "$t (mise)" MISSING "installed by mise"; done
  fi
  if have_claude; then
    v=$(claude_version)
    t=${v%% *}; t=${t#v}; pin=$(claude_pin)
    if [ -z "$pin" ]; then row "claude CLI" UNKNOWN "${v:-no version}; no readable claude-code pin in canon/upstreams.json"; missing=1
    elif ! dotted "$t"; then row "claude CLI" UNKNOWN "cannot read a version from '${v:-nothing}'; pinned $pin (canon/upstreams.json)"; missing=1
    elif ver_ge "$t" "$pin"; then row "claude CLI" ok "$t; pinned $pin"
    else row "claude CLI" BEHIND "$t; pinned $pin (canon/upstreams.json); run: claude install $pin"; missing=1; fi
  else row "claude CLI" MISSING "run: scripts/bootstrap --install"; missing=1; fi
  note "Machine-level Claude Code config (ADR 0007), in $CLAUDE_HOME:"
  check_hooks || missing=1
  if [ -f "$CLAUDE_HOME/CLAUDE.md" ]; then row "user CLAUDE.md" ok ""; else row "user CLAUDE.md" MISSING "run: scripts/bootstrap --user-config"; missing=1; fi
  note "Alpaca paper key pair (ADR 0029), optional:"
  paper_row
  return "$missing"
}

# fetch_then_run <url> <interpreter> [script-args...]
# Downloads the installer fully before executing it, so a cut-off download never runs.
# Equivalent to the documented `curl <url> | <interpreter> -s [script-args...]`.
fetch_then_run() {
  local url="$1" interp="$2" tmp; shift 2
  tmp=$(mktemp)
  curl -fsSL --max-time 120 "$url" -o "$tmp" || { rm -f "$tmp"; die "download failed: $url"; }
  [ -s "$tmp" ] || { rm -f "$tmp"; die "download was empty: $url"; }
  "$interp" "$tmp" "$@" < /dev/null || { rm -f "$tmp"; die "installer failed: $url"; }
  rm -f "$tmp"
}

install_toolchain() {
  have_clt || die "Command Line Tools are missing. Run 'xcode-select --install', click Install in the dialog, then re-run."
  mkdir -p "$LOCAL_BIN"
  if [ -z "$MISE" ] || [ ! -x "$MISE" ]; then
    note "Installing mise $MISE_VERSION into $LOCAL_BIN ..."
    export MISE_VERSION
    fetch_then_run https://mise.run sh
    MISE="$LOCAL_BIN/mise"
    [ -x "$MISE" ] || die "mise installer finished but $MISE is not there"
  fi
  unquotable "$MISE" && die "mise path $MISE holds a quote, \$, backquote, backslash or newline; not supported"
  note "Installing tools from mise.toml with $MISE ..."
  ( cd "$ROOT" && "$MISE" trust "$ROOT/mise.toml" && "$MISE" install ) || die "mise install failed"
  local pin v t; pin=$(claude_pin)
  [ -n "$pin" ] || die "no readable claude-code pin (tag:v<dotted version>) in canon/upstreams.json"
  if ! have_claude; then
    note "Installing Claude Code CLI $pin (canon/upstreams.json: claude-code) ..."
    fetch_then_run https://claude.ai/install.sh bash "$pin"
    [ -x "$LOCAL_BIN/claude" ] || die "Claude Code installer finished but $LOCAL_BIN/claude is not there"
  else
    v=$(claude_version); t=${v%% *}; t=${t#v}
    if dotted "$t" && ! ver_ge "$t" "$pin"; then
      note "Claude Code CLI $t is below the pin $pin; installing $pin (canon/upstreams.json: claude-code) ..."
      fetch_then_run https://claude.ai/install.sh bash "$pin"
    fi
  fi
  v=$(claude_version); t=${v%% *}; t=${t#v}
  dotted "$t" || die "cannot read a version from the Claude Code CLI ('${v:-nothing}'); pinned $pin. Run: claude install $pin"
  ver_ge "$t" "$pin" || die "Claude Code CLI is $t, still below the pin $pin (canon/upstreams.json). Run: claude install $pin"
  note "Claude Code CLI $t (pinned $pin)."
  local rc="$HOME/.zshrc"
  if ! grep -q 'canon bootstrap' "$rc" 2>/dev/null; then
    {
      echo ''
      echo '# canon bootstrap (docs/adr/0008-toolchain.md)'
      # shellcheck disable=SC2016  # written to ~/.zshrc literally; it expands there, not here
      echo 'export PATH="$HOME/.local/bin:$PATH"'
      # shellcheck disable=SC2016  # as above; the mise path is the one found or installed here
      printf 'eval "$("%s" activate zsh)"\n' "$MISE"
    } >> "$rc"
    note "Added ~/.local/bin and mise activation ($MISE) to $rc (open a new terminal to pick it up)."
  else
    note "$rc already has the canon bootstrap lines; left unchanged."
  fi
}

# render_settings: home/.claude/settings.json with its ~/.claude and "$HOME"/.claude paths pointed at
# CLAUDE_HOME when that is not the default
render_settings() {
  if [ "$CLAUDE_HOME" = "$HOME/.claude" ]; then cat "$ROOT/home/.claude/settings.json"; return; fi
  # shellcheck disable=SC2016  # "$HOME" is literal text in the settings file, matched as such
  jq --arg d "\"$CLAUDE_HOME\"" '
    def place: split("\"$HOME\"/.claude") | join($d) | if startswith("~/.claude/") then $d + .[9:] else . end;
    (.statusLine.command |= place) | (.hooks[][].hooks[].command |= place)' "$ROOT/home/.claude/settings.json"
}

install_user_config() {
  local src="$ROOT/home/.claude" pending=0 f dst bak tmp
  case "$CLAUDE_HOME" in /*) ;; *) die "CLAUDE_CONFIG_DIR must be an absolute path (got: $CLAUDE_HOME)" ;; esac
  unquotable "$CLAUDE_HOME" && die "CLAUDE_CONFIG_DIR holds a quote, \$, backquote, backslash or newline, which the hook commands cannot quote: $CLAUDE_HOME"
  command -v jq >/dev/null 2>&1 || die "jq not found"
  mkdir -p "$CLAUDE_HOME/canon"
  for f in ledger.sh statusline.sh; do
    dst="$CLAUDE_HOME/canon/$f"
    if [ -e "$dst" ] && cmp -s "$src/canon/$f" "$dst"; then note "  unchanged  $dst"; continue; fi
    if [ -e "$dst" ]; then
      bak="$dst.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
      cp -p "$dst" "$bak" || die "could not keep the previous $dst"
      note "  kept       the previous $f as $bak"
    fi
    install -m 755 "$src/canon/$f" "$dst"
    note "  installed  $dst"
  done
  tmp=$(mktemp)
  render_settings > "$tmp" || { rm -f "$tmp"; die "could not render settings.json for $CLAUDE_HOME"; }
  for f in settings.json CLAUDE.md; do
    local from="$src/$f"; [ "$f" = settings.json ] && from="$tmp"
    if [ ! -e "$CLAUDE_HOME/$f" ]; then
      cp "$from" "$CLAUDE_HOME/$f"; note "  installed  $CLAUDE_HOME/$f"
    elif cmp -s "$from" "$CLAUDE_HOME/$f"; then
      note "  unchanged  $CLAUDE_HOME/$f"
    else
      cp "$from" "$CLAUDE_HOME/$f.canon-proposed"; pending=1
      note "  EXISTS     $CLAUDE_HOME/$f differs; wrote $f.canon-proposed beside it. Merge by hand."
    fi
  done
  rm -f "$tmp"
  [ "$pending" -eq 0 ] || note "Some files were not applied (see EXISTS above)."
  note "New Claude Code sessions will pick this up. Verify with: scripts/bootstrap --check, then scripts/lanes"
}

case "${1:-}" in
  --check)        if check; then note "All present."; else note "Some pieces are missing or outdated (see above)."; exit 1; fi ;;
  --install)      install_toolchain
                  [ "${2:-}" = "--with-user-config" ] && install_user_config
                  check || true ;;
  --user-config)  install_user_config ;;
  *) note "usage: scripts/bootstrap --check | --install [--with-user-config] | --user-config"; exit 2 ;;
esac
