#!/bin/bash
# bootstrap — install the pinned toolchain on macOS and the machine-level Claude Code config.
# Decisions: docs/adr/0008-toolchain.md and docs/adr/0007-observability.md.
#
# Every installer below is the upstream's own documented method:
#   Command Line Tools  xcode-select --install                       (Apple; needs a click, so not automated)
#   mise                https://mise.jdx.dev/installing-mise.html     (https://mise.run, MISE_VERSION pins)
#   Claude Code         https://code.claude.com/docs/en/setup.md      (https://claude.ai/install.sh, channel arg)
#
# Usage:
#   scripts/bootstrap --check                       show what is installed; changes nothing
#   scripts/bootstrap --install [--with-user-config] install mise, the tools in mise.toml, Claude Code CLI
#   scripts/bootstrap --user-config                 install home/.claude/ into ~/.claude/ only
# Nothing here uses sudo. Existing files in ~/.claude are never overwritten.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MISE_VERSION="v2026.11.5"      # canon/upstreams.json: mise
CLAUDE_CHANNEL="stable"        # ADR 0008: the one tool allowed to auto-update, on the stable channel
LOCAL_BIN="$HOME/.local/bin"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MISE="$LOCAL_BIN/mise"
command -v mise >/dev/null 2>&1 && MISE="$(command -v mise)"

note()  { printf '%s\n' "$*"; }
die()  { printf 'bootstrap: ERROR: %s\n' "$*" >&2; exit 1; }
row()  { printf '  %-24s %-9s %s\n' "$1" "$2" "$3"; }
have_clt() { xcode-select -p >/dev/null 2>&1; }

check() {
  local missing=0 v
  note "Toolchain (ADR 0008):"
  if have_clt; then row "Command Line Tools" ok "$(xcode-select -p)"; else row "Command Line Tools" MISSING "run: xcode-select --install"; missing=1; fi
  # /usr/bin/git is a stub that opens an install dialog when the tools are absent, so only call it when they exist
  if have_clt; then row git ok "$(git --version 2>/dev/null | head -1)"; else row git MISSING "comes with Command Line Tools"; missing=1; fi
  for t in curl jq; do
    if command -v "$t" >/dev/null 2>&1; then row "$t" ok "$("$t" --version 2>/dev/null | head -1)"; else row "$t" MISSING ""; missing=1; fi
  done
  if [ -x "$MISE" ]; then
    row mise ok "$("$MISE" --version 2>/dev/null | head -1)"
    for t in python uv node gh; do
      if v=$(cd "$ROOT" && "$MISE" exec -- "$t" --version 2>/dev/null | head -1) && [ -n "$v" ]; then row "$t (mise)" ok "$v"; else row "$t (mise)" MISSING "run: scripts/bootstrap --install"; missing=1; fi
    done
  else
    row mise MISSING "run: scripts/bootstrap --install"; missing=1
    for t in python uv node gh; do row "$t (mise)" MISSING "installed by mise"; done
  fi
  if [ -x "$LOCAL_BIN/claude" ] || command -v claude >/dev/null 2>&1; then
    row "claude CLI" ok "$( ( "$LOCAL_BIN/claude" --version 2>/dev/null || claude --version 2>/dev/null ) | head -1)"
  else row "claude CLI" MISSING "run: scripts/bootstrap --install"; missing=1; fi
  note "Machine-level Claude Code config (ADR 0007):"
  if [ -x "$CLAUDE_HOME/canon/ledger.sh" ] && grep -q 'canon/ledger.sh' "$CLAUDE_HOME/settings.json" 2>/dev/null; then
    row "event ledger hooks" ok "$CLAUDE_HOME/canon/ledger.sh"
  else row "event ledger hooks" MISSING "run: scripts/bootstrap --user-config"; missing=1; fi
  if grep -q 'canon/statusline.sh' "$CLAUDE_HOME/settings.json" 2>/dev/null; then row "status line" ok ""; else row "status line" MISSING "run: scripts/bootstrap --user-config"; missing=1; fi
  if [ -f "$CLAUDE_HOME/CLAUDE.md" ]; then row "user CLAUDE.md" ok ""; else row "user CLAUDE.md" MISSING "run: scripts/bootstrap --user-config"; missing=1; fi
  return "$missing"
}

# fetch_then_run <url> <interpreter> [script-args...]
# Downloads the installer fully before executing it, so a cut-off download never runs.
# Equivalent to the documented `curl <url> | <interpreter> -s [script-args...]`.
fetch_then_run() {
  local url="$1" interp="$2" tmp; shift 2
  tmp=$(mktemp)
  curl -fsSL --max-time 120 "$url" -o "$tmp" || { rm -f "$tmp"; die "download failed: $url"; }
  [ -s "$tmp" ] || { rm -f "$tmp"; die "download was empty: $url"; }
  "$interp" "$tmp" "$@" < /dev/null || { rm -f "$tmp"; die "installer failed: $url"; }
  rm -f "$tmp"
}

install_toolchain() {
  have_clt || die "Command Line Tools are missing. Run 'xcode-select --install', click Install in the dialog, then re-run."
  mkdir -p "$LOCAL_BIN"
  if [ ! -x "$MISE" ]; then
    note "Installing mise $MISE_VERSION into $LOCAL_BIN ..."
    export MISE_VERSION
    fetch_then_run https://mise.run sh
    MISE="$LOCAL_BIN/mise"
    [ -x "$MISE" ] || die "mise installer finished but $MISE is not there"
  fi
  note "Installing tools from mise.toml ..."
  ( cd "$ROOT" && "$MISE" trust "$ROOT/mise.toml" && "$MISE" install ) || die "mise install failed"
  if [ ! -x "$LOCAL_BIN/claude" ] && ! command -v claude >/dev/null 2>&1; then
    note "Installing Claude Code CLI ($CLAUDE_CHANNEL channel) ..."
    fetch_then_run https://claude.ai/install.sh bash "$CLAUDE_CHANNEL"
    [ -x "$LOCAL_BIN/claude" ] || die "Claude Code installer finished but $LOCAL_BIN/claude is not there"
  fi
  local rc="$HOME/.zshrc"
  if ! grep -q 'canon bootstrap' "$rc" 2>/dev/null; then
    {
      echo ''
      echo '# canon bootstrap (docs/adr/0008-toolchain.md)'
      # shellcheck disable=SC2016  # written to ~/.zshrc literally; it expands there, not here
      echo 'export PATH="$HOME/.local/bin:$PATH"'
      # shellcheck disable=SC2016  # as above
      echo 'eval "$("$HOME/.local/bin/mise" activate zsh)"'
    } >> "$rc"
    note "Added ~/.local/bin and mise activation to $rc (open a new terminal to pick it up)."
  fi
}

install_user_config() {
  local src="$ROOT/home/.claude" pending=0 f
  mkdir -p "$CLAUDE_HOME/canon"
  for f in ledger.sh statusline.sh; do
    install -m 755 "$src/canon/$f" "$CLAUDE_HOME/canon/$f"
    note "  installed  $CLAUDE_HOME/canon/$f"
  done
  for f in settings.json CLAUDE.md; do
    if [ ! -e "$CLAUDE_HOME/$f" ]; then
      cp "$src/$f" "$CLAUDE_HOME/$f"; note "  installed  $CLAUDE_HOME/$f"
    elif cmp -s "$src/$f" "$CLAUDE_HOME/$f"; then
      note "  unchanged  $CLAUDE_HOME/$f"
    else
      cp "$src/$f" "$CLAUDE_HOME/$f.canon-proposed"; pending=1
      note "  EXISTS     $CLAUDE_HOME/$f differs; wrote $f.canon-proposed beside it. Merge by hand."
    fi
  done
  [ "$pending" -eq 0 ] || note "Some files were not applied (see EXISTS above)."
  note "New Claude Code sessions will pick this up. Verify with: scripts/lanes"
}

case "${1:-}" in
  --check)        if check; then note "All present."; else note "Some pieces are missing (see MISSING above)."; exit 1; fi ;;
  --install)      install_toolchain
                  [ "${2:-}" = "--with-user-config" ] && install_user_config
                  check || true ;;
  --user-config)  install_user_config ;;
  *) note "usage: scripts/bootstrap --check | --install [--with-user-config] | --user-config"; exit 2 ;;
esac
