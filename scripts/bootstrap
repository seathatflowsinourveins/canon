#!/bin/bash
# bootstrap — install the pinned toolchain on macOS and the machine-level Claude Code config.
# Decisions: docs/adr/0008-toolchain.md and docs/adr/0007-observability.md.
#
# Every installer below is the upstream's own documented method:
#   Command Line Tools  xcode-select --install                       (Apple; needs a click, so not automated)
#   mise                https://mise.jdx.dev/installing-mise.html     (https://mise.run, MISE_VERSION pins)
#   Claude Code         https://code.claude.com/docs/en/setup.md      (https://claude.ai/install.sh, version arg:
#                                                                      the claude-code pin in canon/upstreams.json)
#
# Usage:
#   scripts/bootstrap --check                       show what is installed; changes nothing
#   scripts/bootstrap --install [--with-user-config] install mise, the tools in mise.toml, the pinned Claude Code CLI
#                                                    (installed or upgraded when absent or below the pin)
#   scripts/bootstrap --user-config                 install home/.claude/ into ~/.claude/ only
# Nothing here uses sudo. mise is the one on PATH, else ~/.local/bin/mise; --install fetches it when there is
# neither, and writes its absolute path into the ~/.zshrc activation line. --check probes tools with mise's
# exec_auto_install setting off (MISE_EXEC_AUTO_INSTALL=false), so a missing tool is reported, not installed,
# and labels mise OUTDATED unless its version is MISE_VERSION. It labels the claude CLI BEHIND when its version
# is below the registry's claude-code pin, and UNKNOWN when its version or the pin cannot be read. The pin
# must be tracked as tag:v<N>.<N>... (or tag:<N>.<N>...); scripts/canon lint refuses any other shape.
# --install runs the vendor installer with the pinned version when the CLI is absent or below the pin, leaves
# one at or above it alone, and then fails if the CLI's version is unreadable or still below the pin. The CLI
# then updates itself on the latest channel, which the template names (the docs: "The channel you choose at
# install time becomes your default for auto-updates", so it is set, not left to the installer), never below
# the template's minimumVersion (ADR 0065: the pin is a floor; --check calls a CLI ahead of it ok and names
# the version it saw).
# CLAUDE_CONFIG_DIR replaces ~/.claude. --user-config never overwrites settings.json, CLAUDE.md or
# claude-hud.json (Claude HUD's settings, ADR 0023) there: a
# differing one gets a <name>.canon-proposed copy beside it, except a settings.json that already holds every
# key and hook entry the template sets (settings_gaps), which is unchanged; an EXISTS line names each gap. It does add to an existing settings.json the
# telemetry variables (CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_*) of home/.claude/settings.json's env block that
# it lacks (ADR 0007, tier 3; Claude Code reads them only from user or managed settings,
# https://code.claude.com/docs/en/monitoring-usage.md), and the keys it lacks of CANON_KEYS (model,
# availableModels and modelPicker, ADR 0059; autoUpdatesChannel, ADR 0065; autoCompactWindow, ADR 0059). It replaces two values an
# earlier template set (RETIRED: autoUpdatesChannel "stable", ADR 0065; env.ANTHROPIC_DEFAULT_FABLE_MODEL
# "claude-fable-5-2", ADR 0059), keeping a copy of the previous file; a value the owner set otherwise is
# left alone and named. It
# appends home/.codex/otel.toml to ${CODEX_HOME:-~/.codex}/config.toml when that file has no otel table of its
# own and its folder exists, and writes home/.codex/defaults.toml's settings (model, model_reasoning_effort;
# approval_policy, default_permissions and the canon-worker permissions profile, ADR 0034) that the file
# lacks at its top, keeping a copy of the previous file and changing nothing else in it; an otel
# table or a default that is not canon's is left alone and named (Codex: CODEX_HOME, codex-rs/utils/home-dir
# at the pinned tag). It sets Antigravity's default model, the "model" key of
# ~/.gemini/antigravity-cli/settings.json ("saved by its label", https://antigravity.google/docs/settings), to
# the label canon/models.json gives when agy's folder exists and the key is unset. It replaces canon/ledger.sh,
# canon/statusline.sh and canon/fleet-rate.sh, keeping a differing previous copy beside each as <name>.replaced-<UTC time>. The
# installed settings call the scripts in the config directory actually used. --check also compares the
# installed settings.json's model keys with the template's, labels any env.ANTHROPIC_DEFAULT_<ALIAS>_MODEL
# there PINNED (it stops the alias following the vendor; ADR 0059) or MISMATCH (another model than
# canon/models.json's), a top-level "model" outside canon/models.json MISMATCH, and reports the update channel
# and the auto-compact window in effect from the settings and this environment.
# --install also sets up the review-only workers (ADR 0045), each as its upstream documents: it adds
# home/dsh/review.patch.yml's rows (session-log upload off, dsh-memento off) to the dsh-tui profile's user
# patch, ${DSH_HOME:-~/.dsh}/profiles/dsh-tui/cordis.patch.yml, after the rows already there (dsh-TUI
# v0.17.0 docs/configuration.en.md), and removes from ~/.zshrc the two lines an earlier --install wrote to
# turn Antigravity's self-updater off (ADR 0065 reverses ADR 0045 on this), keeping a copy. A patch that
# already names either row, or is not a
# YAML block sequence or [], is left alone with review.patch.yml.canon-proposed beside it to merge by hand;
# an older canon block is replaced where it stands.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MISE_VERSION="v2026.11.6"      # canon/upstreams.json: mise
# Claude Code: the version is the registry's claude-code pin (claude_pin below), not a channel; later updates
# follow home/.claude/settings.json (ADR 0008: the one tool allowed to auto-update)
LOCAL_BIN="$HOME/.local/bin"
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
# the env keys of home/.claude/settings.json that are telemetry (ADR 0007): what --user-config adds to an
# existing settings.json and what the telemetry row checks. No model alias pin is among them: ADR 0059 pins
# none, --check labels one PINNED, and --user-config removes only the one an earlier template set (RETIRED)
TELEMETRY_RE='^(CLAUDE_CODE_ENABLE_TELEMETRY$|OTEL_)'
# the top-level keys of home/.claude/settings.json that --user-config adds to an existing settings.json when
# it lacks them (the model keys, ADR 0059; the update channel, ADR 0065), and the values an earlier template
# set that those records retire: --user-config removes one only while it still holds exactly that value, and
# a key of CANON_KEYS removed so is then added from the template. The earlier template's "model": "fable" is
# not among them: it is also the orchestrator lane's alias, which an owner may choose, so --check names it
CANON_KEYS='["model", "availableModels", "modelPicker", "autoUpdatesChannel", "autoCompactWindow"]'
RETIRED='[{"path": ["autoUpdatesChannel"], "value": "stable"}, {"path": ["env", "ANTHROPIC_DEFAULT_FABLE_MODEL"], "value": "claude-fable-5-2"}]'
# the variables that turn Claude Code's background updates off (https://code.claude.com/docs/en/env-vars.md)
UPDATE_OFF_VARS="DISABLE_AUTOUPDATER DISABLE_UPDATES CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"
CODEX_DEFAULTS_SRC="$ROOT/home/.codex/defaults.toml"
# Antigravity keeps its settings in one file at a fixed path (https://antigravity.google/docs/settings)
AGY_SETTINGS="$HOME/.gemini/antigravity-cli/settings.json"

note()  { printf '%s\n' "$*"; }
die()  { printf 'bootstrap: ERROR: %s\n' "$*" >&2; exit 1; }
row()  { printf '  %-24s %-9s %s\n' "$1" "$2" "$3"; }
have_clt() { xcode-select -p >/dev/null 2>&1; }
first_line() { awk 'NR == 1'; }   # reads all input, so no pipe is cut short under pipefail

# dotted <text>: true when the text is a dotted version of digits only ("2.1.321")
# (a here-string, not a pipe: under pipefail a writer that grep -q stops reading could fail the test)
dotted() { grep -Eqx '[0-9]+(\.[0-9]+)*' <<<"$1"; }

# ver_ge <a> <b>: true when dotted version a is at or above b, comparing each field as a number (a missing
# field counts as 0, so 2.1 equals 2.1.0)
ver_ge() {
  local a="$1" b="$2" x y
  while [ -n "$a" ] || [ -n "$b" ]; do
    x=${a%%.*}; y=${b%%.*}
    case "$a" in *.*) a=${a#*.} ;; *) a="" ;; esac
    case "$b" in *.*) b=${b#*.} ;; *) b="" ;; esac
    [ $((10#${x:-0})) -eq $((10#${y:-0})) ] && continue
    [ $((10#${x:-0})) -gt $((10#${y:-0})) ]; return
  done
  return 0
}

# claude_pin: the claude-code version canon/upstreams.json pins ("tag:v2.1.321" -> 2.1.321); empty when jq,
# the registry or the entry is missing, or the track is not tag:v<dotted version> or tag:<dotted version>
# (scripts/canon lint holds the registry to the same shape)
claude_pin() {
  local t
  t=$(jq -r '.upstreams[]? | select(.id == "claude-code") | .track // empty' "$ROOT/canon/upstreams.json" 2>/dev/null \
      | first_line) || t=""
  case "$t" in tag:*) t=${t#tag:}; t=${t#v} ;; *) return 0 ;; esac
  if [ -n "$t" ] && dotted "$t"; then printf '%s' "$t"; fi
}

# have_claude: true when a claude CLI is in ~/.local/bin or on PATH
have_claude() { [ -x "$LOCAL_BIN/claude" ] || command -v claude >/dev/null 2>&1; }
# claude_version: the first line the CLI prints for --version, ~/.local/bin first; empty when it prints none
claude_version() { ( "$LOCAL_BIN/claude" --version 2>/dev/null || claude --version 2>/dev/null ) | first_line; }

# unquotable <path>: true when the path cannot be written inside double quotes in a shell command
unquotable() { case "$1" in *[\"\$\`\\]*|*$'\n'*) return 0 ;; *) return 1 ;; esac; }

# mise: the one on PATH first, then ~/.local/bin/mise; empty when there is neither
MISE=""
if m=$(command -v mise 2>/dev/null) && [ -n "$m" ]; then
  case "$m" in /*) MISE="$m" ;; *) MISE="$(cd "$(dirname "$m")" && pwd)/$(basename "$m")" ;; esac
elif [ -x "$LOCAL_BIN/mise" ]; then
  MISE="$LOCAL_BIN/mise"
fi

# hook_path <command>: the file a settings.json command in this repo's forms runs (quotes dropped,
# $HOME and a leading ~ expanded)
hook_path() {
  local p=${1//\"/}
  case "$p" in \~/*) p="$HOME/${p#\~/}" ;; esac
  p=${p//\$\{HOME\}/$HOME}; p=${p//\$HOME/$HOME}
  printf '%s' "$p"
}

# check_hooks: every event home/.claude/settings.json registers must run an executable ledger.sh in the
# installed settings, and the status line an executable statusline.sh, at the paths those commands name
check_hooks() {
  local s="$CLAUDE_HOME/settings.json" ev c p ok miss="" seen=""
  if [ ! -f "$s" ] || ! jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    row "event ledger hooks" MISSING "no readable $s; run: scripts/bootstrap --user-config"
    row "status line" MISSING "no readable $s; run: scripts/bootstrap --user-config"
    return 1
  fi
  for ev in $(jq -r '.hooks | keys[]' "$ROOT/home/.claude/settings.json"); do
    ok=0
    while IFS= read -r c; do
      p=$(hook_path "$c")
      if [ -x "$p" ]; then ok=1; seen="$p"; fi
    done < <(jq -r --arg ev "$ev" '.hooks[$ev][]?.hooks[]?.command // empty | select(test("ledger\\.sh"))' "$s")
    [ "$ok" = 1 ] || miss="$miss $ev"
  done
  local rc=0
  if [ -z "$miss" ]; then row "event ledger hooks" ok "$seen"
  else row "event ledger hooks" MISSING "no executable ledger.sh for:$miss; run: scripts/bootstrap --user-config"; rc=1; fi
  c=$(jq -r '.statusLine.command // empty' "$s")
  p=$(hook_path "$c")
  if [ -n "$c" ] && [ -x "$p" ]; then row "status line" ok "$p"
  else row "status line" MISSING "${c:+$p is not executable; }run: scripts/bootstrap --user-config"; rc=1; fi
  return "$rc"
}

# check_model_settings: the installed settings.json's model keys against home/.claude/settings.json and
# canon/models.json (ADR 0005, ADR 0059; https://code.claude.com/docs/en/model-config.md).
# * Alias pins: an env.ANTHROPIC_DEFAULT_<ALIAS>_MODEL makes the alias name that model, and "Aliases point to
#   the recommended version for your provider and update over time" only without one. ADR 0059 lets every
#   alias follow the vendor, so a pin is PINNED when it names the ID canon/models.json gives the alias and
#   MISMATCH otherwise; the template must pin none.
# * The top-level "model", the default for new sessions: ok when it is the session_default_lane's alias or
#   model, OWNER when it is another one canon/models.json names (the /model picker's Enter saves one), and
#   MISMATCH outside it; MISSING when unset.
# * availableModels and modelPicker: ok when equal to the template's (the allowlist hides the picker's
#   server-provided Fable 5.1 row; the picker row names the orchestrator lane's ID), MISSING when unset,
#   MISMATCH for an allowlist that admits claude-fable-5-1 again or misses a lane's model, and for a
#   picker with a claude-fable-5-1 row or none for the orchestrator lane's model; OWNER otherwise.
#   A "model" of "fable", the earlier template's value, is OWNER, named as such.
# --user-config never overwrites an existing settings.json, so this is how drift is seen. Only that one file
# is read; the shell environment and other settings scopes are not.
check_model_settings() {
  local s="$CLAUDE_HOME/settings.json" m="$ROOT/canon/models.json" t="$ROOT/home/.claude/settings.json"
  local rc=0 out name key live want state
  if ! jq -e '([.lanes[]? | select((.alias | type) == "string" and (.model | type) == "string")] | length > 0)
              and ((.claude_code.session_default_lane // "") as $l | any(.lanes[]?; .lane == $l))' "$m" >/dev/null 2>&1; then
    row "model settings" UNKNOWN "no readable lanes with alias and model, or no claude_code.session_default_lane, in canon/models.json"; return 1
  fi
  if ! jq -e 'type == "object" and (.availableModels | type) == "array" and (.modelPicker | type) == "object"' "$t" >/dev/null 2>&1; then
    row "model settings" UNKNOWN "home/.claude/settings.json is unreadable or sets no availableModels and modelPicker"; return 1
  fi
  if [ ! -f "$s" ] || ! jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    row "model settings" MISSING "no readable $s; run: scripts/bootstrap --user-config"; return 1
  fi
  # fields are joined with US (0x1f), not a tab: read collapses empty fields between whitespace separators
  if ! out=$(jq -rn --slurpfile t "$t" --slurpfile l "$s" --slurpfile m "$m" '
    def pins: (.env // {}) | if type == "object" then with_entries(select(.key | test("^ANTHROPIC_DEFAULT_.+_MODEL$"))) else {} end;
    ($m[0].lanes | map(select((.alias | type) == "string" and (.model | type) == "string"))) as $lanes
    | ($lanes | group_by(.alias) | map({key: .[0].alias, value: (map(.model) | unique)}) | from_entries) as $want
    | ($m[0].claude_code.session_default_lane) as $dl | ($lanes | map(select(.lane == $dl)) | .[0]) as $d
    | ($t[0] | pins) as $tp | ($l[0] | pins) as $lp
    | (if ($lp | length) == 0 and ($tp | length) == 0 then ["model alias pins", "", "", "", "none"] else empty end),
      ((($tp + $lp) | keys[]) as $k
       | ($k | ltrimstr("ANTHROPIC_DEFAULT_") | rtrimstr("_MODEL") | ascii_downcase) as $a
       | ($want[$a] // []) as $w
       | ($lp[$k] | if . == null then "" else tostring end) as $v
       | [$a + " alias", $k, $v, ($w | join(",")),
          (if $tp[$k] != null then "template" elif ($w | length) != 1 then "unknown" elif $v == $w[0] then "pinned" else "mismatch" end)]),
      (if $l[0] | has("model") then
         ($l[0].model | tostring) as $v
         | ["default model", "model", $v, $d.alias,
            (if $v == $d.alias or $v == $d.model then "ok"
             elif $v == "fable" then "former"
             elif any($lanes[]; .alias == $v or .model == $v) then "owner" else "outside" end)]
       else ["default model", "model", "", $d.alias, "missing"] end),
      # an allowlist entry admits a model when it is its family alias, its ID, or a version prefix of it
      # (https://code.claude.com/docs/en/model-config.md, "Restrict model selection")
      # and a [1m] suffix is stripped from both before matching
      (def bare: tostring | sub("\\[1m\\]$"; "");
       def admits($id; $fam): bare as $e | $e == $fam or $e == $id or ($id | startswith($e + "-"));
       ($lanes | map(select(.lane == "orchestrator")) | .[0].model) as $lead
       | ["availableModels", "modelPicker"][] as $k
       | ($l[0][$k]) as $v
       | (if $k == "availableModels" then ($v | if type == "array" then . else [] end)
          else [($v.options? // [])[]? | .model?] end) as $ids
       | [(if $k == "availableModels" then "model allowlist" else "picker rows" end), $k,
          ($v | tojson), ($t[0][$k] | tojson),
          (if $v == null then "missing"
           elif ($k == "availableModels" and ($v | type) == "array" and ($v | unique) == ($t[0][$k] | unique))
                or $v == $t[0][$k] then "same"
           elif ($k == "availableModels" and ($v | type) != "array") or ($k == "modelPicker" and ($v | type) != "object") then "legacy"
           elif any($ids[]; admits("claude-fable-5-1"; if $k == "availableModels" then "fable" else "" end)) then "legacy"
           elif $k == "availableModels" and any($lanes[]; .model as $id | .alias as $f | any($ids[]; admits($id; $f)) | not)
             then "short:" + ([$lanes[] | .model as $id | .alias as $f | select(any($ids[]; admits($id; $f)) | not) | .model] | unique | join(", "))
           elif $k == "modelPicker" and (any($ids[]; bare == $lead) | not) then "nolead:" + $lead
           else "differs" end)])
    | map(gsub("[\u0000-\u001f]"; "?")) | join("\u001f")'); then
    row "model settings" UNKNOWN "jq could not compare $s with canon/models.json"; return 1
  fi
  while IFS=$'\x1f' read -r name key live want state; do
    case "$state" in
      none)     row "$name" ok "none; every alias follows the vendor's newest model (ADR 0059)" ;;
      pinned)   row "$name" PINNED "$s sets $key=$live, so ${name% alias} will not follow the vendor (ADR 0059); delete env.$key (run: scripts/bootstrap --user-config removes canon's former fable pin)"; rc=1 ;;
      template) row "$name" MISMATCH "home/.claude/settings.json pins $key; ADR 0059 pins no alias"; rc=1 ;;
      unknown)  row "$name" MISMATCH "${live:+$key=$live, but }canon/models.json gives no single model for alias ${name% alias}"; rc=1 ;;
      mismatch) row "$name" MISMATCH "$key=$live; canon/models.json gives $want, and ADR 0059 pins no alias. Delete env.$key in $s"; rc=1 ;;
      ok)       row "$name" ok "$live (the default for new sessions: canon/models.json's session_default_lane)" ;;
      owner)    row "$name" OWNER "$live, a model canon/models.json names but not the session default, $want; /model saves the row Enter picks" ;;
      outside)  row "$name" MISMATCH "$s sets model to $live, which canon/models.json does not name; set it to $want"; rc=1 ;;
      former)   row "$name" OWNER "$live, which an earlier canon template set and is also the orchestrator lane's alias; ADR 0059 makes the default $want, and the lead starts with --model by ID. Left as it is" ;;
      legacy)   row "$name" MISMATCH "$s sets $key to $live, which admits claude-fable-5-1, the picker's legacy Fable row (or is not the shape the docs give); home/.claude/settings.json sets $want (ADR 0059)"; rc=1 ;;
      short:*)  row "$name" MISMATCH "$s sets $key to $live, which does not admit ${state#short:}, a model canon/models.json gives a lane; home/.claude/settings.json sets $want"; rc=1 ;;
      nolead:*) row "$name" MISMATCH "$s sets $key to $live, with no row for ${state#nolead:}, the orchestrator lane's model; home/.claude/settings.json sets $want"; rc=1 ;;
      missing)  row "$name" MISSING "$s sets no $key; run: scripts/bootstrap --user-config"; rc=1 ;;
      same)     row "$name" ok "$key as home/.claude/settings.json sets it" ;;
      *)        row "$name" OWNER "$s sets $key to $live; home/.claude/settings.json sets $want (ADR 0059); left as the owner set it" ;;
    esac
  done <<< "$out"
  return "$rc"
}

# update_row: the release channel Claude Code's background updates follow, as the installed settings and this
# environment set it (https://code.claude.com/docs/en/setup.md: "latest", "receive new features as soon as
# they're released"; "stable", "typically about one week old"; with no key, "The channel you choose at install
# time becomes your default", which no file shows; DISABLE_AUTOUPDATER, DISABLE_UPDATES and
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC turn background updates off). ADR 0065 follows latest, never below
# minimumVersion. A session Orca starts with a prompt carries DISABLE_AUTOUPDATER=1 from Orca itself, which
# is named without failing; `claude doctor` gives the same two lines.
update_row() {
  local s="$CLAUDE_HOME/settings.json" ch="" min="" k v off=""
  if [ -f "$s" ] && jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    ch=$(jq -r '.autoUpdatesChannel // "" | tostring' "$s"); min=$(jq -r '.minimumVersion // "" | tostring' "$s")
    for k in $UPDATE_OFF_VARS; do
      v=$(jq -r --arg k "$k" '(.env // {}) | if type == "object" then .[$k] // "" | tostring else "" end' "$s")
      [ -z "$v" ] || off="$off; $s sets $k"
    done
  else
    row "update channel" MISSING "no readable $s; run: scripts/bootstrap --user-config"; return 1
  fi
  if [ -n "$off" ]; then row "update channel" OFF "background updates off: ${off#; } (any non-empty value is counted)"; return 1; fi
  for k in $UPDATE_OFF_VARS; do [ -z "${!k:-}" ] || off="$off, $k"; done
  local envnote=""; [ -z "$off" ] || envnote="; this environment also sets${off#,}, so this session does not update"
  case "$ch" in
    latest)
      # the environment is the session's, not the machine's: Orca sets DISABLE_AUTOUPDATER for every session
      # it starts, so it is named without failing the check
      if [ -n "$off" ]; then row "update channel" OFF "the settings follow latest, but this environment sets${off#,}, so this session does not update (Orca sets DISABLE_AUTOUPDATER for its sessions)"
      else row "update channel" ok "latest, never below minimumVersion ${min:-(none set)}"; fi ;;
    "")        row "update channel" "NOT SET" "$s names no autoUpdatesChannel, so the channel chosen at install time applies (claude doctor shows it); run: scripts/bootstrap --user-config$envnote"; return 1 ;;
    stable)    row "update channel" MISMATCH "$s follows stable, about a week behind latest (ADR 0065 follows latest); run: scripts/bootstrap --user-config$envnote"; return 1 ;;
    *)         row "update channel" MISMATCH "$s sets autoUpdatesChannel to '$ch', which the docs do not name$envnote"; return 1 ;;
  esac
}

# compact_row: the auto-compact window the installed settings set, against the template's (ADR 0059: canon's
# choice, not a documented recommendation). https://code.claude.com/docs/en/settings-reference.md: top-level
# autoCompactWindow, 100000 to 1000000, any settings file; a model's modelSettings.<model>.autoCompactWindow
# (what /autocompact writes) wins for that model, and --autocompact and CLAUDE_CODE_AUTO_COMPACT_WINDOW win for a
# session (https://code.claude.com/docs/en/model-config.md). Those overrides are named without failing.
compact_row() {
  local s="$CLAUDE_HOME/settings.json" want have per envv over=""
  want=$(jq -r '.autoCompactWindow // empty | tostring' "$ROOT/home/.claude/settings.json" 2>/dev/null)
  if [ ! -f "$s" ] || ! jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    row "auto-compact window" MISSING "no readable $s; run: scripts/bootstrap --user-config"; return 1
  fi
  have=$(jq -r '.autoCompactWindow // empty | tostring' "$s")
  per=$(jq -r '(.modelSettings // {}) | if type == "object" then to_entries | map(select((.value | type) == "object"
          and .value.autoCompactWindow != null) | "\(.key) \(.value.autoCompactWindow)") | join(", ") else "" end' "$s" 2>/dev/null)
  envv=$(jq -r '(.env // {}) | if type == "object" then .CLAUDE_CODE_AUTO_COMPACT_WINDOW // "" | tostring else "" end' "$s" 2>/dev/null)
  [ -z "$per" ] || over="$over; per model (modelSettings, /autocompact): $per"
  [ -z "$envv" ] || over="$over; $s sets CLAUDE_CODE_AUTO_COMPACT_WINDOW=$envv, which wins"
  [ -z "${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-}" ] || over="$over; this environment sets CLAUDE_CODE_AUTO_COMPACT_WINDOW=$CLAUDE_CODE_AUTO_COMPACT_WINDOW, which wins"
  # the status line gives Claude HUD each session's own window; a window in claude-hud.json would replace it with
  # one for every model (ADR 0007)
  local hud; hud=$(jq -r '.display.autoCompactWindow // empty | tostring' "$CLAUDE_HOME/claude-hud.json" 2>/dev/null)
  [ -z "$hud" ] || over="$over; claude-hud.json measures every model's context bar against $hud, not each session's window"
  if [ -z "$want" ]; then row "auto-compact window" UNKNOWN "home/.claude/settings.json sets no autoCompactWindow"; return 1
  elif [ "$have" = "$want" ]; then row "auto-compact window" ok "$have tokens, as home/.claude/settings.json sets it$over"
  elif [ -z "$have" ]; then row "auto-compact window" "NOT SET" "$s sets no autoCompactWindow, so the model's default applies (about 967K for a 1M window); run: scripts/bootstrap --user-config$over"; return 1
  else row "auto-compact window" OWNER "$s sets $have; home/.claude/settings.json sets $want (ADR 0059); left as the owner set it$over"; fi
}

# paper_row <row> <service> <store command>: whether both Alpaca paper key items of one account are in the
# login keychain (ADR 0029, ADR 0069). It looks each item up by service and account without -w or -g, so no
# value is read (man security: find-generic-password). An absent pair is reported and never fails the check:
# only the paper runs need it.
PAPER_SERVICE="canon-alpaca-paper"   # account A, `tests`: the service mise.toml's paper tasks use by default
PAPER_SERVICE_WINDOWS="canon-alpaca-paper-windows"   # account B, `windows` (ADR 0069)
paper_row() {
  local a miss=""
  if ! command -v security >/dev/null 2>&1; then row "$1" absent "no security command here (macOS only)"; return 0; fi
  for a in ALPACA_API_KEY ALPACA_SECRET_KEY; do
    security find-generic-password -s "$2" -a "$a" >/dev/null 2>&1 || miss="$miss $a"
  done
  if [ -z "$miss" ]; then row "$1" ok "login keychain, service $2"
  else row "$1" absent "no keychain item for:$miss; to enter the pair: $3"; fi
}

# toml_python: a python3 that has tomllib (Python 3.11 and later, https://docs.python.org/3/library/tomllib.html):
# the one on PATH, else the one mise.toml pins for this repo; empty when there is neither. Codex's config is
# read with a TOML parser, never a pattern, so a quoted key (['otel']) or an [otel] line inside a string is
# read as TOML reads it.
toml_python() {
  local p
  for p in "$(command -v python3 2>/dev/null)" "$( [ -n "$MISE" ] && cd "$ROOT" && MISE_EXEC_AUTO_INSTALL=false "$MISE" which python3 2>/dev/null)"; do
    [ -n "$p" ] && [ -x "$p" ] && [ "$("$p" -I -c 'import tomllib; print("tomllib")' 2>/dev/null)" = tomllib ] && { echo "$p"; return 0; }
  done
  return 1
}

# codex_otel_state <config.toml>: "canon" when the file's otel table has every key home/.codex/otel.toml sets,
# with its value,
# "other" when it sets otel some other way, "none" when it is absent or sets no otel, "invalid" when it is
# not TOML, "unknown" when no python3 with tomllib is here
codex_otel_state() {
  local py
  [ -f "$1" ] || { echo none; return; }
  py=$(toml_python) || { echo unknown; return; }
  "$py" -I -c 'import sys, tomllib
want = tomllib.load(open(sys.argv[2], "rb"))["otel"]
try: have = tomllib.load(open(sys.argv[1], "rb"))
except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError): print("invalid"); sys.exit()
o = have.get("otel")
print("none" if o is None else "canon" if isinstance(o, dict) and all(o.get(k) == v for k, v in want.items()) else "other")' "$1" "$ROOT/home/.codex/otel.toml" \
    || echo unknown
}

# logs_override <settings.json>: the per-signal logs variables that would send Claude Code's logs elsewhere than
# the general endpoint canon sets, named (never their values, which may hold a credential), from the
# settings' env and from this environment
# (Claude Code: OTEL_EXPORTER_OTLP_LOGS_ENDPOINT and OTEL_EXPORTER_OTLP_LOGS_PROTOCOL each "overrides general
# setting", https://code.claude.com/docs/en/monitoring-usage.md; the OTLP exporter spec: "The per-signal
# endpoint configuration options take precedence",
# https://opentelemetry.io/docs/specs/otel/protocol/exporter/). Canon sets neither.
LOGS_OVERRIDES="OTEL_EXPORTER_OTLP_LOGS_ENDPOINT OTEL_EXPORTER_OTLP_LOGS_PROTOCOL"
logs_override() {
  local k v out=""
  for k in $LOGS_OVERRIDES; do
    v=$(jq -r --arg k "$k" '(.env // {})[$k] // empty | tostring' "$1" 2>/dev/null) || v=""
    [ -n "$v" ] && out="$out; $1 sets $k"
    [ -n "${!k:-}" ] && out="$out; this environment sets $k"
  done
  printf '%s' "${out#; }"
}

# telemetry_rows: whether the user settings carry every telemetry variable (CLAUDE_CODE_ENABLE_TELEMETRY,
# OTEL_*; the model alias pins have their own row) home/.claude/settings.json sets,
# with its value, and whether Codex's config has canon's [otel] table
telemetry_rows() {
  local s="$CLAUDE_HOME/settings.json" miss differ over rc=0
  # shellcheck disable=SC2016  # jq programs, not shell
  if ! jq -e 'type == "object" and ((.env // {}) | type == "object")' "$s" >/dev/null 2>&1 \
     || ! miss=$(jq -r --slurpfile w "$ROOT/home/.claude/settings.json" --arg re "$TELEMETRY_RE" \
                   'def telemetry: with_entries(select(.key | test($re))); (.env // {}) as $e | [($w[0].env // {} | telemetry) | to_entries[] | select($e[.key] == null) | .key] | join(" ")' "$s") \
     || ! differ=$(jq -r --slurpfile w "$ROOT/home/.claude/settings.json" --arg re "$TELEMETRY_RE" \
                   'def telemetry: with_entries(select(.key | test($re))); (.env // {}) as $e | [($w[0].env // {} | telemetry) | to_entries[] | select($e[.key] != null and $e[.key] != .value) | .key] | join(" ")' "$s"); then
    row "telemetry settings" MISSING "no readable $s with an object env; run: scripts/bootstrap --user-config"; rc=1
  elif [ -n "$miss" ]; then
    row "telemetry settings" MISSING "$s lacks: $miss; run: scripts/bootstrap --user-config"; rc=1
  elif over=$(logs_override "$s") && [ -n "$over" ]; then
    row "telemetry settings" OWNER "logs do not reach the local collector: $over, which overrides canon's general endpoint${differ:+; it also sets $differ to a value other than the one canon sets}"
  elif [ -n "$differ" ]; then
    row "telemetry settings" OWNER "$s sets $differ to another value than canon's (left as the owner set it)"
  else row "telemetry settings" ok "OTLP logs to the local collector (ADR 0007)"; fi
  case "$(codex_otel_state "$CODEX_DIR/config.toml")" in
    canon) row "codex telemetry" ok "$CODEX_DIR/config.toml has canon's [otel] table" ;;
    other) row "codex telemetry" OWNER "$CODEX_DIR/config.toml sets otel itself; canon's table is in home/.codex/otel.toml" ;;
    invalid) row "codex telemetry" INVALID "$CODEX_DIR/config.toml is not valid TOML; Codex cannot read it either" ;;
    unknown) row "codex telemetry" UNKNOWN "no python3 with tomllib to read $CODEX_DIR/config.toml; run: scripts/bootstrap --install" ;;
    *)     row "codex telemetry" absent "no canon [otel] table in $CODEX_DIR/config.toml; run: scripts/bootstrap --user-config" ;;
  esac
  return "$rc"
}

# The OmniRoute gateway (ADR 0056), optional: installed only on request, from mise's `gateway` config
# environment (mise.gateway.toml, locked in mise.gateway.lock).
# omniroute_version_row: the installed version against the registry's pin. `mise where` says whether the
# environment's version is installed; `omniroute --version` alone takes OmniRoute's fast path, which prints
# package.json's version before any .env is read (bin/omniroute.mjs). Not installed is absent and passes; an
# installed one whose version cannot be read is UNKNOWN and fails, never "absent".
# omniroute_row: no Anthropic or Claude connection, API-key connections only, and every API key no-log
# (ADR 0056). It reads the provider_connections table OmniRoute's `providers list` reads
# (bin/cli/provider-store.mjs) and the api_keys table (src/lib/db/apiKeys.ts) with Apple's sqlite3, the SQL on
# stdin after `PRAGMA query_only=1`, so nothing is written (OmniRoute's own CLI would open the database for
# writing, run its schema steps and read a .env from the folder it starts in). It selects provider, name,
# display name, e-mail, default model, auth type and, for a key, its name and no_log flag, never a key or
# token column. A connection whose provider, labels or default model says Anthropic or Claude fails the
# check, as does one whose auth type is not apikey (a sign-in), an unrevoked key that is not no-log, and
# tables that cannot be read, which would otherwise pass for none.
OMNIROUTE_DATA="$HOME/.omniroute"   # the folder mise.gateway.toml's omniroute:serve sets as DATA_DIR
OMNIROUTE_ANTHROPIC_RE='anthropic|claude'   # provider ids anthropic, claude, claude-web, anthropic-compatible-*
SQLITE3="${CANON_SQLITE3:-/usr/bin/sqlite3}"
omniroute_version_row() {
  local pin v
  OMNIROUTE_RUNTIME_VERSION="not reported (OmniRoute not installed or version check unavailable)"
  pin=$(jq -r '.upstreams[] | select(.id == "omniroute") | .track // empty' "$ROOT/canon/upstreams.json" 2>/dev/null)
  pin=${pin#tag:}; pin=${pin#v}
  if [ -z "$MISE" ]; then row "omniroute" UNKNOWN "no mise to ask; run: scripts/bootstrap --install"; return 1; fi
  if ! (cd "$ROOT" && MISE_ENV=gateway "$MISE" where npm:omniroute >/dev/null 2>&1); then
    row "omniroute" absent "not installed; to install: mise -E gateway install --locked npm:omniroute"; return 0
  fi
  if ! v=$(cd "$ROOT" && MISE_ENV=gateway MISE_EXEC_AUTO_INSTALL=false NO_UPDATE_NOTIFIER=1 "$MISE" exec -- omniroute --version 2>&1 | first_line) \
     || ! dotted "$v"; then
    row "omniroute" UNKNOWN "installed, but omniroute --version gave '${v:-nothing}'"; return 1
  fi
  OMNIROUTE_RUNTIME_VERSION="$v"
  if [ -z "$pin" ]; then row "omniroute" UNKNOWN "$v; no omniroute pin in canon/upstreams.json"; return 1; fi
  # the gateway's state as omniroute:check reports it (mise.gateway.toml): an inference route answers a made-up
  # key with 401 when the gateway runs requiring its API key (Apple's curl -q --noproxy '*', as every gateway
  # call there: no curlrc, no proxy; CANON_CURL: tests only)
  local code gw
  # (the header from a here-string, not a pipe: under pipefail a curl that never read it would fail the probe)
  code=$("${CANON_CURL:-/usr/bin/curl}" -q --noproxy '*' -sS -o /dev/null -w '%{http_code}' --max-time 10 -H @- -H 'Content-Type: application/json' \
        --data-binary '{}' http://127.0.0.1:20128/v1/chat/completions 2>/dev/null \
        <<<"Authorization: Bearer canon-made-up-$(/usr/bin/openssl rand -hex 16 2>/dev/null)") || code=000
  case "$code" in
    401) gw="the gateway is running on 127.0.0.1:20128, its API key required" ;;
    000) gw="the gateway is not running (scripts/automation status shows its agent; by hand: mise -E gateway run omniroute:serve)" ;;
    *) row "omniroute" FAILED "$v; the gateway on 127.0.0.1:20128 answered a made-up key with $code, not 401: its API key is not required (ADR 0056)"; return 1 ;;
  esac
  if [ "$v" = "$pin" ]; then row "omniroute" ok "$v; pinned $pin; $gw"
  else row "omniroute" OTHER "$v installed; pinned $pin (canon/upstreams.json); $gw; run: mise -E gateway install --locked npm:omniroute"; return 1; fi
}
omniroute_row() {
  local db="$OMNIROUTE_DATA/storage.sqlite" out ids bad
  if [ ! -e "$db" ]; then row "omniroute providers" absent "no gateway data in $OMNIROUTE_DATA"; return 0; fi
  if ! out=$(printf '%s\n' 'PRAGMA query_only=1;' '.mode json' \
               "SELECT 'connection' AS kind, provider, coalesce(name, '') || ' ' || coalesce(display_name, '') || ' ' || coalesce(email, '') AS name, coalesce(default_model, '') AS default_model, coalesce(auth_type, '') AS auth_type, 1 AS no_log FROM provider_connections UNION ALL SELECT 'key', '', name, '', '', coalesce(no_log, 0) FROM api_keys WHERE revoked_at IS NULL;" \
             | "$SQLITE3" -bail "$db" 2>/dev/null) \
     || ! ids=$(jq -rs 'add // [] | map(select(.kind == "connection") | .provider) | unique | join(" ")' <<<"$out" 2>/dev/null); then
    row "omniroute providers" UNKNOWN "could not read the connections in $db"; return 1
  fi
  bad=$(jq -rs --arg re "$OMNIROUTE_ANTHROPIC_RE" 'add // [] | map(select(.kind == "connection" and ((.provider + " " + .name + " " + .default_model) | test($re; "i"))) | .provider) | unique | join(" ")' <<<"$out")
  if [ -n "$bad" ]; then row "omniroute providers" FAILED "Anthropic or Claude connection(s): $bad; remove them in the dashboard, Claude stays native (ADR 0056)"; return 1; fi
  bad=$(jq -rs 'add // [] | map(select(.kind == "connection" and .auth_type != "apikey") | "\(.provider) (\(.auth_type))") | unique | join(" ")' <<<"$out")
  if [ -n "$bad" ]; then row "omniroute providers" FAILED "not API-key connection(s): $bad; API keys only, never a sign-in (ADR 0056): remove them in the dashboard"; return 1; fi
  bad=$(jq -rs 'add // [] | map(select(.kind == "key" and (.no_log | tostring) != "1") | .name) | unique | join(", ")' <<<"$out")
  if [ -n "$bad" ]; then row "omniroute providers" FAILED "API key(s) that log request bodies: $bad; revoke them and mint one with omniroute:setup (ADR 0056)"; return 1; fi
  row "omniroute providers" ok "${ids:-no connections}; none Anthropic, API keys only, every key no-log"
}

# The review-only workers (ADR 0045). DeepSeek Harness reads its profile's user patch last, a YAML array
# whose rows override a bundle's row by id, the config block replaced whole (dsh-TUI v0.17.0
# docs/configuration.en.md, "Profiles and patch layers").
DSH_PATCH_SRC="$ROOT/home/dsh/review.patch.yml"
DSH_MARK_BEGIN='# canon bootstrap: review settings'
DSH_MARK_END='# end canon bootstrap: review settings'
dsh_profile_dir() { printf '%s/profiles/dsh-tui' "${DSH_HOME:-$HOME/.dsh}"; }
# A row the user patch could already hold for one of these ids: block or flow style, quoted or not
DSH_ID_RE='id:[[:space:]]*["'"'"']?(session-log-deepseek|memento)["'"'"']?([[:space:],}#]|$)'
# dsh_block <file>: the canon block in a patch file, marker to end marker; dsh_outside <file>: every other line
dsh_block() { awk -v b="$DSH_MARK_BEGIN" -v e="$DSH_MARK_END" 'index($0, b) == 1 && !on && !done { on = 1 } on { print } on && $0 == e { on = 0; done = 1 }' "$1"; }
dsh_outside() { awk -v b="$DSH_MARK_BEGIN" -v e="$DSH_MARK_END" 'index($0, b) == 1 && !on && !done { on = 1; next } on && $0 == e { on = 0; done = 1; next } !on { print }' "$1"; }
# dsh_state <file>: current (the block as home/dsh/review.patch.yml has it, no other row for its ids),
# stale (an older canon block, no other row), conflict (a row for one of its ids outside the block), none,
# unreadable (the file is there but cannot be read, so nothing about it is known)
dsh_state() {
  local outside
  [ -f "$1" ] || { echo none; return; }
  # the lines are read whole before grep sees them: piped, an early match stops grep reading, and under
  # pipefail the awk it cut off (SIGPIPE, exit 141) would make a conflict read as no conflict
  outside=$(dsh_outside "$1" 2>/dev/null) || { echo unreadable; return; }
  if grep -Eq "$DSH_ID_RE" <<<"$outside"; then echo conflict
  elif ! grep -qF "$DSH_MARK_BEGIN" "$1"; then echo none
  elif [ "$(dsh_block "$1")" = "$(cat "$DSH_PATCH_SRC")" ]; then echo current
  else echo stale; fi
}
dsh_row() {
  local dir dst; dir=$(dsh_profile_dir); dst="$dir/cordis.patch.yml"
  if [ ! -d "$dir" ]; then row "dsh-tui review patch" absent "no dsh-tui profile at $dir"; return; fi
  case "$(dsh_state "$dst")" in
    current)  row "dsh-tui review patch" ok "session log and dsh-memento off in $dst" ;;
    conflict) row "dsh-tui review patch" "NOT SET" "another row in $dst sets session-log-deepseek or memento; merge home/dsh/review.patch.yml by hand" ;;
    unreadable) row "dsh-tui review patch" UNKNOWN "$dst cannot be read" ;;
    *)        row "dsh-tui review patch" "NOT SET" "home/dsh/review.patch.yml's rows are not in $dst; run: scripts/bootstrap --install" ;;
  esac
}
# Antigravity's self-updater. Its troubleshooting page gives `export AGY_CLI_DISABLE_AUTO_UPDATE=true` in the
# shell profile to stop it; an earlier --install wrote that line with a comment of its own (ADR 0045), and ADR
# 0059 reverses that, so --install removes exactly canon's pair (the comment and the line after it, with the
# blank line before them). A line of the owner's is left alone and named.
AGY_RE='^[[:space:]]*export[[:space:]]+AGY_CLI_DISABLE_AUTO_UPDATE=true[[:space:]]*$'
AGY_CANON_COMMENT='# Antigravity CLI: background self-updater off, so agy stays at its pin (docs/adr/0045)'
# agy_without_canon <file>: the file without canon's pair; agy_canon_pair <file>: true when the pair is there
agy_without_canon() {
  awk -v c="$AGY_CANON_COMMENT" -v re="$AGY_RE" '{ l[NR] = $0 }
    END { for (i = 1; i <= NR; i++) if (l[i] == c && (i + 1) in l && l[i + 1] ~ re) { s[i] = 1; s[i + 1] = 1; if (i > 1 && l[i - 1] == "") s[i - 1] = 1 }
          for (i = 1; i <= NR; i++) if (!(i in s)) print l[i] }' "$1"
}
agy_canon_pair() { [ -f "$1" ] && [ "$(agy_without_canon "$1")" != "$(cat "$1")" ]; }
agy_row() {
  local rc="$HOME/.zshrc"
  if agy_canon_pair "$rc"; then row "agy self-updater" OFF "canon's earlier AGY_CLI_DISABLE_AUTO_UPDATE line is in ~/.zshrc; ADR 0065 turns the updater on: run scripts/bootstrap --install"
  elif grep -q 'AGY_CLI_DISABLE_AUTO_UPDATE' "$rc" 2>/dev/null; then row "agy self-updater" OWNER "$rc names AGY_CLI_DISABLE_AUTO_UPDATE itself; left as the owner set it (ADR 0065 has the updater on)"
  elif command -v agy >/dev/null 2>&1; then row "agy self-updater" on "agy updates itself (ADR 0065), except in a launch Orca starts with a prompt; agy update does it at once"
  else row "agy self-updater" absent "no agy on PATH"; fi
}

# codex_defaults <config.toml>: JSON naming the settings of home/.codex/defaults.toml the file lacks
# ("missing"), sets to another value ("other"), and those an active profile sets ("profile_sets"; Codex: a
# profile's keys override the top level, https://learn.chatgpt.com/docs/config-file/config-reference), or
# {"state": "invalid"} when it is not TOML and {"state": "unknown"} when no python3 with tomllib is here. A
# setting is a top-level key of the template, or one entry of a top-level table (permissions.canon-worker,
# ADR 0034), compared as a whole. "sandbox" lists the older sandbox keys the file sets (top level or active
# profile), which Codex uses instead of default_permissions (https://learn.chatgpt.com/docs/permissions). With
# a second argument, it also writes to that path the file with the missing settings at its top, where TOML
# keeps keys of no table, and fails (exit 3) unless the result reads as the old file plus exactly those.
codex_defaults() {
  local py
  py=$(toml_python) || { echo '{"state": "unknown"}'; return; }
  CANON_CODEX_DIR="$CODEX_DIR" "$py" -I -c 'import json, os, re, sys, tomllib
src, want_path = sys.argv[1], sys.argv[2]
out = sys.argv[3] if len(sys.argv) > 3 else None
want = tomllib.load(open(want_path, "rb"))
# the sign-in file sits in CODEX_HOME (codex-rs/utils/home-dir), so a deny of the default one follows it
cdir, ddir = os.environ.get("CANON_CODEX_DIR", ""), os.path.expanduser("~/.codex")
for prof_t in (want.get("permissions") or {}).values():
    fs = prof_t.get("filesystem") if isinstance(prof_t, dict) else None
    if isinstance(fs, dict) and cdir and os.path.realpath(cdir) != os.path.realpath(ddir):
        prof_t["filesystem"] = {(os.path.join(cdir, "auth.json") if k == "~/.codex/auth.json" else k): v for k, v in fs.items()}
try:
    raw = open(src, "rb").read()
    have = tomllib.loads(raw.decode())
except FileNotFoundError:
    raw, have = b"", {}
except OSError:
    print(json.dumps({"state": "unreadable"})); sys.exit()
except (UnicodeDecodeError, tomllib.TOMLDecodeError):
    print(json.dumps({"state": "invalid"})); sys.exit()
NONE = object()
def get(d, path):
    for k in path:
        if not isinstance(d, dict) or k not in d:
            return NONE
        d = d[k]
    return d
def tkey(k):
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k)
def tval(v):
    if isinstance(v, bool): return "true" if v else "false"
    if isinstance(v, (int, float)): return repr(v)
    if isinstance(v, str): return json.dumps(v)
    if isinstance(v, list): return "[" + ", ".join(tval(x) for x in v) + "]"
    if isinstance(v, dict): return "{" + ", ".join(tkey(k) + " = " + tval(x) for k, x in v.items()) + "}"
    raise TypeError(type(v))
units = [u for k, v in want.items() for u in ([(k, c) for c in v] if isinstance(v, dict) else [(k,)])]
name = lambda u: ".".join(u)
missing = [u for u in units if get(have, u) is NONE]
other = [u for u in units if get(have, u) is not NONE and get(have, u) != get(want, u)]
prof = have.get("profile")
pts = have.get("profiles")
pt = pts.get(prof) if isinstance(prof, str) and isinstance(pts, dict) else None
pt = pt if isinstance(pt, dict) else {}
psets = [u for u in units if get(pt, u) is not NONE and get(pt, u) != get(want, u)]
sandbox = [k for k in ("sandbox_mode", "sandbox_workspace_write") if k in have] + ["profiles." + prof + "." + k for k in ("sandbox_mode", "sandbox_workspace_write") if k in pt]
def merged(adds):
    """the file with adds at its top, or None unless it reads as the old file plus exactly those"""
    head = "# canon: native defaults and the worker permissions profile (home/.codex/defaults.toml, docs/adr/0059-native-defaults-for-every-runtime.md, docs/adr/0034-each-runtime-in-its-own-sandbox.md)\n"
    head += "".join(".".join(tkey(k) for k in u) + " = " + tval(get(want, u)) + "\n" for u in adds)
    new = head.encode() + (b"\n" + raw if raw else b"")
    try:
        got = tomllib.loads(new.decode())
    except tomllib.TOMLDecodeError:
        return None
    if any(get(got, u) != get(want, u) for u in adds):
        return None
    for u in adds:   # take the new settings out again: what is left must be the old file
        d = got
        for k in u[:-1]: d = d[k]
        del d[u[-1]]
        if len(u) > 1 and not d and get(have, u[:-1]) is NONE: del got[u[0]]
    return new if got == have else None
unwritten = []
if out and missing:
    # a table entry (permissions.canon-worker) cannot always join a table the file already declares; the
    # top-level keys are then written without it, and it is named
    new = merged(missing)
    if new is None:
        top = [u for u in missing if len(u) == 1]
        new = merged(top) if top else None
        unwritten = [name(u) for u in missing if len(u) > 1]
    if new is None:
        sys.exit(3)
    open(out, "wb").write(new)
effective = {name(u): get(pt, u) if get(pt, u) is not NONE else (None if get(have, u) is NONE else get(have, u)) for u in units}
sources = {name(u): "profiles." + prof + "." + name(u) if get(pt, u) is not NONE else name(u) for u in units}
print(json.dumps({"state": "read", "units": [name(u) for u in units], "missing": [name(u) for u in missing], "other": [name(u) for u in other], "profile": prof if isinstance(prof, str) else None, "profile_sets": [name(u) for u in psets], "unwritten": unwritten, "sandbox": sandbox, "effective": effective, "sources": sources}))' "$1" "$CODEX_DEFAULTS_SRC" ${2:+"$2"}
}
# the settings of home/.codex/defaults.toml that make up ADR 0034's worker profile; the rest are ADR 0059's
CODEX_PERM_RE='^(approval_policy|default_permissions|permissions[.])'
# codex_settings_row <row name> <jq filter selecting the settings> <what they are> <what NOT SET means>:
# one --check row for some of home/.codex/defaults.toml's settings, read from the file
codex_settings_row() {
  local c="$CODEX_DIR/config.toml" j sel="$2" re="$CODEX_PERM_RE"
  if [ ! -d "$CODEX_DIR" ]; then row "$1" absent "no $CODEX_DIR (Codex not installed)"; return; fi
  j=$(codex_defaults "$c") || j='{"state": "unknown"}'
  case "$(jq -r '.state' <<<"$j")" in
    invalid) row "$1" INVALID "$c is not valid TOML; Codex cannot read it either"; return ;;
    unreadable) row "$1" UNKNOWN "$c cannot be read"; return ;;
    unknown) row "$1" UNKNOWN "no python3 with tomllib to read $c; run: scripts/bootstrap --install"; return ;;
  esac
  # shellcheck disable=SC2016  # jq program, not shell
  j=$(jq -c --arg re "$re" "def pick: map(select($sel)); .units |= pick | .missing |= pick | .other |= pick | .profile_sets |= pick" <<<"$j")
  local want; want=$(jq -r '.units | join(", ")' <<<"$j")
  if [ "$(jq '.profile_sets | length' <<<"$j")" != 0 ]; then
    row "$1" OWNER "the active profile $(jq -r '.profile' <<<"$j") in $c sets $(jq -r '.profile_sets | join(", ")' <<<"$j") otherwise, which overrides $3"
  elif [ "$(jq '.other | length' <<<"$j")" != 0 ]; then
    row "$1" OWNER "$c sets $(jq -r '.other | join(", ")' <<<"$j") to another value than home/.codex/defaults.toml ($want); left as the owner set it"
  elif [ "$(jq '.missing | length' <<<"$j")" != 0 ]; then
    row "$1" "NOT SET" "$c lacks $(jq -r '.missing | join(", ")' <<<"$j"), so $4; run: scripts/bootstrap --user-config"
  elif [ "$5" = perm ] && [ "$(jq '.sandbox | length' <<<"$j")" != 0 ]; then
    row "$1" OWNER "$c sets $(jq -r '.sandbox | join(", ")' <<<"$j"), which Codex uses instead of default_permissions (learn.chatgpt.com/docs/permissions)"
  elif [ "$5" = perm ]; then row "$1" ok "$want as home/.codex/defaults.toml$6"
  else row "$1" ok "$(jq -r '[.units[] as $u | "\($u) = \(.effective[$u] | tojson)"] | join(" ")' <<<"$j") $6"; fi
}
codex_defaults_row() {
  # shellcheck disable=SC2016  # jq filter, not shell
  codex_settings_row "codex defaults" 'test($re) | not' "home/.codex/defaults.toml's model and effort" \
    "Codex starts on its catalog default" model "(home/.codex/defaults.toml, ADR 0059)"
}
# the worker profile is in force for a launch with no --sandbox and no bypass flag; Orca's pre-filled
# --dangerously-bypass-approvals-and-sandbox wins over it (ADR 0034, Confirmation)
codex_permissions_row() {
  # shellcheck disable=SC2016  # jq filter, not shell
  codex_settings_row "codex permissions" 'test($re)' "the canon-worker profile" \
    "the canon-worker profile is not set and not the default" perm "; canon-worker is the default profile in this user config (ADR 0034; a project .codex/config.toml is not read here)"
}

# codex_version_row: Codex's version (`codex --version`, "codex-cli <version>") against the pin main's
# registry records (canon/upstreams.json codex-cli, tag:rust-v<version>). The maintenance agent brings it to
# the pin at its next round on main (ADR 0065); by hand: mise use -g codex@<pin>.
codex_version_row() {
  local pin v t
  pin=$(jq -r '.upstreams[]? | select(.id == "codex-cli") | .track // empty' "$ROOT/canon/upstreams.json" 2>/dev/null | sed -n 's/^tag:rust-v//p' | first_line)
  if ! command -v codex >/dev/null 2>&1; then row "codex version" absent "no codex on PATH (Codex not installed)"; return; fi
  v=$(runtime_version codex); t=$(sed -n 's/^codex-cli \([0-9][0-9A-Za-z.+-]*\)$/\1/p' <<<"$v")
  if [ -z "$pin" ]; then row "codex version" UNKNOWN "$v; no readable codex-cli pin in canon/upstreams.json"
  elif [ -z "$t" ]; then row "codex version" UNKNOWN "cannot read a version from '$v'; pinned $pin (canon/upstreams.json)"
  elif [ "$t" = "$pin" ]; then row "codex version" ok "$t; pinned $pin"
  else row "codex version" OUTDATED "$t; pinned $pin (canon/upstreams.json); the maintenance agent's next round on main moves it, or: mise use -g codex@$pin"; fi
}

# agy_label: the label canon/models.json gives Antigravity's default model; agy_model_state: ok, missing,
# other, invalid (not a JSON object), absent (no agy folder)
agy_label() { jq -r '.runtimes[]? | select(.runtime == "antigravity") | .label // empty' "$ROOT/canon/models.json" 2>/dev/null | first_line; }
agy_model_state() {
  local want="$1"
  [ -d "$(dirname "$AGY_SETTINGS")" ] || { echo absent; return; }
  [ -f "$AGY_SETTINGS" ] || { echo missing; return; }
  jq -e 'type == "object"' "$AGY_SETTINGS" >/dev/null 2>&1 || { echo invalid; return; }
  jq -r --arg w "$want" 'if (.model // "") == "" then "missing" elif .model == $w then "ok" else "other" end' "$AGY_SETTINGS"
}
agy_model_row() {
  local want; want=$(agy_label)
  [ -n "$want" ] || { row "agy default model" UNKNOWN "canon/models.json gives no label for antigravity"; return; }
  case "$(agy_model_state "$want")" in
    ok)      row "agy default model" ok "$want ($AGY_SETTINGS, ADR 0059)" ;;
    other)   row "agy default model" OWNER "$AGY_SETTINGS sets model to $(jq -r '.model' "$AGY_SETTINGS"); canon/models.json gives $want" ;;
    missing) row "agy default model" "NOT SET" "$AGY_SETTINGS sets no model, so agy starts on its own default; run: scripts/bootstrap --user-config" ;;
    invalid) row "agy default model" INVALID "$AGY_SETTINGS is not a JSON object" ;;
    *)       row "agy default model" absent "no $(dirname "$AGY_SETTINGS") (Antigravity not installed)" ;;
  esac
}

# Runtime TSV contract: seven tab-separated fields, one row per runtime, indented by two spaces.
# These are configured defaults, not a claim about a running request or a launch override (ADR 0059).
# Sources read 2026-11-11: Muse's install/configuration pages document --version and launch flags;
# Antigravity settings.model is a label and may fall back, so its actual model is not reported here.
# Orca's pinned docs/site/content/docs/cli/{overview,reference}.mdx document no version command.
# UNVERIFIED fetches: https://www.onorca.dev/docs/cli and https://www.onorca.dev/docs/cli/orchestration
# were inaccessible;
# https://raw.githubusercontent.com/deepseek-ai/deepseek-harness/main/README.md returned 404.
# The pinned Orca docs and DeepSeek apps/cli/{package.json,src/args.ts,src/dump-config.ts} were read instead.
# runtime_version <command>: its --version, bounded to 10 s the way the maintenance agent bounds a step
# (/usr/bin/timeout), with stdin closed, so a runtime that waits on a prompt or an update cannot hang --check
runtime_version() {
  local v t=()
  [ -x /usr/bin/timeout ] && t=(/usr/bin/timeout -k 2 10)
  if ! command -v "$1" >/dev/null 2>&1; then printf 'not reported (%s not on PATH)' "$1"
  elif v=$(MISE_EXEC_AUTO_INSTALL=false ${t[@]+"${t[@]}"} "$1" --version 2>/dev/null </dev/null | first_line) && [ -n "$v" ]; then printf '%s' "$v"
  else printf 'not reported (%s --version failed, timed out or returned no output)' "$1"; fi
}
runtime_row() {
  # Keep one physical TSV row even when a settings value contains tabs or newlines.
  local value
  printf '  %s' "$1"; shift
  for value in "$@"; do value=${value//$'\t'/ }; value=${value//$'\n'/ }; printf '\t%s' "$value"; done
  printf '\n'
}
runtimes_rows() {
  local j model effort ms es label fields v
  note 'Runtimes (configured defaults; launch and session overrides are not observed):'
  printf '  RUNTIME\tVERSION\tMODEL\tEFFORT\tVERSION SOURCE\tMODEL SOURCE\tEFFORT SOURCE\n'
  # settings.json's own env block, which new sessions get, not this process's environment
  j=$(jq -c '{model, effortLevel, em: (.env.ANTHROPIC_MODEL // null), ee: (.env.CLAUDE_CODE_EFFORT_LEVEL // null)}' \
        "$CLAUDE_HOME/settings.json" 2>/dev/null) || j='{}'
  model=$(jq -r '.em // .model // "not reported (settings.model unset or unreadable)"' <<<"$j")
  effort=$(jq -r '.ee // .effortLevel // "not reported (effortLevel unset; runtime chooses the default)"' <<<"$j")
  ms='user settings.json model; alias resolution and other scopes not observed'
  es='user settings.json effortLevel; per-model modelSettings levels, the model default and other scopes not resolved (model-config.md)'
  [ "$(jq -r '.em // empty' <<<"$j")" = "" ] || ms='user settings.json env.ANTHROPIC_MODEL'
  [ "$(jq -r '.ee // empty' <<<"$j")" = "" ] || es='user settings.json env.CLAUDE_CODE_EFFORT_LEVEL'
  v=$(claude_version)
  [ -n "$v" ] || v='not reported (claude --version failed in ~/.local/bin and on PATH)'
  runtime_row 'Claude Code' "$v" "$model" "$effort" 'claude --version (~/.local/bin first, then PATH)' "$ms" "$es"
  j=$(codex_defaults "$CODEX_DIR/config.toml" 2>/dev/null) || j='{}'
  [ -n "$j" ] || j='{}'
  model=$(jq -r '.effective.model // "not reported (config model unset or unreadable)"' <<<"$j")
  effort=$(jq -r '.effective.model_reasoning_effort // "not reported (config effort unset or unreadable)"' <<<"$j")
  ms=$(jq -r '.sources.model // "model"' <<<"$j"); es=$(jq -r '.sources.model_reasoning_effort // "model_reasoning_effort"' <<<"$j")
  runtime_row Codex "$(runtime_version codex)" "$model" "$effort" 'codex --version' "config.toml $ms (active profile applied; other scopes not observed)" "config.toml $es"
  runtime_row 'Muse Code' "$(runtime_version muse)" 'not reported (model defaults key undocumented; per-launch --model)' \
    'not reported (per-launch --reasoning-effort; no launch observed)' 'muse --version (dev.meta.ai/docs/muse-code)' \
    'dev.meta.ai/docs/muse-code/configuration' 'dev.meta.ai/docs/muse-code/configuration'
  if [ ! -e "$AGY_SETTINGS" ]; then label='none, no settings file'
  else label=$(jq -r '.model // "unset"' "$AGY_SETTINGS" 2>/dev/null) || label=unreadable; fi
  runtime_row Antigravity "$(runtime_version agy)" "not reported (configured label: $label; availability fallback not observed)" \
    'not reported (label is not evidence of the selected request effort)' 'agy --version' \
    'settings.json model; antigravity.google/docs/settings' 'antigravity.google/docs/settings'
  # Even --dump-config rewrites cordis.yml through prepareProfile; --check must remain read-only.
  fields='deepseek-harness 1f81c047fc48fa190a683e469daa699857e9afe8 apps/cli/src/profile-boot.ts:194-198'
  model='not reported (--dump-config rewrites cordis.yml; read-only check does not run it)'
  runtime_row 'DeepSeek Harness' "$(runtime_version dsh)" "$model" "$model" 'dsh --version' "$fields" "$fields"
  runtime_row Orca 'not reported (no version command in pinned CLI reference)' 'not reported (host; per-agent launch override)' \
    'not reported (host; per-agent launch override)' 'Orca pinned CLI overview/reference, read 2026-11-11' \
    'Orca per-agent launch documentation' 'Orca per-agent launch documentation'
  runtime_row OmniRoute "${OMNIROUTE_RUNTIME_VERSION:-not reported (version check unavailable)}" 'not applicable (gateway; model supplied by request)' \
    'not applicable (gateway; effort supplied by request)' 'mise gateway exec -- omniroute --version (gateway row above)' \
    'OmniRoute OpenAI-compatible request contract, ADR 0056' 'OmniRoute OpenAI-compatible request contract, ADR 0056'
}

check() {
  local missing=0 v t pin
  note "Toolchain (ADR 0008):"
  if have_clt; then row "Command Line Tools" ok "$(xcode-select -p)"; else row "Command Line Tools" MISSING "run: xcode-select --install"; missing=1; fi
  # /usr/bin/git is a stub that opens an install dialog when the tools are absent, so only call it when they exist
  if have_clt; then row git ok "$(git --version 2>/dev/null)"; else row git MISSING "comes with Command Line Tools"; missing=1; fi
  for t in curl jq; do
    if command -v "$t" >/dev/null 2>&1; then row "$t" ok "$("$t" --version 2>/dev/null | first_line)"; else row "$t" MISSING ""; missing=1; fi
  done
  if [ -n "$MISE" ] && [ -x "$MISE" ]; then
    v=$("$MISE" --version 2>/dev/null | first_line) || v=""
    if [ "v${v%% *}" = "$MISE_VERSION" ]; then row mise ok "$MISE: $v"
    else row mise OUTDATED "$MISE: ${v:-no version}; pinned $MISE_VERSION (canon/upstreams.json)"; missing=1; fi
    for t in python uv node gh; do
      if v=$(cd "$ROOT" && MISE_EXEC_AUTO_INSTALL=false "$MISE" exec -- "$t" --version 2>/dev/null | first_line) && [ -n "$v" ]; then
        row "$t (mise)" ok "$v"
      else row "$t (mise)" MISSING "run: scripts/bootstrap --install"; missing=1; fi
    done
  else
    row mise MISSING "run: scripts/bootstrap --install"; missing=1
    for t in python uv node gh; do row "$t (mise)" MISSING "installed by mise"; done
  fi
  if have_claude; then
    v=$(claude_version)
    t=${v%% *}; t=${t#v}; pin=$(claude_pin)
    if [ -z "$pin" ]; then row "claude CLI" UNKNOWN "${v:-no version}; no readable claude-code pin in canon/upstreams.json"; missing=1
    elif ! dotted "$t"; then row "claude CLI" UNKNOWN "cannot read a version from '${v:-nothing}'; pinned $pin (canon/upstreams.json)"; missing=1
    elif ver_ge "$t" "$pin"; then
      if ver_ge "$pin" "$t"; then row "claude CLI" ok "$t; pinned $pin"
      else row "claude CLI" ok "$t, ahead of the pin $pin (the floor; ADR 0065)"; fi
    else row "claude CLI" BEHIND "$t; pinned $pin (canon/upstreams.json); run: claude install $pin"; missing=1; fi
  else row "claude CLI" MISSING "run: scripts/bootstrap --install"; missing=1; fi
  note "Machine-level Claude Code config (ADR 0007), in $CLAUDE_HOME:"
  check_hooks || missing=1
  check_model_settings || missing=1
  update_row || missing=1
  compact_row || missing=1
  if [ -f "$CLAUDE_HOME/CLAUDE.md" ]; then row "user CLAUDE.md" ok ""; else row "user CLAUDE.md" MISSING "run: scripts/bootstrap --user-config"; missing=1; fi
  telemetry_rows || missing=1
  note "Alpaca paper key pairs (ADR 0029, ADR 0069), optional:"
  paper_row "paper key pair" "$PAPER_SERVICE" "mise run paper:store"
  paper_row "paper key pair (windows)" "$PAPER_SERVICE_WINDOWS" "mise run paper:store windows"
  note "Review-only workers (ADR 0045) and their defaults (ADR 0059), optional:"
  codex_version_row
  codex_defaults_row
  codex_permissions_row
  agy_model_row
  dsh_row
  agy_row
  note "OmniRoute gateway (ADR 0056), optional:"
  omniroute_version_row || missing=1
  omniroute_row || missing=1
  runtimes_rows
  return "$missing"
}

# fetch_then_run <url> <interpreter> [script-args...]
# Downloads the installer fully before executing it, so a cut-off download never runs.
# Equivalent to the documented `curl <url> | <interpreter> -s [script-args...]`.
fetch_then_run() {
  local url="$1" interp="$2" tmp; shift 2
  tmp=$(mktemp)
  curl -fsSL --max-time 120 "$url" -o "$tmp" || { rm -f "$tmp"; die "download failed: $url"; }
  [ -s "$tmp" ] || { rm -f "$tmp"; die "download was empty: $url"; }
  "$interp" "$tmp" "$@" < /dev/null || { rm -f "$tmp"; die "installer failed: $url"; }
  rm -f "$tmp"
}

install_toolchain() {
  have_clt || die "Command Line Tools are missing. Run 'xcode-select --install', click Install in the dialog, then re-run."
  mkdir -p "$LOCAL_BIN"
  if [ -z "$MISE" ] || [ ! -x "$MISE" ]; then
    note "Installing mise $MISE_VERSION into $LOCAL_BIN ..."
    export MISE_VERSION
    fetch_then_run https://mise.run sh
    MISE="$LOCAL_BIN/mise"
    [ -x "$MISE" ] || die "mise installer finished but $MISE is not there"
  fi
  unquotable "$MISE" && die "mise path $MISE holds a quote, \$, backquote, backslash or newline; not supported"
  note "Installing tools from mise.toml with $MISE ..."
  ( cd "$ROOT" && "$MISE" trust "$ROOT/mise.toml" && "$MISE" install ) || die "mise install failed"
  local pin v t; pin=$(claude_pin)
  [ -n "$pin" ] || die "no readable claude-code pin (tag:v<dotted version>) in canon/upstreams.json"
  if ! have_claude; then
    note "Installing Claude Code CLI $pin (canon/upstreams.json: claude-code) ..."
    fetch_then_run https://claude.ai/install.sh bash "$pin"
    [ -x "$LOCAL_BIN/claude" ] || die "Claude Code installer finished but $LOCAL_BIN/claude is not there"
  else
    v=$(claude_version); t=${v%% *}; t=${t#v}
    if dotted "$t" && ! ver_ge "$t" "$pin"; then
      note "Claude Code CLI $t is below the pin $pin; installing $pin (canon/upstreams.json: claude-code) ..."
      fetch_then_run https://claude.ai/install.sh bash "$pin"
    fi
  fi
  v=$(claude_version); t=${v%% *}; t=${t#v}
  dotted "$t" || die "cannot read a version from the Claude Code CLI ('${v:-nothing}'); pinned $pin. Run: claude install $pin"
  ver_ge "$t" "$pin" || die "Claude Code CLI is $t, still below the pin $pin (canon/upstreams.json). Run: claude install $pin"
  note "Claude Code CLI $t (pinned $pin)."
  local rc="$HOME/.zshrc"
  if ! grep -q 'canon bootstrap' "$rc" 2>/dev/null; then
    {
      echo ''
      echo '# canon bootstrap (docs/adr/0008-toolchain.md)'
      # shellcheck disable=SC2016  # written to ~/.zshrc literally; it expands there, not here
      echo 'export PATH="$HOME/.local/bin:$PATH"'
      # shellcheck disable=SC2016  # as above; the mise path is the one found or installed here
      printf 'eval "$("%s" activate zsh)"\n' "$MISE"
    } >> "$rc"
    note "Added ~/.local/bin and mise activation ($MISE) to $rc (open a new terminal to pick it up)."
  else
    note "$rc already has the canon bootstrap lines; left unchanged."
  fi
}

# install_reviewer_settings: the dsh-tui patch rows (ADR 0045), and canon's earlier agy line taken out of
# ~/.zshrc (ADR 0065). Every other row and line is kept; a patch it cannot extend safely gets a
# .canon-proposed copy instead.
install_reviewer_settings() {
  local dir dst body tmp="" bak rc="$HOME/.zshrc" state
  dir=$(dsh_profile_dir); dst="$dir/cordis.patch.yml"
  if [ ! -d "$dir" ]; then
    note "No dsh-tui profile at $dir; review patch skipped."
  else
    state=$(dsh_state "$dst")
    if [ "$state" = current ]; then
      note "  unchanged  $dst (review rows present)"
    else
      tmp=$(mktemp)
      case "$state" in
        stale)  # replace the older canon block where it stands
          awk -v b="$DSH_MARK_BEGIN" -v e="$DSH_MARK_END" -v src="$DSH_PATCH_SRC" '
            index($0, b) == 1 && !on && !done { on = 1; while ((getline l < src) > 0) print l; next }
            on && $0 == e { on = 0; done = 1; next } !on { print }' "$dst" > "$tmp" ;;
        none)
          body=""; [ -f "$dst" ] && body=$(grep -Ev '^[[:space:]]*(#|$)' "$dst" || true)
          case "$body" in
            ''|'[]') { if [ -f "$dst" ]; then grep -Ev '^[[:space:]]*\[\][[:space:]]*$' "$dst" || true; fi; cat "$DSH_PATCH_SRC"; } > "$tmp" ;;
            '- '*|-) { cat "$dst"; [ -n "$(tail -c 1 "$dst")" ] && echo; cat "$DSH_PATCH_SRC"; } > "$tmp" ;;
            *) rm -f "$tmp"; tmp="" ;;
          esac ;;
        *) rm -f "$tmp"; tmp="" ;;
      esac
      if [ -z "$tmp" ]; then
        cp "$DSH_PATCH_SRC" "$dir/review.patch.yml.canon-proposed"
        note "  EXISTS     $dst already sets one of these rows or is not a block list; wrote review.patch.yml.canon-proposed beside it. Merge by hand."
      else
        if [ -f "$dst" ]; then
          bak="$dst.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
          cp -p "$dst" "$bak" || { rm -f "$tmp"; die "could not keep the previous $dst"; }
          note "  kept       the previous cordis.patch.yml as $bak"
        fi
        cat "$tmp" > "$dst"; rm -f "$tmp"
        note "  added      session log upload off and dsh-memento off to $dst; restart dsh-tui to apply"
      fi
    fi
  fi
  if agy_canon_pair "$rc"; then
    tmp=$(mktemp) || die "could not create a temp file"
    agy_without_canon "$rc" > "$tmp" || { rm -f "$tmp"; die "could not read $rc"; }
    keep_copy "$rc"
    cat "$tmp" > "$rc" || { rm -f "$tmp"; die "could not write $rc; its previous content is in the copy kept above"; }
    rm -f "$tmp"
    note "  removed    canon's AGY_CLI_DISABLE_AUTO_UPDATE=true and its comment from $rc, so agy updates itself again (ADR 0065); open a new terminal to pick it up"
  elif grep -q 'AGY_CLI_DISABLE_AUTO_UPDATE' "$rc" 2>/dev/null; then
    note "  KEPT       $rc names AGY_CLI_DISABLE_AUTO_UPDATE in a line that is not canon's; left as the owner set it (ADR 0065 has the updater on)"
  else
    note "  unchanged  $rc does not turn Antigravity's self-updater off"
  fi
}

# render_settings: home/.claude/settings.json with its ~/.claude and "$HOME"/.claude paths pointed at
# CLAUDE_HOME when that is not the default
render_settings() {
  if [ "$CLAUDE_HOME" = "$HOME/.claude" ]; then cat "$ROOT/home/.claude/settings.json"; return; fi
  # shellcheck disable=SC2016  # "$HOME" is literal text in the settings file, matched as such
  jq --arg d "\"$CLAUDE_HOME\"" '
    def place: split("\"$HOME\"/.claude") | join($d) | if startswith("~/.claude/") then $d + .[9:] else . end;
    (.statusLine.command |= place) | (.hooks[][].hooks[].command |= place)' "$ROOT/home/.claude/settings.json"
}

# keep_copy <file>: copies the file beside itself as <file>.replaced-<UTC time> and says so; a second copy in
# the same second (two steps of one run writing the same file) gets -2, -3 and so on, never the first's name
keep_copy() {
  local base bak n=1
  base="$1.replaced-$(date -u +%Y%m%dT%H%M%SZ)"; bak="$base"
  while [ -e "$bak" ]; do n=$((n + 1)); bak="$base-$n"; done
  cp -p "$1" "$bak" || die "could not keep the previous $1"
  note "  kept       the previous $(basename "$1") as $bak"
}

# install_telemetry <rendered settings.json>: the OTLP settings of ADR 0007 tier 3, for Claude Code and
# Codex, and the model keys of ADR 0059. An existing settings.json gets the telemetry variables and the model
# keys (CANON_KEYS) it lacks, and loses a RETIRED value it still holds; when that leaves it the same JSON as
# the rendered canon settings, it takes the rendered file's bytes, so the copy step after finds it unchanged.
# A value the owner set otherwise, and an otel setting of Codex's that is not canon's, are left alone and
# named, as the owner's choice. The template's statusLine.refreshInterval is added the same way, only to a status
# line that runs canon's command, spelled as the template spells it, and sets no interval (ADR 0007); an interval
# already there is the owner's and is neither changed nor named as a gap. Codex's config is written only when its folder
# exists (Codex installed).
# Returns 1 only when settings.json cannot be read as settings.
install_telemetry() {
  local s="$CLAUDE_HOME/settings.json" plan differ tmp c="$CODEX_DIR/config.toml" rc=0
  if [ ! -e "$s" ]; then :   # the copy step installs the rendered file, env block included
  elif ! jq -e 'type == "object" and ((.env // {}) | type == "object")' "$s" >/dev/null 2>&1; then
    note "  EXISTS     $s is not a JSON object with an object env; telemetry and model settings not added"; rc=1
  else
    # one plan: the merged document, and what was added, removed and kept, so the file is written once
    # shellcheck disable=SC2016  # jq program, not shell
    plan=$(jq -c --slurpfile w "$1" --arg re "$TELEMETRY_RE" --argjson mk "$CANON_KEYS" --argjson ret "$RETIRED" '
      def telemetry: with_entries(select(.key | test($re)));
      . as $in | $w[0] as $t
      | ($t.env // {} | telemetry | with_entries(select(($in.env // {})[.key] == null))) as $env
      | [$ret[] | select(. as $r | $in | getpath($r.path) == $r.value)] as $gone
      | (reduce $gone[] as $r ($in; delpaths([$r.path]))) as $kept
      | [$mk[] | select($kept[.] == null and $t[.] != null)] as $top
      | ($t.statusLine.refreshInterval? // null) as $ri
      | (if $ri != null and ($kept.statusLine | type) == "object" and $kept.statusLine.command == $t.statusLine.command
            and ($kept.statusLine | has("refreshInterval") | not) then ["statusLine.refreshInterval"] else [] end) as $sl
      | (($kept | if ($env | length) > 0 then .env = ((.env // {}) + $env) else . end)
         | reduce $top[] as $k (.; .[$k] = $t[$k])
         | if ($sl | length) > 0 then .statusLine.refreshInterval = $ri else . end) as $doc
      | {doc: $doc, env: ($env | keys), top: $top, sl: $sl, gone: [$gone[] | .path | join(".")],
         kept: [($t.env // {} | telemetry | to_entries[] | select(($in.env // {})[.key] != null and $in.env[.key] != .value) | .key)],
         kept_top: [$mk[] | select($kept[.] != null and $t[.] != null and $kept[.] != $t[.])]}' "$s") \
      || die "could not read $s"
    differ=$(jq -r '.kept | join(" ")' <<<"$plan")
    if [ "$(jq '(.env + .top + .sl + .gone) | length' <<<"$plan")" != 0 ]; then
      tmp=$(mktemp)
      jq '.doc' <<<"$plan" > "$tmp" || { rm -f "$tmp"; die "could not merge the settings into $s"; }
      [ "$(jq -S . "$tmp")" != "$(jq -S . "$1")" ] || cat "$1" > "$tmp"
      keep_copy "$s"
      cat "$tmp" > "$s" || { rm -f "$tmp"; die "could not write $s; its previous content is in the copy kept above"; }
      rm -f "$tmp"
      [ "$(jq '.env | length' <<<"$plan")" = 0 ] || note "  added      $(jq -r '.env | join(", ")' <<<"$plan") to the env of $s"
      [ "$(jq '.top | length' <<<"$plan")" = 0 ] || note "  added      $(jq -r '.top | join(", ")' <<<"$plan") to $s (ADR 0059, ADR 0065)"
      [ "$(jq '.sl | length' <<<"$plan")" = 0 ] || note "  added      statusLine.refreshInterval to $s (ADR 0007)"
      [ "$(jq '.gone | length' <<<"$plan")" = 0 ] || note "  retired    $(jq -r '.gone | join(", ")' <<<"$plan") in $s, values an earlier canon template set (ADR 0059, ADR 0065); a key retired here is then added from the template"
    else
      note "  unchanged  telemetry and model settings in $s"
    fi
    [ -z "$differ" ] || note "  KEPT       $s sets $differ to another value than canon's; left as the owner set it"
    differ=$(jq -r '.kept_top | join(", ")' <<<"$plan")
    [ -z "$differ" ] || note "  KEPT       $s sets $differ to another value than home/.claude/settings.json; left as the owner set it (scripts/bootstrap --check names each)"
  fi
  if [ ! -d "$CODEX_DIR" ]; then
    note "  skipped    Codex telemetry: no $CODEX_DIR (Codex not installed); run --user-config again after installing it"
    return "$rc"
  fi
  case "$(codex_otel_state "$c")" in
    canon) note "  unchanged  [otel] in $c" ;;
    other) note "  KEPT       $c sets otel itself; left as the owner set it. Canon's table: $ROOT/home/.codex/otel.toml" ;;
    invalid) note "  INVALID    $c is not valid TOML; left as it is, and no [otel] added"; rc=1 ;;
    unknown) note "  UNKNOWN    no python3 with tomllib to read $c; left as it is (run: scripts/bootstrap --install)"; rc=1 ;;
    *)
      # the table is appended to a copy, which must then read as TOML with canon's table before it replaces c
      tmp=$(mktemp) || die "could not create a temp file"
      if [ -s "$c" ]; then
        cat "$c" > "$tmp" || { rm -f "$tmp"; die "could not read $c"; }
        [ -z "$(tail -c 1 "$tmp")" ] || printf '\n' >> "$tmp"
        printf '\n' >> "$tmp"
      fi
      { echo "# canon: OTLP log export to the local collector (home/.codex/otel.toml, docs/adr/0007-observability.md)"
        grep -v -e '^#' -e '^$' "$ROOT/home/.codex/otel.toml"; } >> "$tmp" || { rm -f "$tmp"; die "could not write a temp file"; }
      [ "$(codex_otel_state "$tmp")" = canon ] || { rm -f "$tmp"; die "appending canon's [otel] table to $c would not leave canon's table in valid TOML; nothing written"; }
      [ ! -s "$c" ] || keep_copy "$c"
      cat "$tmp" > "$c" || { rm -f "$tmp"; die "could not write $c; its previous content is in the copy kept above"; }
      rm -f "$tmp"
      note "  added      [otel] to $c"
      ;;
  esac
  return "$rc"
}

# install_runtime_defaults: the default model and effort of the other runtimes that keep them in a file
# (ADR 0059). Codex: home/.codex/defaults.toml's keys that config.toml lacks, written at its top (only when
# the result reads as the old file plus those keys). Antigravity: settings.json's model, set to the label
# canon/models.json gives when unset. Each only when the runtime's folder exists; a value the owner set
# otherwise is left alone and named. Returns 1 when a file cannot be read as its format.
install_runtime_defaults() {
  local c="$CODEX_DIR/config.toml" j tmp rc=0 want st
  if [ ! -d "$CODEX_DIR" ]; then
    note "  skipped    Codex defaults: no $CODEX_DIR (Codex not installed)"
  else
    tmp=$(mktemp) || die "could not create a temp file"
    local xc=0; j=$(codex_defaults "$c" "$tmp") || xc=$?
    case "$xc" in
      0) ;;
      3) j='{"state": "unsafe"}' ;;
      *) j='{"state": "failed"}' ;;
    esac
    case "$(jq -r '.state' <<<"$j")" in
      unsafe)  note "  FAILED     writing home/.codex/defaults.toml's keys at the top of $c would not leave the old file plus those keys; nothing written"; rc=1 ;;
      failed)  note "  FAILED     the TOML step for $c stopped with an error (exit $xc); nothing written"; rc=1 ;;
      unreadable) note "  UNKNOWN    $c cannot be read; left as it is"; rc=1 ;;
      invalid) note "  INVALID    $c is not valid TOML; left as it is, and no defaults added"; rc=1 ;;
      unknown) note "  UNKNOWN    no python3 with tomllib to read $c; left as it is (run: scripts/bootstrap --install)"; rc=1 ;;
      *)
        if [ "$(jq '.missing - .unwritten | length' <<<"$j")" != 0 ]; then
          [ ! -s "$c" ] || keep_copy "$c"
          cat "$tmp" > "$c" || { rm -f "$tmp"; die "could not write $c; its previous content is in the copy kept above"; }
          note "  added      $(jq -r '.missing - .unwritten | join(", ")' <<<"$j") to $c (home/.codex/defaults.toml, ADR 0059, ADR 0034)"
        elif [ "$(jq '.unwritten | length' <<<"$j")" != 0 ]; then :
        else
          note "  unchanged  Codex defaults in $c"
        fi
        [ "$(jq '.unwritten | length' <<<"$j")" = 0 ] || { note "  FAILED     $(jq -r '.unwritten | join(", ")' <<<"$j") cannot be written at the top of $c beside the table it already declares; add it to that table by hand (home/.codex/defaults.toml)"; rc=1; }
        [ "$(jq '.other | length' <<<"$j")" = 0 ] || note "  KEPT       $c sets $(jq -r '.other | join(", ")' <<<"$j") to another value than home/.codex/defaults.toml; left as the owner set it"
        [ "$(jq '.profile_sets | length' <<<"$j")" = 0 ] || note "  KEPT       the active profile in $c sets $(jq -r '.profile_sets | join(", ")' <<<"$j") otherwise, which overrides the top level; left as the owner set it"
        ;;
    esac
    rm -f "$tmp"
  fi
  want=$(agy_label)
  if [ ! -d "$(dirname "$AGY_SETTINGS")" ]; then st=absent
  elif [ -z "$want" ]; then st=nolabel
  else st=$(agy_model_state "$want"); fi
  case "$st" in
    nolabel) note "  UNKNOWN    canon/models.json gives no label for antigravity; $AGY_SETTINGS left as it is"; rc=1 ;;
    absent)  note "  skipped    Antigravity default model: no $(dirname "$AGY_SETTINGS") (Antigravity not installed)" ;;
    ok)      note "  unchanged  model in $AGY_SETTINGS" ;;
    other)   note "  KEPT       $AGY_SETTINGS sets model to $(jq -r '.model' "$AGY_SETTINGS"); left as the owner set it. Canon's: $want" ;;
    invalid) note "  INVALID    $AGY_SETTINGS is not a JSON object; left as it is"; rc=1 ;;
    missing)
      tmp=$(mktemp) || die "could not create a temp file"
      if [ -f "$AGY_SETTINGS" ]; then
        jq --arg w "$want" '.model = $w' "$AGY_SETTINGS" > "$tmp" || { rm -f "$tmp"; die "could not read $AGY_SETTINGS"; }
        keep_copy "$AGY_SETTINGS"
        cat "$tmp" > "$AGY_SETTINGS" || { rm -f "$tmp"; die "could not write $AGY_SETTINGS; its previous content is in the copy kept above"; }
      else
        jq -n --arg w "$want" '{model: $w}' > "$tmp" || { rm -f "$tmp"; die "could not write a temp file"; }
        # the CLI makes the file "readable only by" its owner (https://antigravity.google/docs/settings)
        install -m 600 "$tmp" "$AGY_SETTINGS" || { rm -f "$tmp"; die "could not write $AGY_SETTINGS"; }
      fi
      rm -f "$tmp"
      note "  added      model \"$want\" to $AGY_SETTINGS (ADR 0059)" ;;
  esac
  return "$rc"
}

# settings_gaps <rendered settings.json> <live settings.json>: what the live file lacks of the template, one
# per line; nothing when it holds every key the template sets with the same value (objects compared key by
# key, so the owner's own keys and env variables are no gap) and every hook entry the template proposes,
# present by event, matcher and command (another tool's entries beside them are no gap). When an event fires,
# "its matching hooks run in parallel" (https://code.claude.com/docs/en/hooks.md, read 2026-11-11), so an
# extra entry does not displace canon's. A proposed hook entry counts as present only with every field the
# template gives it (command, type, async, timeout). Known limit: a hook entry a later template drops is left
# in the live file and not named; retiring one is a RETIRED-style step of its own. Exits non-zero when the
# live file is not a JSON object.
settings_gaps() {
  # shellcheck disable=SC2016  # jq program, not shell
  jq -r --slurpfile w "$1" '
    def gaps($t; $l; $p):
      if ($t | type) == "object" and ($l | type) == "object"
      then $t | to_entries[] | .key as $k | gaps(.value; $l[$k]; $p + [$k])
      elif $t == $l then empty else $p | join(".") end;
    def contains_all($x): all(to_entries[]; .key as $k | $x[$k] == .value);   # every field the template gives
    if type != "object" then error("not a JSON object") else . end
    | . as $l | $w[0] as $t
    | gaps($t | del(.hooks) | if ($l.statusLine.refreshInterval? | type) == "number" then del(.statusLine.refreshInterval) else . end;
           $l | del(.hooks); []),
      ($t.hooks // {} | to_entries[] | .key as $ev | .value[] | (.matcher // "") as $m | .hooks[]? as $h
       | select(any(($l.hooks[$ev] // [])[]?; (.matcher // "") == $m and any(.hooks[]?; . as $x | $h | contains_all($x))) | not)
       | "hook \($ev)\(if $m != "" then " (matcher \($m))" else "" end) \($h.command)")' "$2"
}

# canon_wrote <repository path> <file>: whether the file is byte for byte a version of that path committed on
# this checkout's history, so a file the owner edited is never replaced
canon_wrote() {
  local live c
  live=$(git -C "$ROOT" hash-object "$2" 2>/dev/null) || return 1
  while IFS= read -r c; do
    [ "$(git -C "$ROOT" rev-parse "${c}:$1" 2>/dev/null)" = "$live" ] && return 0
  done < <(git -C "$ROOT" rev-list HEAD -- "$1" 2>/dev/null)
  return 1
}

install_user_config() {
  local src="$ROOT/home/.claude" pending=0 f dst bak tmp gaps
  case "$CLAUDE_HOME" in /*) ;; *) die "CLAUDE_CONFIG_DIR must be an absolute path (got: $CLAUDE_HOME)" ;; esac
  unquotable "$CLAUDE_HOME" && die "CLAUDE_CONFIG_DIR holds a quote, \$, backquote, backslash or newline, which the hook commands cannot quote: $CLAUDE_HOME"
  command -v jq >/dev/null 2>&1 || die "jq not found"
  mkdir -p "$CLAUDE_HOME/canon"
  for f in ledger.sh statusline.sh fleet-rate.sh; do
    dst="$CLAUDE_HOME/canon/$f"
    if [ -e "$dst" ] && cmp -s "$src/canon/$f" "$dst"; then note "  unchanged  $dst"; continue; fi
    if [ -e "$dst" ]; then
      bak="$dst.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
      cp -p "$dst" "$bak" || die "could not keep the previous $dst"
      note "  kept       the previous $f as $bak"
    fi
    install -m 755 "$src/canon/$f" "$dst"
    note "  installed  $dst"
  done
  tmp=$(mktemp)
  render_settings > "$tmp" || { rm -f "$tmp"; die "could not render settings.json for $CLAUDE_HOME"; }
  install_telemetry "$tmp" || pending=1
  # claude-hud.json: Claude HUD's settings, read beside settings.json (ADR 0023)
  for f in settings.json CLAUDE.md claude-hud.json; do
    local from="$src/$f"; [ "$f" = settings.json ] && from="$tmp"
    if [ ! -e "$CLAUDE_HOME/$f" ]; then
      cp "$from" "$CLAUDE_HOME/$f"; note "  installed  $CLAUDE_HOME/$f"
    elif cmp -s "$from" "$CLAUDE_HOME/$f"; then
      note "  unchanged  $CLAUDE_HOME/$f"
    elif [ "$f" = settings.json ] && gaps=$(settings_gaps "$from" "$CLAUDE_HOME/$f" 2>/dev/null) && [ -z "$gaps" ]; then
      note "  unchanged  $CLAUDE_HOME/$f"   # a superset of the template: nothing to merge
      if [ -e "$CLAUDE_HOME/$f.canon-proposed" ]; then
        rm -f "${CLAUDE_HOME:?}/$f.canon-proposed"; note "  removed    $f.canon-proposed, an earlier run's copy, since nothing is left to merge"
      fi
    elif [ "$f" = claude-hud.json ] && canon_wrote "home/.claude/$f" "$CLAUDE_HOME/$f"; then
      keep_copy "$CLAUDE_HOME/$f"
      cp "$from" "$CLAUDE_HOME/$f"; note "  updated    $CLAUDE_HOME/$f, a version canon wrote and nobody edited (ADR 0007)"
    elif [ "$f" = settings.json ]; then
      cp "$from" "$CLAUDE_HOME/$f.canon-proposed"; pending=1
      [ -n "$gaps" ] || gaps="not a readable JSON object"
      note "  EXISTS     $CLAUDE_HOME/$f differs from the template: $(printf '%s\n' "$gaps" | paste -sd ';' - | sed 's/;/; /g'); wrote $f.canon-proposed beside it. Merge by hand."
    else
      cp "$from" "$CLAUDE_HOME/$f.canon-proposed"; pending=1
      note "  EXISTS     $CLAUDE_HOME/$f differs; wrote $f.canon-proposed beside it. Merge by hand."
    fi
  done
  rm -f "$tmp"
  local failed=0; install_runtime_defaults || failed=1
  [ "$pending" -eq 0 ] && [ "$failed" -eq 0 ] || note "Some files were not applied (see EXISTS, FAILED, INVALID or UNKNOWN above)."
  note "New Claude Code sessions will pick this up. Verify with: scripts/bootstrap --check, then scripts/lanes"
  # a step that could not run (FAILED, INVALID, UNKNOWN for another runtime's file) fails the run; a
  # differing file left for the owner to merge (EXISTS) does not
  [ "$failed" -eq 0 ] || { note "bootstrap: another runtime's defaults could not be written (see above)" >&2; return 1; }
}

case "${1:-}" in
  --check)        if check; then note "All present."; else note "Some pieces are missing or outdated (see above)."; exit 1; fi ;;
  --install)      install_toolchain
                  install_reviewer_settings
                  [ "${2:-}" = "--with-user-config" ] && install_user_config
                  check || true ;;
  --user-config)  install_user_config ;;
  *) note "usage: scripts/bootstrap --check | --install [--with-user-config] | --user-config"; exit 2 ;;
esac
