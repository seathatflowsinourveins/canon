#!/bin/bash
# test-land — run scripts/land, scripts/check-addresses and .githooks/pre-push in throwaway repositories
# and check what each one decides. Offline: `origin` is a local bare repository, scripts/ci is a stub, and a
# fake `mise` first on PATH answers `mise exec -- gh ...` from canned files and logs every call.
# Exit 0 if every case behaves as expected, 1 otherwise. Touches only a temp folder.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# A git hook that runs this exports variables naming its own repository; the cases need their own.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX \
      GIT_COMMON_DIR GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL \
      GIT_COMMITTER_DATE LAND_PR CHECK_ADDRESSES_STRICT
for f in scripts/land scripts/check-addresses .githooks/pre-push; do
  [ -x "$ROOT/$f" ] || { echo "test-land: $ROOT/$f is missing or not executable"; exit 1; }
done
# An explicit template, as in test-lanes: a TMPDIR that does not exist stops here.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-land.XXXXXX") \
  || { echo "test-land: could not create a temp folder under ${TMPDIR:-/tmp}; nothing was written" >&2; exit 1; }
trap 'rm -rf "$TMP"' EXIT

export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL="$TMP/gitconfig"
# No automatic maintenance: git commit, fetch and merge otherwise start `git maintenance run --auto
# --detach` (seen with GIT_TRACE), a background git that can outlive the command in a case's repository
# (git-config(1): maintenance.auto; gc.auto = 0 turns off gc --auto). That it caused a hosted failure is
# UNVERIFIED; this takes it out of the cases, so a failure that remains is not that.
printf '[user]\n\tname = Test\n\temail = 1+test@users.noreply.github.com\n[commit]\n\tgpgsign = false\n[advice]\n\tdetachedHead = false\n[maintenance]\n\tauto = false\n[gc]\n\tauto = 0\n' > "$GIT_CONFIG_GLOBAL"
export LAND_POLL_SECONDS=0 LAND_WAIT_SECONDS=3
mkdir -p "$TMP/bin"
PATH="$TMP/bin:$PATH"; export PATH

# The fake mise. Files in $FAKE: auth_rc, merge_rc, auto_rc (exit codes, default 0); pr_open (the line
# `gh pr list --jq` would print); pr_info and pr_head (for --pr); pr_title and pr_body (what
# `gh pr view --json title|body --jq` prints; that call fails when the file is missing); views (one
# `gh pr view` answer per line, "<state> <sha>", the last repeated; HEAD and OTHER stand for the current
# commit and another one); checks
# (the failed required checks `gh pr checks --jq` would print).
cat > "$TMP/bin/mise" <<'FAKE'
#!/bin/bash
[ "${1:-} ${2:-} ${3:-}" = "exec -- gh" ] || { echo "fake mise: unexpected call: $*" >&2; exit 99; }
shift 3
printf 'gh %s\n' "$*" >> "$FAKE/log"
rc() { if [ -f "$FAKE/$1" ]; then cat "$FAKE/$1"; else echo 0; fi; }
case "${1:-} ${2:-}" in
  "auth status") exit "$(rc auth_rc)" ;;
  "pr list")     [ ! -f "$FAKE/pr_open" ] || cat "$FAKE/pr_open" ;;
  "pr create")   echo "7 https://github.example/o/r/pull/7" > "$FAKE/pr_open" ;;
  "pr checks")   [ ! -f "$FAKE/checks" ] || cat "$FAKE/checks" ;;
  "pr merge")    prev=""; for a in "$@"; do [ "$prev" != "--body-file" ] || cp "$a" "$FAKE/merge_body"; prev=$a; done
                 case "$*" in
                   *--auto*) r=$(rc auto_rc);  [ "$r" -eq 0 ] || echo "auto-merge refused by the fake" >&2 ;;
                   *)        r=$(rc merge_rc); [ "$r" -eq 0 ] || echo "direct merge refused by the fake" >&2 ;;
                 esac
                 exit "$r" ;;
  "pr checkout") b=$(cat "$FAKE/pr_head")
                 git fetch -q origin "+refs/heads/$b:refs/heads/$b" && git worktree add -q "$5" "$b" ;;
  "pr view")
    case "$*" in *headRefName*) cat "$FAKE/pr_info"; exit 0 ;; esac
    for f in title body; do
      case "$*" in *"--json $f "*)
        [ -f "$FAKE/pr_$f" ] || { echo "fake: no pull request $f" >&2; exit 1; }
        cat "$FAKE/pr_$f"; exit 0 ;;
      esac
    done
    line=$(sed -n 1p "$FAKE/views")
    if [ "$(wc -l < "$FAKE/views")" -gt 1 ]; then tail -n +2 "$FAKE/views" > "$FAKE/views.next" && mv "$FAKE/views.next" "$FAKE/views"; fi
    line=${line/HEAD/$(git rev-parse HEAD)}
    printf '%s\n' "${line/OTHER/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" ;;
  "api rate_limit") # rate: the spent budgets, "<core|graphql> <limit> <reset>" a line, empty for none;
                    # rate_late: the same, answered only once a status was posted
                    if [ -f "$FAKE/rate_late" ] && grep -q statuses "$FAKE/log"; then cat "$FAKE/rate_late"; exit 0; fi
                    [ -f "$FAKE/rate" ] || { echo "gh: HTTP 500" >&2; exit 1; }; cat "$FAKE/rate" ;;
  "api -X")      # api_refuse: a status context (review or signoff) GitHub refuses, as a spent REST budget did
                 if [ -f "$FAKE/api_refuse" ] && case "$*" in *"context=$(cat "$FAKE/api_refuse")"*) true ;; *) false ;; esac; then
                   echo "gh: API rate limit exceeded for user ID 1. (HTTP 403)" >&2; exit 1
                 fi ;;
  *) echo "fake mise: unexpected gh call: $*" >&2; exit 98 ;;
esac
FAKE
chmod +x "$TMP/bin/mise"

# One template, copied for every case: work (on main, with the scripts under test and a scripts/ci stub
# that records that it ran) and its bare origin.
T="$TMP/template"
mkdir -p "$T/work/scripts" "$T/work/docs/adr" "$T/work/src"
{ git init -q -b main "$T/work" && git init -q --bare "$T/origin.git"; } || { echo "test-land: git init failed"; exit 1; }
cp "$ROOT/scripts/land" "$ROOT/scripts/check-addresses" "$T/work/scripts/"
[ ! -f "$ROOT/scripts/fix-index" ] || cp "$ROOT/scripts/fix-index" "$T/work/scripts/"
# shellcheck disable=SC2016  # expanded by the stub, not here
printf '%s\n' '#!/bin/bash' 'echo ran >> "$FAKE/ci"' > "$T/work/scripts/ci"; chmod +x "$T/work/scripts/ci"
echo "readme" > "$T/work/README.md"; echo "# 0001 First" > "$T/work/docs/adr/0001-first.md"
echo "lock" > "$T/work/uv.lock"; echo "x = 1" > "$T/work/src/a.py"
# A gate module on the trading path, and a test file for Fails-before to name.
mkdir -p "$T/work/src/canon_trading" "$T/work/tests"
echo "y = 1" > "$T/work/src/canon_trading/ranking.py"
printf 'class TestGate:\n    def test_refuses(self):\n        pass\n\n\ndef test_gate():\n    pass\n' > "$T/work/tests/test_gate.py"
{ git -C "$T/work" add -A && git -C "$T/work" commit -q -m "Start" \
  && git -C "$T/work" push -q "$T/origin.git" main; } || { echo "test-land: template setup failed"; exit 1; }

# new_repo [noremote]: a case folder C with work tree W on a new branch topic, and origin unless asked
new_repo() {
  C=$(mktemp -d "$TMP/case.XXXXXX") || { echo "test-land: could not create a case folder under $TMP" >&2; exit 1; }
  W="$C/work"; FAKE="$C/fake"; export FAKE
  mkdir -p "$FAKE"; : > "$FAKE/log"; echo "MERGED HEAD" > "$FAKE/views"
  cp -R "$T/work" "$T/origin.git" "$C/"
  if [ "${1:-}" != noremote ]; then
    git -C "$W" remote add origin "$C/origin.git"
  fi
  git -C "$W" switch -q -c topic
}
# change <path> [<message>]: append a line to a file and commit it
change() { mkdir -p "$(dirname "$W/$1")"; echo "line" >> "$W/$1"; git -C "$W" add -A && git -C "$W" commit -q -m "${2:-Change $1}"; }
# land [args]: run scripts/land in W; sets rc and out
land() { out=$(cd "$W" && scripts/land "$@" 2>&1); rc=$?; }
has()     { case "$out" in *"$1"*) return 0 ;; *) return 1 ;; esac; }
logged()  { grep -cF -- "$1" "$FAKE/log" >/dev/null; }
ci_ran()  { [ -f "$FAKE/ci" ]; }
pushed()  { git -C "$C/origin.git" rev-parse --verify -q "refs/heads/$1" >/dev/null; }

# case_ <label> <function> [args]: the function returns 0 when the case behaves as expected. Cases run in
# the background, eight at a time, each in its own folder; results are printed in order at the end.
# A failing case's FAIL line itself says why: the check that failed (a case sets `why`), the exit code
# of what it ran (land, check-addresses or git push),
# its last line of output and the last gh call, since scripts/ci shows a long check's FAIL lines but not
# the indented lines under them.
RESULTS="$TMP/results"; mkdir -p "$RESULTS"; ncase=0; out=""; rc=""; why=""
oneline() { tr '\n\t' '  ' | sed 's/ *$//' | cut -c1-"$1"; }
case_() {
  local label="$1" id; shift
  ncase=$((ncase + 1)); id=$(printf '%03d' "$ncase")
  (
    # stderr is kept: a case that exits before writing its result (new_repo's stop) shows why below
    if "$@" >/dev/null 2>"$RESULTS/$id.err"; then printf '  ok    %s\n' "$label" > "$RESULTS/$id"
    else
      last=$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | tail -n 1 | oneline 200)
      call=$( { [ -n "${FAKE:-}" ] && tail -n 1 "$FAKE/log" 2>/dev/null; } | oneline 120)
      err=$(sed '/^[[:space:]]*$/d' "$RESULTS/$id.err" 2>/dev/null | tail -n 1 | oneline 120)
      { printf '  FAIL  %s [%s; exit %s; last line: %s; last gh call: %s%s]\n' "$label" "${why:-a check failed}" \
          "${rc:-none}" "${last:-none}" "${call:-none}" "${err:+; stderr: $err}"
        printf '%s\n' "$out" | sed -n '1,6s/^/        /p'; } > "$RESULTS/$id"
    fi
  ) &
  [ $((ncase % 8)) -ne 0 ] || wait
}

# --- gh and the local path ---
t_signed_out() {
  new_repo; change README.md; echo 1 > "$FAKE/auth_rc"
  local before; before=$(git -C "$W" rev-parse main)
  land; [ "$rc" -ne 0 ] && has "gh auth login" && [ "$(git -C "$W" rev-parse main)" = "$before" ] && ! ci_ran
}
t_inner_no_origin() {
  new_repo noremote; change README.md
  local before; before=$(git -C "$W" rev-parse main)
  out=$(cd "$W" && LAND_PR=5 scripts/land 2>&1); rc=$?
  [ "$rc" -ne 0 ] && [ "$(git -C "$W" rev-parse main)" = "$before" ] && ! ci_ran
}
t_local_note() {
  new_repo noremote; change src/a.py
  land --reviewed "code-review ran, nothing found"
  [ "$rc" -eq 0 ] && has 'review note: "code-review ran, nothing found"' && has "not recorded anywhere" \
    && [ "$(git -C "$W" rev-parse main)" = "$(git -C "$W" rev-parse topic)" ]
}
t_status_refused() {       # t_status_refused <context>: GitHub refuses that status; the land fails by name
  new_repo; change README.md; echo "$1" > "$FAKE/api_refuse"
  land
  [ "$rc" -ne 0 ] || { why="land exited 0 though the $1 status was refused"; return 1; }
  has "the $1 status" || { why="the failure does not name the $1 status"; return 1; }
  has "rate limit" || { why="the failure does not say what GitHub answered"; return 1; }
  ! logged "pr merge" || { why="a merge was asked for without the statuses"; return 1; }
}
t_budget_spent() {         # t_budget_spent signed-in|signed-out [core|graphql]: a spent budget is named, with its reset
  new_repo; change README.md
  [ "$1" = signed-in ] || echo 1 > "$FAKE/auth_rc"
  local kind=${2:-core} label=REST; [ "$kind" = graphql ] && label=GraphQL
  echo "$kind 5000 1763002800" > "$FAKE/rate"
  local reset; reset=$(date -r 1763002800 '+%Y-%m-%d %H:%M' 2>/dev/null || date -d @1763002800 '+%Y-%m-%d %H:%M')
  land
  [ "$rc" -ne 0 ] || { why="land exited 0 on a spent budget"; return 1; }
  has "$label budget is spent" || { why="the spent $label budget is not named"; return 1; }
  if ! has "0 of 5000" || ! has "$reset"; then why="the count or the reset time ($reset) is not given"; return 1; fi
  ! has "not signed in" || { why="a spent budget was called signed out"; return 1; }
  if ci_ran || pushed topic; then why="checks ran or the branch was pushed on a spent budget"; return 1; fi
}
t_budget_left() {          # a budget with calls left lands as before
  new_repo; change README.md; : > "$FAKE/rate"
  land; [ "$rc" -eq 0 ] && has "landed:"
}
t_status_refused_spent() { # the budget runs out after the checks: the refused status names it and its reset
  new_repo; change README.md; : > "$FAKE/rate"; echo review > "$FAKE/api_refuse"
  echo "core 5000 1763002800" > "$FAKE/rate_late"
  land
  if [ "$rc" -eq 0 ] || ! has "the review status" || ! has "REST budget is spent (0 of 5000)"; then
    why="the refused status does not name the spent budget"; return 1
  fi
}
case_ "origin and gh signed out: refused, main not moved"  t_signed_out
case_ "a spent REST budget is named with its reset, signed in"  t_budget_spent signed-in
case_ "a spent REST budget is named, not called signed out"  t_budget_spent signed-out
case_ "a spent GraphQL budget is named, not called signed out"  t_budget_spent signed-out graphql
case_ "a REST budget with calls left lands"                 t_budget_left
case_ "a refused review status fails the land by name"     t_status_refused review
case_ "a refused signoff status fails the land by name"    t_status_refused signoff
case_ "a status refused on a budget spent after the checks names it"  t_status_refused_spent
case_ "a --pr run with no origin: refused, main not moved"  t_inner_no_origin
case_ "local path prints the review note it cannot record" t_local_note

# --- review gate ---
t_lands_without_note() {   # t_lands_without_note <path>
  new_repo; change "$1"; land
  [ "$rc" -eq 0 ] && logged "context=review -f description=not needed: documentation or lockfile only" && has "landed:"
}
t_needs_note() {           # t_needs_note <path>...
  new_repo; local p; for p in "$@"; do change "$p"; done
  land; [ "$rc" -ne 0 ] && has "needs an independent review" && ! pushed topic && ! ci_ran
}
t_new_adr()    { new_repo; echo "# 0002" > "$W/docs/adr/0002-new.md"; git -C "$W" add -A; git -C "$W" commit -q -m "Add"
                 land; [ "$rc" -ne 0 ] && has "docs/adr/0002-new.md"; }
t_rename_adr() { new_repo; git -C "$W" mv docs/adr/0001-first.md docs/adr/0002-first.md; git -C "$W" commit -q -m "Move"
                 land; [ "$rc" -ne 0 ] && has "needs an independent review"; }
t_unreadable() {
  new_repo noremote; change README.md
  local t; t=$(git -C "$W" rev-parse 'main^{tree}')
  rm -f "$W/.git/objects/${t:0:2}/${t:2}"
  land; [ "$rc" -ne 0 ] && has "review gate cannot be applied" && ! ci_ran
}
case_ "README.md alone lands without a note"               t_lands_without_note README.md
case_ "a package README alone lands without a note"         t_lands_without_note packages/canon-alpaca/README.md
case_ "uv.lock alone lands without a note"                  t_lands_without_note uv.lock
case_ "an edit to an existing ADR lands without a note"     t_lands_without_note docs/adr/0001-first.md
for p in AGENTS.md pyproject.toml tests/conftest.py .claude/skills/x/SKILL.md .claude/rules/x.md \
         canon/upstreams.json mise.toml packages/a/b/README.md src/a.py; do
  case_ "$p needs a note"                                   t_needs_note "$p"
done
case_ "README.md plus code needs a note"                    t_needs_note README.md src/a.py
case_ "a new ADR needs a note"                              t_new_adr
case_ "an ADR made by renaming needs a note"                t_rename_adr
case_ "an unreadable file list stops the run"               t_unreadable
t_dirty() { new_repo; change README.md; echo "more" >> "$W/README.md"; land
            [ "$rc" -ne 0 ] && has "uncommitted changes" && ! ci_ran && ! pushed topic; }
t_behind() {   # a never-pushed branch behind main, with no conflict, is rebased onto it and lands
  new_repo; git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; change README.md "Say what the change does"; land
  [ "$rc" -eq 0 ] && has "rebasing it onto origin/main" && ci_ran && pushed topic \
    && git -C "$C/origin.git" merge-base --is-ancestor main topic \
    && [ "$(git -C "$C/origin.git" rev-list --count main..topic)" -eq 1 ] \
    && [ "$(git -C "$C/origin.git" log -1 --format=%s topic)" = "Say what the change does" ]
}
t_behind_conflict() {   # the rebase conflicts: stopped, named, rolled back, nothing pushed or checked
  new_repo; git -C "$W" switch -q -c side main; echo "main's" > "$W/README.md"; git -C "$W" commit -q -am "Main"
  git -C "$W" push -q origin side:main; git -C "$W" switch -q topic
  echo "topic's" > "$W/README.md"; git -C "$W" commit -q -am "Topic"; local before; before=$(git -C "$W" rev-parse topic)
  land
  [ "$rc" -ne 0 ] && has "rebasing topic onto origin/main conflicts in 'README.md'" && ! ci_ran && ! pushed topic \
    && [ "$(git -C "$W" rev-parse topic)" = "$before" ] && [ "$(git -C "$W" branch --show-current)" = topic ] \
    && [ ! -e "$(git -C "$W" rev-parse --git-path rebase-merge)" ] && [ -z "$(git -C "$W" status --porcelain)" ]
}
t_behind_empty() {   # every commit is already on main: nothing is left to land after the rebase
  new_repo; change README.md "Same"; git -C "$W" switch -q -c side main; echo "line" >> "$W/README.md"
  git -C "$W" commit -q -am "Same on main"; git -C "$W" push -q origin side:main; git -C "$W" switch -q topic
  local before; before=$(git -C "$W" rev-parse topic); land
  [ "$rc" -ne 0 ] && has "has nothing that main lacks once rebased" && ! ci_ran && ! pushed topic \
    && [ "$(git -C "$W" rev-parse topic)" = "$before" ] && [ -z "$(git -C "$W" status --porcelain)" ]
}
t_behind_dry_conflict() {   # a dry run predicts the conflict and changes nothing
  new_repo; git -C "$W" switch -q -c side main; echo "main's" > "$W/README.md"; git -C "$W" commit -q -am "Main"
  git -C "$W" push -q origin side:main; git -C "$W" switch -q topic
  echo "topic's" > "$W/README.md"; git -C "$W" commit -q -am "Topic"; local before; before=$(git -C "$W" rev-parse topic)
  land --dry-run
  [ "$rc" -ne 0 ] && has "would conflict in 'README.md'" && ! ci_ran && ! pushed topic \
    && [ "$(git -C "$W" rev-parse topic)" = "$before" ] && [ -z "$(git -C "$W" status --porcelain)" ]
}
t_behind_rerun() {   # after the rebase, main's own copy of scripts/land is the one that runs on
  new_repo; git -C "$W" switch -q -c side main; printf '%s\n' 'echo "land: main copy ran"; exit 0' >> "$W/scripts/land"
  git -C "$W" commit -q -am "Change land"; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; change README.md; land
  [ "$rc" -eq 0 ] && has "rebased; running main's copy" && has "land: main copy ran"
}
t_behind_pushed() {
  new_repo; change README.md; git -C "$W" push -q origin topic; local sent; sent=$(git -C "$W" rev-parse topic)
  git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; land
  [ "$rc" -ne 0 ] && has "already pushed to origin" && has "Merge main into it instead: git merge origin/main" \
    && ! has "rebase it" && ! ci_ran && [ "$(git -C "$C/origin.git" rev-parse topic)" = "$sent" ]
}
case_ "a dirty working tree is refused"                     t_dirty
case_ "a never-pushed branch behind main is rebased and lands" t_behind
case_ "a rebase that conflicts stops and names the file"    t_behind_conflict
case_ "a rebase that leaves nothing to land stops"          t_behind_empty
case_ "a dry run predicts a rebase conflict"                t_behind_dry_conflict
case_ "main's copy of land runs after the rebase"           t_behind_rerun
t_behind_dry() {   # a dry run says it would rebase and leaves the branch where it was
  new_repo; git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; change README.md; local before; before=$(git -C "$W" rev-parse topic); land --dry-run
  [ "$rc" -eq 0 ] && has "a run without --dry-run rebases it onto origin/main first" && ! pushed topic \
    && [ "$(git -C "$W" rev-parse topic)" = "$before" ]
}
case_ "a dry run behind main says it would rebase"          t_behind_dry
t_behind_local() {
  new_repo noremote; git -C "$W" switch -q main; change uv.lock; git -C "$W" switch -q topic; change README.md
  local was; was=$(git -C "$W" rev-parse main); land
  [ "$rc" -eq 0 ] && has "rebasing it onto main" && ci_ran && [ "$(git -C "$W" rev-parse main)" = "$(git -C "$W" rev-parse topic)" ] \
    && [ "$(git -C "$W" rev-parse main~1)" = "$was" ]
}
t_behind_stale() {   # origin's topic is an earlier, unrelated branch of the same name
  new_repo; git -C "$W" switch -q -c old main; change old.txt; git -C "$W" push -q origin old:topic
  git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; change README.md; land
  [ "$rc" -ne 0 ] && has "already has a topic with other history" && has "git branch -m" && ! has "git merge" && ! ci_ran
}
t_behind_suffix() {  # a remote branch whose name only ends in /topic is not this branch
  new_repo; git -C "$W" push -q origin main:refs/heads/someone/topic
  git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; change README.md; land
  [ "$rc" -eq 0 ] && has "rebasing it onto origin/main" && ci_ran && pushed topic
}
t_main_merged_in() { # a pushed branch with main merged in lands under its own subject and message
  new_repo; change README.md "Say what the change does"; git -C "$W" push -q origin topic
  git -C "$W" switch -q -c side main; change uv.lock; git -C "$W" push -q origin side:main
  git -C "$W" switch -q topic; git -C "$W" fetch -q origin; git -C "$W" merge -q --no-edit origin/main; land
  logged "Say what the change does" && ! logged "Merge remote-tracking branch"
}
case_ "a pushed branch behind main is told to merge main"   t_behind_pushed
case_ "a branch behind main with no remote is rebased"       t_behind_local
case_ "a stale same-named remote branch is not 'pushed'"    t_behind_stale
case_ "a remote x/topic does not count as topic pushed"     t_behind_suffix
case_ "a merge of main stays out of the pull request text"  t_main_merged_in

# --- addresses ---
t_refused() {   # t_refused <where> <commit/body setup function>
  local where="$1"; shift
  new_repo; "$@"
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT="${STRICT:-1}" scripts/land --reviewed "test" ${BODYARG:+--body "$BODYARG"} 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has "$where" && ! has "jane@" && ! pushed topic && ! ci_ran
}
# (the address below is written in two parts, so that this file itself passes the check)
c_suffix()  { echo x > "$W/n.txt"; git -C "$W" add -A
              git -C "$W" -c user.email="jane@example.com""@users.noreply.github.com" commit -q -m "Add"; }
c_folded()  { echo x > "$W/n.txt"; git -C "$W" add -A
              git -C "$W" commit -q -m "Add" -m "$(printf 'Co-authored-by: Jane Doe\n <jane@example.com>')"; }
c_cc()      { echo x > "$W/n.txt"; git -C "$W" add -A; git -C "$W" commit -q -m "Add" -m "Cc: jane@example.com"; }
c_bare()    { echo x > "$W/n.txt"; git -C "$W" add -A; git -C "$W" commit -q -m "Add" -m "Ask jane@example.com about it."; }
c_file()    { echo "contact: jane@example.com" > "$W/notes.txt"; git -C "$W" add -A; git -C "$W" commit -q -m "Add notes"; }
c_body()    { change README.md; BODYARG="$C/body.md"; printf '## Summary\nAsk jane@example.com.\n' > "$BODYARG"; }
STRICT=0 case_ "an address hiding before a noreply suffix"  t_refused "users.noreply.github.com" c_suffix
case_ "a trailer address folded onto the next line"         t_refused "message: an address at example.com" c_folded
case_ "a Cc: trailer"                                       t_refused "message: an address at example.com" c_cc
case_ "a bare address in the message body"                  t_refused "message: an address at example.com" c_bare
case_ "an address in a committed file, named by path"       t_refused "file notes.txt: an address at example.com" c_file
BODYARG="" case_ "an address in the --body file"            t_refused "body file" c_body
BODYARG=""
c_nul()     { printf 'x\000contact jane@example.com\n' > "$W/bin.dat"; git -C "$W" add -A; git -C "$W" commit -q -m "Add"; }
c_nodiff()  { echo "*.dat -diff" > "$W/.gitattributes"; echo "contact jane@example.com" > "$W/notes.dat"
              git -C "$W" add -A; git -C "$W" commit -q -m "Add"; }
c_empty()   { : > "$W/jane@example.com"; git -C "$W" add -A; git -C "$W" commit -q -m "Add"; }
c_binname() { mkdir -p "$W/jane@example.com"; printf 'x\000y\n' > "$W/jane@example.com/blob.bin"
              git -C "$W" add -A; git -C "$W" commit -q -m "Add"; }
case_ "an address in a file with a NUL byte"                t_refused "file bin.dat: an address at example.com" c_nul
case_ "an address in a file marked -diff"                   t_refused "file notes.dat: an address at example.com" c_nodiff
case_ "an empty file named after an address"                t_refused "file name <address>: an address at example.com" c_empty
case_ "a binary file whose path holds an address"           t_refused "file name <address>/blob.bin" c_binname
t_note_address() {
  new_repo; change README.md
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 scripts/land --reviewed "asked jane@example.com" 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has "review note: an address at example.com" && ! pushed topic && ! logged "statuses"
}
case_ "an address in the --reviewed note"                   t_note_address
t_renamed_in_full() {
  new_repo; c_file; git -C "$W" mv notes.txt moved.txt; git -C "$W" commit -q -m "Move"
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 "$ROOT/scripts/check-addresses" HEAD~1..HEAD 2>&1); rc=$?
  [ "$rc" -eq 1 ] && has "file moved.txt: an address at example.com"
}
case_ "a renamed file is read in full"                      t_renamed_in_full
t_allowed() {
  new_repo
  cat > "$W/allowed.txt" <<'EOF'
uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v5
npx ccusage@20.0.48
@dataclass
pattern = r"[0-9]+\+[^<>]*@users\.noreply\.github\.com"
49699333+dependabot[bot]@users.noreply.github.com and 41898282+github-actions[bot]@users.noreply.github.com
url = git@github.com:example/repo.git
support@github.com noreply@github.com jane@example.com ops@build.test a@b.invalid c@d.example e@host.localhost
EOF
  git -C "$W" add -A
  git -C "$W" commit -q -m "Add allowed" -m "Co-Authored-By: Claude <noreply@anthropic.com>"
  land --reviewed "test"; [ "$rc" -eq 0 ] && pushed topic
}
case_ "service, noreply and example addresses are allowed; package pins and patterns are not addresses" t_allowed
# check_title <text>: run scripts/check-addresses on a title alone; sets rc and out
check_title() { out=$("$ROOT/scripts/check-addresses" --title "$1" 2>&1); rc=$?; }
t_two_at()   { check_title "ask jane@example.com""@build.test"; [ "$rc" -eq 1 ] && has "title: an address at build.test"; }
t_no_input() { out=$(cd "$TMP" && "$ROOT/scripts/check-addresses" HEAD 2>&1); rc=$?; [ "$rc" -eq 2 ] && has "could not read"; }
t_userinfo() {
  check_title "curl https://key@api.alpaca.markets/v2 and https://user:pw@paper-api.alpaca.markets/v2" || :
  [ "$rc" -eq 0 ] || return 1
  out=$(CHECK_ADDRESSES_STRICT=1 "$ROOT/scripts/check-addresses" --title "https://jane@example.com/x" 2>&1); rc=$?
  [ "$rc" -eq 0 ] || return 1
  out=$(CHECK_ADDRESSES_STRICT=1 "$ROOT/scripts/check-addresses" --title "see jane@example.com" 2>&1); rc=$?
  [ "$rc" -eq 1 ]
}
case_ "a URL's userinfo is not an address"                  t_userinfo
# (the decorators and gmail addresses below are written in two parts, so that this file itself passes)
t_diff_marker() {
  local a
  for a in "+""@pytest.mark.parametrize" " +""@pytest.fixture" "    -""@pytest.fixture" "-""@gmail.com"; do
    check_title "$a"; [ "$rc" -eq 0 ] || return 1
  done
  new_repo
  printf '%s\n' '+''@pytest.mark.parametrize("x", [1])' ' -''@pytest.fixture' > "$W/change.patch"
  git -C "$W" add -A; git -C "$W" commit -q -m "Add a patch"
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 "$ROOT/scripts/check-addresses" HEAD~1..HEAD 2>&1); rc=$?
  [ "$rc" -eq 0 ] || return 1
  printf '%s\n' '+x@''gmail.com' ' -y@''gmail.com' > "$W/real.patch"
  git -C "$W" add -A; git -C "$W" commit -q -m "Add another patch"
  out=$(cd "$W" && "$ROOT/scripts/check-addresses" HEAD~1..HEAD 2>&1); rc=$?
  [ "$rc" -eq 1 ] && has "file real.patch: an address at gmail.com" || return 1
  out=$(CHECK_ADDRESSES_STRICT=1 "$ROOT/scripts/check-addresses" --title "a+b@example.org" 2>&1); rc=$?
  [ "$rc" -eq 1 ] && has "title: an address at example.org" || return 1
  for a in "x@""gmail.com" "+x@""gmail.com" "x_@""gmail.com" "jos"$'\xc3\xa9'"_@""gmail.com" \
           "jos"$'\xc3\xa9'"-@""gmail.com" "_@+@""gmail.com"; do
    check_title "$a"; [ "$rc" -eq 1 ] && has "title: an address at gmail.com" || return 1
  done
}
case_ "a diff marker before a decorator is not an address; a real address stays refused" t_diff_marker
case_ "a token with two @ is refused even at example domains" t_two_at
case_ "check-addresses fails loudly when git cannot read the range" t_no_input

# --- the pre-push hook ---
hook_repo() {
  new_repo; mkdir -p "$W/.githooks"; cp "$ROOT/.githooks/pre-push" "$W/.githooks/"
  git -C "$W" add -A && git -C "$W" commit -q -m "Hook"
}
t_hook_new_branch() {
  hook_repo; git -C "$W" config core.hooksPath .githooks; c_file
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 git push -q origin topic 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has "file notes.txt" && ! has "jane@" && ! pushed topic
}
t_hook_clean_and_delete() {
  hook_repo; git -C "$W" config core.hooksPath .githooks
  (cd "$W" && CHECK_ADDRESSES_STRICT=1 git push -q origin topic) || return 1
  pushed topic || return 1
  (cd "$W" && CHECK_ADDRESSES_STRICT=1 git push -q origin :topic) || return 1
  ! pushed topic
}
t_hook_range() {
  hook_repo; c_file; git -C "$W" push -q origin topic || return 1    # pushed before the hook was enabled
  git -C "$W" config core.hooksPath .githooks; change README.md
  (cd "$W" && CHECK_ADDRESSES_STRICT=1 git push -q origin topic) || return 1
  [ "$(git -C "$C/origin.git" rev-parse topic)" = "$(git -C "$W" rev-parse topic)" ]
}
t_hook_tag() {   # t_hook_tag <tagger email> <tag message>
  hook_repo; git -C "$W" config core.hooksPath .githooks
  git -C "$W" -c user.email="$1" tag -a v1 -m "$2"
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 git push -q origin v1 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has "tag " && ! has "jane@" && ! git -C "$C/origin.git" rev-parse -q --verify refs/tags/v1 >/dev/null
}
case_ "pre-push refuses an annotated tag by its tagger"     t_hook_tag "jane@example.com" "Release"
case_ "pre-push refuses an annotated tag by its message"    t_hook_tag "1+test@users.noreply.github.com" "Ask jane@example.com"
case_ "pre-push refuses a new branch carrying an address"   t_hook_new_branch
case_ "pre-push lets a clean branch and a deletion through" t_hook_clean_and_delete
case_ "pre-push reads only the commits the remote lacks"    t_hook_range

# --- pull requests someone else opened (--pr) ---
# bot_pr <path> [<ci stub>]: branch bot on origin with one change (and its own scripts/ci, if given),
# announced as open pull request 5
bot_pr() {   # fails, naming why, if a git step fails; every caller stops then (`bot_pr ... || return 1`)
  why="setting up the bot branch failed"
  new_repo; git -C "$W" switch -q -c bot main && change "$1" || return 1
  if [ -n "${2:-}" ]; then { printf '%s\n' "$2" > "$W/scripts/ci" && git -C "$W" commit -q -am "Stub"; } || return 1; fi
  { git -C "$W" push -q origin bot && git -C "$W" switch -q topic && git -C "$W" branch -q -D bot; } || return 1
  why=""
  echo bot > "$FAKE/pr_head"; echo "5 https://github.example/o/r/pull/5" > "$FAKE/pr_open"
  echo '{"headRefName":"bot","state":"OPEN","url":"https://github.example/o/r/pull/5","isCrossRepository":false}' > "$FAKE/pr_info"
  echo "Bump the lockfile" > "$FAKE/pr_title"; printf 'Bumps the lockfile.\n\nRelease notes here.\n' > "$FAKE/pr_body"
}
# main_moves: origin's main gains a commit that the bot branch lacks
main_moves() { why="moving main failed"; git -C "$W" switch -q -c side main && change README.md "Move main" && git -C "$W" push -q origin side:main \
                 && git -C "$W" switch -q topic && why=""; }
gone() { [ ! -e "$C/canon-worktrees/pr-5" ] && ! git -C "$W" show-ref --verify -q refs/heads/bot; }
t_pr_lands() { bot_pr uv.lock || return 1; land --pr 5; [ "$rc" -eq 0 ] && logged "pr merge 5 --squash" && gone; }
t_pr_message() {
  bot_pr src/a.py || return 1; land --pr 5
  [ "$rc" -ne 0 ] && has 'scripts/land --pr 5 --reviewed "' && gone
}
t_pr_interrupted() {
  # the bot branch's scripts/ci stops the outer run with TERM, as an interrupt would
  # shellcheck disable=SC2016  # expanded by the stub, not here
  bot_pr uv.lock '#!/bin/bash
for _ in $(seq 50); do [ -s "$FAKE/outer_pid" ] && break; sleep 0.1; done
echo sent > "$FAKE/killed"; kill -TERM "$(cat "$FAKE/outer_pid")"; exit 1' || return 1
  (cd "$W" && exec scripts/land --pr 5 --reviewed "test") >/dev/null 2>&1 &
  echo $! > "$FAKE/outer_pid"; wait $! 2>/dev/null
  [ -e "$FAKE/killed" ] || return 1
  for _ in $(seq 50); do gone && return 0; sleep 0.1; done
  return 1
}
t_pr_inner_stopped() {
  # the stub stops the outer run, then succeeds, so an inner run that is not stopped would go on to merge
  # shellcheck disable=SC2016  # expanded by the stub, not here
  bot_pr uv.lock '#!/bin/bash
for _ in $(seq 50); do [ -s "$FAKE/outer_pid" ] && break; sleep 0.1; done
echo "$PPID" > "$FAKE/inner_pid"; echo sent > "$FAKE/killed"; kill -TERM "$(cat "$FAKE/outer_pid")"; sleep 1; exit 0' || return 1
  (cd "$W" && exec scripts/land --pr 5 --reviewed "test") >/dev/null 2>&1 &
  echo $! > "$FAKE/outer_pid"; wait $! 2>/dev/null
  [ -e "$FAKE/killed" ] || return 1
  # the outer run returns only once the inner one has stopped
  ! kill -0 "$(cat "$FAKE/inner_pid")" 2>/dev/null || return 1
  for _ in $(seq 50); do gone && break; sleep 0.1; done
  sleep 0.5        # time for an inner run that was not stopped to reach GitHub
  gone && ! logged "statuses" && ! logged "pr merge"
}
t_inner_message() {
  new_repo; change src/a.py
  out=$(cd "$W" && LAND_PR=5 scripts/land 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has 'scripts/land --pr 5 --reviewed "'
}
t_pr_behind_text() {
  bot_pr uv.lock || return 1; main_moves || return 1; land --pr 5
  [ "$rc" -eq 0 ] && has "is behind main" && logged "--subject Bump the lockfile (#5) --body-file" \
    && grep -c "Release notes here." "$FAKE/merge_body" >/dev/null && ! grep -c "Merge" "$FAKE/merge_body" >/dev/null && gone
}
t_pr_refused_text() {   # t_pr_refused_text <title|body> <what check-addresses names>
  bot_pr uv.lock || return 1; main_moves || return 1
  echo "Ask jane@example.com about it" > "$FAKE/pr_$1"
  out=$(cd "$W" && CHECK_ADDRESSES_STRICT=1 scripts/land --pr 5 2>&1); rc=$?
  [ "$rc" -ne 0 ] && has "$2" && ! has "jane@" && ! logged "statuses" && ! logged "pr merge" && gone
}
# left_behind: what of the --pr run's worktree and branch is still there, and git's worktree list, for a
# failure line
left_behind() {
  [ ! -e "$C/canon-worktrees/pr-5" ] || printf 'the worktree folder; '
  ! git -C "$W" show-ref --verify -q refs/heads/bot || printf 'branch bot; '
  printf 'git worktree list: %s' "$(git -C "$W" worktree list 2>&1 | oneline 200)"
}
t_pr_view_fails() {     # t_pr_view_fails <title|body>: each check names itself on the FAIL line
  bot_pr uv.lock || return 1
  main_moves || return 1
  rm -f "$FAKE/pr_$1"; land --pr 5
  [ "$rc" -ne 0 ] || { why="land exited 0"; return 1; }
  has "could not read the" || { why="land did not say it could not read the $1"; return 1; }
  ! logged "statuses" || { why="a status was posted"; return 1; }
  ! logged "pr merge" || { why="a merge was called"; return 1; }
  gone || { why="left behind: $(left_behind)"; return 1; }
}
t_existing_title() {
  new_repo; change README.md "Commit subject"; echo "7 https://github.example/o/r/pull/7" > "$FAKE/pr_open"
  echo "Title on GitHub" > "$FAKE/pr_title"; land
  [ "$rc" -eq 0 ] && logged "--subject Title on GitHub (#7) --body-file" && ! logged "pr create"
}
t_pr_dry_closed() {
  bot_pr uv.lock || return 1; rm -f "$FAKE/pr_open"
  echo '{"headRefName":"bot","state":"MERGED","url":"https://github.example/o/r/pull/5","isCrossRepository":false}' > "$FAKE/pr_info"
  land --pr 5 --dry-run
  [ "$rc" -eq 0 ] && has "pull request 5 is not open" && has "dry run: would push" && ! has "is , not" \
    && ! logged "statuses" && gone
}
t_pr_numbered_title() {
  bot_pr uv.lock || return 1; echo "Bump the lockfile (#5)" > "$FAKE/pr_title"; land --pr 5
  [ "$rc" -eq 0 ] && logged "--subject Bump the lockfile (#5) --body-file" && ! logged "(#5) (#5)"
}
case_ "--pr lands a lockfile-only pull request and leaves nothing behind" t_pr_lands
case_ "--pr --dry-run on a pull request no longer open reports it and goes on" t_pr_dry_closed
case_ "a title that already ends in its number does not get it twice" t_pr_numbered_title
case_ "--pr behind main lands with the pull request's title and body" t_pr_behind_text
case_ "--pr with an address in the pull request's title stops before any status" t_pr_refused_text title "title: an address at example.com"
case_ "--pr with an address in the pull request's body stops before any status" t_pr_refused_text body "body file"
case_ "--pr stops when the pull request's title cannot be read" t_pr_view_fails title
case_ "--pr stops when the pull request's body cannot be read" t_pr_view_fails body
case_ "an existing pull request keeps its own title"        t_existing_title
case_ "--pr refusal names --pr in the command to run"       t_pr_message
case_ "a run inside --pr names --pr in the command to run"  t_inner_message
case_ "an interrupted --pr run removes its worktree and branch" t_pr_interrupted
case_ "an interrupted --pr run stops the run inside it"     t_pr_inner_stopped

# --- dry run ---
t_dry_missing_note() {
  new_repo; change src/a.py; land --dry-run
  [ "$rc" -ne 0 ] && ci_ran && has "would push" && has "needs an independent review" && ! pushed topic
}
case_ "--dry-run without a needed note still runs the checks, then fails" t_dry_missing_note

# --- merging ---
t_match_head() {
  new_repo; change README.md; land
  local sha; sha=$(git -C "$W" rev-parse topic)
  [ "$rc" -eq 0 ] && logged "pr merge 7 --squash --match-head-commit $sha"
}
t_auto_match_head() {
  new_repo; change README.md; echo 1 > "$FAKE/merge_rc"; land
  local sha; sha=$(git -C "$W" rev-parse topic)
  [ "$rc" -eq 0 ] && logged "pr merge 7 --auto --squash --match-head-commit $sha"
}
t_head_moved() {
  new_repo; change README.md; echo 1 > "$FAKE/merge_rc"; echo "OPEN OTHER" > "$FAKE/views"; land
  [ "$rc" -ne 0 ] && has "not the checked commit"
}
t_merge_then_wait() {
  new_repo; change README.md; printf 'OPEN HEAD\nOPEN HEAD\nMERGED HEAD\n' > "$FAKE/views"; land
  [ "$rc" -eq 0 ] && has "landed:"
}
t_merge_then_fail() {
  new_repo; change README.md; echo "OPEN HEAD" > "$FAKE/views"; echo "all required checks passed" > "$FAKE/checks"; land
  [ "$rc" -ne 0 ] && has "a required check failed"
}
case_ "the direct merge names the checked commit"           t_match_head
case_ "auto-merge names the checked commit"                 t_auto_match_head
case_ "a moved pull request head stops the wait"            t_head_moved
case_ "a merge call that returns before merging is waited for" t_merge_then_wait
case_ "a failed required check after a merge call stops the wait" t_merge_then_fail
t_merge_text() {   # t_merge_text <merge_rc>: both merge calls carry the checked subject and message
  new_repo; echo "line" >> "$W/README.md"; git -C "$W" commit -q -am "Reword the readme" -m "Details for the reader."
  echo "$1" > "$FAKE/merge_rc"; land
  [ "$rc" -eq 0 ] && logged "--subject Reword the readme (#7) --body-file" && grep -c "Details for the reader." "$FAKE/merge_body" >/dev/null
}
t_closed() {
  new_repo; change README.md; echo 1 > "$FAKE/merge_rc"; echo "CLOSED HEAD" > "$FAKE/views"
  LAND_WAIT_SECONDS=1000 land
  [ "$rc" -ne 0 ] && has "closed without being merged"
}
t_merge_errors() {
  new_repo; change README.md; echo 1 > "$FAKE/merge_rc"; echo 1 > "$FAKE/auto_rc"; land
  [ "$rc" -ne 0 ] && has "direct merge refused by the fake" && has "auto-merge refused by the fake"
}
case_ "the direct merge gives the checked subject and message" t_merge_text 0
case_ "auto-merge gives the checked subject and message"    t_merge_text 1
case_ "a pull request closed while waiting stops the wait"  t_closed
case_ "both merge calls' errors are shown when both fail"   t_merge_errors

# --- the fix marker (ADR 0073, addition of 2026-11-11) ---
# fix <path> <subject> [<trailer line>...]: change a file and commit it with a body and the given trailers
fix() {
  local path="$1" subject="$2" msg; shift 2
  msg=$(printf '%s\n\n## Summary\n\nDetails for the reader.\n\nCo-Authored-By: Test <1+test@users.noreply.github.com>' "$subject")
  [ $# -eq 0 ] || msg=$(printf '%s\n%s' "$msg" "$(printf '%s\n' "$@")")
  mkdir -p "$(dirname "$W/$path")"; echo "line" >> "$W/$path"
  git -C "$W" add -A && git -C "$W" commit -q -m "$msg"
}
# merged_trailer <key>: the values of that trailer in the squash commit GitHub would write from the merge call
# (its --subject, a blank line, then its --body-file), as git itself parses them
merged_trailer() {
  { logged "--subject " && [ -f "$FAKE/merge_body" ]; } || return 1
  { sed -n 's/.* --subject \(.*\) --body-file .*/\1/p' "$FAKE/log" | tail -n 1; echo; cat "$FAKE/merge_body"; } \
    | git interpret-trailers --parse --no-divider | sed -n "s/^$1: //p"
}
warned() { printf '%s\n' "$out" | grep -c "^land: warning:" ; }
t_fix_warns() {
  new_repo; fix src/canon_trading/ranking.py "Fix the gate's finding on an empty sample"
  land --reviewed "code-review ran"
  why="no warning naming Fails-before, or not landed"
  [ "$rc" -eq 0 ] && has "landed:" && [ "$(warned)" -eq 1 ] && has "no Fails-before trailer" \
    && has "src/canon_trading/ranking.py"
}
t_fix_confirms_warns() {   # a Confirms trailer says it fixes a finding, whatever the subject says
  new_repo; fix src/canon_trading/ranking.py "Refuse an empty sample" "Confirms: round-3/codex-2"
  land --reviewed "code-review ran"; [ "$rc" -eq 0 ] && [ "$(warned)" -eq 1 ] && has "no Fails-before trailer"
}
t_fix_dry_warns() {
  new_repo; fix src/canon_trading/ranking.py "Fix a finding"; land --dry-run --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(warned)" -eq 1 ] && ! pushed topic
}
t_fix_named() {
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate" \
    "Fails-before: tests/test_gate.py::TestGate::test_refuses[empty]"
  land --reviewed "code-review ran"; why="warned on tests that exist"
  [ "$rc" -eq 0 ] && has "landed:" && [ "$(warned)" -eq 0 ]
}
t_fix_named_missing() {    # one warning line per named test the tree lacks; the run still lands
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_nothing" \
    "Fails-before: tests/test_absent.py::test_gate" "Fails-before: tests/test_gate.py::test_gate"
  land --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && has "landed:" && [ "$(warned)" -eq 2 ] && has "tests/test_gate.py::test_nothing" \
    && has "tests/test_absent.py::test_gate"
}
t_fix_named_off_path() {   # a named test is checked wherever the change is
  new_repo; fix src/a.py "Fix a finding" "Fails-before: tests/test_gate.py::test_gone"
  land --reviewed "code-review ran"; [ "$rc" -eq 0 ] && [ "$(warned)" -eq 1 ] && has "tests/test_gate.py::test_gone"
}
t_fix_off_path() {
  new_repo; fix src/a.py "Fix the finding in a helper"; land --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(warned)" -eq 0 ]
}
t_no_fix_on_path() {
  new_repo; fix src/canon_trading/ranking.py "Name the gate's threshold"; land --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(warned)" -eq 0 ]
}
t_trailers_merge() {       # t_trailers_merge <merge_rc>: one commit's trailers reach the squash commit
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate" \
    "Confirms: round-3/codex-2"
  echo "$1" > "$FAKE/merge_rc"; land --reviewed "code-review ran"
  why="trailers missing from the squash message"
  [ "$rc" -eq 0 ] && [ "$(merged_trailer Fails-before)" = "tests/test_gate.py::test_gate" ] \
    && [ "$(merged_trailer Confirms)" = "round-3/codex-2" ] && [ -n "$(merged_trailer Co-Authored-By)" ]
}
t_trailers_merge_many() {  # a trailer on an earlier commit of several reaches the squash commit's trailer block
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate" \
    "Confirms: round-3/codex-2"
  fix src/canon_trading/ranking.py "Fix the second finding" "Fails-before: tests/test_gate.py::TestGate::test_refuses"
  land --reviewed "code-review ran"; why="an earlier commit's trailers missing from the squash message"
  [ "$rc" -eq 0 ] && [ "$(warned)" -eq 0 ] \
    && [ "$(merged_trailer Fails-before | LC_ALL=C sort | paste -sd, -)" = "tests/test_gate.py::TestGate::test_refuses,tests/test_gate.py::test_gate" ] \
    && [ "$(merged_trailer Confirms)" = "round-3/codex-2" ]
}
t_trailers_body_file() {   # a --body file without them gets the commits' trailers; the file itself is left alone
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate"
  printf '## Summary\n\nWritten by hand.\n' > "$C/body.md"
  land --body "$C/body.md" --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(merged_trailer Fails-before)" = "tests/test_gate.py::test_gate" ] \
    && grep -c "Written by hand." "$FAKE/merge_body" >/dev/null && ! grep -c "Fails-before" "$C/body.md" >/dev/null
}
t_trailers_local() {       # with no remote, main is the branch itself, so its trailers are on main
  new_repo noremote
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate"
  land --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(git -C "$W" log -1 --format='%(trailers:key=Fails-before,valueonly)' main)" = "tests/test_gate.py::test_gate" ]
}
t_index() {                # the index lists landed commits with their trailers, newest first, and no others
  new_repo noremote
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate" \
    "Fails-before: tests/test_gate.py::TestGate::test_refuses" "Confirms: round-3/codex-2"
  fix README.md "Reword the readme"
  fix src/a.py "Answer a reader" "Confirms: muse/4"
  land --reviewed "code-review ran" || return 1
  out=$(cd "$W" && scripts/fix-index 2>&1); rc=$?
  why="fix-index output not as expected"
  [ "$rc" -eq 0 ] || return 1
  jq -e --arg a "$(git -C "$W" rev-parse main)" --arg b "$(git -C "$W" rev-parse main~2)" '
    length == 2
    and .[0].commit == $a and .[0].subject == "Answer a reader"
    and .[0].fails_before == [] and .[0].confirms == ["muse/4"]
    and .[1].commit == $b and .[1].subject == "Fix the gate'"'"'s finding"
    and .[1].fails_before == ["tests/test_gate.py::test_gate", "tests/test_gate.py::TestGate::test_refuses"]
    and .[1].confirms == ["round-3/codex-2"]
    and (.[1].date | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))' <<<"$out" >/dev/null
}
t_index_squash() {         # a squash commit made from the merge call's subject and message is indexed the same
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate"
  fix src/canon_trading/ranking.py "Fix the next one" "Confirms: round-3/codex-2"
  land --reviewed "code-review ran" || return 1
  local subject tree sq
  subject=$(sed -n 's/.* --subject \(.*\) --body-file .*/\1/p' "$FAKE/log" | tail -n 1)
  tree=$(git -C "$W" rev-parse 'topic^{tree}')
  sq=$({ printf '%s\n\n' "$subject"; cat "$FAKE/merge_body"; } | git -C "$W" commit-tree "$tree" -p main) || return 1
  git -C "$W" update-ref refs/heads/squashed "$sq"
  out=$(cd "$W" && scripts/fix-index squashed 2>&1); rc=$?
  [ "$rc" -eq 0 ] && jq -e '.[0].subject == "Fix the next one (#7)" and .[0].fails_before == ["tests/test_gate.py::test_gate"]
    and .[0].confirms == ["round-3/codex-2"] and length == 1' <<<"$out" >/dev/null
}
t_index_bad_rev() { new_repo noremote; out=$(cd "$W" && scripts/fix-index no-such-rev 2>&1); rc=$?
                    [ "$rc" -ne 0 ] && has "fix-index"; }
t_trailers_url_body() {    # a description ending in a bare URL keeps it as written; the trailers get their own paragraph
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate"
  fix src/canon_trading/ranking.py "Fix the next one" "Confirms: round-3/codex-2"
  printf '## Summary\n\nBy hand.\n\n## Evidence\n\nhttps://docs.example.com/page\n' > "$C/body.md"
  land --body "$C/body.md" --reviewed "code-review ran"; why="the URL was rewritten or the trailers lost"
  [ "$rc" -eq 0 ] && [ "$(grep -cxF "https://docs.example.com/page" "$FAKE/merge_body")" = 1 ] \
    && [ "$(merged_trailer Fails-before)" = "tests/test_gate.py::test_gate" ] \
    && [ "$(merged_trailer Confirms)" = "round-3/codex-2" ]
}
t_fix_subpackage() {       # an adapter module in a subpackage is on the trading path
  new_repo; fix packages/canon-alpaca/src/canon_alpaca/execution/orders.py "Fix the order path's finding"
  land --reviewed "code-review ran"; [ "$rc" -eq 0 ] && [ "$(warned)" -eq 1 ] && has "no Fails-before trailer"
}
t_fix_wrong_class() {
  new_repo
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::TestGaet::test_refuses"
  land --reviewed "code-review ran"; [ "$rc" -eq 0 ] && [ "$(warned)" -eq 1 ] && has "defines no class TestGaet"
}
t_fixed_seed() {           # "fixed" alone, as in a fixed seed, is not taken for a fix
  new_repo; fix src/canon_trading/ranking.py "Draw the variants from a fixed seed"; land --reviewed "code-review ran"
  [ "$rc" -eq 0 ] && [ "$(warned)" -eq 0 ]
}
t_index_origin() {         # with no revision, the index reads origin/main, which a stale local main may lag
  new_repo
  git -C "$W" switch -q -c side main
  fix src/canon_trading/ranking.py "Fix the gate's finding" "Fails-before: tests/test_gate.py::test_gate"
  git -C "$W" push -q origin side:main && git -C "$W" fetch -q origin || return 1
  out=$(cd "$W" && scripts/fix-index 2>&1); rc=$?
  [ "$rc" -eq 0 ] && jq -e 'length == 1 and .[0].subject == "Fix the gate'"'"'s finding"' <<<"$out" >/dev/null
}
t_trading_globs() {        # every glob of scripts/land's trading path matches a tracked file here
  local list g n bad=""
  list=$(sed -n "s/^TRADING_PATHS='\(.*\)'$/\1/p" "$ROOT/scripts/land")
  why="TRADING_PATHS missing from scripts/land"; [ -n "$list" ] || return 1
  set -f
  for g in $list; do
    n=$(git -C "$ROOT" ls-files -- ":(glob)$g" | grep -c .)
    [ "$n" -gt 0 ] || bad="$bad $g"
  done
  set +f
  why="globs matching no tracked file:${bad}"; [ -z "$bad" ]
}
case_ "a trading-path fix with no Fails-before warns and still lands" t_fix_warns
case_ "a Confirms trailer counts as fixing a finding"       t_fix_confirms_warns
case_ "a dry run prints the same warning"                   t_fix_dry_warns
case_ "Fails-before naming tests that exist: no warning"    t_fix_named
case_ "Fails-before naming tests the tree lacks warns once each and lands" t_fix_named_missing
case_ "a named test is checked off the trading path too"    t_fix_named_off_path
case_ "a fix off the trading path does not warn"            t_fix_off_path
case_ "a trading-path change that fixes nothing does not warn" t_no_fix_on_path
case_ "the direct merge keeps the commit's trailers"        t_trailers_merge 0
case_ "auto-merge keeps the commit's trailers"              t_trailers_merge 1
case_ "an earlier commit's trailers reach the squash message" t_trailers_merge_many
case_ "a --body file gets the commits' trailers"            t_trailers_body_file
case_ "with no remote the trailers are on main"             t_trailers_local
case_ "fix-index lists landed commits with their trailers"  t_index
case_ "fix-index reads a squash commit built from the merge call" t_index_squash
case_ "fix-index fails loudly on a revision git cannot read" t_index_bad_rev
case_ "a description ending in a URL keeps it, and gets the trailers" t_trailers_url_body
case_ "an adapter module in a subpackage is on the trading path" t_fix_subpackage
case_ "Fails-before naming a class the file lacks warns"   t_fix_wrong_class
case_ "a fixed seed is not a fix"                           t_fixed_seed
case_ "fix-index reads origin/main by default"              t_index_origin
case_ "every trading-path glob matches a tracked file"      t_trading_globs

wait
pass=0; fail=0
for i in $(seq 1 "$ncase"); do
  r="$RESULTS/$(printf '%03d' "$i")"
  if [ ! -s "$r" ]; then
    echo "  FAIL  case $i left no result"; sed -n '1,6s/^/        /p' "$r.err" 2>/dev/null
    fail=$((fail + 1)); continue
  fi
  cat "$r"
  case "$(sed -n 1p "$r")" in "  ok "*) pass=$((pass + 1)) ;; *) fail=$((fail + 1)) ;; esac
done
echo "test-land: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
