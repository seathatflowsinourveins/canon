CI_OS=Darwin runci --landing
check "a landing on macOS passes"                  test "$RC" = 0
check "it runs test-lanes"                         test -e "$C.test-lanes.ran"
check "and test-maintenance"                       test -e "$C.test-maintenance.ran"
check "and no other test script"                   test ! -e "$C.test-zz.ran"
check "test-lanes has its ok line"                 has '^  ok    test-lanes$'
rm -f "$C".test-*.ran
runci --landing
check "a landing elsewhere leaves test-lanes"      test ! -e "$C.test-lanes.ran"
check "and test-maintenance to the hosted run"     has '^  skip  test-maintenance \(not run here; the hosted required check runs it\)$'
}
case_fullall() {
