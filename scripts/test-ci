#!/bin/bash
# test-ci — run scripts/ci on a changed copy of this repo and check what it reports.
# The copy is `git archive HEAD` plus the working tree's scripts/ci, committed into a fresh repository in a
# temp folder. mise and the tools it provides are fakes first on PATH, and the scripts scripts/ci calls are
# stubs, so each case takes well under a second. Cases run concurrently, each in its own copy, except the
# first (whose results later cases use) and the signal cases (SIGINT cannot be trapped in a background job).
# Exit 0 if every case behaves as expected, 1 otherwise.
# Offline; touches only a temp folder. CANON_TEST_CI marks a run inside this script; scripts/ci then skips
# scripts/test-ci, and if it did not, the nested run would stop here with a failure.
set -uo pipefail
if [ -n "${CANON_TEST_CI:-}" ]; then echo "test-ci: already running inside scripts/test-ci"; exit 1; fi
export CANON_TEST_CI=1
# scripts/ci takes one of three machine-wide slots unless CANON_CI_SLOT_HELD is set; every case but the slot
# cases runs without waiting for one, as a nested run does. case_slots unsets it for its own runs.
export CANON_CI_SLOT_HELD=1
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# A git hook runs with GIT_DIR, GIT_INDEX_FILE and similar set for the repository being committed to.
# Clear every repository-local variable (git rev-parse --local-env-vars) so git commands in the copies
# act on the copies.
while IFS= read -r v; do [ -n "$v" ] && unset "$v"; done <<<"$(git rev-parse --local-env-vars)"
TMP=$(mktemp -d "${TMPDIR:-/tmp}/canon-test-ci.XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT
skipped=0
RESULTS="$TMP/results"; : >"$RESULTS"
gitq() { git -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false \
             -c core.hooksPath=/dev/null "$@"; }

# --- fake toolchain: `mise env` points PATH at $TOOLS; uv logs its arguments to $UV_LOG ---
FAKE="$TMP/fakebin"; mkdir -p "$FAKE"
cat >"$FAKE/mise" <<'EOF'
#!/bin/bash
case "$*" in
  # FAKE_MISE_KEEP=1: PATH as it was, as mise 2026.11.5 leaves it when it already lists mise's directories
  "env -s bash") if [ -n "${FAKE_MISE_KEEP:-}" ]; then printf 'export PATH=%q\n' "$PATH"
                 else printf 'export PATH=%q\n' "$TOOLS:$PATH"; fi ;;
  "env --paths") printf '%s\n' "$TOOLS" ;;
  # the config files in use: the checkout's, plus FAKE_MISE_STRAY when a case plants one; FAKE_MISE_LS_FAIL fails
  "config ls --json") [ -z "${FAKE_MISE_LS_FAIL:-}" ] || { echo "config ls broke" >&2; exit 1; }
                     jq -cn --arg c "$(pwd -P)/mise.toml" --arg s "${FAKE_MISE_STRAY:-}" \
                       '[{path: $c}] + (if $s == "" then [] else [{path: $s}] end)' ;;
  *) echo "fake mise: unexpected arguments: $*" >&2; exit 2 ;;
esac
EOF
mkdir -p "$TMP/tools"
cat >"$TMP/tools/uv" <<'EOF'
#!/bin/bash
echo "$*" >>"$UV_LOG"
# `--directory <folder>` first is a project kept apart; FAKE_APART_LOCK_FAIL fails its lock check alone
dir=""; if [ "$1" = "--directory" ]; then dir=$2; shift 2; fi
if [ "$1 $2" = "lock --check" ] && [ -z "$dir" ] && [ -n "${FAKE_LOCK_FAIL:-}" ]; then echo "uv.lock needs to be updated"; exit 1; fi
if [ "$1 $2" = "lock --check" ] && [ -n "$dir" ] && [ -n "${FAKE_APART_LOCK_FAIL:-}" ]; then echo "$dir/uv.lock needs to be updated"; exit 1; fi
# FAKE_TY_FAIL fails the root's ty; FAKE_TY_DONE names a file ty writes once it has finished, half a second in
if [ "$1 $2 $3" = "run --locked ty" ] && [ -z "$dir" ]; then
  [ -z "${FAKE_TY_DONE:-}" ] || { sleep 0.5; : >"$FAKE_TY_DONE"; echo "ty finished" >>"$UV_LOG"; }
  [ -z "${FAKE_TY_FAIL:-}" ] || { echo "error[invalid-assignment]: a typing line"; exit 1; }
fi
if [ "$1 $2 $3 $4" = "run --locked pytest --collect-only" ]; then
  [ -z "${FAKE_COLLECT_FAIL:-}" ] || { echo "ERROR collecting tests/test_x.py"; exit 2; }
  # FAKE_PART_NODES: a file of node IDs and collection skip lines, printed as pytest's collection would
  if [ -n "${FAKE_PART_NODES:-}" ]; then cat "$FAKE_PART_NODES"; echo "9 tests collected"; exit 0; fi
  # real pytest's form under --no-fold-skipped, printed only when the skip summary is asked for
  if [ -n "${FAKE_COLLECT_SKIP:-}" ]; then
    for a in "$@"; do
      case "$a" in -r*s*) echo "SKIPPED tests/test_opt.py - Skipped: could not import 'optional_dep'" ;; esac
    done
  fi
  echo "2 tests collected"; exit 0
fi
if [ "$1 $2 $3" = "run --locked pytest" ]; then
  for a in "$@"; do
    case "$a" in -r*s*) echo "SKIPPED tests/test_x.py::test_net - Skipped: no credentials" ;; esac
    # an argument file (a pytest part's tests): each line is one argument, logged as `arg: <line>`
    case "$a" in @*) sed 's/^/arg: /' "${a#@}" >>"$UV_LOG" ;; esac
  done
  echo "1 passed, 1 skipped"
fi
exit 0
EOF
for t in shellcheck gitleaks; do printf '#!/bin/bash\nexit 0\n' >"$TMP/tools/$t"; done
printf '#!/bin/bash\necho "actionlint checked: $*"\nexit 0\n' >"$TMP/tools/actionlint"
chmod +x "$FAKE"/* "$TMP/tools"/*

# --- base copy: HEAD, the current scripts/ci, every script it calls stubbed (scripts/test-ci kept) ---
BASE="$TMP/base"; mkdir -p "$BASE"
git -C "$ROOT" archive HEAD | tar -x -C "$BASE"
cp "$ROOT/scripts/ci" "$BASE/scripts/ci"
cp "$ROOT/scripts/test-ci" "$BASE/scripts/test-ci"
stub() { printf '#!/bin/bash\nexit 0\n' >"$1"; chmod +x "$1"; }
for s in canon lanes survey-github; do stub "$BASE/scripts/$s"; done
for s in "$BASE"/scripts/test-*; do [ -f "$s" ] && [ "${s##*/}" != test-ci ] && stub "$s"; done
# The repository's own projects apart (a uv.lock below the root) are left out of the copy: the cases
# plant their own, so what they expect does not change when this repository gains or loses one.
while IFS= read -r f; do [ -n "$f" ] && rm -f "$BASE/$f"; done <<<"$(git -C "$ROOT" ls-files -- '*/uv.lock')"
if git -C "$BASE" rev-parse --git-dir >/dev/null 2>&1; then
  echo "test-ci: $BASE is already inside a repository; stopping"; exit 1
fi
gitq -C "$BASE" init -q
if [ "$(git -C "$BASE" rev-parse --show-toplevel)" != "$(cd "$BASE" && pwd -P)" ]; then
  echo "test-ci: the copy in $BASE is not its own repository; stopping"; exit 1
fi
gitq -C "$BASE" add -A
gitq -C "$BASE" commit -q -m base

# fresh <name>: copy the base into $C
fresh() { C="$TMP/case-$1"; cp -R "$BASE" "$C"; }
# runci [args...]: run the copy's scripts/ci; sets OUT and RC. Temp files go to $C.tmp, checked later.
runci() {
  mkdir -p "$C.tmp"; : >"$C.uv.log"
  # CANON_CI_OS: Linux unless a case names Darwin, so a case reads the same on this Mac and on the runner
  OUT=$(cd "$C" && PATH="$FAKE:$PATH" TOOLS="${TOOLS:-$TMP/tools}" UV_LOG="$C.uv.log" TMPDIR="$C.tmp" \
        CANON_CI_OS="${CI_OS:-Linux}" \
        scripts/ci "$@" 2>&1); RC=$?
}
# has <regex>: OUT has a line matching the extended regex (reads all of OUT)
has() { [ "$(printf '%s\n' "$OUT" | grep -cE -- "$1")" -gt 0 ]; }
# check <label> <command...>: passes when the command succeeds; one line per result in $RESULTS
check() {
  local label="$1"; shift
  if "$@"; then echo pass >>"$RESULTS"
  else echo fail >>"$RESULTS"; echo "  FAIL  $label"; printf '%s\n' "$OUT" | sed 's/^/        /'; fi
}
# line_after <regex a> <regex b>: some line matching a is followed directly by a line matching b
line_after() {
  [ "$(printf '%s\n' "$OUT" | awk -v a="$1" -v b="$2" 'prev && $0 ~ b { n = 1 } { prev = ($0 ~ a) } END { print n + 0 }')" = 1 ]
}

# line_before <regex a> <regex b>: the first line matching a comes before the first matching b, and both exist
line_before() {
  [ "$(printf '%s\n' "$OUT" | awk -v a="$1" -v b="$2" '!x && $0 ~ a { x = NR } !y && $0 ~ b { y = NR } END { print (x && y && x < y) + 0 }')" = 1 ]
}

# --- the unchanged copy passes ---
fresh plain; runci
check "unchanged copy passes"                      test "$RC" = 0
check "it ends with all checks passed"             has '^ci: all checks passed$'
check "temp files are removed"                     test -z "$(ls -A "$C.tmp")"
n0=$(printf '%s\n' "$OUT" | sed -n 's/^  ok    shell syntax (\([0-9]*\) files)$/\1/p')
check "shell files are counted"                    test -n "$n0"

# --- pytest skips are listed under its ok line ---
check "pytest is asked to report skips"            test "$(grep -c -- '-rfEs' "$C.uv.log")" = 1
check "skip reason follows ok pytest"              line_after '^  ok    pytest$' '^        SKIPPED .*no credentials'

# --- the lock check and the environment come before the Python jobs ---
first2=$(awk 'NR <= 2' "$C.uv.log" | tr '\n' '|')
check "uv lock --check, then uv run --locked first" test "$first2" = "lock --check|run --locked python -c pass|"
check "Python jobs ran after them"                 test "$(grep -cE '^run --locked (ruff|ty|pytest)' "$C.uv.log")" = 4

# --- with no uv.lock below the root there is no project apart, and the root's ty checks everything ---
check "no project apart, no heading"               test "$(printf '%s\n' "$OUT" | grep -c '^Project apart')" = 0
check "nothing ran from another folder"            test "$(grep -c -- '^--directory ' "$C.uv.log")" = 0

# --- recursion guard ---
check "test-ci is skipped inside test-ci"          has '^  skip  test-ci \(running inside scripts/test-ci\)$'

# --- workflows: .yaml counts; none gives a skip line ---
case_yaml() {
fresh yaml
rm -f "$C"/.github/workflows/*.yml
printf 'name: x\non: push\njobs: {}\n' >"$C/.github/workflows/only.yaml"
runci
check "actionlint runs on a .yaml workflow"        has '^  ok    actionlint \(1 workflow files\)$'
}
case_noflows() {
fresh noflows
rm -f "$C"/.github/workflows/*.yml "$C"/.github/workflows/*.yaml
runci
check "no workflows prints a skip line"            has '^  skip  actionlint \(no workflow files'
check "no workflows still passes"                  test "$RC" = 0
}

# --- shell files come from the tracked files' shebangs ---
case_shell() {
fresh shell
mkdir -p "$C/.claude/skills/x"
printf '#!/usr/bin/env bash\nif then\n' >"$C/.claude/skills/x/run.sh"
printf 'not a script\nif then\n' >"$C/.claude/skills/x/notes.txt"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m skill
runci
check "script beside a skill is syntax-checked"    has "^  FAIL  shell syntax \($((n0+1)) files\)$"
check "its error is shown"                         has 'skills/x/run.sh'
check "a file without a shebang is not checked"    test "$(printf '%s\n' "$OUT" | grep -c 'notes.txt')" = 0
}
case_staged() {
fresh staged
printf '#!/bin/sh\nif then\n' >"$C/new-hook"
gitq -C "$C" add new-hook
runci --staged
check "staged new shell file is syntax-checked"    has "^  FAIL  shell syntax \($((n0+1)) files\)$"
}
case_untracked() {
fresh untracked
printf '#!/bin/bash\nif then\n' >"$C/loose"
runci
check "an untracked shell file is not checked"     has "^  ok    shell syntax \($n0 files\)$"
}

# --- test scripts are discovered ---
case_tests() {
fresh tests
printf '#!/bin/bash\necho boom\nexit 1\n' >"$C/scripts/test-aaa"; chmod +x "$C/scripts/test-aaa"
printf '#!/bin/bash\nexit 1\n' >"$C/scripts/test-bbb"; chmod -x "$C/scripts/test-bbb"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m tests
runci
check "a new test script runs as its own check"    has '^  FAIL  test-aaa$'
check "its output is shown"                        line_after '^  FAIL  test-aaa$' '^        boom$'
check "a test script that is not executable fails" has '^  FAIL  test-bbb \(not executable\)$'
check "saying so"                                  line_after '^  FAIL  test-bbb' 'mode 100644, not 100755'
check "test scripts run in name order"             test "$(printf '%s\n' "$OUT" | sed -n 's/^  [a-zA-Z]*  *\(test-[a-z-]*\).*/\1/p' | tr '\n' ' ')" = "$(cd "$C" && git ls-files -s 'scripts/test-*' | awk '$4 !~ /^scripts\/.*\// { sub(".*/", "", $4); printf "%s ", $4 }')"
check "a failing test script fails the run"        test "$RC" = 1
}
case_testdir() {
fresh testdir
mkdir -p "$C/scripts/test-dir"
printf '#!/bin/bash\necho helper ran\nexit 1\n' >"$C/scripts/test-dir/helper"; chmod +x "$C/scripts/test-dir/helper"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m helper
runci
check "a file under scripts/test-dir/ is not a check" test "$(printf '%s\n' "$OUT" | grep -c 'helper')" = 0
check "and the run passes"                         test "$RC" = 0
}
case_testgone() {
fresh testgone
rm "$C/scripts/test-hooks"
runci
check "a test script missing from the tree fails"  has '^  FAIL  test-hooks \(missing\)$'
}

case_notes() {
fresh notes
printf '#!/bin/bash\necho "  skip  case x (no network)"\necho "other output"\nexit 0\n' >"$C/scripts/test-note"
chmod +x "$C/scripts/test-note"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m note
runci
check "a test script's skip line shows under ok"   line_after '^  ok    test-note$' '^          skip  case x .no network.$'
check "its other output does not"                  test "$(printf '%s\n' "$OUT" | grep -c 'other output')" = 0
}

# --- skipped self-test cases: a script that skips as a whole shows under its ok line, and one line before the
# verdict counts and names every skipped case, on GitHub also as a warning annotation ---
case_skipsum() {
fresh skipsum
printf '#!/bin/bash\necho "  skip  case x (no lockf here (macOS only))"\necho "  skip  case y (no nc)"\nexit 0\n' >"$C/scripts/test-note"
printf '#!/bin/bash\necho "test-whole: skip (no /usr/bin/lockf here; macOS only)"\nexit 0\n' >"$C/scripts/test-whole"
chmod +x "$C/scripts/test-note" "$C/scripts/test-whole"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m skips
GITHUB_ACTIONS=true runci
check "a script that skips as a whole: its line under ok" line_after '^  ok    test-whole$' '^        test-whole: skip [(]no /usr/bin/lockf'
check "one line before the verdict counts and names every skipped case" \
      line_after '^ci: 3 self-test case[(]s[)] skipped, so NOT CHECKED here: test-note: case x; test-note: case y; test-whole: every case$' '^ci: all checks passed$'
check "... and on GitHub as a warning annotation" has '^::warning title=3 self-test case\(s\) skipped::not checked on this runner: test-note: case x; '
check "... and the run still passes"               test "$RC" = 0
}

# --- a check that dies before recording its exit status fails ---
case_died() {
fresh died
cat >"$C/scripts/test-die" <<'EOF'
#!/bin/bash
kill -9 "$PPID"
exit 0
EOF
chmod +x "$C/scripts/test-die"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m die
runci
check "a check with no exit status fails"          has '^  FAIL  test-die$'
check "saying why"                                 line_after '^  FAIL  test-die$' 'without recording an exit status'
check "and the run fails"                          test "$RC" = 1
}

# --- symlinks and deleted files ---
case_symlink() {
fresh symlink
ln -s canon "$C/scripts/canon-link"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m link
runci
check "a symlink to a shell script is not counted" has "^  ok    shell syntax \($n0 files\)$"
}
case_deleted() {
fresh deleted
printf '#!/bin/bash\nif then\n' >"$C/broken.sh"
gitq -C "$C" add broken.sh; rm "$C/broken.sh"
runci --staged
check "staged content of a deleted file is checked" has "^  FAIL  shell syntax \($((n0+1)) files\)$"
}
case_deleted2() {
fresh deleted2
rm "$C/.githooks/pre-commit"
runci
check "a deleted shell file is reported"           has '^  skip  shell checks for \.githooks/pre-commit \(deleted from the working tree\)$'
}

# --- a lock mismatch prints the environment step as skipped ---
case_lockfail() {
fresh lockfail
FAKE_LOCK_FAIL=1; export FAKE_LOCK_FAIL
runci
unset FAKE_LOCK_FAIL
check "the lock check fails"                       has '^  FAIL  uv.lock matches the manifests$'
check "the environment step is skipped with why"   has '^  skip  Python environment \(uv.lock does not match the manifests\)$'
check "so are the Python checks"                   has '^  skip  pytest \(uv.lock does not match the manifests\)$'
check "and the self-tests, which never start"      has '^  skip  lane report self-test \(a fast check failed\)$'
}

# --- the fast checks (lock, ruff, format, ty) finish before anything slower starts, and stop the run ---
case_fastfirst() {
fresh fastfirst
printf '#!/bin/bash\n: >"%s"\n' "$C.lanes.ran" >"$C/scripts/lanes"
printf '#!/bin/bash\n: >"%s"\n' "$C.selftest.ran" >"$C/scripts/test-zz"; chmod +x "$C/scripts/test-zz"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m selftest
FAKE_TY_FAIL=1; export FAKE_TY_FAIL
runci
unset FAKE_TY_FAIL
check "a failed ty fails the run"                  test "$RC" = 1
check "it is named, with its output"               line_after '^  FAIL  ty type check$' '^        error.invalid-assignment.: a typing line$'
check "the lane self-test never starts"            test ! -e "$C.lanes.ran"
check "nor does a test script"                     test ! -e "$C.selftest.ran"
check "nor pytest"                                 test "$(grep -c '^run --locked pytest' "$C.uv.log")" = 0
check "each is a skip line saying why"             has '^  skip  test-zz \(a fast check failed\)$'
check "pytest too"                                 has '^  skip  pytest \(a fast check failed\)$'
check "ruff and its format still ran"              test "$(grep -cE '^run --locked ruff (check|format)' "$C.uv.log")" = 2
check "ending with FAILED"                         has '^ci: FAILED$'
}
case_fastorder() {
fresh fastorder
printf '#!/bin/bash\n[ -e "%s" ] || { echo "started before ty finished"; exit 1; }\n' "$C.ty.done" >"$C/scripts/lanes"
FAKE_TY_DONE="$C.ty.done"; export FAKE_TY_DONE
runci
unset FAKE_TY_DONE
check "a self-test starts only after ty finished"  has '^  ok    lane report self-test$'
check "and the run passes"                         test "$RC" = 0
first_after=$(awk '/^ty finished$/ { t = NR } /^run --locked pytest/ && !p { p = NR } END { print (t && p > t) + 0 }' "$C.uv.log")
check "pytest starts only after ty finished"       test "$first_after" = 1
}

# --- a commit's run (--staged) runs the seconds-long checks and leaves the rest to the landing (ADR 0138) ---
case_commitscope() {
fresh commitscope
printf '#!/bin/bash\n: >"%s"\n' "$C.lanes.ran" >"$C/scripts/lanes"
printf '#!/bin/bash\n: >"%s"\n' "$C.selftest.ran" >"$C/scripts/test-zz"; chmod +x "$C/scripts/test-zz"
gitq -C "$C" add -A; gitq -C "$C" commit -q -m scope
runci --staged
check "a commit's run passes"                      test "$RC" = 0
check "it runs no self-test"                       test ! -e "$C.lanes.ran"
check "and no test script"                         test ! -e "$C.selftest.ran"
check "and no full pytest"                         test "$(grep -cE '^run --locked pytest -q' "$C.uv.log")" = 0
check "it collects the tests"                      test "$(grep -c '^run --locked pytest --collect-only -q' "$C.uv.log")" = 1
check "collection has its line"                    has '^  ok    pytest collection$'
check "ruff, format and ty run"                    test "$(grep -cE '^run --locked (ruff check|ruff format|ty check)' "$C.uv.log")" = 3
check "the canon lint runs"                        has '^  ok    canon registry, lock and ADRs$'
check "and the shell checks"                       has '^  ok    shellcheck$'
check "actionlint is left to the landing"          has '^  skip  actionlint .*\(not run here; the hosted required check runs it\)$'
check "so are the canon and survey self-tests"     test "$(printf '%s\n' "$OUT" | grep -cE '^  skip  (release-rule|practice survey) self-test \(not run here')" = 2
check "the verdict says what was left"             has '^ci: all commit checks passed; [0-9]+ checks NOT RUN here, left to the hosted required check'
check "and is not the whole suite's verdict"       test "$(printf '%s\n' "$OUT" | grep -c '^ci: all checks passed$')" = 0
check "a test script left to the landing says so"  has '^  skip  test-zz \(not run here; the hosted required check runs it\)$'
check "pytest too"                                 has '^  skip  pytest \(not run here; the hosted required check runs it\)$'
check "and the lane self-test"                     has '^  skip  lane report self-test \(not run here; the hosted required check runs it\)$'
check "the staged secret scan runs"                has '^  ok    gitleaks \(staged changes\)$'
}
case_collectfail() {
fresh collectfail
FAKE_COLLECT_FAIL=1; export FAKE_COLLECT_FAIL
runci --staged
unset FAKE_COLLECT_FAIL
check "a test file that fails to import fails at commit" has '^  FAIL  pytest collection$'
check "and the run fails"                          test "$RC" = 1
}
case_stagedlock() {
fresh stagedlock
FAKE_LOCK_FAIL=1; export FAKE_LOCK_FAIL
runci --staged
unset FAKE_LOCK_FAIL
check "a commit with a stale lock names its collection too" has '^  skip  pytest collection \(uv.lock does not match the manifests\)$'
check "and fails"                                  test "$RC" = 1
}
case_stagedtool() {
fresh stagedtool
mkdir -p "$C.tools"; cp "$TMP/tools/uv" "$TMP/tools/shellcheck" "$TMP/tools/gitleaks" "$C.tools/"
TOOLS="$C.tools" runci --staged
check "a missing actionlint fails a commit by name"  has '^  FAIL  actionlint \(not found\)$'
check "and the commit fails"                       test "$RC" = 1
}
case_stagedapart() {
apart_copy stagedapart
runci --staged
check "a project apart is collected at commit"     test "$(grep -cx -- '--directory apart run --locked pytest --collect-only -q -rfEs --no-fold-skipped' "$C.uv.log")" = 1
check "with its line"                              has '^  ok    pytest collection in apart$'
check "its full pytest is left to the landing"     has '^  skip  pytest in apart \(not run here; the hosted required check runs it\)$'
}
# A skip during collection (an import skipped for a missing module, say) is shown at commit, as the full
# pytest shows its skips: pytest --collect-only -q alone prints none, so the run asks for the skip summary.
case_collectskips() {
apart_copy collectskips
FAKE_COLLECT_SKIP=1 runci --staged
check "collection with a skip passes"              test "$RC" = 0
check "the root's collection shows its skip"       line_after '^  ok    pytest collection$' '^        SKIPPED tests/test_opt.py - Skipped: could not import'
check "a project apart's collection shows its skip" line_after '^  ok    pytest collection in apart$' '^        SKIPPED tests/test_opt.py - Skipped: could not import'
check "the root's collection asks for its skips"   test "$(grep -cx -- 'run --locked pytest --collect-only -q -rfEs --no-fold-skipped' "$C.uv.log")" = 1
}
# --part: the hosted workflow's parts (ADR 0144, amendment of 2026-11-14)
case_parts() {
fresh parts
local nodes="$C.nodes" i all="$C.all"
printf '%s\n' tests/test_a.py::test_one tests/test_a.py::test_two tests/test_a.py::test_three tests/test_b.py::test_one \
  'tests/test_c.py::test_p[x::y]' 'tests/test_c.py::test_p[a b]' tests/test_d.py::test_one \
  packages/p/tests/test_e.py::test_one tests/sub/test_f.py::C::test_one \
  "SKIPPED tests/test_g.py - Skipped: could not import 'optional_dep'" >"$nodes"
FAKE_PART_NODES=$nodes; export FAKE_PART_NODES
: >"$all"
for i in 1 2 3; do
  runci --part "$i/3"
  check "part $i of 3 passes"                      test "$RC" = 0
  check "part $i of 3 has its pytest line"         has "^  ok    pytest, part $i of 3\$"
  check "part $i of 3 runs no ruff, ty or other pytest" \
    test "$(grep -cE '^run --locked (ruff|ty)' "$C.uv.log")" = 0
  check "part $i of 3 leaves ruff to part rest"    has '^  skip  ruff lint \(part rest of this run runs it\)$'
  check "part $i of 3 leaves the test scripts to part rest" has '^  skip  test-hooks \(part rest of this run runs it\)$'
  check "part $i of 3 leaves gitleaks to part rest" has '^  skip  gitleaks \(git history\) \(part rest of this run runs it\)$'
  check "part $i of 3 passes its tests as one argument file" \
    test "$(grep -cE '^run --locked pytest -q -rfEs --no-fold-skipped @[^ ]+$' "$C.uv.log")" = 1
  check "part $i of 3 shows its count"           has "^        part $i of 3: [0-9]+ test functions\$"
  check "and pytest's summary line"                has '^        1 passed, 1 skipped$'
  sed -n 's/^arg: //p' "$C.uv.log" >>"$all"; sed -n 's/^arg: //p' "$C.uv.log" >"$C.ids.$i"
done
unset FAKE_PART_NODES
check "the parts run every collected test function once, and the file of a module skipped at collection" \
  test "$(sort "$all" | tr '\n' '|')" = \
       "packages/p/tests/test_e.py::test_one|tests/sub/test_f.py::C::test_one|tests/test_a.py::test_one|tests/test_a.py::test_three|tests/test_a.py::test_two|tests/test_b.py::test_one|tests/test_c.py::test_p|tests/test_d.py::test_one|tests/test_g.py|"
check "a function's parametrized cases go to one part as one name" \
  test "$(grep -c '^tests/test_c.py::' "$all")" = 1
check "one file's functions can fall in different parts" \
  test "$(for p in "$C".ids.*; do grep -l '^tests/test_a.py::' "$p"; done | wc -l | tr -d ' ')" -gt 1
runci --part rest
check "part rest passes"                           test "$RC" = 0
check "part rest runs no root pytest"              test "$(grep -cE '^run --locked pytest' "$C.uv.log")" = 0
check "part rest says the pytest parts run it"     has '^  skip  pytest \(the pytest parts of this run run it\)$'
check "part rest runs ruff and ty"                 test "$(grep -cE '^run --locked (ruff|ty)' "$C.uv.log")" = 3
check "part rest runs the test scripts"            has '^  ok    test-hooks$'
for bad in 0/3 4/3 3 x/y foo; do
  runci --part "$bad"
  check "--part $bad is refused"                   test "$RC" = 1
  check "naming what it takes"                     has '^ci: --part takes rest or I/N'
done
FAKE_COLLECT_FAIL=1; export FAKE_COLLECT_FAIL
runci --part 1/2
unset FAKE_COLLECT_FAIL
check "a failed collection fails the part"         has '^  FAIL  pytest, part 1 of 2$'
check "and the run"                                test "$RC" = 1
}
case_landingall() {
