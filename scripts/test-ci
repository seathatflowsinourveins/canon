check "a landing runs no self-test (ADR 0144)"     test ! -e "$C.lanes.ran"
check "and no full pytest"                         test "$(grep -cE '^run --locked pytest -q' "$C.uv.log")" = 0
check "it collects the tests"                      test "$(grep -c '^run --locked pytest --collect-only -q' "$C.uv.log")" = 1
check "it scans the whole git history"             has '^  ok    gitleaks \(git history\)$'
check "and the working tree"                       has '^  ok    gitleaks \(working tree\)$'
check "not only what is staged"                    test "$(printf '%s\n' "$OUT" | grep -c 'gitleaks (staged changes)')" = 0
check "the rest is left to the hosted run"         has '^  skip  pytest \(not run here; the hosted required check runs it\)$'
check "and its verdict says so"                    has '^ci: all landing checks passed; [0-9]+ checks NOT RUN here, left to the hosted required check'
}
case_landingmac() {
