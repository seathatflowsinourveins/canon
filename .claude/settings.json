{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/canon list)",
      "Bash(scripts/canon lint)",
      "Bash(scripts/canon check)",
      "Bash(./scripts/canon list)",
      "Bash(./scripts/canon lint)",
      "Bash(./scripts/canon check)",
      "Bash(scripts/canon outdated)",
      "Bash(scripts/canon outdated --json)",
      "Bash(./scripts/canon outdated)",
      "Bash(./scripts/canon outdated --json)",
      "Bash(scripts/ci)",
      "Bash(scripts/ci --staged)",
      "Bash(./scripts/ci)",
      "Bash(scripts/test-hooks)",
      "Bash(scripts/test-ci)",
      "Bash(scripts/test-land)",
      "Bash(scripts/test-lanes)",
      "Bash(scripts/test-canon)",
      "Bash(scripts/canon selftest)",
      "Bash(uv lock --check)",
      "Bash(uv run --locked ruff *)",
      "Bash(uv run --locked ty check)",
      "Bash(uv run --locked pytest)",
      "Bash(uv run --locked pytest *)",
      "Bash(scripts/automation status)",
      "Bash(./scripts/automation status)",
      "Bash(scripts/lanes)",
      "Bash(scripts/lanes *)",
      "Bash(./scripts/lanes)",
      "Bash(./scripts/lanes *)",
      "Bash(scripts/bootstrap --check)",
      "Bash(./scripts/bootstrap --check)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:nautilustrader.io)",
      "WebFetch(domain:docs.alpaca.markets)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:artificialanalysis.ai)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:docs.astral.sh)",
      "Bash(scripts/land)",
      "Bash(scripts/land *)",
      "Bash(./scripts/land)",
      "Bash(./scripts/land *)",
      "Bash(scripts/canon resolve *)",
      "Bash(./scripts/canon resolve *)",
      "Bash(uv add *==*)",
      "Bash(mise exec -- uv add *==*)"
    ],
    "ask": [
      "Bash(scripts/canon resolve)",
      "Bash(scripts/canon resolve -*)",
      "Bash(scripts/canon resolve ''*)",
      "Bash(scripts/canon resolve \"\"*)",
      "Bash(scripts/canon resolve \"$*)",
      "Bash(scripts/canon resolve $*)",
      "Bash(./scripts/canon resolve)",
      "Bash(./scripts/canon resolve -*)",
      "Bash(./scripts/canon resolve ''*)",
      "Bash(./scripts/canon resolve \"\"*)",
      "Bash(./scripts/canon resolve \"$*)",
      "Bash(./scripts/canon resolve $*)",
      "Bash(uv add *>=*)",
      "Bash(uv add *<*)",
      "Bash(uv add *~=*)",
      "Bash(uv add *!=*)",
      "Bash(uv add *@*)",
      "Bash(uv add *://*)",
      "Bash(uv add *--upgrade*)",
      "Bash(uv add *-U*)",
      "Bash(uv add *-P*)",
      "Bash(uv add *-index*)",
      "Bash(uv add *-i *)",
      "Bash(uv add *--find-links*)",
      "Bash(uv add *-f *)",
      "Bash(uv add *--project*)",
      "Bash(uv add *--directory*)",
      "Bash(uv add *-r *)",
      "Bash(uv add *--requirements*)",
      "Bash(mise exec -- uv add *>=*)",
      "Bash(mise exec -- uv add *<*)",
      "Bash(mise exec -- uv add *~=*)",
      "Bash(mise exec -- uv add *!=*)",
      "Bash(mise exec -- uv add *@*)",
      "Bash(mise exec -- uv add *://*)",
      "Bash(mise exec -- uv add *--upgrade*)",
      "Bash(mise exec -- uv add *-U*)",
      "Bash(mise exec -- uv add *-P*)",
      "Bash(mise exec -- uv add *-index*)",
      "Bash(mise exec -- uv add *-i *)",
      "Bash(mise exec -- uv add *--find-links*)",
      "Bash(mise exec -- uv add *-f *)",
      "Bash(mise exec -- uv add *--project*)",
      "Bash(mise exec -- uv add *--directory*)",
      "Bash(mise exec -- uv add *-r *)",
      "Bash(mise exec -- uv add *--requirements*)",
      "Bash(uv lock *--upgrade*)",
      "Bash(uv lock *-U*)",
      "Bash(mise exec -- uv lock *--upgrade*)",
      "Bash(mise exec -- uv lock *-U*)",
      "Bash(uv sync *)",
      "Bash(mise exec -- uv sync *)",
      "Bash(scripts/bootstrap --install *)",
      "Bash(./scripts/bootstrap --install *)",
      "Bash(scripts/automation install)",
      "Bash(./scripts/automation install)",
      "Bash(scripts/automation uninstall)",
      "Bash(./scripts/automation uninstall)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/canon-lint.sh",
            "args": [],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/py-lint.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-brief.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/canon-watch.sh",
            "args": [],
            "async": true
          }
        ]
      }
    ]
  }
}
