+"""Supplemental offline tests for AlpacaExecutionClient: cancel-all on PENDING_CANCEL orders and orders
+whose client order IDs NautilusTrader's ClientOrderId refuses (empty, whitespace or non-ASCII).
+
+Contract: `nautilus_trader.live.clients.ExecutionClient` and `nautilus_trader.model.ClientOrderId`,
+NautilusTrader v2.0.0rc8 (ADR 0036, ADR 0042).
+"""
+
+import asyncio
+from collections.abc import Awaitable
+from collections.abc import Callable
+from types import SimpleNamespace
+from typing import Any
+from typing import cast
+
+import canon_alpaca.data
+import canon_alpaca.execution
+import canon_alpaca.providers
+import pytest
+from canon_alpaca.constants import ENV_API_KEY
+from canon_alpaca.constants import ENV_SECRET_KEY
+from canon_alpaca.execution import AlpacaExecutionClient
+from canon_alpaca.execution import AlpacaExecutionClientConfig
+from canon_alpaca.execution import holdable_client_order_id
+from canon_alpaca.factories import AlpacaDataClientFactory
+from canon_alpaca.factories import AlpacaExecutionClientFactory
+from nautilus_trader.common import Environment
+from nautilus_trader.common import logging_sync_to_disk
+from nautilus_trader.config import DataClientConfig
+from nautilus_trader.config import InstrumentProviderConfig
+from nautilus_trader.config import LiveNodeConfig
+from nautilus_trader.live import LiveNode
+from nautilus_trader.model import ClientOrderId
+from nautilus_trader.model import InstrumentId
+from nautilus_trader.model import OrderSide
+from nautilus_trader.model import OrderStatus
+from nautilus_trader.model import Price
+from nautilus_trader.model import Quantity
+from nautilus_trader.model import TimeInForce
+from nautilus_trader.model import TraderId
+from nautilus_trader.model import VenueOrderId
+from nautilus_trader.trading import Strategy
+
+AAPL = InstrumentId.from_str("AAPL.ALPACA")
+TRADER = TraderId("TESTER-001")
+PLACEHOLDER = "offline-placeholder"
+
+BUILT_NODES: list[LiveNode] = []
+
+
+@pytest.fixture(autouse=True)
+def dispose_nodes():
+    yield
+    while BUILT_NODES:
+        BUILT_NODES.pop().dispose()
+
+
+@pytest.fixture
+def venue(monkeypatch, alpaca) -> SimpleNamespace:
+    monkeypatch.setenv(ENV_API_KEY, PLACEHOLDER)
+    monkeypatch.setenv(ENV_SECRET_KEY, PLACEHOLDER)
+    trading = alpaca.OrdersClient()
+    stream = alpaca.TradeStream()
+    trading.stream = stream
+    ns = SimpleNamespace(
+        trading=trading,
+        stream=stream,
+        historical=alpaca.HistoricalClient(),
+        quotes=alpaca.Stream(),
+    )
+    monkeypatch.setattr(canon_alpaca.providers, "TradingClient", lambda **_: trading)
+    monkeypatch.setattr(canon_alpaca.execution, "TradingClient", lambda **_: trading)
+    monkeypatch.setattr(canon_alpaca.execution, "TradingStream", lambda **_: stream)
+    monkeypatch.setattr(canon_alpaca.data, "StockHistoricalDataClient", lambda **_: ns.historical)
+    monkeypatch.setattr(canon_alpaca.data, "StockDataStream", lambda **_: ns.quotes)
+    return ns
+
+
+class ProbeStrategy(Strategy):
+    def __init__(self) -> None:
+        super().__init__()
+        self.idle = False
+        self.started = False
+        self.events: list = []
+        self.placed: ClientOrderId | None = None
+
+    def on_start(self) -> None:
+        self.started = True
+        if not self.idle:
+            self.shutdown_system("probe started")
+
+    def submit_limit_buy(self, price: str = "140.00") -> ClientOrderId:
+        order = self.order_factory.limit(
+            AAPL,
+            OrderSide.BUY,
+            Quantity.from_int(1),
+            Price.from_str(price),
+            time_in_force=TimeInForce.GTC,
+        )
+        self.placed = order.client_order_id
+        self.submit_order(order)
+        return order.client_order_id
+
+    def on_order_event(self, event) -> None:
+        name = type(event).__name__
+        if name != "OrderInitialized":
+            self.events.append(event)
+
+    def names(self) -> list[str]:
+        return [type(e).__name__ for e in self.events]
+
+
+def build_node(
+    strategy: ProbeStrategy,
+    exec_factory: type[AlpacaExecutionClientFactory] = AlpacaExecutionClientFactory,
+) -> LiveNode:
+    provider = InstrumentProviderConfig(load_ids=[str(AAPL)])
+    node = LiveNode.build(
+        "CANON-ALPACA-EXEC-EDGE",
+        LiveNodeConfig(
+            environment=Environment.SANDBOX,
+            trader_id=TRADER,
+            timeout_connection_secs=2,
+            timeout_reconciliation_secs=5,
+            timeout_disconnection_secs=5,
+            delay_post_stop_secs=0,
+            data_clients={"ALPACA": DataClientConfig(instrument_provider=provider)},
+            exec_clients={"ALPACA": AlpacaExecutionClientConfig(instrument_provider=provider)},
+        ),
+        data_factories={"ALPACA": AlpacaDataClientFactory},
+        exec_factories={"ALPACA": exec_factory},
+    )
+    node.add_strategy(strategy)
+    BUILT_NODES.append(node)
+    return node
+
+
+def run(node: LiveNode) -> None:
+    async def hosted() -> None:
+        async with asyncio.timeout(15):
+            await node.run_async()
+
+    asyncio.run(hosted())
+
+
+def run_with_client(
+    body: Callable[[AlpacaExecutionClient], Awaitable[None]],
+    strategy: ProbeStrategy | None = None,
+) -> None:
+    clients: list[AlpacaExecutionClient] = []
+    if strategy is None:
+        strategy = ProbeStrategy()
+        strategy.idle = True
+
+    class Capturing(AlpacaExecutionClientFactory):
+        @staticmethod
+        def create(**kwargs):
+            client = AlpacaExecutionClientFactory.create(**kwargs)
+            clients.append(client)
+            return client
+
+    node = build_node(strategy, exec_factory=Capturing)
+
+    async def main() -> None:
+        async with asyncio.timeout(15):
+            task = asyncio.ensure_future(node.run_async())
+            try:
+                while not (
+                    task.done() or (clients and clients[0].is_connected and strategy.started)
+                ):
+                    await asyncio.sleep(0.005)
+                if task.done():
+                    task.result()
+                await body(clients[0])
+            finally:
+                if not task.done():
+                    node.handle().stop()
+                await task
+
+    asyncio.run(main())
+
+
+async def until_idle(client: AlpacaExecutionClient, venue: SimpleNamespace) -> None:
+    async with asyncio.timeout(10):
+        while (
+            client._rest_lock.locked()
+            or not venue.stream._messages.empty()
+            or not client._updates.empty()
+            or not client._idle.is_set()
+        ):
+            await asyncio.sleep(0.01)
+        for _ in range(20):
+            await asyncio.sleep(0.01)
+
+
+def logged(capfd) -> str:
+    logging_sync_to_disk()
+    captured = capfd.readouterr()
+    return captured.out + captured.err
+
+
+def test_holdable_client_order_id_matches_nautilus_client_order_id() -> None:
+    assert holdable_client_order_id(None) is None
+    assert holdable_client_order_id("") is None
+    assert holdable_client_order_id("   ") is None
+    assert holdable_client_order_id("\u8ba2\u5355-1") is None
+    assert holdable_client_order_id("alpaca-made-1") == ClientOrderId("alpaca-made-1")
+
+
+def test_multiple_closed_unholdable_orders_log_warnings_without_blocking_open_orders(
+    venue, alpaca, capfd
+) -> None:
+    empty_first = alpaca.alpaca_order(
+        id="11111111-1111-4111-8111-111111111111",
+        client_order_id="",
+        status="canceled",
+    )
+    empty_second = alpaca.alpaca_order(
+        id="22222222-2222-4222-8222-222222222222",
+        client_order_id="",
+        status="expired",
+    )
+    whitespace = alpaca.alpaca_order(
+        id="33333333-3333-4333-8333-333333333333",
+        client_order_id="   ",
+        status="canceled",
+    )
+    non_ascii = alpaca.alpaca_order(
+        id="44444444-4444-4444-8444-444444444444",
+        client_order_id="\u8ba2\u5355-1",
+        status="rejected",
+    )
+    valid_open = alpaca.alpaca_order(
+        id="55555555-5555-4555-8555-555555555555",
+        client_order_id="valid-open-1",
+        status="new",
+    )
+    venue.trading.orders = [empty_first, empty_second, whitespace, non_ascii, valid_open]
+    node = build_node(ProbeStrategy())
+
+    run(node)
+
+    (working,) = node.cache.orders_open()
+    assert working.client_order_id == ClientOrderId("valid-open-1")
+    text = logged(capfd)
+    for skipped in (empty_first, empty_second, whitespace, non_ascii):
+        assert f"Alpaca order {skipped['id']} (AAPL, {skipped['status']}) is not reported" in text
+
+
+@pytest.mark.parametrize("client_order_id", ["   ", "\u8ba2\u5355-1"])
+def test_open_order_with_whitespace_or_non_ascii_client_id_fails_startup_by_name(
+    venue, alpaca, capfd, client_order_id
+) -> None:
+    bad = alpaca.alpaca_order(
+        id="66666666-6666-4666-8666-666666666666",
+        client_order_id=client_order_id,
+        status="new",
+    )
+    venue.trading.orders = [bad]
+    node = build_node(ProbeStrategy())
+
+    with pytest.raises(RuntimeError, match="Failed to get mass status"):
+        run(node)
+
+    assert f"Alpaca order {bad['id']} (AAPL) is open with invalid string" in logged(capfd)
+
+
+@pytest.mark.parametrize("original_client_id", ["", "\u8ba2\u5355-1"])
+def test_multi_hop_replacement_of_unholdable_original_keeps_earliest_holdable_id(
+    venue, alpaca, original_client_id
+) -> None:
+    original = alpaca.alpaca_order(
+        id="71111111-1111-4111-8111-111111111111",
+        client_order_id=original_client_id,
+        status="replaced",
+        replaced_by="72222222-2222-4222-8222-222222222222",
+    )
+    first_replacement = alpaca.alpaca_order(
+        id="72222222-2222-4222-8222-222222222222",
+        client_order_id="alpaca-made-1",
+        status="replaced",
+        replaces=original["id"],
+        replaced_by="73333333-3333-4333-8333-333333333333",
+    )
+    second_replacement = alpaca.alpaca_order(
+        id="73333333-3333-4333-8333-333333333333",
+        client_order_id="alpaca-made-2",
+        status="new",
+        limit_price="152.00",
+        replaces=first_replacement["id"],
+    )
+    venue.trading.orders = [original, first_replacement, second_replacement]
+    reports: list = []
+
+    async def body(client: AlpacaExecutionClient) -> None:
+        # Clear cache and query open_only=True so `_root_id` must fetch replaced links by ID, and
+        # check single-order status report from the original venue ID too.
+        client._replacements.clear()
+        open_reports = await client._generate_order_status_reports(
+            cast("Any", SimpleNamespace(open_only=True, instrument_id=None, start=None, end=None))
+        )
+        single = await client._generate_order_status_report(
+            cast(
+                "Any",
+                SimpleNamespace(venue_order_id=VenueOrderId(original["id"]), client_order_id=None),
+            )
+        )
+        reports.append((open_reports, single, dict(client._replacements)))
+
+    strategy = ProbeStrategy()
+    strategy.idle = True
+    run_with_client(body, strategy)
+
+    ((open_reports, single, cached),) = reports
+    assert [(r.venue_order_id.value, r.client_order_id) for r in open_reports] == [
+        (second_replacement["id"], ClientOrderId("alpaca-made-1"))
+    ]
+    assert single is not None
+    assert single.venue_order_id == VenueOrderId(second_replacement["id"])
+    assert single.client_order_id == ClientOrderId("alpaca-made-1")
+    assert "" not in cached
+
+
+@pytest.mark.parametrize("client_order_id", ["", "\u8ba2\u5355-1"])
+def test_stream_update_for_external_unholdable_order_is_dropped_without_error(
+    venue, alpaca, capfd, client_order_id
+) -> None:
+    other = alpaca.alpaca_order(
+        id="81111111-1111-4111-8111-111111111111",
+        client_order_id=client_order_id,
+        status="new",
+    )
+
+    async def body(client: AlpacaExecutionClient) -> None:
+        venue.stream.send({"event": "new", "order": other, "timestamp": other["updated_at"]})
+        await until_idle(client, venue)
+
+    run_with_client(body)
+
+    text = logged(capfd)
+    assert f"for order {other['id']} (AAPL), which this node does not hold" in text
+    assert "Alpaca trade update new" not in text or "failed:" not in text
+
+
+def test_cancel_all_on_pending_cancel_order_already_pending_at_alpaca_emits_no_rejection(
+    venue, alpaca
+) -> None:
+    # If an earlier cancel actually reached Alpaca (leaving the order `pending_cancel` at Alpaca too)
+    # and a later cancel-all sends a second cancel that Alpaca answers 422, `_cancel_refused` looks up
+    # the order, sees `pending_cancel`, and emits no `OrderCancelRejected`.
+    venue.trading.script = "accept"
+    strategy = ProbeStrategy()
+    strategy.idle = True
+
+    async def body(client: AlpacaExecutionClient) -> None:
+        cid = strategy.submit_limit_buy("140.00")
+        async with asyncio.timeout(10):
+            while "OrderAccepted" not in strategy.names():
+                await asyncio.sleep(0.01)
+        await until_idle(client, venue)
+        # First cancel reaches Alpaca and moves Alpaca's order to `pending_cancel`, with no `canceled`
+        # stream update yet.
+        venue.trading.cancel_error = alpaca.api_error(422, 42210000, "order is not cancelable")
+        venue.trading.took_before_error = True
+        strategy.cancel_order(cid)
+        await until_idle(client, venue)
+        cached_order = client.cache.order(cid)
+        assert cached_order is not None and cached_order.status == OrderStatus.PENDING_CANCEL
+        # Second cancel via cancel-all meets 422 (`pending_cancel` at Alpaca) and must not reject.
+        venue.trading.took_before_error = False
+        venue.trading.refuse_cancel = lambda _: alpaca.api_error(
+            422, 42210000, "order is not cancelable"
+        )
+        venue.trading.cancel_error = None
+        await client._cancel_all_orders(
+            cast("Any", SimpleNamespace(instrument_id=AAPL, order_side=None))
+        )
+        await until_idle(client, venue)
+
+    run_with_client(body, strategy)
+
+    assert len(venue.trading.cancels) == 2
+    assert "OrderCancelRejected" not in strategy.names()
