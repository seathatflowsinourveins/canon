+def test_rank_normalizes_aware_non_utc_trial_starts_to_utc() -> None:
+    pattern = [0.01, -0.004, 0.006, 0.002, -0.003, 0.008, 0.004, -0.001, 0.005, 0.003]
+    days = [str(DAY_0 + n * DAY_NS) for n in range(10)]
+    pick_returns = {day: value for day, value in zip(days, pattern, strict=True)}
+    second_returns = {day: value * 0.4 - 0.001 for day, value in zip(days, pattern, strict=True)}
+
+    tokyo = timezone(timedelta(hours=9))
+    new_york = timezone(timedelta(hours=-4))
+    first_dt = datetime(2026, 6, 1, 18, 0, 0, tzinfo=tokyo)  # 09:00 UTC
+    second_dt = datetime(2026, 6, 1, 6, 30, 0, tzinfo=new_york)  # 10:30 UTC
+
+    study = optuna.create_study(direction="maximize")
+    study.set_user_attr("samples", [{"number": 0, "start": DAY_0, "end": DAY_0 + 9 * DAY_NS}])
+    for key, series, start_dt in (
+        ("pick", pick_returns, first_dt),
+        ("second", second_returns, second_dt),
+    ):
+        frozen = optuna.trial.create_trial(
+            state=TrialState.COMPLETE,
+            value=0.0,
+            user_attrs={
+                "config_key": key,
+                "sample": 0,
+                "run_config_id": key,
+                "backtest_start": DAY_0,
+                "backtest_end": DAY_0 + 9 * DAY_NS,
+                "returns_series": series,
+                "session_days": days,
+                "data_digest": {f"bars-{key}": "digest"},
+                OUTCOME: TRADED,
+            },
+        )
+        frozen.datetime_start = start_dt
+        study.add_trial(frozen)
+
+    report = rank(study)
+
+    assert report.first_recorded == "2026-06-01T09:00:00+00:00"
+    assert report.last_recorded == "2026-06-01T10:30:00+00:00"
+
