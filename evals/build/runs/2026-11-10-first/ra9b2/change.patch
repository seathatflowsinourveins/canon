+def test_two_processes_racing_on_one_study_name_raise_duplicated_not_schema_error(
+    tmp_path: Path,
+) -> None:
+    script = (
+        "import sys, time\n"
+        "from pathlib import Path\n"
+        "from optuna.exceptions import DuplicatedStudyError\n"
+        "from canon_trading.ledger import create_ledger_study\n"
+        "ready_dir, db_path, me, peer = (\n"
+        "    Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3], sys.argv[4]\n"
+        ")\n"
+        "(ready_dir / f'ready-{me}').touch()\n"
+        "deadline = time.monotonic() + 60\n"
+        "while not (ready_dir / f'ready-{peer}').exists() and time.monotonic() < deadline:\n"
+        "    time.sleep(0.001)\n"
+        "try:\n"
+        "    with create_ledger_study('same', start='2025-03-10', end='2025-05-04', path=db_path):\n"
+        "        pass\n"
+        "    print('created')\n"
+        "except DuplicatedStudyError:\n"
+        "    print('duplicated')\n"
+    )
+    ready_dir = tmp_path / "sync"
+    ready_dir.mkdir()
+    db_path = tmp_path / "nested" / "ledger" / "trials.db"
+    procs = [
+        subprocess.Popen(
+            [sys.executable, "-c", script, str(ready_dir), str(db_path), f"p{n}", f"p{1 - n}"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for n in range(2)
+    ]
+    outcomes = [proc.communicate(timeout=120) for proc in procs]
+    assert [proc.returncode for proc in procs] == [0, 0], [err for _, err in outcomes]
+    assert sorted(out.strip() for out, _ in outcomes) == ["created", "duplicated"]
+    assert optuna.get_all_study_names(f"sqlite:///{db_path}") == ["same"]
+
