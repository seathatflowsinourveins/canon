+
+@pytest.mark.parametrize("bad_value", [float("inf"), float("-inf"), None])
+def test_returns_matrix_refuses_infinities_and_missing_objects_directly(bad_value: object) -> None:
+    index = pd.to_datetime([DAY_0 + n * DAY_NS for n in range(3)], unit="ns", utc=True)
+    first = pd.Series([0.01, 0.0, 0.02], index=index, name="ok")
+    second = pd.Series([0.01, bad_value, 0.02], index=index, name="bad", dtype=object)
+
+    with pytest.raises(ReturnsRejected, match="bad: a return that is not finite") as rejected:
+        returns_matrix([first, second])
+
+    assert rejected.value.names == ("bad",)
+
+
+def test_returns_matrix_names_every_series_with_a_non_finite_return() -> None:
+    index = pd.to_datetime([DAY_0 + n * DAY_NS for n in range(3)], unit="ns", utc=True)
+    a = pd.Series([float("nan"), 0.01, 0.02], index=index, name="a")
+    b = pd.Series([0.01, 0.0, 0.02], index=index, name="b")
+    c = pd.Series([0.01, 0.02, float("-inf")], index=index, name="c")
+
+    with pytest.raises(ReturnsRejected) as rejected:
+        returns_matrix([a, b, c])
+
+    assert rejected.value.names == ("a", "c")
+    message = str(rejected.value)
+    assert "a: a return that is not finite" in message
+    assert "c: a return that is not finite" in message
+    assert "b:" not in message
