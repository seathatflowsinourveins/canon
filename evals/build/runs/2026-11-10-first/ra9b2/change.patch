+def test_gitignore_anchors_ledger_only_at_the_repository_root() -> None:
+    root = Path(canon_trading.ledger.__file__).resolve().parents[2]
+
+    def ignored(rel_path: str) -> bool:
+        return (
+            subprocess.run(
+                ["git", "check-ignore", "-q", rel_path], cwd=root, check=False
+            ).returncode
+            == 0
+        )
+
+    assert ignored("ledger/trials.db")
+    assert ignored("ledger/trials.db.lock")
+    assert not ignored("packages/canon-alpaca/ledger/notes.py")
+    assert not ignored("docs/ledger/summary.md")
