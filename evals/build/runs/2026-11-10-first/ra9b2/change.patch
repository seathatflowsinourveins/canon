+def test_a_rejected_series_fails_the_trial_and_stops_the_gate(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    with ExitStack() as stack:
+        study = stack.enter_context(
+            create_ledger_study(
+                "rejected-gate",
+                start="2025-03-10",
+                end="2025-05-04",
+                path=tmp_path / "trials.db",
+            ),
+        )
+        first_cfg = MaCrossConfig(
+            bar_type=BAR_TYPE, trade_size=TRADE_SIZE, fast_period=3, slow_period=8
+        )
+        second_cfg = MaCrossConfig(
+            bar_type=BAR_TYPE, trade_size=TRADE_SIZE, fast_period=2, slow_period=5
+        )
+        record_trial(study, tmp_path / "catalog", [second_cfg], starting_balances=BALANCES)
+        real = canon_trading.ledger.session_days
+        monkeypatch.setattr(canon_trading.ledger, "session_days", lambda bars: real(bars)[:-5])
+        rejected_run = record_trial(
+            study, tmp_path / "catalog", [first_cfg], starting_balances=BALANCES
+        )
+
+        trial = study.trials[rejected_run.number]
+        assert (trial.state, trial.user_attrs[OUTCOME], trial.value) == (
+            TrialState.FAIL,
+            TRADED,
+            None,
+        )
+        with pytest.raises(
+            RankingStopped, match=rf"{rejected_run.config_key}: return .* on .*, a day with no bar"
+        ):
+            rank(study)
+
