+@contextmanager
+def _ledger_creation_lock(path: Path) -> Generator[None]:
+    """An exclusive `fcntl.flock` on `<ledger>.lock` beside `path`, released on exit (module header)."""
+    with Path(f"{path}.lock").open("a+b") as lock_file:
+        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
