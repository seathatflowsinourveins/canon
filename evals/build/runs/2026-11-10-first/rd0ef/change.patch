+def test_single_order_status_report_skips_closed_unholdable_and_raises_on_open(
+    venue, alpaca
+) -> None:
+    closed_raw = alpaca.alpaca_order(
+        id="4d4e5f6a-7b8c-4d9e-8f0a-1b2c3d4e5f60",
+        client_order_id="",
+        status="canceled",
+    )
+    open_raw = alpaca.alpaca_order(
+        id="5e5f6a7b-8c9d-4e0f-9a1b-2c3d4e5f6071",
+        client_order_id="\u8ba2\u5355-1",
+        status="new",
+    )
+    results: list[object] = []
+
+    async def body(client) -> None:
+        # Set after start-up so reconciliation does not fail on `open_raw` first.
+        venue.trading.orders = [closed_raw, open_raw]
+        results.append(
+            await client._generate_order_status_report(
+                SimpleNamespace(venue_order_id=VenueOrderId(closed_raw["id"]), client_order_id=None)
+            )
+        )
+        with pytest.raises(ValueError, match=f"Alpaca order {open_raw['id']} \\(AAPL\\) is open"):
+            await client._generate_order_status_report(
+                SimpleNamespace(venue_order_id=VenueOrderId(open_raw["id"]), client_order_id=None)
+            )
+
+    run_with_client(body)
+
+    assert results == [None]
