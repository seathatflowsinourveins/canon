+def test_cancel_all_absorbs_422_when_an_earlier_cancel_had_already_reached_alpaca(
+    venue, alpaca
+) -> None:
+    venue.trading.script = "accept"
+    strategy = IdleStrategy()
+    strategy.submit_limit = True
+
+    async def body(client) -> None:
+        async with asyncio.timeout(10):
+            while "OrderAccepted" not in strategy.names():
+                await asyncio.sleep(0.01)
+        await until_idle(client, venue)
+        assert strategy.client_order_id is not None
+        # First cancel reaches Alpaca (`pending_cancel` on Alpaca) before the connection drops.
+        venue.trading.took_before_error = True
+        venue.trading.cancel_error = ConnectionError("read timed out")
+        strategy.cancel_order(strategy.client_order_id)
+        await until_idle(client, venue)
+        venue.trading.took_before_error = False
+        venue.trading.cancel_error = None
+        # Alpaca now refuses a repeat cancel with 422 while holding the order as `pending_cancel`.
+        refusal = alpaca.api_error(422, 42210000, "order is already pending cancel")
+        venue.trading.refuse_cancel = lambda order: (
+            refusal if order["status"] == "pending_cancel" else None
+        )
+        await client._cancel_all_orders(SimpleNamespace(instrument_id=AAPL, order_side=None))
+        await until_idle(client, venue)
+        placed = next(iter(venue.trading._placed.values()))
+        placed.update(status="canceled", canceled_at=datetime.now(UTC).isoformat())
+        venue.stream.send(
+            {"event": "canceled", "order": placed, "timestamp": placed["canceled_at"]}
+        )
+        await until_idle(client, venue)
+
+    run_with_client(body, strategy)
+
+    assert len(venue.trading.cancels) == 2
+    assert "OrderCancelRejected" not in strategy.names()
+    assert strategy.names()[-1] == "OrderCanceled"
