new file mode 100644
index 0000000..384e764
--- /dev/null
+++ b/packages/canon-alpaca/tests/test_client_order_ids.py
@@ -0,0 +1,117 @@
+"""Client order IDs NautilusTrader cannot hold, in the execution client's `replaces` trace.
+
+Alpaca can list an order whose client order ID `ClientOrderId` refuses (empty, all whitespace, not ASCII),
+as an order made outside the node can carry. `test_execution_client.py` covers such orders in start-up
+reconciliation through a node; these cover the trace itself, for the trade update path and for the chains
+a node run does not set up: the trace is called on the client class with a stand-in for the client's
+state (its cache, its replacement map and alpaca-py's order lookup), and no node.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from types import SimpleNamespace
+
+import pytest
+from alpaca.trading.models import Order as AlpacaOrder
+from canon_alpaca.execution import AlpacaExecutionClient
+from canon_alpaca.execution import holdable_client_order_id
+from nautilus_trader.model import ClientOrderId
+
+NODE_ID = "node-order-1"
+
+
+class Tracer:
+    """The state `AlpacaExecutionClient._node_order_id` and `_root_id` read, and nothing else."""
+
+    _node_order_id = AlpacaExecutionClient._node_order_id
+    _root_id = AlpacaExecutionClient._root_id
+
+    def __init__(self, held: set[str], alpaca_orders: list[dict]) -> None:
+        self._replacements: dict[str, ClientOrderId] = {}
+        self._log = logging.getLogger("tracer")
+        self._orders = {order["id"]: AlpacaOrder(**order) for order in alpaca_orders}
+        self.lookups: list[str] = []
+        self.cache = SimpleNamespace(order=lambda cid: object() if cid.value in held else None)
+
+    def _venue(self) -> SimpleNamespace:
+        return SimpleNamespace(get_order_by_id=self._get_order_by_id)
+
+    def _get_order_by_id(self, order_id: str) -> AlpacaOrder:
+        self.lookups.append(order_id)
+        return self._orders[order_id]
+
+    async def _call(self, fn, *args):
+        return fn(*args)
+
+
+def chain(alpaca, *client_order_ids: str) -> list[dict]:
+    """Alpaca orders each replacing the one before, with these client order IDs, oldest first."""
+    orders: list[dict] = []
+    for n, client_order_id in enumerate(client_order_ids):
+        orders.append(
+            alpaca.alpaca_order(
+                id=f"00000000-0000-4000-8000-{n:012d}",
+                client_order_id=client_order_id,
+                status="new" if n == len(client_order_ids) - 1 else "replaced",
+                replaces=orders[-1]["id"] if orders else None,
+            )
+        )
+    return orders
+
+
+@pytest.mark.parametrize("value", ["", "   ", "订单-1"])
+def test_an_id_client_order_id_refuses_is_not_holdable(value) -> None:
+    with pytest.raises(ValueError):
+        ClientOrderId(value)
+    assert holdable_client_order_id(value) is None
+
+
+def test_an_id_the_node_could_send_is_holdable() -> None:
+    assert holdable_client_order_id(NODE_ID) == ClientOrderId(NODE_ID)
+
+
+@pytest.mark.parametrize("value", ["", "订单-1"])
+def test_a_trade_update_for_an_unholdable_order_is_not_the_nodes(alpaca, value) -> None:
+    # Before the fix `ClientOrderId("")` raised here, and the update failed instead of being dropped.
+    (order,) = chain(alpaca, value)
+    tracer = Tracer(held={NODE_ID}, alpaca_orders=[order])
+
+    found = asyncio.run(tracer._node_order_id(AlpacaOrder(**order)))
+
+    assert found is None
+    assert tracer._replacements == {}
+
+
+def test_an_unholdable_order_in_the_chain_is_passed_over_to_the_nodes(alpaca) -> None:
+    # The node's order, replaced by one whose ID NautilusTrader cannot hold, replaced again: the last is
+    # still the node's order.
+    orders = chain(alpaca, NODE_ID, "", "alpaca-made-2")
+    tracer = Tracer(held={NODE_ID}, alpaca_orders=orders)
+
+    found = asyncio.run(tracer._node_order_id(AlpacaOrder(**orders[-1])))
+
+    assert found == ClientOrderId(NODE_ID)
+    assert tracer._replacements == {"alpaca-made-2": ClientOrderId(NODE_ID)}
+
+
+def test_an_unholdable_replacement_of_the_nodes_order_is_traced_and_not_cached(alpaca) -> None:
+    # Its ID need not name one order, so nothing is cached under it: a second trace walks again.
+    orders = chain(alpaca, NODE_ID, "")
+    tracer = Tracer(held={NODE_ID}, alpaca_orders=orders)
+
+    for _ in range(2):
+        found = asyncio.run(tracer._node_order_id(AlpacaOrder(**orders[-1])))
+        assert found == ClientOrderId(NODE_ID)
+
+    assert tracer._replacements == {}
+    assert tracer.lookups == [orders[0]["id"]] * 2
+
+
+def test_a_chain_with_no_holdable_id_has_no_root(alpaca) -> None:
+    orders = chain(alpaca, "订单-1", "")
+    tracer = Tracer(held=set(), alpaca_orders=orders)
+
+    assert asyncio.run(tracer._root_id(AlpacaOrder(**orders[-1]))) is None
+    assert tracer._replacements == {}
