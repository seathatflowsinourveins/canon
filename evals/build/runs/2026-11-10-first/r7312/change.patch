+"""Additional offline replace races through the real node (ADR 0036).
+
+Contract: Alpaca's `Order.replaces`/`replaced_by` and `TradeUpdate` (alpaca-py 0.45.0), and
+NautilusTrader v2.0.0rc8's queued order events. Reuse the existing node harness and paper API stand-ins.
+"""
+
+import uuid
+from types import SimpleNamespace
+
+import pytest
+from nautilus_trader.model import OrderStatus
+from nautilus_trader.model import Price
+from nautilus_trader.model import Quantity
+
+from . import test_execution_client as harness
+from .test_execution_client import modifier
+from .test_execution_client import placed_order
+from .test_execution_client import run_modify
+from .test_execution_client import until_idle
+
+dispose_nodes = harness.dispose_nodes
+venue = harness.venue
+
+
+@pytest.mark.parametrize("event", ["canceled", "expired"])
+@pytest.mark.parametrize("cold", [False, True])
+def test_predecessor_close_cannot_end_the_current_order(venue, event, cold) -> None:
+    venue.trading.script = "accept"
+    strategy = modifier()
+
+    async def close(client) -> None:
+        if cold:
+            # A fresh adapter has only the native order cache to tell which ID took over.
+            client._current.clear()
+            client._superseded.clear()
+            client._replacements.clear()
+        old = placed_order(venue)
+        venue.trading.update(old["id"], event, status=event)
+        await until_idle(client, venue)
+        cached = client.cache.order(strategy.client_order_id)
+        assert cached.status == OrderStatus.ACCEPTED
+        assert cached.venue_order_id.value == placed_order(venue, 1)["id"]
+
+    run_modify(venue, strategy, lambda: "OrderUpdated" in strategy.names(), close)
+
+    assert "OrderCanceled" not in strategy.names()
+    assert "OrderExpired" not in strategy.names()
+
+
+def test_partial_fill_confirms_terms_and_late_replaced_does_not_repeat_them(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def fill(client) -> None:
+        old, new = placed_order(venue), placed_order(venue, 1)
+        venue.trading.update(
+            new["id"], "partial_fill", 3, status="partially_filled", filled_qty="3"
+        )
+        await until_idle(client, venue)
+        assert strategy.names().count("OrderFilled") == 1
+        assert strategy.names().index("OrderUpdated") < strategy.names().index("OrderFilled")
+        venue.trading.confirm_replace(old["id"])
+        await until_idle(client, venue)
+        venue.trading.update(new["id"], "fill", 2, status="filled", filled_qty="5")
+        await until_idle(client, venue)
+        cached = client.cache.order(strategy.client_order_id)
+        assert cached.status == OrderStatus.FILLED
+        assert cached.quantity == Quantity.from_int(5)
+        assert not client._modifying and not client._answers
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), fill)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    assert strategy.names().count("OrderFilled") == 2
+
+
+def test_successor_replaced_before_its_predecessor_does_not_move_the_order_back(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+
+    async def reorder(client) -> None:
+        old, middle = placed_order(venue), placed_order(venue, 1)
+        newest = {
+            **middle,
+            "id": str(uuid.uuid4()),
+            "client_order_id": str(uuid.uuid4()),
+            "replaces": middle["id"],
+            "qty": "7",
+            "limit_price": "152.00",
+        }
+        venue.trading._placed[newest["id"]] = newest
+        middle.update(status="replaced", replaced_by=newest["id"])
+        venue.trading.confirm_replace(middle["id"])
+        await until_idle(client, venue)
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.confirm_replace(middle["id"])
+        await until_idle(client, venue)
+        cached = client.cache.order(strategy.client_order_id)
+        assert cached.venue_order_id.value == newest["id"]
+        assert cached.quantity == Quantity.from_int(7)
+        assert cached.price == Price.from_str("152.0000")
+        assert not client._modifying and not client._answers
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), reorder)
+
+    assert strategy.names().count("OrderUpdated") == 1
+
+
+def test_new_modify_with_the_same_terms_is_not_the_earlier_invocations_retry(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+
+    async def second(client) -> None:
+        cached = client.cache.order(strategy.client_order_id)
+        await client._modify_order(
+            SimpleNamespace(
+                client_order_id=strategy.client_order_id,
+                venue_order_id=cached.venue_order_id,
+                quantity=None,
+                price=Price.from_str("150.50"),
+                trigger_price=None,
+            )
+        )
+        await until_idle(client, venue)
+        assert strategy.names().count("OrderModifyRejected") == 1
+        venue.trading.confirm_replace(placed_order(venue)["id"])
+        await until_idle(client, venue)
+        assert not client._modifying and not client._answers
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), second)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    assert strategy.names().count("OrderModifyRejected") == 1
+
+
+@pytest.mark.parametrize("status", ["canceled", "expired"])
+def test_closed_replacement_is_reported_when_confirmation_was_missed(venue, status) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+    reports = []
+
+    async def reconcile(client) -> None:
+        new = placed_order(venue, 1)
+        new["status"] = status
+        venue.trading.orders = list(venue.trading._placed.values())
+        client._replacements.clear()
+        window = SimpleNamespace(open_only=False, instrument_id=None, start=None, end=None)
+        reports.extend(await client._generate_order_status_reports(window))
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), reconcile)
+
+    assert [(r.venue_order_id.value, r.client_order_id, r.order_status) for r in reports] == [
+        (
+            placed_order(venue, 1)["id"],
+            strategy.client_order_id,
+            getattr(OrderStatus, status.upper()),
+        )
+    ]
