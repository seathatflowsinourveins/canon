@@ -0,0 +1,105 @@
+"""Client order IDs Alpaca accepts and NautilusTrader's `ClientOrderId` cannot hold, offline.
+
+An order made outside the node (Alpaca's dashboard, another program) can carry an empty or non-ASCII client
+order ID; `ClientOrderId` refuses it with a `ValueError`. These tests pin what `held_client_order_id`,
+`order_status_report` and the `replaces` trace in `AlpacaExecutionClient._root_id` do with one. The
+node-level cases (start-up skipping a closed one, failing on an open one by name, a replacement reported
+under its own ID) are in `test_execution_client.py`.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+from alpaca.trading.models import Order as AlpacaOrder
+from canon_alpaca.execution import AlpacaExecutionClient
+from canon_alpaca.execution import held_client_order_id
+from canon_alpaca.execution import order_status_report
+from nautilus_trader.model import ClientOrderId
+
+UNHOLDABLE = ["", "   ", "订单-1"]
+
+
+@pytest.mark.parametrize("value", UNHOLDABLE)
+def test_an_id_client_order_id_refuses_is_not_held(value) -> None:
+    with pytest.raises(ValueError):
+        ClientOrderId(value)  # the upstream behaviour `held_client_order_id` rests on
+    assert held_client_order_id(value) is None
+
+
+def test_an_ascii_id_is_held_as_it_is() -> None:
+    assert held_client_order_id("alpaca-made-1") == ClientOrderId("alpaca-made-1")
+
+
+@pytest.mark.parametrize("value", UNHOLDABLE)
+def test_a_closed_order_with_an_unholdable_id_is_not_reported(alpaca, value) -> None:
+    order = AlpacaOrder(**alpaca.alpaca_order(client_order_id=value, status="canceled"))
+    assert order_status_report(order, 0) is None
+
+
+@pytest.mark.parametrize("value", UNHOLDABLE)
+def test_an_open_order_with_an_unholdable_id_raises_naming_it(alpaca, value) -> None:
+    order = AlpacaOrder(**alpaca.alpaca_order(client_order_id=value, status="new"))
+    with pytest.raises(ValueError, match=rf"Alpaca order {order.id} \(AAPL\) is open with invalid"):
+        order_status_report(order, 0)
+
+
+def test_an_open_order_with_an_unholdable_id_is_reported_under_a_name_traced_for_it(alpaca) -> None:
+    order = AlpacaOrder(**alpaca.alpaca_order(client_order_id="", status="new"))
+    report = order_status_report(order, 0, client_order_id=ClientOrderId("node-1"))
+    assert report is not None and report.client_order_id == ClientOrderId("node-1")
+
+
+def tracer(held: set[str], orders: dict[str, AlpacaOrder]) -> SimpleNamespace:
+    """The parts of the client `_root_id` reads: its cache of traces, the node's cache, Alpaca."""
+
+    async def call(fn, *args):
+        return fn(*args)
+
+    return SimpleNamespace(
+        _replacements={},
+        cache=SimpleNamespace(order=lambda cid: object() if cid.value in held else None),
+        _venue=lambda: SimpleNamespace(get_order_by_id=lambda oid: orders[oid]),
+        _call=call,
+        _log=SimpleNamespace(warning=lambda text: None),
+    )
+
+
+def chain(alpaca, *client_order_ids: str) -> list[AlpacaOrder]:
+    """Orders each replacing the one before, oldest first, with these client order IDs."""
+    ids = [f"00000000-0000-4000-8000-00000000000{i}" for i in range(len(client_order_ids))]
+    return [
+        AlpacaOrder(
+            **alpaca.alpaca_order(
+                id=ids[i],
+                client_order_id=cid,
+                status="new" if i == len(ids) - 1 else "replaced",
+                replaces=ids[i - 1] if i else None,
+                replaced_by=ids[i + 1] if i < len(ids) - 1 else None,
+            )
+        )
+        for i, cid in enumerate(client_order_ids)
+    ]
+
+
+def test_trace_passes_over_an_unholdable_link_to_the_nodes_order(alpaca) -> None:
+    # The node's order replaced outside the node with an ID it cannot hold, then replaced again by Alpaca.
+    orders = chain(alpaca, "node-1", "订单-1", "alpaca-made-1")
+    client = tracer({"node-1"}, {str(o.id): o for o in orders})
+
+    root = asyncio.run(AlpacaExecutionClient._root_id(client, orders[-1]))  # ty: ignore[invalid-argument-type]
+
+    assert root == ClientOrderId("node-1")
+    assert client._replacements == {"alpaca-made-1": ClientOrderId("node-1")}
+
+
+def test_trace_with_no_holdable_id_is_none_and_not_cached(alpaca) -> None:
+    orders = chain(alpaca, "", "订单-2")
+    client = tracer(set(), {str(o.id): o for o in orders})
+
+    root = asyncio.run(AlpacaExecutionClient._root_id(client, orders[-1]))  # ty: ignore[invalid-argument-type]
+
+    assert root is None
+    assert client._replacements == {}
