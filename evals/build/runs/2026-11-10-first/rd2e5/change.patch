@@ -0,0 +1,43 @@
+"""A keyed record with no `sample` attribute at all, written as `record_trial` leaves a record otherwise.
+
+No test here runs a backtest, opens a network connection or reads a credential. The ranking reads such a
+record as on the current sample only if it shows no run (`canon_trading.ranking`'s module header).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import optuna
+import pytest
+from optuna.trial import TrialState
+
+from canon_trading.ledger import DAY_NS
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+DAY_0 = 1_741_651_200 * 1_000_000_000  # 2025-03-11T00:00:00Z
+
+
+def test_a_record_that_ran_with_no_sample_attribute_stops_named(tmp_path: Path) -> None:
+    with create_ledger_study(
+        "unsampled", start=DAY_0, end=DAY_0 + 4 * DAY_NS, path=tmp_path / "trials.db"
+    ) as study:
+        trial = study.ask()
+        trial.set_user_attr("config_key", "pick")
+        days = [str(DAY_0 + n * DAY_NS) for n in range(5)]
+        trial.set_user_attr("returns_series", dict.fromkeys(days, 0.01))
+        trial.set_user_attr("session_days", days)
+        trial.set_user_attr(OUTCOME, TRADED)
+        study.tell(trial, state=TrialState.COMPLETE, values=0.0)
+
+        with pytest.raises(RankingStopped, match=rf"#{trial.number} \(traded\) ran with no sample"):
+            rank(study)
