+"""Offline LiveNode tests for out-of-order, late and repeated Alpaca replace updates.
+
+Contract: `nautilus_trader.live.clients.ExecutionClient` (NautilusTrader v2.0.0rc8) and Alpaca's "Replace
+Order by ID" (`TradingClient.replace_order_by_id`, alpaca-py 0.45.0; ADR 0036). These complement
+`test_execution_client.py` with arrival orders not already covered there: stream rejection before HTTP 422,
+identical-term second modifies against an answered replacement, replacement cancel/expiry or partial fill
+ahead of `replaced`, late expiry on a superseded order, and missed-`replaced` reconciliation of a closed
+replacement.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from typing import TYPE_CHECKING
+
+import canon_alpaca.data
+import canon_alpaca.execution
+import canon_alpaca.providers
+import pytest
+from canon_alpaca.constants import ENV_API_KEY
+from canon_alpaca.constants import ENV_SECRET_KEY
+from canon_alpaca.execution import AlpacaExecutionClient
+from canon_alpaca.execution import AlpacaExecutionClientConfig
+from canon_alpaca.factories import AlpacaDataClientFactory
+from canon_alpaca.factories import AlpacaExecutionClientFactory
+from nautilus_trader.common import Environment
+from nautilus_trader.config import DataClientConfig
+from nautilus_trader.config import InstrumentProviderConfig
+from nautilus_trader.config import LiveNodeConfig
+from nautilus_trader.live import LiveNode
+from nautilus_trader.model import InstrumentId
+from nautilus_trader.model import OrderSide
+from nautilus_trader.model import OrderStatus
+from nautilus_trader.model import Price
+from nautilus_trader.model import Quantity
+from nautilus_trader.model import TraderId
+from nautilus_trader.trading import Strategy
+
+if TYPE_CHECKING:
+    from collections.abc import Awaitable
+    from collections.abc import Callable
+
+AAPL = InstrumentId.from_str("AAPL.ALPACA")
+TRADER = TraderId("TESTER-001")
+PLACEHOLDER = "offline-placeholder"
+BUILT_NODES: list[LiveNode] = []
+
+
+@pytest.fixture(autouse=True)
+def dispose_nodes():
+    yield
+    while BUILT_NODES:
+        BUILT_NODES.pop().dispose()
+
+
+@pytest.fixture
+def venue(monkeypatch, alpaca) -> SimpleNamespace:
+    monkeypatch.setenv(ENV_API_KEY, PLACEHOLDER)
+    monkeypatch.setenv(ENV_SECRET_KEY, PLACEHOLDER)
+    trading = alpaca.OrdersClient()
+    stream = alpaca.TradeStream()
+    trading.stream = stream
+    ns = SimpleNamespace(
+        trading=trading,
+        stream=stream,
+        historical=alpaca.HistoricalClient(),
+        quotes=alpaca.Stream(),
+    )
+    monkeypatch.setattr(canon_alpaca.providers, "TradingClient", lambda **_kw: trading)
+    monkeypatch.setattr(canon_alpaca.execution, "TradingClient", lambda **_kw: trading)
+    monkeypatch.setattr(canon_alpaca.execution, "TradingStream", lambda **_kw: stream)
+    monkeypatch.setattr(canon_alpaca.data, "StockHistoricalDataClient", lambda **_kw: ns.historical)
+    monkeypatch.setattr(canon_alpaca.data, "StockDataStream", lambda **_kw: ns.quotes)
+    return ns
+
+
+class ModifyProbe(Strategy):
+    def __init__(self) -> None:
+        super().__init__()
+        self.events: list = []
+        self.client_order_id = None
+        self.started = False
+        self.modify_qty: int | None = None
+        self.modify_price: str | None = "150.50"
+
+    def on_start(self) -> None:
+        self.started = True
+        self.subscribe_quotes(AAPL)
+
+    def on_quote(self, quote) -> None:
+        if self.client_order_id is not None:
+            return
+        order = self.order_factory.limit(
+            AAPL, OrderSide.BUY, Quantity.from_int(2), Price.from_str("150.00")
+        )
+        self.client_order_id = order.client_order_id
+        self.submit_order(order)
+
+    def on_order_event(self, event) -> None:
+        name = type(event).__name__
+        if name == "OrderInitialized":
+            return
+        self.events.append(event)
+        if name == "OrderAccepted" and self.names().count("OrderAccepted") == 1:
+            assert self.client_order_id is not None
+            self.modify_order(
+                self.client_order_id,
+                quantity=Quantity.from_int(self.modify_qty)
+                if self.modify_qty is not None
+                else None,
+                price=Price.from_str(self.modify_price) if self.modify_price is not None else None,
+            )
+
+    def names(self) -> list[str]:
+        return [type(e).__name__ for e in self.events]
+
+
+async def until_idle(client: AlpacaExecutionClient, venue: SimpleNamespace) -> None:
+    async with asyncio.timeout(10):
+        while (
+            client._rest_lock.locked()
+            or not venue.stream._messages.empty()
+            or not client._updates.empty()
+            or client._applying
+        ):
+            await asyncio.sleep(0.01)
+        for _ in range(20):
+            await asyncio.sleep(0.01)
+
+
+def run_probe(
+    venue: SimpleNamespace,
+    strategy: ModifyProbe,
+    done: Callable[[], bool],
+    then: Callable[[AlpacaExecutionClient], Awaitable[None]] | None = None,
+) -> None:
+    clients: list[AlpacaExecutionClient] = []
+
+    class Capturing(AlpacaExecutionClientFactory):
+        @staticmethod
+        def create(**kwargs):
+            client = AlpacaExecutionClientFactory.create(**kwargs)
+            clients.append(client)
+            return client
+
+    provider = InstrumentProviderConfig(load_ids=[str(AAPL)])
+    node = LiveNode.build(
+        "CANON-ALPACA-REPLACE-ORDERING",
+        LiveNodeConfig(
+            environment=Environment.SANDBOX,
+            trader_id=TRADER,
+            timeout_connection_secs=2,
+            timeout_reconciliation_secs=5,
+            timeout_disconnection_secs=5,
+            delay_post_stop_secs=0,
+            data_clients={"ALPACA": DataClientConfig(instrument_provider=provider)},
+            exec_clients={"ALPACA": AlpacaExecutionClientConfig(instrument_provider=provider)},
+        ),
+        data_factories={"ALPACA": AlpacaDataClientFactory},
+        exec_factories={"ALPACA": Capturing},
+    )
+    node.add_strategy(strategy)
+    BUILT_NODES.append(node)
+
+    async def main() -> None:
+        async with asyncio.timeout(15):
+            task = asyncio.ensure_future(node.run_async())
+            try:
+                while not (
+                    task.done() or (clients and clients[0].is_connected and strategy.started)
+                ):
+                    await asyncio.sleep(0.005)
+                if task.done():
+                    task.result()
+                async with asyncio.timeout(10):
+                    while not done():
+                        await asyncio.sleep(0.01)
+                await until_idle(clients[0], venue)
+                if then is not None:
+                    await then(clients[0])
+                    await until_idle(clients[0], venue)
+            finally:
+                if not task.done():
+                    node.handle().stop()
+                await task
+
+    asyncio.run(main())
+
+
+def placed(venue: SimpleNamespace, index: int) -> dict:
+    return list(venue.trading._placed.values())[index]
+
+
+def test_stream_replace_rejected_before_delayed_http_refusal_is_one_rejection(
+    venue, alpaca
+) -> None:
+    venue.trading.script = "accept"
+    strategy = ModifyProbe()
+
+    original_replace = venue.trading.replace_order_by_id
+
+    def slow_refusal(order_id: object, order_data: object = None):
+        venue.trading.replace_requests.append((str(order_id), order_data))
+        old = venue.trading._placed[str(order_id)]
+        venue.trading._send("order_replace_rejected", old)
+        import time
+
+        time.sleep(0.2)
+        raise alpaca.api_error(422, 42210000, "replace rejected after stream update")
+
+    venue.trading.replace_order_by_id = slow_refusal
+    try:
+        run_probe(venue, strategy, lambda: "OrderModifyRejected" in strategy.names())
+    finally:
+        venue.trading.replace_order_by_id = original_replace
+
+    assert strategy.names().count("OrderModifyRejected") == 1, strategy.names()
+
+
+def test_second_modify_with_identical_terms_after_answered_first_is_still_rejected(venue) -> None:
+    # Even when a second modify asks for the exact same terms as the already-answered first modify,
+    # its 422 "order already replaced" is a second modify's refusal, not alpaca-py's retry.
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = ModifyProbe()
+    strategy.modify_qty = 5
+    strategy.modify_price = "150.50"
+
+    async def repeat_same_terms(client: AlpacaExecutionClient) -> None:
+        assert strategy.client_order_id is not None
+        cached = client.cache.order(strategy.client_order_id)
+        assert cached is not None
+        command = SimpleNamespace(
+            client_order_id=strategy.client_order_id,
+            venue_order_id=cached.venue_order_id,
+            quantity=Quantity.from_int(5),
+            price=Price.from_str("150.50"),
+            trigger_price=None,
+        )
+        await client._modify_order(command)  # ty: ignore[invalid-argument-type]
+        async with asyncio.timeout(10):
+            while "OrderModifyRejected" not in strategy.names():
+                await asyncio.sleep(0.01)
+
+    run_probe(venue, strategy, lambda: bool(venue.trading.replace_requests), repeat_same_terms)
+
+    assert strategy.names().count("OrderModifyRejected") == 1
+
+
+@pytest.mark.parametrize(
+    ("terminal_event", "expected_event"),
+    [("canceled", "OrderCanceled"), ("expired", "OrderExpired")],
+)
+def test_replacement_close_before_replaced_adopts_first_and_ignores_late_replaced(
+    venue, terminal_event: str, expected_event: str
+) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = ModifyProbe()
+
+    async def close_then_replaced(_client: AlpacaExecutionClient) -> None:
+        old, new = placed(venue, 0), placed(venue, 1)
+        venue.trading.update(new["id"], terminal_event, status=terminal_event)
+        venue.trading.confirm_replace(old["id"])
+        async with asyncio.timeout(10):
+            while expected_event not in strategy.names():
+                await asyncio.sleep(0.01)
+
+    run_probe(venue, strategy, lambda: bool(venue.trading.replace_requests), close_then_replaced)
