+        client._replacements.clear()
+        window = SimpleNamespace(open_only=False, instrument_id=None, start=None, end=None)
+        reports.extend(await client._generate_order_status_reports(window))  # ty: ignore[invalid-argument-type]
+
+    run_probe(venue, strategy, lambda: bool(venue.trading.replace_requests), reconcile)
+
+    mine = [r for r in reports if r.client_order_id == strategy.client_order_id]
