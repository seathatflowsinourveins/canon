@@ -0,0 +1,155 @@
+"""Additional boundaries of the trial ledger's ADR 0035 and ADR 0041 contracts.
+
+The real Optuna store and NautilusTrader replay are used; no credentials or network are involved.
+A small engine cache exercises eviction without a large dataset. Synthetic completed records check
+that a later valid record cannot legitimise a run with no valid sample attribution.
+"""
+
+from __future__ import annotations
+
+from functools import partial
+from typing import TYPE_CHECKING
+
+import optuna
+import pytest
+from nautilus_trader.config import BacktestEngineConfig
+from nautilus_trader.config import CacheConfig
+from nautilus_trader.model import BarType
+from nautilus_trader.model import Quantity
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+import canon_trading.backtest
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import SAMPLES
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import record_trial
+from canon_trading.ma_cross import MaCrossConfig
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+DAY = 86_400 * 10**9
+FIRST = 1_741_651_200 * 10**9  # 2025-03-11T00:00:00Z
+
+
+def _finished(study: optuna.Study, key: str, sample: object) -> int:
+    trial = study.ask()
+    trial.set_user_attr("config_key", key)
+    if sample is not None:
+        trial.set_user_attr("sample", sample)
+    values = [0.01, -0.004, 0.006, 0.002] if key == "a" else [-0.004, 0.002, 0.003, 0.001]
+    days = [FIRST + i * DAY for i in range(4)]
+    trial.set_user_attr("backtest_start", days[0])
+    trial.set_user_attr("backtest_end", days[-1])
+    trial.set_user_attr("returns_series", {str(d): v for d, v in zip(days, values, strict=True)})
+    trial.set_user_attr("session_days", [str(d) for d in days])
+    trial.set_user_attr("data_digest", {"bars": "same bars"})
+    trial.set_user_attr(OUTCOME, TRADED)
+    study.tell(trial, 0.0)
+    return trial.number
+
+
+@pytest.mark.parametrize("sample", [None, False, 0.0, "0", [], {}, 7])
+def test_a_later_record_cannot_repair_a_completed_runs_invalid_sample(
+    tmp_path: Path, sample: object
+) -> None:
+    with create_ledger_study(
+        "invalid", start=FIRST, end=FIRST + 3 * DAY, path=tmp_path / "trials.db"
+    ) as study:
+        number = _finished(study, "a", sample)
+        _finished(study, "a", 0)
+        _finished(study, "b", 0)
+
+        with pytest.raises(RankingStopped) as stopped:
+            rank(study)
+
+        assert f"#{number} (traded) ran with sample {sample!r}, not a sample number" in str(
+            stopped.value
+        )
+
+
+@pytest.mark.parametrize("existing", ["attributes", "trials", "malformed sample", "direction"])
+def test_creation_never_reinitialises_a_study_with_existing_contents(
+    tmp_path: Path, existing: str
+) -> None:
+    path = tmp_path / "trials.db"
+    storage = optuna.storages.RDBStorage(f"sqlite:///{path}")
+    try:
+        study = optuna.create_study(
+            study_name="existing",
+            storage=storage,
+            direction="minimize" if existing == "direction" else "maximize",
+        )
+        if existing == "attributes":
+            study.set_user_attr("owner", "another writer")
+        elif existing == "trials":
+            study.tell(study.ask(), state=TrialState.FAIL)
+        elif existing == "malformed sample":
+            study.set_user_attr(SAMPLES, [])
+        before = study.user_attrs
+        trials = study.trials
+
+        with (
+            pytest.raises(DuplicatedStudyError),
+            create_ledger_study("existing", start=FIRST, end=FIRST + DAY, path=path),
+        ):
+            pytest.fail("an existing study was reinitialised")
+
+        assert study.user_attrs == before
+        assert study.trials == trials
+    finally:
+        storage.remove_session()
+        storage.engine.dispose()
+
+
+def test_cache_eviction_fails_the_trial_instead_of_hashing_another_read(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    monkeypatch.setattr(
+        canon_trading.backtest,
+        "BacktestEngineConfig",
+        partial(BacktestEngineConfig, cache=CacheConfig(bar_capacity=3)),
+    )
+    strategy = MaCrossConfig(
+        bar_type=BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL"),
+        trade_size=Quantity.from_int(10),
+        fast_period=3,
+        slow_period=8,
+    )
+    with create_ledger_study(
+        "eviction", start="2025-03-10", end="2025-05-04", path=tmp_path / "trials.db"
+    ) as study:
+        with pytest.raises(RuntimeError, match="cache holds 3 bars and the run replayed 40"):
+            record_trial(study, tmp_path / "catalog", [strategy], starting_balances=["100000 USD"])
+
+        [trial] = study.trials
+        assert (trial.state, trial.user_attrs[OUTCOME]) == (TrialState.FAIL, FAILED)
+        assert "data_digest" not in trial.user_attrs
+
+
+def test_an_empty_catalog_names_the_whole_missing_sample_before_asking_for_a_trial(
+    alpaca_bars: AlpacaBars, tmp_path: Path
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog", bars=False)
+    strategy = MaCrossConfig(
+        bar_type=BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL"),
+        trade_size=Quantity.from_int(10),
+    )
+    with create_ledger_study(
+        "empty", start="2025-03-10", end="2025-05-04", path=tmp_path / "trials.db"
+    ) as study:
+        with pytest.raises(
+            LookupError,
+            match="does not cover the sample: missing 2025-03-10.*2025-05-04",
+        ):
+            record_trial(study, tmp_path / "catalog", [strategy], starting_balances=["100000 USD"])
+
+        assert study.trials == []
