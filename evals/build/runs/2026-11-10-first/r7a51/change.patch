+def test_returns_matrix_refuses_infinities_and_names_every_offending_series() -> None:
+    index = pd.to_datetime([DAY_0 + n * DAY_NS for n in range(3)], unit="ns", utc=True)
+    first = pd.Series([0.01, float("inf"), 0.02], index=index, name="a")
+    second = pd.Series([0.01, 0.0, 0.02], index=index, name="b")
+    third = pd.Series([float("-inf"), 0.0, 0.02], index=index, name="c")
