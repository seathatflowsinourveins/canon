+def test_gitignore_ignores_root_ledger_files_only() -> None:
+    root = Path(canon_trading.ledger.__file__).resolve().parents[2]
+
+    def ignored(rel: str) -> bool:
+        return (
+            subprocess.run(["git", "check-ignore", "-q", rel], cwd=root, check=False).returncode
+            == 0
+        )
+
+    assert ignored("ledger/trials.db")
+    assert ignored("ledger/trials.db.lock")
+    assert not ignored("tests/ledger/helper.py")
+    assert not ignored("packages/canon-alpaca/ledger/helper.py")
