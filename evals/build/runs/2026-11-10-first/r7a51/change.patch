+            self.returns_series = returns_series
+
+        def __getattr__(self, name: str) -> object:
+            return getattr(self._inner, name)
+
+    with ExitStack() as stack:
+        study = stack.enter_context(
+            create_ledger_study("bad-series", start=START, end=END, path=tmp_path / "trials.db")
+        )
+        for bad_returns in (
+            {DAY_0 + 3_600 * 10**9: 0.01, DAY_0 + DAY_NS: 0.02},
+            {DAY_0: 0.01, DAY_0 + 2 * DAY_NS: 0.02},
+        ):
+
+            def patched(
+                run_cfg: BacktestRunConfig,
+                built: Sequence[MaCross],
+                *,
+                _r: dict[int, float] = bad_returns,
+            ) -> BacktestRun:
+                ran = real_run(run_cfg, built)
+                return BacktestRun(
+                    result=cast("BacktestResult", _PatchedResult(ran.result, _r)),
+                    orders=ran.orders,
+                    positions=ran.positions,
+                    position_snapshots=ran.position_snapshots,
+                    account=ran.account,
+                )
+
+            monkeypatch.setattr(canon_trading.ledger, "run_backtest_config", patched)
+            record_trial(study, tmp_path / "catalog", [cfg], starting_balances=BALANCES)
+
+        assert [(t.state, t.user_attrs[OUTCOME], t.value) for t in study.trials] == [
+            (TrialState.FAIL, TRADED, None),
+            (TrialState.FAIL, TRADED, None),
+        ]
+
+
+def test_modules_import_cleanly_in_either_order() -> None:
+    for first, second in (
+        ("canon_trading.returns_matrix", "canon_trading.ledger"),
+        ("canon_trading.ledger", "canon_trading.returns_matrix"),
+    ):
+        proc = subprocess.run(
+            [sys.executable, "-c", f"import {first}, {second}"],
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        assert proc.returncode == 0, proc.stderr
+
