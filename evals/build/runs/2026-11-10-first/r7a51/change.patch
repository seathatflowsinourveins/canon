+def test_concurrent_creation_with_missing_parent_and_same_study_name(tmp_path: Path) -> None:
+    """Two processes racing on a missing parent folder and an identical study name: one creates it,
+    the other raises `DuplicatedStudyError`, and neither fails on SQLite schema or Alembic setup."""
+    script = (
+        "import sys, time\n"
+        "from pathlib import Path\n"
+        "from optuna.exceptions import DuplicatedStudyError\n"
+        "from canon_trading.ledger import create_ledger_study\n"
+        "sync, ledger, me, peer = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3], sys.argv[4]\n"
+        "(sync / f'ready-{me}').touch()\n"
+        "deadline = time.monotonic() + 60\n"
+        "while not (sync / f'ready-{peer}').exists() and time.monotonic() < deadline:\n"
+        "    time.sleep(0.001)\n"
+        "try:\n"
+        "    with create_ledger_study('shared', start='2025-03-10', end='2025-05-04', path=ledger):\n"
+        "        print('created')\n"
+        "except DuplicatedStudyError:\n"
+        "    print('duplicated')\n"
+    )
+    sync = tmp_path / "sync"
+    sync.mkdir()
+    ledger = tmp_path / "missing" / "nested" / "trials.db"
+    procs = [
+        subprocess.Popen(
+            [sys.executable, "-c", script, str(sync), str(ledger), f"p{n}", f"p{1 - n}"],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for n in range(2)
+    ]
+    outcomes = [(p.communicate(timeout=120), p.returncode) for p in procs]
+    assert [code for _, code in outcomes] == [0, 0], [out[1] for out, _ in outcomes]
+    assert sorted(out[0].strip() for out, _ in outcomes) == ["created", "duplicated"]
+    assert optuna.get_all_study_names(f"sqlite:///{ledger}") == ["shared"]
+
