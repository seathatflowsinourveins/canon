diff --git a/tests/test_ledger_creation_lock.py b/tests/test_ledger_creation_lock.py
new file mode 100644
index 0000000..483cf24
--- /dev/null
+++ b/tests/test_ledger_creation_lock.py
@@ -0,0 +1,70 @@
+"""The ledger's creation lock and the matrix's refusal of returns that are not finite.
+
+What the module headers of `canon_trading.ledger` and `canon_trading.returns_matrix` state, beyond the
+cases the other test files cover.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from typing import TYPE_CHECKING
+
+import pandas as pd
+import pytest
+
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import open_study
+from canon_trading.returns_matrix import DAY_NS
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import returns_matrix
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+DAY_0 = 20_000 * DAY_NS
+
+
+def test_creating_a_ledger_leaves_its_lock_file_beside_it(tmp_path: Path) -> None:
+    path = tmp_path / "trials.db"
+    with create_ledger_study("s", start="2025-03-10", end="2025-05-04", path=path):
+        pass
+
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["trials.db", "trials.db.lock"]
+
+
+def test_opening_a_ledger_with_no_lock_file_creates_none(tmp_path: Path) -> None:
+    path = tmp_path / "trials.db"
+    with create_ledger_study("s", start="2025-03-10", end="2025-05-04", path=path):
+        pass
+    (tmp_path / "trials.db.lock").unlink()
+
+    with open_study("s", path) as study:
+        assert study.study_name == "s"
+
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["trials.db"]
+
+
+def test_opening_a_file_that_is_not_a_ledger_creates_no_lock_file(tmp_path: Path) -> None:
+    path = tmp_path / "trials.db"
+    sqlite3.connect(path).close()
+
+    with pytest.raises(LookupError), open_study("s", path):
+        pass
+
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["trials.db"]
+
+
+def test_an_infinite_return_is_refused_and_every_such_series_named() -> None:
+    """skfolio's `Portfolio` raises its own `ValueError` on an infinity; the matrix names the trials."""
+    index = pd.to_datetime([DAY_0 + n * DAY_NS for n in range(3)], unit="ns", utc=True)
+    series = [
+        pd.Series([0.01, float("inf"), 0.02], index=index, name="a"),
+        pd.Series([0.01, 0.0, 0.02], index=index, name="b"),
+        pd.Series([float("-inf"), 0.0, float("nan")], index=index, name="c"),
+    ]
+
+    with pytest.raises(ReturnsRejected, match="a: a return that is not finite") as rejected:
+        returns_matrix(series)
+
+    assert rejected.value.names == ("a", "c")
+    assert "c: a return that is not finite, -inf" in str(rejected.value)
