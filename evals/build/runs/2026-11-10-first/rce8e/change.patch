diff --git a/tests/test_returns_matrix_nonfinite.py b/tests/test_returns_matrix_nonfinite.py
new file mode 100644
index 0000000..4945489
--- /dev/null
+++ b/tests/test_returns_matrix_nonfinite.py
@@ -0,0 +1,28 @@
+"""Direct matrix input obeys ADR 0031 before skfolio 1.12.8 can replace NaN returns with zero.
+
+Contract: `canon_trading.returns_matrix.returns_matrix` names every rejected series, including direct
+callers that did not use `daily_series`. No backtest, network connection or credential is needed.
+"""
+
+import pandas as pd
+import pytest
+
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import returns_matrix
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), float("-inf")])
+def test_every_series_with_a_nonfinite_return_is_named(value: float) -> None:
+    index = pd.to_datetime(["2025-03-10", "2025-03-11", "2025-03-12"], utc=True)
+    series = [
+        pd.Series([0.01, value, 0.02], index=index, name="first"),
+        pd.Series([0.01, 0.0, 0.02], index=index, name="finite"),
+        pd.Series([value, 0.0, 0.02], index=index, name="last"),
+    ]
+
+    with pytest.raises(ReturnsRejected) as rejected:
+        returns_matrix(series)
+
+    assert rejected.value.names == ("first", "last")
+    assert "first: a return that is not finite" in str(rejected.value)
+    assert "last: a return that is not finite" in str(rejected.value)
