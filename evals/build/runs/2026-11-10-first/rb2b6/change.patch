+"""Alpaca client order IDs that NautilusTrader's `ClientOrderId` cannot hold, offline.
+
+NautilusTrader's identifiers refuse an empty or non-ASCII string with `ValueError`; Alpaca takes any client
+order ID up to 128 characters, so an order made outside the node can carry one. These tests cover the
+conversion and the trace of a trade update's order back to the node's; start-up reconciliation of such
+orders is covered in `test_execution_client.py`.
+"""
+
+import asyncio
+from functools import partial
+from types import SimpleNamespace
+from typing import Any
+from typing import cast
+
+import pytest
+from alpaca.trading.models import Order as AlpacaOrder
+from canon_alpaca.execution import AlpacaExecutionClient
+from canon_alpaca.execution import holdable_client_order_id
+from nautilus_trader.model import ClientOrderId
+
+UNHOLDABLE = ["", "订单-1"]
+
+
+@pytest.mark.parametrize("value", UNHOLDABLE)
+def test_an_id_nautilus_refuses_is_not_held(value) -> None:
+    with pytest.raises(ValueError, match="invalid string"):
+        ClientOrderId(value)  # the upstream behaviour the helper relies on
+    assert holdable_client_order_id(value) is None
+
+
+def test_an_ascii_id_is_held() -> None:
+    assert holdable_client_order_id("placed-elsewhere") == ClientOrderId("placed-elsewhere")
+
+
+def tracer(held: set[str]) -> AlpacaExecutionClient:
+    """The parts of the client `_node_order_id` and `_root_id` read, with no venue call allowed."""
+
+    def no_call(*_: object) -> None:
+        raise AssertionError("the trace should not need Alpaca")
+
+    client: Any = SimpleNamespace(
+        _replacements={},
+        cache=SimpleNamespace(order=lambda cid: object() if cid.value in held else None),
+        _log=SimpleNamespace(warning=lambda _: None),
+        _call=no_call,
+        _venue=no_call,
+    )
+    client._root_id = partial(AlpacaExecutionClient._root_id, client)
+    client._node_order_id = partial(AlpacaExecutionClient._node_order_id, client)
+    return cast("AlpacaExecutionClient", client)
+
+
+@pytest.mark.parametrize("value", UNHOLDABLE)
+def test_trade_update_order_with_an_unholdable_id_is_none_of_the_nodes(alpaca, value) -> None:
+    order = AlpacaOrder(**alpaca.alpaca_order(client_order_id=value, status="new"))
+    client = tracer(held=set())
+
+    found = asyncio.run(client._node_order_id(order))
+
+    assert found is None
+    assert client._replacements == {}  # nothing cached under an ID the node cannot hold
+
+
+def test_replacement_traces_to_the_nodes_order_past_nothing_unholdable(alpaca) -> None:
+    original = AlpacaOrder(
+        **alpaca.alpaca_order(
+            id="6a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d", client_order_id="node-1", status="replaced"
+        )
+    )
+    replacement = AlpacaOrder(
+        **alpaca.alpaca_order(
+            id="7b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
+            client_order_id="alpaca-made-1",
+            status="new",
+            replaces=str(original.id),
+        )
+    )
+    client = tracer(held={"node-1"})
+
+    found = asyncio.run(client._node_order_id(replacement, {str(original.id): original}))
+
+    assert found == ClientOrderId("node-1")
