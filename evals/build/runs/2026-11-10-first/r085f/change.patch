+def test_two_missed_replaces_and_a_filled_final_replacement_reconcile_under_node_order(
+    venue,
+) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = ModifyStrategy()
+    reports: list = []
+
+    async def reconcile(client: AlpacaExecutionClient) -> None:
+        first_replacement = list(venue.trading._placed.values())[1]
+        second_replacement = {
+            **first_replacement,
+            "id": "9c0f6b2e-1d4a-4e8b-a3f5-7b6c5d4e3f21",
+            "client_order_id": "second-replacement-id",
+            "replaces": first_replacement["id"],
+            "status": "filled",
+            "qty": "6",
+            "filled_qty": "6",
+            "filled_avg_price": "150.00",
+        }
+        first_replacement.update(status="replaced", replaced_by=second_replacement["id"])
+        venue.trading._placed[second_replacement["id"]] = second_replacement
+        venue.trading.orders = list(venue.trading._placed.values())
+        client._replacements.clear()
+        window = SimpleNamespace(open_only=False, instrument_id=None, start=None, end=None)
+        reports.extend(
+            await client._generate_order_status_reports(window)  # ty: ignore[invalid-argument-type]
+        )
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), reconcile)
+
+    mine = [r for r in reports if r.client_order_id == strategy.client_order_id]
+    assert [(r.venue_order_id.value, r.order_status, r.quantity) for r in mine] == [
+        ("9c0f6b2e-1d4a-4e8b-a3f5-7b6c5d4e3f21", OrderStatus.FILLED, Quantity.from_int(6))
+    ]
