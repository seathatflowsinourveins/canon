diff --git a/tests/test_variant_study_sample_numbers.py b/tests/test_variant_study_sample_numbers.py
new file mode 100644
index 0000000..df9ac41
--- /dev/null
+++ b/tests/test_variant_study_sample_numbers.py
@@ -0,0 +1,50 @@
+"""`variant_study._to_record` reads a record's sample number as the gate does (ADR 0041).
+
+No test here runs a backtest, opens a network connection or reads a credential. Each writes trials to
+an Optuna SQLite study in pytest's temporary directory, by hand, with the user attributes
+`canon_trading.ledger.record_trial` writes before and after a run.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import optuna
+from optuna.trial import TrialState
+
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.variant_study import _to_record
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+
+def _write(study: optuna.Study, key: str, *, sample: object, outcome: str) -> None:
+    trial = study.ask()
+    trial.set_user_attr("config_key", key)
+    if sample is not None:
+        trial.set_user_attr("sample", sample)
+    trial.set_user_attr(OUTCOME, outcome)
+    if outcome == TRADED:
+        trial.set_user_attr("returns_series", {})
+        study.tell(trial, 0.0)
+    else:
+        study.tell(trial, state=TrialState.FAIL)
+
+
+def test_a_keyed_failure_with_no_sample_after_a_run_is_recorded_again(tmp_path: Path) -> None:
+    """The gate reads it as on the current sample and unresolved, so the pass must run its key."""
+    with create_ledger_study(
+        "pass", start="2025-03-10", end="2025-05-04", path=tmp_path / "trials.db"
+    ) as study:
+        _write(study, "resolved", sample=0, outcome=TRADED)
+        _write(study, "again", sample=0, outcome=TRADED)
+        _write(study, "again", sample=None, outcome=FAILED)
+        _write(study, "foreign", sample="0", outcome=TRADED)
+
+        assert _to_record(study, ["resolved", "again", "foreign"]) == ["again", "foreign"]
