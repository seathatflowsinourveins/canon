+"""The pure parts of the execution client's modify: which replacement holds a modify's terms, and how an
+order pending replace is reported. Offline; payloads from `conftest.py`'s copy of Alpaca's order example."""
+
+from __future__ import annotations
+
+from alpaca.trading.models import Order
+from alpaca.trading.requests import ReplaceOrderRequest
+from canon_alpaca.execution import order_status_report
+from canon_alpaca.execution import replaces_as_asked
+from nautilus_trader.model import OrderStatus
+
+
+def test_a_replacement_holds_a_modify_that_sends_no_quantity_only_at_the_order_quantity(
+    alpaca,
+) -> None:
+    # The docs' order is a limit buy of 2 at 150; a modify of the price alone sends no `qty`.
+    request = ReplaceOrderRequest(limit_price=150.0)
+    same = Order(**alpaca.alpaca_order(limit_price="150", qty="2"))
+    other_modify = Order(**alpaca.alpaca_order(limit_price="150", qty="5"))
+
+    assert replaces_as_asked(same, request, 2)
+    assert not replaces_as_asked(other_modify, request, 2)
+
+
+def test_a_replacement_must_hold_every_term_the_request_set(alpaca) -> None:
+    request = ReplaceOrderRequest(qty=5, limit_price=151.0)
+
+    assert replaces_as_asked(Order(**alpaca.alpaca_order(limit_price="151", qty="5")), request, 2)
+    assert not replaces_as_asked(
+        Order(**alpaca.alpaca_order(limit_price="150", qty="5")), request, 2
+    )
+
+
+def test_pending_replace_without_fills_is_reported_accepted(alpaca) -> None:
+    report = order_status_report(Order(**alpaca.alpaca_order(status="pending_replace")), 0)
+
+    assert report is not None
+    assert report.order_status == OrderStatus.ACCEPTED
