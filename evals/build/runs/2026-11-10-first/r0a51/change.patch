+def test_recorded_range_is_identical_across_extreme_offsets(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    pick = [0.01 * ((i % 5) - 1) for i in range(10)]
+    second = [0.005 * ((i % 3) - 1) for i in range(10)]
+    days = [DAY_0 + n * DAY_NS for n in range(10)]
+    before = datetime.now(UTC)
+    with create_ledger_study(
+        "offsets", start=days[0], end=days[-1], path=tmp_path / "trials.db"
+    ) as written:
+        for key, returns in (("pick", pick), ("second", second)):
+            trial = written.ask()
+            trial.set_user_attr("config_key", key)
+            trial.set_user_attr("sample", 0)
+            trial.set_user_attr("run_config_id", key)
+            trial.set_user_attr("backtest_start", days[0])
+            trial.set_user_attr("backtest_end", days[-1])
+            trial.set_user_attr(
+                "returns_series",
+                {str(d): v for d, v in zip(days, returns, strict=True)},
+            )
+            trial.set_user_attr("session_days", [str(d) for d in days])
+            trial.set_user_attr("data_digest", {f"bars-{key}": "d"})
+            trial.set_user_attr(OUTCOME, TRADED)
+            written.tell(trial, 0.0)
+    after = datetime.now(UTC)
+
+    seen = set()
+    try:
+        for zone in ("Pacific/Kiritimati", "UTC", "Pacific/Pago_Pago"):
+            monkeypatch.setenv("TZ", zone)
+            time.tzset()
+            with open_study("offsets", tmp_path / "trials.db") as reopened:
+                report = rank(reopened)
+            seen.add((report.first_recorded, report.last_recorded))
+    finally:
+        monkeypatch.undo()
+        time.tzset()
+
+    [(first, last)] = seen
+    assert first.endswith("+00:00") and last.endswith("+00:00")
+    assert before <= datetime.fromisoformat(first) <= datetime.fromisoformat(last) <= after
