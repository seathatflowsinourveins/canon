+def test_concurrent_ledger_creation_succeeds_while_first_caller_stays_open(tmp_path: Path) -> None:
+    """Creation lock releases before yielding, so a second process does not wait on the with-body."""
+    script = (
+        "import sys, time\n"
+        "from pathlib import Path\n"
+        "from canon_trading.ledger import create_ledger_study\n"
+        "here, name, other, sync = Path(sys.argv[1]), sys.argv[2], sys.argv[3], Path(sys.argv[4])\n"
+        "(sync / f'ready-{name}').touch()\n"
+        "deadline = time.monotonic() + 60\n"
+        "while not (sync / f'ready-{other}').exists() and time.monotonic() < deadline:\n"
+        "    time.sleep(0.001)\n"
+        "with create_ledger_study(name, start='2025-03-10', end='2025-05-04', path=here) as s:\n"
+        "    (sync / f'opened-{name}').touch()\n"
+        "    while not (sync / f'opened-{other}').exists() and time.monotonic() < deadline:\n"
+        "        time.sleep(0.001)\n"
+        "    s.ask()\n"
+    )
+    sync = tmp_path / "sync"
+    sync.mkdir()
+    path = tmp_path / "nested" / "ledger" / "trials.db"
+    runs = [
+        subprocess.Popen(
+            [sys.executable, "-c", script, str(path), f"s{n}", f"s{1 - n}", str(sync)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for n in range(2)
+    ]
+    results = [(run.communicate(timeout=120)[1], run.returncode) for run in runs]
+    assert [code for _, code in results] == [0, 0], [err[-300:] for err, _ in results]
+    for name in ("s0", "s1"):
+        with open_study(name, path) as study:
+            assert len(study.trials) == 1
+
