diff --git a/tests/test_returns_matrix_finite.py b/tests/test_returns_matrix_finite.py
new file mode 100644
index 0000000..d3cb0f0
--- /dev/null
+++ b/tests/test_returns_matrix_finite.py
@@ -0,0 +1,38 @@
+"""ADR 0031's finite-return contract applies before skfolio to every matrix column.
+
+skfolio 1.12.8 replaces NaN asset returns with zero and raises on infinities. Neither should reach
+that conversion: a matrix rejection must identify all the offending trials in one call.
+"""
+
+import pandas as pd
+import pytest
+
+from canon_trading.returns_matrix import DAY_NS
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import returns_matrix
+
+
+@pytest.mark.parametrize("invalid", [float("nan"), float("inf"), -float("inf")])
+def test_every_series_with_a_nonfinite_return_is_named(invalid: float) -> None:
+    index = pd.to_datetime([0, DAY_NS, 2 * DAY_NS], unit="ns", utc=True)
+    first = pd.Series([0.01, invalid, 0.02], index=index, name="first")
+    valid = pd.Series([0.01, 0.0, 0.02], index=index, name="valid")
+    last = pd.Series([invalid, 0.01, 0.02], index=index, name="last")
+
+    with pytest.raises(ReturnsRejected) as rejected:
+        returns_matrix([first, valid, last])
+
+    assert rejected.value.names == ("first", "last")
+    assert str(rejected.value) == (
+        "first: a return that is not finite\nlast: a return that is not finite"
+    )
+
+
+def test_a_missing_nullable_return_is_refused_before_skfolio_fills_it() -> None:
+    index = pd.to_datetime([0, DAY_NS, 2 * DAY_NS], unit="ns", utc=True)
+    missing = pd.Series([0.01, pd.NA, 0.02], index=index, name="missing", dtype="Float64")
+
+    with pytest.raises(ReturnsRejected, match="missing: a return that is not finite") as rejected:
+        returns_matrix([missing])
+
+    assert rejected.value.names == ("missing",)
