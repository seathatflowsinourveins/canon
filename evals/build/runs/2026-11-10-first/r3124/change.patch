     return default_ledger_path() if path is None else Path(path).resolve()
 
 
+@contextmanager
+def _creation_lock(path: Path) -> Generator[None]:
+    """An exclusive inter-process lock on the creation of the ledger file at `path`.
+
+    Held on the sibling `<file>.lock`; `fcntl.flock` is released when the file is closed, so a
+    creator killed while holding it leaves no stale lock.
+    """
+    with Path(f"{path}.lock").open("a+") as lock_file:
+        fcntl.flock(lock_file, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_file, fcntl.LOCK_UN)
+
