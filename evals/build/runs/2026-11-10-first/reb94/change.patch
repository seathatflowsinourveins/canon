index 0000000..ec1314c
--- /dev/null
+++ b/tests/test_gate_contracts.py
@@ -0,0 +1,170 @@
+"""Additional boundary checks on the sample, cache, creation and calendar rules of ADR 0035 and ADR 0041.
+
+No test here opens a network connection, reads a credential or downloads a file.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from contextlib import ExitStack
+from datetime import datetime
+from typing import TYPE_CHECKING
+from typing import Any
+from zoneinfo import ZoneInfo
+
+import optuna
+import pytest
+from nautilus_trader.model import BarType
+from nautilus_trader.model import Quantity
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+import canon_trading.ledger
+from canon_trading.backtest import backtest_run_config
+from canon_trading.ledger import DAY_NS
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import data_digest
+from canon_trading.ledger import record_trial
+from canon_trading.ma_cross import MaCross
+from canon_trading.ma_cross import MaCrossConfig
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import daily_series
+from canon_trading.variant_study import _to_record
+from canon_trading.variant_study import key_of
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+NEW_YORK = ZoneInfo("America/New_York")
+AAPL = BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL")
+MSFT = BarType.from_str("MSFT.ALPACA-1-DAY-LAST-EXTERNAL")
+BALANCES = ["100000 USD"]
+START = "2025-03-10"
+END = "2025-05-04"
+DAY_0 = 1_741_651_200 * 1_000_000_000  # 2025-03-11T00:00:00Z
+
+
+def _config(bar_type: BarType = AAPL, fast: int = 3, slow: int = 8) -> MaCrossConfig:
+    return MaCrossConfig(
+        bar_type=bar_type,
+        trade_size=Quantity.from_int(10),
+        fast_period=fast,
+        slow_period=slow,
+    )
+
+
+def test_data_digest_is_independent_of_bar_order(alpaca_bars: AlpacaBars) -> None:
+    bars = alpaca_bars.daily(alpaca_bars.equity())
+
+    assert data_digest(list(reversed(bars))) == data_digest(bars)
+
+
+def test_unexpected_cached_bar_type_is_told_failed(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    stray = alpaca_bars.daily(alpaca_bars.equity("MSFT"), [101.0])
+    real = canon_trading.ledger.run_backtest_config
+
+    def swap_bar(*args: Any) -> object:
+        run = real(*args)
+        return dataclasses.replace(run, bars=[*run.bars[:-1], *stray])
+
+    monkeypatch.setattr(canon_trading.ledger, "run_backtest_config", swap_bar)
+    with create_ledger_study("unexpected", start=START, end=END, path=tmp_path / "trials.db") as s:
+        with pytest.raises(RuntimeError, match="holds bars of .*MSFT"):
+            record_trial(s, tmp_path / "catalog", [_config()], starting_balances=BALANCES)
+        [trial] = s.trials
+        assert (trial.state, trial.user_attrs[OUTCOME]) == (TrialState.FAIL, FAILED)
+        assert "data_digest" not in trial.user_attrs
+
+
+def test_second_instrument_partial_coverage_is_refused_before_a_trial(
+    alpaca_bars: AlpacaBars, tmp_path: Path
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog", symbols=("AAPL",))
+    alpaca_bars.write(
+        tmp_path / "catalog",
+        alpaca_bars.CLOSES[:10],
+        symbols=("MSFT",),
+        first=datetime(2025, 3, 10, tzinfo=NEW_YORK),
+    )
+    with create_ledger_study("two", start=START, end=END, path=tmp_path / "trials.db") as study:
+        with pytest.raises(LookupError, match=r"MSFT.*does not cover the sample"):
+            record_trial(
+                study,
+                tmp_path / "catalog",
+                [_config(AAPL), _config(MSFT)],
+                starting_balances=BALANCES,
+            )
+        assert study.trials == []
+
+
+def test_inverted_explicit_bounds_are_refused(alpaca_bars: AlpacaBars, tmp_path: Path) -> None:
+    bars = alpaca_bars.write(tmp_path)
+
+    with pytest.raises(LookupError, match="holds no AAPL.ALPACA-1-DAY-LAST-EXTERNAL bars from"):
+        backtest_run_config(
+            tmp_path,
+            [MaCross(_config())],
+            starting_balances=BALANCES,
+            start=bars[-1].ts_init,
+            end=bars[0].ts_init,
+        )
+
+
+def test_foreign_empty_study_is_not_treated_as_interrupted_creation(tmp_path: Path) -> None:
+    ledger = tmp_path / "trials.db"
+    with ExitStack() as stack:
+        stack.enter_context(create_ledger_study("other", start=START, end=END, path=ledger))
+    optuna.create_study(
+        study_name="foreign",
+        storage=f"sqlite:///{ledger}",
+        direction="minimize",
+    )
+
+    with (
+        pytest.raises(DuplicatedStudyError),
+        create_ledger_study("foreign", start=START, end=END, path=ledger),
+    ):
+        pass
+
+
+def test_variant_study_reruns_key_after_sampleless_failure_and_ignores_bool_sample(
+    alpaca_bars: AlpacaBars, tmp_path: Path
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    first_cfg = _config(AAPL, fast=3, slow=8)
+    second_cfg = _config(AAPL, fast=2, slow=5)
+    first_key = key_of(first_cfg, BALANCES)
+    second_key = key_of(second_cfg, BALANCES)
+    with create_ledger_study("grid", start=START, end=END, path=tmp_path / "trials.db") as study:
+        record_trial(study, tmp_path / "catalog", [first_cfg], starting_balances=BALANCES)
+        # Keyed failure before `sample` was written must schedule `first_key` again.
+        failed = study.ask()
+        failed.set_user_attr("config_key", first_key)
+        failed.set_user_attr(OUTCOME, FAILED)
+        study.tell(failed, state=TrialState.FAIL)
+        # A `bool` sample (`False == 0` in Python) is not sample 0.
+        bogus = study.ask()
+        bogus.set_user_attr("config_key", second_key)
+        bogus.set_user_attr("sample", False)
+        bogus.set_user_attr(OUTCOME, "traded")
+        study.tell(bogus, 1.0)
+
+        assert _to_record(study, [first_key, second_key]) == [first_key, second_key]
+
+
+def test_daily_series_refuses_off_midnight_session_days_and_multiple_missing_days() -> None:
+    returns = {str(DAY_0 + n * DAY_NS): 0.01 for n in range(3)}
+
+    with pytest.raises(ReturnsRejected, match="session_days has keys off a UTC midnight"):
+        daily_series("a", returns, [str(DAY_0 + 1)])
+    with pytest.raises(
+        ReturnsRejected, match="a: no return on 2 of its 5 session days, the first 2025-03-14"
+    ):
+        daily_series("a", returns, [str(DAY_0 + n * DAY_NS) for n in range(5)])
