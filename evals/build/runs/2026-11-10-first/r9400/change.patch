+@contextmanager
+def _creation_lock(path: Path) -> Generator[None]:
+    """Hold the creation lock of the ledger at `path` (module header) until the block leaves.
+
+    The lock is `fcntl.flock` with `LOCK_EX` on `<path>.lock` beside the ledger file, so creators
+    of different files never wait on each other. Closing the file releases it, as a process ending
+    does, so a creator killed while holding it leaves no stale lock behind.
+    """
+    with path.with_name(f"{path.name}.lock").open("a+b") as lock_file:
+        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+
+
