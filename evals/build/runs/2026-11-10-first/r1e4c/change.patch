@@ -0,0 +1,184 @@
+"""Edge cases around the five gate and ledger defects fixed on 2026-11-10.
+
+No test here opens a network connection, reads a credential or edits an existing test file.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime
+from typing import TYPE_CHECKING
+from typing import Any
+from zoneinfo import ZoneInfo
+
+import optuna
+import pytest
+from nautilus_trader.model import BarType
+from nautilus_trader.model import Quantity
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+import canon_trading.ledger
+from canon_trading.backtest import backtest_run_config
+from canon_trading.backtest import run_backtest
+from canon_trading.ledger import DAY_NS
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import data_digest
+from canon_trading.ledger import open_study
+from canon_trading.ledger import record_trial
+from canon_trading.ma_cross import MaCross
+from canon_trading.ma_cross import MaCrossConfig
+from canon_trading.ranking import RankingReport
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import daily_series
+from canon_trading.variant_study import grid
+from canon_trading.variant_study import key_of
+from canon_trading.variant_study import run_study
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+NEW_YORK = ZoneInfo("America/New_York")
+BAR_TYPE = BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL")
+MSFT_BAR_TYPE = BarType.from_str("MSFT.ALPACA-1-DAY-LAST-EXTERNAL")
+DAY_0 = 1_741_651_200 * 1_000_000_000
+
+
+def test_backtest_run_exposes_cached_bars_in_chronological_order_and_digest_sorts(
+    alpaca_bars: AlpacaBars, tmp_path: Path
+) -> None:
+    bars = alpaca_bars.write(tmp_path)
+    strategy = MaCross(
+        MaCrossConfig(
+            bar_type=BAR_TYPE, trade_size=Quantity.from_int(10), fast_period=3, slow_period=8
+        )
+    )
+
+    run = run_backtest(tmp_path, [strategy], starting_balances=["100000 USD"])
+
+    assert run.bars == bars
+    assert data_digest(list(reversed(bars))) == data_digest(bars)
+
+
+def test_unexpected_cached_bar_type_is_told_failed(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    msft = alpaca_bars.daily(alpaca_bars.equity("MSFT"), [101.0])
+    real = canon_trading.ledger.run_backtest_config
+
+    def swap_bar_type(*args: Any) -> object:
+        run = real(*args)
+        return dataclasses.replace(run, bars=[*run.bars[:-1], msft[0]])
+
+    monkeypatch.setattr(canon_trading.ledger, "run_backtest_config", swap_bar_type)
+    with create_ledger_study(
+        "unexpected", start="2025-03-10", end="2025-05-04", path=tmp_path / "trials.db"
+    ) as study:
+        config = MaCrossConfig(
+            bar_type=BAR_TYPE, trade_size=Quantity.from_int(10), fast_period=3, slow_period=8
+        )
+        with pytest.raises(RuntimeError, match="cached bars of"):
+            record_trial(study, tmp_path / "catalog", [config], starting_balances=["100000 USD"])
+        [trial] = study.trials
+        assert (trial.state, trial.user_attrs[OUTCOME]) == (TrialState.FAIL, FAILED)
+        assert "data_digest" not in trial.user_attrs
+
+
+@pytest.mark.parametrize("bound", ["start", "end"])
+def test_one_bound_partially_beyond_the_catalog_is_refused_naming_the_gap(
+    alpaca_bars: AlpacaBars, tmp_path: Path, bound: str
+) -> None:
+    bars = alpaca_bars.write(tmp_path)
+    strategy = MaCross(MaCrossConfig(bar_type=BAR_TYPE, trade_size=Quantity.from_int(10)))
+    start = bars[0].ts_init - 5 * DAY_NS if bound == "start" else None
+    end = bars[-1].ts_init + 5 * DAY_NS if bound == "end" else None
+
+    with pytest.raises(LookupError, match="does not cover the sample: missing"):
+        backtest_run_config(
+            tmp_path, [strategy], starting_balances=["100000 USD"], start=start, end=end
+        )
+
+
+def test_false_is_not_sample_zero_when_a_record_ran(tmp_path: Path) -> None:
+    """In Python `False == 0`; a record that ran with `sample=False` must still stop the ranking."""
+    with create_ledger_study(
+        "bool zero", start=DAY_0, end=DAY_0 + 2 * DAY_NS, path=tmp_path / "trials.db"
+    ) as study:
+        for key, sample_attr, vals in (
+            ("a", False, [0.01, -0.005, 0.02]),
+            ("b", 0, [0.005, 0.002, -0.001]),
+        ):
+            trial = study.ask()
+            trial.set_user_attr("config_key", key)
+            trial.set_user_attr("sample", sample_attr)
+            trial.set_user_attr(
+                "returns_series", {str(DAY_0 + i * DAY_NS): v for i, v in enumerate(vals)}
+            )
+            trial.set_user_attr("session_days", [str(DAY_0 + i * DAY_NS) for i in range(3)])
+            trial.set_user_attr("data_digest", {"BT": "d"})
+            trial.set_user_attr(OUTCOME, TRADED)
+            study.tell(trial, 0.0)
+
+        with pytest.raises(RankingStopped, match=r"#0 \(traded\) ran with sample False"):
+            rank(study)
+
+
+def test_variant_study_reruns_a_key_that_failed_before_its_sample_was_written(
+    alpaca_bars: AlpacaBars, tmp_path: Path
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog", symbols=("SPY",))
+    alpaca_bars.write(
+        tmp_path / "catalog", tuple(100.0 + (i * 7) % 13 for i in range(40)), symbols=("QQQ",)
+    )
+    configs = grid(periods=((2, 5), (3, 8)))
+    ledger = tmp_path / "trials.db"
+    start = datetime(2025, 3, 10, 12, tzinfo=NEW_YORK)
+    end = datetime(2025, 5, 3, 12, tzinfo=NEW_YORK)
+    run_study(
+        tmp_path / "catalog",
+        name="s",
+        ledger_path=ledger,
+        configs=configs,
+        start=start,
+        end=end,
+        create=True,
+    )
+    with open_study("s", ledger) as study:
+        failed = study.ask()
+        failed.set_user_attr("config_key", key_of(configs[0]))
+        failed.set_user_attr(OUTCOME, FAILED)
+        study.tell(failed, state=TrialState.FAIL)
+
+    recorded, report = run_study(
+        tmp_path / "catalog", name="s", ledger_path=ledger, configs=configs, start=start, end=end
+    )
+
+    assert recorded is not None and len(recorded.recorded) == 1
+    assert isinstance(report, RankingReport)
+
+
+def test_create_ledger_study_does_not_adopt_a_foreign_study(tmp_path: Path) -> None:
+    ledger = tmp_path / "trials.db"
+    optuna.create_study(study_name="foreign", storage=f"sqlite:///{ledger}")  # default minimize
+
+    with (
+        pytest.raises(DuplicatedStudyError),
+        create_ledger_study("foreign", start="2025-03-10", end="2025-05-04", path=ledger),
+    ):
+        pass
+
+
+def test_duplicate_session_days_are_refused() -> None:
+    returns = {str(DAY_0): 0.01, str(DAY_0 + DAY_NS): 0.02}
+    days = [str(DAY_0), str(DAY_0), str(DAY_0 + DAY_NS)]
+
+    with pytest.raises(ReturnsRejected, match="session_days has duplicate days"):
+        daily_series("a", returns, days)
