+"""Records with no sample of their study (ADR 0041), on an Optuna SQLite study in pytest's temporary
+directory. No test here runs a backtest, opens a network connection or reads a credential.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import optuna
+import pytest
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+from canon_trading.ledger import DAY_NS
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+DAY_0 = 1_741_651_200 * 1_000_000_000  # 2025-03-11T00:00:00Z
+
+
+def test_a_record_that_ran_with_no_sample_attribute_stops(tmp_path: Path) -> None:
+    """`record_trial` writes the sample before the run, so one that ran without it is another writer's."""
+    with create_ledger_study(
+        "no sample", start=DAY_0, end=DAY_0 + 2 * DAY_NS, path=tmp_path / "trials.db"
+    ) as study:
+        trial = study.ask()
+        trial.set_user_attr("config_key", "pick")
+        days = [str(DAY_0 + n * DAY_NS) for n in range(3)]
+        trial.set_user_attr("returns_series", dict.fromkeys(days, 0.01))
+        trial.set_user_attr("session_days", days)
+        trial.set_user_attr(OUTCOME, TRADED)
+        study.tell(trial, 0.0)
+
+        with pytest.raises(RankingStopped, match=rf"#{trial.number} \(traded\) ran with no sample"):
+            rank(study)
+
+
+def test_a_study_with_no_sample_but_with_trials_is_not_completed(tmp_path: Path) -> None:
+    """Only a creation interrupted before any trial is completed; anything else is a duplicate."""
+    path = tmp_path / "trials.db"
+    storage = optuna.storages.RDBStorage(f"sqlite:///{path}")
+    try:
+        other = optuna.create_study(study_name="taken", storage=storage)
+        other.tell(other.ask(), state=TrialState.FAIL)
+    finally:
+        storage.remove_session()
+        storage.engine.dispose()
+
+    with (
+        pytest.raises(DuplicatedStudyError),
+        create_ledger_study("taken", start=DAY_0, end=DAY_0 + DAY_NS, path=path),
+    ):
+        pass
