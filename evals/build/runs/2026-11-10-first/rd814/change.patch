+"""Additional boundaries of the ledger's ADR 0035 and ADR 0041 contracts.
+
+Only an empty maximizing study can be an interrupted creation; records and other metadata must
+survive a refused creation unchanged. A real bounded Nautilus cache must also fail the trial rather
+than identify a replay by only the bars it retained. All storage and replay are local.
+"""
+
+from __future__ import annotations
+
+from functools import partial
+from typing import TYPE_CHECKING
+
+import optuna
+import pytest
+from nautilus_trader.config import BacktestEngineConfig
+from nautilus_trader.config import CacheConfig
+from nautilus_trader.model import BarType
+from nautilus_trader.model import Quantity
+from optuna.exceptions import DuplicatedStudyError
+from optuna.study import StudyDirection
+from optuna.trial import TrialState
+
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import SAMPLES
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import record_trial
+from canon_trading.ma_cross import MaCrossConfig
+from canon_trading.returns_matrix import DAY_NS
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import daily_series
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+
+@pytest.mark.parametrize(
+    "occupied", ["metadata", "sample", "trial", "minimizing", "multiobjective"]
+)
+def test_creation_recovery_never_overwrites_an_occupied_study(
+    tmp_path: Path, occupied: str
+) -> None:
+    path = tmp_path / "trials.db"
+    storage = optuna.storages.RDBStorage(f"sqlite:///{path}")
+    try:
+        directions = {
+            "minimizing": [StudyDirection.MINIMIZE],
+            "multiobjective": [StudyDirection.MAXIMIZE, StudyDirection.MAXIMIZE],
+        }.get(occupied, [StudyDirection.MAXIMIZE])
+        study = optuna.create_study(study_name="occupied", storage=storage, directions=directions)
+        if occupied == "metadata":
+            study.set_user_attr("other_writer", "kept")
+        elif occupied == "sample":
+            study.set_user_attr(SAMPLES, [])  # malformed metadata is not an unwritten sample
+        elif occupied == "trial":
+            study.ask()
+        before_attrs = study.user_attrs
+        before_trials = study.trials
+
+        with (
+            pytest.raises(DuplicatedStudyError),
+            create_ledger_study("occupied", start="2025-03-10", end="2025-05-04", path=path),
+        ):
+            pytest.fail("an occupied study was accepted as an interrupted creation")
+
+        reopened = optuna.load_study(study_name="occupied", storage=storage)
+        assert reopened.user_attrs == before_attrs
+        assert reopened.trials == before_trials
+        assert reopened.directions == study.directions
+    finally:
+        storage.remove_session()
+        storage.engine.dispose()
+
+
+def test_actual_cache_eviction_fails_before_the_data_identity_is_written(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    monkeypatch.setattr(
+        "canon_trading.backtest.BacktestEngineConfig",
+        partial(BacktestEngineConfig, cache=CacheConfig(bar_capacity=5)),
+    )
+    strategy = MaCrossConfig(
+        bar_type=BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL"),
+        trade_size=Quantity.from_int(10),
+        fast_period=3,
+        slow_period=8,
+    )
+    with create_ledger_study(
+        "evicted", start="2025-03-10", end="2025-05-04", path=tmp_path / "trials.db"
+    ) as study:
+        with pytest.raises(
+            RuntimeError, match="the engine's cache holds 5 bars and the run replayed 40"
+        ):
+            record_trial(study, tmp_path / "catalog", [strategy], starting_balances=["100000 USD"])
+
+        [trial] = study.trials
+        assert trial.state == TrialState.FAIL
+        assert trial.user_attrs[OUTCOME] == FAILED
+        assert "data_digest" not in trial.user_attrs
+        assert "session_days" not in trial.user_attrs
+
+
+def test_missing_session_returns_before_and_after_the_series_are_both_counted() -> None:
+    first = 1_741_651_200 * 1_000_000_000  # 2025-03-11T00:00:00Z
+    returns = {str(first + n * DAY_NS): 0.001 * (n + 1) for n in range(3)}
+    days = [str(first + n * DAY_NS) for n in range(-1, 4)]
+
+    with pytest.raises(
+        ReturnsRejected,
+        match="edges: no return on 2 of its 5 session days, the first 2025-03-10",
+    ):
+        daily_series("edges", returns, days)
