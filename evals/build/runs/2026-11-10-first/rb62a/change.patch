+def test_replaces_as_asked_compares_omitted_fields_with_original(alpaca) -> None:
+    from alpaca.trading.requests import ReplaceOrderRequest
+
+    original = Order(**alpaca.alpaca_order(qty="2", limit_price="150.0"))
+    same_qty = Order(**alpaca.alpaca_order(qty="2", limit_price="151.0"))
+    changed_qty = Order(**alpaca.alpaca_order(qty="5", limit_price="151.0"))
+    req = ReplaceOrderRequest(limit_price=151.0)
+
+    assert replaces_as_asked(original, same_qty, req)
+    assert not replaces_as_asked(original, changed_qty, req)
