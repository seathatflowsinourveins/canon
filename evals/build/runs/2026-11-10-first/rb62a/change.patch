+def test_late_expire_of_the_replaced_order_does_not_expire_the_replacement(venue) -> None:
+    venue.trading.script = "accept"
+    strategy = modifier()
+
+    async def late(_client) -> None:
+        old = placed_order(venue, 0)
+        venue.trading.update(old["id"], "expired", status="expired")
+
+    run_modify(venue, strategy, lambda: "OrderUpdated" in strategy.names(), late)
+
+    assert "OrderExpired" not in strategy.names(), strategy.names()
+
+
+def test_partial_fill_on_replacement_before_replaced_updates_once_even_when_replaced_arrives_later(
+    venue,
+) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def sequence(_client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        venue.trading.update(
+            new["id"], "partial_fill", 3, status="partially_filled", filled_qty="3"
+        )
+        async with asyncio.timeout(10):
+            while "OrderFilled" not in strategy.names():
+                await asyncio.sleep(0.01)
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.update(new["id"], "fill", 2, status="filled", filled_qty="5")
+        async with asyncio.timeout(10):
+            while strategy.names().count("OrderFilled") < 2:
+                await asyncio.sleep(0.01)
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), sequence)
+
+    names = strategy.names()
+    assert names.count("OrderUpdated") == 1, names
+    assert names.index("OrderUpdated") < names.index("OrderFilled"), names
+    fills = [e for e in strategy.events if type(e).__name__ == "OrderFilled"]
+    assert [f.last_qty for f in fills] == [Quantity.from_int(3), Quantity.from_int(2)]
+
