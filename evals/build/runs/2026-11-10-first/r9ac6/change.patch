+"""Additional event-order regressions for Alpaca's Replace Order by ID and OrderUpdated contracts.
+
+Uses the real-node harness and documented Alpaca payloads from test_execution_client and conftest.
+"""
+
+import asyncio
+import uuid
+from types import SimpleNamespace
+
+import pytest
+from nautilus_trader.model import OrderStatus
+from nautilus_trader.model import Price
+from nautilus_trader.model import Quantity
+
+from .test_execution_client import dispose_nodes
+from .test_execution_client import modifier
+from .test_execution_client import placed_order
+from .test_execution_client import run_modify
+from .test_execution_client import until_idle
+from .test_execution_client import venue
+
+# These imported fixtures register this module's node lifecycle and offline venue with pytest.
+__all__ = ["dispose_nodes", "venue"]
+
+
+@pytest.mark.parametrize("event", ["canceled", "expired", "rejected"])
+def test_old_order_close_keeps_its_replacement_working(venue, event) -> None:
+    venue.trading.script = "accept"
+    strategy = modifier()
+
+    async def late(client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        venue.trading.update(old["id"], event, status=event)
+        await until_idle(client, venue)
+        current = client.cache.order(strategy.client_order_id)
+        assert current.venue_order_id.value == new["id"]
+        assert not current.is_closed
+
+    run_modify(venue, strategy, lambda: "OrderUpdated" in strategy.names(), late)
+
+    assert strategy.names()[-1] == "OrderUpdated"
+
+
+def test_older_replace_confirmations_do_not_roll_back_two_modifies(venue) -> None:
+    venue.trading.script = "accept"
+    strategy = modifier(prices=["150.50", "151.00"])
+
+    async def repeat(client) -> None:
+        venue.trading.confirm_replace(placed_order(venue, 1)["id"])
+        venue.trading.confirm_replace(placed_order(venue, 0)["id"])
+        venue.trading.confirm_replace(placed_order(venue, 1)["id"])
+        await until_idle(client, venue)
+        current = client.cache.order(strategy.client_order_id)
+        assert current.venue_order_id.value == placed_order(venue, 2)["id"]
+        assert current.price == Price.from_str("151.00")
+
+    run_modify(venue, strategy, lambda: strategy.names().count("OrderUpdated") == 2, repeat)
+
+    assert strategy.names().count("OrderUpdated") == 2
+
+
+def test_partial_fill_before_confirmation_then_old_expiry_preserves_all_fills(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def race(client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        venue.trading.update(
+            new["id"], "partial_fill", 1, status="partially_filled", filled_qty="1"
+        )
+        await until_idle(client, venue)
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.update(old["id"], "expired", status="expired")
+        venue.trading.update(new["id"], "fill", 4, status="filled", filled_qty="5")
+        await until_idle(client, venue)
+        current = client.cache.order(strategy.client_order_id)
+        assert current.status == OrderStatus.FILLED
+        assert current.quantity == current.filled_qty == Quantity.from_int(5)
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), race)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    assert strategy.names().count("OrderFilled") == 2
+    assert "OrderExpired" not in strategy.names()
+
+
+def test_separate_modify_with_identical_terms_is_not_an_sdk_retry(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def second(client) -> None:
+        old = placed_order(venue, 0)
+        current = client.cache.order(strategy.client_order_id)
+        await client._modify_order(
+            SimpleNamespace(
+                client_order_id=strategy.client_order_id,
+                venue_order_id=current.venue_order_id,
+                quantity=Quantity.from_int(5),
+                price=None,
+                trigger_price=None,
+            )
+        )
+        await until_idle(client, venue)
+        assert strategy.names().count("OrderModifyRejected") == 1
+        assert list(client._modifying.values()) == [strategy.client_order_id]
+        venue.trading.confirm_replace(old["id"])
+        await until_idle(client, venue)
+        assert not client._modifying
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), second)
+
+    assert len(venue.trading.replace_requests) == 2
+    assert strategy.names().count("OrderUpdated") == 1
+
+
+def test_replacement_read_follows_changed_terms_to_the_latest_order(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+    latest_id = str(uuid.uuid4())
+
+    async def moved(client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        latest = {
+            **new,
+            "id": latest_id,
+            "client_order_id": str(uuid.uuid4()),
+            "replaces": new["id"],
+            "qty": "5",
+            "limit_price": "151.00",
+        }
+        venue.trading._placed[latest_id] = latest
+        new.update(status="replaced", replaced_by=latest_id)
+        client._answers.clear()
+        venue.trading.confirm_replace(old["id"])
+        async with asyncio.timeout(10):
+            while "OrderUpdated" not in strategy.names():
+                await asyncio.sleep(0.01)
+        await until_idle(client, venue)
+        assert not client._modifying
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), moved)
+
+    updated = strategy.last("OrderUpdated")
+    assert updated.venue_order_id.value == latest_id
+    assert updated.quantity == Quantity.from_int(5)
+    assert updated.price == Price.from_str("151.00")
