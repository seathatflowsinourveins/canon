+def test_two_step_replace_from_unholdable_original_keeps_the_first_holdable_id(
+    venue, alpaca
+) -> None:
+    original = alpaca.alpaca_order(
+        id="6a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
+        client_order_id="\u8ba2\u5355-1",
+        status="replaced",
+        replaced_by="7b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
+    )
+    first = alpaca.alpaca_order(
+        id="7b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
+        client_order_id="alpaca-made-1",
+        status="replaced",
+        replaces=original["id"],
+        replaced_by="8c3d4e5f-6a7b-4c8d-9e0f-1a2b3c4d5e6f",
+    )
+    second = alpaca.alpaca_order(
+        id="8c3d4e5f-6a7b-4c8d-9e0f-1a2b3c4d5e6f",
+        client_order_id="alpaca-made-2",
+        status="new",
+        replaces=first["id"],
+    )
+    venue.trading.orders = [original, first, second]
+    single_reports: list = []
+
+    async def inspect_single(client: Any, _: Idle) -> None:
+        client._replacements.clear()
+        command = SimpleNamespace(
+            venue_order_id=VenueOrderId(original["id"]),
+            client_order_id=None,
+        )
+        single_reports.append(await client._generate_order_status_report(command))
+
+    run_with_client(inspect_single)
+
+    assert len(single_reports) == 1
+    assert single_reports[0] is not None
+    assert single_reports[0].client_order_id == ClientOrderId("alpaca-made-1")
+    assert single_reports[0].venue_order_id == VenueOrderId(second["id"])
+
