diff --git a/tests/test_variant_study_recovery.py b/tests/test_variant_study_recovery.py
new file mode 100644
index 0000000..29b34a6
--- /dev/null
+++ b/tests/test_variant_study_recovery.py
@@ -0,0 +1,57 @@
+"""A pass re-runs a key whose latest gate record failed before its sample was written.
+
+The gate counts such a record for its key until a later record of the key ran to the
+end (`canon_trading.ranking`), so `canon_trading.variant_study._to_record` must count
+it the same way when it decides what to record again. No backtest runs here: records
+are written in the ledger's form, as in `tests/test_ranking.py`.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import optuna
+from optuna.trial import TrialState
+
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import create_ledger_study
+from canon_trading.variant_study import _to_record
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+DAY_0 = 1_741_651_200 * 1_000_000_000
+
+
+def _ran(study: optuna.Study, key: str) -> None:
+    trial = study.ask()
+    trial.set_user_attr("config_key", key)
+    trial.set_user_attr("sample", 0)
+    trial.set_user_attr(OUTCOME, TRADED)
+    study.tell(trial, 0.0)
+
+
+def _failed_without_sample(study: optuna.Study, key: str) -> None:
+    trial = study.ask()
+    trial.set_user_attr("config_key", key)
+    trial.set_user_attr(OUTCOME, FAILED)
+    study.tell(trial, state=TrialState.FAIL)
+
+
+def test_an_unsampled_failure_is_recorded_again_until_a_later_run(tmp_path: Path) -> None:
+    with create_ledger_study(
+        "recovery", start=DAY_0, end=DAY_0 + 1, path=tmp_path / "trials.db"
+    ) as study:
+        _ran(study, "a")
+        _ran(study, "b")
+        _failed_without_sample(study, "a")
+
+        assert _to_record(study, ["a", "b"]) == ["a"]
+
+        _ran(study, "a")
+
+        assert _to_record(study, ["a", "b"]) == []
