index 0000000..7c23822
--- /dev/null
+++ b/tests/test_gate_contracts.py
@@ -0,0 +1,193 @@
+"""Additional offline checks of the gate, ledger and returns-matrix contracts (ADR 0010, 0035, 0041)."""
+
+from __future__ import annotations
+
+import dataclasses
+from typing import TYPE_CHECKING
+from typing import Any
+
+import optuna
+import pytest
+from nautilus_trader.model import BarType
+from nautilus_trader.model import Quantity
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+import canon_trading.ledger
+from canon_trading.backtest import backtest_run_config
+from canon_trading.ledger import DAY_NS
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import TRADED
+from canon_trading.ledger import LedgerNotFound
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import data_digest
+from canon_trading.ledger import open_study
+from canon_trading.ledger import record_trial
+from canon_trading.ma_cross import MaCross
+from canon_trading.ma_cross import MaCrossConfig
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+from canon_trading.returns_matrix import ReturnsRejected
+from canon_trading.returns_matrix import daily_series
+from canon_trading.variant_study import record_grid
+
+if TYPE_CHECKING:
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+BAR_TYPE = BarType.from_str("AAPL.ALPACA-1-DAY-LAST-EXTERNAL")
+BALANCES = ("100000 USD",)
+START = "2025-03-10"
+END = "2025-05-04"
+DAY_0 = 1_741_651_200 * 1_000_000_000
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+
+def _strategy(fast: int = 3, slow: int = 8, bar_type: BarType = BAR_TYPE) -> MaCrossConfig:
+    return MaCrossConfig(
+        bar_type=bar_type,
+        trade_size=Quantity.from_int(10),
+        fast_period=fast,
+        slow_period=slow,
+    )
+
+
+def test_data_digest_sorts_bars_by_timestamps(alpaca_bars: AlpacaBars) -> None:
+    """`Cache.bars` holds bars most-recent first; `data_digest` gives one digest whatever the order."""
+    bars = alpaca_bars.daily(alpaca_bars.equity(), alpaca_bars.CLOSES)
+
+    assert data_digest(list(reversed(bars))) == data_digest(bars)
+
+
+def test_unexpected_bar_types_in_cache_are_told_failed(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    msft = alpaca_bars.daily(alpaca_bars.equity("MSFT"), [100.0])
+    real = canon_trading.ledger.run_backtest_config
+
+    def with_msft(*args: Any) -> object:
+        run = real(*args)
+        return dataclasses.replace(run, bars=[*run.bars[:-1], *msft])
+
+    monkeypatch.setattr(canon_trading.ledger, "run_backtest_config", with_msft)
+    with (
+        create_ledger_study("unexpected", start=START, end=END, path=tmp_path / "trials.db") as s,
+        pytest.raises(RuntimeError, match="MSFT"),
+    ):
+        record_trial(s, tmp_path / "catalog", [_strategy()], starting_balances=BALANCES)
+
+    with open_study("unexpected", tmp_path / "trials.db") as reopened:
+        [trial] = reopened.trials
+        assert (trial.state, trial.user_attrs[OUTCOME]) == (TrialState.FAIL, FAILED)
+        assert "data_digest" not in trial.user_attrs
+
+
+def test_inverted_explicit_bounds_are_refused(alpaca_bars: AlpacaBars, tmp_path: Path) -> None:
+    bars = alpaca_bars.write(tmp_path)
+
+    with pytest.raises(LookupError, match="holds no AAPL.ALPACA-1-DAY-LAST-EXTERNAL bars from"):
+        backtest_run_config(
+            tmp_path,
+            [MaCross(_strategy())],
+            starting_balances=BALANCES,
+            start=bars[-1].ts_init,
+            end=bars[0].ts_init,
+        )
+
+
+def test_create_ledger_study_refuses_non_interrupted_existing_studies(tmp_path: Path) -> None:
+    """Only an empty `MAXIMIZE` study with no user attributes and no trials is completed."""
+    db = tmp_path / "trials.db"
+    url = f"sqlite:///{db}"
+
+    minimized = optuna.create_study(study_name="minimized", storage=url, direction="minimize")
+    assert minimized.study_name == "minimized"
+    with_trial = optuna.create_study(study_name="with_trial", storage=url, direction="maximize")
+    with_trial.ask()
+    corrupt = optuna.create_study(study_name="corrupt", storage=url, direction="maximize")
+    corrupt.set_user_attr("samples", "bad")
+
+    for name in ("minimized", "with_trial", "corrupt"):
+        with (
+            pytest.raises(DuplicatedStudyError),
+            create_ledger_study(name, start=START, end=END, path=db),
+        ):
+            pass
+
+    with (
+        pytest.raises(LedgerNotFound, match="no sample in the form ADR 0041 gives"),
+        open_study("corrupt", db),
+    ):
+        pass
+
+
+@pytest.mark.parametrize("bad", [False, None], ids=["false-on-zero", "missing"])
+def test_ran_record_with_false_or_missing_sample_stops(tmp_path: Path, bad: object) -> None:
+    days = [DAY_0 + n * DAY_NS for n in range(5)]
+    with create_ledger_study(
+        "bad-sample", start=days[0], end=days[-1], path=tmp_path / "t.db"
+    ) as s:
+        for idx, (key, step) in enumerate((("a", 0.01), ("b", -0.005))):
+            t = s.ask()
+            t.set_user_attr("config_key", key)
+            if idx == 0 and bad is not None:
+                t.set_user_attr("sample", bad)
+            elif idx == 1:
+                t.set_user_attr("sample", 0)
+            t.set_user_attr("run_config_id", key)
+            t.set_user_attr("backtest_start", days[0])
+            t.set_user_attr("backtest_end", days[-1])
+            t.set_user_attr(
+                "returns_series", {str(d): step * ((i % 3) - 1) for i, d in enumerate(days)}
+            )
+            t.set_user_attr("session_days", [str(d) for d in days])
+            t.set_user_attr("data_digest", {str(BAR_TYPE): "digest"})
+            t.set_user_attr(OUTCOME, TRADED)
+            s.tell(t, 0.0)
+
+        with pytest.raises(
+            RankingStopped, match=rf"#0 \(traded\) ran with sample {bad!r}, not a sample number"
+        ):
+            rank(s)
+
+
+def test_record_grid_reruns_a_key_that_failed_before_its_sample_was_written(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alpaca_bars.write(tmp_path / "catalog")
+    configs = [_strategy(3, 8), _strategy(2, 5)]
+    with create_ledger_study("grid", start=START, end=END, path=tmp_path / "trials.db") as study:
+        first_pass = record_grid(study, tmp_path / "catalog", configs, starting_balances=BALANCES)
+        assert first_pass.recorded == (0, 1)
+
+        real = optuna.trial.Trial.set_user_attr
+
+        def locked(trial: optuna.trial.Trial, key: str, value: object) -> None:
+            if key == "sample":
+                raise OSError("database is locked")
+            real(trial, key, value)
+
+        monkeypatch.setattr(optuna.trial.Trial, "set_user_attr", locked)
+        with pytest.raises(OSError, match="database is locked"):
+            record_trial(study, tmp_path / "catalog", [configs[0]], starting_balances=BALANCES)
+        monkeypatch.undo()
+
+        recovery = record_grid(study, tmp_path / "catalog", configs, starting_balances=BALANCES)
+        assert recovery.recorded == (3,)
+        assert rank(study).n == 2
+
+
+def test_daily_series_refuses_off_midnight_and_multiple_unreturned_session_days() -> None:
+    returns = {str(DAY_0 + n * DAY_NS): 0.01 * (n + 1) for n in range(3)}
+
+    with pytest.raises(ReturnsRejected, match="session_days has a day off a UTC midnight"):
+        daily_series("a", returns, [str(DAY_0 + 1)])
+
+    with pytest.raises(
+        ReturnsRejected, match="a: no return on 2 of its 5 session days, the first 2025-03-14"
+    ):
+        daily_series("a", returns, [str(DAY_0 + n * DAY_NS) for n in range(5)])
