+"""Replace delivery races under Alpaca's Order links and ExecutionClient's command outcome contract.
+
+Reuse the offline LiveNode harness; no paper endpoint or credential is used.
+"""
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+from nautilus_trader.model import OrderStatus
+from nautilus_trader.model import Price
+from nautilus_trader.model import Quantity
+
+from . import test_execution_client as harness
+from .test_execution_client import modifier
+from .test_execution_client import placed_order
+from .test_execution_client import run_modify
+from .test_execution_client import until_idle
+
+venue = harness.venue
+dispose_nodes = harness.dispose_nodes
+
+
+@pytest.mark.parametrize("event", ["canceled", "expired"])
+def test_a_stale_terminal_update_does_not_hide_the_replacements_fill(venue, event) -> None:
+    venue.trading.script = "accept"
+    strategy = modifier()
+
+    async def deliver(client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        venue.trading.update(old["id"], event, status=event)
+        venue.trading.update(new["id"], "fill", 2, status="filled", filled_qty="2")
+        await until_idle(client, venue)
+
+    run_modify(venue, strategy, lambda: "OrderUpdated" in strategy.names(), deliver)
+
+    assert "OrderCanceled" not in strategy.names()
+    assert "OrderExpired" not in strategy.names()
+    assert strategy.names().count("OrderFilled") == 1
+    assert strategy.last("OrderFilled").venue_order_id.value == placed_order(venue, 1)["id"]
+
+
+def test_a_late_replaced_after_a_partial_fill_does_not_update_twice(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def deliver(client) -> None:
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        venue.trading.update(
+            new["id"], "partial_fill", 3, status="partially_filled", filled_qty="3"
+        )
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.confirm_replace(old["id"])
+        venue.trading.update(new["id"], "fill", 2, status="filled", filled_qty="5")
+        await until_idle(client, venue)
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), deliver)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    assert strategy.names().count("OrderFilled") == 2
+    assert strategy.names().index("OrderUpdated") < strategy.names().index("OrderFilled")
+
+
+def test_a_second_command_with_the_same_terms_is_not_the_first_commands_retry(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier(field="quantity", prices=["5"])
+
+    async def deliver(client) -> None:
+        cached = client.cache.order(strategy.client_order_id)
+        await client._modify_order(
+            SimpleNamespace(
+                client_order_id=strategy.client_order_id,
+                venue_order_id=cached.venue_order_id,
+                quantity=Quantity.from_int(5),
+                price=Price.from_str("150.00"),
+                trigger_price=None,
+            )
+        )
+        await until_idle(client, venue)
+        assert strategy.names().count("OrderModifyRejected") == 1
+        venue.trading.confirm_replace(placed_order(venue, 0)["id"])
+        await until_idle(client, venue)
+        assert not client._modifying
+        assert not client._answers
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), deliver)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    assert strategy.last("OrderUpdated").quantity == Quantity.from_int(5)
+
+
+def test_each_of_two_refused_commands_has_one_rejection(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "reject"
+    strategy = modifier()
+
+    async def deliver(client) -> None:
+        cached = client.cache.order(strategy.client_order_id)
+        await client._modify_order(
+            SimpleNamespace(
+                client_order_id=strategy.client_order_id,
+                venue_order_id=cached.venue_order_id,
+                quantity=None,
+                price=Price.from_str("151.00"),
+                trigger_price=None,
+            )
+        )
+        await until_idle(client, venue)
+        assert not client._modifying
+        assert not client._answers
+
+    run_modify(venue, strategy, lambda: "OrderModifyRejected" in strategy.names(), deliver)
+
+    assert strategy.names().count("OrderModifyRejected") == 2
+    assert strategy.names().count("OrderUpdated") == 0
+
+
+def test_replaced_follows_two_links_to_the_final_terms(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+    final_id = "9c0f6b2e-1d4a-4e8b-a3f5-7b6c5d4e3f21"
+
+    async def deliver(client) -> None:
+        client._answers.clear()
+        old, new = placed_order(venue, 0), placed_order(venue, 1)
+        final = {
+            **new,
+            "id": final_id,
+            "client_order_id": "final-replacement",
+            "replaces": new["id"],
+            "qty": "7",
+            "limit_price": "152.00",
+        }
+        venue.trading._placed[final_id] = final
+        new.update(status="replaced", replaced_by=final_id)
+        venue.trading.confirm_replace(old["id"])
+        async with asyncio.timeout(10):
+            while "OrderUpdated" not in strategy.names():
+                await asyncio.sleep(0.01)
+        venue.trading.confirm_replace(new["id"])
+        await until_idle(client, venue)
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), deliver)
+
+    assert strategy.names().count("OrderUpdated") == 1
+    updated = strategy.last("OrderUpdated")
+    assert updated.venue_order_id.value == final_id
+    assert updated.quantity == Quantity.from_int(7)
+    assert updated.price == Price.from_str("152.0000")
+
+
+def test_a_canceled_replacement_is_reported_even_when_replaced_was_missed(venue) -> None:
+    venue.trading.script = "accept"
+    venue.trading.replace_script = "silent"
+    strategy = modifier()
+    reports = []
+
+    async def reconcile(client) -> None:
+        new = placed_order(venue, 1)
+        new["status"] = "canceled"
+        venue.trading.orders = list(venue.trading._placed.values())
+        client._replacements.clear()
+        reports.extend(
+            await client._generate_order_status_reports(
+                SimpleNamespace(open_only=False, instrument_id=None, start=None, end=None)
+            )
+        )
+
+    run_modify(venue, strategy, lambda: bool(venue.trading.replace_requests), reconcile)
+
+    mine = [r for r in reports if r.client_order_id == strategy.client_order_id]
+    assert [(r.venue_order_id.value, r.order_status) for r in mine] == [
+        (placed_order(venue, 1)["id"], OrderStatus.CANCELED)
+    ]
