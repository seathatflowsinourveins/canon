index 0000000..7cf4c83
--- /dev/null
+++ b/tests/test_trial_integrity.py
@@ -0,0 +1,188 @@
+"""ADR 0035/0041 recovery and cache accounting through the pinned Optuna and NautilusTrader APIs.
+
+All bars are generated by the offline `alpaca_bars` fixture. These tests use no credential or network.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC
+from datetime import datetime
+from typing import TYPE_CHECKING
+from typing import Literal
+
+import optuna
+import pytest
+from nautilus_trader.common import CacheConfig
+from nautilus_trader.config import BacktestEngineConfig
+from nautilus_trader.config import BacktestRunConfig
+from optuna.exceptions import DuplicatedStudyError
+from optuna.trial import TrialState
+
+import canon_trading.ledger
+from canon_trading.ledger import FAILED
+from canon_trading.ledger import OUTCOME
+from canon_trading.ledger import SAMPLES
+from canon_trading.ledger import create_ledger_study
+from canon_trading.ledger import open_study
+from canon_trading.ledger import record_trial
+from canon_trading.ranking import RankingReport
+from canon_trading.ranking import RankingStopped
+from canon_trading.ranking import rank
+from canon_trading.variant_study import grid
+from canon_trading.variant_study import key_of
+from canon_trading.variant_study import run_study
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+    from pathlib import Path
+
+    from conftest import AlpacaBars
+
+    from canon_trading.backtest import BacktestRun
+    from canon_trading.ma_cross import MaCross
+
+START = "2025-03-10"
+END = "2025-05-04"
+BALANCES = ["100000 USD"]
+
+
+@pytest.mark.parametrize("finished", [False, True], ids=["running", "failed"])
+def test_a_pass_retries_a_key_interrupted_before_its_sample_write(
+    alpaca_bars: AlpacaBars, tmp_path: Path, finished: bool
+) -> None:
+    catalog = tmp_path / "catalog"
+    alpaca_bars.write(catalog)
+    ledger = tmp_path / "trials.db"
+    configs = grid(symbols=("AAPL",), periods=((2, 5), (3, 8)))
+    start = datetime.fromisoformat(START).replace(tzinfo=UTC)
+    end = datetime.fromisoformat(END).replace(tzinfo=UTC)
+    run_study(
+        catalog,
+        name="retry",
+        ledger_path=ledger,
+        configs=configs,
+        start=start,
+        end=end,
+        create=True,
+    )
+    with open_study("retry", ledger) as study:
+        interrupted = study.ask()
+        interrupted.set_user_attr("config_key", key_of(configs[0]))
+        if finished:
+            interrupted.set_user_attr(OUTCOME, FAILED)
+            study.tell(interrupted, state=TrialState.FAIL)
+        with pytest.raises(RankingStopped, match="no later record ran to the end"):
+            rank(study)
+
+    recorded, report = run_study(
+        catalog, name="retry", ledger_path=ledger, configs=configs, start=start, end=end
+    )
+
+    assert recorded is not None
+    assert recorded.recorded == (3,)
+    assert recorded.skipped == (key_of(configs[1]),)
+    assert isinstance(report, RankingReport), report
+    assert (report.n, report.all_records) == (2, 4)
+    with open_study("retry", ledger) as study:
+        assert "sample" not in study.trials[interrupted.number].user_attrs
+        assert study.trials[interrupted.number].state == (
+            TrialState.FAIL if finished else TrialState.RUNNING
+        )
+
+
+@pytest.mark.parametrize(
+    ("attrs", "with_trial", "direction"),
+    [
+        pytest.param({}, True, "maximize", id="existing trial"),
+        pytest.param({"purpose": "another writer"}, False, "maximize", id="existing attributes"),
+        pytest.param({SAMPLES: []}, False, "maximize", id="malformed sample"),
+        pytest.param({}, False, "minimize", id="different direction"),
+    ],
+)
+def test_creation_recovery_does_not_overwrite_another_study(
+    tmp_path: Path,
+    attrs: dict[str, object],
+    with_trial: bool,
+    direction: Literal["minimize", "maximize"],
+) -> None:
+    path = tmp_path / "trials.db"
+    storage = optuna.storages.RDBStorage(f"sqlite:///{path}")
+    try:
+        original = optuna.create_study(study_name="existing", storage=storage, direction=direction)
+        for key, value in attrs.items():
+            original.set_user_attr(key, value)
+        if with_trial:
+            original.ask()
+        with (
+            pytest.raises(DuplicatedStudyError),
+            create_ledger_study("existing", path=path, start=START, end=END),
+        ):
+            pass
+        assert original.user_attrs == attrs
+        assert len(original.trials) == int(with_trial)
+        assert original.direction.name.lower() == direction
+    finally:
+        storage.remove_session()
+        storage.engine.dispose()
+
+
+def test_a_real_cache_capacity_limit_is_told_failed(
+    alpaca_bars: AlpacaBars, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    catalog = tmp_path / "catalog"
+    alpaca_bars.write(catalog)
+    real = canon_trading.ledger.run_backtest_config
+
+    def limited(config: BacktestRunConfig, strategies: Sequence[MaCross]) -> BacktestRun:
+        return real(
+            BacktestRunConfig(
+                venues=config.venues,
+                data=config.data,
+                engine=BacktestEngineConfig(
+                    logging=config.engine.logging, cache=CacheConfig(bar_capacity=3)
+                ),
+                id=config.id,
+                start=config.start,
+                end=config.end,
+                raise_exception=config.raise_exception,
+                dispose_on_completion=config.dispose_on_completion,
+            ),
+            strategies,
+        )
+
+    monkeypatch.setattr(canon_trading.ledger, "run_backtest_config", limited)
+    with create_ledger_study("limited", path=tmp_path / "trials.db", start=START, end=END) as study:
+        with pytest.raises(RuntimeError, match="cache holds 3 bars and the run replayed 40"):
+            record_trial(
+                study,
+                catalog,
+                grid(symbols=("AAPL",), periods=((3, 8),)),
+                starting_balances=BALANCES,
+            )
+        [trial] = study.trials
+        assert (trial.state, trial.user_attrs[OUTCOME]) == (TrialState.FAIL, FAILED)
+        assert "data_digest" not in trial.user_attrs
+        assert "session_days" not in trial.user_attrs
+
+
+@pytest.mark.parametrize("number", [None, False, 0.0], ids=["missing", "bool zero", "float zero"])
+def test_a_later_run_cannot_resolve_a_run_with_an_invalid_sample(
+    alpaca_bars: AlpacaBars, tmp_path: Path, number: object
+) -> None:
+    catalog = tmp_path / "catalog"
+    alpaca_bars.write(catalog)
+    configs = grid(symbols=("AAPL",), periods=((3, 8), (2, 5)))
+    with create_ledger_study("invalid", path=tmp_path / "trials.db", start=START, end=END) as study:
+        for config in configs:
+            record_trial(study, catalog, [config], starting_balances=BALANCES)
+        attrs = dict(study.trials[0].user_attrs)
+        if number is None:
+            del attrs["sample"]
+        else:
+            attrs["sample"] = number
+        study.add_trial(optuna.trial.create_trial(value=0.0, user_attrs=attrs))
+        record_trial(study, catalog, [configs[0]], starting_balances=BALANCES)
+
+        with pytest.raises(RankingStopped) as stopped:
+            rank(study)
+        assert f"#2 (traded) ran with sample {number!r}, not a sample number" in str(stopped.value)
