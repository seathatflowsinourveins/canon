+def _first_uncovered(intervals: Sequence[tuple[int, int]], start: int, end: int) -> int | None:
+    """The first instant in [start, end] that none of `intervals` covers, or `None` if all are."""
+    at = start
+    for first, last in sorted(intervals):
+        if last < at:
+            continue
+        if first > at:
+            return at
+        if last >= end:
+            return None
+        at = last + 1
+    return at if at <= end else None
+
+
+def _between_intervals(intervals: Sequence[tuple[int, int]], instant: int) -> bool:
+    """Whether `instant` lies between two of `intervals`, where consolidation can close the gap."""
+    return any(last < instant for _, last in intervals) and any(
+        first > instant for first, _ in intervals
+    )
+
+
+def _stamp(ns: int) -> str:
+    return pd.Timestamp(ns, unit="ns", tz="UTC").isoformat()
